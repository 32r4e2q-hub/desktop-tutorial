      "atempo": 1.0,
      "tail_silence_seconds": 0.624
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "所谓幻听，挡不住一步步跟随的客观事实。",
      "sha256": "1cdd23dd59fb6325068f7ade49c82edfb32250ec81bb4adbd7fc957a626b5a47",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
