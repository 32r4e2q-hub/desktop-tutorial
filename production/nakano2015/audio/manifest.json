      "atempo": 1.0,
      "tail_silence_seconds": 0.984
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "法院给出的答案是：这不是一时冲动，而是持续的选择。",
      "sha256": "81c8bf869c0627e678853a2a2ce41f4746685b0378222973d737409a754eb158",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
