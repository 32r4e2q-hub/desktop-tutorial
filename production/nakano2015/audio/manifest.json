      "tail_silence_seconds": 1.344
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "裁判员法庭认定的结果是：无期徒刑。",
      "sha256": "13e6195ace5fc0345f7b000889edc4de6f52cac5d1baa363384bf901136f7bab",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
