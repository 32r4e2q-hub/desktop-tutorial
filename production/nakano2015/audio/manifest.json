      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.224,
      "atempo": 1.0,
      "tail_silence_seconds": 1.776
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "从那扇没被打开的门，到这份判决，用了三年多。",
      "sha256": "01cb34a021c7e58d8a83b3874c2c400e5652ea3ab92cb22753749f5e9f097c57",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
