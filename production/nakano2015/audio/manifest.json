      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.096,
      "atempo": 1.016,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "划清陌生人的边界，也是在保护每个人的归途。",
      "sha256": "bc0f6addfa31e6574141b4024bf1aa43c4059e7d98ecf5b4c11a81973c259f81",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
