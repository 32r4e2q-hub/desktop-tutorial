    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "无期徒刑，成为这起案件的最终结论。",
      "sha256": "4157bd5831b915c02b948ee3c9d6c5f13dfeac5251b67720ce98d172ad31c4b2",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
