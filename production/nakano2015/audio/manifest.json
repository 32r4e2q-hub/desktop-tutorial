      "atempo": 1.104,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "同事赶到时，二十五岁的剧团成员加贺谷理沙再没有开门。",
      "sha256": "93597a8506a2afc0221d437fd62ec8d4708e16b07eceed221824e2ed957ea1c5",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
