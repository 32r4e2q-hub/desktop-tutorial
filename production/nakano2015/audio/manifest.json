      "atempo": 1.048,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "为什么一句搭讪被拒之后，跟随会升级成侵害？",
      "sha256": "be2d2295ab8bb7adcb430e0d12a1b5129e20b6b14fc843bc6efb5e460c275131",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
      "target_start": 150.0,
      "target_duration": 6,
      "alignment": "shot-locked",
