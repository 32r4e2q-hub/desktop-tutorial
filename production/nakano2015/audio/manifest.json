      "atempo": 1.0,
      "tail_silence_seconds": 1.464
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "法官说，被夺走的是她曾经的梦想和希望。",
      "sha256": "501d47d64d7362e0f7486d7a72c83022c43ef57b7e4fd36807e91695f8b7a6a0",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
