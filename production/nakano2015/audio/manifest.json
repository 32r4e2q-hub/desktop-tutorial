      "atempo": 1.0,
      "tail_silence_seconds": 1.224
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "二零一八年十二月六日，二审维持原判。",
      "sha256": "4feb3582a08f1fce48370128a9cd2321d2b0a06a60197d92c0367d26d7e298e4",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
