      "tail_silence_seconds": 0.0
    },
    {
      "id": "S15",
      "file": "S15.mp3",
      "text": "二零一八年三月七日，东京地裁做出判决。",
      "sha256": "8ea6c60e634ff44c990fa6c113eb42833517834c13ab65496d72aa2d0dc3cfdd",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
