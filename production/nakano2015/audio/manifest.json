      "atempo": 1.0,
      "tail_silence_seconds": 0.384
    },
    {
      "id": "S24",
      "file": "S24.mp3",
      "text": "夜路、便利店和门厅，拼出她最后一段归途。",
      "sha256": "1d527b275007c1fa90dc9efe426711d0b41564dc8e6311cbf92de7190aa3f20c",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 138.0,
      "target_duration": 6,
