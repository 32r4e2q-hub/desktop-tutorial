{
 "N01": {
  "duration": 28.25,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.29,
    "text": "二零一九年九月",
    "chars_per_second": 6.09
   },
   {
    "i": 1,
    "start": 1.64,
    "end": 2.67,
    "text": "韩国警方宣布",
    "chars_per_second": 5.83
   },
   {
    "i": 2,
    "start": 3.01,
    "end": 5.52,
    "text": "一桩尘封三十三年的连环杀人案",
    "chars_per_second": 5.58
   },
   {
    "i": 3,
    "start": 5.86,
    "end": 7.63,
    "text": "终于出现了DNA线索",
    "chars_per_second": 5.65
   },
   {
    "i": 4,
    "start": 7.98,
    "end": 9.3,
    "text": "可线索指向的那个人",
    "chars_per_second": 6.82
   },
   {
    "i": 5,
    "start": 9.59,
    "end": 12.88,
    "text": "已经在监狱里服刑了二十五年",
    "chars_per_second": 3.95
   },
   {
    "i": 6,
    "start": 13.07,
    "end": 13.86,
    "text": "他叫李春才",
    "chars_per_second": 6.33
   },
   {
    "i": 7,
    "start": 14.21,
    "end": 15.18,
    "text": "这起案件",
    "chars_per_second": 4.12
   },
   {
    "i": 8,
    "start": 15.52,
    "end": 17.29,
    "text": "就是华城连环杀人案",
    "chars_per_second": 5.08
   },
   {
    "i": 9,
    "start": 17.65,
    "end": 18.31,
    "text": "DNA",
    "chars_per_second": 4.55
   },
   {
    "i": 10,
    "start": 18.56,
    "end": 19.99,
    "text": "这项当年的弱项技术",
    "chars_per_second": 6.29
   },
   {
    "i": 11,
    "start": 20.33,
    "end": 21.68,
    "text": "三十三年后开了口",
    "chars_per_second": 5.93
   },
   {
    "i": 12,
    "start": 22.02,
    "end": 23.7,
    "text": "而真相浮出水面的时候",
    "chars_per_second": 5.95
   },
   {
    "i": 13,
    "start": 24.05,
    "end": 25.85,
    "text": "另一个坐了二十年冤狱的人",
    "chars_per_second": 6.67
   },
   {
    "i": 14,
    "start": 26.19,
    "end": 28.25,
    "text": "也终于等到了被看见的一天",
    "chars_per_second": 5.83
   }
  ]
 },
 "N02": {
  "duration": 24.372,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.39,
    "text": "时间回到一九八六年九月",
    "chars_per_second": 4.91
   },
   {
    "i": 1,
    "start": 2.74,
    "end": 4.15,
    "text": "京畿道华城郡",
    "chars_per_second": 4.26
   },
   {
    "i": 2,
    "start": 4.49,
    "end": 6.01,
    "text": "还是一片安静的乡村",
    "chars_per_second": 5.92
   },
   {
    "i": 3,
    "start": 6.36,
    "end": 7.44,
    "text": "住着二十多万人",
    "chars_per_second": 6.48
   },
   {
    "i": 4,
    "start": 7.79,
    "end": 8.59,
    "text": "九月十五日",
    "chars_per_second": 6.25
   },
   {
    "i": 5,
    "start": 8.94,
    "end": 10.64,
    "text": "一位七十一岁的老人遇害",
    "chars_per_second": 6.47
   },
   {
    "i": 6,
    "start": 10.98,
    "end": 11.41,
    "text": "此后",
    "chars_per_second": 4.65
   },
   {
    "i": 7,
    "start": 11.76,
    "end": 13.68,
    "text": "类似的命案接连出现",
    "chars_per_second": 4.69
   },
   {
    "i": 8,
    "start": 14.03,
    "end": 16.33,
    "text": "从一九八六年到一九九一年",
    "chars_per_second": 5.22
   },
   {
    "i": 9,
    "start": 16.67,
    "end": 17.64,
    "text": "四年零七个月",
    "chars_per_second": 6.19
   },
   {
    "i": 10,
    "start": 17.99,
    "end": 19.59,
    "text": "十位女性接连遇害",
    "chars_per_second": 5.0
   },
   {
    "i": 11,
    "start": 19.94,
    "end": 21.38,
    "text": "最小的只有十三岁",
    "chars_per_second": 5.56
   },
   {
    "i": 12,
    "start": 21.72,
    "end": 22.28,
    "text": "天黑了",
    "chars_per_second": 5.36
   },
   {
    "i": 13,
    "start": 22.64,
    "end": 24.37,
    "text": "村民们早早关紧门窗",
    "chars_per_second": 5.2
   }
  ]
 },
 "N03": {
  "duration": 27.35,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.79,
    "text": "警方投入两百多万人次",
    "chars_per_second": 6.1
   },
   {
    "i": 1,
    "start": 2.13,
    "end": 4.19,
    "text": "排查了两万多名嫌疑人",
    "chars_per_second": 4.85
   },
   {
    "i": 2,
    "start": 4.54,
    "end": 6.69,
    "text": "鉴定了五百七十组DNA",
    "chars_per_second": 5.12
   },
   {
    "i": 3,
    "start": 7.03,
    "end": 8.76,
    "text": "却始终没能锁定真凶",
    "chars_per_second": 5.2
   },
   {
    "i": 4,
    "start": 9.1,
    "end": 10.24,
    "text": "一九八八年九月",
    "chars_per_second": 6.14
   },
   {
    "i": 5,
    "start": 10.59,
    "end": 11.99,
    "text": "一名十三岁女孩遇害",
    "chars_per_second": 6.43
   },
   {
    "i": 6,
    "start": 12.33,
    "end": 14.42,
    "text": "警方认定这是模仿作案",
    "chars_per_second": 4.78
   },
   {
    "i": 7,
    "start": 14.77,
    "end": 18.35,
    "text": "二十出头的尹成汝被判处无期徒刑",
    "chars_per_second": 4.19
   },
   {
    "i": 8,
    "start": 18.69,
    "end": 20.13,
    "text": "调查记录堆成了山",
    "chars_per_second": 5.56
   },
   {
    "i": 9,
    "start": 20.47,
    "end": 22.45,
    "text": "真凶却始终藏在人海里",
    "chars_per_second": 5.05
   },
   {
    "i": 10,
    "start": 22.8,
    "end": 23.98,
    "text": "一次不实的调查",
    "chars_per_second": 5.93
   },
   {
    "i": 11,
    "start": 24.33,
    "end": 27.35,
    "text": "让无辜的人失去了二十年自由",
    "chars_per_second": 4.3
   }
  ]
 },
 "N04": {
  "duration": 28.75,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.72,
    "text": "原来",
    "chars_per_second": 3.51
   },
   {
    "i": 1,
    "start": 1.03,
    "end": 2.83,
    "text": "真凶早就关在监狱里",
    "chars_per_second": 5.0
   },
   {
    "i": 2,
    "start": 3.17,
    "end": 4.61,
    "text": "一九九四年一月",
    "chars_per_second": 4.86
   },
   {
    "i": 3,
    "start": 4.94,
    "end": 7.9,
    "text": "李春才因杀害妻子的妹妹被捕",
    "chars_per_second": 4.39
   },
   {
    "i": 4,
    "start": 8.25,
    "end": 10.23,
    "text": "随后被判终身监禁",
    "chars_per_second": 4.04
   },
   {
    "i": 5,
    "start": 10.57,
    "end": 11.94,
    "text": "警方先后九次到监狱见他",
    "chars_per_second": 8.03
   },
   {
    "i": 6,
    "start": 12.16,
    "end": 13.08,
    "text": "二零一九年十月一日",
    "chars_per_second": 9.78
   },
   {
    "i": 7,
    "start": 13.42,
    "end": 14.96,
    "text": "他承认了华城十起命案中的九起",
    "chars_per_second": 9.09
   },
   {
    "i": 8,
    "start": 15.31,
    "end": 15.98,
    "text": "四天后",
    "chars_per_second": 4.48
   },
   {
    "i": 9,
    "start": 16.26,
    "end": 17.93,
    "text": "又承认了剩下那起",
    "chars_per_second": 4.79
   },
   {
    "i": 10,
    "start": 18.27,
    "end": 20.29,
    "text": "他也在证物上留下了DNA",
    "chars_per_second": 5.94
   },
   {
    "i": 11,
    "start": 20.64,
    "end": 22.39,
    "text": "只是当年比对不了",
    "chars_per_second": 4.57
   },
   {
    "i": 12,
    "start": 22.73,
    "end": 24.11,
    "text": "他还供认了另外四起谋杀",
    "chars_per_second": 7.97
   },
   {
    "i": 13,
    "start": 24.46,
    "end": 28.75,
    "text": "和三十多起性犯罪",
    "chars_per_second": 1.86
   }
  ]
 },
 "N05": {
  "duration": 27.365,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.92,
    "text": "二零二零年十一月",
    "chars_per_second": 4.52
   },
   {
    "i": 1,
    "start": 2.26,
    "end": 4.88,
    "text": "李春才以证人身份站上法庭",
    "chars_per_second": 4.58
   },
   {
    "i": 2,
    "start": 5.23,
    "end": 6.05,
    "text": "只说了一句",
    "chars_per_second": 6.1
   },
   {
    "i": 3,
    "start": 6.34,
    "end": 7.2,
    "text": "我就是真凶",
    "chars_per_second": 5.81
   },
   {
    "i": 4,
    "start": 7.54,
    "end": 9.04,
    "text": "同年十二月十七日",
    "chars_per_second": 5.33
   },
   {
    "i": 5,
    "start": 9.39,
    "end": 12.41,
    "text": "水原地方法院宣判尹成汝无罪",
    "chars_per_second": 4.3
   },
   {
    "i": 6,
    "start": 12.76,
    "end": 14.34,
    "text": "法官当庭致歉",
    "chars_per_second": 3.8
   },
   {
    "i": 7,
    "start": 14.69,
    "end": 17.3,
    "text": "说当年的调查机关用不实行为",
    "chars_per_second": 4.98
   },
   {
    "i": 8,
    "start": 17.67,
    "end": 19.08,
    "text": "做出了错误的判决",
    "chars_per_second": 5.67
   },
   {
    "i": 9,
    "start": 19.43,
    "end": 20.88,
    "text": "判决书可以改写",
    "chars_per_second": 4.83
   },
   {
    "i": 10,
    "start": 21.23,
    "end": 22.43,
    "text": "人生却改不回来",
    "chars_per_second": 5.83
   },
   {
    "i": 11,
    "start": 22.78,
    "end": 23.78,
    "text": "二十年牢狱",
    "chars_per_second": 5.0
   },
   {
    "i": 12,
    "start": 24.02,
    "end": 24.88,
    "text": "一句道歉",
    "chars_per_second": 4.65
   },
   {
    "i": 13,
    "start": 25.22,
    "end": 27.36,
    "text": "换不回一个人最好的年华",
    "chars_per_second": 5.13
   }
  ]
 },
 "N06": {
  "duration": 26.295,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 0.59,
    "text": "可是",
    "chars_per_second": 4.08
   },
   {
    "i": 1,
    "start": 0.91,
    "end": 2.45,
    "text": "李春才无法被起诉",
    "chars_per_second": 5.19
   },
   {
    "i": 2,
    "start": 2.79,
    "end": 4.14,
    "text": "二零零六年四月",
    "chars_per_second": 5.19
   },
   {
    "i": 3,
    "start": 4.4,
    "end": 5.93,
    "text": "追诉时效已经届满",
    "chars_per_second": 5.23
   },
   {
    "i": 4,
    "start": 6.27,
    "end": 9.34,
    "text": "韩国二零一五年废除了谋杀案的追诉时效",
    "chars_per_second": 5.86
   },
   {
    "i": 5,
    "start": 9.65,
    "end": 12.32,
    "text": "却来不及保护三十三年前的受害者",
    "chars_per_second": 5.62
   },
   {
    "i": 6,
    "start": 12.61,
    "end": 15.29,
    "text": "这起案件推动了韩国的DNA立法",
    "chars_per_second": 5.6
   },
   {
    "i": 7,
    "start": 15.57,
    "end": 17.89,
    "text": "也被拍成电影《杀人回忆》",
    "chars_per_second": 4.31
   },
   {
    "i": 8,
    "start": 18.23,
    "end": 19.16,
    "text": "警醒一代人",
    "chars_per_second": 5.38
   },
   {
    "i": 9,
    "start": 19.5,
    "end": 22.33,
    "text": "每一份没丢的证物",
    "chars_per_second": 2.83
   },
   {
    "i": 10,
    "start": 22.6,
    "end": 23.63,
    "text": "都可能在某天开口",
    "chars_per_second": 7.77
   },
   {
    "i": 11,
    "start": 23.98,
    "end": 24.57,
    "text": "真相可以迟到",
    "chars_per_second": 10.17
   },
   {
    "i": 12,
    "start": 24.8,
    "end": 26.3,
    "text": "但不该让无辜者买单",
    "chars_per_second": 6.02
   }
  ]
 }
}