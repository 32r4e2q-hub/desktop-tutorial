[
  {
    "start": 0.6,
    "end": 2.0794747056002474,
    "text": "二零一九年九月，"
  },
  {
    "start": 2.286394244845037,
    "end": 3.507219526389298,
    "text": "韩国警方宣布，"
  },
  {
    "start": 3.548603434238256,
    "end": 6.486860891514272,
    "text": "一桩尘封三十三年的连环杀人案，"
  },
  {
    "start": 6.52824479936323,
    "end": 8.535364330037693,
    "text": "终于出现了DNA线索。"
  },
  {
    "start": 8.721591915358003,
    "end": 10.356256275391843,
    "text": "可线索指向的那个人，"
  },
  {
    "start": 10.376948229316321,
    "end": 13.170362009120986,
    "text": "已经在监狱里服刑了二十五年。"
  },
  {
    "start": 13.273821778743379,
    "end": 14.991253954475136,
    "text": "他叫李春才。"
  },
  {
    "start": 15.177481539795446,
    "end": 16.294847051717312,
    "text": "这起案件，"
  },
  {
    "start": 16.481074637037622,
    "end": 18.653729799107918,
    "text": "就是华城连环杀人案。"
  },
  {
    "start": 18.715805660881358,
    "end": 19.502099910011555,
    "text": "DNA，"
  },
  {
    "start": 19.626251633558432,
    "end": 21.488527486761537,
    "text": "这项当年的弱项技术，"
  },
  {
    "start": 21.529911394610497,
    "end": 23.205959662493292,
    "text": "三十三年后开了口。"
  },
  {
    "start": 23.268035524266732,
    "end": 25.068235515696404,
    "text": "而真相浮出水面的时候，"
  },
  {
    "start": 25.33723091671463,
    "end": 27.468502170935967,
    "text": "另一个坐了二十年冤狱的人，"
  },
  {
    "start": 27.551269986633883,
    "end": 29.723925148704176,
    "text": "也终于等到了被看见的一天。"
  },
  {
    "start": 30.969460780100007,
    "end": 33.5352630667354,
    "text": "时间回到一九八六年九月，"
  },
  {
    "start": 33.649068813320035,
    "end": 35.35615501208955,
    "text": "京畿道华城郡，"
  },
  {
    "start": 35.45961478171195,
    "end": 37.2805067270661,
    "text": "还是一片安静的乡村，"
  },
  {
    "start": 37.394312473650736,
    "end": 38.75998143266635,
    "text": "住着二十多万人。"
  },
  {
    "start": 38.87378717925098,
    "end": 39.94976878332389,
    "text": "九月十五日，"
  },
  {
    "start": 40.06357452990852,
    "end": 42.07069406058299,
    "text": "一位七十一岁的老人遇害。"
  },
  {
    "start": 42.174153830205384,
    "end": 42.86733428667543,
    "text": "此后，"
  },
  {
    "start": 42.98114003326006,
    "end": 45.21587105710379,
    "text": "类似的命案接连出现。"
  },
  {
    "start": 45.32967680368843,
    "end": 47.957554952097254,
    "text": "从一九八六年到一九九一年，"
  },
  {
    "start": 48.06101472171966,
    "end": 49.312877934150634,
    "text": "四年零七个月，"
  },
  {
    "start": 49.426683680735266,
    "end": 51.330343441787335,
    "text": "十位女性接连遇害，"
  },
  {
    "start": 51.444149188371966,
    "end": 53.182273318028194,
    "text": "最小的只有十三岁。"
  },
  {
    "start": 53.2857330876506,
    "end": 54.11341124462976,
    "text": "天黑了，"
  },
  {
    "start": 54.23756296817663,
    "end": 56.12255686245932,
    "text": "村民们早早关紧门窗。"
  },
  {
    "start": 57.20255686245932,
    "end": 59.19933041617154,
    "text": "警方投入两百多万人次，"
  },
  {
    "start": 59.19933041617154,
    "end": 61.66167293318454,
    "text": "排查了两万多名嫌疑人，"
  },
  {
    "start": 61.72374879495798,
    "end": 64.18609131197098,
    "text": "鉴定了五百七十组DNA，"
  },
  {
    "start": 64.31024303551786,
    "end": 66.37943842796575,
    "text": "却始终没能锁定真凶。"
  },
  {
    "start": 66.54497405936158,
    "end": 67.95202692622615,
    "text": "一九八八年九月，"
  },
  {
    "start": 68.03479474192407,
    "end": 69.75222691765583,
    "text": "一名十三岁女孩遇害，"
  },
  {
    "start": 69.79361082550479,
    "end": 72.27664529644227,
    "text": "警方认定这是模仿作案。"
  },
  {
    "start": 72.38010506606466,
    "end": 76.29088435779119,
    "text": "二十出头的尹成汝被判处无期徒刑。"
  },
  {
    "start": 76.45641998918701,
    "end": 78.1324682570698,
    "text": "调查记录堆成了山，"
  },
  {
    "start": 78.21523607276772,
    "end": 80.53273491230937,
    "text": "真凶却始终藏在人海里。"
  },
  {
    "start": 80.6982705437052,
    "end": 82.12601536449426,
    "text": "一次不实的调查，"
  },
  {
    "start": 82.20878318019217,
    "end": 85.16773259139266,
    "text": "让无辜的人失去了二十年自由。"
  },
  {
    "start": 86.64087971595778,
    "end": 87.47890384989918,
    "text": "原来，"
  },
  {
    "start": 87.55132568863486,
    "end": 89.66190498893171,
    "text": "真凶早就关在监狱里。"
  },
  {
    "start": 89.76536475855411,
    "end": 91.50348888821034,
    "text": "一九九四年一月，"
  },
  {
    "start": 91.5966026808705,
    "end": 94.90731530878713,
    "text": "李春才因杀害妻子的妹妹被捕，"
  },
  {
    "start": 95.02112105537176,
    "end": 97.31792794098894,
    "text": "随后被判终身监禁。"
  },
  {
    "start": 97.42138771061133,
    "end": 99.06639804760741,
    "text": "警方先后九次到监狱见他。"
  },
  {
    "start": 99.06639804760741,
    "end": 100.26653137522719,
    "text": "二零一九年十月一日，"
  },
  {
    "start": 100.36999114484959,
    "end": 102.21157504412822,
    "text": "他承认了华城十起命案中的九起，"
  },
  {
    "start": 102.32538079071286,
    "end": 103.26686469427665,
    "text": "四天后，"
  },
  {
    "start": 103.3082486021256,
    "end": 105.28433020191335,
    "text": "又承认了剩下那起。"
  },
  {
    "start": 105.38778997153574,
    "end": 107.72598076500186,
    "text": "他也在证物上留下了DNA，"
  },
  {
    "start": 107.83978651158651,
    "end": 109.89863592707216,
    "text": "只是当年比对不了。"
  },
  {
    "start": 110.00209569669455,
    "end": 111.67814396457736,
    "text": "他还供认了另外四起谋杀，"
  },
  {
    "start": 111.79194971116199,
    "end": 116.32348762062288,
    "text": "和三十多起性犯罪。"
  },
  {
    "start": 117.40348762062288,
    "end": 119.48302899003302,
    "text": "二零二零年十一月，"
  },
  {
    "start": 119.56579680573094,
    "end": 122.54543817085592,
    "text": "李春才以证人身份站上法庭，"
  },
  {
    "start": 122.62820598655382,
    "end": 123.62141977492882,
    "text": "只说了一句："
  },
  {
    "start": 123.8283393141736,
    "end": 124.96639678001995,
    "text": "我就是真凶。"
  },
  {
    "start": 125.09054850356682,
    "end": 126.99420826461889,
    "text": "同年十二月十七日，"
  },
  {
    "start": 127.01490021854337,
    "end": 130.32561284646002,
    "text": "水原地方法院宣判尹成汝无罪。"
  },
  {
    "start": 130.47045652393138,
    "end": 132.2913484692855,
    "text": "法官当庭致歉，"
  },
  {
    "start": 132.49826800853032,
    "end": 135.4572174197308,
    "text": "说当年的调查机关用不实行为，"
  },
  {
    "start": 135.51929328150425,
    "end": 137.19534154938702,
    "text": "做出了错误的判决。"
  },
  {
    "start": 137.40226108863183,
    "end": 139.07830935651464,
    "text": "判决书可以改写，"
  },
  {
    "start": 139.26453694183493,
    "end": 140.71297371654845,
    "text": "人生却改不回来。"
  },
  {
    "start": 140.85781739401983,
    "end": 142.01656681379063,
    "text": "二十年牢狱，"
  },
  {
    "start": 142.09933462948857,
    "end": 143.23739209533488,
    "text": "一句道歉，"
  },
  {
    "start": 143.38223577280624,
    "end": 145.53419898095206,
    "text": "换不回一个人最好的年华。"
  },
  {
    "start": 146.80559955475348,
    "end": 147.56085587299697,
    "text": "可是，"
  },
  {
    "start": 147.64362368869487,
    "end": 149.48520758797352,
    "text": "李春才无法被起诉。"
  },
  {
    "start": 149.5886673575959,
    "end": 151.233677694592,
    "text": "二零零六年四月，"
  },
  {
    "start": 151.25436964851647,
    "end": 153.08560757083285,
    "text": "追诉时效已经届满；"
  },
  {
    "start": 153.18906734045524,
    "end": 156.6135857149565,
    "text": "韩国二零一五年废除了谋杀案的追诉时效，"
  },
  {
    "start": 156.6860075536922,
    "end": 159.6966868497039,
    "text": "却来不及保护三十三年前的受害者。"
  },
  {
    "start": 159.7484167345151,
    "end": 162.76944200748903,
    "text": "这起案件推动了韩国的DNA立法，"
  },
  {
    "start": 162.81082591533797,
    "end": 165.45939601767128,
    "text": "也被拍成电影《杀人回忆》，"
  },
  {
    "start": 165.5628557872937,
    "end": 166.7733350918757,
    "text": "警醒一代人。"
  },
  {
    "start": 166.8767948614981,
    "end": 170.05300978890563,
    "text": "每一份没丢的证物，"
  },
  {
    "start": 170.08404771979235,
    "end": 171.39798679399675,
    "text": "都可能在某天开口。"
  },
  {
    "start": 171.51179254058138,
    "end": 172.36016265148504,
    "text": "真相可以迟到，"
  },
  {
    "start": 172.36016265148504,
    "end": 174.0,
    "text": "但不该让无辜者买单。"
  }
]