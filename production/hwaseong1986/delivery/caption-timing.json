[
  {
    "start": 0.6517298848111974,
    "end": 2.089820682562487,
    "text": "二零一九年九月，"
  },
  {
    "start": 2.2036264291471213,
    "end": 3.517565503351537,
    "text": "韩国警方宣布，"
  },
  {
    "start": 3.6210252729739323,
    "end": 6.466168937589793,
    "text": "一桩尘封三十三年的连环杀人案，"
  },
  {
    "start": 6.569628707212188,
    "end": 8.649170076622326,
    "text": "终于出现了DNA线索。"
  },
  {
    "start": 8.762975823206961,
    "end": 10.376948229316323,
    "text": "可线索指向的那个人，"
  },
  {
    "start": 10.42867811412752,
    "end": 14.029078096986863,
    "text": "已经在监狱里服刑了二十五年。"
  },
  {
    "start": 14.029078096986863,
    "end": 15.09471372409753,
    "text": "他叫李春才。"
  },
  {
    "start": 15.208519470682166,
    "end": 16.460382683113146,
    "text": "这起案件，"
  },
  {
    "start": 16.56384245273554,
    "end": 18.643383822145676,
    "text": "就是华城连环杀人案。"
  },
  {
    "start": 18.767535545692553,
    "end": 19.698673472294104,
    "text": "DNA，"
  },
  {
    "start": 19.709019449256346,
    "end": 21.43679760195034,
    "text": "这项当年的弱项技术，"
  },
  {
    "start": 21.540257371572736,
    "end": 23.185267708568816,
    "text": "三十三年后开了口。"
  },
  {
    "start": 23.288727478191213,
    "end": 25.27515505494119,
    "text": "而真相浮出水面的时候，"
  },
  {
    "start": 25.38896080152583,
    "end": 27.499540101822685,
    "text": "另一个坐了二十年冤狱的人，"
  },
  {
    "start": 27.602999871445082,
    "end": 29.827384918326572,
    "text": "也终于等到了被看见的一天。"
  },
  {
    "start": 30.90738491832657,
    "end": 33.52491708977316,
    "text": "时间回到一九八六年九月，"
  },
  {
    "start": 33.71114467509347,
    "end": 35.34580903512732,
    "text": "京畿道华城郡，"
  },
  {
    "start": 35.57342052829658,
    "end": 37.2287768422549,
    "text": "还是一片安静的乡村，"
  },
  {
    "start": 37.394312473650736,
    "end": 38.656521663043954,
    "text": "住着二十多万人。"
  },
  {
    "start": 38.801365340515304,
    "end": 39.96011476028613,
    "text": "九月十五日，"
  },
  {
    "start": 40.12565039168196,
    "end": 42.00861819880955,
    "text": "一位七十一岁的老人遇害。"
  },
  {
    "start": 42.0500021066585,
    "end": 42.79491244793975,
    "text": "此后，"
  },
  {
    "start": 43.00183198718454,
    "end": 45.17448714925483,
    "text": "类似的命案接连出现。"
  },
  {
    "start": 45.25725496495275,
    "end": 47.926517021210536,
    "text": "从一九八六年到一九九一年，"
  },
  {
    "start": 48.154128514379806,
    "end": 49.312877934150634,
    "text": "四年零七个月，"
  },
  {
    "start": 49.5404894273199,
    "end": 51.29930551090061,
    "text": "十位女性接连遇害，"
  },
  {
    "start": 51.444149188371966,
    "end": 53.161581364103725,
    "text": "最小的只有十三岁。"
  },
  {
    "start": 53.265041133726115,
    "end": 54.092719290705276,
    "text": "天黑了，"
  },
  {
    "start": 54.15479515247871,
    "end": 56.05845491353078,
    "text": "村民们早早关紧门窗。"
  },
  {
    "start": 57.20255686245932,
    "end": 59.15794650832258,
    "text": "警方投入两百多万人次，"
  },
  {
    "start": 59.38555800149185,
    "end": 61.66167293318454,
    "text": "排查了两万多名嫌疑人，"
  },
  {
    "start": 61.86859247242933,
    "end": 64.24816717374442,
    "text": "鉴定了五百七十组DNA，"
  },
  {
    "start": 64.4550867129892,
    "end": 66.35874647404127,
    "text": "却始终没能锁定真凶。"
  },
  {
    "start": 66.37943842796575,
    "end": 67.95202692622615,
    "text": "一九八八年九月，"
  },
  {
    "start": 68.13825451154646,
    "end": 69.73153496373135,
    "text": "一名十三岁女孩遇害，"
  },
  {
    "start": 69.87637864120269,
    "end": 72.27664529644227,
    "text": "警方认定这是模仿作案。"
  },
  {
    "start": 72.31802920429122,
    "end": 76.2701924038667,
    "text": "二十出头的尹成汝被判处无期徒刑。"
  },
  {
    "start": 76.49780389703596,
    "end": 78.09108434922085,
    "text": "调查记录堆成了山，"
  },
  {
    "start": 78.29800388846564,
    "end": 80.5120429583849,
    "text": "真凶却始终藏在人海里。"
  },
  {
    "start": 80.59481077408282,
    "end": 82.04324754879634,
    "text": "一次不实的调查，"
  },
  {
    "start": 82.31224294981456,
    "end": 85.18842454531715,
    "text": "让无辜的人失去了二十年自由。"
  },
  {
    "start": 86.64087971595778,
    "end": 87.47890384989918,
    "text": "原来，"
  },
  {
    "start": 87.55132568863486,
    "end": 89.66190498893171,
    "text": "真凶早就关在监狱里。"
  },
  {
    "start": 89.76536475855411,
    "end": 91.50348888821034,
    "text": "一九九四年一月，"
  },
  {
    "start": 91.5966026808705,
    "end": 94.90731530878713,
    "text": "李春才因杀害妻子的妹妹被捕，"
  },
  {
    "start": 95.02112105537176,
    "end": 97.31792794098894,
    "text": "随后被判终身监禁。"
  },
  {
    "start": 97.42138771061133,
    "end": 99.06639804760741,
    "text": "警方先后九次到监狱见他。"
  },
  {
    "start": 99.06639804760741,
    "end": 100.26653137522719,
    "text": "二零一九年十月一日，"
  },
  {
    "start": 100.36999114484959,
    "end": 102.21157504412822,
    "text": "他承认了华城十起命案中的九起，"
  },
  {
    "start": 102.32538079071286,
    "end": 103.26686469427665,
    "text": "四天后，"
  },
  {
    "start": 103.3082486021256,
    "end": 105.28433020191335,
    "text": "又承认了剩下那起。"
  },
  {
    "start": 105.38778997153574,
    "end": 107.72598076500186,
    "text": "他也在证物上留下了DNA，"
  },
  {
    "start": 107.83978651158651,
    "end": 109.89863592707216,
    "text": "只是当年比对不了。"
  },
  {
    "start": 110.00209569669455,
    "end": 111.67814396457736,
    "text": "他还供认了另外四起谋杀，"
  },
  {
    "start": 111.79194971116199,
    "end": 116.32348762062288,
    "text": "和三十多起性犯罪。"
  },
  {
    "start": 117.46556348239632,
    "end": 119.54510485180646,
    "text": "二零二零年十一月，"
  },
  {
    "start": 119.64856462142885,
    "end": 122.60751403262935,
    "text": "李春才以证人身份站上法庭，"
  },
  {
    "start": 122.72131977921399,
    "end": 123.81799333721136,
    "text": "只说了一句："
  },
  {
    "start": 123.86972322202257,
    "end": 125.00778068786892,
    "text": "我就是真凶。"
  },
  {
    "start": 125.1112404574913,
    "end": 126.91144044892098,
    "text": "同年十二月十七日，"
  },
  {
    "start": 127.02524619550562,
    "end": 130.39803468519568,
    "text": "水原地方法院宣判尹成汝无罪。"
  },
  {
    "start": 130.5118404317803,
    "end": 132.3948082389079,
    "text": "法官当庭致歉，"
  },
  {
    "start": 132.50861398549253,
    "end": 135.4572174197308,
    "text": "说当年的调查机关用不实行为，"
  },
  {
    "start": 135.5917151202399,
    "end": 137.29880131900944,
    "text": "做出了错误的判决。"
  },
  {
    "start": 137.41260706559407,
    "end": 139.16107717221254,
    "text": "判决书可以改写，"
  },
  {
    "start": 139.27488291879718,
    "end": 140.76470360135966,
    "text": "人生却改不回来。"
  },
  {
    "start": 140.8785093479443,
    "end": 142.161410491262,
    "text": "二十年牢狱，"
  },
  {
    "start": 142.161410491262,
    "end": 143.29946795710833,
    "text": "一句道歉，"
  },
  {
    "start": 143.40292772673072,
    "end": 145.71525357779126,
    "text": "换不回一个人最好的年华。"
  },
  {
    "start": 146.80559955475348,
    "end": 147.56085587299697,
    "text": "可是，"
  },
  {
    "start": 147.64362368869487,
    "end": 149.48520758797352,
    "text": "李春才无法被起诉。"
  },
  {
    "start": 149.5886673575959,
    "end": 151.233677694592,
    "text": "二零零六年四月，"
  },
  {
    "start": 151.25436964851647,
    "end": 153.08560757083285,
    "text": "追诉时效已经届满；"
  },
  {
    "start": 153.18906734045524,
    "end": 156.6135857149565,
    "text": "韩国二零一五年废除了谋杀案的追诉时效，"
  },
  {
    "start": 156.6860075536922,
    "end": 159.6966868497039,
    "text": "却来不及保护三十三年前的受害者。"
  },
  {
    "start": 159.7484167345151,
    "end": 162.76944200748903,
    "text": "这起案件推动了韩国的DNA立法，"
  },
  {
    "start": 162.81082591533797,
    "end": 165.45939601767128,
    "text": "也被拍成电影《杀人回忆》，"
  },
  {
    "start": 165.5628557872937,
    "end": 166.7733350918757,
    "text": "警醒一代人。"
  },
  {
    "start": 166.8767948614981,
    "end": 170.05300978890563,
    "text": "每一份没丢的证物，"
  },
  {
    "start": 170.08404771979235,
    "end": 171.39798679399675,
    "text": "都可能在某天开口。"
  },
  {
    "start": 171.51179254058138,
    "end": 172.36016265148504,
    "text": "真相可以迟到，"
  },
  {
    "start": 172.36016265148504,
    "end": 174.0,
    "text": "但不该让无辜者买单。"
  }
]