      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "她还说，那晚警察一直在街上开罚单。",
      "sha256": "64cfabc10d2f7077df6bced44ccd6092d21e9af12321a6f98f4bbd26aa273dcf",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
