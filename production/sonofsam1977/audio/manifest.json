      "file": "S19.mp3",
      "text": "探长贾斯特斯翻遍了当晚开出的所有罚单。",
      "sha256": "5d3b35160714720e1fc56650c3b30a708e95737a802e7a1d108163391dbd0e41",
      "voice_id": "voice-00",
