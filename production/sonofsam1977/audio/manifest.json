      "alignment": "shot-locked"
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "走出大门的，是24岁的邮局职员大卫·伯科维茨。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
