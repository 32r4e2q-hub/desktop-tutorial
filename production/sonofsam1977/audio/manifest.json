    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "接电话的调度员，叫惠特·卡尔。",
      "sha256": "a0f1683902e6456cdf43d74523d36b98c12c5a93c7a7fc716f092b745b893bf9",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
