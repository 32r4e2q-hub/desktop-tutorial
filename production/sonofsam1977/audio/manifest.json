      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "接电话的调度员，叫惠特·卡尔。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N6",
      "target_start": 125,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "更巧的是，惠特的父亲山姆·卡尔不久前报过警：",
