      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "一个男人从黄色福特车上取走了一张罚单。",
      "sha256": "4b4fe36afca4d8240512640f89efad0f48a2e50f57f143600a83c0ab08caef9d",
      "voice_id": "voice-00",
