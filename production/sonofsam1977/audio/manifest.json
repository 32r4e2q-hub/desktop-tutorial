    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "其中一张罚单的车牌，来自北边的扬克斯。",
      "sha256": "d3906ca5bf399f3a44685e4edd3796664f0f966bb802a60dad3460f27fa604d1",
      "voice_id": "voice-00",
