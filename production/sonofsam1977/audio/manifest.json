      "file": "S24.mp3",
      "text": "自家的黑色拉布拉多被人打伤，还收到恐吓信。",
      "sha256": "5e2f52ddc01be9e56dc9c863bf635d61c7387de9234987b0fde43d462222c3a5",
      "voice_id": "voice-00",
