      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N7",
      "target_start": 130,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S24",
      "file": "S24.mp3",
      "text": "自家的黑色拉布拉多被人打伤，还收到恐吓信。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N7",
      "target_start": 137,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S25",
      "file": "S25.mp3",
      "text": "扬克斯警方早就在怀疑同一个邻居。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N7",
      "target_start": 144,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "8月10日夜，警方在扬克斯公寓外等到了他。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N8",
