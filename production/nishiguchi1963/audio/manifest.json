      "source_duration_seconds": 4.307
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "他叫西口彰，当时三十七岁，曾因诈骗和盗窃获罪。",
      "voice_id": "voice-00",
      "sha256": "3900803f58bf857e2ddbd027261affa8d0d019cb8657534e7e58680d8ad84a17",
      "narration_id": "N02",
      "target_start": 24,
