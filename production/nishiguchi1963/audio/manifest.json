    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "警方根据目击证言等线索，很快锁定一名嫌疑人。",
      "voice_id": "voice-00",
      "sha256": "78468226e3e0054b1e26d0d591a6f16ea6f6b9a837495f648f7b2e5573138d48",
