      "target_start": 24,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.008,
      "atempo": 1.0,
      "tail_silence_seconds": 1.992
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "text": "桌上还摆着泡面碗和橘子皮，她原本正准备吃午饭。",
      "sha256": "86a26bc23511a815de6ae91ad98ba81f6c57fcfab4d4c5e781b5b4da79261d39",
      "voice_id": "voice-02",
      "voice_description": "低沉悬疑纪录片男声（主创 2026-11-24 试听改选；本会话注册），克制压抑，实测约 4 字/秒",
