      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.016,
      "atempo": 1.0,
      "tail_silence_seconds": 0.984
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "三十二岁的主妇高羽奈美子，在自己家里遇害。",
      "sha256": "b0f15e0e500f7c785606d8939203823eaa10743216eb628ad303a3ea523ba90e",
      "voice_id": "voice-02",
      "voice_description": "低沉悬疑纪录片男声（主创 2026-11-24 试听改选；本会话注册），克制压抑，实测约 4 字/秒",
      "narration_id": "S04",
      "target_start": 18,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.704,
      "atempo": 1.0,
      "tail_silence_seconds": 1.296
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "她才两岁的儿子就坐在她旁边，浑身没有一处伤。",
      "sha256": "2ec320409c56809b84ddb188182fc880991186e69fe57ad5c1a4243c9d7c3c00",
      "voice_id": "voice-02",
      "voice_description": "低沉悬疑纪录片男声（主创 2026-11-24 试听改选；本会话注册），克制压抑，实测约 4 字/秒",
