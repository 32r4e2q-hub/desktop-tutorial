{
 "N01": {
  "duration": 27.149,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.38,
    "text": "一九八三年二月",
    "chars_per_second": 5.65
   },
   {
    "i": 1,
    "start": 1.73,
    "end": 3.45,
    "text": "伦敦北部一栋老公寓",
    "chars_per_second": 5.23
   },
   {
    "i": 2,
    "start": 3.7,
    "end": 4.75,
    "text": "下水道堵了",
    "chars_per_second": 4.76
   },
   {
    "i": 3,
    "start": 5.1,
    "end": 7.3,
    "text": "疏通工钻进屋外的检查井",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 7.65,
    "end": 10.44,
    "text": "从管壁上掏下一大团泡白的东西",
    "chars_per_second": 5.02
   },
   {
    "i": 5,
    "start": 10.79,
    "end": 12.32,
    "text": "还有几截像手指的",
    "chars_per_second": 5.23
   },
   {
    "i": 6,
    "start": 12.66,
    "end": 14.97,
    "text": "他先把工头叫下来一起看",
    "chars_per_second": 4.76
   },
   {
    "i": 7,
    "start": 15.22,
    "end": 15.81,
    "text": "再报警",
    "chars_per_second": 5.08
   },
   {
    "i": 8,
    "start": 16.15,
    "end": 17.57,
    "text": "当晚警察上了顶楼",
    "chars_per_second": 5.63
   },
   {
    "i": 9,
    "start": 17.92,
    "end": 19.49,
    "text": "开门的男人只说了一句",
    "chars_per_second": 6.37
   },
   {
    "i": 10,
    "start": 19.84,
    "end": 20.99,
    "text": "东西都在衣柜里",
    "chars_per_second": 6.09
   },
   {
    "i": 11,
    "start": 21.34,
    "end": 22.36,
    "text": "路上有人问他",
    "chars_per_second": 5.88
   },
   {
    "i": 12,
    "start": 22.71,
    "end": 23.96,
    "text": "是一具还是两具",
    "chars_per_second": 5.6
   },
   {
    "i": 13,
    "start": 24.2,
    "end": 24.82,
    "text": "他说",
    "chars_per_second": 3.23
   },
   {
    "i": 14,
    "start": 25.09,
    "end": 25.61,
    "text": "十五个",
    "chars_per_second": 5.77
   },
   {
    "i": 15,
    "start": 25.95,
    "end": 27.15,
    "text": "或者十六个",
    "chars_per_second": 4.17
   }
  ]
 },
 "N02": {
  "duration": 29.785,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.06,
    "text": "他叫丹尼斯·尼尔森",
    "chars_per_second": 4.19
   },
   {
    "i": 1,
    "start": 2.46,
    "end": 6.1,
    "text": "一九四五年生在苏格兰渔港弗拉伯勒",
    "chars_per_second": 4.4
   },
   {
    "i": 2,
    "start": 6.45,
    "end": 7.6,
    "text": "父亲是挪威兵",
    "chars_per_second": 5.22
   },
   {
    "i": 3,
    "start": 7.95,
    "end": 9.77,
    "text": "父母一九四八年离婚",
    "chars_per_second": 4.95
   },
   {
    "i": 4,
    "start": 10.12,
    "end": 11.94,
    "text": "他等于没了父亲",
    "chars_per_second": 3.85
   },
   {
    "i": 5,
    "start": 12.28,
    "end": 14.91,
    "text": "他唯一亲近的人是当渔民的祖父",
    "chars_per_second": 5.32
   },
   {
    "i": 6,
    "start": 15.16,
    "end": 16.2,
    "text": "一九五一年",
    "chars_per_second": 4.81
   },
   {
    "i": 7,
    "start": 16.41,
    "end": 18.1,
    "text": "祖父死在北海的渔船上",
    "chars_per_second": 5.92
   },
   {
    "i": 8,
    "start": 18.46,
    "end": 19.78,
    "text": "母亲让他看最后一眼",
    "chars_per_second": 6.82
   },
   {
    "i": 9,
    "start": 20.12,
    "end": 21.5,
    "text": "说祖父睡着了",
    "chars_per_second": 4.35
   },
   {
    "i": 10,
    "start": 21.84,
    "end": 23.88,
    "text": "他在军队食堂学过屠宰",
    "chars_per_second": 4.9
   },
   {
    "i": 11,
    "start": 24.15,
    "end": 26.2,
    "text": "退伍后在就业中心当保安",
    "chars_per_second": 5.37
   },
   {
    "i": 12,
    "start": 26.55,
    "end": 28.05,
    "text": "白天给找工作的人开门",
    "chars_per_second": 6.67
   },
   {
    "i": 13,
    "start": 28.36,
    "end": 29.79,
    "text": "晚上去酒吧找人",
    "chars_per_second": 4.91
   }
  ]
 },
 "N03": {
  "duration": 30.895,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 3.69,
    "text": "动手是从一九七八年冬天开始的",
    "chars_per_second": 3.94
   },
   {
    "i": 1,
    "start": 4.04,
    "end": 4.79,
    "text": "他挑的",
    "chars_per_second": 4.0
   },
   {
    "i": 2,
    "start": 5.03,
    "end": 6.95,
    "text": "大多是没人会去找的人",
    "chars_per_second": 5.21
   },
   {
    "i": 3,
    "start": 7.28,
    "end": 8.25,
    "text": "离家出走的",
    "chars_per_second": 5.15
   },
   {
    "i": 4,
    "start": 8.52,
    "end": 9.26,
    "text": "睡车站的",
    "chars_per_second": 5.41
   },
   {
    "i": 5,
    "start": 9.5,
    "end": 10.41,
    "text": "出来卖的男人",
    "chars_per_second": 6.59
   },
   {
    "i": 6,
    "start": 10.76,
    "end": 12.18,
    "text": "他把人带回自己家",
    "chars_per_second": 5.63
   },
   {
    "i": 7,
    "start": 12.53,
    "end": 12.97,
    "text": "给饭",
    "chars_per_second": 4.55
   },
   {
    "i": 8,
    "start": 13.29,
    "end": 13.88,
    "text": "给酒",
    "chars_per_second": 3.39
   },
   {
    "i": 9,
    "start": 14.12,
    "end": 14.86,
    "text": "给一张床",
    "chars_per_second": 5.41
   },
   {
    "i": 10,
    "start": 15.2,
    "end": 16.48,
    "text": "凌晨趁人睡着",
    "chars_per_second": 4.69
   },
   {
    "i": 11,
    "start": 16.78,
    "end": 17.41,
    "text": "用领带",
    "chars_per_second": 4.76
   },
   {
    "i": 12,
    "start": 17.76,
    "end": 19.59,
    "text": "之后他把人洗干净",
    "chars_per_second": 4.37
   },
   {
    "i": 13,
    "start": 19.94,
    "end": 21.27,
    "text": "换上衣服摆在床上",
    "chars_per_second": 6.02
   },
   {
    "i": 14,
    "start": 21.62,
    "end": 22.39,
    "text": "跟他们说话",
    "chars_per_second": 6.49
   },
   {
    "i": 15,
    "start": 22.73,
    "end": 23.79,
    "text": "一起看电视",
    "chars_per_second": 4.72
   },
   {
    "i": 16,
    "start": 24.14,
    "end": 25.62,
    "text": "一放就是几个星期",
    "chars_per_second": 5.41
   },
   {
    "i": 17,
    "start": 25.97,
    "end": 26.9,
    "text": "房子有花园",
    "chars_per_second": 5.38
   },
   {
    "i": 18,
    "start": 27.25,
    "end": 28.1,
    "text": "他就架火",
    "chars_per_second": 4.71
   },
   {
    "i": 19,
    "start": 28.45,
    "end": 30.89,
    "text": "往火里扔橡胶盖味道",
    "chars_per_second": 3.68
   }
  ]
 },
 "N04": {
  "duration": 31.805,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.61,
    "text": "一九八一年十月",
    "chars_per_second": 4.79
   },
   {
    "i": 1,
    "start": 1.82,
    "end": 4.3,
    "text": "他搬到克兰利花园二十三号的顶楼",
    "chars_per_second": 6.05
   },
   {
    "i": 2,
    "start": 4.65,
    "end": 5.51,
    "text": "没有花园",
    "chars_per_second": 4.65
   },
   {
    "i": 3,
    "start": 5.73,
    "end": 6.97,
    "text": "也没有地板可以藏",
    "chars_per_second": 6.45
   },
   {
    "i": 4,
    "start": 7.32,
    "end": 9.33,
    "text": "他改成把东西煮散",
    "chars_per_second": 3.98
   },
   {
    "i": 5,
    "start": 9.55,
    "end": 10.04,
    "text": "冲下去",
    "chars_per_second": 6.12
   },
   {
    "i": 6,
    "start": 10.39,
    "end": 11.66,
    "text": "整栋楼五户人",
    "chars_per_second": 4.72
   },
   {
    "i": 7,
    "start": 12.01,
    "end": 13.59,
    "text": "厕所一天比一天慢",
    "chars_per_second": 5.06
   },
   {
    "i": 8,
    "start": 13.94,
    "end": 15.47,
    "text": "邻居投诉有味道",
    "chars_per_second": 4.58
   },
   {
    "i": 9,
    "start": 15.82,
    "end": 17.69,
    "text": "他每天喷两遍杀虫剂",
    "chars_per_second": 4.81
   },
   {
    "i": 10,
    "start": 18.03,
    "end": 19.72,
    "text": "说房子结构有问题",
    "chars_per_second": 4.73
   },
   {
    "i": 11,
    "start": 20.06,
    "end": 22.32,
    "text": "二月八号疏通公司来了人",
    "chars_per_second": 4.87
   },
   {
    "i": 12,
    "start": 22.67,
    "end": 24.03,
    "text": "第二天他再来时",
    "chars_per_second": 5.15
   },
   {
    "i": 13,
    "start": 24.37,
    "end": 25.64,
    "text": "井盖被挪过位",
    "chars_per_second": 4.72
   },
   {
    "i": 14,
    "start": 25.98,
    "end": 29.05,
    "text": "管壁上只剩一小块刮不干净的东西",
    "chars_per_second": 4.89
   },
   {
    "i": 15,
    "start": 29.4,
    "end": 29.99,
    "text": "这一次",
    "chars_per_second": 5.08
   },
   {
    "i": 16,
    "start": 30.33,
    "end": 31.8,
    "text": "警察没有被劝回去",
    "chars_per_second": 5.42
   }
  ]
 },
 "N05": {
  "duration": 31.183,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 2.28,
    "text": "他配合得让办案的人心里发毛",
    "chars_per_second": 6.02
   },
   {
    "i": 1,
    "start": 2.62,
    "end": 5.33,
    "text": "说不准确切的人数",
    "chars_per_second": 2.95
   },
   {
    "i": 2,
    "start": 5.67,
    "end": 7.62,
    "text": "还为此道歉",
    "chars_per_second": 2.56
   },
   {
    "i": 3,
    "start": 7.84,
    "end": 9.67,
    "text": "整晚的供词在法庭上被逐字念了四个多小时",
    "chars_per_second": 10.38
   },
   {
    "i": 4,
    "start": 10.01,
    "end": 12.44,
    "text": "一九八三年十月二十四日",
    "chars_per_second": 4.53
   },
   {
    "i": 5,
    "start": 12.79,
    "end": 14.22,
    "text": "中央刑事法院开庭",
    "chars_per_second": 5.59
   },
   {
    "i": 6,
    "start": 14.54,
    "end": 16.65,
    "text": "辩方说他有精神疾病",
    "chars_per_second": 4.27
   },
   {
    "i": 7,
    "start": 16.99,
    "end": 18.86,
    "text": "活下来的人出庭作证",
    "chars_per_second": 4.81
   },
   {
    "i": 8,
    "start": 19.2,
    "end": 21.49,
    "text": "有人被掐醒后逃出来报过警",
    "chars_per_second": 5.24
   },
   {
    "i": 9,
    "start": 21.83,
    "end": 23.41,
    "text": "警方当成情侣纠纷",
    "chars_per_second": 5.06
   },
   {
    "i": 10,
    "start": 23.68,
    "end": 25.3,
    "text": "做了记录就再没下文",
    "chars_per_second": 5.56
   },
   {
    "i": 11,
    "start": 25.64,
    "end": 26.5,
    "text": "十一月四日",
    "chars_per_second": 5.81
   },
   {
    "i": 12,
    "start": 26.8,
    "end": 27.62,
    "text": "六项谋杀",
    "chars_per_second": 4.88
   },
   {
    "i": 13,
    "start": 27.84,
    "end": 28.82,
    "text": "两项未遂成立",
    "chars_per_second": 6.12
   },
   {
    "i": 14,
    "start": 29.16,
    "end": 31.18,
    "text": "至少服满二十五年",
    "chars_per_second": 3.96
   }
  ]
 },
 "N06": {
  "duration": 29.61,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.47,
    "text": "一九九四年十二月",
    "chars_per_second": 6.02
   },
   {
    "i": 1,
    "start": 1.82,
    "end": 5.04,
    "text": "内政大臣把那二十五年改成永远不用出去",
    "chars_per_second": 5.59
   },
   {
    "i": 2,
    "start": 5.37,
    "end": 6.5,
    "text": "二〇一八年五月",
    "chars_per_second": 5.31
   },
   {
    "i": 3,
    "start": 6.79,
    "end": 9.31,
    "text": "他在监狱医院死于手术后并发症",
    "chars_per_second": 5.56
   },
   {
    "i": 4,
    "start": 9.65,
    "end": 10.38,
    "text": "七十二岁",
    "chars_per_second": 5.48
   },
   {
    "i": 5,
    "start": 10.64,
    "end": 11.58,
    "text": "开庭那年",
    "chars_per_second": 4.26
   },
   {
    "i": 6,
    "start": 11.91,
    "end": 13.91,
    "text": "八个死者连名字都没有",
    "chars_per_second": 5.0
   },
   {
    "i": 7,
    "start": 14.25,
    "end": 16.57,
    "text": "第一个死的是个十四岁男孩",
    "chars_per_second": 5.17
   },
   {
    "i": 8,
    "start": 16.92,
    "end": 19.18,
    "text": "一九九〇年拿照片去问",
    "chars_per_second": 3.98
   },
   {
    "i": 9,
    "start": 19.54,
    "end": 20.42,
    "text": "他没认出来",
    "chars_per_second": 5.68
   },
   {
    "i": 10,
    "start": 20.77,
    "end": 24.78,
    "text": "二〇〇六年才靠家人换的照片对上名字",
    "chars_per_second": 3.74
   },
   {
    "i": 11,
    "start": 25.12,
    "end": 26.7,
    "text": "斯蒂芬·霍姆斯",
    "chars_per_second": 3.8
   },
   {
    "i": 12,
    "start": 27.04,
    "end": 28.07,
    "text": "有些人失踪",
    "chars_per_second": 4.85
   },
   {
    "i": 13,
    "start": 28.41,
    "end": 29.61,
    "text": "不会有人报案",
    "chars_per_second": 5.0
   }
  ]
 }
}