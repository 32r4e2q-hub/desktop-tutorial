[
  {
    "start": 0.6465562572094651,
    "end": 2.0246214706096306,
    "text": "一九八三年二月，"
  },
  {
    "start": 2.1270452364704537,
    "end": 3.9520505190814843,
    "text": "伦敦北部一栋老公寓，"
  },
  {
    "start": 3.9613617705233772,
    "end": 5.162513206527575,
    "text": "下水道堵了。"
  },
  {
    "start": 5.264936972388398,
    "end": 7.536882324210294,
    "text": "疏通工钻进屋外的检查井，"
  },
  {
    "start": 7.639306090071116,
    "end": 10.460615276964699,
    "text": "从管壁上掏下一大团泡白的东西，"
  },
  {
    "start": 10.56303904282552,
    "end": 12.211130548040586,
    "text": "还有几截像手指的。"
  },
  {
    "start": 12.304243062459514,
    "end": 14.678612180142233,
    "text": "他先把工头叫下来一起看，"
  },
  {
    "start": 14.687923431584126,
    "end": 15.460757301261246,
    "text": "再报警。"
  },
  {
    "start": 15.553869815680175,
    "end": 17.099537555034416,
    "text": "当晚警察上了顶楼，"
  },
  {
    "start": 17.201961320895244,
    "end": 18.887297831877873,
    "text": "开门的男人只说了一句："
  },
  {
    "start": 18.989721597738697,
    "end": 20.283985548161823,
    "text": "东西都在衣柜里。"
  },
  {
    "start": 20.38640931402265,
    "end": 21.55962699570117,
    "text": "路上有人问他，"
  },
  {
    "start": 21.662050761561993,
    "end": 23.049427226404053,
    "text": "是一具还是两具，"
  },
  {
    "start": 23.049427226404053,
    "end": 23.85019485040685,
    "text": "他说，"
  },
  {
    "start": 23.87812860473253,
    "end": 24.585783714316396,
    "text": "十五个，"
  },
  {
    "start": 24.67889622873533,
    "end": 25.87936871932189,
    "text": "或者十六个。"
  },
  {
    "start": 26.959368719321887,
    "end": 28.97991028221267,
    "text": "他叫丹尼斯·尼尔森，"
  },
  {
    "start": 28.97991028221267,
    "end": 32.68578835608609,
    "text": "一九四五年生在苏格兰渔港弗拉伯勒。"
  },
  {
    "start": 32.76027836762123,
    "end": 34.119721078137616,
    "text": "父亲是挪威兵，"
  },
  {
    "start": 34.119721078137616,
    "end": 36.18681889823786,
    "text": "父母一九四八年离婚，"
  },
  {
    "start": 36.29855391554058,
    "end": 38.19804920968675,
    "text": "他等于没了父亲。"
  },
  {
    "start": 38.19804920968675,
    "end": 40.95417963648708,
    "text": "他唯一亲近的人是当渔民的祖父；"
  },
  {
    "start": 41.04729215090602,
    "end": 42.015662300862886,
    "text": "一九五一年，"
  },
  {
    "start": 42.23913233546832,
    "end": 43.95240260077664,
    "text": "祖父死在北海的渔船上，"
  },
  {
    "start": 44.17587263538206,
    "end": 45.53531534589844,
    "text": "母亲让他看最后一眼，"
  },
  {
    "start": 45.57256035166601,
    "end": 47.08098308525268,
    "text": "说祖父睡着了。"
  },
  {
    "start": 47.1927181025554,
    "end": 49.07359089381779,
    "text": "他在军队食堂学过屠宰，"
  },
  {
    "start": 49.37155093995837,
    "end": 51.475893765826186,
    "text": "退伍后在就业中心当保安："
  },
  {
    "start": 51.56900628024512,
    "end": 53.13329652248314,
    "text": "白天给找工作的人开门，"
  },
  {
    "start": 53.189164031134496,
    "end": 54.511361735883305,
    "text": "晚上去酒吧找人。"
  },
  {
    "start": 55.81948739620969,
    "end": 59.348451692687135,
    "text": "动手是从一九七八年冬天开始的。"
  },
  {
    "start": 59.45087545854796,
    "end": 60.37268935129537,
    "text": "他挑的，"
  },
  {
    "start": 60.37268935129537,
    "end": 62.38391966274426,
    "text": "大多是没人会去找的人："
  },
  {
    "start": 62.467720925721295,
    "end": 63.59438235019035,
    "text": "离家出走的、"
  },
  {
    "start": 63.62231610451603,
    "end": 64.53481874582154,
    "text": "睡车站的、"
  },
  {
    "start": 64.53481874582154,
    "end": 65.60561266163924,
    "text": "出来卖的男人。"
  },
  {
    "start": 65.70803642750006,
    "end": 67.2537041668543,
    "text": "他把人带回自己家，"
  },
  {
    "start": 67.35612793271513,
    "end": 67.98929303076385,
    "text": "给饭、"
  },
  {
    "start": 68.063783042299,
    "end": 68.83661691197611,
    "text": "给酒、"
  },
  {
    "start": 68.83661691197611,
    "end": 69.74911955328163,
    "text": "给一张床；"
  },
  {
    "start": 69.84223206770056,
    "end": 71.2575422868683,
    "text": "凌晨趁人睡着，"
  },
  {
    "start": 71.31340979551966,
    "end": 72.12348867096435,
    "text": "用领带。"
  },
  {
    "start": 72.22591243682517,
    "end": 74.15334148529702,
    "text": "之后他把人洗干净、"
  },
  {
    "start": 74.25576525115785,
    "end": 75.71763172753505,
    "text": "换上衣服摆在床上，"
  },
  {
    "start": 75.82005549339587,
    "end": 76.76049188902707,
    "text": "跟他们说话，"
  },
  {
    "start": 76.853604403446,
    "end": 78.06406709089208,
    "text": "一起看电视，"
  },
  {
    "start": 78.16649085675292,
    "end": 79.76802610475852,
    "text": "一放就是几个星期。"
  },
  {
    "start": 79.87044987061932,
    "end": 80.95986628932081,
    "text": "房子有花园，"
  },
  {
    "start": 81.06229005518163,
    "end": 82.07721646234798,
    "text": "他就架火，"
  },
  {
    "start": 82.1796402282088,
    "end": 84.54004246872867,
    "text": "往火里扔橡胶盖味道。"
  },
  {
    "start": 85.67590997738004,
    "end": 87.23088896817617,
    "text": "一九八一年十月，"
  },
  {
    "start": 87.23088896817617,
    "end": 89.76354936037107,
    "text": "他搬到克兰利花园二十三号的顶楼，"
  },
  {
    "start": 89.86597312623189,
    "end": 90.87158828195635,
    "text": "没有花园，"
  },
  {
    "start": 90.87158828195635,
    "end": 92.24965349535651,
    "text": "也没有地板可以藏。"
  },
  {
    "start": 92.35207726121733,
    "end": 94.42848633275948,
    "text": "他改成把东西煮散、"
  },
  {
    "start": 94.42848633275948,
    "end": 95.10820768801766,
    "text": "冲下去。"
  },
  {
    "start": 95.21063145387849,
    "end": 96.61663042160433,
    "text": "整栋楼五户人，"
  },
  {
    "start": 96.71905418746515,
    "end": 98.41370194988968,
    "text": "厕所一天比一天慢；"
  },
  {
    "start": 98.5161257157505,
    "end": 100.16421722096557,
    "text": "邻居投诉有味道，"
  },
  {
    "start": 100.26664098682639,
    "end": 102.23131504106581,
    "text": "他每天喷两遍杀虫剂，"
  },
  {
    "start": 102.32442755548475,
    "end": 104.12149908377009,
    "text": "说房子结构有问题。"
  },
  {
    "start": 104.21461159818902,
    "end": 106.54242445866228,
    "text": "二月八号疏通公司来了人，"
  },
  {
    "start": 106.6448482245231,
    "end": 108.13464845522599,
    "text": "第二天他再来时，"
  },
  {
    "start": 108.22776096964492,
    "end": 109.63375993737075,
    "text": "井盖被挪过位，"
  },
  {
    "start": 109.72687245178969,
    "end": 112.80889667905628,
    "text": "管壁上只剩一小块刮不干净的东西。"
  },
  {
    "start": 112.9113204449171,
    "end": 113.68415431459422,
    "text": "这一次，"
  },
  {
    "start": 113.77726682901314,
    "end": 115.23447767966941,
    "text": "警察没有被劝回去。"
  },
  {
    "start": 116.34241143399508,
    "end": 118.5771117800494,
    "text": "他配合得让办案的人心里发毛："
  },
  {
    "start": 118.67022429446834,
    "end": 121.41704346982678,
    "text": "说不准确切的人数，"
  },
  {
    "start": 121.51015598424571,
    "end": 123.5306975471365,
    "text": "还为此道歉；"
  },
  {
    "start": 123.5306975471365,
    "end": 125.45812659560835,
    "text": "整晚的供词在法庭上被逐字念了四个多小时。"
  },
  {
    "start": 125.55123911002727,
    "end": 128.03734324501272,
    "text": "一九八三年十月二十四日，"
  },
  {
    "start": 128.13976701087353,
    "end": 129.69474600166967,
    "text": "中央刑事法院开庭，"
  },
  {
    "start": 129.76923601320482,
    "end": 131.95738010204965,
    "text": "辩方说他有精神疾病。"
  },
  {
    "start": 132.0504926164686,
    "end": 134.01516667070803,
    "text": "活下来的人出庭作证："
  },
  {
    "start": 134.10827918512695,
    "end": 136.46402579992588,
    "text": "有人被掐醒后逃出来报过警，"
  },
  {
    "start": 136.55713831434483,
    "end": 138.25178607676935,
    "text": "警方当成情侣纠纷，"
  },
  {
    "start": 138.279719831095,
    "end": 140.01161259928713,
    "text": "做了记录就再没下文。"
  },
  {
    "start": 140.10472511370605,
    "end": 141.12896277231428,
    "text": "十一月四日，"
  },
  {
    "start": 141.18483028096563,
    "end": 142.1532004309225,
    "text": "六项谋杀、"
  },
  {
    "start": 142.1532004309225,
    "end": 143.28917310683346,
    "text": "两项未遂成立，"
  },
  {
    "start": 143.38228562125238,
    "end": 145.34938448055482,
    "text": "至少服满二十五年。"
  },
  {
    "start": 146.4293844805548,
    "end": 147.87262845404823,
    "text": "一九九四年十二月，"
  },
  {
    "start": 148.1333434944212,
    "end": 151.20605647024593,
    "text": "内政大臣把那二十五年改成永远不用出去。"
  },
  {
    "start": 151.44814900773514,
    "end": 152.54687667787852,
    "text": "二〇一八年五月，"
  },
  {
    "start": 152.73310170671638,
    "end": 155.20989459025992,
    "text": "他在监狱医院死于手术后并发症，"
  },
  {
    "start": 155.43336462486533,
    "end": 156.159642237333,
    "text": "七十二岁。"
  },
  {
    "start": 156.27137725463572,
    "end": 157.18387989594123,
    "text": "开庭那年，"
  },
  {
    "start": 157.44459493631425,
    "end": 159.39995773911176,
    "text": "八个死者连名字都没有；"
  },
  {
    "start": 159.51169275641448,
    "end": 161.8953731255391,
    "text": "第一个死的是个十四岁男孩，"
  },
  {
    "start": 162.0443531486094,
    "end": 164.39078851196643,
    "text": "一九九〇年拿照片去问，"
  },
  {
    "start": 164.52114603215293,
    "end": 165.470893679226,
    "text": "他没认出来，"
  },
  {
    "start": 165.56400619364493,
    "end": 169.58646681654272,
    "text": "二〇〇六年才靠家人换的照片对上名字："
  },
  {
    "start": 169.71682433672922,
    "end": 171.37422709338617,
    "text": "斯蒂芬·霍姆斯。"
  },
  {
    "start": 171.5045846135727,
    "end": 172.5474447750647,
    "text": "有些人失踪，"
  },
  {
    "start": 172.64055728948364,
    "end": 173.88826498269728,
    "text": "不会有人报案。"
  }
]