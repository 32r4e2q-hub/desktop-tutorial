  "captions": [
    {
      "text": "二〇一二年八月十四日，",
      "start": 0.744,
      "continues_previous_clause": false,
      "nearest_voice_onset": 0.77,
      "delta_seconds": -0.026
    },
    {
      "text": "清晨六点四十，",
      "start": 3.085,
      "continues_previous_clause": false,
      "nearest_voice_onset": 3.1,
      "delta_seconds": -0.015
    },
    {
      "text": "重庆沙坪坝，",
      "start": 4.616,
      "continues_previous_clause": false,
      "nearest_voice_onset": 4.65,
      "delta_seconds": -0.034
    },
    {
      "text": "童家桥。",
      "start": 6.103,
      "continues_previous_clause": false,
      "nearest_voice_onset": 6.12,
      "delta_seconds": -0.017
    },
    {
      "text": "两名便衣民警在巷口发现了一个人——",
      "start": 7.323,
      "continues_previous_clause": false,
      "nearest_voice_onset": 7.34,
      "delta_seconds": -0.017
    },
    {
      "text": "一个被追了八年的名字：",
      "start": 10.485,
      "continues_previous_clause": false,
      "nearest_voice_onset": 10.5,
      "delta_seconds": -0.015
    },
    {
      "text": "周克华。",
      "start": 13.081,
      "continues_previous_clause": false,
      "nearest_voice_onset": 13.09,
      "delta_seconds": -0.009
    },
    {
      "text": "十分钟后，",
      "start": 14.423,
      "continues_previous_clause": false,
      "nearest_voice_onset": 14.45,
      "delta_seconds": -0.027
    },
    {
      "text": "枪声响起。",
      "start": 15.532,
      "continues_previous_clause": false,
      "nearest_voice_onset": 15.56,
      "delta_seconds": -0.028
    },
    {
      "text": "八年里，",
      "start": 16.764,
      "continues_previous_clause": false,
      "nearest_voice_onset": 16.78,
      "delta_seconds": -0.016
    },
    {
      "text": "这个名字反复出现在三座城市的案卷上。",
      "start": 17.651,
      "continues_previous_clause": false,
      "nearest_voice_onset": 17.67,
      "delta_seconds": -0.019
    },
    {
      "text": "八年追捕，",
      "start": 21.368,
      "continues_previous_clause": false,
      "nearest_voice_onset": 21.38,
      "delta_seconds": -0.012
    },
    {
      "text": "为什么会在最后四天突然收网？",
      "start": 22.622,
      "continues_previous_clause": false,
      "nearest_voice_onset": 22.63,
      "delta_seconds": -0.008
    },
    {
      "text": "故事要从二〇〇四年四月二十二日说起。",
      "start": 26.775,
      "continues_previous_clause": false,
      "nearest_voice_onset": 26.79,
      "delta_seconds": -0.015
    },
    {
      "text": "重庆，",
      "start": 31.845,
      "continues_previous_clause": false,
      "nearest_voice_onset": 31.86,
      "delta_seconds": -0.015
    },
    {
      "text": "两名女子刚从银行取完钱，",
      "start": 32.821,
      "continues_previous_clause": false,
      "nearest_voice_onset": 32.84,
      "delta_seconds": -0.019
    },
    {
      "text": "枪声突然响起，",
      "start": 35.561,
      "continues_previous_clause": false,
      "nearest_voice_onset": 35.58,
      "delta_seconds": -0.019
    },
    {
      "text": "一死一伤，",
      "start": 37.336,
      "continues_previous_clause": false,
      "nearest_voice_onset": 37.35,
      "delta_seconds": -0.014
    },
    {
      "text": "七万元被抢走。",
      "start": 38.656,
      "continues_previous_clause": false,
      "nearest_voice_onset": 38.68,
      "delta_seconds": -0.024
    },
    {
      "text": "一年后，",
      "start": 40.309,
      "continues_previous_clause": false,
      "nearest_voice_onset": 40.32,
      "delta_seconds": -0.011
    },
    {
      "text": "又一对夫妻在银行门口遇袭，",
      "start": 41.274,
      "continues_previous_clause": false,
      "nearest_voice_onset": 41.29,
      "delta_seconds": -0.016
    },
    {
      "text": "一名路人中枪。",
      "start": 44.003,
      "continues_previous_clause": false,
      "nearest_voice_onset": 44.03,
      "delta_seconds": -0.027
    },
    {
      "text": "二〇〇五年，",
      "start": 45.523,
      "continues_previous_clause": false,
      "nearest_voice_onset": 45.54,
      "delta_seconds": -0.017
    },
    {
      "text": "他因非法持枪入狱，",
      "start": 46.344,
      "continues_previous_clause": false,
      "nearest_voice_onset": 46.37,
      "delta_seconds": -0.026
    },
    {
      "text": "二〇〇八年出狱。",
      "start": 49.251,
      "continues_previous_clause": false,
      "nearest_voice_onset": 49.26,
      "delta_seconds": -0.009
    },
    {
      "text": "二〇〇九年三月，",
      "start": 51.137,
      "continues_previous_clause": false,
      "nearest_voice_onset": 51.16,
      "delta_seconds": -0.023
    },
    {
      "text": "重庆石桥铺，",
      "start": 52.834,
      "continues_previous_clause": false,
      "nearest_voice_onset": 52.86,
      "delta_seconds": -0.026
    },
    {
      "text": "执勤哨兵遇害，",
      "start": 54.254,
      "continues_previous_clause": false,
      "nearest_voice_onset": 54.27,
      "delta_seconds": -0.016
    },
    {
      "text": "一支自动步枪被抢走。",
      "start": 55.863,
      "continues_previous_clause": false,
      "nearest_voice_onset": 55.89,
      "delta_seconds": -0.027
    },
    {
      "text": "这就是系列案的起点。",
      "start": 58.148,
      "continues_previous_clause": false,
      "nearest_voice_onset": 58.17,
      "delta_seconds": -0.022
    },
    {
      "text": "专案组发现，",
      "start": 61.547,
      "continues_previous_clause": false,
      "nearest_voice_onset": 61.57,
      "delta_seconds": -0.023
    },
    {
      "text": "这些案子不像临时起意：",
      "start": 62.934,
      "continues_previous_clause": false,
      "nearest_voice_onset": 62.96,
      "delta_seconds": -0.026
    },
    {
      "text": "只挑刚从银行取款的人，",
      "start": 65.896,
      "continues_previous_clause": false,
      "nearest_voice_onset": 66.05,
      "delta_seconds": -0.154
    },
    {
      "text": "只走人流密集的老街，",
      "start": 68.558,
      "continues_previous_clause": false,
      "nearest_voice_onset": 68.59,
      "delta_seconds": -0.032
    },
    {
      "text": "作案后立刻消失。",
      "start": 70.966,
      "continues_previous_clause": false,
      "nearest_voice_onset": 70.99,
      "delta_seconds": -0.024
    },
    {
      "text": "二〇〇九年到二〇一一年，",
      "start": 73.24,
      "continues_previous_clause": false,
      "nearest_voice_onset": 73.25,
      "delta_seconds": -0.01
    },
    {
      "text": "长沙接连发生枪击；",
      "start": 75.803,
      "continues_previous_clause": false,
      "nearest_voice_onset": 75.82,
      "delta_seconds": -0.017
    },
    {
      "text": "二〇一二年一月六日，",
      "start": 77.733,
      "continues_previous_clause": false,
      "nearest_voice_onset": 77.75,
      "delta_seconds": -0.017
    },
    {
      "text": "南京下关区一家银行门口，",
      "start": 79.763,
      "continues_previous_clause": false,
      "nearest_voice_onset": 79.79,
      "delta_seconds": -0.027
    },
    {
      "text": "一名提款人当场身亡，",
      "start": 82.47,
      "continues_previous_clause": false,
      "nearest_voice_onset": 82.48,
      "delta_seconds": -0.01
    },
    {
      "text": "二十万现金被抢。",
      "start": 84.556,
      "continues_previous_clause": false,
      "nearest_voice_onset": 84.58,
      "delta_seconds": -0.024
    },
    {
      "text": "三座城市，",
      "start": 86.32,
      "continues_previous_clause": false,
      "nearest_voice_onset": 86.38,
      "delta_seconds": -0.06
    },
    {
      "text": "第一次连成一条线。",
      "start": 87.784,
      "continues_previous_clause": false,
      "nearest_voice_onset": 87.81,
      "delta_seconds": -0.026
    },
    {
      "text": "二〇一二年八月十日，",
      "start": 90.806,
      "continues_previous_clause": false,
      "nearest_voice_onset": 90.83,
      "delta_seconds": -0.024
    },
    {
      "text": "上午九点三十七分，",
      "start": 92.681,
      "continues_previous_clause": false,
      "nearest_voice_onset": 92.7,
      "delta_seconds": -0.019
    },
    {
      "text": "重庆沙坪坝凤鸣山，",
      "start": 94.467,
      "continues_previous_clause": false,
      "nearest_voice_onset": 94.48,
      "delta_seconds": -0.013
    },
    {
      "text": "中国银行储蓄所门前再次响起枪声：",
      "start": 96.652,
      "continues_previous_clause": false,
      "nearest_voice_onset": 96.67,
      "delta_seconds": -0.018
    },
    {
      "text": "一人不幸身亡，",
      "start": 100.258,
      "continues_previous_clause": false,
      "nearest_voice_onset": 100.27,
      "delta_seconds": -0.012
    },
    {
      "text": "两人受伤。",
      "start": 101.722,
      "continues_previous_clause": false,
      "nearest_voice_onset": 101.74,
      "delta_seconds": -0.018
    },
    {
      "text": "逃往途中，",
      "start": 102.865,
      "continues_previous_clause": false,
      "nearest_voice_onset": 102.89,
      "delta_seconds": -0.025
    },
    {
      "text": "铁路民警朱彦超上前盘查，",
      "start": 104.174,
      "continues_previous_clause": false,
      "nearest_voice_onset": 104.2,
      "delta_seconds": -0.026
    },
    {
      "text": "遭到袭击，",
      "start": 106.981,
      "continues_previous_clause": false,
      "nearest_voice_onset": 107.0,
      "delta_seconds": -0.019
    },
    {
      "text": "不幸牺牲。",
      "start": 108.123,
      "continues_previous_clause": false,
      "nearest_voice_onset": 108.15,
      "delta_seconds": -0.027
    },
    {
      "text": "当天，",
      "start": 109.188,
      "continues_previous_clause": false,
      "nearest_voice_onset": 109.21,
      "delta_seconds": -0.022
    },
    {
      "text": "重庆全城布控，",
      "start": 110.043,
      "continues_previous_clause": false,
      "nearest_voice_onset": 110.07,
      "delta_seconds": -0.027
    },
    {
      "text": "通往山外的每一条路都被设卡，",
      "start": 112.017,
      "continues_previous_clause": false,
      "nearest_voice_onset": 112.03,
      "delta_seconds": -0.013
    },
    {
      "text": "上万警力进山搜捕——",
      "start": 115.09,
      "continues_previous_clause": false,
      "nearest_voice_onset": 115.11,
      "delta_seconds": -0.02
    },
    {
      "text": "这一次，",
      "start": 117.254,
      "continues_previous_clause": false,
      "nearest_voice_onset": 117.28,
      "delta_seconds": -0.026
    },
    {
      "text": "他没能走远。",
      "start": 118.197,
      "continues_previous_clause": false,
      "nearest_voice_onset": 118.22,
      "delta_seconds": -0.023
    },
    {
      "text": "转机来自两座城市：",
      "start": 120.619,
      "continues_previous_clause": false,
      "nearest_voice_onset": 120.64,
      "delta_seconds": -0.021
    },
    {
      "text": "长沙警方拿到了他的体貌特征，",
      "start": 123.193,
      "continues_previous_clause": false,
      "nearest_voice_onset": 123.2,
      "delta_seconds": -0.007
    },
    {
      "text": "江苏警方比中了他的DNA。",
      "start": 126.111,
      "continues_previous_clause": false,
      "nearest_voice_onset": 126.13,
      "delta_seconds": -0.019
    },
    {
      "text": "八月十四日清晨，",
      "start": 128.862,
      "continues_previous_clause": false,
      "nearest_voice_onset": 128.87,
      "delta_seconds": -0.008
    },
    {
      "text": "便衣民警王晓渝、",
      "start": 130.315,
      "continues_previous_clause": false,
      "nearest_voice_onset": 130.33,
      "delta_seconds": -0.015
    },
    {
      "text": "周缙在童家桥发现了他。",
      "start": 131.902,
      "continues_previous_clause": false,
      "nearest_voice_onset": 131.92,
      "delta_seconds": -0.018
    },
    {
      "text": "察觉被跟踪后，",
      "start": 134.475,
      "continues_previous_clause": false,
      "nearest_voice_onset": 134.5,
      "delta_seconds": -0.025
    },
    {
      "text": "他突然转身，",
      "start": 136.051,
      "continues_previous_clause": false,
      "nearest_voice_onset": 136.07,
      "delta_seconds": -0.019
    },
    {
      "text": "两名民警随即上前处置——",
      "start": 137.282,
      "continues_previous_clause": false,
      "nearest_voice_onset": 137.3,
      "delta_seconds": -0.018
    },
    {
      "text": "六点五十分，",
      "start": 139.59,
      "continues_previous_clause": false,
      "nearest_voice_onset": 139.61,
      "delta_seconds": -0.02
    },
    {
      "text": "周克华当场身亡，",
      "start": 140.877,
      "continues_previous_clause": false,
      "nearest_voice_onset": 140.9,
      "delta_seconds": -0.023
    },
    {
      "text": "随身的物品全部被起获。",
      "start": 142.674,
      "continues_previous_clause": false,
      "nearest_voice_onset": 142.73,
      "delta_seconds": -0.056
    },
    {
      "text": "八年，",
      "start": 146.061,
      "continues_previous_clause": false,
      "nearest_voice_onset": 146.07,
      "delta_seconds": -0.009
    },
    {
      "text": "十起案件，",
      "start": 147.071,
      "continues_previous_clause": false,
      "nearest_voice_onset": 147.09,
      "delta_seconds": -0.019
    },
    {
      "text": "十人死亡、",
      "start": 148.447,
      "continues_previous_clause": false,
      "nearest_voice_onset": 148.48,
      "delta_seconds": -0.033
    },
    {
      "text": "六人受伤。",
      "start": 149.811,
      "continues_previous_clause": false,
      "nearest_voice_onset": 149.83,
      "delta_seconds": -0.019
    },
    {
      "text": "数字背后，",
      "start": 151.153,
      "continues_previous_clause": false,
      "nearest_voice_onset": 151.18,
      "delta_seconds": -0.027
    },
    {
      "text": "是一个个原本普通的日子：",
      "start": 152.374,
      "continues_previous_clause": false,
      "nearest_voice_onset": 152.4,
      "delta_seconds": -0.026
    },
    {
      "text": "有人只是去取一笔钱，",
      "start": 155.236,
      "continues_previous_clause": false,
      "nearest_voice_onset": 155.25,
      "delta_seconds": -0.014
    },
    {
      "text": "有人只是站在哨位上，",
      "start": 157.166,
      "continues_previous_clause": false,
      "nearest_voice_onset": 157.18,
      "delta_seconds": -0.014
    },
    {
      "text": "有人只是路过。",
      "start": 159.063,
      "continues_previous_clause": false,
      "nearest_voice_onset": 159.08,
      "delta_seconds": -0.017
    },
    {
      "text": "追捕结束了，",
      "start": 160.428,
      "continues_previous_clause": false,
      "nearest_voice_onset": 160.45,
      "delta_seconds": -0.022
    },
    {
      "text": "但那些没能回家的人不会回来。",
      "start": 162.003,
      "continues_previous_clause": false,
      "nearest_voice_onset": 162.03,
      "delta_seconds": -0.027
    },
    {
      "text": "十年之后再看，",
      "start": 164.843,
      "continues_previous_clause": false,
      "nearest_voice_onset": 164.88,
      "delta_seconds": -0.037
    },
    {
      "text": "这仍然是一道关于公共安全的伤口。",
      "start": 166.574,
      "continues_previous_clause": false,
      "nearest_voice_onset": 166.6,
      "delta_seconds": -0.026
    },
    {
      "text": "这不是传奇，",
      "start": 169.958,
      "continues_previous_clause": false,
      "nearest_voice_onset": 169.98,
      "delta_seconds": -0.022
    },
    {
      "text": "是一段必须被记住的代价。",
      "start": 171.345,
      "continues_previous_clause": false,
      "nearest_voice_onset": 171.38,
      "delta_seconds": -0.035
    }
  ],
