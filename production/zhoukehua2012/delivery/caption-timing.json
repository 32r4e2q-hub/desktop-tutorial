[
  {
    "start": 0.7500426374596489,
    "end": 2.850639561894735,
    "text": "二〇一二年八月十四日，"
  },
  {
    "start": 3.185350060843182,
    "end": 4.547275539323073,
    "text": "清晨六点四十，"
  },
  {
    "start": 4.778110366184071,
    "end": 6.093868879291762,
    "text": "重庆沙坪坝，"
  },
  {
    "start": 6.324703706152762,
    "end": 7.259584754939805,
    "text": "童家桥。"
  },
  {
    "start": 7.594295253888252,
    "end": 10.59514800308123,
    "text": "两名便衣民警在巷口发现了一个人——"
  },
  {
    "start": 10.88369153665748,
    "end": 13.261290253325763,
    "text": "一个被追了八年的名字："
  },
  {
    "start": 13.58445901093116,
    "end": 14.657840955834804,
    "text": "周克华。"
  },
  {
    "start": 14.981009713440203,
    "end": 15.812015090139795,
    "text": "十分钟后，"
  },
  {
    "start": 16.135183847745196,
    "end": 17.093148379218338,
    "text": "枪声响起。"
  },
  {
    "start": 17.416317136823736,
    "end": 18.00494594531928,
    "text": "八年里，"
  },
  {
    "start": 18.33965644426773,
    "end": 21.859887553897956,
    "text": "这个名字反复出现在三座城市的案卷上。"
  },
  {
    "start": 22.206139794189454,
    "end": 23.279521739093095,
    "text": "八年追捕，"
  },
  {
    "start": 23.510356565954098,
    "end": 26.55737628051927,
    "text": "为什么会在最后四天突然收网？"
  },
  {
    "start": 27.77587717663587,
    "end": 32.02323799087824,
    "text": "故事要从二〇〇四年四月二十二日说起。"
  },
  {
    "start": 32.34640674848364,
    "end": 32.888868591606986,
    "text": "重庆，"
  },
  {
    "start": 33.22357909055543,
    "end": 35.83201263408471,
    "text": "两名女子刚从银行取完钱，"
  },
  {
    "start": 36.16672313303316,
    "end": 37.747941697031,
    "text": "枪声突然响起，"
  },
  {
    "start": 38.08265219597945,
    "end": 39.04061672745259,
    "text": "一死一伤，"
  },
  {
    "start": 39.352243743714936,
    "end": 40.714169222194826,
    "text": "七万元被抢走。"
  },
  {
    "start": 41.04887972114328,
    "end": 41.78755116709847,
    "text": "一年后，"
  },
  {
    "start": 42.122261666046924,
    "end": 44.776862174948405,
    "text": "又一对夫妻在银行门口遇袭，"
  },
  {
    "start": 45.0769474498677,
    "end": 46.25420506685879,
    "text": "一名路人中枪。"
  },
  {
    "start": 46.57737382446419,
    "end": 48.21630109517728,
    "text": "二〇〇九年三月，"
  },
  {
    "start": 48.551011594125725,
    "end": 50.109146675437465,
    "text": "重庆石桥铺，"
  },
  {
    "start": 50.44385717438591,
    "end": 51.88657484226715,
    "text": "执勤哨兵遇害，"
  },
  {
    "start": 52.20974359987255,
    "end": 54.36804923102289,
    "text": "一支自动步枪被抢走。"
  },
  {
    "start": 54.69121798862829,
    "end": 56.95339929186607,
    "text": "这就是系列案的起点。"
  },
  {
    "start": 58.12573322261047,
    "end": 59.09523949542666,
    "text": "专案组发现，"
  },
  {
    "start": 59.31453258094461,
    "end": 61.022710299715996,
    "text": "这些案子不像临时起意："
  },
  {
    "start": 61.3458790573214,
    "end": 63.49264294712868,
    "text": "只挑刚从银行取款的人，"
  },
  {
    "start": 63.81581170473408,
    "end": 65.50090594081937,
    "text": "只走人流密集的老街，"
  },
  {
    "start": 65.82407469842477,
    "end": 67.42837674510871,
    "text": "作案后立刻消失。"
  },
  {
    "start": 67.76308724405715,
    "end": 70.42922949430168,
    "text": "二〇〇九年到二〇一一年，"
  },
  {
    "start": 70.75239825190708,
    "end": 72.54136816007981,
    "text": "长沙接连发生枪击；"
  },
  {
    "start": 72.86453691768521,
    "end": 75.0113008074925,
    "text": "二〇一二年一月六日，"
  },
  {
    "start": 75.3113860824118,
    "end": 78.02369529802853,
    "text": "南京下关区一家银行门口，"
  },
  {
    "start": 78.35840579697698,
    "end": 80.26279311858022,
    "text": "一名提款人当场身亡，"
  },
  {
    "start": 80.58596187618562,
    "end": 82.0402212854099,
    "text": "二十万现金被抢。"
  },
  {
    "start": 82.3633900430153,
    "end": 83.93306686567009,
    "text": "苏湘渝三地，"
  },
  {
    "start": 84.26777736461854,
    "end": 86.3164364530099,
    "text": "第一次连成一条线。"
  },
  {
    "start": 87.5349373491265,
    "end": 89.28928203327008,
    "text": "二〇一二年八月十日，"
  },
  {
    "start": 89.48549163610193,
    "end": 90.99745975204148,
    "text": "上午九点三十七分，"
  },
  {
    "start": 91.34371199233297,
    "end": 93.28272453796535,
    "text": "重庆沙坪坝凤鸣山，"
  },
  {
    "start": 93.6174350369138,
    "end": 97.04533221579963,
    "text": "中国银行储蓄所门前再次响起枪声："
  },
  {
    "start": 97.36850097340503,
    "end": 98.64963426248357,
    "text": "一人不幸身亡，"
  },
  {
    "start": 98.89201083068762,
    "end": 99.74609969007331,
    "text": "两人受伤。"
  },
  {
    "start": 100.08081018902176,
    "end": 101.1080251685532,
    "text": "逃往途中，"
  },
  {
    "start": 101.44273566750165,
    "end": 104.05116921103094,
    "text": "铁路民警朱彦超上前盘查，"
  },
  {
    "start": 104.36279622729329,
    "end": 105.21688508667897,
    "text": "遭到袭击，"
  },
  {
    "start": 105.55159558562742,
    "end": 106.32489225561177,
    "text": "不幸牺牲。"
  },
  {
    "start": 106.65960275456021,
    "end": 107.22514808036966,
    "text": "当天，"
  },
  {
    "start": 107.54831683797507,
    "end": 109.2680362980895,
    "text": "重庆全城布控，"
  },
  {
    "start": 109.60274679703795,
    "end": 112.46509865011433,
    "text": "通往山外的每一条路都被设卡，"
  },
  {
    "start": 112.79980914906278,
    "end": 114.72727995335211,
    "text": "上万警力进山搜捕——"
  },
  {
    "start": 115.05044871095751,
    "end": 115.7198697088544,
    "text": "这一次，"
  },
  {
    "start": 116.03149672511675,
    "end": 117.3357134968814,
    "text": "他没能走远。"
  },
  {
    "start": 118.5080474276258,
    "end": 120.85102092026493,
    "text": "转机来自两座城市："
  },
  {
    "start": 121.18573141921338,
    "end": 123.874957152144,
    "text": "长沙警方拿到了他的体貌特征，"
  },
  {
    "start": 124.22120939243551,
    "end": 126.67960029850514,
    "text": "江苏警方比中了他的DNA。"
  },
  {
    "start": 127.08356124551189,
    "end": 128.38777801727653,
    "text": "八月十四日清晨，"
  },
  {
    "start": 128.59552936145144,
    "end": 130.13058096007705,
    "text": "便衣民警王晓渝、"
  },
  {
    "start": 130.24599837350758,
    "end": 132.60051360748975,
    "text": "周缙在童家桥发现了他。"
  },
  {
    "start": 132.92368236509515,
    "end": 134.44719222237774,
    "text": "察觉被跟踪后，"
  },
  {
    "start": 134.56260963580823,
    "end": 135.50903242593833,
    "text": "他突然转身，"
  },
  {
    "start": 135.84374292488678,
    "end": 137.9097146252927,
    "text": "两名民警随即上前处置——"
  },
  {
    "start": 138.24442512424116,
    "end": 139.35243229317396,
    "text": "六点五十分，"
  },
  {
    "start": 139.58326712003495,
    "end": 141.1183187186606,
    "text": "周克华当场身亡，"
  },
  {
    "start": 141.45302921760904,
    "end": 143.71521052084682,
    "text": "随身的物品全部被起获。"
  },
  {
    "start": 144.9337114169634,
    "end": 145.66084112157554,
    "text": "八年，"
  },
  {
    "start": 145.98400987918095,
    "end": 147.09201704811375,
    "text": "十起案件，"
  },
  {
    "start": 147.41518580571915,
    "end": 148.52319297465192,
    "text": "十人死亡、"
  },
  {
    "start": 148.83481999091427,
    "end": 149.89666019447486,
    "text": "六人受伤。"
  },
  {
    "start": 150.23137069342332,
    "end": 151.17779348355342,
    "text": "数字背后，"
  },
  {
    "start": 151.50096224115882,
    "end": 154.14402100871723,
    "text": "是一个个原本普通的日子："
  },
  {
    "start": 154.47873150766569,
    "end": 156.15228400240792,
    "text": "有人只是去取一笔钱，"
  },
  {
    "start": 156.48699450135638,
    "end": 158.12592177206946,
    "text": "有人只是站在哨位上，"
  },
  {
    "start": 158.46063227101791,
    "end": 159.5455559572646,
    "text": "有人只是路过。"
  },
  {
    "start": 159.88026645621306,
    "end": 161.19602496932075,
    "text": "追捕结束了，"
  },
  {
    "start": 161.51919372692615,
    "end": 164.16225249448456,
    "text": "但那些没能回家的人不会回来。"
  },
  {
    "start": 164.47387951074694,
    "end": 165.93968066131427,
    "text": "十年之后再看，"
  },
  {
    "start": 166.27439116026272,
    "end": 169.45991177094447,
    "text": "这仍然是一道关于公共安全的伤口。"
  },
  {
    "start": 169.79462226989293,
    "end": 170.91417118016878,
    "text": "这不是传奇，"
  },
  {
    "start": 171.23733993777418,
    "end": 173.99999999999997,
    "text": "是一段必须被记住的代价。"
  }
]