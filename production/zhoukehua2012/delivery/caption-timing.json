[
  {
    "start": 0.7442216020385168,
    "end": 2.763324030577753,
    "text": "二〇一二年八月十四日，"
  },
  {
    "start": 3.0850491428175215,
    "end": 4.394137530551752,
    "text": "清晨六点四十，"
  },
  {
    "start": 4.616016918303316,
    "end": 5.880729428487233,
    "text": "重庆沙坪坝，"
  },
  {
    "start": 6.102608816238798,
    "end": 7.001220336632634,
    "text": "童家桥。"
  },
  {
    "start": 7.322945448872402,
    "end": 10.207377489642738,
    "text": "两名便衣民警在巷口发现了一个人——"
  },
  {
    "start": 10.484726724332194,
    "end": 12.770084418173306,
    "text": "一个被追了八年的名字："
  },
  {
    "start": 13.080715561025498,
    "end": 14.112454714070273,
    "text": "周克华。"
  },
  {
    "start": 14.423085856922464,
    "end": 15.221851652828095,
    "text": "十分钟后，"
  },
  {
    "start": 15.532482795680286,
    "end": 16.453282254849277,
    "text": "枪声响起。"
  },
  {
    "start": 16.76391339770147,
    "end": 17.32970583646796,
    "text": "八年里，"
  },
  {
    "start": 17.651430948707727,
    "end": 21.035091611919082,
    "text": "这个名字反复出现在三座城市的案卷上。"
  },
  {
    "start": 21.36791069354643,
    "end": 22.399649846591203,
    "text": "八年追捕，"
  },
  {
    "start": 22.621529234342773,
    "end": 25.55033715266342,
    "text": "为什么会在最后四天突然收网？"
  },
  {
    "start": 26.77455875470194,
    "end": 31.51168368319784,
    "text": "故事要从二〇〇四年四月二十二日说起。"
  },
  {
    "start": 31.844502764825187,
    "end": 32.51014092807988,
    "text": "重庆，"
  },
  {
    "start": 32.82077207093207,
    "end": 35.33910312191232,
    "text": "两名女子刚从银行取完钱，"
  },
  {
    "start": 35.56098250966389,
    "end": 37.014292499436635,
    "text": "枪声突然响起，"
  },
  {
    "start": 37.336017611676404,
    "end": 38.3566627953336,
    "text": "一死一伤，"
  },
  {
    "start": 38.65619996879821,
    "end": 39.998570264695175,
    "text": "七万元被抢走。"
  },
  {
    "start": 40.30920140754737,
    "end": 41.01921544835237,
    "text": "一年后，"
  },
  {
    "start": 41.274376744266675,
    "end": 43.69286207075872,
    "text": "又一对夫妻在银行门口遇袭，"
  },
  {
    "start": 44.003493213610916,
    "end": 45.201641907469366,
    "text": "一名路人中枪。"
  },
  {
    "start": 45.523367019709134,
    "end": 46.233381060514134,
    "text": "二〇〇五年，"
  },
  {
    "start": 46.34432075438992,
    "end": 48.92921562169565,
    "text": "他因非法持枪入狱，"
  },
  {
    "start": 49.250940733935415,
    "end": 50.87066026452183,
    "text": "二〇〇八年出狱。"
  },
  {
    "start": 51.13691552982371,
    "end": 52.5680375808213,
    "text": "二〇〇九年三月，"
  },
  {
    "start": 52.834292846123176,
    "end": 54.099005356307096,
    "text": "重庆石桥铺，"
  },
  {
    "start": 54.2543209277332,
    "end": 55.552315346079844,
    "text": "执勤哨兵遇害，"
  },
  {
    "start": 55.86294648893204,
    "end": 57.85986097869611,
    "text": "一支自动步枪被抢走。"
  },
  {
    "start": 58.148304182773145,
    "end": 60.32272218273848,
    "text": "这就是系列案的起点。"
  },
  {
    "start": 61.546943784777,
    "end": 62.6119648459845,
    "text": "专案组发现，"
  },
  {
    "start": 62.93368995822427,
    "end": 65.5740546724679,
    "text": "这些案子不像临时起意："
  },
  {
    "start": 65.89577978470766,
    "end": 68.23660732548666,
    "text": "只挑刚从银行取款的人，"
  },
  {
    "start": 68.55833243772643,
    "end": 70.64399868259113,
    "text": "只走人流密集的老街，"
  },
  {
    "start": 70.96572379483091,
    "end": 72.91826240704466,
    "text": "作案后立刻消失。"
  },
  {
    "start": 73.23998751928444,
    "end": 75.48096933557524,
    "text": "二〇〇九年到二〇一一年，"
  },
  {
    "start": 75.80269444781501,
    "end": 77.42241397840144,
    "text": "长沙接连发生枪击；"
  },
  {
    "start": 77.73304512125362,
    "end": 79.45261037632824,
    "text": "二〇一二年一月六日，"
  },
  {
    "start": 79.76324151918044,
    "end": 82.29266653954826,
    "text": "南京下关区一家银行门口，"
  },
  {
    "start": 82.47017004974953,
    "end": 84.23411118237445,
    "text": "一名提款人当场身亡，"
  },
  {
    "start": 84.55583629461422,
    "end": 85.9980523149994,
    "text": "二十万现金被抢。"
  },
  {
    "start": 86.31977742723916,
    "end": 87.48464421293488,
    "text": "三座城市，"
  },
  {
    "start": 87.7841813863995,
    "end": 89.59249839657474,
    "text": "第一次连成一条线。"
  },
  {
    "start": 90.80562602922568,
    "end": 92.49190937613757,
    "text": "二〇一二年八月十日，"
  },
  {
    "start": 92.68050685572639,
    "end": 94.13381684549914,
    "text": "上午九点三十七分，"
  },
  {
    "start": 94.46663592712649,
    "end": 96.33042278423963,
    "text": "重庆沙坪坝凤鸣山，"
  },
  {
    "start": 96.6521478964794,
    "end": 99.94705680459013,
    "text": "中国银行储蓄所门前再次响起枪声："
  },
  {
    "start": 100.25768794744232,
    "end": 101.4891185494635,
    "text": "一人不幸身亡，"
  },
  {
    "start": 101.72209190660264,
    "end": 102.54304564128344,
    "text": "两人受伤。"
  },
  {
    "start": 102.8647707535232,
    "end": 103.85213402901766,
    "text": "逃往途中，"
  },
  {
    "start": 104.17385914125744,
    "end": 106.68109622285012,
    "text": "铁路民警朱彦超上前盘查，"
  },
  {
    "start": 106.98063339631473,
    "end": 107.80158713099551,
    "text": "遭到袭击，"
  },
  {
    "start": 108.12331224323528,
    "end": 108.86660819220302,
    "text": "不幸牺牲。"
  },
  {
    "start": 109.18833330444279,
    "end": 109.73193780443412,
    "text": "当天，"
  },
  {
    "start": 110.04256894728631,
    "end": 111.69557038603547,
    "text": "重庆全城布控，"
  },
  {
    "start": 112.01729549827525,
    "end": 114.76859990639463,
    "text": "通往山外的每一条路都被设卡，"
  },
  {
    "start": 115.0903250186344,
    "end": 116.94301790635997,
    "text": "上万警力进山搜捕——"
  },
  {
    "start": 117.25364904921216,
    "end": 117.8970992736917,
    "text": "这一次，"
  },
  {
    "start": 118.19663644715631,
    "end": 119.45025498795265,
    "text": "他没能走远。"
  },
  {
    "start": 120.61900674305328,
    "end": 122.87108252873165,
    "text": "转机来自两座城市："
  },
  {
    "start": 123.19280764097142,
    "end": 125.77770250827714,
    "text": "长沙警方拿到了他的体貌特征，"
  },
  {
    "start": 126.1105215899045,
    "end": 128.47353706945864,
    "text": "江苏警方比中了他的DNA。"
  },
  {
    "start": 128.8618259980239,
    "end": 130.1154445388202,
    "text": "八月十四日清晨，"
  },
  {
    "start": 130.31513598779662,
    "end": 131.79063391634455,
    "text": "便衣民警王晓渝、"
  },
  {
    "start": 131.9015736102203,
    "end": 134.16474336528628,
    "text": "周缙在童家桥发现了他。"
  },
  {
    "start": 134.47537450813846,
    "end": 135.9397784672988,
    "text": "察觉被跟踪后，"
  },
  {
    "start": 136.0507181611746,
    "end": 136.960423650956,
    "text": "他突然转身，"
  },
  {
    "start": 137.28214876319575,
    "end": 139.26796928357226,
    "text": "两名民警随即上前处置——"
  },
  {
    "start": 139.58969439581202,
    "end": 140.65471545701953,
    "text": "六点五十分，"
  },
  {
    "start": 140.8765948447711,
    "end": 142.35209277331901,
    "text": "周克华当场身亡，"
  },
  {
    "start": 142.67381788555878,
    "end": 144.8482358855241,
    "text": "随身的物品全部被起获。"
  },
  {
    "start": 146.06136351817506,
    "end": 146.7602835895925,
    "text": "八年，"
  },
  {
    "start": 147.07091473244466,
    "end": 148.13593579365218,
    "text": "十起案件，"
  },
  {
    "start": 148.44656693650438,
    "end": 149.51158799771187,
    "text": "十人死亡、"
  },
  {
    "start": 149.81112517117649,
    "end": 150.83177035483368,
    "text": "六人受伤。"
  },
  {
    "start": 151.15349546707347,
    "end": 152.06320095685487,
    "text": "数字背后，"
  },
  {
    "start": 152.37383209970707,
    "end": 154.91435108946249,
    "text": "是一个个原本普通的日子："
  },
  {
    "start": 155.23607620170225,
    "end": 156.84470176290108,
    "text": "有人只是去取一笔钱，"
  },
  {
    "start": 157.16642687514084,
    "end": 158.74177052817697,
    "text": "有人只是站在哨位上，"
  },
  {
    "start": 159.06349564041673,
    "end": 160.10632876284907,
    "text": "有人只是路过。"
  },
  {
    "start": 160.42805387508886,
    "end": 161.69276638527276,
    "text": "追捕结束了，"
  },
  {
    "start": 162.00339752812496,
    "end": 164.54391651788038,
    "text": "但那些没能回家的人不会回来。"
  },
  {
    "start": 164.843453691345,
    "end": 166.25238780356742,
    "text": "十年之后再看，"
  },
  {
    "start": 166.57411291580718,
    "end": 169.6360484667788,
    "text": "这仍然是一道关于公共安全的伤口。"
  },
  {
    "start": 169.95777357901855,
    "end": 171.03388860961363,
    "text": "这不是传奇，"
  },
  {
    "start": 171.34451975246583,
    "end": 174.0,
    "text": "是一段必须被记住的代价。"
  }
]