    "chars_per_second": 5.8
   },
   {
    "i": 3,
    "start": 7.53,
    "end": 8.6,
    "text": "八月十四日清晨",
    "chars_per_second": 6.54
   },
   {
    "i": 4,
    "start": 8.84,
    "end": 10.11,
    "text": "便衣民警王晓渝",
    "chars_per_second": 5.51
   },
   {
    "i": 5,
    "start": 10.27,
    "end": 12.25,
    "text": "周缙在童家桥发现了他",
    "chars_per_second": 5.05
   },
   {
    "i": 6,
    "start": 12.59,
    "end": 13.85,
    "text": "察觉被跟踪后",
    "chars_per_second": 4.76
   },
   {
    "i": 7,
    "start": 14.01,
    "end": 14.77,
