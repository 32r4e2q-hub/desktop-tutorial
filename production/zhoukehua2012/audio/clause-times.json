    "chars_per_second": 5.15
   },
   {
    "i": 4,
    "start": 8.66,
    "end": 9.71,
    "text": "一人不幸身亡",
    "chars_per_second": 5.71
   },
   {
    "i": 5,
    "start": 9.98,
    "end": 10.66,
    "text": "两人受伤",
    "chars_per_second": 5.88
   },
   {
    "i": 6,
    "start": 11.01,
    "end": 11.84,
    "text": "逃往途中",
    "chars_per_second": 4.82
   },
   {
    "i": 7,
    "start": 12.19,
    "end": 14.39,
    "text": "铁路民警朱彦超上前盘查",
    "chars_per_second": 5.0
   },
   {
    "i": 8,
    "start": 14.72,
    "end": 15.4,
    "text": "遭到袭击",
    "chars_per_second": 5.88
   },
   {
    "i": 9,
    "start": 15.75,
    "end": 16.36,
