    "chars_per_second": 5.78
   },
   {
    "i": 9,
    "start": 17.2,
    "end": 18.1,
    "text": "六点五十分",
    "chars_per_second": 5.56
   },
   {
    "i": 10,
    "start": 18.36,
    "end": 19.63,
    "text": "周克华当场身亡",
    "chars_per_second": 5.51
   },
   {
    "i": 11,
    "start": 19.98,
    "end": 21.92,
    "text": "随身的物品全部被起获",
    "chars_per_second": 5.15
   }
  ]
 },
 "N06": {
  "duration": 25.304,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.71,
    "text": "八年",
    "chars_per_second": 3.51
   },
   {
    "i": 1,
    "start": 1.05,
    "end": 1.95,
    "text": "十起案件",
    "chars_per_second": 4.44
   },
   {
    "i": 2,
    "start": 2.29,
    "end": 3.19,
    "text": "十人死亡",
    "chars_per_second": 4.44
   },
   {
    "i": 3,
    "start": 3.52,
    "end": 4.38,
    "text": "六人受伤",
    "chars_per_second": 4.65
   },
   {
    "i": 4,
    "start": 4.73,
    "end": 5.49,
    "text": "数字背后",
    "chars_per_second": 5.26
   },
   {
    "i": 5,
    "start": 5.83,
    "end": 8.06,
    "text": "是一个个原本普通的日子",
    "chars_per_second": 4.93
   },
   {
    "i": 6,
    "start": 8.41,
    "end": 9.8,
    "text": "有人只是去取一笔钱",
    "chars_per_second": 6.47
   },
   {
    "i": 7,
    "start": 10.15,
    "end": 11.51,
    "text": "有人只是站在哨位上",
    "chars_per_second": 6.62
   },
   {
    "i": 8,
    "start": 11.86,
    "end": 12.74,
    "text": "有人只是路过",
    "chars_per_second": 6.82
   },
   {
    "i": 9,
    "start": 13.09,
    "end": 14.17,
    "text": "追捕结束了",
    "chars_per_second": 4.63
   },
   {
    "i": 10,
    "start": 14.51,
    "end": 16.74,
    "text": "但那些没能回家的人不会回来",
    "chars_per_second": 5.83
   },
   {
    "i": 11,
    "start": 17.07,
    "end": 18.28,
    "text": "十年之后再看",
    "chars_per_second": 4.96
   },
   {
    "i": 12,
    "start": 18.63,
    "end": 21.33,
    "text": "这仍然是一道关于公共安全的伤口",
    "chars_per_second": 5.56
   },
   {
    "i": 13,
    "start": 21.68,
    "end": 22.59,
    "text": "这不是传奇",
    "chars_per_second": 5.49
   },
   {
    "i": 14,
    "start": 22.93,
    "end": 25.3,
    "text": "是一段必须被记住的代价",
    "chars_per_second": 4.63
   }
  ]
 }
}