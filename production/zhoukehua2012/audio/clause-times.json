{
 "N01": {
  "duration": 22.49,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.91,
    "text": "二〇一二年八月十四日",
    "chars_per_second": 5.11
   },
   {
    "i": 1,
    "start": 2.26,
    "end": 3.38,
    "text": "清晨六点四十",
    "chars_per_second": 5.36
   },
   {
    "i": 2,
    "start": 3.64,
    "end": 4.72,
    "text": "重庆沙坪坝",
    "chars_per_second": 4.63
   },
   {
    "i": 3,
    "start": 4.98,
    "end": 5.73,
    "text": "童家桥",
    "chars_per_second": 4.0
   },
   {
    "i": 4,
    "start": 6.08,
    "end": 8.62,
    "text": "两名便衣民警在巷口发现了一个人",
    "chars_per_second": 5.91
   },
   {
    "i": 5,
    "start": 8.93,
    "end": 10.93,
    "text": "一个被追了八年的名字",
    "chars_per_second": 5.0
   },
   {
    "i": 6,
    "start": 11.27,
    "end": 12.14,
    "text": "周克华",
    "chars_per_second": 3.45
   },
   {
    "i": 7,
    "start": 12.48,
    "end": 13.14,
    "text": "十分钟后",
    "chars_per_second": 6.06
   },
   {
    "i": 8,
    "start": 13.48,
    "end": 14.25,
    "text": "枪声响起",
    "chars_per_second": 5.19
   },
   {
    "i": 9,
    "start": 14.59,
    "end": 15.04,
    "text": "八年里",
    "chars_per_second": 6.67
   },
   {
    "i": 10,
    "start": 15.39,
    "end": 18.38,
    "text": "这个名字反复出现在三座城市的案卷上",
    "chars_per_second": 5.69
   },
   {
    "i": 11,
    "start": 18.74,
    "end": 19.61,
    "text": "八年追捕",
    "chars_per_second": 4.6
   },
   {
    "i": 12,
    "start": 19.87,
    "end": 22.49,
    "text": "为什么会在最后四天突然收网",
    "chars_per_second": 4.96
   }
  ]
 },
 "N02": {
  "duration": 30.37,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 4.36,
    "text": "故事要从二〇〇四年四月二十二日说起",
    "chars_per_second": 3.56
   },
   {
    "i": 1,
    "start": 4.72,
    "end": 5.26,
    "text": "重庆",
    "chars_per_second": 3.7
   },
   {
    "i": 2,
    "start": 5.6,
    "end": 7.81,
    "text": "两名女子刚从银行取完钱",
    "chars_per_second": 4.98
   },
   {
    "i": 3,
    "start": 8.07,
    "end": 9.32,
    "text": "枪声突然响起",
    "chars_per_second": 4.8
   },
   {
    "i": 4,
    "start": 9.67,
    "end": 10.53,
    "text": "一死一伤",
    "chars_per_second": 4.65
   },
   {
    "i": 5,
    "start": 10.86,
    "end": 12.01,
    "text": "七万元被抢走",
    "chars_per_second": 5.22
   },
   {
    "i": 6,
    "start": 12.35,
    "end": 12.93,
    "text": "一年后",
    "chars_per_second": 5.17
   },
   {
    "i": 7,
    "start": 13.22,
    "end": 15.34,
    "text": "又一对夫妻在银行门口遇袭",
    "chars_per_second": 5.66
   },
   {
    "i": 8,
    "start": 15.68,
    "end": 16.7,
    "text": "一名路人中枪",
    "chars_per_second": 5.88
   },
   {
    "i": 9,
    "start": 17.05,
    "end": 17.63,
    "text": "二〇〇五年",
    "chars_per_second": 5.17
   },
   {
    "i": 10,
    "start": 17.79,
    "end": 20.06,
    "text": "他因非法持枪入狱",
    "chars_per_second": 3.52
   },
   {
    "i": 11,
    "start": 20.41,
    "end": 21.81,
    "text": "二〇〇八年出狱",
    "chars_per_second": 3.57
   },
   {
    "i": 12,
    "start": 22.11,
    "end": 23.34,
    "text": "二〇〇九年三月",
    "chars_per_second": 4.07
   },
   {
    "i": 13,
    "start": 23.64,
    "end": 24.72,
    "text": "重庆石桥铺",
    "chars_per_second": 4.63
   },
   {
    "i": 14,
    "start": 24.92,
    "end": 26.03,
    "text": "执勤哨兵遇害",
    "chars_per_second": 5.41
   },
   {
    "i": 15,
    "start": 26.37,
    "end": 28.11,
    "text": "一支自动步枪被抢走",
    "chars_per_second": 5.17
   },
   {
    "i": 16,
    "start": 28.43,
    "end": 30.37,
    "text": "这就是系列案的起点",
    "chars_per_second": 4.64
   }
  ]
 },
 "N03": {
  "duration": 25.41,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.05,
    "text": "专案组发现",
    "chars_per_second": 5.56
   },
   {
    "i": 1,
    "start": 1.4,
    "end": 3.72,
    "text": "这些案子不像临时起意",
    "chars_per_second": 4.31
   },
   {
    "i": 2,
    "start": 4.07,
    "end": 6.12,
    "text": "只挑刚从银行取款的人",
    "chars_per_second": 4.88
   },
   {
    "i": 3,
    "start": 6.47,
    "end": 8.29,
    "text": "只走人流密集的老街",
    "chars_per_second": 4.95
   },
   {
    "i": 4,
    "start": 8.64,
    "end": 10.34,
    "text": "作案后立刻消失",
    "chars_per_second": 4.12
   },
   {
    "i": 5,
    "start": 10.69,
    "end": 12.65,
    "text": "二〇〇九年到二〇一一年",
    "chars_per_second": 4.08
   },
   {
    "i": 6,
    "start": 13.0,
    "end": 14.4,
    "text": "长沙接连发生枪击",
    "chars_per_second": 5.71
   },
   {
    "i": 7,
    "start": 14.74,
    "end": 16.23,
    "text": "二〇一二年一月六日",
    "chars_per_second": 5.37
   },
   {
    "i": 8,
    "start": 16.57,
    "end": 18.79,
    "text": "南京下关区一家银行门口",
    "chars_per_second": 4.95
   },
   {
    "i": 9,
    "start": 19.01,
    "end": 20.54,
    "text": "一名提款人当场身亡",
    "chars_per_second": 5.88
   },
   {
    "i": 10,
    "start": 20.89,
    "end": 22.13,
    "text": "二十万现金被抢",
    "chars_per_second": 5.65
   },
   {
    "i": 11,
    "start": 22.48,
    "end": 23.47,
    "text": "三座城市",
    "chars_per_second": 4.04
   },
   {
    "i": 12,
    "start": 23.8,
    "end": 25.41,
    "text": "第一次连成一条线",
    "chars_per_second": 4.97
   }
  ]
 },
 "N04": {
  "duration": 25.94,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.6,
    "text": "二〇一二年八月十日",
    "chars_per_second": 5.48
   },
   {
    "i": 1,
    "start": 1.83,
    "end": 3.08,
