    "text": "重庆全城布控",
    "chars_per_second": 4.2
   },
   {
    "i": 12,
    "start": 19.26,
    "end": 21.68,
    "text": "通往山外的每一条路都被设卡",
    "chars_per_second": 5.37
   },
   {
    "i": 13,
    "start": 22.03,
    "end": 23.64,
    "text": "上万警力进山搜捕",
    "chars_per_second": 4.97
   },
   {
    "i": 14,
    "start": 23.98,
    "end": 24.5,
    "text": "这一次",
    "chars_per_second": 5.77
   },
   {
    "i": 15,
    "start": 24.83,
    "end": 25.94,
    "text": "他没能走远",
    "chars_per_second": 4.5
   }
  ]
 },
 "N05": {
  "duration": 21.92,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 2.07,
