[
  {
    "start": 0.61,
    "end": 2.9473076923076924,
    "text": "一九九一年一月二十九日，"
  },
  {
    "start": 2.9473076923076924,
    "end": 4.173461538461538,
    "text": "首尔狎鸥亭。"
  },
  {
    "start": 4.173461538461538,
    "end": 7.59,
    "text": "九岁的李亨浩在公寓旁的游乐场玩耍，"
  },
  {
    "start": 7.59,
    "end": 9.490000000000002,
    "text": "傍晚却没有回家。"
  },
  {
    "start": 9.490000000000002,
    "end": 10.81,
    "text": "深夜十一点，"
  },
  {
    "start": 11.05,
    "end": 12.290000000000001,
    "text": "父亲接到电话，"
  },
  {
    "start": 12.610000000000001,
    "end": 15.25,
    "text": "来电者声称孩子在他手上，"
  },
  {
    "start": 15.278461538461539,
    "end": 17.14423076923077,
    "text": "并索要七千万韩元，"
  },
  {
    "start": 17.14423076923077,
    "end": 20.33,
    "text": "还要求一辆装有车载电话的车。"
  },
  {
    "start": 20.33,
    "end": 23.87,
    "text": "没有镜头能替这家人把时间倒回去；"
  },
  {
    "start": 23.87,
    "end": 25.59,
    "text": "从这个夜晚开始，"
  },
  {
    "start": 25.59,
    "end": 28.79,
    "text": "电话铃声成了他们唯一的线索。"
  },
  {
    "start": 30.461000000000002,
    "end": 32.900999999999996,
    "text": "赎金并没有换来一次清楚的交接。"
  },
  {
    "start": 32.900999999999996,
    "end": 35.221000000000004,
    "text": "来电者不断更换地点，"
  },
  {
    "start": 35.221000000000004,
    "end": 38.881,
    "text": "也曾要求家人把钱汇进指定账户。"
  },
  {
    "start": 39.401,
    "end": 40.921,
    "text": "父亲在首尔街头往返，"
  },
  {
    "start": 41.321,
    "end": 42.400999999999996,
    "text": "记下每个地址、"
  },
  {
    "start": 42.400999999999996,
    "end": 43.601,
    "text": "每句指令；"
  },
  {
    "start": 43.601,
    "end": 47.221000000000004,
    "text": "家人不知道下一通电话会带来希望，"
  },
  {
    "start": 47.221000000000004,
    "end": 48.941,
    "text": "还是另一个陷阱。"
  },
  {
    "start": 48.941,
    "end": 50.381,
    "text": "多家媒体回顾，"
  },
  {
    "start": 50.381,
    "end": 53.400999999999996,
    "text": "案件中出现了六十多通勒索电话；"
  },
  {
    "start": 53.400999999999996,
    "end": 55.120999999999995,
    "text": "但每个号码背后，"
  },
  {
    "start": 55.120999999999995,
    "end": 57.841,
    "text": "都没有一个能被确认的姓名。"
  },
  {
    "start": 58.728,
    "end": 61.208,
    "text": "警方与家属尝试布控，"
  },
  {
    "start": 61.428000000000004,
    "end": 62.867999999999995,
    "text": "盯守交钱地点，"
  },
  {
    "start": 63.00261538461538,
    "end": 65.0706923076923,
    "text": "核查账户与银行线索。"
  },
  {
    "start": 65.0706923076923,
    "end": 66.228,
    "text": "一次交接中，"
  },
  {
    "start": 66.508,
    "end": 69.30799999999999,
    "text": "警员因联络错位守错位置，"
  },
  {
    "start": 69.43184615384615,
    "end": 70.77146153846154,
    "text": "取钱者脱身。"
  },
  {
    "start": 70.77146153846154,
    "end": 71.608,
    "text": "后来，"
  },
  {
    "start": 71.728,
    "end": 75.52799999999999,
    "text": "存款记录与柜员描述仍没能确认身份。"
  },
  {
    "start": 75.52799999999999,
    "end": 76.948,
    "text": "每次行动结束，"
  },
  {
    "start": 77.17492307692308,
    "end": 78.27530769230769,
    "text": "父亲回到家，"
  },
  {
    "start": 78.27530769230769,
    "end": 80.268,
    "text": "等待的仍只有下一次铃响；"
  },
  {
    "start": 80.648,
    "end": 82.708,
    "text": "希望一次次被递来，"
  },
  {
    "start": 82.82799999999999,
    "end": 84.52799999999999,
    "text": "又一次次被抽走。"
  },
  {
    "start": 85.741,
    "end": 88.021,
    "text": "一九九一年三月十三日，"
  },
  {
    "start": 88.14099999999999,
    "end": 89.741,
    "text": "失踪后的第四十四天，"
  },
  {
    "start": 89.901,
    "end": 92.941,
    "text": "工人在蚕室一带的排水沟发现亨浩。"
  },
  {
    "start": 93.61253846153846,
    "end": 95.49715384615385,
    "text": "画面停在警戒线外，"
  },
  {
    "start": 95.56099999999999,
    "end": 96.701,
    "text": "不展示遗体。"
  },
  {
    "start": 96.72099999999999,
    "end": 98.841,
    "text": "法医确认他死于窒息；"
  },
  {
    "start": 99.22099999999999,
    "end": 103.161,
    "text": "胃里的内容物与失踪当天吃过的午餐相符。"
  },
  {
    "start": 103.161,
    "end": 104.841,
    "text": "有报道据此推测，"
  },
  {
    "start": 105.06099999999999,
    "end": 107.201,
    "text": "他可能在失踪当天遇害；"
  },
  {
    "start": 107.201,
    "end": 108.56099999999999,
    "text": "具体死亡时间，"
  },
  {
    "start": 108.86099999999999,
    "end": 111.301,
    "text": "公开资料无法精确确定。"
  },
  {
    "start": 112.247,
    "end": 114.447,
    "text": "警方公开嫌疑人画像，"
  },
  {
    "start": 114.447,
    "end": 116.607,
    "text": "重新检查电话录音、"
  },
  {
    "start": 116.747,
    "end": 118.907,
    "text": "汇款记录和旧卷宗；"
  },
  {
    "start": 118.907,
    "end": 123.86699999999999,
    "text": "调查始终没能把一个具体的人和所有线索连在一起。"
  },
  {
    "start": 123.86699999999999,
    "end": 125.127,
    "text": "二〇〇六年，"
  },
  {
    "start": 125.127,
    "end": 128.167,
    "text": "韩国当时适用的追诉时效届满，"
  },
  {
    "start": 128.167,
    "end": 129.80700000000002,
    "text": "凶手仍未确认，"
  },
  {
    "start": 129.80700000000002,
    "end": 131.98700000000002,
    "text": "案件因此无法起诉。"
  },
  {
    "start": 131.98700000000002,
    "end": 134.047,
    "text": "四十多天的等待结束了，"
  },
  {
    "start": 134.047,
    "end": 137.667,
    "text": "但追查没有给家人一个可以告别的答案。"
  },
  {
    "start": 138.608,
    "end": 140.068,
    "text": "二〇〇七年，"
  },
  {
    "start": 140.288,
    "end": 143.008,
    "text": "案件被拍成电影《那家伙的声音》，"
  },
  {
    "start": 143.008,
    "end": 146.30800000000002,
    "text": "让那段来电再次进入公众记忆。"
  },
  {
    "start": 146.30800000000002,
    "end": 147.68800000000002,
    "text": "二〇一九年，"
  },
  {
    "start": 147.788,
    "end": 151.62800000000001,
    "text": "警方将旧录音带数字化并重新分析声纹，"
  },
  {
    "start": 152.068,
    "end": 153.62800000000001,
    "text": "希望找到新线索。"
  },
  {
    "start": 153.62800000000001,
    "end": 154.548,
    "text": "多年过去，"
  },
  {
    "start": 154.868,
    "end": 157.568,
    "text": "声纹仍没有指向已确认的凶手。"
  },
  {
    "start": 157.568,
    "end": 159.208,
    "text": "截至二〇二六年，"
  },
  {
    "start": 159.508,
    "end": 160.828,
    "text": "案件依旧未侦破。"
  },
  {
    "start": 161.148,
    "end": 163.86800000000002,
    "text": "今天留下的不是凶手的传奇，"
  },
  {
    "start": 163.86800000000002,
    "end": 167.228,
    "text": "而是一个九岁孩子被夺走的日常，"
  },
  {
    "start": 167.228,
    "end": 170.30800000000002,
    "text": "以及仍在等待真相的家人。"
  },
  {
    "start": 170.30800000000002,
    "end": 171.448,
    "text": "三十五年后，"
  },
  {
    "start": 171.448,
    "end": 173.828,
    "text": "真相还可能从哪里出现？"
  }
]
