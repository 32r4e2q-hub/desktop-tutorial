[
  {
    "start": 0.6,
    "end": 2.2060556161218408,
    "text": "二零零三年九月，"
  },
  {
    "start": 2.4999742909676677,
    "end": 4.326468913223879,
    "text": "首尔江南区新沙洞，"
  },
  {
    "start": 4.515416632767625,
    "end": 6.803783458352993,
    "text": "一对老夫妇在自己家里遇害，"
  },
  {
    "start": 6.9507427957759065,
    "end": 8.462324552125875,
    "text": "房子随后被点着。"
  },
  {
    "start": 8.54630131636754,
    "end": 11.254551963161232,
    "text": "凶手没有拿走任何值钱的东西。"
  },
  {
    "start": 11.380517109523728,
    "end": 13.87882584571326,
    "text": "十个月后警方才确认，"
  },
  {
    "start": 14.109761947377839,
    "end": 15.621343703727806,
    "text": "那只是第一起；"
  },
  {
    "start": 15.852279805392383,
    "end": 17.34286737068194,
    "text": "而最后把他揪出来的，"
  },
  {
    "start": 17.65778023658818,
    "end": 18.581524643246492,
    "text": "不是指纹，"
  },
  {
    "start": 18.791466553850658,
    "end": 19.904158680052713,
    "text": "也不是监控，"
  },
  {
    "start": 20.15608897277771,
    "end": 23.011298956994317,
    "text": "是一部被记下来的电话号码。"
  },
  {
    "start": 24.322235058658897,
    "end": 25.487412662511996,
    "text": "他叫柳永哲，"
  },
  {
    "start": 25.487412662511996,
    "end": 29.07741933384317,
    "text": "一九七零年出生在全罗北道高敞郡，"
  },
  {
    "start": 29.371338008689,
    "end": 30.1481230779244,
    "text": "家里很穷。"
  },
  {
    "start": 30.379059179588978,
    "end": 31.80666417169728,
    "text": "从高中时代起，"
  },
  {
    "start": 31.995611891241026,
    "end": 33.75912394031599,
    "text": "他就在监狱里进进出出："
  },
  {
    "start": 34.17900776152432,
    "end": 34.76684511121597,
    "text": "盗窃、"
  },
  {
    "start": 34.87181606651805,
    "end": 36.21544429438469,
    "text": "诈骗和暴力，"
  },
  {
    "start": 36.40439201392843,
    "end": 37.664043477553406,
    "text": "前后十四次，"
  },
  {
    "start": 37.7900086239159,
    "end": 39.19661942496379,
    "text": "累计服刑十一年。"
  },
  {
    "start": 39.30159038026587,
    "end": 41.925864262817896,
    "text": "二零零三年九月十一日，"
  },
  {
    "start": 42.07282360024081,
    "end": 44.508149763249094,
    "text": "他最后一次走出监狱；"
  },
  {
    "start": 44.97002196657825,
    "end": 47.321371365344866,
    "text": "妻子已经带着儿子离开，"
  },
  {
    "start": 47.4893248938282,
    "end": 49.651726573051064,
    "text": "那年他三十三岁。"
  },
  {
    "start": 50.97315977024586,
    "end": 52.337782189172906,
    "text": "出狱十三天后，"
  },
  {
    "start": 52.44275314447499,
    "end": 53.87035813658329,
    "text": "第一起案子发生了。"
  },
  {
    "start": 53.98582618741558,
    "end": 56.99849260458531,
    "text": "此后他专挑富人区的独栋住宅，"
  },
  {
    "start": 57.10346355988739,
    "end": 59.885193875392545,
    "text": "在白天老人独自在家的时候闯进去；"
  },
  {
    "start": 60.00066192622483,
    "end": 61.32329596303105,
    "text": "为了不留目击者，"
  },
  {
    "start": 61.35478724962167,
    "end": 63.349235400361216,
    "text": "连屋里的帮佣也不放过。"
  },
  {
    "start": 63.46470345119351,
    "end": 64.94479392095285,
    "text": "二零零四年春天，"
  },
  {
    "start": 65.02877068519452,
    "end": 66.47736986836324,
    "text": "他突然换了目标："
  },
  {
    "start": 66.5508495370747,
    "end": 69.0281640822038,
    "text": "用伪造的警察证件和一部电话，"
  },
  {
    "start": 69.13313503750588,
    "end": 71.97784792619228,
    "text": "把按摩女约到自己住的写字楼公寓。"
  },
  {
    "start": 72.08281888149436,
    "end": 74.90653757912034,
    "text": "到七月落网前，"
  },
  {
    "start": 74.95902305677139,
    "end": 76.12420066062448,
    "text": "有十一名女性走进了那栋楼，"
  },
  {
    "start": 76.22917161592656,
    "end": 77.41009486307499,
    "text": "再也没有出来。"
  },
  {
    "start": 78.54258034072602,
    "end": 79.58179279821661,
    "text": "一开始，"
  },
  {
    "start": 79.58179279821661,
    "end": 82.47899116455406,
    "text": "这些失踪并没有被当成连环案件。"
  },
  {
    "start": 82.59445921538634,
    "end": 85.61762272808627,
    "text": "按摩女的去向本来就少有人追问，"
  },
  {
    "start": 85.61762272808627,
    "end": 87.2026841531477,
    "text": "警方最初的判断是："
  },
  {
    "start": 87.31815220397999,
    "end": 89.57502774297474,
    "text": "可能有人把她们拐卖到了乡下。"
  },
  {
    "start": 89.67999869827682,
    "end": 94.3197149226288,
    "text": "真正的转机出现在一部电话上——店里好几个姑娘，"
  },
  {
    "start": 94.4351829734611,
    "end": 96.93349170965062,
    "text": "都是接到同一个号码之后消失的。"
  },
  {
    "start": 97.04895976048292,
    "end": 98.86495728720891,
    "text": "老板把号码记了下来，"
  },
  {
    "start": 98.92793986039015,
    "end": 100.43952161674014,
    "text": "又看见它出现，"
  },
  {
    "start": 100.43952161674014,
    "end": 102.04032868509687,
    "text": "就带着人报了警。"
  },
  {
    "start": 103.18331125827811,
    "end": 105.6291345168166,
    "text": "二零零四年七月十五日凌晨，"
  },
  {
    "start": 105.73410547211869,
    "end": 108.94621670436237,
    "text": "警方在麻浦区的一条巷子里抓住了他。"
  },
  {
    "start": 109.05118765966445,
    "end": 112.38926403827062,
    "text": "审讯中途他假装癫痫发作，"
  },
  {
    "start": 112.4942349935727,
    "end": 115.00304082529244,
    "text": "趁手铐松开逃出警局；"
  },
  {
    "start": 115.10801178059452,
    "end": 116.44114291293096,
    "text": "十二个小时后，"
  },
  {
    "start": 116.55661096376325,
    "end": 120.17810892168504,
    "text": "警察在永登浦站附近把他重新抓住。"
  },
  {
    "start": 120.28307987698713,
    "end": 122.21454545454542,
    "text": "面对警方的问话，"
  },
  {
    "start": 122.3195164098475,
    "end": 125.78355793481617,
    "text": "他承认自己和这些失踪案有关。"
  },
  {
    "start": 125.88852889011827,
    "end": 126.95923263419948,
    "text": "七月十八日，"
  },
  {
    "start": 127.07470068503177,
    "end": 130.49675382787962,
    "text": "他带着警察上了奉元寺的后山。"
  },
  {
    "start": 130.9796202222692,
    "end": 131.81938786468584,
    "text": "雨天里，"
  },
  {
    "start": 131.9978384886994,
    "end": 134.18123435898266,
    "text": "警方在那片山坡上，"
  },
  {
    "start": 134.18123435898266,
    "end": 137.57627934978925,
    "text": "找到了十一名失踪女性的下落。"
  },
  {
    "start": 138.69826773191008,
    "end": 141.0391200351465,
    "text": "二零零四年十二月十三日，"
  },
  {
    "start": 141.14409099044857,
    "end": 143.13853914118812,
    "text": "首尔中央地方法院认定，"
  },
  {
    "start": 143.25400719202042,
    "end": 145.78380721480056,
    "text": "他对二十人的死亡负有责任，"
  },
  {
    "start": 145.78380721480056,
    "end": 146.92799062759326,
    "text": "判处死刑；"
  },
  {
    "start": 147.03296158289533,
    "end": 148.50255495712446,
    "text": "二零零五年六月，"
  },
  {
    "start": 148.60752591242655,
    "end": 151.21080560391817,
    "text": "最高法院终审维持原判。"
  },
  {
    "start": 151.31577655922024,
    "end": 155.03174837691392,
    "text": "韩国从一九九七年起就没有再执行过死刑，"
  },
  {
    "start": 155.10522804562538,
    "end": 157.204647151667,
    "text": "他至今仍然在监狱里。"
  },
  {
    "start": 157.30961810696908,
    "end": 158.94716500968153,
    "text": "真正让人不安的是，"
  },
  {
    "start": 158.96815920074195,
    "end": 160.04936004035338,
    "text": "他被捕之后，"
  },
  {
    "start": 160.1753251867159,
    "end": 163.36644222789914,
    "text": "韩国的网站上出现了他的粉丝俱乐部。"
  },
  {
    "start": 163.48191027873145,
    "end": 164.7310646468262,
    "text": "二零零八年，"
  },
  {
    "start": 164.7310646468262,
    "end": 167.46030948468032,
    "text": "这起案子被拍成电影《追击者》；"
  },
  {
    "start": 167.5652804399824,
    "end": 168.63598418406363,
    "text": "二零二一年，"
  },
  {
    "start": 168.63598418406363,
    "end": 170.10557755829277,
    "text": "它又被拍成纪录片。"
  },
  {
    "start": 170.22104560912504,
    "end": 172.44642986152917,
    "text": "危险从不写在脸上，"
  },
  {
    "start": 172.56189791236145,
    "end": 173.99999999999997,
    "text": "它就走在人群里。"
  }
]