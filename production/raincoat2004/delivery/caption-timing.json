[
  {
    "start": 0.6,
    "end": 2.5317403874912765,
    "text": "二〇〇三年九月，"
  },
  {
    "start": 2.7327307168256287,
    "end": 4.541643680834801,
    "text": "首尔江南区新沙洞，"
  },
  {
    "start": 4.7649662689840815,
    "end": 7.06518892692167,
    "text": "一对老夫妇在自己家里遇害，"
  },
  {
    "start": 7.1321857033664555,
    "end": 8.583782526336778,
    "text": "房子随后起火。"
  },
  {
    "start": 8.80710511448606,
    "end": 11.375314878202785,
    "text": "凶手没有拿走任何值钱的东西。"
  },
  {
    "start": 11.531640689907281,
    "end": 14.211511747698646,
    "text": "十个月后警方才确认，"
  },
  {
    "start": 14.434834335847928,
    "end": 17.047708617194512,
    "text": "那只是二十条人命里的第一起；"
  },
  {
    "start": 17.159369911269152,
    "end": 18.76729254594397,
    "text": "而最后把他揪出来的，"
  },
  {
    "start": 19.191605463427603,
    "end": 20.218889368914294,
    "text": "不是指纹，"
  },
  {
    "start": 20.442211957063574,
    "end": 21.53649263899505,
    "text": "也不是监控，"
  },
  {
    "start": 21.804479744774184,
    "end": 24.127034661526704,
    "text": "是一部被记下来的电话号码。"
  },
  {
    "start": 25.447106443787177,
    "end": 27.08852746668439,
    "text": "他叫柳永哲，"
  },
  {
    "start": 27.08852746668439,
    "end": 31.755969559004352,
    "text": "一九七〇年出生在全罗北道高敞郡，"
  },
  {
    "start": 32.1132857000432,
    "end": 32.89491475856568,
    "text": "家里很穷。"
  },
  {
    "start": 33.028908311455254,
    "end": 34.48050513442557,
    "text": "从高中时代起，"
  },
  {
    "start": 34.68149546375993,
    "end": 36.62440198065867,
    "text": "他就在监狱里进进出出："
  },
  {
    "start": 36.8923890864378,
    "end": 37.69635040377521,
    "text": "盗窃、"
  },
  {
    "start": 37.87500847429464,
    "end": 38.54497623874248,
    "text": "诈骗、"
  },
  {
    "start": 38.67896979163205,
    "end": 39.63925692067396,
    "text": "暴力伤人，"
  },
  {
    "start": 39.840247250008304,
    "end": 41.224847296533845,
    "text": "前后十四次，"
  },
  {
    "start": 41.33650859060849,
    "end": 42.92209896646838,
    "text": "累计服刑十一年。"
  },
  {
    "start": 43.01142800172809,
    "end": 45.378647436110455,
    "text": "二〇〇三年九月十一日，"
  },
  {
    "start": 45.53497324781496,
    "end": 47.74586687049283,
    "text": "他最后一次走出监狱；"
  },
  {
    "start": 47.90219268219733,
    "end": 49.59944435213187,
    "text": "妻子已经带着儿子离开，"
  },
  {
    "start": 49.73343790502143,
    "end": 51.72100893955003,
    "text": "那年他三十三岁。"
  },
  {
    "start": 53.59380412747998,
    "end": 54.4870944800771,
    "text": "出狱十三天后，"
  },
  {
    "start": 54.643420291781595,
    "end": 55.87169452660264,
    "text": "他第一次作案。"
  },
  {
    "start": 56.117349373566846,
    "end": 59.55651723106577,
    "text": "此后他专挑富人区的独栋住宅，"
  },
  {
    "start": 59.75750756040012,
    "end": 63.06268186500947,
    "text": "在白天老人独自在家的时候闯进去；"
  },
  {
    "start": 63.353001229603535,
    "end": 64.71526901731414,
    "text": "为了不留活口，"
  },
  {
    "start": 64.9162593466485,
    "end": 66.88149812236217,
    "text": "连屋里的帮佣也不放过。"
  },
  {
    "start": 67.03782393406667,
    "end": 68.91373367452061,
    "text": "二〇〇四年春天，"
  },
  {
    "start": 68.93606593333556,
    "end": 70.45465953275065,
    "text": "他突然换了目标："
  },
  {
    "start": 70.45465953275065,
    "end": 73.22385962580174,
    "text": "用伪造的警察证件和一部电话，"
  },
  {
    "start": 73.33552091987637,
    "end": 76.73002425974543,
    "text": "把按摩女约到自己住的写字楼公寓。"
  },
  {
    "start": 76.9310145890798,
    "end": 78.5389372237546,
    "text": "到七月落网前，"
  },
  {
    "start": 78.71759529427403,
    "end": 81.26347279917583,
    "text": "有十一名女性走进了那栋楼，"
  },
  {
    "start": 81.46446312851019,
    "end": 82.64807284570136,
    "text": "再也没有出来。"
  },
  {
    "start": 83.96814462796185,
    "end": 84.92843175700375,
    "text": "一开始，"
  },
  {
    "start": 85.05125918048586,
    "end": 88.37876574391014,
    "text": "这些失踪并没有被当成连环案件。"
  },
  {
    "start": 88.53509155561463,
    "end": 91.87376424844638,
    "text": "按摩女的去向本来就少有人追问，"
  },
  {
    "start": 91.98542554252101,
    "end": 93.78317237712272,
    "text": "警方最初的判断是："
  },
  {
    "start": 93.90599980060483,
    "end": 96.60820311721112,
    "text": "可能有人把她们拐卖到了乡下。"
  },
  {
    "start": 96.73103054069323,
    "end": 101.06348875078928,
    "text": "真正的转机出现在一部电话上——店里好几个姑娘，"
  },
  {
    "start": 101.14165165664151,
    "end": 103.75452593798809,
    "text": "都是接到同一个号码之后消失的。"
  },
  {
    "start": 103.88851949087767,
    "end": 105.7085985842943,
    "text": "老板把号码记了下来，"
  },
  {
    "start": 105.79792761955402,
    "end": 107.12669701904224,
    "text": "又看见它出现，"
  },
  {
    "start": 107.24952444252433,
    "end": 108.8127825595693,
    "text": "就带着人报了警。"
  },
  {
    "start": 109.8927825595693,
    "end": 113.07512944069654,
    "text": "二〇〇四年七月十五日凌晨，"
  },
  {
    "start": 113.36544880529061,
    "end": 116.87161343923431,
    "text": "警方在麻浦区的一条巷子里抓住了他。"
  },
  {
    "start": 117.13960054501345,
    "end": 120.02046193213917,
    "text": "审讯中途他假装癫痫发作，"
  },
  {
    "start": 120.33311355554817,
    "end": 123.1469781662291,
    "text": "趁手铐松开逃出警局；"
  },
  {
    "start": 123.50429430726794,
    "end": 124.79956531853377,
    "text": "十二个小时后，"
  },
  {
    "start": 124.95589113023827,
    "end": 129.10969126981487,
    "text": "警察在永登浦站附近把他重新抓住。"
  },
  {
    "start": 129.28834934033432,
    "end": 130.56128809278522,
    "text": "面对警方他说："
  },
  {
    "start": 130.76227842211955,
    "end": 132.97317204479742,
    "text": "我就是那个连环杀人犯。"
  },
  {
    "start": 133.15183011531687,
    "end": 134.58109467947224,
    "text": "七月十八日，"
  },
  {
    "start": 134.67042371473198,
    "end": 137.4172915489681,
    "text": "他带着警察上了奉元寺的后山。"
  },
  {
    "start": 137.5512851018577,
    "end": 138.33291416038017,
    "text": "雨天里，"
  },
  {
    "start": 138.53390448971453,
    "end": 143.00035625270013,
    "text": "警方在那片山坡上标出了十一处掩埋地点。"
  },
  {
    "start": 144.27576351733074,
    "end": 146.7434781163803,
    "text": "二〇〇四年十二月十三日，"
  },
  {
    "start": 147.03379748097436,
    "end": 150.49529759728821,
    "text": "首尔中央地方法院认定他杀害二十人，"
  },
  {
    "start": 150.58462663254792,
    "end": 151.6789073144794,
    "text": "判处死刑；"
  },
  {
    "start": 151.87989764381373,
    "end": 153.33149446678408,
    "text": "二〇〇五年六月，"
  },
  {
    "start": 153.64414609019306,
    "end": 156.39101392442922,
    "text": "最高法院终审维持原判。"
  },
  {
    "start": 156.41334618324413,
    "end": 161.3041108637134,
    "text": "韩国从一九九七年起就没有再执行过死刑，"
  },
  {
    "start": 161.5497657106776,
    "end": 163.7829915921704,
    "text": "他至今仍然在监狱里。"
  },
  {
    "start": 164.0063141803197,
    "end": 165.50257552091986,
    "text": "真正让人不安的是，"
  },
  {
    "start": 165.74823036788408,
    "end": 166.7308497557409,
    "text": "他被捕之后，"
  },
  {
    "start": 166.86484330863047,
    "end": 170.25934664849953,
    "text": "韩国的网站上出现了他的粉丝俱乐部。"
  },
  {
    "start": 170.5719982719085,
    "end": 172.29158220065798,
    "text": "危险从不写在脸上，"
  },
  {
    "start": 172.5595693064371,
    "end": 173.85484031770295,
    "text": "它就走在人群里。"
  }
]