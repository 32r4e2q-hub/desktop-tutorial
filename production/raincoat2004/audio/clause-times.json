{
 "N01": {
  "duration": 21.285,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.59,
    "text": "二〇〇三年九月",
    "chars_per_second": 3.47
   },
   {
    "i": 1,
    "start": 1.93,
    "end": 3.41,
    "text": "首尔江南区新沙洞",
    "chars_per_second": 5.41
   },
   {
    "i": 2,
    "start": 3.76,
    "end": 5.62,
    "text": "一对老夫妇在自己家里遇害",
    "chars_per_second": 6.45
   },
   {
    "i": 3,
    "start": 5.97,
    "end": 7.12,
    "text": "房子随后起火",
    "chars_per_second": 5.22
   },
   {
    "i": 4,
    "start": 7.46,
    "end": 9.61,
    "text": "凶手没有拿走任何值钱的东西",
    "chars_per_second": 6.05
   },
   {
    "i": 5,
    "start": 9.92,
    "end": 12.13,
    "text": "十个月后警方才确认",
    "chars_per_second": 4.07
   },
   {
    "i": 6,
    "start": 12.48,
    "end": 14.58,
    "text": "那只是二十条人命里的第一起",
    "chars_per_second": 6.19
   },
   {
    "i": 7,
    "start": 14.9,
    "end": 16.5,
    "text": "而最后把他揪出来的",
    "chars_per_second": 5.63
   },
   {
    "i": 8,
    "start": 16.77,
    "end": 17.64,
    "text": "不是指纹",
    "chars_per_second": 4.6
   },
   {
    "i": 9,
    "start": 17.84,
    "end": 18.69,
    "text": "也不是监控",
    "chars_per_second": 5.88
   },
   {
    "i": 10,
    "start": 19.03,
    "end": 21.29,
    "text": "是一部被记下来的电话号码",
    "chars_per_second": 5.32
   }
  ]
 },
 "N02": {
  "duration": 23.69,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.38,
    "text": "他叫柳永哲",
    "chars_per_second": 4.03
   },
   {
    "i": 1,
    "start": 1.73,
    "end": 5.57,
    "text": "一九七〇年出生在全罗北道高敞郡",
    "chars_per_second": 3.65
   },
   {
    "i": 2,
    "start": 5.93,
    "end": 6.56,
    "text": "家里很穷",
    "chars_per_second": 6.35
   },
   {
    "i": 3,
    "start": 6.91,
    "end": 8.02,
    "text": "从高中时代起",
    "chars_per_second": 5.41
   },
   {
    "i": 4,
    "start": 8.35,
    "end": 10.08,
    "text": "他就在监狱里进进出出",
    "chars_per_second": 5.78
   },
   {
    "i": 5,
    "start": 10.42,
    "end": 10.86,
    "text": "盗窃",
    "chars_per_second": 4.55
   },
   {
    "i": 6,
    "start": 11.2,
    "end": 11.6,
    "text": "诈骗",
    "chars_per_second": 5.0
   },
   {
    "i": 7,
    "start": 11.94,
    "end": 12.62,
    "text": "暴力伤人",
    "chars_per_second": 5.88
   },
   {
    "i": 8,
    "start": 12.97,
    "end": 13.93,
    "text": "前后十四次",
    "chars_per_second": 5.21
   },
   {
    "i": 9,
    "start": 14.27,
    "end": 15.54,
    "text": "累计服刑十一年",
    "chars_per_second": 5.51
   },
   {
    "i": 10,
    "start": 15.89,
    "end": 17.74,
    "text": "二〇〇三年九月十一日",
    "chars_per_second": 4.32
   },
   {
    "i": 11,
    "start": 18.09,
    "end": 19.84,
    "text": "他最后一次走出监狱",
    "chars_per_second": 5.14
   },
   {
    "i": 12,
    "start": 20.2,
    "end": 22.31,
    "text": "妻子已经带着儿子离开",
    "chars_per_second": 4.74
   },
   {
    "i": 13,
    "start": 22.59,
    "end": 23.69,
    "text": "那年他三十三岁",
    "chars_per_second": 6.36
   }
  ]
 },
 "N03": {
  "duration": 26.735,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 2.54,
    "text": "出狱十三天后",
    "chars_per_second": 2.48
   },
   {
    "i": 1,
    "start": 2.89,
    "end": 3.48,
    "text": "他第一次作案",
    "chars_per_second": 10.17
   },
   {
    "i": 2,
    "start": 3.7,
    "end": 5.79,
    "text": "此后他专挑富人区的独栋住宅",
    "chars_per_second": 6.22
   },
   {
    "i": 3,
    "start": 6.14,
    "end": 9.05,
    "text": "在白天老人独自在家的时候闯进去",
    "chars_per_second": 5.15
   },
   {
    "i": 4,
    "start": 9.4,
    "end": 10.48,
    "text": "为了不留活口",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 10.77,
    "end": 12.35,
    "text": "连屋里的帮佣也不放过",
    "chars_per_second": 6.33
   },
   {
    "i": 6,
    "start": 12.69,
    "end": 14.13,
    "text": "二〇〇四年春天",
    "chars_per_second": 3.47
   },
   {
    "i": 7,
    "start": 14.39,
    "end": 15.49,
    "text": "他突然换了目标",
    "chars_per_second": 6.36
   },
   {
    "i": 8,
    "start": 15.84,
    "end": 17.97,
    "text": "用伪造的警察证件和一部电话",
    "chars_per_second": 6.1
   },
   {
    "i": 9,
    "start": 18.35,
    "end": 21.21,
    "text": "把按摩女约到自己住的写字楼公寓",
    "chars_per_second": 5.24
   },
   {
    "i": 10,
    "start": 21.56,
    "end": 22.9,
    "text": "到七月落网前",
    "chars_per_second": 4.48
   },
   {
    "i": 11,
    "start": 23.15,
    "end": 25.19,
    "text": "有十一名女性走进了那栋楼",
    "chars_per_second": 5.88
   },
   {
    "i": 12,
    "start": 25.54,
    "end": 26.73,
    "text": "再也没有出来",
    "chars_per_second": 5.02
   }
  ]
 },
 "N04": {
  "duration": 22.3,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.76,
    "text": "一开始",
    "chars_per_second": 4.84
   },
   {
    "i": 1,
    "start": 1.11,
    "end": 3.85,
    "text": "这些失踪并没有被当成连环案件",
    "chars_per_second": 5.11
   },
   {
    "i": 2,
    "start": 4.23,
    "end": 6.98,
    "text": "按摩女的去向本来就少有人追问",
    "chars_per_second": 5.09
   },
   {
    "i": 3,
    "start": 7.32,
    "end": 8.69,
    "text": "警方最初的判断是",
    "chars_per_second": 5.84
   },
   {
    "i": 4,
    "start": 9.04,
    "end": 11.22,
    "text": "可能有人把她们拐卖到了乡下",
    "chars_per_second": 5.96
   },
   {
    "i": 5,
    "start": 11.57,
    "end": 13.68,
    "text": "真正的转机出现在一部电话上",
    "chars_per_second": 6.16
   },
   {
    "i": 6,
    "start": 14.03,
    "end": 15.21,
    "text": "店里好几个姑娘",
    "chars_per_second": 5.93
   },
   {
    "i": 7,
    "start": 15.52,
    "end": 17.62,
    "text": "都是接到同一个号码之后消失的",
    "chars_per_second": 6.67
   },
   {
    "i": 8,
    "start": 17.98,
    "end": 19.37,
    "text": "老板把号码记了下来",
    "chars_per_second": 6.47
   },
   {
    "i": 9,
    "start": 19.69,
    "end": 20.64,
    "text": "又看见它出现",
    "chars_per_second": 6.32
   },
   {
    "i": 10,
    "start": 20.99,
    "end": 22.3,
    "text": "就带着人报了警",
    "chars_per_second": 5.34
   }
  ]
 },
 "N05": {
  "duration": 29.825,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 2.73,
    "text": "二〇〇四年七月十五日凌晨",
    "chars_per_second": 3.83
   },
   {
    "i": 1,
    "start": 3.08,
    "end": 6.18,
    "text": "警方在麻浦区的一条巷子里抓住了他",
    "chars_per_second": 5.16
   },
   {
    "i": 2,
    "start": 6.53,
    "end": 9.0,
    "text": "审讯中途他假装癫痫发作",
    "chars_per_second": 4.45
   },
   {
    "i": 3,
    "start": 9.35,
    "end": 11.8,
    "text": "趁手铐松开逃出警局",
    "chars_per_second": 3.67
   },
   {
    "i": 4,
    "start": 12.14,
    "end": 13.21,
    "text": "十二个小时后",
    "chars_per_second": 5.61
   },
   {
    "i": 5,
    "start": 13.56,
    "end": 17.08,
    "text": "警察在永登浦站附近把他重新抓住",
    "chars_per_second": 4.26
   },
   {
    "i": 6,
    "start": 17.43,
    "end": 18.58,
    "text": "面对警方他说",
    "chars_per_second": 5.22
   },
   {
    "i": 7,
    "start": 18.93,
    "end": 20.69,
    "text": "我就是那个连环杀人犯",
    "chars_per_second": 5.68
   },
   {
    "i": 8,
    "start": 21.04,
    "end": 21.97,
    "text": "七月十八日",
    "chars_per_second": 5.38
   },
   {
    "i": 9,
    "start": 22.3,
    "end": 24.57,
    "text": "他带着警察上了奉元寺的后山",
    "chars_per_second": 5.73
   },
   {
    "i": 10,
    "start": 24.91,
    "end": 25.54,
    "text": "雨天里",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 25.76,
    "end": 29.82,
    "text": "警方在那片山坡上标出了十一处掩埋地点",
    "chars_per_second": 4.43
   }
  ]
 },
 "N06": {
  "duration": 26.62,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 2.09,
    "text": "二〇〇四年十二月十三日",
    "chars_per_second": 4.5
   },
   {
    "i": 1,
    "start": 2.43,
    "end": 5.42,
    "text": "首尔中央地方法院认定他杀害二十人",
    "chars_per_second": 5.35
   },
   {
    "i": 2,
    "start": 5.73,
    "end": 6.56,
    "text": "判处死刑",
    "chars_per_second": 4.82
   },
   {
    "i": 3,
    "start": 6.91,
    "end": 8.11,
    "text": "二〇〇五年六月",
    "chars_per_second": 4.17
   },
   {
    "i": 4,
    "start": 8.45,
    "end": 10.78,
    "text": "最高法院终审维持原判",
    "chars_per_second": 4.29
   },
   {
    "i": 5,
    "start": 11.13,
    "end": 15.15,
    "text": "韩国从一九九七年起就没有再执行过死刑",
    "chars_per_second": 4.48
   },
   {
    "i": 6,
    "start": 15.5,
    "end": 17.38,
    "text": "他至今仍然在监狱里",
    "chars_per_second": 4.79
   },
   {
    "i": 7,
    "start": 17.72,
    "end": 19.02,
    "text": "真正让人不安的是",
    "chars_per_second": 6.15
   },
   {
    "i": 8,
    "start": 19.26,
    "end": 20.01,
    "text": "他被捕之后",
    "chars_per_second": 6.67
   },
   {
    "i": 9,
    "start": 20.36,
    "end": 23.18,
    "text": "韩国的网站上出现了他的粉丝俱乐部",
    "chars_per_second": 5.67
   },
   {
    "i": 10,
    "start": 23.52,
    "end": 24.93,
    "text": "危险从不写在脸上",
    "chars_per_second": 5.67
   },
   {
    "i": 11,
    "start": 25.28,
    "end": 26.62,
    "text": "它就走在人群里",
    "chars_per_second": 5.22
   }
  ]
 }
}