[
  {
    "start": 0.6,
    "end": 1.8900717582608593,
    "text": "英国海德镇，"
  },
  {
    "start": 1.8900717582608593,
    "end": 3.9582820373774754,
    "text": "有个全镇人都爱的医生，"
  },
  {
    "start": 3.9582820373774754,
    "end": 5.842196351028254,
    "text": "叫哈罗德·希普曼。"
  },
  {
    "start": 5.842196351028254,
    "end": 6.927494814327072,
    "text": "半夜发烧，"
  },
  {
    "start": 6.927494814327072,
    "end": 9.691934296314628,
    "text": "一个电话他背着药箱就上门，"
  },
  {
    "start": 9.691934296314628,
    "end": 11.514416621476794,
    "text": "孤寡老人没钱看病，"
  },
  {
    "start": 11.514416621476794,
    "end": 12.722579061752837,
    "text": "他免费送药，"
  },
  {
    "start": 12.722579061752837,
    "end": 14.729357352380841,
    "text": "年年被评为最佳医生。"
  },
  {
    "start": 14.729357352380841,
    "end": 15.91704246316068,
    "text": "可没人知道，"
  },
  {
    "start": 15.91704246316068,
    "end": 18.333367343712766,
    "text": "这位天使医生在24年里，"
  },
  {
    "start": 18.333367343712766,
    "end": 22.387878583961182,
    "text": "被官方认定与250起离奇病例有关。"
  },
  {
    "start": 22.387878583961182,
    "end": 23.67795034222204,
    "text": "最信任他的人，"
  },
  {
    "start": 23.67795034222204,
    "end": 25.643773973857638,
    "text": "情况最让人担忧。"
  },
  {
    "start": 25.643773973857638,
    "end": 27.036232379599518,
    "text": "他不是失误，"
  },
  {
    "start": 27.036232379599518,
    "end": 28.154230578437588,
    "text": "是挑选目标。"
  },
  {
    "start": 29.23423057843759,
    "end": 30.237619723751592,
    "text": "他的手法，"
  },
  {
    "start": 30.237619723751592,
    "end": 31.445782164027634,
    "text": "简单到可怕。"
  },
  {
    "start": 31.445782164027634,
    "end": 32.94062721725054,
    "text": "先支开家属，"
  },
  {
    "start": 32.94062721725054,
    "end": 34.49690425896205,
    "text": "说要单独检查，"
  },
  {
    "start": 34.49690425896205,
    "end": 37.118002434476175,
    "text": "然后一针大剂量二乙酰吗啡，"
  },
  {
    "start": 37.118002434476175,
    "end": 39.268122031577605,
    "text": "学名海洛因的医用版，"
  },
  {
    "start": 39.268122031577605,
    "end": 44.16220378117039,
    "text": "0.2克就能让一个健康老人在5分钟内呼吸抑制，"
  },
  {
    "start": 44.16220378117039,
    "end": 45.6980034933857,
    "text": "像睡着一样死去。"
  },
  {
    "start": 45.6980034933857,
    "end": 47.82764576099093,
    "text": "随后他自己打急救电话，"
  },
  {
    "start": 47.82764576099093,
    "end": 49.83442405161893,
    "text": "亲自写下死亡证明："
  },
  {
    "start": 49.83442405161893,
    "end": 50.20301598255061,
    "text": "死因，"
  },
  {
    "start": 50.20301598255061,
    "end": 52.57838620411029,
    "text": "自然衰老或冠心病。"
  },
  {
    "start": 52.57838620411029,
    "end": 54.87184710768514,
    "text": "因为他既是主治医生，"
  },
  {
    "start": 54.87184710768514,
    "end": 56.30526017241944,
    "text": "又是死亡证明人，"
  },
  {
    "start": 56.30526017241944,
    "end": 57.88207853528182,
    "text": "没人会怀疑。"
  },
  {
    "start": 58.962078535281826,
    "end": 60.19071830505407,
    "text": "更离谱的是，"
  },
  {
    "start": 60.19071830505407,
    "end": 62.13606460719346,
    "text": "英国制度给了他完美掩护。"
  },
  {
    "start": 62.13606460719346,
    "end": 63.26231772948469,
    "text": "90年代，"
  },
  {
    "start": 63.26231772948469,
    "end": 65.63768795104437,
    "text": "全科医生管着自己的药品库，"
  },
  {
    "start": 65.63768795104437,
    "end": 67.62398891217617,
    "text": "吗啡用量自己说了算。"
  },
  {
    "start": 67.62398891217617,
    "end": 69.99935913373585,
    "text": "病人火化只需要两个医生签字，"
  },
  {
    "start": 69.99935913373585,
    "end": 72.7433212862272,
    "text": "第二位医生基本就是走个过场，"
  },
  {
    "start": 72.7433212862272,
    "end": 75.38489679123752,
    "text": "看一眼他写的证明就签了。"
  },
  {
    "start": 75.38489679123752,
    "end": 76.30637661856672,
    "text": "尸体一烧，"
  },
  {
    "start": 76.30637661856672,
    "end": 77.39167508186553,
    "text": "证据全无。"
  },
  {
    "start": 77.39167508186553,
    "end": 79.35749871350113,
    "text": "甚至当地火化率异常飙升，"
  },
  {
    "start": 79.35749871350113,
    "end": 81.30284501564051,
    "text": "殡仪馆都觉得奇怪，"
  },
  {
    "start": 81.30284501564051,
    "end": 83.68719539940633,
    "text": "却没人敢质疑一个好医生。"
  },
  {
    "start": 84.76719539940635,
    "end": 86.40538175910268,
    "text": "直到1998年，"
  },
  {
    "start": 86.40538175910268,
    "end": 88.9855252756244,
    "text": "他犯了一个致命的贪婪错误。"
  },
  {
    "start": 88.9855252756244,
    "end": 91.87282873458918,
    "text": "81岁的前女市长凯瑟琳·格兰迪，"
  },
  {
    "start": 91.87282873458918,
    "end": 92.73287657342975,
    "text": "富婆，"
  },
  {
    "start": 92.73287657342975,
    "end": 93.53149242378171,
    "text": "身体硬朗，"
  },
  {
    "start": 93.53149242378171,
    "end": 94.78060952305016,
    "text": "突然死了。"
  },
  {
    "start": 94.78060952305016,
    "end": 95.84543065685277,
    "text": "希普曼主动说，"
  },
  {
    "start": 95.84543065685277,
    "end": 97.70886764100734,
    "text": "是他发现的尸体。"
  },
  {
    "start": 97.70886764100734,
    "end": 98.56891547984792,
    "text": "几天后，"
  },
  {
    "start": 98.56891547984792,
    "end": 99.89994189710119,
    "text": "格兰迪的女儿，"
  },
  {
    "start": 99.89994189710119,
    "end": 101.00571768989622,
    "text": "律师安吉拉，"
  },
  {
    "start": 101.00571768989622,
    "end": 102.5005627431191,
    "text": "收到一封遗嘱："
  },
  {
    "start": 102.5005627431191,
    "end": 104.09779444382303,
    "text": "全部38万英镑遗产，"
  },
  {
    "start": 104.09779444382303,
    "end": 105.79741279200798,
    "text": "留给希普曼医生。"
  },
  {
    "start": 105.79741279200798,
    "end": 107.23082585674226,
    "text": "安吉拉当场炸了："
  },
  {
    "start": 107.23082585674226,
    "end": 109.66762806679056,
    "text": "我妈连打字机都不会用，"
  },
  {
    "start": 109.66762806679056,
    "end": 112.06347561784644,
    "text": "这封遗嘱全是打字机打的，"
  },
  {
    "start": 112.06347561784644,
    "end": 113.15353079414281,
    "text": "还漏洞百出。"
  },
  {
    "start": 114.23353079414281,
    "end": 115.65670519412899,
    "text": "安吉拉直接报警。"
  },
  {
    "start": 115.86147848909104,
    "end": 117.21298223584051,
    "text": "警方开棺验尸，"
  },
  {
    "start": 117.43823286029875,
    "end": 120.6122189322104,
    "text": "在格兰迪体内检出致死量15倍的吗啡。"
  },
  {
    "start": 120.93985620414966,
    "end": 123.80668233361823,
    "text": "随后又挖出15具他经手的尸体，"
  },
  {
    "start": 124.21622892354232,
    "end": 125.6496419882766,
    "text": "具具含超量吗啡。"
  },
  {
    "start": 125.77250596525383,
    "end": 127.22639635948433,
    "text": "最蠢的铁证来了："
  },
  {
    "start": 127.6564202789046,
    "end": 130.6256330558542,
    "text": "那封遗嘱是用一台老式兄弟牌打字机打的，"
  },
  {
    "start": 130.99422498678587,
    "end": 132.26381941555053,
    "text": "而那台打字机，"
  },
  {
    "start": 132.26381941555053,
    "end": 133.36959520834554,
    "text": "就在他诊所里，"
  },
  {
    "start": 133.77914179826965,
    "end": 134.84396293207226,
    "text": "指纹全是他的。"
  },
  {
    "start": 135.29446418098874,
    "end": 137.0555145176623,
    "text": "24年完美谋杀，"
  },
  {
    "start": 137.13742383564713,
    "end": 139.0827701377865,
    "text": "被一台打字机的字体出卖。"
  },
  {
    "start": 139.26706610325235,
    "end": 140.37284189604736,
    "text": "吗啡这东西，"
  },
  {
    "start": 140.76191115647524,
    "end": 142.76868944710324,
    "text": "埋进土里几十年都还在。"
  },
  {
    "start": 143.91383295156305,
    "end": 145.5520193112594,
    "text": "2000年1月，"
  },
  {
    "start": 145.5520193112594,
    "end": 147.78404822634562,
    "text": "希普曼被判15项罪名成立，"
  },
  {
    "start": 147.78404822634562,
    "end": 148.5621867472014,
    "text": "终身监禁。"
  },
  {
    "start": 148.5621867472014,
    "end": 150.05703180042428,
    "text": "官方调查认定，"
  },
  {
    "start": 150.05703180042428,
    "end": 152.47335668097637,
    "text": "他至少与250起事件有关，"
  },
  {
    "start": 152.47335668097637,
    "end": 156.42548127374377,
    "text": "可能是英国史上涉及人数最多的案件之一。"
  },
  {
    "start": 156.42548127374377,
    "end": 157.30600644208056,
    "text": "2004年，"
  },
  {
    "start": 157.30600644208056,
    "end": 158.90323814278446,
    "text": "他在狱中离世了。"
  },
  {
    "start": 158.90323814278446,
    "end": 161.667677624772,
    "text": "但250个家庭永远等不到道歉。"
  },
  {
    "start": 161.667677624772,
    "end": 163.01918137152148,
    "text": "记住这句话："
  },
  {
    "start": 163.01918137152148,
    "end": 164.30925312978235,
    "text": "最可怕的危险，"
  },
  {
    "start": 164.30925312978235,
    "end": 165.86553017149387,
    "text": "从来不是表面凶狠，"
  },
  {
    "start": 165.86553017149387,
    "end": 167.5241938606864,
    "text": "而是穿着白大褂，"
  },
  {
    "start": 167.5241938606864,
    "end": 170.32958800166637,
    "text": "让你放心把后背交给他的那个人。"
  },
  {
    "start": 170.32958800166637,
    "end": 173.0325954951653,
    "text": "你敢把信任交给熟人医生吗？"
  },
  {
    "start": 173.0325954951653,
    "end": 174.00000000000006,
    "text": "评论区聊聊。"
  }
]