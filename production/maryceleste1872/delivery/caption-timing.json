[
  {
    "start": 0.35,
    "end": 1.4533977348434375,
    "text": "一八七二年，"
  },
  {
    "start": 1.4533977348434375,
    "end": 3.5753164556962025,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 4.193704197201865,
    "end": 5.478980679546968,
    "text": "灯火未熄，"
  },
  {
    "start": 5.7578614257161895,
    "end": 6.9340106595602915,
    "text": "早餐未凉，"
  },
  {
    "start": 7.1765156562291805,
    "end": 8.243537641572285,
    "text": "可是十个人，"
  },
  {
    "start": 8.243537641572285,
    "end": 9.383311125916055,
    "text": "全都消失了。"
  },
  {
    "start": 10.35,
    "end": 11.543026076409944,
    "text": "十一月七日，"
  },
  {
    "start": 11.728350515463918,
    "end": 12.956124924196482,
    "text": "纽约天刚亮。"
  },
  {
    "start": 13.535263796240145,
    "end": 15.585415403274713,
    "text": "玛丽·赛勒斯特号启航，"
  },
  {
    "start": 15.817070952092177,
    "end": 17.484990903577923,
    "text": "驶向意大利热那亚。"
  },
  {
    "start": 18.075712553062463,
    "end": 19.326652516676774,
    "text": "船长布里格斯，"
  },
  {
    "start": 19.616221952698602,
    "end": 21.49263189812007,
    "text": "带上妻子和两岁的女儿。"
  },
  {
    "start": 22.141267434808974,
    "end": 23.867101273499088,
    "text": "七名船员各就各位，"
  },
  {
    "start": 23.867101273499088,
    "end": 24.816889023650695,
    "text": "帆索绷紧。"
  },
  {
    "start": 25.453941782898724,
    "end": 26.125742874469374,
    "text": "货舱里，"
  },
  {
    "start": 26.334232868405095,
    "end": 29.39208611279563,
    "text": "一千七百多桶工业酒精静静堆着。"
  },
  {
    "start": 30.35,
    "end": 31.196925064599483,
    "text": "一个月后，"
  },
  {
    "start": 31.196925064599483,
    "end": 32.2680361757106,
    "text": "十二月四日，"
  },
  {
    "start": 32.2680361757106,
    "end": 33.849793281653746,
    "text": "亚速尔群岛附近。"
  },
  {
    "start": 34.858630490956074,
    "end": 38.84416020671834,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 38.84416020671834,
    "end": 40.99883720930232,
    "text": "可它的帆破破烂烂，"
  },
  {
    "start": 40.99883720930232,
    "end": 42.68023255813954,
    "text": "航向歪歪扭扭，"
  },
  {
    "start": 42.90441860465116,
    "end": 44.21217054263566,
    "text": "像喝醉了酒。"
  },
  {
    "start": 44.21217054263566,
    "end": 47.03940568475452,
    "text": "摩尔豪斯船长连喊几声，"
  },
  {
    "start": 47.28850129198966,
    "end": 48.13542635658915,
    "text": "海上一片死寂。"
  },
  {
    "start": 48.13542635658915,
    "end": 49.20653746770026,
    "text": "水手们放下小艇，"
  },
  {
    "start": 49.49299741602067,
    "end": 51.336304909560724,
    "text": "贴着船舷爬上去。"
  },
  {
    "start": 51.996408268733845,
    "end": 53.00524547803617,
    "text": "甲板上，"
  },
  {
    "start": 53.229431524547806,
    "end": 54.37527131782946,
    "text": "一个人都没有。"
  },
  {
    "start": 55.35,
    "end": 56.931974324922535,
    "text": "船体几乎完好，"
  },
  {
    "start": 57.14934484285082,
    "end": 59.5887250996016,
    "text": "食物和淡水够吃半年。"
  },
  {
    "start": 60.192532093846836,
    "end": 61.77450641876937,
    "text": "船员的行李都在，"
  },
  {
    "start": 61.99187693669766,
    "end": 64.612399291722,
    "text": "小女孩的红外套和布偶兔子，"
  },
  {
    "start": 64.8418459495352,
    "end": 66.3513634351483,
    "text": "还留在小床上。"
  },
  {
    "start": 66.94309428950864,
    "end": 68.57337317397078,
    "text": "可是救生艇不见了，"
  },
  {
    "start": 68.79074369189907,
    "end": 70.43309871624612,
    "text": "航海仪器也不见了，"
  },
  {
    "start": 70.63839309428951,
    "end": 75.85528552456839,
    "text": "只留下拆开的抽水泵和敞开的工具箱。"
  },
  {
    "start": 76.49532093846835,
    "end": 77.17158477202302,
    "text": "最后一篇日志，"
  },
  {
    "start": 77.17158477202302,
    "end": 78.3550464807437,
    "text": "停在十天前，"
  },
  {
    "start": 78.49996015936256,
    "end": 80.00947764497565,
    "text": "笔迹平平稳稳，"
  },
  {
    "start": 80.23892430278885,
    "end": 81.34992917220009,
    "text": "断在半页。"
  },
  {
    "start": 82.02619300575476,
    "end": 83.47532979194334,
    "text": "没有打斗痕迹，"
  },
  {
    "start": 83.72892872952633,
    "end": 85.39543603364321,
    "text": "没有求救信号。"
  },
  {
    "start": 85.99924302788844,
    "end": 87.6657503320053,
    "text": "他们是自己离开的，"
  },
  {
    "start": 87.8951969898185,
    "end": 89.3805621956618,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.35,
    "end": 91.85996729702829,
    "text": "有人说是海盗干的。"
  },
  {
    "start": 92.41398407507464,
    "end": 93.44597611261197,
    "text": "黑旗升起，"
  },
  {
    "start": 93.63064837196075,
    "end": 94.87990189108488,
    "text": "刀光映着火把。"
  },
  {
    "start": 95.48823403952794,
    "end": 96.75921370681074,
    "text": "可值钱的货物，"
  },
  {
    "start": 97.00906441063557,
    "end": 97.88897341106212,
    "text": "一件没少。"
  },
  {
    "start": 98.4755794113465,
    "end": 100.33316507891368,
    "text": "有人说是船员叛变。"
  },
  {
    "start": 100.8763187828807,
    "end": 102.57095833925777,
    "text": "可船长威望极高，"
  },
  {
    "start": 102.7664936726859,
    "end": 104.12437793260344,
    "text": "水手们都服他，"
  },
  {
    "start": 104.31991326603156,
    "end": 106.52511730413762,
    "text": "现场也没有半点争斗的痕迹。"
  },
  {
    "start": 107.08999715626332,
    "end": 108.03508460116592,
    "text": "两个猜想，"
  },
  {
    "start": 108.23061993459405,
    "end": 109.39296886108346,
    "text": "两处说不通。"
  },
  {
    "start": 110.35,
    "end": 112.16226892317931,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 112.56221792691544,
    "end": 114.31199481826098,
    "text": "从深海伸出触手，"
  },
  {
    "start": 114.31199481826098,
    "end": 115.94928605230574,
    "text": "把船拖进地狱。"
  },
  {
    "start": 116.74918405977799,
    "end": 118.93640517395991,
    "text": "有人说是海上龙卷风，"
  },
  {
    "start": 119.32385577132929,
    "end": 120.57369640800468,
    "text": "或者海底地震，"
  },
  {
    "start": 120.98614381810755,
    "end": 122.93589521132117,
    "text": "一夜之间掀翻了它。"
  },
  {
    "start": 123.81078365699393,
    "end": 125.46994710218051,
    "text": "听起来够刺激。"
  },
  {
    "start": 125.46994710218051,
    "end": 126.02300158390938,
    "text": "可是，"
  },
  {
    "start": 126.02300158390938,
    "end": 127.84776891345544,
    "text": "船本身几乎完好，"
  },
  {
    "start": 128.24771791719158,
    "end": 129.39757130293293,
    "text": "桅杆还在，"
  },
  {
    "start": 129.84751393213605,
    "end": 131.09735456881145,
    "text": "船帆还在，"
  },
  {
    "start": 131.48480516618082,
    "end": 134.371937036901,
    "text": "不像遭遇过任何毁灭性的灾难。"
  },
  {
    "start": 135.35,
    "end": 136.00542832909244,
    "text": "近年来，"
  },
  {
    "start": 136.00542832909244,
    "end": 137.6737913486005,
    "text": "科学家做过实验。"
  },
  {
    "start": 138.2696352841391,
    "end": 139.43748939779474,
    "text": "密闭舱室里，"
  },
  {
    "start": 139.62815945716707,
    "end": 143.87056827820186,
    "text": "酒精蒸汽能引发一次几乎没有火光的爆燃，"
  },
  {
    "start": 144.1565733672604,
    "end": 145.2886768447837,
    "text": "冲开舱盖，"
  },
  {
    "start": 145.5031806615776,
    "end": 147.18346055979643,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 147.89847328244275,
    "end": 149.80517387616624,
    "text": "这或许能解释一切："
  },
  {
    "start": 150.00776081424937,
    "end": 153.02273112807464,
    "text": "船长以为大船随时会再炸，"
  },
  {
    "start": 153.27298558100085,
    "end": 156.15687022900764,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 156.39520780322306,
    "end": 157.93248515691263,
    "text": "再用一根长绳，"
  },
  {
    "start": 158.12315521628497,
    "end": 159.87818644459864,
    "text": "把小艇拴在大船后面。"
  },
  {
    "start": 159.87818644459864,
    "end": 160.33969465648855,
    "text": "可是，"
  },
  {
    "start": 160.62569974554708,
    "end": 162.2106446140797,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 162.2106446140797,
    "end": 163.34274809160306,
    "text": "绳子断了。"
  },
  {
    "start": 164.4203147699758,
    "end": 166.61179176755448,
    "text": "大船张满帆继续前行，"
  },
  {
    "start": 166.83445520581114,
    "end": 167.9477723970944,
    "text": "而救生艇，"
  },
  {
    "start": 168.1352784503632,
    "end": 169.6001694915254,
    "text": "再也没人见到。"
  },
  {
    "start": 170.43222760290556,
    "end": 171.7564891041162,
    "text": "这解释最合理，"
  },
  {
    "start": 172.02602905569006,
    "end": 173.3971670702179,
    "text": "却没有人能证明。"
  },
  {
    "start": 173.9831234866828,
    "end": 174.5690799031477,
    "text": "你觉得，"
  },
  {
    "start": 174.5690799031477,
    "end": 176.39726392251816,
    "text": "他们到底遇到了什么？"
  }
]