[
  {
    "start": 0.35,
    "end": 1.5499999999999998,
    "text": "一八七二年，"
  },
  {
    "start": 1.8399999999999999,
    "end": 3.5500000000000003,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 3.85,
    "end": 5.21,
    "text": "灯火未熄，"
  },
  {
    "start": 5.5,
    "end": 6.739999999999999,
    "text": "早餐未凉，"
  },
  {
    "start": 7.03,
    "end": 7.989999999999999,
    "text": "可是十个人，"
  },
  {
    "start": 8.280000000000001,
    "end": 9.45,
    "text": "全都消失了。"
  },
  {
    "start": 10.35,
    "end": 11.6,
    "text": "十一月七日，"
  },
  {
    "start": 11.85,
    "end": 13.329999999999998,
    "text": "纽约天刚亮。"
  },
  {
    "start": 13.589999999999998,
    "end": 15.7,
    "text": "玛丽·赛勒斯特号启航，"
  },
  {
    "start": 15.95,
    "end": 17.729999999999997,
    "text": "驶向意大利热那亚。"
  },
  {
    "start": 17.979999999999997,
    "end": 19.459999999999997,
    "text": "船长布里格斯，"
  },
  {
    "start": 19.72,
    "end": 21.739999999999995,
    "text": "带上妻子和两岁的女儿。"
  },
  {
    "start": 21.99,
    "end": 23.669999999999995,
    "text": "七名船员各就各位，"
  },
  {
    "start": 23.919999999999995,
    "end": 25.009999999999994,
    "text": "帆索绷紧。"
  },
  {
    "start": 25.269999999999996,
    "end": 26.229999999999997,
    "text": "货舱里，"
  },
  {
    "start": 26.479999999999997,
    "end": 29.449999999999996,
    "text": "一千七百多桶工业酒精静静堆着。"
  },
  {
    "start": 30.35,
    "end": 31.3,
    "text": "一个月后，"
  },
  {
    "start": 31.61,
    "end": 32.79,
    "text": "十二月四日，"
  },
  {
    "start": 33.1,
    "end": 34.72,
    "text": "亚速尔群岛附近。"
  },
  {
    "start": 35.03,
    "end": 38.22,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 38.53,
    "end": 40.37,
    "text": "可它的帆破破烂烂，"
  },
  {
    "start": 40.68,
    "end": 42.2,
    "text": "航向歪歪扭扭，"
  },
  {
    "start": 42.51,
    "end": 43.56999999999999,
    "text": "像喝醉了酒。"
  },
  {
    "start": 43.879999999999995,
    "end": 46.169999999999995,
    "text": "摩尔豪斯船长连喊几声，"
  },
  {
    "start": 46.48,
    "end": 47.879999999999995,
    "text": "海上一片死寂。"
  },
  {
    "start": 48.19,
    "end": 49.339999999999996,
    "text": "水手们放下小艇，"
  },
  {
    "start": 49.65,
    "end": 51.58,
    "text": "贴着船舷爬上去。"
  },
  {
    "start": 51.89,
    "end": 52.959999999999994,
    "text": "甲板上，"
  },
  {
    "start": 53.269999999999996,
    "end": 54.449999999999996,
    "text": "一个人都没有。"
  },
  {
    "start": 55.35,
    "end": 56.85,
    "text": "船体几乎完好，"
  },
  {
    "start": 57.21,
    "end": 59.620000000000005,
    "text": "食物和淡水够吃半年。"
  },
  {
    "start": 59.99,
    "end": 61.65,
    "text": "船员的行李都在，"
  },
  {
    "start": 62.010000000000005,
    "end": 64.48,
    "text": "小女孩的红外套和布偶兔子，"
  },
  {
    "start": 64.84,
    "end": 66.45,
    "text": "还留在小床上。"
  },
  {
    "start": 66.82000000000001,
    "end": 68.51,
    "text": "可是救生艇不见了，"
  },
  {
    "start": 68.87,
    "end": 70.55,
    "text": "航海仪器也不见了，"
  },
  {
    "start": 70.91,
    "end": 74.86,
    "text": "只留下拆开的抽水泵和敞开的工具箱。"
  },
  {
    "start": 75.23,
    "end": 76.67,
    "text": "最后一篇日志，"
  },
  {
    "start": 77.03,
    "end": 78.02,
    "text": "停在十天前，"
  },
  {
    "start": 78.39,
    "end": 79.78,
    "text": "笔迹平平稳稳，"
  },
  {
    "start": 80.14,
    "end": 81.38,
    "text": "断在半页。"
  },
  {
    "start": 81.74000000000001,
    "end": 83.35,
    "text": "没有打斗痕迹，"
  },
  {
    "start": 83.72,
    "end": 85.51,
    "text": "没有求救信号。"
  },
  {
    "start": 85.87,
    "end": 87.62,
    "text": "他们是自己离开的，"
  },
  {
    "start": 87.97999999999999,
    "end": 89.45,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.35,
    "end": 91.96,
    "text": "有人说是海盗干的。"
  },
  {
    "start": 92.17999999999999,
    "end": 93.39999999999999,
    "text": "黑旗升起，"
  },
  {
    "start": 93.61999999999999,
    "end": 95.02999999999999,
    "text": "刀光映着火把。"
  },
  {
    "start": 95.25,
    "end": 96.72,
    "text": "可值钱的货物，"
  },
  {
    "start": 96.94,
    "end": 98.02999999999999,
    "text": "一件没少。"
  },
  {
    "start": 98.25,
    "end": 100.36999999999999,
    "text": "有人说是船员叛变。"
  },
  {
    "start": 100.58999999999999,
    "end": 102.46999999999998,
    "text": "可船长威望极高，"
  },
  {
    "start": 102.69,
    "end": 104.10999999999999,
    "text": "水手们都服他，"
  },
  {
    "start": 104.32999999999998,
    "end": 106.64999999999999,
    "text": "现场也没有半点争斗的痕迹。"
  },
  {
    "start": 106.86999999999999,
    "end": 108.01999999999998,
    "text": "两个猜想，"
  },
  {
    "start": 108.24,
    "end": 109.44999999999999,
    "text": "两处说不通。"
  },
  {
    "start": 110.35,
    "end": 111.97,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 112.49,
    "end": 114.41,
    "text": "从深海伸出触手，"
  },
  {
    "start": 114.92999999999999,
    "end": 116.14999999999999,
    "text": "把船拖进地狱。"
  },
  {
    "start": 116.66999999999999,
    "end": 118.66999999999999,
    "text": "有人说是海上龙卷风，"
  },
  {
    "start": 119.19,
    "end": 120.44,
    "text": "或者海底地震，"
  },
  {
    "start": 120.96,
    "end": 122.92999999999999,
    "text": "一夜之间掀翻了它。"
  },
  {
    "start": 123.44999999999999,
    "end": 125.145,
    "text": "听起来够刺激。"
  },
  {
    "start": 125.145,
    "end": 125.77,
    "text": "可是，"
  },
  {
    "start": 126.28999999999999,
    "end": 127.91999999999999,
    "text": "船本身几乎完好，"
  },
  {
    "start": 128.44,
    "end": 129.73999999999998,
    "text": "桅杆还在，"
  },
  {
    "start": 130.26,
    "end": 130.94,
    "text": "船帆还在，"
  },
  {
    "start": 131.45999999999998,
    "end": 134.45,
    "text": "不像遭遇过任何毁灭性的灾难。"
  },
  {
    "start": 135.35,
    "end": 136.09,
    "text": "近年来，"
  },
  {
    "start": 136.43,
    "end": 137.91,
    "text": "科学家做过实验。"
  },
  {
    "start": 138.23999999999998,
    "end": 139.48,
    "text": "密闭舱室里，"
  },
  {
    "start": 139.82,
    "end": 143.59,
    "text": "酒精蒸汽能引发一次几乎没有火光的爆燃，"
  },
  {
    "start": 143.92,
    "end": 145.1,
    "text": "冲开舱盖，"
  },
  {
    "start": 145.44,
    "end": 147.14,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 147.47,
    "end": 149.5,
    "text": "这或许能解释一切："
  },
  {
    "start": 149.84,
    "end": 152.70999999999998,
    "text": "船长以为大船随时会再炸，"
  },
  {
    "start": 153.04999999999998,
    "end": 155.83999999999997,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 156.17,
    "end": 157.54,
    "text": "再用一根长绳，"
  },
  {
    "start": 157.88,
    "end": 159.66363636363636,
    "text": "把小艇拴在大船后面。"
  },
  {
    "start": 159.66363636363636,
    "end": 160.11999999999998,
    "text": "可是，"
  },
  {
    "start": 160.45,
    "end": 162.17999999999998,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 162.51999999999998,
    "end": 163.45,
    "text": "绳子断了。"
  },
  {
    "start": 164.35,
    "end": 166.43,
    "text": "大船张满帆继续前行，"
  },
  {
    "start": 166.75,
    "end": 167.92,
    "text": "而救生艇，"
  },
  {
    "start": 168.23999999999998,
    "end": 169.78,
    "text": "再也没人见到。"
  },
  {
    "start": 170.1,
    "end": 171.57,
    "text": "这解释最合理，"
  },
  {
    "start": 171.89,
    "end": 173.42,
    "text": "却没有人能证明。"
  },
  {
    "start": 173.74,
    "end": 174.2,
    "text": "你觉得，"
  },
  {
    "start": 174.53,
    "end": 176.45,
    "text": "他们到底遇到了什么？"
  }
]