[
  {
    "start": 0.35,
    "end": 1.5699999999999998,
    "text": "一八七二年，"
  },
  {
    "start": 1.8199999999999998,
    "end": 3.77,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 4.01,
    "end": 6.67,
    "text": "船上的东西几乎原封不动，"
  },
  {
    "start": 6.92,
    "end": 8.06,
    "text": "可是十个人，"
  },
  {
    "start": 8.31,
    "end": 9.45,
    "text": "全都消失了。"
  },
  {
    "start": 10.35,
    "end": 11.549999999999999,
    "text": "十一月七日，"
  },
  {
    "start": 12.02,
    "end": 14.649999999999999,
    "text": "玛丽·赛勒斯特号从纽约出发，"
  },
  {
    "start": 15.11,
    "end": 17.06,
    "text": "前往意大利热那亚。"
  },
  {
    "start": 17.529999999999998,
    "end": 20.059999999999995,
    "text": "船长布里格斯经验丰富，"
  },
  {
    "start": 20.529999999999998,
    "end": 22.399999999999995,
    "text": "船上载着他的妻子、"
  },
  {
    "start": 22.859999999999996,
    "end": 23.929999999999993,
    "text": "两岁的女儿，"
  },
  {
    "start": 24.4,
    "end": 25.969999999999995,
    "text": "还有七名船员，"
  },
  {
    "start": 26.439999999999998,
    "end": 29.449999999999996,
    "text": "货物是一千七百多桶工业酒精。"
  },
  {
    "start": 30.35,
    "end": 31.32,
    "text": "一个月后，"
  },
  {
    "start": 32.050000000000004,
    "end": 32.92,
    "text": "十二月四日，"
  },
  {
    "start": 33.660000000000004,
    "end": 35.55,
    "text": "在亚速尔群岛附近，"
  },
  {
    "start": 36.28,
    "end": 39.94,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 40.67,
    "end": 42.73,
    "text": "它的帆破破烂烂，"
  },
  {
    "start": 43.46,
    "end": 44.39,
    "text": "航向混乱，"
  },
  {
    "start": 45.129999999999995,
    "end": 45.78,
    "text": "喊了半天，"
  },
  {
    "start": 46.51,
    "end": 47.26,
    "text": "没有人回应。"
  },
  {
    "start": 47.989999999999995,
    "end": 50.17,
    "text": "水手们划着小艇靠近，"
  },
  {
    "start": 50.91,
    "end": 52.11,
    "text": "爬上甲板，"
  },
  {
    "start": 52.84,
    "end": 54.449999999999996,
    "text": "一个人都没有。"
  },
  {
    "start": 55.35,
    "end": 56.88,
    "text": "船体几乎完好，"
  },
  {
    "start": 58.47,
    "end": 60.89,
    "text": "食物和淡水够吃半年，"
  },
  {
    "start": 62.47,
    "end": 64.93857142857144,
    "text": "船员的行李和私人物品都在。"
  },
  {
    "start": 64.93857142857144,
    "end": 65.41,
    "text": "可是，"
  },
  {
    "start": 67.0,
    "end": 68.37,
    "text": "救生艇不见了，"
  },
  {
    "start": 69.96000000000001,
    "end": 71.62,
    "text": "航海仪器不见了，"
  },
  {
    "start": 73.2,
    "end": 75.78999999999999,
    "text": "最后一篇日志停在十天前。"
  },
  {
    "start": 77.38,
    "end": 79.5,
    "text": "没有明确的打斗痕迹，"
  },
  {
    "start": 81.09,
    "end": 82.94,
    "text": "没有求救信号。"
  },
  {
    "start": 84.52000000000001,
    "end": 86.31,
    "text": "他们是自己离开的，"
  },
  {
    "start": 87.9,
    "end": 89.45,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.35,
    "end": 91.66,
    "text": "有人说是海盗，"
  },
  {
    "start": 94.05999999999999,
    "end": 96.14999999999999,
    "text": "可是值钱的货物一件没少。"
  },
  {
    "start": 98.55,
    "end": 100.69,
    "text": "有人说是船员叛变，"
  },
  {
    "start": 103.07999999999998,
    "end": 104.99,
    "text": "可是船长威望很高，"
  },
  {
    "start": 107.38999999999999,
    "end": 109.44999999999999,
    "text": "现场也没有争斗痕迹。"
  },
  {
    "start": 110.35,
    "end": 112.19999999999999,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 115.36,
    "end": 118.35999999999999,
    "text": "有人说是海上龙卷风和海底地震。"
  },
  {
    "start": 121.52,
    "end": 123.18499999999999,
    "text": "听起来很刺激，"
  },
  {
    "start": 123.18499999999999,
    "end": 123.79999999999998,
    "text": "可是，"
  },
  {
    "start": 126.96,
    "end": 128.88,
    "text": "船本身几乎完好，"
  },
  {
    "start": 132.03,
    "end": 134.45,
    "text": "不像遭遇过毁灭性的灾难。"
  },
  {
    "start": 135.35,
    "end": 136.07,
    "text": "近年来，"
  },
  {
    "start": 136.76,
    "end": 138.37,
    "text": "科学家做了实验："
  },
  {
    "start": 139.07,
    "end": 143.35,
    "text": "酒精蒸汽可以发生一次几乎没有火光的爆燃，"
  },
  {
    "start": 144.04,
    "end": 145.32999999999998,
    "text": "冲开舱盖，"
  },
  {
    "start": 146.03,
    "end": 147.83999999999997,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 148.53,
    "end": 151.48999999999998,
    "text": "船长害怕大船随时再次爆炸，"
  },
  {
    "start": 152.18,
    "end": 154.56,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 155.26,
    "end": 158.82470588235293,
    "text": "并用一根长绳把小艇拴在大船后面。"
  },
  {
    "start": 158.82470588235293,
    "end": 159.35999999999999,
    "text": "可是，"
  },
  {
    "start": 160.04999999999998,
    "end": 161.7,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 162.39999999999998,
    "end": 163.45,
    "text": "绳子断了。"
  },
  {
    "start": 164.35,
    "end": 166.98,
    "text": "大船带着满帆继续前行，"
  },
  {
    "start": 167.19,
    "end": 167.85999999999999,
    "text": "而救生艇，"
  },
  {
    "start": 168.07,
    "end": 170.03,
    "text": "再也没人见到。"
  },
  {
    "start": 170.23,
    "end": 171.68,
    "text": "这个解释最合理，"
  },
  {
    "start": 171.89,
    "end": 173.54,
    "text": "但没有人能证明。"
  },
  {
    "start": 173.75,
    "end": 174.66,
    "text": "你觉得，"
  },
  {
    "start": 174.87,
    "end": 176.45,
    "text": "他们到底遇到了什么？"
  }
]