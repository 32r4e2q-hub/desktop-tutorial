[
  {
    "start": 0.35,
    "end": 1.4900000000000002,
    "text": "一八七二年，"
  },
  {
    "start": 1.71,
    "end": 3.21,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 4.75,
    "end": 5.81,
    "text": "灯火未熄，"
  },
  {
    "start": 6.03,
    "end": 7.01,
    "text": "早餐未凉，"
  },
  {
    "start": 7.23,
    "end": 8.0,
    "text": "可是十个人，"
  },
  {
    "start": 8.22,
    "end": 9.329999999999998,
    "text": "全都消失了。"
  },
  {
    "start": 10.35,
    "end": 11.36,
    "text": "十一月七日，"
  },
  {
    "start": 11.58,
    "end": 12.639999999999999,
    "text": "纽约天刚亮。"
  },
  {
    "start": 13.809999999999999,
    "end": 15.59,
    "text": "玛丽·赛勒斯特号启航，"
  },
  {
    "start": 15.809999999999999,
    "end": 17.22,
    "text": "驶向意大利热那亚。"
  },
  {
    "start": 18.4,
    "end": 19.479999999999997,
    "text": "船长布里格斯，"
  },
  {
    "start": 19.699999999999996,
    "end": 21.33,
    "text": "带上妻子和两岁的女儿。"
  },
  {
    "start": 22.499999999999996,
    "end": 23.919999999999995,
    "text": "七名船员各就各位，"
  },
  {
    "start": 24.139999999999997,
    "end": 24.919999999999995,
    "text": "帆索绷紧。"
  },
  {
    "start": 26.099999999999994,
    "end": 26.689999999999998,
    "text": "货舱里，"
  },
  {
    "start": 26.909999999999997,
    "end": 29.449999999999996,
    "text": "一千七百多桶工业酒精静静堆着。"
  },
  {
    "start": 30.35,
    "end": 31.28,
    "text": "一个月后，"
  },
  {
    "start": 31.5,
    "end": 32.68,
    "text": "十二月四日，"
  },
  {
    "start": 32.9,
    "end": 34.07,
    "text": "亚速尔群岛附近。"
  },
  {
    "start": 35.370000000000005,
    "end": 38.03,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 38.25,
    "end": 40.089999999999996,
    "text": "可它的帆破破烂烂，"
  },
  {
    "start": 40.31,
    "end": 41.6,
    "text": "航向歪歪扭扭，"
  },
  {
    "start": 41.82,
    "end": 42.669999999999995,
    "text": "像喝醉了酒。"
  },
  {
    "start": 43.96,
    "end": 46.05,
    "text": "摩尔豪斯船长连喊几声，"
  },
  {
    "start": 46.269999999999996,
    "end": 47.23,
    "text": "海上一片死寂。"
  },
  {
    "start": 48.53,
    "end": 49.48,
    "text": "水手们放下小艇，"
  },
  {
    "start": 49.7,
    "end": 51.239999999999995,
    "text": "贴着船舷爬上去。"
  },
  {
    "start": 52.54,
    "end": 53.339999999999996,
    "text": "甲板上，"
  },
  {
    "start": 53.56,
    "end": 54.449999999999996,
    "text": "一个人都没有。"
  },
  {
    "start": 55.35,
    "end": 56.65,
    "text": "船体几乎完好，"
  },
  {
    "start": 56.870000000000005,
    "end": 58.800000000000004,
    "text": "食物和淡水够吃半年。"
  },
  {
    "start": 60.34,
    "end": 61.620000000000005,
    "text": "船员的行李都在，"
  },
  {
    "start": 61.84,
    "end": 63.94,
    "text": "小女孩的红外套和布偶兔子，"
  },
  {
    "start": 64.16,
    "end": 65.39,
    "text": "还留在小床上。"
  },
  {
    "start": 66.93,
    "end": 68.19,
    "text": "可是救生艇不见了，"
  },
  {
    "start": 68.41,
    "end": 69.74,
    "text": "航海仪器也不见了，"
  },
  {
    "start": 69.96000000000001,
    "end": 73.38,
    "text": "只留下拆开的抽水泵和敞开的工具箱。"
  },
  {
    "start": 74.92,
    "end": 76.23,
    "text": "最后一篇日志，"
  },
  {
    "start": 76.45,
    "end": 77.1,
    "text": "停在十天前，"
  },
  {
    "start": 77.33,
    "end": 78.53,
    "text": "笔迹平平稳稳，"
  },
  {
    "start": 78.76,
    "end": 79.64,
    "text": "断在半页。"
  },
  {
    "start": 81.18,
    "end": 82.28,
    "text": "没有打斗痕迹，"
  },
  {
    "start": 82.5,
    "end": 83.86,
    "text": "没有求救信号。"
  },
  {
    "start": 85.4,
    "end": 86.75,
    "text": "他们是自己离开的，"
  },
  {
    "start": 86.97,
    "end": 88.16,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.35,
    "end": 91.72,
    "text": "有人说是海盗干的。"
  },
  {
    "start": 92.53999999999999,
    "end": 93.49,
    "text": "黑旗升起，"
  },
  {
    "start": 93.71,
    "end": 94.86,
    "text": "刀光映着火把。"
  },
  {
    "start": 95.66999999999999,
    "end": 96.85,
    "text": "可值钱的货物，"
  },
  {
    "start": 97.08,
    "end": 97.88999999999999,
    "text": "一件没少。"
  },
  {
    "start": 98.71,
    "end": 100.41999999999999,
    "text": "有人说是船员叛变。"
  },
  {
    "start": 101.22999999999999,
    "end": 102.79999999999998,
    "text": "可船长威望极高，"
  },
  {
    "start": 103.02,
    "end": 104.27999999999999,
    "text": "水手们都服他，"
  },
  {
    "start": 104.49999999999999,
    "end": 106.49999999999999,
    "text": "现场也没有半点争斗的痕迹。"
  },
  {
    "start": 107.32,
    "end": 108.19999999999999,
    "text": "两个猜想，"
  },
  {
    "start": 108.41999999999999,
    "end": 109.44999999999999,
    "text": "两处说不通。"
  },
  {
    "start": 110.35,
    "end": 111.77,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 111.99,
    "end": 113.69,
    "text": "从深海伸出触手，"
  },
  {
    "start": 113.91,
    "end": 114.88999999999999,
    "text": "把船拖进地狱。"
  },
  {
    "start": 116.44,
    "end": 118.14999999999999,
    "text": "有人说是海上龙卷风，"
  },
  {
    "start": 118.36999999999999,
    "end": 119.35,
    "text": "或者海底地震，"
  },
  {
    "start": 119.57,
    "end": 121.13,
    "text": "一夜之间掀翻了它。"
  },
  {
    "start": 122.66999999999999,
    "end": 123.86999999999999,
    "text": "听起来够刺激。"
  },
  {
    "start": 123.86999999999999,
    "end": 124.32999999999998,
    "text": "可是，"
  },
  {
    "start": 124.55,
    "end": 125.97999999999999,
    "text": "船本身几乎完好，"
  },
  {
    "start": 126.19999999999999,
    "end": 127.10999999999999,
    "text": "桅杆还在，"
  },
  {
    "start": 127.32999999999998,
    "end": 127.79999999999998,
    "text": "船帆还在，"
  },
  {
    "start": 128.01999999999998,
    "end": 130.82,
    "text": "不像遭遇过任何毁灭性的灾难。"
  },
  {
    "start": 135.35,
    "end": 136.04,
    "text": "近年来，"
  },
  {
    "start": 136.26,
    "end": 137.53,
    "text": "科学家做过实验。"
  },
  {
    "start": 139.07,
    "end": 140.04999999999998,
    "text": "密闭舱室里，"
  },
  {
    "start": 140.26999999999998,
    "end": 143.73999999999998,
    "text": "酒精蒸汽能引发一次几乎没有火光的爆燃，"
  },
  {
    "start": 143.95,
    "end": 144.89999999999998,
    "text": "冲开舱盖，"
  },
  {
    "start": 145.12,
    "end": 146.5,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 148.04,
    "end": 149.64,
    "text": "这或许能解释一切："
  },
  {
    "start": 149.85999999999999,
    "end": 152.26999999999998,
    "text": "船长以为大船随时会再炸，"
  },
  {
    "start": 152.48999999999998,
    "end": 154.87,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 155.09,
    "end": 156.26999999999998,
    "text": "再用一根长绳，"
  },
  {
    "start": 156.48999999999998,
    "end": 158.01999999999998,
    "text": "把小艇拴在大船后面。"
  },
  {
    "start": 158.01999999999998,
    "end": 158.42,
    "text": "可是，"
  },
  {
    "start": 158.64,
    "end": 160.10999999999999,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 160.32999999999998,
    "end": 161.14999999999998,
    "text": "绳子断了。"
  },
  {
    "start": 164.35,
    "end": 166.23,
    "text": "大船张满帆继续前行，"
  },
  {
    "start": 166.45,
    "end": 167.39,
    "text": "而救生艇，"
  },
  {
    "start": 167.60999999999999,
    "end": 168.85,
    "text": "再也没人见到。"
  },
  {
    "start": 170.28,
    "end": 171.39,
    "text": "这解释最合理，"
  },
  {
    "start": 171.60999999999999,
    "end": 172.78,
    "text": "却没有人能证明。"
  },
  {
    "start": 174.21,
    "end": 174.44,
    "text": "你觉得，"
  },
  {
    "start": 174.66,
    "end": 176.45,
    "text": "他们到底遇到了什么？"
  }
]