[
  {
    "start": 0.38585029546946814,
    "end": 1.4733092580433356,
    "text": "一八七二年，"
  },
  {
    "start": 1.4733092580433356,
    "end": 3.5645764937623112,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 4.17403151674327,
    "end": 5.4407419566644775,
    "text": "灯火未熄，"
  },
  {
    "start": 5.715594221930401,
    "end": 6.874753775443204,
    "text": "早餐未凉，"
  },
  {
    "start": 7.113755745239658,
    "end": 8.165364412344058,
    "text": "可是十个人，"
  },
  {
    "start": 8.165364412344058,
    "end": 9.288673670387393,
    "text": "全都消失了。"
  },
  {
    "start": 10.37301204819277,
    "end": 11.569638554216867,
    "text": "十一月七日，"
  },
  {
    "start": 11.753734939759035,
    "end": 12.973373493975902,
    "text": "纽约天刚亮。"
  },
  {
    "start": 13.54867469879518,
    "end": 15.58524096385542,
    "text": "玛丽·赛勒斯特号启航，"
  },
  {
    "start": 15.815361445783132,
    "end": 17.472228915662647,
    "text": "驶向意大利热那亚。"
  },
  {
    "start": 18.05903614457831,
    "end": 19.30168674698795,
    "text": "船长布里格斯，"
  },
  {
    "start": 19.58933734939759,
    "end": 21.453313253012045,
    "text": "带上妻子和两岁的女儿。"
  },
  {
    "start": 22.097650602409637,
    "end": 23.812048192771083,
    "text": "七名船员各就各位，"
  },
  {
    "start": 23.812048192771083,
    "end": 24.755542168674694,
    "text": "帆索绷紧。"
  },
  {
    "start": 25.3883734939759,
    "end": 26.055722891566262,
    "text": "货舱里，"
  },
  {
    "start": 26.2628313253012,
    "end": 29.300421686746986,
    "text": "一千七百多桶工业酒精静静堆着。"
  },
  {
    "start": 30.374768756423435,
    "end": 31.229290853031863,
    "text": "一个月后，"
  },
  {
    "start": 31.229290853031863,
    "end": 32.29434737923947,
    "text": "十二月四日，"
  },
  {
    "start": 32.29434737923947,
    "end": 33.86716341212744,
    "text": "亚速尔群岛附近。"
  },
  {
    "start": 34.870298047276464,
    "end": 38.84568345323741,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 38.84568345323741,
    "end": 40.975796505652625,
    "text": "可它的帆破破烂烂，"
  },
  {
    "start": 40.975796505652625,
    "end": 42.647687564234324,
    "text": "航向歪歪扭扭，"
  },
  {
    "start": 42.87060637204522,
    "end": 44.170966084275435,
    "text": "像喝醉了酒。"
  },
  {
    "start": 44.170966084275435,
    "end": 46.98221993833505,
    "text": "摩尔豪斯船长连喊几声，"
  },
  {
    "start": 47.229907502569375,
    "end": 48.07204522096608,
    "text": "海上一片死寂。"
  },
  {
    "start": 48.07204522096608,
    "end": 49.13710174717369,
    "text": "水手们放下小艇，"
  },
  {
    "start": 49.42194244604316,
    "end": 51.25483042137718,
    "text": "贴着船舷爬上去。"
  },
  {
    "start": 51.91120246659815,
    "end": 52.914337101747165,
    "text": "甲板上，"
  },
  {
    "start": 53.137255909558064,
    "end": 54.27661870503597,
    "text": "一个人都没有。"
  },
  {
    "start": 55.37405855895582,
    "end": 56.961923450039684,
    "text": "船体几乎完好，"
  },
  {
    "start": 57.178450480642034,
    "end": 59.60836493517947,
    "text": "食物和淡水够吃半年。"
  },
  {
    "start": 60.20982890907487,
    "end": 61.78566452068084,
    "text": "船员的行李都在，"
  },
  {
    "start": 62.00219155128318,
    "end": 64.61254519798925,
    "text": "小女孩的红外套和布偶兔子，"
  },
  {
    "start": 64.8411015080695,
    "end": 66.34476144280801,
    "text": "还留在小床上。"
  },
  {
    "start": 66.93419613722551,
    "end": 68.5581488667431,
    "text": "可是救生艇不见了，"
  },
  {
    "start": 68.77467589734545,
    "end": 70.41065790634094,
    "text": "航海仪器也不见了，"
  },
  {
    "start": 70.6151556574654,
    "end": 75.81180439192168,
    "text": "只留下拆开的抽水泵和敞开的工具箱。"
  },
  {
    "start": 76.44935620425082,
    "end": 77.12299585501367,
    "text": "最后一篇日志，"
  },
  {
    "start": 77.12299585501367,
    "end": 78.30186524384867,
    "text": "停在十天前，"
  },
  {
    "start": 78.44621659758356,
    "end": 79.94987653232208,
    "text": "笔迹平平稳稳，"
  },
  {
    "start": 80.17843284240233,
    "end": 81.28512655436987,
    "text": "断在半页。"
  },
  {
    "start": 81.95876620513273,
    "end": 83.40227974248171,
    "text": "没有打斗痕迹，"
  },
  {
    "start": 83.65489461151778,
    "end": 85.31493517946909,
    "text": "没有求救信号。"
  },
  {
    "start": 85.9163991533645,
    "end": 87.57643972131581,
    "text": "他们是自己离开的，"
  },
  {
    "start": 87.80499603139606,
    "end": 89.28459740717877,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.38238660449342,
    "end": 91.88296594602232,
    "text": "有人说是海盗干的。"
  },
  {
    "start": 92.43353822241062,
    "end": 93.45911403136923,
    "text": "黑旗升起，"
  },
  {
    "start": 93.64263812349866,
    "end": 94.8841246290801,
    "text": "刀光映着火把。"
  },
  {
    "start": 95.48867457962413,
    "end": 96.75175215486787,
    "text": "可值钱的货物，"
  },
  {
    "start": 97.00004945598417,
    "end": 97.87448777730677,
    "text": "一件没少。"
  },
  {
    "start": 98.45744665818849,
    "end": 100.30348311431396,
    "text": "有人说是船员叛变。"
  },
  {
    "start": 100.84325985587112,
    "end": 102.52736328952946,
    "text": "可船长威望极高，"
  },
  {
    "start": 102.72168291649004,
    "end": 104.07112477038292,
    "text": "水手们都服他，"
  },
  {
    "start": 104.2654443973435,
    "end": 106.45693796806556,
    "text": "现场也没有半点争斗的痕迹。"
  },
  {
    "start": 107.018305779285,
    "end": 107.95751730959445,
    "text": "两个猜想，"
  },
  {
    "start": 108.15183693655503,
    "end": 109.30695916348735,
    "text": "两处说不通。"
  },
  {
    "start": 110.375,
    "end": 112.19999999999999,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 112.57499999999999,
    "end": 114.32499999999999,
    "text": "从深海伸出触手，"
  },
  {
    "start": 114.32499999999999,
    "end": 115.96249999999999,
    "text": "把船拖进地狱。"
  },
  {
    "start": 116.76249999999999,
    "end": 118.94999999999999,
    "text": "有人说是海上龙卷风，"
  },
  {
    "start": 119.3125,
    "end": 120.5625,
    "text": "或者海底地震，"
  },
  {
    "start": 120.96249999999999,
    "end": 122.9125,
    "text": "一夜之间掀翻了它。"
  },
  {
    "start": 123.76249999999999,
    "end": 125.421875,
    "text": "听起来够刺激。"
  },
  {
    "start": 125.421875,
    "end": 125.975,
    "text": "可是，"
  },
  {
    "start": 125.975,
    "end": 127.79999999999998,
    "text": "船本身几乎完好，"
  },
  {
    "start": 128.17499999999998,
    "end": 129.325,
    "text": "桅杆还在，"
  },
  {
    "start": 129.77499999999998,
    "end": 131.02499999999998,
    "text": "船帆还在，"
  },
  {
    "start": 131.3875,
    "end": 134.27499999999998,
    "text": "不像遭遇过任何毁灭性的灾难。"
  },
  {
    "start": 135.38558463486703,
    "end": 136.0379696074293,
    "text": "近年来，"
  },
  {
    "start": 136.0379696074293,
    "end": 137.69858590122413,
    "text": "科学家做过实验。"
  },
  {
    "start": 138.291663149008,
    "end": 139.4540945546644,
    "text": "密闭舱室里，"
  },
  {
    "start": 139.64387927395524,
    "end": 143.86658927817643,
    "text": "酒精蒸汽能引发一次几乎没有火光的爆燃，"
  },
  {
    "start": 144.1512663571127,
    "end": 145.27811312790206,
    "text": "冲开舱盖，"
  },
  {
    "start": 145.49162093710424,
    "end": 147.16409877585477,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 147.87579147319542,
    "end": 149.77363866610384,
    "text": "这或许能解释一切："
  },
  {
    "start": 149.97528493035034,
    "end": 152.97625580413677,
    "text": "船长以为大船随时会再炸，"
  },
  {
    "start": 153.225348248206,
    "end": 156.09584212747995,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 156.3330730265935,
    "end": 157.86321232587588,
    "text": "再用一根长绳，"
  },
  {
    "start": 158.05299704516673,
    "end": 159.7998791204574,
    "text": "把小艇拴在大船后面。"
  },
  {
    "start": 159.7998791204574,
    "end": 160.25924440692273,
    "text": "可是，"
  },
  {
    "start": 160.54392148585902,
    "end": 162.1215069649641,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 162.1215069649641,
    "end": 163.24835373575348,
    "text": "绳子断了。"
  },
  {
    "start": 164.45436032582654,
    "end": 166.62273598466697,
    "text": "大船张满帆继续前行，"
  },
  {
    "start": 166.84305222807856,
    "end": 167.94463344513656,
    "text": "而救生艇，"
  },
  {
    "start": 168.13016291327264,
    "end": 169.57961188308576,
    "text": "再也没人见到。"
  },
  {
    "start": 170.40289889793962,
    "end": 171.7132007666507,
    "text": "这解释最合理，"
  },
  {
    "start": 171.9798993770963,
    "end": 173.3365836128414,
    "text": "却没有人能证明。"
  },
  {
    "start": 173.91636320076665,
    "end": 174.49614278869188,
    "text": "你觉得，"
  },
  {
    "start": 174.49614278869188,
    "end": 176.30505510301867,
    "text": "他们到底遇到了什么？"
  }
]