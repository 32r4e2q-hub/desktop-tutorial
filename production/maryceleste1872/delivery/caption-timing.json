[
  {
    "start": 0.35,
    "end": 1.52,
    "text": "一八七二年，"
  },
  {
    "start": 1.7199999999999998,
    "end": 3.86,
    "text": "大西洋上漂着一艘船。"
  },
  {
    "start": 4.06,
    "end": 6.359999999999999,
    "text": "船上的东西几乎原封不动，"
  },
  {
    "start": 6.5600000000000005,
    "end": 7.71,
    "text": "可是十个人，"
  },
  {
    "start": 7.91,
    "end": 9.45,
    "text": "全都消失了。"
  },
  {
    "start": 10.35,
    "end": 11.42,
    "text": "十一月七日，"
  },
  {
    "start": 11.959999999999999,
    "end": 14.529999999999998,
    "text": "玛丽·赛勒斯特号从纽约出发，"
  },
  {
    "start": 15.059999999999999,
    "end": 16.909999999999997,
    "text": "前往意大利热那亚。"
  },
  {
    "start": 17.45,
    "end": 19.679999999999996,
    "text": "船长布里格斯经验丰富，"
  },
  {
    "start": 20.22,
    "end": 21.879999999999995,
    "text": "船上载着他的妻子、"
  },
  {
    "start": 22.419999999999995,
    "end": 23.719999999999995,
    "text": "两岁的女儿，"
  },
  {
    "start": 24.249999999999996,
    "end": 25.879999999999995,
    "text": "还有七名船员，"
  },
  {
    "start": 26.419999999999995,
    "end": 29.449999999999996,
    "text": "货物是一千七百多桶工业酒精。"
  },
  {
    "start": 30.35,
    "end": 31.310000000000002,
    "text": "一个月后，"
  },
  {
    "start": 32.07,
    "end": 33.11,
    "text": "十二月四日，"
  },
  {
    "start": 33.86,
    "end": 35.9,
    "text": "在亚速尔群岛附近，"
  },
  {
    "start": 36.66,
    "end": 39.92,
    "text": "另一艘船「上帝的恩典号」发现了它。"
  },
  {
    "start": 40.68,
    "end": 42.32,
    "text": "它的帆破破烂烂，"
  },
  {
    "start": 43.07,
    "end": 44.28,
    "text": "航向混乱，"
  },
  {
    "start": 45.04,
    "end": 45.769999999999996,
    "text": "喊了半天，"
  },
  {
    "start": 46.53,
    "end": 48.019999999999996,
    "text": "没有人回应。"
  },
  {
    "start": 48.769999999999996,
    "end": 50.58,
    "text": "水手们划着小艇靠近，"
  },
  {
    "start": 51.34,
    "end": 52.489999999999995,
    "text": "爬上甲板，"
  },
  {
    "start": 53.25,
    "end": 54.449999999999996,
    "text": "一个人都没有。"
  },
  {
    "start": 55.35,
    "end": 56.89,
    "text": "船体几乎完好，"
  },
  {
    "start": 58.47,
    "end": 60.870000000000005,
    "text": "食物和淡水够吃半年，"
  },
  {
    "start": 62.46,
    "end": 64.83428571428571,
    "text": "船员的行李和私人物品都在。"
  },
  {
    "start": 64.83428571428571,
    "end": 65.29,
    "text": "可是，"
  },
  {
    "start": 66.87,
    "end": 68.75,
    "text": "救生艇不见了，"
  },
  {
    "start": 70.34,
    "end": 71.62,
    "text": "航海仪器不见了，"
  },
  {
    "start": 73.2,
    "end": 75.67,
    "text": "最后一篇日志停在十天前。"
  },
  {
    "start": 77.26,
    "end": 79.33,
    "text": "没有明确的打斗痕迹，"
  },
  {
    "start": 80.91,
    "end": 82.61,
    "text": "没有求救信号。"
  },
  {
    "start": 84.2,
    "end": 86.25,
    "text": "他们是自己离开的，"
  },
  {
    "start": 87.83,
    "end": 89.45,
    "text": "还是被什么带走的？"
  },
  {
    "start": 90.35,
    "end": 91.64,
    "text": "有人说是海盗，"
  },
  {
    "start": 93.91,
    "end": 96.44999999999999,
    "text": "可是值钱的货物一件没少。"
  },
  {
    "start": 98.71,
    "end": 100.69999999999999,
    "text": "有人说是船员叛变，"
  },
  {
    "start": 102.97,
    "end": 105.03999999999999,
    "text": "可是船长威望很高，"
  },
  {
    "start": 107.29999999999998,
    "end": 109.44999999999999,
    "text": "现场也没有争斗痕迹。"
  },
  {
    "start": 110.35,
    "end": 112.0,
    "text": "有人说是巨型乌贼，"
  },
  {
    "start": 115.33999999999999,
    "end": 118.08,
    "text": "有人说是海上龙卷风和海底地震。"
  },
  {
    "start": 121.41,
    "end": 123.1275,
    "text": "听起来很刺激，"
  },
  {
    "start": 123.1275,
    "end": 123.75999999999999,
    "text": "可是，"
  },
  {
    "start": 127.1,
    "end": 128.5,
    "text": "船本身几乎完好，"
  },
  {
    "start": 131.82999999999998,
    "end": 134.45,
    "text": "不像遭遇过毁灭性的灾难。"
  },
  {
    "start": 135.35,
    "end": 135.98,
    "text": "近年来，"
  },
  {
    "start": 136.73999999999998,
    "end": 138.32999999999998,
    "text": "科学家做了实验："
  },
  {
    "start": 139.09,
    "end": 143.07,
    "text": "酒精蒸汽可以发生一次几乎没有火光的爆燃，"
  },
  {
    "start": 143.82,
    "end": 145.31,
    "text": "冲开舱盖，"
  },
  {
    "start": 146.07,
    "end": 147.67999999999998,
    "text": "却不留下多少痕迹。"
  },
  {
    "start": 148.44,
    "end": 151.42999999999998,
    "text": "船长害怕大船随时再次爆炸，"
  },
  {
    "start": 152.19,
    "end": 155.04,
    "text": "命令所有人立刻登上救生艇，"
  },
  {
    "start": 155.79999999999998,
    "end": 159.1,
    "text": "并用一根长绳把小艇拴在大船后面。"
  },
  {
    "start": 159.1,
    "end": 159.6,
    "text": "可是，"
  },
  {
    "start": 160.35,
    "end": 161.7,
    "text": "一阵风浪袭来，"
  },
  {
    "start": 162.45999999999998,
    "end": 163.45,
    "text": "绳子断了。"
  },
  {
    "start": 164.35,
    "end": 167.1,
    "text": "大船带着满帆继续前行，"
  },
  {
    "start": 167.38,
    "end": 167.96,
    "text": "而救生艇，"
  },
  {
    "start": 168.23999999999998,
    "end": 169.09,
    "text": "再也没人见到。"
  },
  {
    "start": 169.37,
    "end": 171.32,
    "text": "这个解释最合理，"
  },
  {
    "start": 171.6,
    "end": 173.45,
    "text": "但没有人能证明。"
  },
  {
    "start": 173.73,
    "end": 174.64,
    "text": "你觉得，"
  },
  {
    "start": 174.92,
    "end": 176.45,
    "text": "他们到底遇到了什么？"
  }
]