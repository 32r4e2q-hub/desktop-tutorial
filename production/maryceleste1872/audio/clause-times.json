{
 "N01": {
  "duration": 9.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 1.18,
    "text": "一八七二年",
    "gap_before": 0.02,
    "chars_per_second": 4.31
   },
   {
    "i": 1,
    "start": 1.49,
    "end": 3.38,
    "text": "大西洋上漂着一艘船",
    "gap_before": 0.31,
    "chars_per_second": 4.76
   },
   {
    "i": 2,
    "start": 3.68,
    "end": 6.28,
    "text": "船上的东西几乎原封不动",
    "gap_before": 0.3,
    "chars_per_second": 4.23
   },
   {
    "i": 3,
    "start": 6.59,
    "end": 7.67,
    "text": "可是十个人",
    "gap_before": 0.31,
    "chars_per_second": 4.63
   },
   {
    "i": 4,
    "start": 7.98,
    "end": 9.1,
    "text": "全都消失了",
    "gap_before": 0.31,
    "chars_per_second": 4.45
   }
  ]
 },
 "N02": {
  "duration": 19.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.16,
    "text": "十一月七日",
    "gap_before": 0.01,
    "chars_per_second": 4.35
   },
   {
    "i": 1,
    "start": 1.69,
    "end": 4.26,
    "text": "玛丽·赛勒斯特号从纽约出发",
    "gap_before": 0.53,
    "chars_per_second": 4.67
   },
   {
    "i": 2,
    "start": 4.78,
    "end": 6.67,
    "text": "前往意大利热那亚",
    "gap_before": 0.52,
    "chars_per_second": 4.23
   },
   {
    "i": 3,
    "start": 7.2,
    "end": 9.67,
    "text": "船长布里格斯经验丰富",
    "gap_before": 0.53,
    "chars_per_second": 4.05
   },
   {
    "i": 4,
    "start": 10.2,
    "end": 12.01,
    "text": "船上载着他的妻子",
    "gap_before": 0.53,
    "chars_per_second": 4.42
   },
   {
    "i": 5,
    "start": 12.53,
    "end": 13.54,
    "text": "两岁的女儿",
    "gap_before": 0.52,
    "chars_per_second": 4.95
   },
   {
    "i": 6,
    "start": 14.07,
    "end": 15.58,
    "text": "还有七名船员",
    "gap_before": 0.53,
    "chars_per_second": 3.97
   },
   {
    "i": 7,
    "start": 16.11,
    "end": 19.1,
    "text": "货物是一千七百多桶工业酒精",
    "gap_before": 0.53,
    "chars_per_second": 4.34
   }
  ]
 },
 "N03": {
  "duration": 24.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 0.93,
    "text": "一个月后",
    "gap_before": 0.01,
    "chars_per_second": 4.35
   },
   {
    "i": 1,
    "start": 1.72,
    "end": 2.53,
    "text": "十二月四日",
    "gap_before": 0.79,
    "chars_per_second": 6.17
   },
   {
    "i": 2,
    "start": 3.33,
    "end": 5.16,
    "text": "在亚速尔群岛附近",
    "gap_before": 0.8,
    "chars_per_second": 4.37
   },
   {
    "i": 3,
    "start": 5.95,
    "end": 9.55,
    "text": "另一艘船「上帝的恩典号」发现了它",
    "gap_before": 0.79,
    "chars_per_second": 3.89
   },
   {
    "i": 4,
    "start": 10.34,
    "end": 12.34,
    "text": "它的帆破破烂烂",
    "gap_before": 0.79,
    "chars_per_second": 3.5
   },
   {
    "i": 5,
    "start": 13.13,
    "end": 14.0,
    "text": "航向混乱",
    "gap_before": 0.79,
    "chars_per_second": 4.6
   },
   {
    "i": 6,
    "start": 14.8,
    "end": 15.39,
    "text": "喊了半天",
    "gap_before": 0.8,
    "chars_per_second": 6.78
   },
   {
    "i": 7,
    "start": 16.18,
