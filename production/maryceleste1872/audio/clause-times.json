    "text": "船长害怕大船随时再次爆炸",
    "gap_before": 0.75,
    "chars_per_second": 4.14
   },
   {
    "i": 6,
    "start": 16.85,
    "end": 19.17,
    "text": "命令所有人立刻登上救生艇",
    "gap_before": 0.75,
    "chars_per_second": 5.17
   },
