    "gap_before": 0.79,
    "chars_per_second": 7.25
   },
   {
    "i": 8,
    "start": 17.66,
    "end": 19.78,
    "text": "水手们划着小艇靠近",
    "gap_before": 0.79,
    "chars_per_second": 4.25
   },
   {
    "i": 9,
    "start": 20.58,
    "end": 21.72,
    "text": "爬上甲板",
    "gap_before": 0.8,
    "chars_per_second": 3.51
   },
   {
    "i": 10,
    "start": 22.51,
    "end": 24.1,
    "text": "一个人都没有",
    "gap_before": 0.79,
    "chars_per_second": 3.77
   }
  ]
 },
 "N04": {
  "duration": 34.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.49,
    "text": "船体几乎完好",
    "gap_before": 0.01,
    "chars_per_second": 4.05
   },
   {
    "i": 1,
    "start": 3.14,
    "end": 5.5,
    "text": "食物和淡水够吃半年",
    "gap_before": 1.65,
    "chars_per_second": 3.81
   },
   {
    "i": 2,
    "start": 7.14,
    "end": 10.02,
    "text": "船员的行李和私人物品都在，可是",
    "gap_before": 1.64,
    "chars_per_second": 4.86
   },
   {
    "i": 3,
    "start": 11.67,
    "end": 12.98,
    "text": "救生艇不见了",
