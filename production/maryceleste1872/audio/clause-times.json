{
  "N01": {
    "duration": 7.505,
    "clauses": [
      {
        "i": 0,
        "start": 0.02,
        "end": 0.93,
        "text": "一八七二年",
        "chars_per_second": 5.51,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 0.93,
        "end": 2.62,
        "text": "大西洋上漂着一艘船",
        "chars_per_second": 5.32,
        "gap_before": 0.0
      },
      {
        "i": 2,
        "start": 3.19,
        "end": 4.19,
        "text": "灯火未熄",
        "chars_per_second": 4.0,
        "gap_before": 0.57
      },
      {
        "i": 3,
        "start": 4.48,
        "end": 5.39,
        "text": "早餐未凉",
        "chars_per_second": 4.4,
        "gap_before": 0.29
      },
      {
        "i": 4,
        "start": 5.65,
        "end": 6.53,
        "text": "可是十个人",
        "chars_per_second": 5.68,
        "gap_before": 0.26
      },
      {
        "i": 5,
        "start": 6.53,
        "end": 7.41,
        "text": "全都消失了",
        "chars_per_second": 5.68,
        "gap_before": 0.0
      }
    ]
  },
  "N02": {
    "duration": 16.49,
    "clauses": [
      {
        "i": 0,
        "start": 0.01,
        "end": 0.99,
        "text": "十一月七日",
        "chars_per_second": 5.1,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 1.21,
        "end": 2.21,
        "text": "纽约天刚亮",
        "chars_per_second": 5.0,
        "gap_before": 0.22
      },
      {
        "i": 2,
        "start": 2.77,
        "end": 4.48,
        "text": "玛丽·赛勒斯特号启航",
        "chars_per_second": 5.26,
        "gap_before": 0.56
      },
      {
        "i": 3,
        "start": 4.74,
        "end": 6.12,
        "text": "驶向意大利热那亚",
        "chars_per_second": 5.8,
        "gap_before": 0.26
      },
      {
        "i": 4,
        "start": 6.69,
        "end": 7.71,
        "text": "船长布里格斯",
        "chars_per_second": 5.88,
        "gap_before": 0.57
      },
      {
        "i": 5,
        "start": 8.02,
        "end": 9.58,
        "text": "带上妻子和两岁的女儿",
        "chars_per_second": 6.41,
        "gap_before": 0.31
      },
      {
        "i": 6,
        "start": 10.2,
        "end": 11.69,
        "text": "七名船员各就各位",
        "chars_per_second": 5.38,
        "gap_before": 0.62
      },
      {
        "i": 7,
        "start": 11.69,
        "end": 12.45,
        "text": "帆索绷紧",
        "chars_per_second": 5.24,
        "gap_before": 0.0
      },
      {
        "i": 8,
        "start": 13.06,
        "end": 13.58,
        "text": "货舱里",
        "chars_per_second": 5.77,
        "gap_before": 0.61
      },
      {
        "i": 9,
        "start": 13.82,
        "end": 16.4,
        "text": "一千七百多桶工业酒精静静堆着",
        "chars_per_second": 5.43,
        "gap_before": 0.24
      }
    ]
  },
  "N03": {
    "duration": 19.35,
    "clauses": [
      {
        "i": 0,
        "start": 0.01,
        "end": 0.7,
        "text": "一个月后",
        "chars_per_second": 5.8,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 0.7,
        "end": 1.56,
        "text": "十二月四日",
        "chars_per_second": 5.8,
        "gap_before": 0.0
      },
      {
        "i": 2,
        "start": 1.56,
        "end": 2.77,
        "text": "亚速尔群岛附近",
        "chars_per_second": 5.8,
        "gap_before": 0.0
      },
      {
        "i": 3,
        "start": 3.64,
        "end": 6.84,
        "text": "另一艘船「上帝的恩典号」发现了它",
        "chars_per_second": 4.37,
        "gap_before": 0.87
      },
      {
        "i": 4,
        "start": 6.84,
        "end": 8.57,
        "text": "可它的帆破破烂烂",
        "chars_per_second": 4.64,
        "gap_before": 0.0
      },
      {
        "i": 5,
        "start": 8.57,
        "end": 9.86,
        "text": "航向歪歪扭扭",
        "chars_per_second": 4.64,
        "gap_before": 0.0
      },
      {
        "i": 6,
        "start": 10.1,
        "end": 11.15,
        "text": "像喝醉了酒",
        "chars_per_second": 4.75,
        "gap_before": 0.24
      },
      {
        "i": 7,
        "start": 11.15,
        "end": 13.36,
        "text": "摩尔豪斯船长连喊几声",
        "chars_per_second": 4.53,
        "gap_before": 0.0
      },
      {
        "i": 8,
        "start": 13.62,
        "end": 14.3,
        "text": "海上一片死寂",
        "chars_per_second": 8.78,
        "gap_before": 0.26
      },
      {
        "i": 9,
        "start": 14.3,
        "end": 15.1,
        "text": "水手们放下小艇",
        "chars_per_second": 8.78,
        "gap_before": 0.0
      },
      {
        "i": 10,
        "start": 15.39,
        "end": 16.81,
        "text": "贴着船舷爬上去",
        "chars_per_second": 4.93,
        "gap_before": 0.29
      },
      {
        "i": 11,
        "start": 17.4,
        "end": 18.15,
        "text": "甲板上",
        "chars_per_second": 4.0,
        "gap_before": 0.59
      },
      {
        "i": 12,
        "start": 18.39,
        "end": 19.25,
        "text": "一个人都没有",
        "chars_per_second": 6.98,
        "gap_before": 0.24
      }
    ]
  },
  "N04": {
    "duration": 28.238,
    "clauses": [
      {
        "i": 0,
        "start": 0.01,
        "end": 1.27,
        "text": "船体几乎完好",
        "chars_per_second": 4.76,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 1.51,
        "end": 3.47,
        "text": "食物和淡水够吃半年",
        "chars_per_second": 4.59,
        "gap_before": 0.24
      },
      {
        "i": 2,
        "start": 4.03,
        "end": 5.28,
        "text": "船员的行李都在",
        "chars_per_second": 5.6,
        "gap_before": 0.56
      },
      {
        "i": 3,
        "start": 5.52,
        "end": 7.63,
        "text": "小女孩的红外套和布偶兔子",
        "chars_per_second": 5.69,
        "gap_before": 0.24
      },
      {
        "i": 4,
        "start": 7.88,
        "end": 9.07,
        "text": "还留在小床上",
        "chars_per_second": 5.04,
        "gap_before": 0.25
      },
      {
        "i": 5,
        "start": 9.62,
        "end": 10.91,
        "text": "可是救生艇不见了",
        "chars_per_second": 6.2,
        "gap_before": 0.55
      },
      {
        "i": 6,
        "start": 11.15,
        "end": 12.45,
        "text": "航海仪器也不见了",
        "chars_per_second": 6.15,
        "gap_before": 0.24
      },
      {
        "i": 7,
        "start": 12.68,
        "end": 16.94,
        "text": "只留下拆开的抽水泵和敞开的工具箱",
        "chars_per_second": 3.76,
        "gap_before": 0.23
      },
      {
        "i": 8,
        "start": 17.53,
        "end": 18.65,
        "text": "最后一篇日志",
        "chars_per_second": 5.36,
        "gap_before": 0.59
      },
      {
        "i": 9,
        "start": 18.09,
        "end": 19.01,
        "text": "停在十天前",
        "chars_per_second": 5.43,
        "gap_before": 0.0
      },
      {
        "i": 10,
        "start": 19.19,
        "end": 20.38,
        "text": "笔迹平平稳稳",
        "chars_per_second": 5.04,
        "gap_before": 0.18
      },
      {
        "i": 11,
        "start": 20.63,
        "end": 21.49,
        "text": "断在半页",
        "chars_per_second": 4.65,
        "gap_before": 0.25
      },
      {
        "i": 12,
        "start": 22.11,
        "end": 23.25,
        "text": "没有打斗痕迹",
        "chars_per_second": 5.26,
        "gap_before": 0.62
      },
      {
        "i": 13,
        "start": 23.52,
        "end": 24.84,
        "text": "没有求救信号",
        "chars_per_second": 4.55,
        "gap_before": 0.27
      },
      {
        "i": 14,
        "start": 25.4,
        "end": 26.72,
        "text": "他们是自己离开的",
        "chars_per_second": 6.06,
        "gap_before": 0.56
      },
      {
        "i": 15,
        "start": 26.97,
        "end": 28.14,
        "text": "还是被什么带走的",
        "chars_per_second": 6.84,
        "gap_before": 0.25
      }
    ]
  },
  "N05": {
    "duration": 17.582,
    "clauses": [
      {
        "i": 0,
        "start": 0.02,
        "end": 1.35,
        "text": "有人说是海盗干的",
        "chars_per_second": 6.02,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 1.92,
        "end": 2.81,
        "text": "黑旗升起",
        "chars_per_second": 4.49,
        "gap_before": 0.57
      },
      {
        "i": 2,
        "start": 3.04,
        "end": 4.13,
        "text": "刀光映着火把",
        "chars_per_second": 5.5,
        "gap_before": 0.23
      },
      {
        "i": 3,
        "start": 4.75,
        "end": 5.86,
        "text": "可值钱的货物",
        "chars_per_second": 5.41,
        "gap_before": 0.62
      },
      {
        "i": 4,
        "start": 6.15,
        "end": 6.9,
        "text": "一件没少",
        "chars_per_second": 5.33,
        "gap_before": 0.29
      },
      {
        "i": 5,
        "start": 7.5,
        "end": 9.15,
        "text": "有人说是船员叛变",
        "chars_per_second": 4.85,
        "gap_before": 0.6
      },
      {
        "i": 6,
        "start": 9.71,
        "end": 11.21,
        "text": "可船长威望极高",
        "chars_per_second": 4.67,
        "gap_before": 0.56
      },
      {
        "i": 7,
        "start": 11.45,
        "end": 12.64,
        "text": "水手们都服他",
        "chars_per_second": 5.04,
        "gap_before": 0.24
      },
      {
        "i": 8,
        "start": 12.88,
        "end": 14.85,
        "text": "现场也没有半点争斗的痕迹",
        "chars_per_second": 6.09,
        "gap_before": 0.24
      },
      {
        "i": 9,
        "start": 15.43,
        "end": 16.24,
        "text": "两个猜想",
        "chars_per_second": 4.94,
        "gap_before": 0.58
      },
      {
        "i": 10,
        "start": 16.48,
        "end": 17.49,
        "text": "两处说不通",
        "chars_per_second": 4.95,
        "gap_before": 0.24
      }
    ]
  },
  "N06": {
    "duration": 19.282,
    "clauses": [
      {
        "i": 0,
        "start": 0.01,
        "end": 1.41,
        "text": "有人说是巨型乌贼",
        "chars_per_second": 5.71,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 1.79,
        "end": 3.19,
        "text": "从深海伸出触手",
        "chars_per_second": 5.0,
        "gap_before": 0.38
      },
      {
        "i": 2,
        "start": 3.19,
        "end": 4.44,
        "text": "把船拖进地狱",
        "chars_per_second": 4.8,
        "gap_before": 0.0
      },
      {
        "i": 3,
        "start": 5.14,
        "end": 6.83,
        "text": "有人说是海上龙卷风",
        "chars_per_second": 5.33,
        "gap_before": 0.71
      },
      {
        "i": 4,
        "start": 7.2,
        "end": 8.14,
        "text": "或者海底地震",
        "chars_per_second": 6.38,
        "gap_before": 0.37
      },
      {
        "i": 5,
        "start": 8.53,
        "end": 10.03,
        "text": "一夜之间掀翻了它",
        "chars_per_second": 5.33,
        "gap_before": 0.39
      },
      {
        "i": 6,
        "start": 10.79,
        "end": 12.56,
        "text": "听起来够刺激，可是",
        "chars_per_second": 4.52,
        "gap_before": 0.76
      },
      {
        "i": 7,
        "start": 12.56,
        "end": 13.96,
        "text": "船本身几乎完好",
        "chars_per_second": 5.0,
        "gap_before": 0.0
      },
      {
        "i": 8,
        "start": 14.34,
        "end": 15.2,
        "text": "桅杆还在",
        "chars_per_second": 4.65,
        "gap_before": 0.38
      },
      {
        "i": 9,
        "start": 15.62,
        "end": 16.56,
        "text": "船帆还在",
        "chars_per_second": 4.26,
        "gap_before": 0.43
      },
      {
        "i": 10,
        "start": 16.93,
        "end": 19.18,
        "text": "不像遭遇过任何毁灭性的灾难",
        "chars_per_second": 5.78,
        "gap_before": 0.37
      }
    ]
  },
  "N07": {
    "duration": 23.58,
    "clauses": [
      {
        "i": 0,
        "start": 0.02,
        "end": 0.57,
        "text": "近年来",
        "chars_per_second": 5.43,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 0.57,
        "end": 1.91,
        "text": "科学家做过实验",
        "chars_per_second": 5.23,
        "gap_before": 0.0
      },
      {
        "i": 2,
        "start": 2.47,
        "end": 3.39,
        "text": "密闭舱室里",
        "chars_per_second": 5.43,
        "gap_before": 0.56
      },
      {
        "i": 3,
        "start": 3.61,
        "end": 7.11,
        "text": "酒精蒸汽能引发一次几乎没有火光的爆燃",
        "chars_per_second": 5.14,
        "gap_before": 0.22
      },
      {
        "i": 4,
        "start": 7.41,
        "end": 8.3,
        "text": "冲开舱盖",
        "chars_per_second": 4.49,
        "gap_before": 0.3
      },
      {
        "i": 5,
        "start": 8.54,
        "end": 9.89,
        "text": "却不留下多少痕迹",
        "chars_per_second": 5.93,
        "gap_before": 0.24
      },
      {
        "i": 6,
        "start": 10.55,
        "end": 12.09,
        "text": "这或许能解释一切",
        "chars_per_second": 5.19,
        "gap_before": 0.66
      },
      {
        "i": 7,
        "start": 12.32,
        "end": 14.79,
        "text": "船长以为大船随时会再炸",
        "chars_per_second": 4.45,
        "gap_before": 0.23
      },
      {
        "i": 8,
        "start": 15.06,
        "end": 17.42,
        "text": "命令所有人立刻登上救生艇",
        "chars_per_second": 5.08,
        "gap_before": 0.27
      },
      {
        "i": 9,
        "start": 17.68,
        "end": 18.91,
        "text": "再用一根长绳",
        "chars_per_second": 4.88,
        "gap_before": 0.26
      },
      {
        "i": 10,
        "start": 19.13,
        "end": 20.93,
        "text": "把小艇拴在大船后面，可是",
        "chars_per_second": 6.11,
        "gap_before": 0.22
      },
      {
        "i": 11,
        "start": 21.23,
        "end": 22.56,
        "text": "一阵风浪袭来",
        "chars_per_second": 4.5,
        "gap_before": 0.3
      },
      {
        "i": 12,
        "start": 22.56,
        "end": 23.45,
        "text": "绳子断了",
        "chars_per_second": 4.5,
        "gap_before": 0.0
      }
    ]
  },
  "N08": {
    "duration": 10.325,
    "clauses": [
      {
        "i": 0,
        "start": 0.08,
        "end": 1.89,
        "text": "大船张满帆继续前行",
        "chars_per_second": 4.97,
        "gap_before": 0.0
      },
      {
        "i": 1,
        "start": 2.14,
        "end": 3.03,
        "text": "而救生艇",
        "chars_per_second": 4.49,
        "gap_before": 0.25
      },
      {
        "i": 2,
        "start": 3.25,
        "end": 4.44,
        "text": "再也没人见到",
        "chars_per_second": 5.04,
        "gap_before": 0.22
      },
      {
        "i": 3,
        "start": 5.21,
        "end": 6.28,
        "text": "这解释最合理",
        "chars_per_second": 5.61,
        "gap_before": 0.77
      },
      {
        "i": 4,
        "start": 6.57,
        "end": 7.68,
        "text": "却没有人能证明",
        "chars_per_second": 6.31,
        "gap_before": 0.29
      },
      {
        "i": 5,
        "start": 8.24,
        "end": 8.74,
        "text": "你觉得",
        "chars_per_second": 6.0,
        "gap_before": 0.56
      },
      {
        "i": 6,
        "start": 8.74,
        "end": 10.24,
        "text": "他们到底遇到了什么",
        "chars_per_second": 6.0,
        "gap_before": 0.0
      }
    ]
  }
}