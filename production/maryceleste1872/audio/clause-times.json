{
 "N01": {
  "duration": 9.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.13,
    "text": "一八七二年",
    "gap_before": 0.01,
    "chars_per_second": 4.46
   },
   {
    "i": 1,
    "start": 1.39,
    "end": 3.47,
    "text": "大西洋上漂着一艘船",
    "gap_before": 0.26,
    "chars_per_second": 4.33
   },
   {
    "i": 2,
    "start": 3.73,
    "end": 5.97,
    "text": "船上的东西几乎原封不动",
    "gap_before": 0.26,
    "chars_per_second": 4.91
   },
   {
    "i": 3,
    "start": 6.23,
    "end": 7.32,
    "text": "可是十个人",
    "gap_before": 0.26,
    "chars_per_second": 4.59
   },
   {
    "i": 4,
    "start": 7.58,
    "end": 9.1,
    "text": "全都消失了",
    "gap_before": 0.26,
    "chars_per_second": 3.29
   }
  ]
 },
 "N02": {
  "duration": 19.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 1.03,
    "text": "十一月七日",
    "gap_before": 0.02,
    "chars_per_second": 4.95
   },
   {
    "i": 1,
    "start": 1.63,
    "end": 4.14,
    "text": "玛丽·赛勒斯特号从纽约出发",
    "gap_before": 0.6,
    "chars_per_second": 4.78
   },
   {
    "i": 2,
    "start": 4.73,
    "end": 6.52,
    "text": "前往意大利热那亚",
    "gap_before": 0.59,
    "chars_per_second": 4.47
   },
   {
    "i": 3,
    "start": 7.12,
    "end": 9.29,
    "text": "船长布里格斯经验丰富",
    "gap_before": 0.6,
    "chars_per_second": 4.61
   },
   {
    "i": 4,
    "start": 9.89,
    "end": 11.49,
    "text": "船上载着他的妻子",
    "gap_before": 0.6,
    "chars_per_second": 5.0
   },
   {
    "i": 5,
    "start": 12.09,
    "end": 13.33,
    "text": "两岁的女儿",
    "gap_before": 0.6,
    "chars_per_second": 4.03
   },
   {
    "i": 6,
    "start": 13.92,
    "end": 15.49,
    "text": "还有七名船员",
    "gap_before": 0.59,
    "chars_per_second": 3.82
   },
   {
    "i": 7,
    "start": 16.09,
    "end": 19.1,
    "text": "货物是一千七百多桶工业酒精",
    "gap_before": 0.6,
    "chars_per_second": 4.32
   }
  ]
 },
 "N03": {
  "duration": 24.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 0.92,
    "text": "一个月后",
    "gap_before": 0.01,
    "chars_per_second": 4.4
   },
   {
    "i": 1,
    "start": 1.74,
    "end": 2.72,
    "text": "十二月四日",
    "gap_before": 0.82,
    "chars_per_second": 5.1
   },
   {
    "i": 2,
    "start": 3.53,
    "end": 5.51,
    "text": "在亚速尔群岛附近",
    "gap_before": 0.81,
    "chars_per_second": 4.04
   },
   {
    "i": 3,
    "start": 6.33,
    "end": 9.53,
    "text": "另一艘船「上帝的恩典号」发现了它",
    "gap_before": 0.82,
    "chars_per_second": 4.38
   },
   {
    "i": 4,
    "start": 10.35,
    "end": 11.93,
    "text": "它的帆破破烂烂",
    "gap_before": 0.82,
    "chars_per_second": 4.43
   },
   {
    "i": 5,
    "start": 12.74,
    "end": 13.89,
    "text": "航向混乱",
    "gap_before": 0.81,
    "chars_per_second": 3.48
   },
   {
    "i": 6,
    "start": 14.71,
    "end": 15.38,
    "text": "喊了半天",
    "gap_before": 0.82,
    "chars_per_second": 5.97
   },
   {
    "i": 7,
    "start": 16.2,
    "end": 17.63,
    "text": "没有人回应",
    "gap_before": 0.82,
    "chars_per_second": 3.5
   },
   {
    "i": 8,
    "start": 18.44,
    "end": 20.19,
    "text": "水手们划着小艇靠近",
    "gap_before": 0.81,
    "chars_per_second": 5.14
   },
   {
    "i": 9,
    "start": 21.01,
    "end": 22.1,
    "text": "爬上甲板",
    "gap_before": 0.82,
    "chars_per_second": 3.67
   },
   {
    "i": 10,
    "start": 22.92,
    "end": 24.11,
    "text": "一个人都没有",
    "gap_before": 0.82,
    "chars_per_second": 5.06
   }
  ]
 },
 "N04": {
  "duration": 34.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.5,
    "text": "船体几乎完好",
    "gap_before": 0.01,
    "chars_per_second": 4.03
   },
   {
    "i": 1,
    "start": 3.14,
    "end": 5.48,
    "text": "食物和淡水够吃半年",
    "gap_before": 1.64,
    "chars_per_second": 3.85
   },
   {
    "i": 2,
    "start": 7.13,
    "end": 9.9,
    "text": "船员的行李和私人物品都在，可是",
    "gap_before": 1.65,
    "chars_per_second": 5.05
   },
   {
    "i": 3,
    "start": 11.54,
    "end": 13.36,
    "text": "救生艇不见了",
    "gap_before": 1.64,
    "chars_per_second": 3.3
   },
   {
    "i": 4,
    "start": 15.01,
    "end": 16.23,
    "text": "航海仪器不见了",
    "gap_before": 1.65,
    "chars_per_second": 5.74
   },
   {
    "i": 5,
    "start": 17.87,
    "end": 20.28,
    "text": "最后一篇日志停在十天前",
    "gap_before": 1.64,
    "chars_per_second": 4.56
   },
   {
    "i": 6,
    "start": 21.93,
    "end": 23.94,
    "text": "没有明确的打斗痕迹",
    "gap_before": 1.65,
    "chars_per_second": 4.48
   },
   {
    "i": 7,
    "start": 25.58,
    "end": 27.22,
    "text": "没有求救信号",
    "gap_before": 1.64,
    "chars_per_second": 3.66
   },
   {
    "i": 8,
    "start": 28.87,
    "end": 30.86,
    "text": "他们是自己离开的",
    "gap_before": 1.65,
    "chars_per_second": 4.02
   },
   {
    "i": 9,
    "start": 32.5,
    "end": 34.1,
    "text": "还是被什么带走的",
    "gap_before": 1.64,
    "chars_per_second": 5.01
   }
  ]
 },
 "N05": {
  "duration": 19.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.25,
    "text": "有人说是海盗",
    "gap_before": 0.01,
    "chars_per_second": 4.84
   },
   {
    "i": 1,
    "start": 3.58,
    "end": 6.06,
    "text": "可是值钱的货物一件没少",
    "gap_before": 2.33,
    "chars_per_second": 4.44
   },
   {
    "i": 2,
    "start": 8.38,
    "end": 10.31,
    "text": "有人说是船员叛变",
    "gap_before": 2.32,
    "chars_per_second": 4.15
   },
   {
    "i": 3,
    "start": 12.64,
    "end": 14.65,
    "text": "可是船长威望很高",
    "gap_before": 2.33,
    "chars_per_second": 3.98
   },
   {
    "i": 4,
    "start": 16.97,
    "end": 19.1,
    "text": "现场也没有争斗痕迹",
    "gap_before": 2.32,
    "chars_per_second": 4.23
   }
  ]
 },
 "N06": {
  "duration": 24.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 1.61,
    "text": "有人说是巨型乌贼",
    "gap_before": 0.02,
    "chars_per_second": 5.03
   },
   {
    "i": 1,
    "start": 5.01,
    "end": 7.69,
    "text": "有人说是海上龙卷风和海底地震",
    "gap_before": 3.4,
    "chars_per_second": 5.22
   },
   {
    "i": 2,
    "start": 11.08,
    "end": 13.37,
    "text": "听起来很刺激，可是",
    "gap_before": 3.39,
    "chars_per_second": 3.49
   },
   {
    "i": 3,
    "start": 16.77,
    "end": 18.11,
    "text": "船本身几乎完好",
    "gap_before": 3.4,
    "chars_per_second": 5.22
   },
   {
    "i": 4,
    "start": 21.5,
    "end": 24.1,
    "text": "不像遭遇过毁灭性的灾难",
    "gap_before": 3.39,
    "chars_per_second": 4.24
   }
  ]
 },
 "N07": {
  "duration": 28.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 0.59,
    "text": "近年来",
    "gap_before": 0.01,
    "chars_per_second": 5.17
   },
   {
    "i": 1,
    "start": 1.41,
    "end": 2.94,
    "text": "科学家做了实验",
    "gap_before": 0.82,
    "chars_per_second": 4.58
   },
   {
    "i": 2,
    "start": 3.76,
    "end": 7.68,
    "text": "酒精蒸汽可以发生一次几乎没有火光的爆燃",
    "gap_before": 0.82,
    "chars_per_second": 4.85
   },
   {
    "i": 3,
    "start": 8.49,
    "end": 9.92,
    "text": "冲开舱盖",
    "gap_before": 0.81,
    "chars_per_second": 2.8
   },
   {
    "i": 4,
    "start": 10.74,
    "end": 12.29,
    "text": "却不留下多少痕迹",
    "gap_before": 0.82,
    "chars_per_second": 5.16
   },
   {
    "i": 5,
    "start": 13.11,
    "end": 16.04,
    "text": "船长害怕大船随时再次爆炸",
    "gap_before": 0.82,
    "chars_per_second": 4.1
   },
   {
    "i": 6,
    "start": 16.86,
    "end": 19.65,
    "text": "命令所有人立刻登上救生艇",
    "gap_before": 0.82,
    "chars_per_second": 4.3
   },
   {
    "i": 7,
    "start": 20.47,
    "end": 24.21,
    "text": "并用一根长绳把小艇拴在大船后面，可是",
    "gap_before": 0.82,
    "chars_per_second": 4.55
   },
   {
    "i": 8,
    "start": 25.02,
    "end": 26.31,
    "text": "一阵风浪袭来",
    "gap_before": 0.81,
    "chars_per_second": 4.65
   },
   {
    "i": 9,
    "start": 27.13,
    "end": 28.1,
    "text": "绳子断了",
    "gap_before": 0.82,
    "chars_per_second": 4.13
   }
  ]
 },
 "N08": {
  "duration": 12.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 2.71,
    "text": "大船带着满帆继续前行",
    "gap_before": 0.01,
    "chars_per_second": 3.7
   },
   {
    "i": 1,
    "start": 3.05,
    "end": 3.57,
    "text": "而救生艇",
    "gap_before": 0.34,
    "chars_per_second": 7.69
   },
   {
    "i": 2,
    "start": 3.91,
    "end": 4.7,
    "text": "再也没人见到",
    "gap_before": 0.34,
    "chars_per_second": 7.59
   },
   {
    "i": 3,
    "start": 5.04,
    "end": 6.93,
    "text": "这个解释最合理",
    "gap_before": 0.34,
    "chars_per_second": 3.7
   },
   {
    "i": 4,
    "start": 7.27,
    "end": 9.06,
    "text": "但没有人能证明",
    "gap_before": 0.34,
    "chars_per_second": 3.91
   },
   {
    "i": 5,
    "start": 9.4,
    "end": 10.25,
    "text": "你觉得",
    "gap_before": 0.34,
    "chars_per_second": 3.53
   },
   {
    "i": 6,
    "start": 10.59,
    "end": 12.1,
    "text": "他们到底遇到了什么",
    "gap_before": 0.34,
    "chars_per_second": 5.95
   }
  ]
 }
}