    "chars_per_second": 4.76
   },
   {
    "i": 1,
    "start": 3.73,
    "end": 5.76,
    "text": "可是值钱的货物一件没少",
    "gap_before": 2.46,
    "chars_per_second": 5.42
   },
   {
    "i": 2,
    "start": 8.22,
    "end": 10.3,
    "text": "有人说是船员叛变",
    "gap_before": 2.46,
    "chars_per_second": 3.85
   },
   {
    "i": 3,
    "start": 12.75,
    "end": 14.6,
    "text": "可是船长威望很高",
    "gap_before": 2.45,
    "chars_per_second": 4.32
   },
   {
    "i": 4,
    "start": 17.06,
