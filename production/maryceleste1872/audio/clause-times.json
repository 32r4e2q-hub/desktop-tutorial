    "text": "现场也没有争斗痕迹",
    "gap_before": 2.46,
    "chars_per_second": 4.42
   }
  ]
 },
 "N06": {
  "duration": 24.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.81,
    "text": "有人说是巨型乌贼",
    "gap_before": 0.01,
    "chars_per_second": 4.44
   },
   {
    "i": 1,
    "start": 5.03,
    "end": 7.97,
    "text": "有人说是海上龙卷风和海底地震",
    "gap_before": 3.22,
    "chars_per_second": 4.76
   },
   {
    "i": 2,
    "start": 11.19,
    "end": 13.41,
    "text": "听起来很刺激，可是",
    "gap_before": 3.22,
    "chars_per_second": 3.6
   },
   {
    "i": 3,
    "start": 16.63,
    "end": 18.49,
    "text": "船本身几乎完好",
    "gap_before": 3.22,
    "chars_per_second": 3.76
   },
   {
    "i": 4,
    "start": 21.7,
    "end": 24.09,
    "text": "不像遭遇过毁灭性的灾难",
    "gap_before": 3.21,
    "chars_per_second": 4.59
   }
  ]
 },
 "N07": {
  "duration": 28.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 0.68,
