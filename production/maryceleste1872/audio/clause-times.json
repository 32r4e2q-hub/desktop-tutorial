    "chars_per_second": 4.58
   },
   {
    "i": 4,
    "start": 14.63,
    "end": 16.23,
    "text": "航海仪器不见了",
    "gap_before": 1.65,
    "chars_per_second": 4.37
   },
   {
    "i": 5,
    "start": 17.87,
    "end": 20.4,
    "text": "最后一篇日志停在十天前",
    "gap_before": 1.64,
    "chars_per_second": 4.35
   },
   {
    "i": 6,
    "start": 22.05,
    "end": 24.11,
    "text": "没有明确的打斗痕迹",
    "gap_before": 1.65,
    "chars_per_second": 4.37
   },
   {
    "i": 7,
    "start": 25.76,
    "end": 27.55,
    "text": "没有求救信号",
    "gap_before": 1.65,
    "chars_per_second": 3.35
   },
   {
    "i": 8,
    "start": 29.19,
    "end": 30.92,
    "text": "他们是自己离开的",
    "gap_before": 1.64,
    "chars_per_second": 4.62
   },
   {
    "i": 9,
    "start": 32.57,
    "end": 34.1,
    "text": "还是被什么带走的",
    "gap_before": 1.65,
    "chars_per_second": 5.23
   }
  ]
 },
 "N05": {
  "duration": 19.1,
  "clauses": [
   {
    "i": 0,
    "start": 0.01,
    "end": 1.27,
