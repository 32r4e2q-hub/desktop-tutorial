      "atempo": 1.0,
      "tail_silence_seconds": 1.632
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "法院后来认定：明知危险却没有施救，就是杀人。",
      "sha256": "6bdf59b5641ce7048cf85b77d182c81bf22b809919a574e2eed982e868a2ebb5",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
