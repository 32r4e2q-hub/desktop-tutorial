      "file": "S27.mp3",
      "text": "无期与三十年成为终审结论，附加二十年电子脚镣。",
      "sha256": "7e69a6cc985832d96458e60adc5d3789a4e98c93b38a5267cf6c0f8948e769a5",
      "voice_id": "voice-00",
