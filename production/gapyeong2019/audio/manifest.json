    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "二零一九年六月三十日，韩国加平一处知名溪谷。",
      "sha256": "b2d28e8ffb3b60ef05353038df76b76a6947817437dbb2befcc7055ab75d3505",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
