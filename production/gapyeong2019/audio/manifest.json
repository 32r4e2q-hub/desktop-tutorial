      "tail_silence_seconds": 2.232
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "二零二二年十月，一审认定不作为杀人。",
      "sha256": "830c76942c2f70424df97bbc94737504e5baa62eb88a87f6c43a40991c3127df",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
