      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.048,
      "atempo": 1.008,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "晚上八点，一名三十九岁男子在溪谷落水，此后再没回来。",
      "sha256": "6beda7681e16c6862fb3d2a2c682388c339fe14555eabbe30a2a09384cc313fd",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 6.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.928,
      "atempo": 1.0,
      "tail_silence_seconds": 0.072
    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "text": "妻子说没听见呼救，同行的朋友也这么说。",
      "sha256": "77a20be5bc09fd001cf858d7f2f86046859841549d1c4cc66255c06db0da3b07",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 12.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.848,
      "atempo": 1.0,
      "tail_silence_seconds": 1.152
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "警方现场勘查后，把它写成意外溺水。",
      "sha256": "d0f1fe16e7cd3a37a638b4a4a0633eff2c61d1be029f6e956eef4ec614819eff",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 18.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.704,
      "atempo": 1.0,
      "tail_silence_seconds": 1.296
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "保险公司的电话，却让这页结论再也翻不过去。",
      "sha256": "9587b5afb56da8302d3bd48b919bcb4b863fae187adf37c0e744d5719c530b7e",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 24.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.896,
      "atempo": 1.0,
      "tail_silence_seconds": 1.104
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "text": "死者身上有四份保单，死亡赔付合计约八亿韩元。",
      "sha256": "3086f5de408d3b5d75a200a322d95bda19bfd057ded3fe3ccc6901163e75e33b",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 30.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.024,
      "atempo": 1.004,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "text": "受益人，正是他的妻子李恩海。",
      "sha256": "1390f791246ad90aa46af330183dc4bbe5271a3e48c72560e1219629ab3fdbe5",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 36.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.464,
      "atempo": 1.0,
      "tail_silence_seconds": 1.536
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "text": "更巧的是，事发时离一份保单到期只剩几个小时。",
      "sha256": "f320f017a1cfe36bf20dd620e54fd491151bc63b3ce37eeeda954d9d251530c6",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 42.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.328,
      "atempo": 1.0,
      "tail_silence_seconds": 0.672
    },
    {
      "id": "S09",
      "file": "S09.mp3",
      "text": "她却上节目哭诉，指责保险公司拒赔。",
      "sha256": "c21bba1704804188e10b51906e8da03d8f2c8f5a32f0164e83aa213d169bd584",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 48.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.176,
      "atempo": 1.0,
      "tail_silence_seconds": 1.824
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "text": "拒赔的理由，是死亡时间太像被安排好的。",
      "sha256": "0fd5f0b3690c5f77fccfc25b319ccd9a44db591559140df7689b090464b9280a",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 54.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.944,
      "atempo": 1.0,
      "tail_silence_seconds": 1.056
    },
    {
      "id": "S11",
      "file": "S11.mp3",
      "text": "重新调查后，第一件事是翻出两年前的旧账。",
      "sha256": "4db61519a7efd48bd7d793b5030f331a7be5676c6f6afebeea8f40eb98a1c12b",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 60.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.848,
      "atempo": 1.0,
      "tail_silence_seconds": 1.152
    },
    {
      "id": "S12",
      "file": "S12.mp3",
      "text": "二零一九年二月，民宿里一顿掺了河豚毒的饭。",
      "sha256": "a9c76a5e1ad1de2c5de6c0ff77f212a93d1992a793cc69a72fb83f7240578ff9",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 66.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.328,
      "atempo": 1.0,
      "tail_silence_seconds": 0.672
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "她在聊天里问：放了这么多毒，他怎么还不死？",
      "sha256": "4f471b5142cba92c74ad850ca39fede9a3e200b58aac2d81764b313c0fef017d",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 72.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.136,
      "atempo": 1.0,
      "tail_silence_seconds": 0.864
    },
    {
      "id": "S14",
      "file": "S14.mp3",
      "text": "五月，钓鱼场边他又被推下水，被朋友拉了回来。",
      "sha256": "258f0375c9c34b636ac00a523a4342a1dedbbcf159310f3a92d6dc82a2b4bdba",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 78.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.856,
      "atempo": 1.0,
      "tail_silence_seconds": 0.144
    },
    {
      "id": "S15",
      "file": "S15.mp3",
      "text": "两次都没成功，第三次他们换了地点。",
      "sha256": "2995b8704c11051685c15b63c9e025347c27e514220fba0eb92de69afc592b6c",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 84.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.056,
      "atempo": 1.0,
      "tail_silence_seconds": 1.944
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "六月底，他们来到以跳崖闻名的龙沼溪谷。",
      "sha256": "e5872e3bd6dd961c77370d866420c6edb80fe20f09cb73543c1a852083b739bd",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
