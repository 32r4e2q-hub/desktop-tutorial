      "tail_silence_seconds": 1.872
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "公开通缉十七天，他们在高阳被捕。",
      "sha256": "e1ed4ec7b693927ed53cfee1321b504b16e7a1d9b5c773f597f099e5962bf8fe",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
