      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.328,
      "atempo": 1.0,
      "tail_silence_seconds": 0.672
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "同行的人里，有妻子的情人赵贤洙。",
      "sha256": "6f0fef26ea4b2599852f52bb69726375e16245f9548ae59a24815f426dcde09c",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 96.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.728,
      "atempo": 1.0,
      "tail_silence_seconds": 1.272
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "不会游泳的尹相烨，被反复劝上四米高的岩台。",
      "sha256": "6bf46ca314e1e8512e52cdfef717b9c5fa408c27fa2b0fd87fddb149bc33ab17",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
