      "tail_silence_seconds": 0.816
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "二零二三年九月二十一日，大法院驳回上告。",
      "sha256": "5873d8d58cbe8c64c76a63e8692c1ae61d064459a78d2d0d6283391095ad53a1",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
