      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.944,
      "atempo": 1.0,
      "tail_silence_seconds": 1.056
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "崖下水面，只剩一只空着的救生圈。",
      "sha256": "66f95e48160096c7220c7eebd0ef7530c92f2a4c3aeebb3ac5f59e8e4210ec42",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
