      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.776,
      "atempo": 1.0,
      "tail_silence_seconds": 1.224
    },
    {
      "id": "S25",
      "file": "S25.mp3",
      "text": "检方主张的精神控制直接杀人，法院没有采纳。",
      "sha256": "8410b90d782f65f2b55a69c18f28528a0821eabcab6cb86ed309d537826816f0",
      "voice_id": "voice-00",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
