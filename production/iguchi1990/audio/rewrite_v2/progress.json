      "file": "S16.mp3",
      "voice_id": "voice-03",
      "sha256": "0ef1632af64a4b8d8a7f019880843c4d0e7def77526e0375f8d9eb7264422145",
      "text_matches_script": true,
      "script_text": "他供称，自己在车站看见真理子，随后主动上前搭话。",
      "decoded_seconds": 6.04,
      "active_seconds": 5.33,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 0.9253,
      "cjk_count": 21,
      "status": "provisional"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "voice_id": "voice-03",
      "sha256": "872cb5c10ca7238958c59e6ae5d8f5cf486a6c9c3c4ee5d4e3d01e2b5db9bf6b",
      "text_matches_script": true,
      "script_text": "他还说，白天带她去过景点；每个细节仍要逐一核实。",
      "decoded_seconds": 6.8,
      "active_seconds": 6.3,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.0938,
      "cjk_count": 21,
      "status": "provisional"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "voice_id": "voice-03",
      "sha256": "7a21d255a33f065a83d48011d5d4870fc5c3a1b3f84245075d730e6c1c3a674a",
      "text_matches_script": true,
      "script_text": "他的说法几度变化，警方只好重新核对每条线索。",
      "decoded_seconds": 5.56,
      "active_seconds": 5.03,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 1.0567,
      "cjk_count": 20,
      "status": "provisional"
    },
    {
