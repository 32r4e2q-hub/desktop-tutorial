      "voice_id": "voice-03",
      "sha256": "98e80fbfb6fba5ef6b960ad0ec3cfdd1e25cfe5c9c36658d9b45c7c85078b6f7",
      "text_matches_script": true,
      "script_text": "母亲久子带着女儿照片，跨海来到台湾寻人。",
      "decoded_seconds": 5.76,
      "active_seconds": 5.31,
      "target_seconds": 5,
