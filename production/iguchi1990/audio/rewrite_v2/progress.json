      "file": "S24.mp3",
      "voice_id": "voice-03",
      "sha256": "c864303de40f6450d9b79472dc478ebf427f16d434badfbfa3bbc6ffe081deb6",
      "text_matches_script": true,
      "script_text": "警车整夜往返台南、高雄，路灯从车窗掠过，天色渐渐发亮。",
      "decoded_seconds": 7.88,
      "active_seconds": 7.34,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
