    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "voice_id": "voice-03",
      "sha256": "b62b8251acee52ca50927863b911dafbd9a34d3f882a9c6b9a16cde319ca3920",
      "text_matches_script": true,
      "script_text": "时间回到一九九〇年四月，二十三岁的她独自抵台，旅程才开始。",
      "decoded_seconds": 7.24,
      "active_seconds": 6.73,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 0.9956,
      "cjk_count": 25,
      "status": "provisional"
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "voice_id": "voice-03",
      "sha256": "db0da3ec6a28d68805a042af61383efddc0264330bd5f84d80d865953c7febda",
      "text_matches_script": true,
      "script_text": "夜市人声热闹、锅气升起；她边尝小吃，边把见闻记进小本子。",
      "decoded_seconds": 8.36,
      "active_seconds": 7.68,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 1.1361,
      "cjk_count": 24,
      "status": "provisional"
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "voice_id": "voice-03",
      "sha256": "8d6a501a2b504cac8e7899061be3a70d12cc9a99a417ef39bbbbee7d1da45be5",
      "text_matches_script": true,
      "script_text": "在台南，她认识了李姓计程车司机；对方接待过她，也邀她借住。",
      "decoded_seconds": 6.8,
      "active_seconds": 6.4,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.1111,
      "cjk_count": 25,
      "status": "provisional"
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "voice_id": "voice-03",
      "sha256": "c5d7ea8289b0e8cbb35b996c622190359e0cd38f82da464682b135ebf5170328",
      "text_matches_script": true,
      "script_text": "她写下明信片，向日本家人报平安，也留下旅途点滴。",
      "decoded_seconds": 5.84,
      "active_seconds": 5.35,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 1.1239,
      "cjk_count": 21,
      "status": "provisional"
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "voice_id": "voice-03",
      "sha256": "0df318108e5d15dd75de714fc184d55d446ba94a278fbce7cf76bf62f5a21066",
      "text_matches_script": true,
      "script_text": "四月七日清晨，司机送她到台南车站；她登上列车，驶向高雄。",
      "decoded_seconds": 6.92,
      "active_seconds": 6.43,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 0.9512,
      "cjk_count": 24,
      "status": "provisional"
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "voice_id": "voice-03",
      "sha256": "91721931bacf62c53df876e062bd44ab143975665a2b809a1050d28b49218ffd",
      "text_matches_script": true,
      "script_text": "车窗外，稻田渐渐退远；她手里的明信片，记着旅途日常。",
      "decoded_seconds": 6.96,
      "active_seconds": 6.49,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 0.9601,
      "cjk_count": 22,
      "status": "provisional"
    },
    {
      "id": "S09",
      "file": "S09.mp3",
      "voice_id": "voice-03",
      "sha256": "59504fdc4afa980b9e48358389b24b117fbe7bef0acb899d5fdf274209aaaf24",
      "text_matches_script": true,
      "script_text": "她抵达高雄车站，独自走出站口；此后便没了消息。",
      "decoded_seconds": 5.4,
      "active_seconds": 4.84,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 0.8403,
      "cjk_count": 20,
      "status": "provisional"
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "voice_id": "voice-03",
      "sha256": "2d56dfdd29f428e5d6b1a33eaa45edff1d0dbcbbdb14187043cdbc8346bdcae0",
      "text_matches_script": true,
      "script_text": "四月十八日，原定返日的航班起飞，她却没有登机。",
      "decoded_seconds": 5.44,
      "active_seconds": 4.95,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 1.0399,
      "cjk_count": 20,
      "status": "provisional"
    },
    {
      "id": "S11",
      "file": "S11.mp3",
      "voice_id": "voice-03",
      "sha256": "119242c560103bd3516f6f6171ac731f635db68f5a62019b54cdc9056590e4bb",
      "text_matches_script": true,
      "script_text": "四月二十五日，母亲久子带着女儿照片抵台，沿途打听她的下落。",
      "decoded_seconds": 6.8,
      "active_seconds": 6.21,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 0.9186,
      "cjk_count": 26,
      "status": "provisional"
    },
    {
      "id": "S12",
      "file": "S12.mp3",
      "voice_id": "voice-03",
      "sha256": "3ec3cc4e1e52c74b8ec36d39e5970b85fb3ebf7268f5aff91a6e31d1effdbaae",
      "text_matches_script": true,
      "script_text": "等不到消息，她向警方求助；搜寻范围由台南一路延伸到高雄。",
      "decoded_seconds": 7.52,
      "active_seconds": 6.89,
      "target_seconds": 7,
      "available_speech_seconds": 6.76,
      "required_speedup": 1.0192,
      "cjk_count": 25,
      "status": "provisional"
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "voice_id": "voice-03",
      "sha256": "b60d00cb371be932872095b86c9b0c205b22ab82f77242cc64b10509ff429ea2",
      "text_matches_script": true,
      "script_text": "李姓司机接受警方询问后获释；真理子的下落仍无从确认。",
      "decoded_seconds": 6.52,
      "active_seconds": 6.08,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.0556,
      "cjk_count": 24,
      "status": "provisional"
    },
    {
      "id": "S14",
      "file": "S14.mp3",
      "voice_id": "voice-03",
      "sha256": "af5e73b2c3ac8a0fd50757faebb21c824f2c07d312173f51b49633dceaa82f21",
      "text_matches_script": true,
      "script_text": "墓园与甘蔗田反复搜过，仍找不到她的踪迹。",
      "decoded_seconds": 5.0,
      "active_seconds": 4.42,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 0.9286,
      "cjk_count": 18,
      "status": "provisional"
    },
    {
