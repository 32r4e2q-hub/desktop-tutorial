      "file": "S21.mp3",
      "voice_id": "voice-03",
      "sha256": "639f97dbf58d47e9df085946d3cc893120ab5aefc68ad774dab469b43001465d",
      "text_matches_script": true,
      "script_text": "深夜，警车循着新线索驶进小巷。",
      "decoded_seconds": 4.32,
      "active_seconds": 3.83,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 0.8046,
      "cjk_count": 13,
      "status": "provisional"
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "voice_id": "voice-03",
      "sha256": "0a216813ce0680e27f9249c78a972172a8aba49fef601333fea220cea5797694",
      "text_matches_script": true,
      "script_text": "又一处线索落空，天快亮了，搜寻仍没有停下来。",
      "decoded_seconds": 5.84,
      "active_seconds": 5.27,
      "target_seconds": 5,
      "available_speech_seconds": 4.76,
      "required_speedup": 1.1071,
      "cjk_count": 19,
      "status": "provisional"
    },
