      "file": "S28.mp3",
      "voice_id": "voice-03",
      "sha256": "378ba6c3de94d061562efa87546d50b8f850aebe026f32b1191c4c9386adfc7a",
      "text_matches_script": true,
      "script_text": "他供称，头颅被垃圾车运走；相关搜寻最终停止。",
      "decoded_seconds": 5.68,
      "active_seconds": 5.15,
      "target_seconds": 6,
