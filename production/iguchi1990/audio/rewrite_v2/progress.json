      "file": "S15.mp3",
      "voice_id": "voice-03",
      "sha256": "f53b783e0fc4aa75d05c0055ef78392c3da3fce6746b5df5f9ae5b678fd6e800",
      "text_matches_script": true,
      "script_text": "次年三月，警方在高雄逮捕刘学强；追查终于有了突破。",
      "decoded_seconds": 6.48,
      "active_seconds": 5.79,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.0052,
      "cjk_count": 22,
      "status": "provisional"
    },
    {
