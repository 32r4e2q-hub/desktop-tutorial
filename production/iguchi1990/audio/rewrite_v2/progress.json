      "voice_id": "voice-03",
      "sha256": "f795fc698639160fd2da2ab573ca117d77e669a1589cb1e2544e0e408a393889",
      "text_matches_script": true,
      "script_text": "王家儒回忆，谈到儿子时，对方沉默良久，终于说出地点。",
      "decoded_seconds": 6.44,
      "active_seconds": 5.9,
      "target_seconds": 6,
