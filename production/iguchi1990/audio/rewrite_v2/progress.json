      "file": "S19.mp3",
      "voice_id": "voice-03",
      "sha256": "663c688e43a36aeedaf0535378e7a2252d0c3a09573f4080e37c755c5ab68356",
      "text_matches_script": true,
      "script_text": "那只深蓝色背包，也成了这个故事里另一个没有答案的问号。",
      "decoded_seconds": 6.08,
      "active_seconds": 5.56,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 0.9653,
      "cjk_count": 25,
      "status": "provisional"
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "voice_id": "voice-03",
      "sha256": "871f652ec07ba74430af669d61b203d4cf04018d882dc09552716559aec1e41f",
      "text_matches_script": true,
      "script_text": "每报出一个新地点，警员就得立即出发；搜寻一再落空。",
      "decoded_seconds": 6.52,
      "active_seconds": 5.97,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.0365,
      "cjk_count": 22,
      "status": "provisional"
    },
    {
