      "file": "S23.mp3",
      "voice_id": "voice-03",
      "sha256": "d3ad723f929402bf17402d66c81c64f289e0c29118fb4e4bdec55443d7278e1f",
      "text_matches_script": true,
      "script_text": "三月七日深夜，组长王家儒决定自己留下来，再和他单独谈一次。",
      "decoded_seconds": 6.64,
      "active_seconds": 6.14,
      "target_seconds": 7,
