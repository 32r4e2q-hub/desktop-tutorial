      "voice_id": "voice-03",
      "sha256": "cc49cff7fc793812c93a6b11f9324cd77625856ed2feb97ea6407cca9a6b15e7",
      "text_matches_script": true,
      "script_text": "确认身份后，母亲后来见到女儿遗物；漫长等待，终于有了结果。",
      "decoded_seconds": 6.84,
      "active_seconds": 6.04,
      "target_seconds": 6,
      "available_speech_seconds": 5.76,
      "required_speedup": 1.0486,
      "cjk_count": 25,
