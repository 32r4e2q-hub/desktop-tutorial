  "clips": [
    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "1919年午夜，全城同时放起了爵士乐。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
