      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.827,
      "atempo": 1.1378,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "纪录片《消失在西塞尔酒店》让这段城市记忆重回公众视野。",
      "sha256": "79afbf07948585bf8be08fcd851616dc0ce37b94d22532a830fe104b5a451d09",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
