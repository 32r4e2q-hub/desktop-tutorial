      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.525,
      "atempo": 1.0875,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "而她的家人只想要一个答案，不是传说，只是一个解释。",
      "sha256": "430a85b10ec6fd1e48f7f6d17f20a553c26d3500f98a13c2be4c974be3e40894",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
