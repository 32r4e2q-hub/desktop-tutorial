  "clips": [
    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "二零一三年一月三十一日凌晨，电梯按钮全亮了。",
      "sha256": "9833c3be4fdfe4020575af11602b71dbdc66e8ed9eabd7785356fbcc08b1d756",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 0.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.435,
      "atempo": 1.0,
      "tail_silence_seconds": 1.565
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "西塞尔酒店的电梯，停了一下——又停了一下。",
      "sha256": "5be903594440d3c84668fdd94e0f0114787d8d318866909bf018ac7343dbf4a4",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 6.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.899,
      "atempo": 1.0,
      "tail_silence_seconds": 1.101
    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "text": "她躲在门后，一遍遍向走廊里张望。",
      "sha256": "ccf59990141be92826e9e091f5848a4e58d6ae3bfd10ef953ab5c9caf13c3f11",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 12.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.541,
      "atempo": 1.0,
      "tail_silence_seconds": 2.459
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "像是在躲什么——又好像觉得自己正在被追。",
      "sha256": "1c16cb15b6f579375837bebacbae93ccbcc4a63af758d451d3fb1424392f4aff",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 18.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.435,
      "atempo": 1.0,
      "tail_silence_seconds": 1.565
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "这是洛杉矶市中心的西塞尔酒店——“死亡之屋”。",
      "sha256": "afa994a9675da79099410826f6eba5795f9840e2281aa6faece1b953a0fac905",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N01",
      "target_start": 24.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.981,
      "atempo": 1.0,
      "tail_silence_seconds": 1.019
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "text": "蓝可儿，华裔加拿大人，在温哥华上大学。",
      "sha256": "75e36669a2a98a1cf41571b967ef36ea6ac877ddc4ec890158c536ea02067098",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 30.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.516,
      "atempo": 1.0,
      "tail_silence_seconds": 1.484
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "text": "那年一月，她跟朋友们一起来到洛杉矶。",
      "sha256": "ab06d7a1b4467ffab8b6a73aa55824b3ea9b0d52dc12f2d40a142bf0a36c685f",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 36.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.413,
      "atempo": 1.0,
      "tail_silence_seconds": 2.587
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "text": "朋友先离开后，她说再玩几天，一个人留在旅馆。",
      "sha256": "95aac028c3523e328988ead9707c936f3ee28d9e2fda4471535171f245f60880",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 42.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.598,
      "atempo": 1.0,
      "tail_silence_seconds": 1.402
    },
    {
      "id": "S09",
      "file": "S09.mp3",
      "text": "后来，再也没有人见过她。",
      "sha256": "0075d6989c42a92059bb6c918908a2d0fcc658fb4597a52a65066e0e6bd4c5e2",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 48.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 2.728,
      "atempo": 1.0,
      "tail_silence_seconds": 3.272
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "text": "她最后一次出现在监控里，是一月三十一日凌晨。",
      "sha256": "7e081a4df9a805bb7f9deb2cad3c22c75aad63c6456a62a31dd48b4eabea6f66",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N02",
      "target_start": 54.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.598,
      "atempo": 1.0,
      "tail_silence_seconds": 1.402
    },
    {
      "id": "S11",
      "file": "S11.mp3",
      "text": "警方向媒体公布了这段电梯录像。",
      "sha256": "8d77b35a4418becb16fa42b7622ab6d66a2fb40b76f6edd9047651e5f7b857fe",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 60.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.622,
      "atempo": 1.0,
      "tail_silence_seconds": 2.378
    },
    {
      "id": "S12",
      "file": "S12.mp3",
      "text": "短短录像里，她按亮了每一层，往走廊望了又望。",
      "sha256": "4dc60f40b9dde96e1736144dbd93a4b9004eda76608ffe77bcb00ca8dd1db961",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 66.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.201,
      "atempo": 1.0,
      "tail_silence_seconds": 0.799
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "警方把她当失踪人口立案排查。",
      "sha256": "8570bd6a25ce7108ceed8f739a90ae8d61a70de1db70034648a57c0933c6651c",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 72.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.413,
      "atempo": 1.0,
      "tail_silence_seconds": 2.587
    },
    {
      "id": "S14",
      "file": "S14.mp3",
      "text": "她的房间里，护照、手机、现金全都在。",
      "sha256": "ac095667454d04b5f4f7da9af5d5f7c261d56f04dc954e613bfc3892950892b6",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 78.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.214,
      "atempo": 1.0,
      "tail_silence_seconds": 1.786
    },
    {
      "id": "S15",
      "file": "S15.mp3",
      "text": "十九天里没人再见过她——直到有人报修水压。",
      "sha256": "81637dd3edf90b547a213958f818e8e00458e4c4266defb7a922de075c7dca93",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N03",
      "target_start": 84.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.201,
      "atempo": 1.0,
      "tail_silence_seconds": 0.799
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "二月十九日，酒店维修工接到投诉：没了水压。",
      "sha256": "e219eccf068dc86d73a1028fe6a0efe2f6fec1aa9c23535fa5bb1111f6b19219",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 90.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.725,
      "atempo": 1.0,
      "tail_silence_seconds": 1.275
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "他们爬上屋顶，打开水箱盖——然后就没了声音。",
      "sha256": "889b767517e5005aa94faea6f837a9d106b93bc1e121c5fd3f8d050d01589cea",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 96.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.831,
      "atempo": 1.0,
      "tail_silence_seconds": 2.169
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "她在里面——十九天，泡在冰冷的水里。",
      "sha256": "655134c01617580f9145b7c5a176854e3b229fbe3061c69093204bd995c1bfac",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 102.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.307,
      "atempo": 1.0,
      "tail_silence_seconds": 1.693
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "警方封锁屋顶，全球媒体涌了过来。",
      "sha256": "7a955192dff90767cd5ee6079e9153ef1ae1e48b5e4723df43413c923f39396e",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 108.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.133,
      "atempo": 1.0,
      "tail_silence_seconds": 1.867
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "尸检：溺水。没有挣扎，没有暴力，没有嫌疑人。",
      "sha256": "52cdabcf03ed5a5e51c8a5ad8f88f617ab95a359a742271b5fd090949dba7589",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N04",
      "target_start": 114.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.155,
      "atempo": 1.0,
      "tail_silence_seconds": 0.845
    },
    {
      "id": "S21",
      "file": "S21.mp3",
      "text": "所有人盯上了那段录像——躲的是人，还是幻觉。",
      "sha256": "60d1e902189c05839a29f05beef7eefeda0d19dfaeed1db48b6ab03cc96f329b",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 120.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.4,
      "atempo": 1.0,
      "tail_silence_seconds": 0.6
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "网上疯传：西塞尔有鬼，电梯会自己开。",
      "sha256": "26f6606d778da0aec997d04e31afafb27a16b1f4960a3772f47b172058fc6579",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 126.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.087,
      "atempo": 1.0,
      "tail_silence_seconds": 1.913
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "警方面对的现实只有一句：除了录像，什么都没有。",
      "sha256": "74330e18912621cf3f089af33318e13a6c8a0568556a0c891546ac0db8d0d17a",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 132.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.899,
      "atempo": 1.0,
      "tail_silence_seconds": 1.101
    },
    {
      "id": "S24",
      "file": "S24.mp3",
      "text": "她患有双相情感障碍，官方结论是溺水。",
      "sha256": "475764766c01aa79d11ca058c7598177af8c2c2a96513de3caa1880e46f222d7",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 138.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.3,
      "atempo": 1.0,
      "tail_silence_seconds": 1.7
    },
    {
      "id": "S25",
      "file": "S25.mp3",
      "text": "停药还是没停药，没有人能说清楚。",
      "sha256": "17fa848ae65760fb27c69ed87c6ebef9eb0e65e2b1ec5afbb4c24db6b5c1127e",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N05",
      "target_start": 144.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.32,
      "atempo": 1.0,
      "tail_silence_seconds": 2.68
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "西塞尔后来歇了业，改作平价住房，电梯仍在运行。",
      "sha256": "3dc6aaeb90c78b51f1c5b8ec685c66a3a53b2356ff4d129266d6f23fc84f86db",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
      "target_start": 150.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.899,
      "atempo": 1.0,
      "tail_silence_seconds": 1.101
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "不久，一部纪录片把西塞尔再次推回聚光灯下。",
      "sha256": "ffad2ea874d09e2a851f39da0974b3df9f809fb957d7ee671b5ca4bc805683e1",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
      "target_start": 156.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.899,
      "atempo": 1.0,
      "tail_silence_seconds": 1.101
    },
    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "而她的家人只想要一个答案。",
      "sha256": "4542f13c1bb12121718dfecf31cf0a7f57fd263ebf225b350ca0bbc27b41330a",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
      "target_start": 162.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 2.891,
      "atempo": 1.0,
      "tail_silence_seconds": 3.109
    },
    {
      "id": "S29",
      "file": "S29.mp3",
      "text": "她本该早点回家——她没有回来。",
      "sha256": "03f29a2cde21b43266a4edeab5dbe8f49e9bf8d87d51faa03f4df4e48750f0d9",
      "voice_id": "voice-02",
      "voice_description": "试音对决 02 由主创选定（2026-11-22）；悬疑纪录片向低沉普通话男声，克制压抑",
      "narration_id": "N06",
      "target_start": 168.0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 3.0,
      "atempo": 1.0,
      "tail_silence_seconds": 3.0
    },
    {
      "id": "S30",
