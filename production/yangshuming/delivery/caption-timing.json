[
  {
    "start": 0.728195345288058,
    "end": 1.7340357467789747,
    "text": "一九九二年，"
  },
  {
    "start": 2.0101487981686375,
    "end": 3.578076482845655,
    "text": "山西阳泉马家坪。"
  },
  {
    "start": 3.8541895342353176,
    "end": 6.644903589352272,
    "text": "一名下夜班的女工倒在回家的路上。"
  },
  {
    "start": 6.93087782114871,
    "end": 7.97616294426672,
    "text": "此后十四年，"
  },
  {
    "start": 8.27199835646993,
    "end": 10.658404014909163,
    "text": "矿区接连发生针对女性的袭击——"
  },
  {
    "start": 10.934517066298827,
    "end": 11.575493792739117,
    "text": "凶手，"
  },
  {
    "start": 11.841745663722007,
    "end": 13.034948492941623,
    "text": "就藏在人群之中。"
  },
  {
    "start": 13.311061544331286,
    "end": 14.435236110703487,
    "text": "多起案件里，"
  },
  {
    "start": 14.563431455991546,
    "end": 18.004983417955565,
    "text": "有报道称多名受害者穿着红色衣物，"
  },
  {
    "start": 18.290957649752002,
    "end": 20.430833798021894,
    "text": "「红衣杀手」的称呼不胫而走。"
  },
  {
    "start": 20.70694684941156,
    "end": 22.15654036920729,
    "text": "可比颜色更重要的，"
  },
  {
    "start": 22.353763977342762,
    "end": 24.73030845537522,
    "text": "是案件之间的联系。"
  },
  {
    "start": 24.897948522290374,
    "end": 26.613793913068996,
    "text": "一年又一年过去，"
  },
  {
    "start": 26.811017521204473,
    "end": 27.915469726763124,
    "text": "案子始终没破。"
  },
  {
    "start": 29.11380389164441,
    "end": 30.25770081883016,
    "text": "凶手没有消失。"
  },
  {
    "start": 30.533813870219824,
    "end": 31.628404895371702,
    "text": "工人照常上班，"
  },
  {
    "start": 31.855212044727494,
    "end": 33.20619376045549,
    "text": "孩子照常上学；"
  },
  {
    "start": 33.482306811845156,
    "end": 34.56703665659026,
    "text": "可夜色一降，"
  },
  {
    "start": 34.86287206879347,
    "end": 36.77594106770756,
    "text": "脚步声就让人发怵。"
  },
  {
    "start": 37.06191529950401,
    "end": 37.75219792797816,
    "text": "杨树明，"
  },
  {
    "start": 38.038172159774604,
    "end": 39.172207906553574,
    "text": "山西寿阳人，"
  },
  {
    "start": 39.44832095794324,
    "end": 40.769719132450916,
    "text": "在当地企业上班——"
  },
  {
    "start": 41.045832183840574,
    "end": 41.70653127109441,
    "text": "有工作，"
  },
  {
    "start": 41.99250550289085,
    "end": 42.672926950958235,
    "text": "也有家庭。"
  },
  {
    "start": 42.968762363161446,
    "end": 46.420175505532235,
    "text": "没有人能从表象里看清他的罪行。"
  },
  {
    "start": 46.70614973732867,
    "end": 47.820463123294104,
    "text": "二〇〇一年，"
  },
  {
    "start": 48.155743257124406,
    "end": 49.79269920464884,
    "text": "一名女工下班后失踪，"
  },
  {
    "start": 49.83214392627593,
    "end": 51.528266956241005,
    "text": "几天后被发现遇害。"
  },
  {
    "start": 51.80438000763067,
    "end": 53.184945264578985,
    "text": "二〇〇四年冬天，"
  },
  {
    "start": 53.36244651190091,
    "end": 54.67398350600182,
    "text": "悲剧再次上演。"
  },
  {
    "start": 54.950096557391475,
    "end": 56.60677486572946,
    "text": "一次次排查走访，"
  },
  {
    "start": 56.715247850203966,
    "end": 58.6874839315587,
    "text": "案件迟迟没有突破。"
  },
  {
    "start": 59.895679276846764,
    "end": 62.94278402253984,
    "text": "二〇〇五年警方重新组建专案力量。"
  },
  {
    "start": 63.2188970739295,
    "end": 65.41794030464003,
    "text": "这一次不再只盯单起案件——"
  },
  {
    "start": 65.70391453643647,
    "end": 67.7155953394183,
    "text": "而是把十四年来的案发地点、"
  },
  {
    "start": 67.86351304551991,
    "end": 68.44532268951956,
    "text": "时间、"
  },
  {
    "start": 68.6524074780618,
    "end": 70.91061779121297,
    "text": "受害者情况放在一起比对。"
  },
  {
    "start": 71.19659202300942,
    "end": 73.77036010917735,
    "text": "地图上的标记逐渐连成一片，"
  },
  {
    "start": 74.04647316056702,
    "end": 76.22579403046399,
    "text": "嫌疑范围一轮轮缩小。"
  },
  {
    "start": 76.50190708185366,
    "end": 78.60233850849646,
    "text": "杨树明进入重点视野："
  },
  {
    "start": 78.88831274029289,
    "end": 80.75207583717312,
    "text": "他住在案发区域附近。"
  },
  {
    "start": 81.02818888856278,
    "end": 81.60999853256243,
    "text": "询问、"
  },
  {
    "start": 81.89597276435887,
    "end": 82.71445073812109,
    "text": "比对资料、"
  },
  {
    "start": 82.99056378951074,
    "end": 86.02780735479705,
    "text": "心理测试……多种线索逐渐汇合，"
  },
  {
    "start": 86.31378158659348,
    "end": 86.89559123059313,
    "text": "调查，"
  },
  {
    "start": 87.18156546238957,
    "end": 88.79386845889707,
    "text": "逼近关键节点。"
  },
  {
    "start": 89.99220262377835,
    "end": 91.29387843747247,
    "text": "二〇〇六年三月，"
  },
  {
    "start": 91.45165732398085,
    "end": 94.03528659055556,
    "text": "杨树明与其他重点对象接受调查。"
  },
  {
    "start": 94.321260822352,
    "end": 95.1101552548939,
    "text": "面对询问，"
  },
  {
    "start": 95.35668476506324,
    "end": 96.79641710445219,
    "text": "他一度相当镇定。"
  },
  {
    "start": 97.08239133624863,
    "end": 99.01518269597628,
    "text": "可随着线索一寸寸拼合，"
  },
  {
    "start": 99.26171220614562,
    "end": 101.08603058139875,
    "text": "他的从容开始出现裂缝。"
  },
  {
    "start": 101.36214363278842,
    "end": 102.8709042350248,
    "text": "据当年媒体报道，"
  },
  {
    "start": 103.19632318844832,
    "end": 104.40924837848148,
    "text": "三月底前后，"
  },
  {
    "start": 104.64591670824406,
    "end": 106.391345640243,
    "text": "他开始交代犯罪事实。"
  },
  {
    "start": 106.67731987203943,
    "end": 107.72260499515744,
    "text": "调查最终确认："
  },
  {
    "start": 108.02830158776743,
    "end": 108.99469726763125,
    "text": "十二起案件，"
  },
  {
    "start": 109.28067149942768,
    "end": 110.51331905027439,
    "text": "九名女性死亡、"
  },
  {
    "start": 110.77957092125729,
    "end": 111.54874299298564,
    "text": "三人受伤——"
  },
  {
    "start": 111.83471722478207,
    "end": 113.1363930384762,
    "text": "十四年的恐惧，"
  },
  {
    "start": 113.42236727027264,
    "end": 114.8620996096616,
    "text": "终于有了责任人。"
  },
  {
    "start": 116.06043377454289,
    "end": 117.53961083555893,
    "text": "二〇〇六年四月，"
  },
  {
    "start": 117.7368344436944,
    "end": 120.19226836498106,
    "text": "阳泉警方宣布案件告破。"
  },
  {
    "start": 120.47824259677749,
    "end": 121.06005224077714,
    "text": "同年，"
  },
  {
    "start": 121.30658175094648,
    "end": 123.19992838904703,
    "text": "杨树明被依法逮捕，"
  },
  {
    "start": 123.48590262084348,
    "end": 125.32008217650338,
    "text": "案件进入司法程序。"
  },
  {
    "start": 125.60605640829982,
    "end": 126.32592257799429,
    "text": "庭审中，"
  },
  {
    "start": 126.56259090775686,
    "end": 129.29413788043317,
    "text": "他对主要犯罪事实供认不讳。"
  },
  {
    "start": 129.5801121122296,
    "end": 130.31970064273764,
    "text": "八月十日，"
  },
  {
    "start": 130.6056748745341,
    "end": 131.4635975699234,
    "text": "一审判决："
  },
  {
    "start": 131.75943298212658,
    "end": 133.3766665688375,
    "text": "故意杀人罪死刑，"
  },
  {
    "start": 133.65277962022714,
    "end": 136.42377131453054,
    "text": "另因抢劫罪判处有期徒刑，"
  },
  {
    "start": 136.6998843659202,
    "end": 137.755030669445,
    "text": "数罪并罚，"
  },
  {
    "start": 138.0114213600211,
    "end": 138.8496216945969,
    "text": "执行死刑。"
  },
  {
    "start": 139.1355959263933,
    "end": 140.58518944618905,
    "text": "十一月二十一日，"
  },
  {
    "start": 140.73310715229064,
    "end": 142.71520441405215,
    "text": "杨树明被执行死刑。"
  },
  {
    "start": 143.0011786458486,
    "end": 144.726885217034,
    "text": "十四年的系列案件，"
  },
  {
    "start": 145.0227206292372,
    "end": 146.38356352537198,
    "text": "至此终结。"
  },
  {
    "start": 147.59175887066002,
    "end": 148.43982038564255,
    "text": "案件终结，"
  },
  {
    "start": 148.71593343703222,
    "end": 150.27399994130246,
    "text": "矿区的生活还要继续。"
  },
  {
    "start": 150.55011299269214,
    "end": 151.64470401784402,
    "text": "可对家属来说，"
  },
  {
    "start": 151.92081706923366,
    "end": 153.80430252692744,
    "text": "痛不会随判决消失。"
  },
  {
    "start": 154.0902767587239,
    "end": 155.2144513250961,
    "text": "九名遇害女性，"
  },
  {
    "start": 155.45111965485864,
    "end": 157.05849206116278,
    "text": "从十六岁到四十二岁——"
  },
  {
    "start": 157.3444662929592,
    "end": 159.82948375546619,
    "text": "她们原本都有自己的生活和未来。"
  },
  {
    "start": 160.10559680685583,
    "end": 162.72867079505764,
    "text": "侦查从来没有戏剧性的瞬间："
  },
  {
    "start": 163.01464502685408,
    "end": 164.67132333519206,
    "text": "它来自一遍遍的走访、"
  },
  {
    "start": 164.94743638658173,
    "end": 165.31230006163236,
    "text": "档案，"
  },
  {
    "start": 165.59827429342877,
    "end": 167.0577289936313,
    "text": "和对旧线索的不放弃。"
  },
  {
    "start": 167.33384204502096,
    "end": 169.17788278108765,
    "text": "「红衣杀手」让人记住了案子，"
  },
  {
    "start": 169.4539958324773,
    "end": 170.7359492853579,
    "text": "却不该盖住事实——"
  },
  {
    "start": 171.0219235171543,
    "end": 172.40248877410264,
    "text": "受害者不是符号，"
  },
  {
    "start": 172.70818536671263,
    "end": 173.99999999999997,
    "text": "是真实的人。"
  }
]