{
 "N01": {
  "duration": 27.7,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.11,
    "text": "一九九二年",
    "chars_per_second": 5.21
   },
   {
    "i": 1,
    "start": 1.45,
    "end": 2.98,
    "text": "山西阳泉马家坪",
    "chars_per_second": 4.58
   },
   {
    "i": 2,
    "start": 3.32,
    "end": 6.09,
    "text": "一名下夜班的女工倒在回家的路上",
    "chars_per_second": 5.42
   },
   {
    "i": 3,
    "start": 6.44,
    "end": 7.44,
    "text": "此后十四年",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 7.8,
    "end": 10.16,
    "text": "矿区接连发生针对女性的袭击",
    "chars_per_second": 5.51
   },
   {
    "i": 5,
    "start": 10.5,
    "end": 11.09,
    "text": "凶手",
    "chars_per_second": 3.39
   },
   {
    "i": 6,
    "start": 11.42,
    "end": 12.57,
    "text": "就藏在人群之中",
    "chars_per_second": 6.09
   },
   {
    "i": 7,
    "start": 12.91,
    "end": 13.99,
    "text": "多起案件里",
    "chars_per_second": 4.63
   },
   {
    "i": 8,
    "start": 14.18,
    "end": 17.61,
    "text": "有报道称多名受害者穿着红色衣物",
    "chars_per_second": 4.37
   },
   {
    "i": 9,
    "start": 17.96,
    "end": 20.07,
    "text": "「红衣杀手」的称呼不胫而走",
    "chars_per_second": 5.21
   },
   {
    "i": 10,
    "start": 20.41,
    "end": 21.82,
    "text": "可比颜色更重要的",
    "chars_per_second": 5.67
   },
   {
    "i": 11,
    "start": 22.08,
    "end": 24.43,
    "text": "是案件之间的联系",
    "chars_per_second": 3.4
   },
   {
    "i": 12,
    "start": 24.66,
    "end": 26.34,
    "text": "一年又一年过去",
    "chars_per_second": 4.17
   },
   {
    "i": 13,
    "start": 26.6,
    "end": 27.7,
    "text": "案子始终没破",
    "chars_per_second": 5.45
   }
  ]
 },
 "N02": {
  "duration": 30.11,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.24,
    "text": "凶手没有消失",
    "chars_per_second": 5.45
   },
   {
    "i": 1,
    "start": 1.58,
    "end": 2.63,
    "text": "工人照常上班",
    "chars_per_second": 5.71
   },
   {
    "i": 2,
    "start": 2.92,
    "end": 4.23,
    "text": "孩子照常上学",
    "chars_per_second": 4.58
   },
   {
    "i": 3,
    "start": 4.57,
    "end": 5.61,
    "text": "可夜色一降",
    "chars_per_second": 4.81
   },
   {
    "i": 4,
    "start": 5.97,
    "end": 7.85,
    "text": "脚步声就让人发怵",
    "chars_per_second": 4.26
   },
   {
    "i": 5,
    "start": 8.2,
    "end": 8.84,
    "text": "杨树明",
    "chars_per_second": 4.69
   },
   {
    "i": 6,
    "start": 9.19,
    "end": 10.28,
    "text": "山西寿阳人",
    "chars_per_second": 4.59
   },
   {
    "i": 7,
    "start": 10.62,
    "end": 11.9,
    "text": "在当地企业上班",
    "chars_per_second": 5.47
   },
   {
    "i": 8,
    "start": 12.24,
    "end": 12.85,
    "text": "有工作",
    "chars_per_second": 4.92
   },
   {
    "i": 9,
    "start": 13.2,
    "end": 13.83,
    "text": "也有家庭",
    "chars_per_second": 6.35
   },
   {
    "i": 10,
    "start": 14.19,
    "end": 17.63,
    "text": "没有人能从表象里看清他的罪行",
    "chars_per_second": 4.07
   },
   {
    "i": 11,
    "start": 17.98,
    "end": 19.05,
    "text": "二〇〇一年",
    "chars_per_second": 2.8
   },
   {
    "i": 12,
    "start": 19.45,
    "end": 21.05,
    "text": "一名女工下班后失踪",
    "chars_per_second": 5.62
   },
   {
    "i": 13,
    "start": 21.15,
    "end": 22.81,
    "text": "几天后被发现遇害",
    "chars_per_second": 4.82
   },
   {
    "i": 14,
    "start": 23.15,
    "end": 24.49,
    "text": "二〇〇四年冬天",
    "chars_per_second": 3.73
   },
   {
    "i": 15,
    "start": 24.73,
    "end": 26.0,
    "text": "悲剧再次上演",
    "chars_per_second": 4.72
   },
   {
    "i": 16,
    "start": 26.34,
    "end": 27.96,
    "text": "一次次排查走访",
    "chars_per_second": 4.32
   },
   {
    "i": 17,
    "start": 28.13,
    "end": 30.11,
    "text": "案件迟迟没有突破",
    "chars_per_second": 4.04
   }
  ]
 },
 "N03": {
  "duration": 29.435,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 3.18,
    "text": "二〇〇五年警方重新组建专案力量",
    "chars_per_second": 4.29
   },
   {
    "i": 1,
    "start": 3.52,
    "end": 5.69,
    "text": "这一次不再只盯单起案件",
    "chars_per_second": 5.07
   },
   {
    "i": 2,
    "start": 6.04,
    "end": 8.02,
    "text": "而是把十四年来的案发地点",
    "chars_per_second": 6.06
   },
   {
    "i": 3,
    "start": 8.23,
    "end": 8.76,
    "text": "时间",
    "chars_per_second": 3.77
   },
   {
    "i": 4,
    "start": 9.03,
    "end": 11.26,
    "text": "受害者情况放在一起比对",
    "chars_per_second": 4.93
   },
   {
    "i": 5,
    "start": 11.61,
    "end": 14.16,
    "text": "地图上的标记逐渐连成一片",
    "chars_per_second": 4.71
   },
   {
    "i": 6,
    "start": 14.5,
    "end": 16.65,
    "text": "嫌疑范围一轮轮缩小",
    "chars_per_second": 4.19
   },
   {
    "i": 7,
    "start": 16.99,
    "end": 19.06,
    "text": "杨树明进入重点视野",
    "chars_per_second": 4.35
   },
   {
    "i": 8,
    "start": 19.41,
    "end": 21.24,
    "text": "他住在案发区域附近",
    "chars_per_second": 4.92
   },
   {
    "i": 9,
    "start": 21.58,
    "end": 22.11,
    "text": "询问",
    "chars_per_second": 3.77
   },
   {
    "i": 10,
    "start": 22.46,
    "end": 23.23,
    "text": "比对资料",
    "chars_per_second": 5.19
   },
   {
    "i": 11,
    "start": 23.57,
    "end": 26.59,
    "text": "心理测试……多种线索逐渐汇合",
    "chars_per_second": 3.97
   },
   {
    "i": 12,
    "start": 26.94,
    "end": 27.47,
    "text": "调查",
    "chars_per_second": 3.77
   },
   {
    "i": 13,
    "start": 27.82,
    "end": 29.43,
    "text": "逼近关键节点",
    "chars_per_second": 3.72
   }
  ]
 },
 "N04": {
  "duration": 25.34,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.4,
    "text": "二〇〇六年三月",
    "chars_per_second": 3.97
   },
   {
    "i": 1,
    "start": 1.62,
    "end": 4.18,
    "text": "杨树明与其他重点对象接受调查",
    "chars_per_second": 5.47
   },
   {
    "i": 2,
    "start": 4.53,
    "end": 5.27,
    "text": "面对询问",
    "chars_per_second": 5.41
   },
   {
    "i": 3,
    "start": 5.58,
    "end": 6.98,
    "text": "他一度相当镇定",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 7.33,
    "end": 9.23,
    "text": "可随着线索一寸寸拼合",
    "chars_per_second": 5.26
   },
   {
    "i": 5,
    "start": 9.54,
    "end": 11.33,
    "text": "他的从容开始出现裂缝",
    "chars_per_second": 5.59
   },
   {
    "i": 6,
    "start": 11.67,
    "end": 13.14,
    "text": "据当年媒体报道",
    "chars_per_second": 4.76
   },
   {
    "i": 7,
    "start": 13.53,
    "end": 14.7,
    "text": "三月底前后",
    "chars_per_second": 4.27
   },
   {
    "i": 8,
    "start": 15.0,
    "end": 16.71,
    "text": "他开始交代犯罪事实",
    "chars_per_second": 5.26
   },
   {
    "i": 9,
    "start": 17.06,
    "end": 18.06,
    "text": "调查最终确认",
    "chars_per_second": 6.0
   },
   {
    "i": 10,
    "start": 18.43,
    "end": 19.35,
    "text": "十二起案件",
    "chars_per_second": 5.43
   },
   {
    "i": 11,
    "start": 19.7,
    "end": 20.89,
    "text": "九名女性死亡",
    "chars_per_second": 5.04
   },
   {
    "i": 12,
    "start": 21.22,
    "end": 21.94,
    "text": "三人受伤",
    "chars_per_second": 5.56
   },
   {
    "i": 13,
    "start": 22.29,
    "end": 23.55,
    "text": "十四年的恐惧",
    "chars_per_second": 4.76
   },
   {
    "i": 14,
    "start": 23.9,
    "end": 25.34,
    "text": "终于有了责任人",
    "chars_per_second": 4.86
   }
  ]
 },
 "N05": {
  "duration": 30.87,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.58,
    "text": "二〇〇六年四月",
    "chars_per_second": 3.47
   },
   {
    "i": 1,
    "start": 1.84,
    "end": 4.27,
    "text": "阳泉警方宣布案件告破",
    "chars_per_second": 4.12
   },
   {
    "i": 2,
    "start": 4.62,
    "end": 5.15,
    "text": "同年",
    "chars_per_second": 3.77
   },
   {
    "i": 3,
    "start": 5.46,
    "end": 7.32,
    "text": "杨树明被依法逮捕",
    "chars_per_second": 4.3
   },
   {
    "i": 4,
    "start": 7.67,
    "end": 9.47,
    "text": "案件进入司法程序",
    "chars_per_second": 4.44
   },
   {
    "i": 5,
    "start": 9.82,
    "end": 10.49,
    "text": "庭审中",
    "chars_per_second": 4.48
   },
   {
    "i": 6,
    "start": 10.79,
    "end": 13.5,
    "text": "他对主要犯罪事实供认不讳",
    "chars_per_second": 4.43
   },
   {
    "i": 7,
    "start": 13.85,
    "end": 14.54,
    "text": "八月十日",
    "chars_per_second": 5.8
   },
   {
    "i": 8,
    "start": 14.89,
    "end": 15.7,
    "text": "一审判决",
    "chars_per_second": 4.94
   },
   {
    "i": 9,
    "start": 16.06,
    "end": 17.64,
    "text": "故意杀人罪死刑",
    "chars_per_second": 4.43
   },
   {
    "i": 10,
    "start": 17.98,
    "end": 20.73,
    "text": "另因抢劫罪判处有期徒刑",
    "chars_per_second": 4.0
   },
   {
    "i": 11,
    "start": 21.07,
    "end": 22.08,
    "text": "数罪并罚",
    "chars_per_second": 3.96
   },
   {
    "i": 12,
    "start": 22.4,
    "end": 23.19,
    "text": "执行死刑",
    "chars_per_second": 5.06
   },
   {
    "i": 13,
    "start": 23.54,
    "end": 24.95,
    "text": "十一月二十一日",
    "chars_per_second": 4.96
   },
   {
    "i": 14,
    "start": 25.16,
    "end": 27.11,
    "text": "杨树明被执行死刑",
    "chars_per_second": 4.1
   },
   {
    "i": 15,
    "start": 27.46,
    "end": 29.15,
    "text": "十四年的系列案件",
    "chars_per_second": 4.73
   },
   {
    "i": 16,
    "start": 29.51,
    "end": 30.87,
    "text": "至此终结",
    "chars_per_second": 2.94
   }
  ]
 },
 "N06": {
  "duration": 26.91,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.95,
    "text": "案件终结",
    "chars_per_second": 5.0
   },
   {
    "i": 1,
    "start": 1.29,
    "end": 2.81,
    "text": "矿区的生活还要继续",
    "chars_per_second": 5.92
   },
   {
    "i": 2,
    "start": 3.15,
    "end": 4.2,
    "text": "可对家属来说",
    "chars_per_second": 5.71
   },
   {
    "i": 3,
    "start": 4.54,
    "end": 6.39,
    "text": "痛不会随判决消失",
    "chars_per_second": 4.32
   },
   {
    "i": 4,
    "start": 6.74,
    "end": 7.82,
    "text": "九名遇害女性",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 8.12,
    "end": 9.69,
    "text": "从十六岁到四十二岁",
    "chars_per_second": 5.73
   },
   {
    "i": 6,
    "start": 10.04,
    "end": 12.5,
    "text": "她们原本都有自己的生活和未来",
    "chars_per_second": 5.69
   },
   {
    "i": 7,
    "start": 12.84,
    "end": 15.44,
    "text": "侦查从来没有戏剧性的瞬间",
    "chars_per_second": 4.62
   },
   {
    "i": 8,
    "start": 15.79,
    "end": 17.41,
    "text": "它来自一遍遍的走访",
    "chars_per_second": 5.56
   },
   {
    "i": 9,
    "start": 17.75,
    "end": 18.06,
    "text": "档案",
    "chars_per_second": 6.45
   },
   {
    "i": 10,
    "start": 18.41,
    "end": 19.83,
    "text": "和对旧线索的不放弃",
    "chars_per_second": 6.34
   },
   {
    "i": 11,
    "start": 20.17,
    "end": 21.98,
    "text": "「红衣杀手」让人记住了案子",
    "chars_per_second": 6.08
   },
   {
    "i": 12,
    "start": 22.32,
    "end": 23.56,
    "text": "却不该盖住事实",
    "chars_per_second": 5.65
   },
   {
    "i": 13,
    "start": 23.91,
    "end": 25.25,
    "text": "受害者不是符号",
    "chars_per_second": 5.22
   },
   {
    "i": 14,
    "start": 25.62,
    "end": 26.91,
    "text": "是真实的人",
    "chars_per_second": 3.88
   }
  ]
 }
}