    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "1998年夏，和歌山园部，一场社区夏祭。",
      "sha256": "e83e580bd96fec31530338fa3e7faeb9ea796325e35b7d6a57ca5f24f83fd495",
      "voice_id": "voice-00",
