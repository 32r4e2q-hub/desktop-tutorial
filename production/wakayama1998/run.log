    "silent_fraction": 0.0111,
    "target_rms_dbfs": -20.0,
    "peak_ceiling_dbfs": -1.5,
    "bgm_under_voice_target_db": -18.0,
    "bgm_sidechain_makeup_db": 1.5,
    "bgm_under_voice_measured_db": -19.57,
    "bgm_silence_gain": 0.24,
    "sfx_level": 0.5,
    "narration": {
      "voice_id": "voice-00",
      "alignment": "one-clip-one-shot-one-caption",
      "slowdown_allowed": false,
      "max_speedup_factor": 1.55,
      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "1998年夏，和歌山园部，一场社区夏祭。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 5.027,
          "natural_clip_seconds": 4.76,
          "natural_speech_seconds": 4.65,
          "spoken_seconds": 4.65,
          "tempo_factor": 1.0,
          "speech_start": 0.03,
          "speech_end": 4.68,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "锅里的咖喱还冒着热气，四个人再也没能回家。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 4.36,
          "natural_clip_seconds": 4.24,
          "natural_speech_seconds": 4.19,
          "spoken_seconds": 4.19,
          "tempo_factor": 1.0,
          "speech_start": 5.03,
          "speech_end": 9.22,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "那天一早，园部的主妇们就在车库里架起这口大锅，说笑着煮了整整一天。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 6.827,
          "natural_clip_seconds": 6.53,
          "natural_speech_seconds": 6.42,
          "spoken_seconds": 6.42,
          "tempo_factor": 1.0,
          "speech_start": 10.03,
          "speech_end": 16.45,
          "characters": 30,
          "target_chars_per_second": 4.286
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "开饭的时候，主妇们一勺一勺把咖喱盛进餐盘，队伍一直排到街口。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 6.72,
          "natural_clip_seconds": 6.636,
          "natural_speech_seconds": 6.6,
          "spoken_seconds": 6.6,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 23.63,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "孩子挨着妈妈坐下，捧着自己的小盘子，一口一口吃得很香。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 6.27,
          "natural_clip_seconds": 6.247,
          "natural_speech_seconds": 6.19,
          "spoken_seconds": 5.83,
          "tempo_factor": 1.0613,
          "speech_start": 24.03,
          "speech_end": 29.86,
          "characters": 24,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "夕阳落下去，蝉声很响，没有人察觉任何异常。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 5.21,
          "natural_clip_seconds": 5.2,
          "natural_speech_seconds": 5.13,
          "spoken_seconds": 4.83,
          "tempo_factor": 1.0638,
          "speech_start": 30.03,
          "speech_end": 34.86,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "大人们围坐在折叠桌旁，慢慢吃着咖喱聊着家常，谁也没有在意。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 6.76,
          "natural_clip_seconds": 6.67,
          "natural_speech_seconds": 6.56,
          "spoken_seconds": 6.56,
          "tempo_factor": 1.0,
          "speech_start": 35.03,
          "speech_end": 41.59,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "没过多久，有人扶住额头慢慢蹲了下去；接着，一个，又一个。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 6.98,
          "natural_clip_seconds": 6.93,
          "natural_speech_seconds": 6.82,
          "spoken_seconds": 6.79,
          "tempo_factor": 1.0014,
          "speech_start": 42.03,
          "speech_end": 48.82,
          "characters": 23,
          "target_chars_per_second": 3.286
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "一辆接一辆的救护车挤进窄街，警灯在墙上不停打转。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.49,
          "natural_speech_seconds": 5.38,
          "spoken_seconds": 5.38,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 54.41,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "医生起初以为，这只是夏天常见的一次食物中毒。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.41,
          "natural_speech_seconds": 4.3,
          "spoken_seconds": 4.3,
          "tempo_factor": 1.0,
          "speech_start": 55.03,
          "speech_end": 59.33,
          "characters": 20,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "走廊里，母亲抱着孩子的小鞋；六十七人中毒，四个人再也没能回家。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 6.269,
          "natural_clip_seconds": 6.2,
          "natural_speech_seconds": 6.09,
          "spoken_seconds": 6.09,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 66.12,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "检验结果出来了：让所有人中毒的，是砒霜，也就是亚砷酸。",
          "start": 67.0,
          "duration": 7.0,
          "source_seconds": 6.58,
          "natural_clip_seconds": 6.56,
          "natural_speech_seconds": 6.45,
          "spoken_seconds": 6.45,
          "tempo_factor": 1.0,
          "speech_start": 67.03,
          "speech_end": 73.48,
          "characters": 23,
          "target_chars_per_second": 3.286
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "毒物查明了：这不是意外，是有人故意把毒放进了那锅咖喱里。",
          "start": 74.0,
          "duration": 6.0,
          "source_seconds": 5.503,
          "natural_clip_seconds": 5.32,
          "natural_speech_seconds": 5.21,
          "spoken_seconds": 5.21,
          "tempo_factor": 1.0,
          "speech_start": 74.03,
          "speech_end": 79.24,
          "characters": 25,
          "target_chars_per_second": 4.167
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "全城震惊。警方在那口锅四周拉起警戒线。",
          "start": 80.0,
          "duration": 5.0,
          "source_seconds": 4.43,
          "natural_clip_seconds": 4.408,
          "natural_speech_seconds": 4.32,
          "spoken_seconds": 4.32,
          "tempo_factor": 1.0,
          "speech_start": 80.03,
          "speech_end": 84.35,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "专案组围着板子推演：谁靠近过那口锅？谁有机会一个人留下？",
          "start": 85.0,
          "duration": 7.0,
          "source_seconds": 6.56,
          "natural_clip_seconds": 6.535,
          "natural_speech_seconds": 6.48,
          "spoken_seconds": 6.48,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 91.51,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "那天经过这条街、进过那间车库的每一张脸，全被重新排查一遍。",
          "start": 92.0,
          "duration": 7.0,
          "source_seconds": 6.432,
          "natural_clip_seconds": 6.2,
          "natural_speech_seconds": 6.09,
          "spoken_seconds": 6.09,
          "tempo_factor": 1.0,
          "speech_start": 92.03,
          "speech_end": 98.12,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "照片钉上墙，红线牵着名字：谁在什么时候站在锅边。",
          "start": 99.0,
          "duration": 6.0,
          "source_seconds": 5.457,
          "natural_clip_seconds": 5.23,
          "natural_speech_seconds": 5.12,
          "spoken_seconds": 5.12,
          "tempo_factor": 1.0,
          "speech_start": 99.03,
          "speech_end": 104.15,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "街坊低声议论的，是同一个名字：林真须美。",
          "start": 105.0,
          "duration": 5.0,
          "source_seconds": 5.16,
          "natural_clip_seconds": 5.159,
          "natural_speech_seconds": 5.08,
          "spoken_seconds": 4.82,
          "tempo_factor": 1.0552,
          "speech_start": 105.03,
          "speech_end": 109.85,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "那年她三十七岁；和丈夫健治做过保险推销、灭白蚁，都碰过砷。",
          "start": 110.0,
          "duration": 7.0,
          "source_seconds": 7.38,
          "natural_clip_seconds": 7.357,
          "natural_speech_seconds": 7.32,
          "spoken_seconds": 6.85,
          "tempo_factor": 1.0704,
          "speech_start": 110.03,
          "speech_end": 116.88,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "警方在她家搜出一包白色粉末，送检之后，是和锅里同样的砷。",
          "start": 117.0,
          "duration": 7.0,
          "source_seconds": 6.67,
          "natural_clip_seconds": 6.656,
          "natural_speech_seconds": 6.57,
          "spoken_seconds": 6.57,
          "tempo_factor": 1.0,
          "speech_start": 117.03,
          "speech_end": 123.6,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "案发之前那十年，夫妻俩多次靠保险诈骗，拿到过不少钱。",
          "start": 124.0,
          "duration": 6.0,
          "source_seconds": 5.99,
          "natural_clip_seconds": 5.98,
          "natural_speech_seconds": 5.9,
          "spoken_seconds": 5.81,
          "tempo_factor": 1.0169,
          "speech_start": 124.0,
          "speech_end": 129.81,
          "characters": 23,
          "target_chars_per_second": 3.833
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "检方说：家里的砷和锅里的砷，成分相同。",
          "start": 130.0,
          "duration": 5.0,
          "source_seconds": 4.26,
          "natural_clip_seconds": 4.239,
          "natural_speech_seconds": 4.19,
          "spoken_seconds": 4.19,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 134.22,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "记者把她家门口围住；她抓起水管朝镜头猛喷，水花溅在镜片上。",
          "start": 135.0,
          "duration": 7.0,
          "source_seconds": 6.29,
          "natural_clip_seconds": 6.287,
          "natural_speech_seconds": 6.24,
          "spoken_seconds": 6.24,
          "tempo_factor": 1.0,
          "speech_start": 135.02,
          "speech_end": 141.26,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "这一幕当晚传遍全国。很多人看完那段画面，心里已经先给她定了罪。",
          "start": 142.0,
          "duration": 7.0,
          "source_seconds": 6.432,
          "natural_clip_seconds": 6.15,
          "natural_speech_seconds": 6.04,
          "spoken_seconds": 6.04,
          "tempo_factor": 1.0,
          "speech_start": 142.03,
          "speech_end": 148.07,
          "characters": 28,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "同年十二月，她因这锅咖喱被捕。她只说：我没有做。",
          "start": 149.0,
          "duration": 6.0,
          "source_seconds": 5.4,
          "natural_clip_seconds": 5.13,
          "natural_speech_seconds": 5.02,
          "spoken_seconds": 5.02,
          "tempo_factor": 1.0,
          "speech_start": 149.03,
          "speech_end": 154.05,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "2002年12月，和歌山地方法院一审宣判，判处她死刑。",
          "start": 155.0,
          "duration": 6.0,
          "source_seconds": 5.865,
          "natural_clip_seconds": 5.82,
          "natural_speech_seconds": 5.73,
          "spoken_seconds": 5.73,
          "tempo_factor": 1.0,
          "speech_start": 155.01,
          "speech_end": 160.74,
          "characters": 24,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "没有动机，也没有直接证据；法院靠的，只有鉴定和证词。",
          "start": 161.0,
          "duration": 6.0,
          "source_seconds": 6.35,
          "natural_clip_seconds": 6.347,
          "natural_speech_seconds": 6.31,
          "spoken_seconds": 5.86,
          "tempo_factor": 1.0777,
          "speech_start": 161.03,
          "speech_end": 166.89,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "2009年，最高法院维持死刑；辩方质疑证据。",
          "start": 167.0,
          "duration": 5.0,
          "source_seconds": 5.06,
          "natural_clip_seconds": 5.051,
          "natural_speech_seconds": 5.01,
          "spoken_seconds": 4.85,
          "tempo_factor": 1.0341,
          "speech_start": 167.03,
          "speech_end": 171.88,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "她至今在狱中喊冤，第三度再审仍在审理。你觉得，凶手是她吗？",
          "start": 172.0,
          "duration": 8.0,
          "source_seconds": 6.734,
          "natural_clip_seconds": 6.47,
          "natural_speech_seconds": 6.36,
          "spoken_seconds": 6.36,
          "tempo_factor": 1.0,
          "speech_start": 172.03,
          "speech_end": 178.39,
          "characters": 25,
          "target_chars_per_second": 3.125
        }
      ],
