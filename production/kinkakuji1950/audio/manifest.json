    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "它在这里站了五百多年，美得让人不敢呼吸。",
      "sha256": "8cfd5e858a324be8744a144d575f8ca1eb892ec5f3a8a5dd8815e9da870afff7",
      "voice_id": "voice-02",
