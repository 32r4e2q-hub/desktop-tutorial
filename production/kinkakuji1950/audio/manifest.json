      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "凌晨三点，窗口亮起一点火，接着，整座楼阁烧了起来。",
      "sha256": "79bfa4e4a94a6eb9e3d44a1459a2f8aa8bfe46a5c4e0dc35703dcd9e8644b93b",
      "voice_id": "voice-02",
