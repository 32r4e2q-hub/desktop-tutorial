    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "镜湖池里，燃烧的金阁倒映在水中，像另一片星空。",
      "sha256": "5c12e92a0f73084955e1ae7522e7fdcf0ecb5c316970e1a9b70489389e19c9e2",
