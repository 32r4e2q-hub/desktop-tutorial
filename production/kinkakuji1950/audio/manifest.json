      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "金阁里面，佛像静静坐着，烛火轻轻摇晃。",
      "sha256": "785091dc0f1a853a0645a93e96db29969d63bae07a5b625d1b8607439f2f3e75",
