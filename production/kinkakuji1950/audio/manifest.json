      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "1950年12月，京都地方法院判他七年。",
      "sha256": "69a54850f8fc6ac2c3812e852a7f9dd48136eadae4ee22a4c40756346ae818ad",
      "voice_id": "voice-02",
      "voice_description": "低沉悬疑男声；语速沉稳、句尾收得轻，像真实犯罪纪录片",
