{
 "N01": {
  "duration": 24.12,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.07,
    "text": "一九九〇年五月二十三日",
    "chars_per_second": 5.21
   },
   {
    "i": 1,
    "start": 2.42,
    "end": 3.93,
    "text": "奥地利一家监狱的门口",
    "chars_per_second": 6.62
   },
   {
    "i": 2,
    "start": 4.28,
    "end": 6.01,
    "text": "记者们等了整整一上午",
    "chars_per_second": 5.78
   },
   {
    "i": 3,
    "start": 6.36,
    "end": 7.61,
    "text": "他们等的不是政客",
    "chars_per_second": 6.4
   },
   {
    "i": 4,
    "start": 7.95,
    "end": 9.62,
    "text": "是一个刚出狱的杀人犯",
    "chars_per_second": 5.99
   },
   {
    "i": 5,
    "start": 9.97,
    "end": 11.28,
    "text": "杰克·翁特维格",
    "chars_per_second": 4.58
   },
   {
    "i": 6,
    "start": 11.63,
    "end": 12.27,
    "text": "三十九岁",
    "chars_per_second": 6.25
   },
   {
    "i": 7,
    "start": 12.62,
    "end": 13.63,
    "text": "服刑满十五年",
    "chars_per_second": 5.94
   },
   {
    "i": 8,
    "start": 13.96,
    "end": 14.84,
    "text": "今天被假释",
    "chars_per_second": 5.68
   },
   {
    "i": 9,
    "start": 15.19,
    "end": 15.59,
    "text": "出书",
    "chars_per_second": 5.0
   },
   {
    "i": 10,
    "start": 15.86,
    "end": 16.41,
    "text": "写剧本",
    "chars_per_second": 5.45
   },
   {
    "i": 11,
    "start": 16.65,
    "end": 17.16,
    "text": "上电视",
    "chars_per_second": 5.88
   },
   {
    "i": 12,
    "start": 17.5,
    "end": 19.2,
    "text": "很多人把他当成一个奇迹",
    "chars_per_second": 6.47
   },
   {
    "i": 13,
    "start": 19.55,
    "end": 20.06,
    "text": "三年后",
    "chars_per_second": 5.88
   },
   {
    "i": 14,
    "start": 20.41,
    "end": 21.49,
    "text": "警方给出的答案",
    "chars_per_second": 6.48
   },
   {
    "i": 15,
    "start": 21.81,
    "end": 24.12,
    "text": "让整个奥地利都沉默了",
    "chars_per_second": 4.33
   }
  ]
 },
 "N02": {
  "duration": 23.235,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.33,
    "text": "时间倒回一九七四年十二月",
    "chars_per_second": 5.5
   },
   {
    "i": 1,
    "start": 2.67,
    "end": 5.38,
    "text": "十八岁的玛格丽特·舍费尔在夜里失踪",
    "chars_per_second": 5.9
   },
   {
    "i": 2,
    "start": 5.72,
    "end": 8.46,
    "text": "警方很快锁定了一个二十四岁的年轻人",
    "chars_per_second": 6.2
   },
   {
    "i": 3,
    "start": 8.81,
    "end": 10.66,
    "text": "他之前十六次进出监狱",
    "chars_per_second": 5.41
   },
   {
    "i": 4,
    "start": 11.0,
    "end": 12.89,
    "text": "罪名大多是盗窃和性侵",
    "chars_per_second": 5.29
   },
   {
    "i": 5,
    "start": 13.23,
    "end": 14.37,
    "text": "一九七六年六月",
    "chars_per_second": 6.14
   },
   {
    "i": 6,
    "start": 14.71,
    "end": 17.27,
    "text": "他因这起谋杀被判处终身监禁",
    "chars_per_second": 5.08
   },
   {
    "i": 7,
    "start": 17.61,
    "end": 18.56,
    "text": "所有人都以为",
    "chars_per_second": 6.32
   },
   {
    "i": 8,
    "start": 18.78,
    "end": 20.7,
    "text": "他的人生会在监狱里结束",
    "chars_per_second": 5.73
   },
   {
    "i": 9,
    "start": 21.04,
    "end": 23.23,
    "text": "但他在牢房里拿起了笔",
    "chars_per_second": 4.56
   }
  ]
 },
 "N03": {
  "duration": 27.37,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.47,
    "text": "他在狱中写诗",
    "chars_per_second": 4.51
   },
   {
    "i": 1,
    "start": 1.71,
    "end": 2.37,
    "text": "写小说",
    "chars_per_second": 4.55
   },
   {
    "i": 2,
    "start": 2.66,
    "end": 3.3,
    "text": "写剧本",
    "chars_per_second": 4.69
   },
   {
    "i": 3,
    "start": 3.64,
    "end": 5.6,
    "text": "还写了一本自传《炼狱》",
    "chars_per_second": 4.59
   },
   {
    "i": 4,
    "start": 5.95,
    "end": 6.73,
    "text": "书出版了",
    "chars_per_second": 5.13
   },
   {
    "i": 5,
    "start": 7.04,
    "end": 8.75,
    "text": "甚至有学校把它当教材",
    "chars_per_second": 5.85
   },
   {
    "i": 6,
    "start": 9.09,
    "end": 9.56,
    "text": "作家",
    "chars_per_second": 4.26
   },
   {
    "i": 7,
    "start": 9.82,
    "end": 10.47,
    "text": "艺术家",
    "chars_per_second": 4.62
   },
   {
    "i": 8,
    "start": 10.82,
    "end": 13.73,
    "text": "诺贝尔文学奖得主联名替他请愿",
    "chars_per_second": 4.81
   },
   {
    "i": 9,
    "start": 14.07,
    "end": 16.67,
    "text": "一个能把自己的罪行写成文学的人",
    "chars_per_second": 5.77
   },
   {
    "i": 10,
    "start": 17.02,
    "end": 18.26,
    "text": "应该是真的悔改了",
    "chars_per_second": 6.45
   },
   {
    "i": 11,
    "start": 18.61,
    "end": 19.78,
    "text": "一九九〇年五月",
    "chars_per_second": 5.13
   },
   {
    "i": 12,
    "start": 20.12,
    "end": 20.94,
    "text": "他走出监狱",
    "chars_per_second": 6.1
   },
   {
    "i": 13,
    "start": 21.29,
    "end": 22.31,
    "text": "没有附加条件",
    "chars_per_second": 5.88
   },
   {
    "i": 14,
    "start": 22.65,
    "end": 24.38,
    "text": "但就在那之后的五个月里",
    "chars_per_second": 6.36
   },
   {
    "i": 15,
    "start": 24.73,
    "end": 27.37,
    "text": "维也纳的夜里开始有人失踪",
    "chars_per_second": 4.55
   }
  ]
 },
 "N04": {
  "duration": 29.35,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.75,
    "text": "一九九〇年十月起",
    "chars_per_second": 4.35
   },
   {
    "i": 1,
    "start": 2.1,
    "end": 5.28,
    "text": "维也纳和格拉茨的性工作者接连消失",
    "chars_per_second": 5.03
   },
   {
    "i": 2,
    "start": 5.63,
    "end": 7.33,
    "text": "遗体被弃在城外林地",
    "chars_per_second": 5.29
   },
   {
    "i": 3,
    "start": 7.68,
    "end": 8.43,
    "text": "至少七个人",
    "chars_per_second": 6.67
   },
   {
    "i": 4,
    "start": 8.77,
    "end": 9.71,
    "text": "警方查了很久",
    "chars_per_second": 6.38
   },
   {
    "i": 5,
    "start": 10.06,
    "end": 10.93,
    "text": "没能找到凶手",
    "chars_per_second": 6.9
   },
   {
    "i": 6,
    "start": 11.28,
    "end": 12.37,
    "text": "一九九一年六月",
    "chars_per_second": 6.42
   },
   {
    "i": 7,
    "start": 12.72,
    "end": 16.23,
    "text": "这名作家受奥地利一家杂志委托飞到洛杉矶",
    "chars_per_second": 5.41
   },
   {
    "i": 8,
    "start": 16.58,
    "end": 18.06,
    "text": "写红灯区系列报道",
    "chars_per_second": 5.41
   },
   {
    "i": 9,
    "start": 18.4,
    "end": 19.18,
    "text": "更离奇的是",
    "chars_per_second": 6.41
   },
   {
    "i": 10,
    "start": 19.53,
    "end": 21.15,
    "text": "他跟着洛杉矶警方出勤",
    "chars_per_second": 6.17
   },
   {
    "i": 11,
    "start": 21.49,
    "end": 23.46,
    "text": "坐在警车里看警方查案",
    "chars_per_second": 5.08
   },
   {
    "i": 12,
    "start": 23.81,
    "end": 24.89,
    "text": "他停留的这几周里",
    "chars_per_second": 7.41
   },
   {
    "i": 13,
    "start": 25.23,
    "end": 29.35,
    "text": "洛杉矶也有三名女性以几乎相同的方式死去",
    "chars_per_second": 4.61
   }
  ]
 },
 "N05": {
  "duration": 24.305,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.8,
    "text": "格拉茨的刑警盯上了他",
    "chars_per_second": 6.02
   },
   {
    "i": 1,
    "start": 2.14,
    "end": 3.55,
    "text": "证据却总差一截",
    "chars_per_second": 4.96
   },
   {
    "i": 2,
    "start": 3.9,
    "end": 4.98,
    "text": "洛杉矶查的案子",
    "chars_per_second": 6.48
   },
   {
    "i": 3,
    "start": 5.33,
    "end": 7.39,
    "text": "手法和奥地利如出一辙",
    "chars_per_second": 4.85
   },
   {
    "i": 4,
    "start": 7.74,
    "end": 9.59,
    "text": "两地警方把资料并在一起",
    "chars_per_second": 5.95
   },
   {
    "i": 5,
    "start": 9.94,
    "end": 12.09,
    "text": "勒具来自被害人自己的衣物",
    "chars_per_second": 5.58
   },
   {
    "i": 6,
    "start": 12.44,
    "end": 13.21,
    "text": "弃尸环境",
    "chars_per_second": 5.19
   },
   {
    "i": 7,
    "start": 13.4,
    "end": 13.8,
    "text": "手法",
    "chars_per_second": 5.0
   },
   {
    "i": 8,
    "start": 13.99,
    "end": 15.32,
    "text": "时间线都能对上",
    "chars_per_second": 5.26
   },
   {
    "i": 9,
    "start": 15.66,
    "end": 16.74,
    "text": "一九九二年二月",
    "chars_per_second": 6.48
   },
   {
    "i": 10,
    "start": 17.08,
    "end": 18.08,
    "text": "逮捕令发出时",
    "chars_per_second": 6.0
   },
   {
    "i": 11,
    "start": 18.35,
    "end": 20.22,
    "text": "他已经带着女友离开奥地利",
    "chars_per_second": 6.42
   },
   {
    "i": 12,
    "start": 20.46,
    "end": 21.44,
    "text": "一路到了美国",
    "chars_per_second": 6.12
   },
   {
    "i": 13,
    "start": 21.79,
    "end": 22.65,
    "text": "二月二十七日",
    "chars_per_second": 6.98
   },
   {
    "i": 14,
    "start": 22.96,
    "end": 24.3,
    "text": "他在迈阿密被捕",
    "chars_per_second": 5.2
   }
  ]
 },
 "N06": {
  "duration": 26.92,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.19,
    "text": "一九九四年",
    "chars_per_second": 4.76
   },
   {
    "i": 1,
    "start": 1.53,
    "end": 2.12,
    "text": "格拉茨",
    "chars_per_second": 5.08
   },
   {
    "i": 2,
    "start": 2.47,
    "end": 3.64,
    "text": "经过两个月审理",
    "chars_per_second": 5.98
   },
   {
    "i": 3,
    "start": 4.01,
    "end": 7.96,
    "text": "陪审团以六比二认定他九项谋杀罪成立",
    "chars_per_second": 4.3
   },
   {
    "i": 4,
    "start": 8.31,
    "end": 9.55,
    "text": "判处终身监禁",
    "chars_per_second": 4.84
   },
   {
    "i": 5,
    "start": 9.89,
    "end": 10.59,
    "text": "不得假释",
    "chars_per_second": 5.71
   },
   {
    "i": 6,
    "start": 10.93,
    "end": 11.7,
    "text": "审判当夜",
    "chars_per_second": 5.19
   },
   {
    "i": 7,
    "start": 12.05,
    "end": 14.21,
    "text": "他在牢房里结束了自己的生命",
    "chars_per_second": 6.02
   },
   {
    "i": 8,
    "start": 14.55,
    "end": 16.14,
    "text": "他在书里写自己的罪",
    "chars_per_second": 5.66
   },
   {
    "i": 9,
    "start": 16.48,
    "end": 18.27,
    "text": "又用书洗白自己的罪",
    "chars_per_second": 5.03
   },
   {
    "i": 10,
    "start": 18.63,
    "end": 19.98,
    "text": "他让整个社会相信",
    "chars_per_second": 5.93
   },
   {
    "i": 11,
    "start": 20.33,
    "end": 22.62,
    "text": "一个人可以被改造成另一个人",
    "chars_per_second": 5.68
   },
   {
    "i": 12,
    "start": 22.98,
    "end": 24.61,
    "text": "如果那场改变是真的",
    "chars_per_second": 5.52
   },
   {
    "i": 13,
    "start": 24.97,
    "end": 26.92,
    "text": "他为什么还要再杀人",
    "chars_per_second": 4.62
   }
  ]
 }
}