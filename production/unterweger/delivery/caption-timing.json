[
  {
    "start": 0.6649066323245332,
    "end": 3.0015453960077267,
    "text": "一九九〇年五月二十三日，"
  },
  {
    "start": 3.1205408886027044,
    "end": 5.013650998068255,
    "text": "奥地利一家监狱的门口，"
  },
  {
    "start": 5.132646490663232,
    "end": 7.263747585318737,
    "text": "记者们等了整整一上午。"
  },
  {
    "start": 7.382743077913715,
    "end": 8.994591113972955,
    "text": "他们等的不是政客，"
  },
  {
    "start": 9.102768834513844,
    "end": 11.168963296844815,
    "text": "是一个刚出狱的杀人犯："
  },
  {
    "start": 11.287958789439793,
    "end": 12.964713457823565,
    "text": "杰克·翁特维格，"
  },
  {
    "start": 13.083708950418545,
    "end": 14.035672891178363,
    "text": "三十九岁，"
  },
  {
    "start": 14.15466838377334,
    "end": 15.506889890534449,
    "text": "服刑满十五年，"
  },
  {
    "start": 15.604249839021248,
    "end": 16.815840309079203,
    "text": "今天被假释。"
  },
  {
    "start": 16.93483580167418,
    "end": 17.627173213135865,
    "text": "出书、"
  },
  {
    "start": 17.659626529298134,
    "end": 18.51423052157115,
    "text": "写剧本、"
  },
  {
    "start": 18.51423052157115,
    "end": 19.325563425627816,
    "text": "上电视，"
  },
  {
    "start": 19.433741146168707,
    "end": 21.532388924661944,
    "text": "很多人把他当成一个奇迹。"
  },
  {
    "start": 21.651384417256924,
    "end": 22.462717321313583,
    "text": "三年后，"
  },
  {
    "start": 22.581712813908563,
    "end": 24.00965872504829,
    "text": "警方给出的答案，"
  },
  {
    "start": 24.096200901481005,
    "end": 26.692466194462334,
    "text": "让整个奥地利都沉默了。"
  },
  {
    "start": 28.23763039278815,
    "end": 30.44445589182228,
    "text": "时间倒回一九七四年十二月。"
  },
  {
    "start": 30.44445589182228,
    "end": 33.733058596265295,
    "text": "十八岁的玛格丽特·舍费尔在夜里失踪，"
  },
  {
    "start": 33.92777849323889,
    "end": 37.08656793303284,
    "text": "警方很快锁定了一个二十四岁的年轻人："
  },
  {
    "start": 37.151474565357375,
    "end": 39.444842240824215,
    "text": "他之前十六次进出监狱，"
  },
  {
    "start": 39.66119768190599,
    "end": 41.82475209272376,
    "text": "罪名大多是盗窃和性侵。"
  },
  {
    "start": 41.93292981326465,
    "end": 43.46905344494527,
    "text": "一九七六年六月，"
  },
  {
    "start": 43.64213779781069,
    "end": 46.58457179652285,
    "text": "他因这起谋杀被判处终身监禁。"
  },
  {
    "start": 46.67111397295557,
    "end": 48.01251770766258,
    "text": "所有人都以为，"
  },
  {
    "start": 48.120695428203476,
    "end": 50.3275209272376,
    "text": "他的人生会在监狱里结束。"
  },
  {
    "start": 50.3275209272376,
    "end": 52.837244043786214,
    "text": "但他在牢房里拿起了笔。"
  },
  {
    "start": 54.041648422408244,
    "end": 55.740038634900195,
    "text": "他在狱中写诗、"
  },
  {
    "start": 55.740038634900195,
    "end": 56.71363811976819,
    "text": "写小说、"
  },
  {
    "start": 56.76772698003863,
    "end": 57.719690920798456,
    "text": "写剧本，"
  },
  {
    "start": 57.82786864133934,
    "end": 60.20777849323889,
    "text": "还写了一本自传《炼狱》。"
  },
  {
    "start": 60.32677398583387,
    "end": 61.43018673535093,
    "text": "书出版了，"
  },
  {
    "start": 61.505911139729555,
    "end": 63.61537669027688,
    "text": "甚至有学校把它当教材。"
  },
  {
    "start": 63.72355441081777,
    "end": 64.49161622665808,
    "text": "作家、"
  },
  {
    "start": 64.51325177076626,
    "end": 65.47603348358017,
    "text": "艺术家、"
  },
  {
    "start": 65.59502897617514,
    "end": 69.00262717321314,
    "text": "诺贝尔文学奖得主联名替他请愿："
  },
  {
    "start": 69.11080489375402,
    "end": 72.18305215711526,
    "text": "一个能把自己的罪行写成文学的人，"
  },
  {
    "start": 72.30204764971023,
    "end": 73.90307791371539,
    "text": "应该是真的悔改了。"
  },
  {
    "start": 74.02207340631037,
    "end": 75.5473792659369,
    "text": "一九九〇年五月，"
  },
  {
    "start": 75.65555698647779,
    "end": 76.8022408242112,
    "text": "他走出监狱，"
  },
  {
    "start": 76.92123631680619,
    "end": 78.28427559562138,
    "text": "没有附加条件。"
  },
  {
    "start": 78.39245331616226,
    "end": 80.52355441081777,
    "text": "但就在那之后的五个月里，"
  },
  {
    "start": 80.64254990341274,
    "end": 83.595801674179,
    "text": "维也纳的夜里开始有人失踪。"
  },
  {
    "start": 84.67580167417901,
    "end": 86.7203605924018,
    "text": "一九九〇年十月起，"
  },
  {
    "start": 86.95835157759176,
    "end": 90.52821635544109,
    "text": "维也纳和格拉茨的性工作者接连消失，"
  },
  {
    "start": 90.83111397295558,
    "end": 92.75667739858339,
    "text": "遗体被弃在城外林地，"
  },
  {
    "start": 92.95139729555699,
    "end": 94.05481004507405,
    "text": "至少七个人。"
  },
  {
    "start": 94.07644558918223,
    "end": 95.3745782356729,
    "text": "警方查了很久，"
  },
  {
    "start": 95.48275595621378,
    "end": 96.65107533805538,
    "text": "没能找到凶手。"
  },
  {
    "start": 96.69434642627174,
    "end": 98.25210560206054,
    "text": "一九九一年六月，"
  },
  {
    "start": 98.33864777849324,
    "end": 102.34122343850612,
    "text": "这名作家受奥地利一家杂志委托飞到洛杉矶，"
  },
  {
    "start": 102.53594333547971,
    "end": 104.396600128783,
    "text": "写红灯区系列报道。"
  },
  {
    "start": 104.50477784932389,
    "end": 105.58655505473277,
    "text": "更离奇的是，"
  },
  {
    "start": 105.7596394075982,
    "end": 107.64193174500966,
    "text": "他跟着洛杉矶警方出勤，"
  },
  {
    "start": 107.83665164198327,
    "end": 110.28146812620734,
    "text": "坐在警车里看警方查案。"
  },
  {
    "start": 110.34637475853188,
    "end": 111.79595621377979,
    "text": "他停留的这几周里，"
  },
  {
    "start": 111.92576947842885,
    "end": 116.33942047649711,
    "text": "洛杉矶也有三名女性以几乎相同的方式死去。"
  },
  {
    "start": 117.50596265292981,
    "end": 119.63706374758532,
    "text": "格拉茨的刑警盯上了他，"
  },
  {
    "start": 119.78851255634255,
    "end": 121.47608499678041,
    "text": "证据却总差一截；"
  },
  {
    "start": 121.62753380553767,
    "end": 123.12038634900193,
    "text": "洛杉矶查的案子，"
  },
  {
    "start": 123.20692852543463,
    "end": 125.58683837733419,
    "text": "手法和奥地利如出一辙。"
  },
  {
    "start": 125.65174500965873,
    "end": 128.03165486155828,
    "text": "两地警方把资料并在一起："
  },
  {
    "start": 128.16146812620732,
    "end": 130.75773341918867,
    "text": "勒具来自被害人自己的衣物，"
  },
  {
    "start": 130.84427559562138,
    "end": 131.94768834513843,
    "text": "弃尸环境、"
  },
  {
    "start": 131.96932388924662,
    "end": 132.64002575660012,
    "text": "手法、"
  },
  {
    "start": 132.64002575660012,
    "end": 134.24105602060527,
    "text": "时间线都能对上。"
  },
  {
    "start": 134.3059626529298,
    "end": 135.7771796522859,
    "text": "一九九二年二月，"
  },
  {
    "start": 135.8637218287186,
    "end": 137.2267611075338,
    "text": "逮捕令发出时，"
  },
  {
    "start": 137.27003219575016,
    "end": 139.52012878300064,
    "text": "他已经带着女友离开奥地利，"
  },
  {
    "start": 139.5417643271088,
    "end": 140.81826142949132,
    "text": "一路到了美国。"
  },
  {
    "start": 140.904803605924,
    "end": 142.1813007083065,
    "text": "二月二十七日，"
  },
  {
    "start": 142.20293625241467,
    "end": 143.69578879587894,
    "text": "他在迈阿密被捕。"
  },
  {
    "start": 144.93264649066322,
    "end": 146.3281390856407,
    "text": "一九九四年，"
  },
  {
    "start": 146.43631680618157,
    "end": 147.33419188667094,
    "text": "格拉茨。"
  },
  {
    "start": 147.45318737926593,
    "end": 148.97849323889244,
    "text": "经过两个月审理，"
  },
  {
    "start": 149.1191242755956,
    "end": 153.65177076625884,
    "text": "陪审团以六比二认定他九项谋杀罪成立，"
  },
  {
    "start": 153.77076625885383,
    "end": 155.37179652285897,
    "text": "判处终身监禁、"
  },
  {
    "start": 155.47997424339985,
    "end": 156.4968448164842,
    "text": "不得假释。"
  },
  {
    "start": 156.6050225370251,
    "end": 157.6976175144881,
    "text": "审判当夜，"
  },
  {
    "start": 157.81661300708305,
    "end": 160.4128783000644,
    "text": "他在牢房里结束了自己的生命。"
  },
  {
    "start": 160.52105602060527,
    "end": 162.50070830650353,
    "text": "他在书里写自己的罪，"
  },
  {
    "start": 162.60888602704443,
    "end": 164.80489375402445,
    "text": "又用书洗白自己的罪；"
  },
  {
    "start": 164.93470701867352,
    "end": 166.65473277527366,
    "text": "他让整个社会相信，"
  },
  {
    "start": 166.77372826786862,
    "end": 169.51062459755312,
    "text": "一个人可以被改造成另一个人。"
  },
  {
    "start": 169.6404378622022,
    "end": 171.6633612363168,
    "text": "如果那场改变是真的，"
  },
  {
    "start": 171.79317450096585,
    "end": 174.0,
    "text": "他为什么还要再杀人？"
  }
]