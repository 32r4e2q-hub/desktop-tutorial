[
  {
    "start": 0.6,
    "end": 3.406256602192035,
    "text": "一九七八年到一九九六年，"
  },
  {
    "start": 3.406256602192035,
    "end": 7.107261686242399,
    "text": "联邦调查局经历了持续时间最长、"
  },
  {
    "start": 7.107261686242399,
    "end": 9.893183095664927,
    "text": "代价最高昂的追捕之一。"
  },
  {
    "start": 9.893183095664927,
    "end": 12.292735842466811,
    "text": "凶手不是街头暴徒，"
  },
  {
    "start": 12.292735842466811,
    "end": 16.746143058988956,
    "text": "而是智商高达一百六十七的哈佛数学"
  },
  {
    "start": 16.746143058988956,
    "end": 17.173182107148612,
    "text": "天才："
  },
  {
    "start": 17.173182107148612,
    "end": 19.369382926255422,
    "text": "西奥多·卡钦斯基。"
  },
  {
    "start": 19.369382926255422,
    "end": 22.684019347685144,
    "text": "他隐居蒙大拿林间的简陋木屋，"
  },
  {
    "start": 22.684019347685144,
    "end": 27.157761756976793,
    "text": "把精心制作的邮包寄向全美大学与航"
  },
  {
    "start": 27.157761756976793,
    "end": 27.58480080513645,
    "text": "空业。"
  },
  {
    "start": 27.58480080513645,
    "end": 30.440454979764414,
    "text": "科技界开始闻风丧胆。"
  },
  {
    "start": 31.520454979764416,
    "end": 32.557549811009295,
    "text": "十七年间，"
  },
  {
    "start": 32.557549811009295,
    "end": 36.86861067814489,
    "text": "他寄出或亲手放置了十六枚装置，"
  },
  {
    "start": 36.86861067814489,
    "end": 37.702353581694695,
    "text": "三人死亡，"
  },
  {
    "start": 37.702353581694695,
    "end": 40.24425267788313,
    "text": "近二十二人受伤。"
  },
  {
    "start": 40.24425267788313,
    "end": 44.107939304089555,
    "text": "联邦调查局联合烟酒枪械管理局与邮"
  },
  {
    "start": 44.107939304089555,
    "end": 46.03978261719277,
    "text": "政稽查组成专案组，"
  },
  {
    "start": 46.03978261719277,
    "end": 47.89028515921795,
    "text": "代号尤纳炸弹，"
  },
  {
    "start": 47.89028515921795,
    "end": 50.391513869867374,
    "text": "专指大学与航空目标。"
  },
  {
    "start": 50.391513869867374,
    "end": 53.38078720698498,
    "text": "装置用随处可寻的废料制成，"
  },
  {
    "start": 53.38078720698498,
    "end": 54.96693224300656,
    "text": "几乎不留痕迹。"
  },
  {
    "start": 54.96693224300656,
    "end": 58.50525578490087,
    "text": "名单甚至来自图书馆的随机检索。"
  },
  {
    "start": 58.50525578490087,
    "end": 61.63687547140502,
    "text": "专案组一度扩充到一百五十人，"
  },
  {
    "start": 61.63687547140502,
    "end": 63.356110107604536,
    "text": "仍找不到他。"
  },
  {
    "start": 64.43611010760455,
    "end": 65.59521609546647,
    "text": "一九九五年，"
  },
  {
    "start": 65.59521609546647,
    "end": 68.46247827596703,
    "text": "他寄出约三万五千字的长文，"
  },
  {
    "start": 68.46247827596703,
    "end": 70.84169582999941,
    "text": "要世人正视他的主张："
  },
  {
    "start": 70.84169582999941,
    "end": 73.62761723942194,
    "text": "工业科技正在毁灭人类。"
  },
  {
    "start": 73.62761723942194,
    "end": 75.4171142031386,
    "text": "经过激烈争论，"
  },
  {
    "start": 75.4171142031386,
    "end": 79.36214160042306,
    "text": "联邦调查局局长与司法部长同意发表，"
  },
  {
    "start": 79.36214160042306,
    "end": 82.65644282908326,
    "text": "希望有读者能认出作者。"
  },
  {
    "start": 82.65644282908326,
    "end": 84.26292305787436,
    "text": "《华盛顿邮报》刊出后，"
  },
  {
    "start": 84.26292305787436,
    "end": 85.88973847943495,
    "text": "线索如潮水涌来。"
  },
  {
    "start": 85.88973847943495,
    "end": 87.69957063592113,
    "text": "真正打开缺口的，"
  },
  {
    "start": 87.69957063592113,
    "end": 89.41986439674406,
    "text": "不是新的物证。"
  },
  {
    "start": 90.49986439674406,
    "end": 94.87193084218816,
    "text": "他的弟弟戴维提供了哥哥的书信与文稿。"
  },
  {
    "start": 94.87193084218816,
    "end": 96.5800870348268,
    "text": "语言分析认定："
  },
  {
    "start": 96.5800870348268,
    "end": 97.6781874443802,
    "text": "那些私信，"
  },
  {
    "start": 97.6781874443802,
    "end": 100.68779597426732,
    "text": "与宣言几乎出自同一人。"
  },
  {
    "start": 100.68779597426732,
    "end": 102.92466717891314,
    "text": "再叠上芝加哥成长、"
  },
  {
    "start": 102.92466717891314,
    "end": 104.28712509447014,
    "text": "伯克利任教、"
  },
  {
    "start": 104.28712509447014,
    "end": 105.77159416664419,
    "text": "盐湖城停留、"
  },
  {
    "start": 105.77159416664419,
    "end": 109.94030868439323,
    "text": "最终隐居蒙大拿——搜查令的事实基础，"
  },
  {
    "start": 109.94030868439323,
    "end": 111.64846487703186,
    "text": "第一次被写实。"
  },
  {
    "start": 111.64846487703186,
    "end": 114.19036397322029,
    "text": "高科技追踪十七年无果，"
  },
  {
    "start": 114.19036397322029,
    "end": 116.23784251270762,
    "text": "破局靠的是文风。"
  },
  {
    "start": 117.31784251270761,
    "end": 119.52421092819918,
    "text": "一九九六年四月三日，"
  },
  {
    "start": 119.76823324143326,
    "end": 124.03862372302984,
    "text": "调查人员在林肯镇附近十英尺乘十四"
  },
  {
    "start": 124.03862372302984,
    "end": 125.72644472289896,
    "text": "英尺的木屋里逮捕了他。"
  },
  {
    "start": 125.90946145782453,
    "end": 127.63795284323267,
    "text": "屋内有大量零件、"
  },
  {
    "start": 127.88197515646677,
    "end": 129.59013134910538,
    "text": "四万页手写笔记，"
  },
  {
    "start": 130.07817597557357,
    "end": 132.45739352960595,
    "text": "以及一枚已准备寄出的装置。"
  },
  {
    "start": 132.76242142114856,
    "end": 135.14163897518094,
    "text": "持续十七年的恐慌结束了。"
  },
  {
    "start": 135.34499090287602,
    "end": 136.4430913124294,
    "text": "破案的关键，"
  },
  {
    "start": 136.9311359388976,
    "end": 140.42878909525288,
    "text": "是亲弟弟从字里行间认出独特文风，"
  },
  {
    "start": 140.87616333618206,
    "end": 142.25895644450856,
    "text": "选择大义灭亲。"
  },
  {
    "start": 143.6314231180175,
    "end": 145.28874132873236,
    "text": "一九九八年一月，"
  },
  {
    "start": 145.55309883473595,
    "end": 146.2241601961297,
    "text": "他认罪。"
  },
  {
    "start": 146.42751212382478,
    "end": 150.45388029218725,
    "text": "此后在科罗拉多超级监狱度过余生。"
  },
  {
    "start": 150.94192491865545,
    "end": 153.91086306300355,
    "text": "联邦调查局称他为终极独狼。"
  },
  {
    "start": 154.25656134008517,
    "end": 156.63577889411755,
    "text": "十七年间最昂贵的追捕，"
  },
  {
    "start": 157.10348832781622,
    "end": 160.03175608662528,
    "text": "最后不是靠卫星或数据库，"
  },
  {
    "start": 160.45879513478496,
    "end": 163.0820350020514,
    "text": "而是一篇公开发表的宣言，"
  },
  {
    "start": 163.38706289359402,
    "end": 165.40024697777528,
    "text": "和一次家人的指认。"
  },
  {
    "start": 165.56292851993132,
    "end": 167.16940874872242,
    "text": "卡钦斯基证明："
  },
  {
    "start": 167.33209029087848,
    "end": 168.65387782089647,
    "text": "最危险的，"
  },
  {
    "start": 168.81655936305253,
    "end": 170.24002285691805,
    "text": "有时不是街头，"
  },
  {
    "start": 170.6670619050777,
    "end": 173.85968716989038,
    "text": "而是一间与世隔绝的小屋。"
  }
]