{
 "N01": {
  "duration": 26.695,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.32,
    "text": "他把一条牛仔裤送进洗衣店",
    "chars_per_second": 5.5
   },
   {
    "i": 1,
    "start": 2.66,
    "end": 4.71,
    "text": "却把十七条人命的线索",
    "chars_per_second": 4.88
   },
   {
    "i": 2,
    "start": 5.06,
    "end": 6.18,
    "text": "送到了警方手里",
    "chars_per_second": 6.25
   },
   {
    "i": 3,
    "start": 6.52,
    "end": 7.37,
    "text": "一九七五年",
    "chars_per_second": 5.88
   },
   {
    "i": 4,
    "start": 7.72,
    "end": 8.22,
    "text": "韩国",
    "chars_per_second": 4.0
   },
   {
    "i": 5,
    "start": 8.57,
    "end": 9.75,
    "text": "洗衣工接过裤子",
    "chars_per_second": 5.93
   },
   {
    "i": 6,
    "start": 10.09,
    "end": 11.72,
    "text": "注意到不寻常的斑痕",
    "chars_per_second": 5.52
   },
   {
    "i": 7,
    "start": 12.07,
    "end": 12.59,
    "text": "男人解释",
    "chars_per_second": 7.69
   },
   {
    "i": 8,
    "start": 12.94,
    "end": 13.78,
    "text": "是打架留下的",
    "chars_per_second": 7.14
   },
   {
    "i": 9,
    "start": 14.13,
    "end": 14.99,
    "text": "老板做了一件事",
    "chars_per_second": 8.14
   },
   {
    "i": 10,
    "start": 15.34,
    "end": 15.88,
    "text": "报警",
    "chars_per_second": 3.7
   },
   {
    "i": 11,
    "start": 16.22,
    "end": 18.22,
    "text": "这个男人叫金大斗",
    "chars_per_second": 4.0
   },
   {
    "i": 12,
    "start": 18.57,
    "end": 19.16,
    "text": "此时",
    "chars_per_second": 3.39
   },
   {
    "i": 13,
    "start": 19.39,
    "end": 20.58,
    "text": "那条裤子背后",
    "chars_per_second": 5.04
   },
   {
    "i": 14,
    "start": 20.88,
    "end": 21.95,
    "text": "不是一次冲突",
    "chars_per_second": 5.61
   },
   {
    "i": 15,
    "start": 22.3,
    "end": 23.84,
    "text": "而是多地的连续命案",
    "chars_per_second": 5.84
   },
   {
    "i": 16,
    "start": 24.18,
    "end": 26.7,
    "text": "故事要从那个夏天说起",
    "chars_per_second": 3.98
   }
  ]
 },
 "N02": {
  "duration": 28.375,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.38,
    "text": "那年八月至十月",
    "chars_per_second": 5.65
   },
   {
    "i": 1,
    "start": 1.73,
    "end": 4.01,
    "text": "金大斗接连犯下抢劫杀人案",
    "chars_per_second": 5.26
   },
   {
    "i": 2,
    "start": 4.36,
    "end": 5.29,
    "text": "乡间住宅",
    "chars_per_second": 4.3
   },
   {
    "i": 3,
    "start": 5.57,
    "end": 6.38,
    "text": "普通家庭",
    "chars_per_second": 4.94
   },
   {
    "i": 4,
    "start": 6.73,
    "end": 7.64,
    "text": "五十五天里",
    "chars_per_second": 5.49
   },
   {
    "i": 5,
    "start": 7.92,
    "end": 9.13,
    "text": "许多人失去生命",
    "chars_per_second": 5.79
   },
   {
    "i": 6,
    "start": 9.47,
    "end": 10.82,
    "text": "遇害者中有老人",
    "chars_per_second": 5.19
   },
   {
    "i": 7,
    "start": 11.15,
    "end": 12.79,
    "text": "甚至有年幼的孩子",
    "chars_per_second": 4.88
   },
   {
    "i": 8,
    "start": 13.13,
    "end": 15.52,
    "text": "他们留下的不是一个数字",
    "chars_per_second": 4.6
   },
   {
    "i": 9,
    "start": 15.86,
    "end": 19.1,
    "text": "而是一张再也等不到人坐下的餐桌",
    "chars_per_second": 4.63
   },
   {
    "i": 10,
    "start": 19.45,
    "end": 20.72,
    "text": "案件分散发生",
    "chars_per_second": 4.72
   },
   {
    "i": 11,
    "start": 21.06,
    "end": 22.08,
    "text": "线索也分散",
    "chars_per_second": 4.9
   },
   {
    "i": 12,
    "start": 22.43,
    "end": 24.08,
    "text": "没有今天的监控网络",
    "chars_per_second": 5.45
   },
   {
    "i": 13,
    "start": 24.41,
    "end": 28.38,
    "text": "调查人员要从纸质案卷中寻找联系",
    "chars_per_second": 3.78
   }
  ]
 },
 "N03": {
  "duration": 27.27,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.5,
    "text": "可最重要的突破",
    "chars_per_second": 5.15
   },
   {
    "i": 1,
    "start": 1.84,
    "end": 2.63,
    "text": "不在地图上",
    "chars_per_second": 6.33
   },
   {
    "i": 2,
    "start": 2.97,
    "end": 4.72,
    "text": "而在一间普通洗衣店里",
    "chars_per_second": 5.71
   },
   {
    "i": 3,
    "start": 5.07,
    "end": 6.63,
    "text": "一条需要清洗的裤子",
    "chars_per_second": 5.77
   },
   {
    "i": 4,
    "start": 6.97,
    "end": 8.47,
    "text": "一个关于打架的解释",
    "chars_per_second": 6.0
   },
   {
    "i": 5,
    "start": 8.81,
    "end": 10.6,
    "text": "一名觉得不对劲的店主",
    "chars_per_second": 5.59
   },
   {
    "i": 6,
    "start": 10.95,
    "end": 12.96,
    "text": "老板不知道自己面对的是谁",
    "chars_per_second": 5.97
   },
   {
    "i": 7,
    "start": 13.31,
    "end": 14.41,
    "text": "他没有冒险追问",
    "chars_per_second": 6.36
   },
   {
    "i": 8,
    "start": 14.76,
    "end": 16.22,
    "text": "只把异常交给警方",
    "chars_per_second": 5.48
   },
   {
    "i": 9,
    "start": 16.57,
    "end": 17.99,
    "text": "可能被洗掉的痕迹",
    "chars_per_second": 5.63
   },
   {
    "i": 10,
    "start": 18.34,
    "end": 19.17,
    "text": "就这样留下了",
    "chars_per_second": 7.23
   },
   {
    "i": 11,
    "start": 19.51,
    "end": 21.45,
    "text": "金大斗随后被捕",
    "chars_per_second": 3.61
   },
   {
    "i": 12,
    "start": 21.8,
    "end": 23.26,
    "text": "警方开始调查",
    "chars_per_second": 4.11
   },
   {
    "i": 13,
    "start": 23.63,
    "end": 24.62,
    "text": "分散的案卷",
    "chars_per_second": 5.05
   },
   {
    "i": 14,
    "start": 24.92,
    "end": 27.27,
    "text": "终于有了一个共同的名字",
    "chars_per_second": 4.68
   }
  ]
 },
 "N04": {
  "duration": 28.495,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.96,
    "text": "被捕之后",
    "chars_per_second": 4.94
   },
   {
    "i": 1,
    "start": 1.3,
    "end": 3.16,
    "text": "金大斗承认了自己的犯罪",
    "chars_per_second": 5.91
   },
   {
    "i": 2,
    "start": 3.51,
    "end": 5.24,
    "text": "但供述不是调查的终点",
    "chars_per_second": 5.78
   },
   {
    "i": 3,
    "start": 5.59,
    "end": 7.09,
    "text": "警方还要把供述",
    "chars_per_second": 4.67
   },
   {
    "i": 4,
    "start": 7.27,
    "end": 9.46,
    "text": "与不同地区的案件逐项核对",
    "chars_per_second": 5.48
   },
   {
    "i": 5,
    "start": 9.81,
    "end": 11.49,
    "text": "原本分开的线索",
    "chars_per_second": 4.17
   },
   {
    "i": 6,
    "start": 11.72,
    "end": 13.68,
    "text": "开始拼成同一段时间",
    "chars_per_second": 4.59
   },
   {
    "i": 7,
    "start": 13.98,
    "end": 16.2,
    "text": "一九七五年八月至十月",
    "chars_per_second": 4.5
   },
   {
    "i": 8,
    "start": 16.55,
    "end": 17.36,
    "text": "五十五天",
    "chars_per_second": 4.94
   },
   {
    "i": 9,
    "start": 17.72,
    "end": 18.66,
    "text": "十七人遇害",
    "chars_per_second": 5.32
   },
   {
    "i": 10,
    "start": 19.01,
    "end": 20.88,
    "text": "这不是神奇推理的故事",
    "chars_per_second": 5.35
   },
   {
    "i": 11,
    "start": 21.22,
    "end": 22.73,
    "text": "真正改变方向的",
    "chars_per_second": 4.64
   },
   {
    "i": 12,
    "start": 23.06,
    "end": 24.58,
    "text": "是有人报告异常",
    "chars_per_second": 4.61
   },
   {
    "i": 13,
    "start": 24.93,
    "end": 28.5,
    "text": "而调查人员继续把异常追查到底",
    "chars_per_second": 3.93
   }
  ]
 },
 "N05": {
  "duration": 27.395,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.63,
    "text": "案件进入司法程序",
    "chars_per_second": 5.41
   },
   {
    "i": 1,
    "start": 1.97,
    "end": 3.9,
    "text": "金大斗被判处死刑",
    "chars_per_second": 4.15
   },
   {
    "i": 2,
    "start": 4.25,
    "end": 5.57,
    "text": "一九七六年十二月",
    "chars_per_second": 6.06
   },
   {
    "i": 3,
    "start": 5.88,
    "end": 7.0,
    "text": "他被执行死刑",
    "chars_per_second": 5.36
   },
   {
    "i": 4,
    "start": 7.35,
    "end": 9.01,
    "text": "一个人的犯罪到此终结",
    "chars_per_second": 6.02
   },
   {
    "i": 5,
    "start": 9.34,
    "end": 10.74,
    "text": "十七个家庭的伤痛",
    "chars_per_second": 5.71
   },
   {
    "i": 6,
    "start": 11.08,
    "end": 12.75,
    "text": "却不会跟着判决结束",
    "chars_per_second": 5.39
   },
   {
    "i": 7,
    "start": 13.1,
    "end": 14.29,
    "text": "有关报道也提到",
    "chars_per_second": 5.88
   },
   {
    "i": 8,
    "start": 14.64,
    "end": 18.46,
    "text": "他曾把自己的处境归结为贫困和被冷落",
    "chars_per_second": 4.45
   },
   {
    "i": 9,
    "start": 18.81,
    "end": 21.12,
    "text": "但受挫不能成为伤害他人的理由",
    "chars_per_second": 6.06
   },
   {
    "i": 10,
    "start": 21.44,
    "end": 22.94,
    "text": "更不能抹去受害者",
    "chars_per_second": 5.33
   },
   {
    "i": 11,
    "start": 23.29,
    "end": 24.92,
    "text": "我们记住这个案件",
    "chars_per_second": 4.91
   },
   {
    "i": 12,
    "start": 25.26,
    "end": 27.39,
    "text": "不是为了替凶手制造传奇",
    "chars_per_second": 5.15
   }
  ]
 },
 "N06": {
  "duration": 30.51,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.32,
    "text": "再看那间洗衣店",
    "chars_per_second": 5.98
   },
   {
    "i": 1,
    "start": 1.66,
    "end": 2.26,
    "text": "柜台",
    "chars_per_second": 3.33
   },
   {
    "i": 2,
    "start": 2.53,
    "end": 2.99,
    "text": "电话",
    "chars_per_second": 4.35
   },
   {
    "i": 3,
    "start": 3.34,
    "end": 4.32,
    "text": "普通的顾客",
    "chars_per_second": 5.1
   },
   {
    "i": 4,
    "start": 4.66,
    "end": 5.64,
    "text": "都没有什么特别",
    "chars_per_second": 7.14
   },
   {
    "i": 5,
    "start": 5.99,
    "end": 6.82,
    "text": "特别的是",
    "chars_per_second": 4.82
   },
   {
    "i": 6,
    "start": 7.16,
    "end": 9.12,
    "text": "老板没有把眼前的不合理",
    "chars_per_second": 5.61
   },
   {
    "i": 7,
    "start": 9.42,
    "end": 10.68,
    "text": "当成与自己无关",
    "chars_per_second": 5.56
   },
   {
    "i": 8,
    "start": 11.02,
    "end": 13.04,
    "text": "一条裤子可以被洗干净",
    "chars_per_second": 4.95
   },
   {
    "i": 9,
    "start": 13.38,
    "end": 14.65,
    "text": "留下的线索",
    "chars_per_second": 3.94
   },
   {
    "i": 10,
    "start": 15.0,
    "end": 17.04,
    "text": "却让警方追到了真相",
    "chars_per_second": 4.41
   },
   {
    "i": 11,
    "start": 17.39,
    "end": 18.3,
    "text": "五十五天",
    "chars_per_second": 4.4
   },
   {
    "i": 12,
    "start": 18.58,
    "end": 19.62,
    "text": "十七条生命",
    "chars_per_second": 4.81
   },
   {
    "i": 13,
    "start": 19.97,
    "end": 20.98,
    "text": "最值得记住的",
    "chars_per_second": 5.94
   },
   {
    "i": 14,
    "start": 21.27,
    "end": 22.62,
    "text": "不是凶手有多可怕",
    "chars_per_second": 5.93
   },
   {
    "i": 15,
    "start": 22.96,
    "end": 25.52,
    "text": "而是那些本不该空下来的座位",
    "chars_per_second": 5.08
   },
   {
    "i": 16,
    "start": 25.87,
    "end": 27.48,
    "text": "如果你遇到可疑情况",
    "chars_per_second": 5.59
   },
   {
    "i": 17,
    "start": 27.82,
    "end": 28.85,
    "text": "别独自冒险",
    "chars_per_second": 4.85
   },
   {
    "i": 18,
    "start": 29.2,
    "end": 30.51,
    "text": "交给警方处理",
    "chars_per_second": 4.58
   }
  ]
 }
}