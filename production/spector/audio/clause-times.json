{
 "N01": {
  "duration": 32.672,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.32,
    "text": "十八个不到一毫米的血点",
    "chars_per_second": 5.07
   },
   {
    "i": 1,
    "start": 2.67,
    "end": 3.65,
    "text": "怎么给人定罪",
    "chars_per_second": 6.12
   },
   {
    "i": 2,
    "start": 4.0,
    "end": 5.24,
    "text": "二零零三年凌晨",
    "chars_per_second": 5.65
   },
   {
    "i": 3,
    "start": 5.55,
    "end": 8.43,
    "text": "洛杉矶山上的城堡宅邸一声枪响",
    "chars_per_second": 4.86
   },
   {
    "i": 4,
    "start": 8.8,
    "end": 10.44,
    "text": "女演员死在门厅",
    "chars_per_second": 4.27
   },
   {
    "i": 5,
    "start": 10.78,
    "end": 12.48,
    "text": "左轮手枪落在脚边",
    "chars_per_second": 4.71
   },
   {
    "i": 6,
    "start": 12.74,
    "end": 13.91,
    "text": "枪上没有指纹",
    "chars_per_second": 5.13
   },
   {
    "i": 7,
    "start": 14.2,
    "end": 15.51,
    "text": "宅子里的另一个人",
    "chars_per_second": 6.11
   },
   {
    "i": 8,
    "start": 15.77,
    "end": 17.71,
    "text": "是乐坛活着的传奇",
    "chars_per_second": 4.12
   },
   {
    "i": 9,
    "start": 18.06,
    "end": 18.46,
    "text": "他说",
    "chars_per_second": 5.0
   },
   {
    "i": 10,
    "start": 18.71,
    "end": 21.44,
    "text": "是她自己把枪放进嘴里的",
    "chars_per_second": 4.03
   },
   {
    "i": 11,
    "start": 21.79,
    "end": 23.21,
    "text": "他把枪擦干净",
    "chars_per_second": 4.23
   },
   {
    "i": 12,
    "start": 23.39,
    "end": 25.22,
    "text": "门厅擦得一尘不染",
    "chars_per_second": 4.37
   },
   {
    "i": 13,
    "start": 25.56,
    "end": 26.68,
    "text": "可这些血点",
    "chars_per_second": 4.46
   },
   {
    "i": 14,
    "start": 26.8,
    "end": 30.26,
    "text": "早已按流体力学的方程写好了真相",
    "chars_per_second": 4.34
   },
   {
    "i": 15,
    "start": 30.6,
    "end": 32.67,
    "text": "这就是菲尔·斯佩克特案",
    "chars_per_second": 4.83
   }
  ]
 },
 "N02": {
  "duration": 24.656,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 1.26,
    "text": "这个男人是谁",
    "chars_per_second": 5.26
   },
   {
    "i": 1,
    "start": 1.61,
    "end": 2.93,
    "text": "菲尔·斯佩克特",
    "chars_per_second": 4.55
   },
   {
    "i": 2,
    "start": 3.27,
    "end": 4.75,
    "text": "「声墙」发明人",
    "chars_per_second": 3.38
   },
   {
    "i": 3,
    "start": 5.07,
    "end": 6.9,
    "text": "把乐器一层层叠录",
    "chars_per_second": 4.37
   },
   {
    "i": 4,
    "start": 7.25,
    "end": 8.82,
    "text": "砌成一面声音的墙",
    "chars_per_second": 5.1
   },
   {
    "i": 5,
    "start": 9.07,
    "end": 10.4,
    "text": "五年二十首热单",
    "chars_per_second": 5.26
   },
   {
    "i": 6,
    "start": 10.76,
    "end": 12.39,
    "text": "披头士告别专辑",
    "chars_per_second": 4.29
   },
   {
    "i": 7,
    "start": 12.58,
    "end": 13.52,
    "text": "列侬的《想象》",
    "chars_per_second": 5.32
   },
   {
    "i": 8,
    "start": 13.68,
    "end": 14.77,
    "text": "都出自他手",
    "chars_per_second": 4.59
   },
   {
    "i": 9,
    "start": 15.05,
    "end": 15.55,
    "text": "另一边",
    "chars_per_second": 6.0
   },
   {
    "i": 10,
    "start": 15.87,
    "end": 18.24,
    "text": "女演员拉娜·克拉克森",
    "chars_per_second": 3.8
   },
   {
    "i": 11,
    "start": 18.58,
    "end": 19.11,
    "text": "四十岁",
    "chars_per_second": 5.66
   },
   {
    "i": 12,
    "start": 19.43,
    "end": 20.96,
    "text": "当时在俱乐部工作",
    "chars_per_second": 5.23
   },
   {
    "i": 13,
    "start": 21.3,
    "end": 22.71,
    "text": "当晚两人相识",
    "chars_per_second": 4.26
   },
   {
    "i": 14,
    "start": 23.06,
    "end": 24.66,
    "text": "他提出送她回家",
    "chars_per_second": 4.39
   }
  ]
 },
 "N03": {
  "duration": 22.955,
  "clauses": [
   {
    "i": 0,
    "start": 0.11,
    "end": 1.43,
    "text": "汽车开进宅邸",
    "chars_per_second": 4.55
   },
   {
    "i": 1,
    "start": 1.77,
    "end": 2.79,
    "text": "他的版本是",
    "chars_per_second": 4.9
   },
   {
    "i": 2,
    "start": 2.98,
    "end": 4.93,
    "text": "克拉克森自己开了枪",
    "chars_per_second": 4.62
   },
   {
    "i": 3,
    "start": 5.28,
    "end": 6.05,
    "text": "一场意外",
    "chars_per_second": 5.19
   },
   {
    "i": 4,
    "start": 6.21,
    "end": 7.94,
    "text": "可司机已经报了警",
    "chars_per_second": 4.62
   },
   {
    "i": 5,
    "start": 8.29,
    "end": 9.38,
    "text": "宅门打开时",
    "chars_per_second": 4.59
   },
   {
    "i": 6,
    "start": 9.64,
    "end": 10.56,
    "text": "第一句话是",
    "chars_per_second": 5.43
   },
   {
    "i": 7,
    "start": 10.9,
    "end": 12.75,
    "text": "我想我害了一条命",
    "chars_per_second": 4.32
   },
   {
    "i": 8,
    "start": 13.1,
    "end": 16.97,
    "text": "警方在浴室找到一块带深红痕迹的白布",
    "chars_per_second": 4.39
   },
   {
    "i": 9,
    "start": 17.31,
    "end": 19.68,
    "text": "他手上检出射击残留物",
    "chars_per_second": 4.22
   },
   {
    "i": 10,
    "start": 20.02,
    "end": 21.2,
    "text": "多名女性还指证",
    "chars_per_second": 5.93
   },
   {
    "i": 11,
    "start": 21.46,
    "end": 22.95,
    "text": "曾被他威胁过",
    "chars_per_second": 4.01
   }
  ]
 },
 "N04": {
  "duration": 29.228,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.96,
    "text": "法医撕开了「自杀」的说法",
    "chars_per_second": 5.49
   },
   {
    "i": 1,
    "start": 2.31,
    "end": 3.72,
    "text": "弹道向下倾斜",
    "chars_per_second": 4.26
   },
   {
    "i": 2,
    "start": 3.96,
    "end": 4.68,
    "text": "自己开枪",
    "chars_per_second": 5.56
   },
   {
    "i": 3,
    "start": 4.92,
    "end": 7.31,
    "text": "枪口该是平的甚至朝上",
    "chars_per_second": 4.18
   },
   {
    "i": 4,
    "start": 7.65,
    "end": 9.44,
    "text": "被后坐力崩落的牙齿",
    "chars_per_second": 5.03
   },
   {
    "i": 5,
    "start": 9.57,
    "end": 10.91,
    "text": "在楼梯脚被发现",
    "chars_per_second": 5.22
   },
   {
    "i": 6,
    "start": 11.25,
    "end": 12.28,
    "text": "验尸官结论",
    "chars_per_second": 4.85
   },
   {
    "i": 7,
    "start": 12.59,
    "end": 13.04,
    "text": "他杀",
    "chars_per_second": 4.44
   },
   {
    "i": 8,
    "start": 13.36,
    "end": 15.0,
    "text": "但辩护手里也有牌",
    "chars_per_second": 4.88
   },
   {
    "i": 9,
    "start": 15.25,
    "end": 17.24,
    "text": "夹克上只有十八个血点",
    "chars_per_second": 5.03
   },
   {
    "i": 10,
    "start": 17.58,
    "end": 20.83,
    "text": "这么近的距离",
    "chars_per_second": 1.85
   },
   {
    "i": 11,
    "start": 21.18,
    "end": 22.78,
    "text": "人该被血雾糊满才对",
    "chars_per_second": 5.63
   },
   {
    "i": 12,
    "start": 23.03,
    "end": 23.83,
    "text": "二零零七年一审",
    "chars_per_second": 8.75
   },
   {
    "i": 13,
    "start": 23.96,
    "end": 25.13,
    "text": "陪审团十比二",
    "chars_per_second": 5.13
   },
   {
    "i": 14,
    "start": 25.37,
    "end": 26.98,
    "text": "流审",
    "chars_per_second": 1.24
   },
   {
    "i": 15,
    "start": 27.3,
    "end": 27.82,
    "text": "全案卡在一个问题上",
    "chars_per_second": 17.31
   },
   {
    "i": 16,
    "start": 28.01,
    "end": 29.23,
    "text": "血滴到底往哪儿飞",
    "chars_per_second": 6.57
   }
  ]
 },
 "N05": {
  "duration": 36.911,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 1.17,
    "text": "硬核的部分来了",
    "chars_per_second": 6.54
   },
   {
    "i": 1,
    "start": 1.52,
    "end": 2.8,
    "text": "血滴砸在表面",
    "chars_per_second": 4.69
   },
   {
    "i": 2,
    "start": 3.15,
    "end": 4.27,
    "text": "宽除以长",
    "chars_per_second": 3.57
   },
   {
    "i": 3,
    "start": 4.39,
    "end": 6.46,
    "text": "就是撞击角的正弦值",
    "chars_per_second": 4.35
   },
   {
    "i": 4,
    "start": 6.8,
    "end": 8.13,
    "text": "多条轨迹连线",
    "chars_per_second": 4.51
   },
   {
    "i": 5,
    "start": 8.48,
    "end": 9.81,
    "text": "汇聚到空中一点",
    "chars_per_second": 5.26
   },
   {
    "i": 6,
    "start": 10.15,
    "end": 11.0,
    "text": "开枪的位置",
    "chars_per_second": 5.88
   },
   {
    "i": 7,
    "start": 11.33,
    "end": 13.36,
    "text": "后来流体力学算出",
    "chars_per_second": 3.94
   },
   {
    "i": 8,
    "start": 13.61,
    "end": 18.3,
    "text": "枪口燃气卷成约一百米每秒的涡环",
    "chars_per_second": 3.2
   },
   {
    "i": 9,
    "start": 18.44,
    "end": 21.1,
    "text": "迎面撞上反向飞出的血雾",
    "chars_per_second": 4.14
   },
   {
    "i": 10,
    "start": 21.36,
    "end": 22.22,
    "text": "把它推回去",
    "chars_per_second": 5.81
   },
   {
    "i": 11,
    "start": 22.56,
    "end": 23.26,
    "text": "甚至掉头",
    "chars_per_second": 5.71
   },
   {
    "i": 12,
    "start": 23.38,
    "end": 24.45,
    "text": "开枪的人可以干干净净",
    "chars_per_second": 9.35
   },
   {
    "i": 13,
    "start": 24.79,
    "end": 25.33,
    "text": "底牌「血太少」",
    "chars_per_second": 9.26
   },
   {
    "i": 14,
    "start": 25.53,
    "end": 26.25,
    "text": "被这组方程撕碎",
    "chars_per_second": 9.72
   },
   {
    "i": 15,
    "start": 26.61,
    "end": 28.14,
    "text": "袖口那十八个点",
    "chars_per_second": 4.58
   },
   {
    "i": 16,
    "start": 28.44,
    "end": 31.1,
    "text": "恰好落在物理认定的开枪者身上",
    "chars_per_second": 5.26
   },
   {
    "i": 17,
    "start": 31.23,
    "end": 32.97,
    "text": "二零零九年重审",
    "chars_per_second": 4.02
   },
   {
    "i": 18,
    "start": 33.32,
    "end": 34.83,
    "text": "陪审团裁定",
    "chars_per_second": 3.31
   },
   {
    "i": 19,
    "start": 35.04,
    "end": 36.91,
    "text": "有罪",
    "chars_per_second": 1.07
   }
  ]
 },
 "N06": {
  "duration": 27.73,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 0.91,
    "text": "二级谋杀",
    "chars_per_second": 4.94
   },
   {
    "i": 1,
    "start": 1.25,
    "end": 2.92,
    "text": "十九年监禁至终身",
    "chars_per_second": 4.79
   },
   {
    "i": 2,
    "start": 3.27,
    "end": 4.11,
    "text": "二零二一年",
    "chars_per_second": 5.95
   },
   {
    "i": 3,
    "start": 4.38,
    "end": 7.14,
    "text": "八十一岁的斯佩克特在狱中去世",
    "chars_per_second": 5.07
   },
   {
    "i": 4,
    "start": 7.49,
    "end": 8.19,
    "text": "四个月后",
    "chars_per_second": 5.71
   },
   {
    "i": 5,
    "start": 8.54,
    "end": 10.24,
    "text": "那篇涡环论文发表",
    "chars_per_second": 4.71
   },
   {
    "i": 6,
    "start": 10.59,
    "end": 11.59,
    "text": "人不在了",
    "chars_per_second": 4.0
   },
   {
    "i": 7,
    "start": 11.94,
    "end": 15.1,
    "text": "物理替这个案子写完了最后一页",
    "chars_per_second": 4.43
   },
   {
    "i": 8,
    "start": 15.42,
    "end": 17.72,
    "text": "他一生砌起声音的墙",
    "chars_per_second": 3.91
   },
   {
    "i": 9,
    "start": 17.85,
    "end": 20.69,
    "text": "最后却挡不住一滴血说出真相",
    "chars_per_second": 4.58
   },
   {
    "i": 10,
    "start": 21.03,
    "end": 23.06,
    "text": "你相信有完美的犯罪",
    "chars_per_second": 4.43
   },
   {
    "i": 11,
    "start": 23.35,
    "end": 26.15,
    "text": "还是只有还没追上的科学",
    "chars_per_second": 3.93
   },
   {
    "i": 12,
    "start": 26.47,
    "end": 27.73,
    "text": "评论区聊聊",
    "chars_per_second": 3.97
   }
  ]
 }
}