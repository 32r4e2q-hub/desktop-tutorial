{
 "N01": {
  "duration": 29.829,
  "clauses": [
   {
    "i": 0,
    "start": 0.04,
    "end": 2.12,
    "text": "十八个不到一毫米的血点",
    "chars_per_second": 5.28
   },
   {
    "i": 1,
    "start": 2.12,
    "end": 3.26,
    "text": "怎么给人定罪",
    "chars_per_second": 5.28
   },
   {
    "i": 2,
    "start": 3.6,
    "end": 5.02,
    "text": "二零零三年凌晨",
    "chars_per_second": 4.93
   },
   {
    "i": 3,
    "start": 5.02,
    "end": 7.86,
    "text": "洛杉矶山上的城堡宅邸一声枪响",
    "chars_per_second": 4.93
   },
   {
    "i": 4,
    "start": 8.21,
    "end": 9.71,
    "text": "女演员死在门厅",
    "chars_per_second": 4.67
   },
   {
    "i": 5,
    "start": 10.05,
    "end": 11.66,
    "text": "左轮手枪落在脚边",
    "chars_per_second": 4.97
   },
   {
    "i": 6,
    "start": 12.0,
    "end": 13.21,
    "text": "枪上没有指纹",
    "chars_per_second": 4.96
   },
   {
    "i": 7,
    "start": 13.55,
    "end": 14.82,
    "text": "宅子里的另一个人",
    "chars_per_second": 6.3
   },
   {
    "i": 8,
    "start": 15.12,
    "end": 16.8,
    "text": "是乐坛活着的传奇",
    "chars_per_second": 4.76
   },
   {
    "i": 9,
    "start": 17.13,
    "end": 17.56,
    "text": "他说",
    "chars_per_second": 4.68
   },
   {
    "i": 10,
    "start": 17.56,
    "end": 19.91,
    "text": "是她自己把枪放进嘴里的",
    "chars_per_second": 4.68
   },
   {
    "i": 11,
    "start": 20.25,
    "end": 21.47,
    "text": "他把枪擦干净",
    "chars_per_second": 4.92
   },
   {
    "i": 12,
    "start": 21.82,
    "end": 23.24,
    "text": "门厅擦得一尘不染",
    "chars_per_second": 5.63
   },
   {
    "i": 13,
    "start": 23.59,
    "end": 24.56,
    "text": "可这些血点",
    "chars_per_second": 5.14
   },
   {
    "i": 14,
    "start": 24.56,
    "end": 27.48,
    "text": "早已按流体力学的方程写好了真相",
    "chars_per_second": 5.14
   },
   {
    "i": 15,
    "start": 27.82,
    "end": 29.83,
    "text": "这就是菲尔·斯佩克特案",
    "chars_per_second": 4.98
   }
  ]
 },
 "N02": {
  "duration": 23.395,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 1.12,
    "text": "这个男人是谁",
    "chars_per_second": 5.45
   },
   {
    "i": 1,
    "start": 1.46,
    "end": 2.72,
    "text": "菲尔·斯佩克特",
    "chars_per_second": 4.76
   },
   {
    "i": 2,
    "start": 3.06,
    "end": 4.26,
    "text": "「声墙」发明人",
    "chars_per_second": 4.17
   },
   {
    "i": 3,
    "start": 4.61,
    "end": 6.31,
    "text": "把乐器一层层叠录",
    "chars_per_second": 4.71
   },
   {
    "i": 4,
    "start": 6.66,
    "end": 8.18,
    "text": "砌成一面声音的墙",
    "chars_per_second": 5.26
   },
   {
    "i": 5,
    "start": 8.53,
    "end": 10.02,
    "text": "五年二十首热单",
    "chars_per_second": 4.7
   },
   {
    "i": 6,
    "start": 10.37,
    "end": 11.84,
    "text": "披头士告别专辑",
    "chars_per_second": 4.76
   },
   {
    "i": 7,
    "start": 12.19,
    "end": 13.25,
    "text": "列侬的《想象》",
    "chars_per_second": 4.74
   },
   {
    "i": 8,
    "start": 13.25,
    "end": 14.3,
    "text": "都出自他手",
    "chars_per_second": 4.74
   },
   {
    "i": 9,
    "start": 14.64,
    "end": 15.35,
    "text": "另一边",
    "chars_per_second": 4.21
   },
   {
    "i": 10,
    "start": 15.35,
    "end": 17.49,
    "text": "女演员拉娜·克拉克森",
    "chars_per_second": 4.21
   },
   {
    "i": 11,
    "start": 17.49,
    "end": 18.2,
    "text": "四十岁",
    "chars_per_second": 4.21
   },
   {
    "i": 12,
    "start": 18.54,
    "end": 19.92,
    "text": "当时在俱乐部工作",
    "chars_per_second": 5.8
   },
   {
    "i": 13,
    "start": 20.27,
    "end": 21.55,
    "text": "当晚两人相识",
    "chars_per_second": 4.69
   },
   {
    "i": 14,
    "start": 21.87,
    "end": 23.39,
    "text": "他提出送她回家",
    "chars_per_second": 4.59
   }
  ]
 },
 "N03": {
  "duration": 20.609,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 1.37,
    "text": "汽车开进宅邸",
    "chars_per_second": 4.62
   },
   {
    "i": 1,
    "start": 1.71,
    "end": 2.74,
    "text": "他的版本是",
    "chars_per_second": 4.85
   },
   {
    "i": 2,
    "start": 3.08,
    "end": 4.71,
    "text": "克拉克森自己开了枪",
    "chars_per_second": 5.52
   },
   {
    "i": 3,
    "start": 5.03,
    "end": 5.74,
    "text": "一场意外",
    "chars_per_second": 5.63
   },
   {
    "i": 4,
    "start": 6.09,
    "end": 7.35,
    "text": "可司机已经报了警",
    "chars_per_second": 6.35
   },
   {
    "i": 5,
    "start": 7.69,
    "end": 8.72,
    "text": "宅门打开时",
    "chars_per_second": 4.85
   },
   {
    "i": 6,
    "start": 9.04,
    "end": 9.97,
    "text": "第一句话是",
    "chars_per_second": 5.38
   },
   {
    "i": 7,
    "start": 10.28,
    "end": 11.59,
    "text": "我想我害了一条命",
    "chars_per_second": 6.11
   },
   {
    "i": 8,
    "start": 11.94,
    "end": 15.15,
    "text": "警方在浴室找到一块带深红痕迹的白布",
    "chars_per_second": 5.3
   },
   {
    "i": 9,
    "start": 15.51,
    "end": 17.48,
    "text": "他手上检出射击残留物",
    "chars_per_second": 5.08
   },
   {
    "i": 10,
    "start": 17.83,
    "end": 19.33,
    "text": "多名女性还指证",
    "chars_per_second": 4.68
   },
   {
    "i": 11,
    "start": 19.33,
    "end": 20.61,
    "text": "曾被他威胁过",
    "chars_per_second": 4.68
   }
  ]
 },
 "N04": {
  "duration": 28.465,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 2.11,
    "text": "法医撕开了「自杀」的说法",
    "chars_per_second": 4.9
   },
   {
    "i": 1,
    "start": 2.5,
    "end": 3.88,
    "text": "弹道向下倾斜",
    "chars_per_second": 4.35
   },
   {
    "i": 2,
    "start": 4.22,
    "end": 5.1,
    "text": "自己开枪",
    "chars_per_second": 4.55
   },
   {
    "i": 3,
    "start": 5.1,
    "end": 7.3,
    "text": "枪口该是平的甚至朝上",
    "chars_per_second": 4.55
   },
   {
    "i": 4,
    "start": 7.65,
    "end": 9.42,
    "text": "被后坐力崩落的牙齿",
    "chars_per_second": 5.08
   },
   {
    "i": 5,
    "start": 9.42,
    "end": 10.8,
    "text": "在楼梯脚被发现",
    "chars_per_second": 5.08
   },
   {
    "i": 6,
    "start": 11.15,
    "end": 12.36,
    "text": "验尸官结论",
    "chars_per_second": 4.12
   },
   {
    "i": 7,
    "start": 12.36,
    "end": 12.85,
    "text": "他杀",
    "chars_per_second": 4.12
   },
   {
    "i": 8,
    "start": 13.2,
    "end": 14.8,
    "text": "但辩护手里也有牌",
    "chars_per_second": 5.0
   },
   {
    "i": 9,
    "start": 15.15,
    "end": 16.99,
    "text": "夹克上只有十八个血点",
    "chars_per_second": 5.43
   },
   {
    "i": 10,
    "start": 17.33,
    "end": 18.51,
    "text": "这么近的距离",
    "chars_per_second": 5.1
   },
   {
    "i": 11,
    "start": 18.51,
    "end": 20.27,
    "text": "人该被血雾糊满才对",
    "chars_per_second": 5.1
   },
   {
    "i": 12,
    "start": 20.62,
    "end": 21.89,
    "text": "二零零七年一审",
    "chars_per_second": 5.51
   },
   {
    "i": 13,
    "start": 22.24,
    "end": 23.58,
    "text": "陪审团十比二",
    "chars_per_second": 4.48
   },
   {
    "i": 14,
    "start": 23.92,
    "end": 24.4,
    "text": "流审",
    "chars_per_second": 4.17
   },
   {
    "i": 15,
    "start": 24.74,
    "end": 26.4,
    "text": "全案卡在一个问题上",
    "chars_per_second": 5.42
   },
   {
    "i": 16,
    "start": 26.75,
    "end": 28.46,
    "text": "血滴到底往哪儿飞",
    "chars_per_second": 4.66
   }
  ]
 },
 "N05": {
  "duration": 33.31,
  "clauses": [
   {
    "i": 0,
    "start": 0.06,
    "end": 1.25,
    "text": "硬核的部分来了",
    "chars_per_second": 5.88
   },
   {
    "i": 1,
    "start": 1.59,
    "end": 2.89,
    "text": "血滴砸在表面",
    "chars_per_second": 4.61
   },
   {
    "i": 2,
    "start": 2.89,
    "end": 3.76,
    "text": "宽除以长",
    "chars_per_second": 4.61
   },
   {
    "i": 3,
    "start": 3.76,
    "end": 5.71,
    "text": "就是撞击角的正弦值",
    "chars_per_second": 4.61
   },
   {
    "i": 4,
    "start": 6.05,
    "end": 7.21,
    "text": "多条轨迹连线",
    "chars_per_second": 5.16
   },
   {
    "i": 5,
    "start": 7.21,
    "end": 8.57,
    "text": "汇聚到空中一点",
    "chars_per_second": 5.16
   },
   {
    "i": 6,
    "start": 8.92,
    "end": 9.8,
    "text": "开枪的位置",
    "chars_per_second": 5.68
   },
   {
    "i": 7,
    "start": 10.17,
    "end": 11.74,
    "text": "后来流体力学算出",
    "chars_per_second": 5.1
   },
   {
    "i": 8,
    "start": 12.08,
    "end": 15.21,
    "text": "枪口燃气卷成约一百米每秒的涡环",
    "chars_per_second": 4.79
   },
   {
    "i": 9,
    "start": 15.56,
    "end": 17.71,
    "text": "迎面撞上反向飞出的血雾",
    "chars_per_second": 5.12
   },
   {
    "i": 10,
    "start": 18.04,
    "end": 19.15,
    "text": "把它推回去",
    "chars_per_second": 4.5
   },
   {
    "i": 11,
    "start": 19.15,
    "end": 20.04,
    "text": "甚至掉头",
    "chars_per_second": 4.5
   },
   {
    "i": 12,
    "start": 20.39,
    "end": 22.09,
    "text": "开枪的人可以干干净净",
    "chars_per_second": 5.88
   },
   {
    "i": 13,
    "start": 22.43,
    "end": 23.56,
    "text": "底牌「血太少」",
    "chars_per_second": 4.42
   },
   {
    "i": 14,
    "start": 23.91,
    "end": 25.18,
    "text": "被这组方程撕碎",
    "chars_per_second": 5.51
   },
   {
    "i": 15,
    "start": 25.52,
    "end": 26.83,
    "text": "袖口那十八个点",
    "chars_per_second": 5.34
   },
   {
    "i": 16,
    "start": 27.16,
    "end": 29.62,
    "text": "恰好落在物理认定的开枪者身上",
    "chars_per_second": 5.69
   },
   {
    "i": 17,
    "start": 29.97,
    "end": 31.2,
    "text": "二零零九年重审",
    "chars_per_second": 5.69
   },
   {
    "i": 18,
    "start": 31.54,
    "end": 32.8,
    "text": "陪审团裁定",
    "chars_per_second": 3.95
   },
   {
    "i": 19,
    "start": 32.8,
    "end": 33.31,
    "text": "有罪",
    "chars_per_second": 3.95
   }
  ]
 },
 "N06": {
  "duration": 24.147,
  "clauses": [
   {
    "i": 0,
    "start": 0.02,
    "end": 0.94,
    "text": "二级谋杀",
    "chars_per_second": 4.35
   },
   {
    "i": 1,
    "start": 0.94,
    "end": 2.78,
    "text": "十九年监禁至终身",
    "chars_per_second": 4.35
   },
   {
    "i": 2,
    "start": 3.13,
    "end": 4.07,
    "text": "二零二一年",
    "chars_per_second": 5.29
   },
   {
    "i": 3,
    "start": 4.07,
    "end": 6.72,
    "text": "八十一岁的斯佩克特在狱中去世",
    "chars_per_second": 5.29
   },
   {
    "i": 4,
    "start": 7.06,
    "end": 7.95,
    "text": "四个月后",
    "chars_per_second": 4.51
   },
   {
    "i": 5,
    "start": 7.95,
    "end": 9.72,
    "text": "那篇涡环论文发表",
    "chars_per_second": 4.51
   },
   {
    "i": 6,
    "start": 10.07,
    "end": 10.75,
    "text": "人不在了",
    "chars_per_second": 5.88
   },
   {
    "i": 7,
    "start": 11.09,
    "end": 13.45,
    "text": "物理替这个案子写完了最后一页",
    "chars_per_second": 5.93
   },
   {
    "i": 8,
    "start": 13.8,
    "end": 15.62,
    "text": "他一生砌起声音的墙",
    "chars_per_second": 4.95
   },
   {
    "i": 9,
    "start": 15.97,
    "end": 18.38,
    "text": "最后却挡不住一滴血说出真相",
    "chars_per_second": 5.39
   },
   {
    "i": 10,
    "start": 18.74,
    "end": 20.51,
    "text": "你相信有完美的犯罪",
    "chars_per_second": 5.08
   },
   {
    "i": 11,
    "start": 20.51,
    "end": 22.68,
    "text": "还是只有还没追上的科学",
    "chars_per_second": 5.08
   },
   {
    "i": 12,
    "start": 23.03,
    "end": 24.15,
    "text": "评论区聊聊",
    "chars_per_second": 4.47
   }
  ]
 }
}