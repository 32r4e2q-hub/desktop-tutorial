[
  {
    "start": 0.6,
    "end": 2.881987459219904,
    "text": "十八个不到一毫米的血点，"
  },
  {
    "start": 2.881987459219904,
    "end": 4.101851723134692,
    "text": "怎么给人定罪？"
  },
  {
    "start": 4.101851723134692,
    "end": 5.8475195490817145,
    "text": "二零零三年凌晨，"
  },
  {
    "start": 5.8475195490817145,
    "end": 8.98130877879384,
    "text": "洛杉矶山上的城堡宅邸一声枪响。"
  },
  {
    "start": 8.98130877879384,
    "end": 10.853169459628601,
    "text": "女演员死在门厅，"
  },
  {
    "start": 10.853169459628601,
    "end": 12.914319422794966,
    "text": "左轮手枪落在脚边，"
  },
  {
    "start": 12.914319422794966,
    "end": 14.512762251372964,
    "text": "枪上没有指纹。"
  },
  {
    "start": 14.512762251372964,
    "end": 16.279462219801278,
    "text": "宅子里的另一个人，"
  },
  {
    "start": 16.279462219801278,
    "end": 18.34061218296764,
    "text": "是乐坛活着的传奇，"
  },
  {
    "start": 18.34061218296764,
    "end": 19.16086573973793,
    "text": "他说："
  },
  {
    "start": 19.16086573973793,
    "end": 21.705754979973953,
    "text": "是她自己把枪放进嘴里的。"
  },
  {
    "start": 21.705754979973953,
    "end": 23.241101381108077,
    "text": "他把枪擦干净，"
  },
  {
    "start": 23.241101381108077,
    "end": 25.02883349201768,
    "text": "门厅擦得一尘不染。"
  },
  {
    "start": 25.02883349201768,
    "end": 26.52211560818923,
    "text": "可这些血点，"
  },
  {
    "start": 26.52211560818923,
    "end": 29.59280841045749,
    "text": "早已按流体力学的方程写好了真相。"
  },
  {
    "start": 29.59280841045749,
    "end": 31.88531194091804,
    "text": "这就是菲尔·斯佩克特案。"
  },
  {
    "start": 33.04803836801111,
    "end": 34.257386560685255,
    "text": "这个男人是谁？"
  },
  {
    "start": 34.42564370053557,
    "end": 36.02408652911357,
    "text": "菲尔·斯佩克特，"
  },
  {
    "start": 36.02408652911357,
    "end": 37.60149721521027,
    "text": "「声墙」发明人："
  },
  {
    "start": 37.60149721521027,
    "end": 39.536454323488904,
    "text": "把乐器一层层叠录，"
  },
  {
    "start": 40.08329002800243,
    "end": 41.40831500432367,
    "text": "砌成一面声音的墙。"
  },
  {
    "start": 41.492443574248824,
    "end": 42.964693547939085,
    "text": "五年二十首热单；"
  },
  {
    "start": 43.974236387040975,
    "end": 45.5306149306564,
    "text": "披头士告别专辑、"
  },
  {
    "start": 46.09848277765121,
    "end": 47.086993474271814,
    "text": "列侬的《想象》，"
  },
  {
    "start": 47.086993474271814,
    "end": 48.26479345322402,
    "text": "都出自他手。"
  },
  {
    "start": 48.26479345322402,
    "end": 49.12711129495689,
    "text": "另一边，"
  },
  {
    "start": 49.12711129495689,
    "end": 51.48271125286131,
    "text": "女演员拉娜·克拉克森，"
  },
  {
    "start": 51.48271125286131,
    "end": 52.34502909459417,
    "text": "四十岁，"
  },
  {
    "start": 52.34502909459417,
    "end": 54.0696647780599,
    "text": "当时在俱乐部工作。"
  },
  {
    "start": 54.0696647780599,
    "end": 55.77326831904435,
    "text": "当晚两人相识，"
  },
  {
    "start": 55.77326831904435,
    "end": 57.53996828747266,
    "text": "他提出送她回家。"
  },
  {
    "start": 58.73021176764542,
    "end": 60.00265638776343,
    "text": "汽车开进宅邸。"
  },
  {
    "start": 60.29710638250148,
    "end": 61.64316350130401,
    "text": "他的版本是："
  },
  {
    "start": 61.64316350130401,
    "end": 63.72534560695166,
    "text": "克拉克森自己开了枪，"
  },
  {
    "start": 63.72534560695166,
    "end": 64.90314558590387,
    "text": "一场意外。"
  },
  {
    "start": 64.90314558590387,
    "end": 66.6488134118509,
    "text": "可司机已经报了警："
  },
  {
    "start": 66.6488134118509,
    "end": 67.99487053065342,
    "text": "宅门打开时，"
  },
  {
    "start": 67.99487053065342,
    "end": 69.23576693704949,
    "text": "第一句话是："
  },
  {
    "start": 69.23576693704949,
    "end": 71.02349904795909,
    "text": "我想我害了一条命。"
  },
  {
    "start": 71.02349904795909,
    "end": 74.85134897955378,
    "text": "警方在浴室找到一块带深红痕迹的白布，"
  },
  {
    "start": 74.85134897955378,
    "end": 77.33314179234593,
    "text": "他手上检出射击残留物。"
  },
  {
    "start": 77.33314179234593,
    "end": 79.01571319084908,
    "text": "多名女性还指证，"
  },
  {
    "start": 79.01571319084908,
    "end": 80.29867388220774,
    "text": "曾被他威胁过。"
  },
  {
    "start": 81.48295825534413,
    "end": 83.89113856945177,
    "text": "法医撕开了「自杀」的说法："
  },
  {
    "start": 84.37487784652143,
    "end": 86.83563851683229,
    "text": "弹道向下倾斜——自己开枪，"
  },
  {
    "start": 86.83563851683229,
    "end": 89.29639918714315,
    "text": "枪口该是平的甚至朝上；"
  },
  {
    "start": 89.29639918714315,
    "end": 91.48374200519726,
    "text": "被后坐力崩落的牙齿，"
  },
  {
    "start": 91.48374200519726,
    "end": 93.12424911873784,
    "text": "在楼梯脚被发现。"
  },
  {
    "start": 93.12424911873784,
    "end": 94.36514552513391,
    "text": "验尸官结论："
  },
  {
    "start": 94.36514552513391,
    "end": 94.806820517241,
    "text": "他杀。"
  },
  {
    "start": 94.84888480220357,
    "end": 96.91003476536993,
    "text": "但辩护手里也有牌："
  },
  {
    "start": 96.93106690785122,
    "end": 100.80098112440848,
    "text": "夹克上只有十八个血点——这么近的距离，"
  },
  {
    "start": 100.80098112440848,
    "end": 102.94625965750001,
    "text": "人该被血雾糊满才对。"
  },
  {
    "start": 102.94625965750001,
    "end": 104.60779891352186,
    "text": "二零零七年一审，"
  },
  {
    "start": 104.60779891352186,
    "end": 106.39553102443146,
    "text": "陪审团十比二，"
  },
  {
    "start": 106.71101316165081,
    "end": 107.27888100864563,
    "text": "流审。"
  },
  {
    "start": 107.27888100864563,
    "end": 109.44519168421843,
    "text": "全案卡在一个问题上："
  },
  {
    "start": 109.44519168421843,
    "end": 111.25395593760933,
    "text": "血滴到底往哪儿飞？"
  },
  {
    "start": 112.49693313335757,
    "end": 113.83247418091945,
    "text": "硬核的部分来了。"
  },
  {
    "start": 113.83247418091945,
    "end": 115.62020629182905,
    "text": "血滴砸在表面，"
  },
  {
    "start": 115.62020629182905,
    "end": 116.04084914145484,
    "text": "宽除以长，"
  },
  {
    "start": 116.50355627604321,
    "end": 118.10199910462121,
    "text": "就是撞击角的正弦值；"
  },
  {
    "start": 118.29128838695281,
    "end": 120.24727763771273,
    "text": "多条轨迹连线，"
  },
  {
    "start": 120.35243835011917,
    "end": 123.02352044524294,
    "text": "汇聚到空中一点——开枪的位置。"
  },
  {
    "start": 123.02352044524294,
    "end": 124.93744541104027,
    "text": "后来流体力学算出："
  },
  {
    "start": 124.93744541104027,
    "end": 128.57600606030334,
    "text": "枪口燃气卷成约一百米每秒的涡环，"
  },
  {
    "start": 128.57600606030334,
    "end": 130.99470244565163,
    "text": "迎面撞上反向飞出的血雾，"
  },
  {
    "start": 131.01573458813291,
    "end": 132.46695241934188,
    "text": "把它推回去、"
  },
  {
    "start": 132.46695241934188,
    "end": 135.8110630738669,
    "text": "甚至掉头——开枪的人可以干干净净。"
  },
  {
    "start": 135.8110630738669,
    "end": 137.4305380449262,
    "text": "底牌「血太少」，"
  },
  {
    "start": 137.4305380449262,
    "end": 139.15517372839193,
    "text": "被这组方程撕碎。"
  },
  {
    "start": 139.3865272956861,
    "end": 140.8587772693764,
    "text": "袖口那十八个点，"
  },
  {
    "start": 140.8587772693764,
    "end": 143.88740578668205,
    "text": "恰好落在物理认定的开枪者身上。"
  },
  {
    "start": 143.88740578668205,
    "end": 145.50688075774133,
    "text": "二零零九年重审，"
  },
  {
    "start": 145.50688075774133,
    "end": 146.8319057340626,
    "text": "陪审团裁定："
  },
  {
    "start": 146.8319057340626,
    "end": 147.48390215098254,
    "text": "有罪。"
  },
  {
    "start": 148.60649223950716,
    "end": 149.64758329233098,
    "text": "二级谋杀，"
  },
  {
    "start": 149.71067971977484,
    "end": 151.56150825812833,
    "text": "十九年监禁至终身。"
  },
  {
    "start": 151.56150825812833,
    "end": 153.03375823181858,
    "text": "二零二一年，"
  },
  {
    "start": 153.03375823181858,
    "end": 155.76793675438623,
    "text": "八十一岁的斯佩克特在狱中去世；"
  },
  {
    "start": 155.76793675438623,
    "end": 156.94573673333844,
    "text": "四个月后，"
  },
  {
    "start": 157.09296173070746,
    "end": 160.10055810553183,
    "text": "那篇涡环论文发表——人不在了，"
  },
  {
    "start": 160.12159024801312,
    "end": 162.87680091306206,
    "text": "物理替这个案子写完了最后一页。"
  },
  {
    "start": 162.87680091306206,
    "end": 164.81175802134067,
    "text": "他一生砌起声音的墙，"
  },
  {
    "start": 164.85382230630324,
    "end": 168.1138043909031,
    "text": "最后却挡不住一滴血说出真相。"
  },
  {
    "start": 168.1138043909031,
    "end": 170.19598649655077,
    "text": "你相信有完美的犯罪，"
  },
  {
    "start": 170.19598649655077,
    "end": 172.57261859693648,
    "text": "还是只有还没追上的科学？"
  },
  {
    "start": 172.67777930934292,
    "end": 173.918675715739,
    "text": "评论区聊聊。"
  }
]