[
  {
    "start": 0.6,
    "end": 2.7347624618508783,
    "text": "十八个不到一毫米的血点，"
  },
  {
    "start": 2.7347624618508783,
    "end": 4.185980293059849,
    "text": "怎么给人定罪？"
  },
  {
    "start": 4.291141005466296,
    "end": 5.784423121637846,
    "text": "二零零三年凌晨，"
  },
  {
    "start": 5.784423121637846,
    "end": 9.02337306375642,
    "text": "洛杉矶山上的城堡宅邸一声枪响。"
  },
  {
    "start": 9.139049847403513,
    "end": 10.968846243275694,
    "text": "女演员死在门厅，"
  },
  {
    "start": 11.07400695568214,
    "end": 13.019480135201412,
    "text": "左轮手枪落在脚边，"
  },
  {
    "start": 13.12464084760786,
    "end": 14.649471177501345,
    "text": "枪上没有指纹。"
  },
  {
    "start": 14.754631889907792,
    "end": 16.342558647245145,
    "text": "宅子里的另一个人，"
  },
  {
    "start": 16.40565507468901,
    "end": 18.4247407528928,
    "text": "是乐坛活着的传奇，"
  },
  {
    "start": 18.519385394058602,
    "end": 18.971576457406325,
    "text": "他说："
  },
  {
    "start": 18.971576457406325,
    "end": 21.695238908733305,
    "text": "是她自己把枪放进嘴里的。"
  },
  {
    "start": 21.800399621139753,
    "end": 23.33574602227388,
    "text": "他把枪擦干净，"
  },
  {
    "start": 23.451422805920977,
    "end": 25.197090631867997,
    "text": "门厅擦得一尘不染。"
  },
  {
    "start": 25.31276741551509,
    "end": 26.332826325857628,
    "text": "可这些血点，"
  },
  {
    "start": 26.332826325857628,
    "end": 29.65590483790136,
    "text": "早已按流体力学的方程写好了真相。"
  },
  {
    "start": 29.76106555030781,
    "end": 31.96803836801111,
    "text": "这就是菲尔·斯佩克特案。"
  },
  {
    "start": 33.04803836801111,
    "end": 34.257386560685255,
    "text": "这个男人是谁？"
  },
  {
    "start": 34.42564370053557,
    "end": 36.02408652911357,
    "text": "菲尔·斯佩克特，"
  },
  {
    "start": 36.234407953926464,
    "end": 37.60149721521027,
    "text": "「声墙」发明人："
  },
  {
    "start": 37.85388292498575,
    "end": 39.78884003326438,
    "text": "把乐器一层层叠录，"
  },
  {
    "start": 39.95709717311469,
    "end": 41.70276499906171,
    "text": "砌成一面声音的墙。"
  },
  {
    "start": 41.87102213891203,
    "end": 43.637722107340345,
    "text": "五年二十首热单；"
  },
  {
    "start": 43.80597924719066,
    "end": 45.5095827881751,
    "text": "披头士告别专辑、"
  },
  {
    "start": 45.783000640431865,
    "end": 46.98183276186536,
    "text": "列侬的《想象》，"
  },
  {
    "start": 47.00286490434665,
    "end": 48.243761310742734,
    "text": "都出自他手。"
  },
  {
    "start": 48.34892202314918,
    "end": 49.1060791524756,
    "text": "另一边，"
  },
  {
    "start": 49.2953684348072,
    "end": 51.46167911038002,
    "text": "女演员拉娜·克拉克森，"
  },
  {
    "start": 51.48271125286131,
    "end": 52.30296480963159,
    "text": "四十岁，"
  },
  {
    "start": 52.40812552203804,
    "end": 54.04863263557861,
    "text": "当时在俱乐部工作。"
  },
  {
    "start": 54.21688977542893,
    "end": 55.73120403408177,
    "text": "当晚两人相识，"
  },
  {
    "start": 55.8784290314508,
    "end": 57.53996828747266,
    "text": "他提出送她回家。"
  },
  {
    "start": 58.73021176764542,
    "end": 60.328654596223416,
    "text": "汽车开进宅邸。"
  },
  {
    "start": 60.43381530862987,
    "end": 61.76935635619174,
    "text": "他的版本是："
  },
  {
    "start": 61.874517068598195,
    "end": 63.84102239059875,
    "text": "克拉克森自己开了枪，"
  },
  {
    "start": 63.925150960523915,
    "end": 64.92417772838516,
    "text": "一场意外。"
  },
  {
    "start": 65.03985451203225,
    "end": 66.61726519812896,
    "text": "可司机已经报了警："
  },
  {
    "start": 66.7224259105354,
    "end": 68.0579669580973,
    "text": "宅门打开时，"
  },
  {
    "start": 68.14209552802245,
    "end": 69.37247586317788,
    "text": "第一句话是："
  },
  {
    "start": 69.4460883618624,
    "end": 71.07607940416233,
    "text": "我想我害了一条命。"
  },
  {
    "start": 71.19175618780942,
    "end": 74.81980076583184,
    "text": "警方在浴室找到一块带深红痕迹的白布，"
  },
  {
    "start": 74.94599362071958,
    "end": 77.27004536490206,
    "text": "他手上检出射击残留物。"
  },
  {
    "start": 77.38572214854915,
    "end": 78.96313283464586,
    "text": "多名女性还指证，"
  },
  {
    "start": 78.96313283464586,
    "end": 80.40295825534413,
    "text": "曾被他威胁过。"
  },
  {
    "start": 81.48295825534413,
    "end": 83.87010642697048,
    "text": "法医撕开了「自杀」的说法："
  },
  {
    "start": 83.87010642697048,
    "end": 86.83563851683229,
    "text": "弹道向下倾斜——自己开枪，"
  },
  {
    "start": 86.89873494427616,
    "end": 89.25433490218057,
    "text": "枪口该是平的甚至朝上；"
  },
  {
    "start": 89.4015598995496,
    "end": 91.46270986271597,
    "text": "被后坐力崩落的牙齿，"
  },
  {
    "start": 91.46270986271597,
    "end": 92.95599197888751,
    "text": "在楼梯脚被发现。"
  },
  {
    "start": 93.14528126121913,
    "end": 94.34411338265262,
    "text": "验尸官结论："
  },
  {
    "start": 94.42824195257778,
    "end": 95.08023836949775,
    "text": "他杀。"
  },
  {
    "start": 95.22746336686677,
    "end": 97.14138833266412,
    "text": "但辩护手里也有牌："
  },
  {
    "start": 97.28861333003314,
    "end": 100.80098112440848,
    "text": "夹克上只有十八个血点——这么近的距离，"
  },
  {
    "start": 100.84304540937106,
    "end": 102.90419537253742,
    "text": "人该被血雾糊满才对。"
  },
  {
    "start": 103.03038822742516,
    "end": 104.56573462855928,
    "text": "二零零七年一审，"
  },
  {
    "start": 104.7339917684096,
    "end": 106.39553102443146,
    "text": "陪审团十比二，"
  },
  {
    "start": 106.56378816428179,
    "end": 107.23681672368305,
    "text": "流审。"
  },
  {
    "start": 107.36300957857078,
    "end": 109.36106311429327,
    "text": "全案卡在一个问题上："
  },
  {
    "start": 109.5082881116623,
    "end": 111.25395593760933,
    "text": "血滴到底往哪儿飞？"
  },
  {
    "start": 112.49693313335757,
    "end": 113.96918310704783,
    "text": "硬核的部分来了。"
  },
  {
    "start": 114.07434381945428,
    "end": 115.4414330807381,
    "text": "血滴砸在表面，"
  },
  {
    "start": 115.4414330807381,
    "end": 116.35633127867419,
    "text": "宽除以长，"
  },
  {
    "start": 116.35633127867419,
    "end": 118.65935088037537,
    "text": "就是撞击角的正弦值；"
  },
  {
    "start": 118.76451159278183,
    "end": 119.98437585669662,
    "text": "多条轨迹连线，"
  },
  {
    "start": 119.98437585669662,
    "end": 122.96042401779907,
    "text": "汇聚到空中一点——开枪的位置。"
  },
  {
    "start": 123.09713294392745,
    "end": 125.00054183848414,
    "text": "后来流体力学算出："
  },
  {
    "start": 125.10570255089058,
    "end": 128.64961855898787,
    "text": "枪口燃气卷成约一百米每秒的涡环，"
  },
  {
    "start": 128.76529534263494,
    "end": 131.27863636914904,
    "text": "迎面撞上反向飞出的血雾，"
  },
  {
    "start": 131.37328101031483,
    "end": 132.5405649180264,
    "text": "把它推回去、"
  },
  {
    "start": 132.5405649180264,
    "end": 135.88467557255143,
    "text": "甚至掉头——开枪的人可以干干净净。"
  },
  {
    "start": 135.98983628495787,
    "end": 137.4305380449262,
    "text": "底牌「血太少」，"
  },
  {
    "start": 137.54621482857328,
    "end": 139.13414158591064,
    "text": "被这组方程撕碎。"
  },
  {
    "start": 139.23930229831709,
    "end": 140.86929334061702,
    "text": "袖口那十八个点，"
  },
  {
    "start": 140.96393798178283,
    "end": 143.8032772167569,
    "text": "恰好落在物理认定的开枪者身上。"
  },
  {
    "start": 143.918954000404,
    "end": 145.46481647277875,
    "text": "二零零九年重审，"
  },
  {
    "start": 145.56997718518522,
    "end": 146.89500216150645,
    "text": "陪审团裁定："
  },
  {
    "start": 146.89500216150645,
    "end": 147.52649223950715,
    "text": "有罪。"
  },
  {
    "start": 148.60649223950716,
    "end": 149.64758329233098,
    "text": "二级谋杀，"
  },
  {
    "start": 149.71067971977484,
    "end": 151.56150825812833,
    "text": "十九年监禁至终身。"
  },
  {
    "start": 151.68770111301606,
    "end": 152.88653323444956,
    "text": "二零二一年，"
  },
  {
    "start": 152.90756537693085,
    "end": 155.76793675438623,
    "text": "八十一岁的斯佩克特在狱中去世；"
  },
  {
    "start": 155.91516175175525,
    "end": 156.94573673333844,
    "text": "四个月后，"
  },
  {
    "start": 157.05089744574488,
    "end": 160.05849382056925,
    "text": "那篇涡环论文发表——人不在了，"
  },
  {
    "start": 160.12159024801312,
    "end": 162.83473662809948,
    "text": "物理替这个案子写完了最后一页。"
  },
  {
    "start": 162.9609294829872,
    "end": 165.08517587359745,
    "text": "他一生砌起声音的墙，"
  },
  {
    "start": 165.25343301344776,
    "end": 168.05070796345925,
    "text": "最后却挡不住一滴血说出真相。"
  },
  {
    "start": 168.1558686758657,
    "end": 170.17495435406948,
    "text": "你相信有完美的犯罪，"
  },
  {
    "start": 170.25908292399464,
    "end": 172.5305543119739,
    "text": "还是只有还没追上的科学？"
  },
  {
    "start": 172.65674716686163,
    "end": 173.918675715739,
    "text": "评论区聊聊。"
  }
]