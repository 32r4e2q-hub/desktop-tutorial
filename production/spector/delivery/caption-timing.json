[
  {
    "start": 0.6,
    "end": 2.9055591809069212,
    "text": "十八个不到一毫米的血点，"
  },
  {
    "start": 3.1563731503779673,
    "end": 4.21750917506316,
    "text": "怎么给人定罪？"
  },
  {
    "start": 4.4297363800001985,
    "end": 5.683806227355428,
    "text": "二零零三年凌晨，"
  },
  {
    "start": 5.876740050025463,
    "end": 8.886507683678012,
    "text": "洛杉矶山上的城堡宅邸一声枪响。"
  },
  {
    "start": 8.98297459501303,
    "end": 10.73867238131035,
    "text": "女演员死在门厅，"
  },
  {
    "start": 10.931606203980387,
    "end": 12.687303990277707,
    "text": "左轮手枪落在脚边，"
  },
  {
    "start": 12.841651048413734,
    "end": 14.01854736670095,
    "text": "枪上没有指纹。"
  },
  {
    "start": 14.172894424836977,
    "end": 15.619898094862242,
    "text": "宅子里的另一个人，"
  },
  {
    "start": 15.77424515299827,
    "end": 17.68428999743162,
    "text": "是乐坛活着的传奇，"
  },
  {
    "start": 17.877223820101655,
    "end": 18.475318670378762,
    "text": "他说："
  },
  {
    "start": 18.6682524930488,
    "end": 21.46579292176431,
    "text": "是她自己把枪放进嘴里的。"
  },
  {
    "start": 21.46579292176431,
    "end": 23.0478502676586,
    "text": "他把枪擦干净，"
  },
  {
    "start": 23.163610561260622,
    "end": 25.01577525889296,
    "text": "门厅擦得一尘不染。"
  },
  {
    "start": 25.035068641159963,
    "end": 26.23125834171418,
    "text": "可这些血点，"
  },
  {
    "start": 26.443485546651218,
    "end": 29.877707590177845,
    "text": "早已按流体力学的方程写好了真相。"
  },
  {
    "start": 30.01276126604687,
    "end": 32.03856640408224,
    "text": "这就是菲尔·斯佩克特案。"
  },
  {
    "start": 33.22701129024136,
    "end": 34.5582546666646,
    "text": "这个男人是谁？"
  },
  {
    "start": 34.66436826913312,
    "end": 36.16925208595939,
    "text": "菲尔·斯佩克特，"
  },
  {
    "start": 36.265718997294414,
    "end": 37.92494987225672,
    "text": "「声墙」发明人："
  },
  {
    "start": 38.00212340132473,
    "end": 39.99898846595959,
    "text": "把乐器一层层叠录，"
  },
  {
    "start": 40.10510206842811,
    "end": 41.85115316359193,
    "text": "砌成一面声音的墙。"
  },
  {
    "start": 41.860799854725435,
    "end": 43.37533036268521,
    "text": "五年二十首热单；"
  },
  {
    "start": 43.49109065628723,
    "end": 45.24678844258455,
    "text": "披头士告别专辑、"
  },
  {
    "start": 45.24678844258455,
    "end": 46.30792446726974,
    "text": "列侬的《想象》，"
  },
  {
    "start": 46.30792446726974,
    "end": 47.59093438802548,
    "text": "都出自他手。"
  },
  {
    "start": 47.62952115255949,
    "end": 48.34337629643862,
    "text": "另一边，"
  },
  {
    "start": 48.420549825506626,
    "end": 50.93833621135059,
    "text": "女演员拉娜·克拉克森，"
  },
  {
    "start": 51.0348031226856,
    "end": 51.77759833996524,
    "text": "四十岁，"
  },
  {
    "start": 51.85477186903326,
    "end": 53.56223619966307,
    "text": "当时在俱乐部工作。"
  },
  {
    "start": 53.65870311099809,
    "end": 55.25040714802588,
    "text": "当晚两人相识，"
  },
  {
    "start": 55.3565207504944,
    "end": 56.98265141650487,
    "text": "他提出送她回家。"
  },
  {
    "start": 58.06265141650487,
    "end": 59.48071501312963,
    "text": "汽车开进宅邸。"
  },
  {
    "start": 59.69294221806667,
    "end": 60.79266500728587,
    "text": "他的版本是："
  },
  {
    "start": 60.83125177181988,
    "end": 62.87635029212225,
    "text": "克拉克森自己开了枪，"
  },
  {
    "start": 62.97281720345727,
    "end": 63.956779699074445,
    "text": "一场意外。"
  },
  {
    "start": 64.11112675721047,
    "end": 65.77035763217278,
    "text": "可司机已经报了警："
  },
  {
    "start": 65.9247046903088,
    "end": 67.23665468446504,
    "text": "宅门打开时，"
  },
  {
    "start": 67.23665468446504,
    "end": 68.35567085595125,
    "text": "第一句话是："
  },
  {
    "start": 68.39425762048526,
    "end": 70.42006275852063,
    "text": "我想我害了一条命。"
  },
  {
    "start": 70.59370319892366,
    "end": 74.54884656365938,
    "text": "警方在浴室找到一块带深红痕迹的白布，"
  },
  {
    "start": 74.58743332819338,
    "end": 77.19203993423886,
    "text": "他手上检出射击残留物。"
  },
  {
    "start": 77.19203993423886,
    "end": 78.61975022199712,
    "text": "多名女性还指证，"
  },
  {
    "start": 78.71621713333214,
    "end": 80.12463403882339,
    "text": "曾被他威胁过。"
  },
  {
    "start": 81.33486436912568,
    "end": 83.32208274262705,
    "text": "法医撕开了「自杀」的说法："
  },
  {
    "start": 83.42819634509556,
    "end": 85.94598273093952,
    "text": "弹道向下倾斜——自己开枪，"
  },
  {
    "start": 85.94598273093952,
    "end": 88.48306249905048,
    "text": "枪口该是平的甚至朝上；"
  },
  {
    "start": 88.5795294103855,
    "end": 90.43169410801784,
    "text": "被后坐力崩落的牙齿，"
  },
  {
    "start": 90.43169410801784,
    "end": 91.95587130711112,
    "text": "在楼梯脚被发现。"
  },
  {
    "start": 92.05233821844614,
    "end": 93.27746799240086,
    "text": "验尸官结论："
  },
  {
    "start": 93.34499483033537,
    "end": 94.010616518547,
    "text": "他杀。"
  },
  {
    "start": 94.087790047615,
    "end": 95.90136798071333,
    "text": "但辩护手里也有牌："
  },
  {
    "start": 95.91101467184684,
    "end": 101.52538891154487,
    "text": "夹克上只有十八个血点——这么近的距离，"
  },
  {
    "start": 101.63150251401339,
    "end": 103.4064936825777,
    "text": "人该被血雾糊满才对。"
  },
  {
    "start": 103.41614037371122,
    "end": 104.31328264912688,
    "text": "二零零七年一审，"
  },
  {
    "start": 104.31328264912688,
    "end": 105.67346609895063,
    "text": "陪审团十比二，"
  },
  {
    "start": 105.67346609895063,
    "end": 107.45810395864845,
    "text": "流审。"
  },
  {
    "start": 107.53527748771646,
    "end": 108.2201925581951,
    "text": "全案卡在一个问题上："
  },
  {
    "start": 108.2201925581951,
    "end": 109.48238170392102,
    "text": "血滴到底往哪儿飞？"
  },
  {
    "start": 110.5720283950545,
    "end": 111.83574493354324,
    "text": "硬核的部分来了。"
  },
  {
    "start": 111.94185853601175,
    "end": 113.40815558830403,
    "text": "血滴砸在表面，"
  },
  {
    "start": 113.51426919077254,
    "end": 114.71045889132677,
    "text": "宽除以长，"
  },
  {
    "start": 114.71045889132677,
    "end": 116.93884454316567,
    "text": "就是撞击角的正弦值；"
  },
  {
    "start": 117.03531145450069,
    "end": 118.54984196246046,
    "text": "多条轨迹连线，"
  },
  {
    "start": 118.65595556492899,
    "end": 121.31844231777546,
    "text": "汇聚到空中一点——开枪的位置。"
  },
  {
    "start": 121.40526253797698,
    "end": 123.59506142528188,
    "text": "后来流体力学算出："
  },
  {
    "start": 123.60470811641538,
    "end": 128.26405993389673,
    "text": "枪口燃气卷成约一百米每秒的涡环，"
  },
  {
    "start": 128.26405993389673,
    "end": 131.06160036261224,
    "text": "迎面撞上反向飞出的血雾，"
  },
  {
    "start": 131.08089374487926,
    "end": 132.14202976956443,
    "text": "把它推回去、"
  },
  {
    "start": 132.23849668089946,
    "end": 134.29324189233535,
    "text": "甚至掉头——开枪的人可以干干净净。"
  },
  {
    "start": 134.38970880367035,
    "end": 135.10356394754947,
    "text": "底牌「血太少」，"
  },
  {
    "start": 135.10356394754947,
    "end": 136.02964629636566,
    "text": "被这组方程撕碎。"
  },
  {
    "start": 136.14540658996768,
    "end": 137.8528709205975,
    "text": "袖口那十八个点，"
  },
  {
    "start": 137.9107510673985,
    "end": 140.6021778936455,
    "text": "恰好落在物理认定的开枪者身上。"
  },
  {
    "start": 140.6021778936455,
    "end": 142.51222273807883,
    "text": "二零零九年重审，"
  },
  {
    "start": 142.61833634054736,
    "end": 144.27756721550966,
    "text": "陪审团裁定："
  },
  {
    "start": 144.27756721550966,
    "end": 146.16944412497492,
    "text": "有罪。"
  },
  {
    "start": 147.2494441249749,
    "end": 148.22375992945857,
    "text": "二级谋杀，"
  },
  {
    "start": 148.49386728119663,
    "end": 150.11451139162492,
    "text": "十九年监禁至终身。"
  },
  {
    "start": 150.21097830295994,
    "end": 151.29140770991214,
    "text": "二零二一年，"
  },
  {
    "start": 151.48434153258216,
    "end": 154.22400181449666,
    "text": "八十一岁的斯佩克特在狱中去世；"
  },
  {
    "start": 154.41693563716672,
    "end": 155.28513783918186,
    "text": "四个月后，"
  },
  {
    "start": 155.40089813278388,
    "end": 158.60359958910647,
    "text": "那篇涡环论文发表——人不在了，"
  },
  {
    "start": 158.64218635364048,
    "end": 161.92206133903107,
    "text": "物理替这个案子写完了最后一页。"
  },
  {
    "start": 161.94135472129807,
    "end": 164.1793870642705,
    "text": "他一生砌起声音的墙，"
  },
  {
    "start": 164.2951473578725,
    "end": 167.28562160925804,
    "text": "最后却挡不住一滴血说出真相。"
  },
  {
    "start": 167.30491499152507,
    "end": 169.58153409903147,
    "text": "你相信有完美的犯罪，"
  },
  {
    "start": 169.7358811571675,
    "end": 172.514128203616,
    "text": "还是只有还没追上的科学？"
  },
  {
    "start": 172.68776864401906,
    "end": 173.96113187364128,
    "text": "评论区聊聊。"
  }
]