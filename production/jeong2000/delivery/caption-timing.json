[
  {
    "start": 0.6,
    "end": 3.0343675417661093,
    "text": "二零零零年四月十二日，"
  },
  {
    "start": 3.2062052505966587,
    "end": 5.554653937947494,
    "text": "韩国天安警方接到紧急报警："
  },
  {
    "start": 5.745584725536992,
    "end": 7.540334128878281,
    "text": "一户住宅遭到抢劫，"
  },
  {
    "start": 7.884009546539378,
    "end": 9.526014319809068,
    "text": "屋内女子可能被控制。"
  },
  {
    "start": 9.659665871121717,
    "end": 10.728878281622912,
    "text": "警员赶到后，"
  },
  {
    "start": 10.862529832935559,
    "end": 14.261097852028639,
    "text": "抓住了试图离开的三十一岁男子郑斗英。"
  },
  {
    "start": 14.299284009546538,
    "end": 14.948448687350835,
    "text": "起初，"
  },
  {
    "start": 15.311217183770882,
    "end": 17.16324582338902,
    "text": "这只像一次入室抢劫；"
  },
  {
    "start": 17.39236276849642,
    "end": 19.645346062052504,
    "text": "可当釜山警方赶来核对旧案，"
  },
  {
    "start": 19.778997613365156,
    "end": 21.077326968973747,
    "text": "真相迅速失控。"
  },
  {
    "start": 21.172792362768497,
    "end": 22.394749403341287,
    "text": "他们抓到的，"
  },
  {
    "start": 22.566587112171838,
    "end": 25.984248210023864,
    "text": "是十个月里连续夺走九条生命的人。"
  },
  {
    "start": 27.312458233890215,
    "end": 31.016515513126492,
    "text": "郑斗英并非第一次因暴力犯罪入狱。"
  },
  {
    "start": 31.121527446300718,
    "end": 32.09527446300716,
    "text": "一九八六年，"
  },
  {
    "start": 32.20028639618138,
    "end": 35.07379474940334,
    "text": "十八岁的他杀害一名巡逻人员，"
  },
  {
    "start": 35.178806682577566,
    "end": 38.63465393794749,
    "text": "服刑多年后又因盗窃反复进出监狱。"
  },
  {
    "start": 38.730119331742245,
    "end": 41.68954653937948,
    "text": "一九九九年三月再次获释后，"
  },
  {
    "start": 41.7945584725537,
    "end": 43.51293556085919,
    "text": "他把目标对准釜山、"
  },
  {
    "start": 43.51293556085919,
    "end": 45.39360381861575,
    "text": "蔚山等地的富裕住宅。"
  },
  {
    "start": 45.4890692124105,
    "end": 46.21460620525059,
    "text": "六月起，"
  },
  {
    "start": 46.310071599045344,
    "end": 49.135847255369924,
    "text": "不同城市陆续出现抢劫和命案；"
  },
  {
    "start": 49.23131264916468,
    "end": 50.2146062052506,
    "text": "地点分散、"
  },
  {
    "start": 50.2146062052506,
    "end": 51.25517899761336,
    "text": "现场各异，"
  },
  {
    "start": 51.35064439140811,
    "end": 54.62510739856802,
    "text": "警方最初没有认定它们来自同一个人。"
  },
  {
    "start": 55.70510739856802,
    "end": 57.05116945107398,
    "text": "公开报道显示，"
  },
  {
    "start": 57.24210023866348,
    "end": 59.18959427207637,
    "text": "他的目的主要是钱财。"
  },
  {
    "start": 59.28505966587112,
    "end": 61.423484486873505,
    "text": "他常在白天寻找住宅，"
  },
  {
    "start": 61.652601431980905,
    "end": 64.30653937947494,
    "text": "进入后搜掠现金和贵重物品；"
  },
  {
    "start": 64.65021479713604,
    "end": 65.71942720763722,
    "text": "一旦被发现，"
  },
  {
    "start": 65.85307875894988,
    "end": 68.65976133651552,
    "text": "犯罪便升级为致命暴力。"
  },
  {
    "start": 68.79341288782817,
    "end": 70.8745584725537,
    "text": "受害者既有屋主，"
  },
  {
    "start": 71.19914081145585,
    "end": 73.14663484486873,
    "text": "也有在住宅里工作的人员。"
  },
  {
    "start": 73.33756563245822,
    "end": 74.86501193317422,
    "text": "到二零零零年春，"
  },
  {
    "start": 75.09412887828162,
    "end": 77.27073985680191,
    "text": "相关案件已造成九人死亡、"
  },
  {
    "start": 77.30892601431981,
    "end": 78.32085918854415,
    "text": "十人受伤。"
  },
  {
    "start": 78.4545107398568,
    "end": 81.83398568019092,
    "text": "警方掌握了幸存者描述与公开通缉线索，"
  },
  {
    "start": 82.04400954653937,
    "end": 85.4998568019093,
    "text": "却仍缺少把所有现场连成一线的关键证据。"
  },
  {
    "start": 86.90443914081145,
    "end": 87.9545584725537,
    "text": "四月十二日，"
  },
  {
    "start": 87.97365155131264,
    "end": 90.07389021479713,
    "text": "郑斗英进入天安一处住宅，"
  },
  {
    "start": 90.32210023866348,
    "end": 92.88057279236276,
    "text": "要求屋内女子联系丈夫送钱。"
  },
  {
    "start": 93.18606205250596,
    "end": 94.9999045346062,
    "text": "丈夫从电话中察觉异常，"
  },
  {
    "start": 95.1526491646778,
    "end": 96.33642004773269,
    "text": "没有独自回家，"
  },
  {
    "start": 96.603723150358,
    "end": 97.97842482100238,
    "text": "而是立即报警。"
  },
  {
    "start": 98.18844868735083,
    "end": 100.17412887828162,
    "text": "警方在住宅周围布控，"
  },
  {
    "start": 100.36505966587112,
    "end": 102.9617183770883,
    "text": "并安排人员带着准备好的钱进入。"
  },
  {
    "start": 103.17174224343674,
    "end": 104.48916467780428,
    "text": "郑斗英拿到钱、"
  },
  {
    "start": 104.64190930787589,
    "end": 105.78749403341288,
    "text": "走出房门时，"
  },
  {
    "start": 105.88295942720762,
    "end": 107.56315035799523,
    "text": "被守候的警员控制。"
  },
  {
    "start": 107.62042959427207,
    "end": 110.0070644391408,
    "text": "这场看似偶然的现场处置，"
  },
  {
    "start": 110.1216229116945,
    "end": 113.65384248210023,
    "text": "终于给持续十个月的调查打开突破口。"
  },
  {
    "start": 114.97727923627683,
    "end": 116.87704057279235,
    "text": "后续审讯和核查中，"
  },
  {
    "start": 116.98205250596656,
    "end": 119.14911694510738,
    "text": "郑斗英供述了多起案件。"
  },
  {
    "start": 119.2541288782816,
    "end": 120.628830548926,
    "text": "韩国媒体统计，"
  },
  {
    "start": 120.73384248210021,
    "end": 124.31379474940333,
    "text": "从一九九九年六月到二零零零年四月，"
  },
  {
    "start": 124.41880668257755,
    "end": 126.95818615751789,
    "text": "他在多地涉及二十三起强盗、"
  },
  {
    "start": 127.06319809069211,
    "end": 128.54291169451074,
    "text": "杀人相关犯罪，"
  },
  {
    "start": 128.63837708830548,
    "end": 129.68849642004773,
    "text": "九人死亡，"
  },
  {
    "start": 129.7266825775656,
    "end": 130.77680190930786,
    "text": "十人受伤。"
  },
  {
    "start": 130.8722673031026,
    "end": 133.21116945107397,
    "text": "二零零零年七月二十一日，"
  },
  {
    "start": 133.3066348448687,
    "end": 136.0178520286396,
    "text": "釜山地方法院一审判处死刑；"
  },
  {
    "start": 136.12286396181383,
    "end": 137.34482100238662,
    "text": "十一月三十日，"
  },
  {
    "start": 137.44028639618136,
    "end": 138.70997613365154,
    "text": "二审维持原判。"
  },
  {
    "start": 138.80544152744628,
    "end": 140.4665393794749,
    "text": "他放弃继续上诉，"
  },
  {
    "start": 140.56200477326968,
    "end": 142.79112171837707,
    "text": "死刑判决随后确定。"
  },
  {
    "start": 143.87112171837708,
    "end": 146.19093078758948,
    "text": "案件并未从公众记忆中消失。"
  },
  {
    "start": 146.381861575179,
    "end": 147.66109785202863,
    "text": "二零一六年八月，"
  },
  {
    "start": 147.92840095465394,
    "end": 150.8305489260143,
    "text": "关押在大田监狱的郑斗英试图逃脱。"
  },
  {
    "start": 150.86873508353221,
    "end": 154.03818615751788,
    "text": "他越过三重围墙中的两道后触发警报，"
  },
  {
    "start": 154.2291169451074,
    "end": 156.19570405727922,
    "text": "在最后一道围墙前被控制，"
  },
  {
    "start": 156.38663484486872,
    "end": 159.7470167064439,
    "text": "后来又因逃跑未遂被加刑十个月。"
  },
  {
    "start": 159.88066825775655,
    "end": 160.7398568019093,
    "text": "九条生命，"
  },
  {
    "start": 160.94988066825775,
    "end": 162.63007159904532,
    "text": "不是凶手传奇的注脚，"
  },
  {
    "start": 162.89737470167063,
    "end": 165.81861575178996,
    "text": "而是九个再也无法回家的普通人。"
  },
  {
    "start": 165.81861575178996,
    "end": 167.23150357995226,
    "text": "真正该记住的，"
  },
  {
    "start": 167.4415274463007,
    "end": 168.87350835322195,
    "text": "是报警者的警觉、"
  },
  {
    "start": 169.0835322195704,
    "end": 170.43914081145584,
    "text": "幸存者的勇气，"
  },
  {
    "start": 170.43914081145584,
    "end": 173.85680190930788,
    "text": "以及那些不该被名字遮住的受害者。"
  }
]