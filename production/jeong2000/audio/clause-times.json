{
 "N01": {
  "duration": 26.8,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.34,
    "text": "二零零零年四月十二日",
    "chars_per_second": 4.57
   },
   {
    "i": 1,
    "start": 2.68,
    "end": 5.14,
    "text": "韩国天安警方接到紧急报警",
    "chars_per_second": 4.88
   },
   {
    "i": 2,
    "start": 5.49,
    "end": 7.21,
    "text": "一户住宅遭到抢劫",
    "chars_per_second": 4.65
   },
   {
    "i": 3,
    "start": 7.56,
    "end": 9.24,
    "text": "屋内女子可能被控制",
    "chars_per_second": 5.36
   },
   {
    "i": 4,
    "start": 9.59,
    "end": 10.49,
    "text": "警员赶到后",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 10.8,
    "end": 14.22,
    "text": "抓住了试图离开的三十一岁男子郑斗英",
    "chars_per_second": 4.97
   },
   {
    "i": 6,
    "start": 14.57,
    "end": 15.18,
    "text": "起初",
    "chars_per_second": 3.28
   },
   {
    "i": 7,
    "start": 15.53,
    "end": 17.33,
    "text": "这只像一次入室抢劫",
    "chars_per_second": 5.0
   },
   {
    "i": 8,
    "start": 17.68,
    "end": 19.86,
    "text": "可当釜山警方赶来核对旧案",
    "chars_per_second": 5.5
   },
   {
    "i": 9,
    "start": 20.13,
    "end": 21.33,
    "text": "真相迅速失控",
    "chars_per_second": 5.0
   },
   {
    "i": 10,
    "start": 21.68,
    "end": 22.73,
    "text": "他们抓到的",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 23.02,
    "end": 26.8,
    "text": "是十个月里连续夺走九条生命的人",
    "chars_per_second": 3.97
   }
  ]
 },
 "N02": {
  "duration": 28.66,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 3.78,
    "text": "郑斗英并非第一次因暴力犯罪入狱",
    "chars_per_second": 4.12
   },
   {
    "i": 1,
    "start": 4.13,
    "end": 4.91,
    "text": "一九八六年",
    "chars_per_second": 6.41
   },
   {
    "i": 2,
    "start": 5.26,
    "end": 8.03,
    "text": "十八岁的他杀害一名巡逻人员",
    "chars_per_second": 4.69
   },
   {
    "i": 3,
    "start": 8.38,
    "end": 11.76,
    "text": "服刑多年后又因盗窃反复进出监狱",
    "chars_per_second": 4.44
   },
   {
    "i": 4,
    "start": 12.1,
    "end": 14.96,
    "text": "一九九九年三月再次获释后",
    "chars_per_second": 4.2
   },
   {
    "i": 5,
    "start": 15.31,
    "end": 16.91,
    "text": "他把目标对准釜山",
    "chars_per_second": 5.0
   },
   {
    "i": 6,
    "start": 17.11,
    "end": 18.84,
    "text": "蔚山等地的富裕住宅",
    "chars_per_second": 5.2
   },
   {
    "i": 7,
    "start": 19.18,
    "end": 19.7,
    "text": "六月起",
    "chars_per_second": 5.77
   },
   {
    "i": 8,
    "start": 20.04,
    "end": 22.76,
    "text": "不同城市陆续出现抢劫和命案",
    "chars_per_second": 4.78
   },
   {
    "i": 9,
    "start": 23.1,
    "end": 23.93,
    "text": "地点分散",
    "chars_per_second": 4.82
   },
   {
    "i": 10,
    "start": 24.13,
    "end": 24.98,
    "text": "现场各异",
    "chars_per_second": 4.71
   },
   {
    "i": 11,
    "start": 25.32,
    "end": 28.66,
    "text": "警方最初没有认定它们来自同一个人",
    "chars_per_second": 4.79
   }
  ]
 },
 "N03": {
  "duration": 31.28,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.52,
    "text": "公开报道显示",
    "chars_per_second": 4.35
   },
   {
    "i": 1,
    "start": 1.8,
    "end": 3.66,
    "text": "他的目的主要是钱财",
    "chars_per_second": 4.84
   },
   {
    "i": 2,
    "start": 4.06,
    "end": 6.0,
    "text": "他常在白天寻找住宅",
    "chars_per_second": 4.64
   },
   {
    "i": 3,
    "start": 6.3,
    "end": 9.04,
    "text": "进入后搜掠现金和贵重物品",
    "chars_per_second": 4.38
   },
   {
    "i": 4,
    "start": 9.38,
    "end": 10.43,
    "text": "一旦被发现",
    "chars_per_second": 4.76
   },
   {
    "i": 5,
    "start": 10.73,
    "end": 13.5,
    "text": "犯罪便升级为致命暴力",
    "chars_per_second": 3.61
   },
   {
    "i": 6,
    "start": 13.85,
    "end": 15.95,
    "text": "受害者既有屋主",
    "chars_per_second": 3.33
   },
   {
    "i": 7,
    "start": 16.23,
    "end": 18.22,
    "text": "也有在住宅里工作的人员",
    "chars_per_second": 5.53
   },
   {
    "i": 8,
    "start": 18.56,
    "end": 20.03,
    "text": "到二零零零年春",
    "chars_per_second": 4.76
   },
   {
    "i": 9,
    "start": 20.35,
    "end": 22.51,
    "text": "相关案件已造成九人死亡",
    "chars_per_second": 5.09
   },
   {
    "i": 10,
    "start": 22.76,
    "end": 23.59,
    "text": "十人受伤",
    "chars_per_second": 4.82
   },
   {
    "i": 11,
    "start": 23.94,
    "end": 27.26,
    "text": "警方掌握了幸存者描述与公开通缉线索",
    "chars_per_second": 5.12
   },
   {
    "i": 12,
    "start": 27.61,
    "end": 31.28,
    "text": "却仍缺少把所有现场连成一线的关键证据",
    "chars_per_second": 4.9
   }
  ]
 },
 "N04": {
  "duration": 28.495,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.06,
    "text": "四月十二日",
    "chars_per_second": 5.49
   },
   {
    "i": 1,
    "start": 1.41,
    "end": 3.54,
    "text": "郑斗英进入天安一处住宅",
    "chars_per_second": 5.16
   },
   {
    "i": 2,
    "start": 3.89,
    "end": 6.48,
    "text": "要求屋内女子联系丈夫送钱",
    "chars_per_second": 4.63
   },
   {
    "i": 3,
    "start": 6.82,
    "end": 8.73,
    "text": "丈夫从电话中察觉异常",
    "chars_per_second": 5.24
   },
   {
    "i": 4,
    "start": 9.02,
    "end": 10.05,
    "text": "没有独自回家",
    "chars_per_second": 5.83
   },
   {
    "i": 5,
    "start": 10.4,
    "end": 11.84,
    "text": "而是立即报警",
    "chars_per_second": 4.17
   },
   {
    "i": 6,
    "start": 12.18,
    "end": 14.14,
    "text": "警方在住宅周围布控",
    "chars_per_second": 4.59
   },
   {
    "i": 7,
    "start": 14.47,
    "end": 17.02,
    "text": "并安排人员带着准备好的钱进入",
    "chars_per_second": 5.49
   },
   {
    "i": 8,
    "start": 17.37,
    "end": 18.67,
    "text": "郑斗英拿到钱",
    "chars_per_second": 4.62
   },
   {
    "i": 9,
    "start": 18.95,
    "end": 19.93,
    "text": "走出房门时",
    "chars_per_second": 5.1
   },
   {
    "i": 10,
    "start": 20.27,
    "end": 21.76,
    "text": "被守候的警员控制",
    "chars_per_second": 5.37
   },
   {
    "i": 11,
    "start": 22.08,
    "end": 24.37,
    "text": "这场看似偶然的现场处置",
    "chars_per_second": 4.8
   },
   {
    "i": 12,
    "start": 24.62,
    "end": 28.5,
    "text": "终于给持续十个月的调查打开突破口",
    "chars_per_second": 4.13
   }
  ]
 },
 "N05": {
  "duration": 29.185,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.89,
    "text": "后续审讯和核查中",
    "chars_per_second": 4.57
   },
   {
    "i": 1,
    "start": 2.24,
    "end": 4.27,
    "text": "郑斗英供述了多起案件",
    "chars_per_second": 4.93
   },
   {
    "i": 2,
    "start": 4.62,
    "end": 5.82,
    "text": "韩国媒体统计",
    "chars_per_second": 5.0
   },
   {
    "i": 3,
    "start": 6.17,
    "end": 9.68,
    "text": "从一九九九年六月到二零零零年四月",
    "chars_per_second": 4.56
   },
   {
    "i": 4,
    "start": 10.03,
    "end": 12.45,
    "text": "他在多地涉及二十三起强盗",
    "chars_per_second": 4.96
   },
   {
    "i": 5,
    "start": 12.8,
    "end": 14.11,
    "text": "杀人相关犯罪",
    "chars_per_second": 4.58
   },
   {
    "i": 6,
    "start": 14.45,
    "end": 15.31,
    "text": "九人死亡",
    "chars_per_second": 4.65
   },
   {
    "i": 7,
    "start": 15.59,
    "end": 16.45,
    "text": "十人受伤",
    "chars_per_second": 4.65
   },
   {
    "i": 8,
    "start": 16.79,
    "end": 19.0,
    "text": "二零零零年七月二十一日",
    "chars_per_second": 4.98
   },
   {
    "i": 9,
    "start": 19.34,
    "end": 21.94,
    "text": "釜山地方法院一审判处死刑",
    "chars_per_second": 4.62
   },
   {
    "i": 10,
    "start": 22.29,
    "end": 23.33,
    "text": "十一月三十日",
    "chars_per_second": 5.77
   },
   {
    "i": 11,
    "start": 23.67,
    "end": 24.76,
    "text": "二审维持原判",
    "chars_per_second": 5.5
   },
   {
    "i": 12,
    "start": 25.1,
    "end": 26.6,
    "text": "他放弃继续上诉",
    "chars_per_second": 4.67
   },
   {
    "i": 13,
    "start": 26.94,
    "end": 29.18,
    "text": "死刑判决随后确定",
    "chars_per_second": 3.56
   }
  ]
 },
 "N06": {
  "duration": 31.56,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.32,
    "text": "案件并未从公众记忆中消失",
    "chars_per_second": 5.53
   },
   {
    "i": 1,
    "start": 2.66,
    "end": 3.92,
    "text": "二零一六年八月",
    "chars_per_second": 5.56
   },
   {
    "i": 2,
    "start": 4.27,
    "end": 7.2,
    "text": "关押在大田监狱的郑斗英试图逃脱",
    "chars_per_second": 5.12
   },
   {
    "i": 3,
    "start": 7.55,
    "end": 10.54,
    "text": "他越过三重围墙中的两道后触发警报",
    "chars_per_second": 5.35
   },
   {
    "i": 4,
    "start": 10.9,
    "end": 12.79,
    "text": "在最后一道围墙前被控制",
    "chars_per_second": 5.82
   },
   {
    "i": 5,
    "start": 13.14,
    "end": 16.52,
    "text": "后来又因逃跑未遂被加刑十个月",
    "chars_per_second": 4.14
   },
   {
    "i": 6,
    "start": 16.86,
    "end": 17.64,
    "text": "九条生命",
    "chars_per_second": 5.13
   },
   {
    "i": 7,
    "start": 17.99,
    "end": 19.6,
    "text": "不是凶手传奇的注脚",
    "chars_per_second": 5.59
   },
   {
    "i": 8,
    "start": 19.94,
    "end": 22.81,
    "text": "而是九个再也无法回家的普通人",
    "chars_per_second": 4.88
   },
   {
    "i": 9,
    "start": 23.11,
    "end": 24.35,
    "text": "真正该记住的",
    "chars_per_second": 4.84
   },
   {
    "i": 10,
    "start": 24.71,
    "end": 26.13,
    "text": "是报警者的警觉",
    "chars_per_second": 4.93
   },
   {
    "i": 11,
    "start": 26.48,
    "end": 27.74,
    "text": "幸存者的勇气",
    "chars_per_second": 4.76
   },
   {
    "i": 12,
    "start": 28.08,
    "end": 31.56,
    "text": "以及那些不该被名字遮住的受害者",
    "chars_per_second": 4.31
   }
  ]
 }
}