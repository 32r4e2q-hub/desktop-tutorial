          "source_seconds": 4.598,
          "natural_clip_seconds": 4.35,
          "natural_speech_seconds": 4.24,
          "spoken_seconds": 4.24,
          "tempo_factor": 1.0,
          "speech_start": 0.03,
          "speech_end": 4.27,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "两个男人戴着铅面具，并排躺在山顶的草丛里，纹丝不动。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 5.329,
          "natural_clip_seconds": 5.12,
          "natural_speech_seconds": 5.01,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.048,
          "speech_start": 5.03,
          "speech_end": 9.81,
          "characters": 23,
          "target_chars_per_second": 4.6
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "他们叫米格尔和曼努埃尔，在坎普斯市修电视和收音机。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 6.095,
          "natural_clip_seconds": 5.86,
          "natural_speech_seconds": 5.75,
          "spoken_seconds": 5.75,
          "tempo_factor": 1.0,
          "speech_start": 10.03,
          "speech_end": 15.78,
          "characters": 23,
          "target_chars_per_second": 3.286
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "两个人靠给电视台装天线、修收音机吃饭，也上门修电器。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 6.8,
          "natural_clip_seconds": 6.49,
          "natural_speech_seconds": 6.38,
          "spoken_seconds": 6.38,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 23.41,
          "characters": 23,
          "target_chars_per_second": 3.286
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "八月十七号，他们对妻子说，去圣保罗买车和仪器。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 5.793,
          "natural_clip_seconds": 5.57,
          "natural_speech_seconds": 5.46,
          "spoken_seconds": 5.46,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 29.49,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "可当天下午，他们却出现在一百公里外的尼泰罗伊车站。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 5.921,
          "natural_clip_seconds": 5.62,
          "natural_speech_seconds": 5.51,
          "spoken_seconds": 4.8,
          "tempo_factor": 1.1527,
          "speech_start": 30.03,
          "speech_end": 34.83,
          "characters": 23,
          "target_chars_per_second": 4.6
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "尼泰罗伊郊外有座荒山，叫文廷山，山顶光秃秃的，没有路灯。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 7.5,
          "natural_clip_seconds": 7.13,
          "natural_speech_seconds": 7.02,
          "spoken_seconds": 6.73,
          "tempo_factor": 1.043,
          "speech_start": 35.03,
          "speech_end": 41.76,
          "characters": 24,
          "target_chars_per_second": 3.429
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "八月二十号下午，一个十八岁的少年抱着风筝，一个人沿着小路走上山顶。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 6.5,
          "natural_clip_seconds": 6.16,
          "natural_speech_seconds": 6.05,
          "spoken_seconds": 6.05,
          "tempo_factor": 1.0,
          "speech_start": 42.03,
          "speech_end": 48.08,
          "characters": 30,
          "target_chars_per_second": 4.286
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "他刚站上山顶，就看见草丛里并排躺着两个男人，一动不动。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 5.41,
          "natural_clip_seconds": 5.21,
          "natural_speech_seconds": 5.1,
          "spoken_seconds": 5.1,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 54.13,
          "characters": 24,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "他僵在原地，手里的风筝线滑落，风筝飘向天空。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 5.6,
          "natural_clip_seconds": 5.33,
          "natural_speech_seconds": 5.22,
          "spoken_seconds": 4.76,
          "tempo_factor": 1.0833,
          "speech_start": 55.03,
          "speech_end": 59.79,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "警方封锁了现场，草地上没有血迹，只有两处浅浅的人形压痕。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 6.095,
          "natural_clip_seconds": 5.94,
          "natural_speech_seconds": 5.83,
          "spoken_seconds": 5.83,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 65.86,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "他们穿着西装，外面套着雨衣，身边只有一只空水瓶。",
          "start": 67.0,
          "duration": 6.0,
          "source_seconds": 5.41,
          "natural_clip_seconds": 5.18,
          "natural_speech_seconds": 5.07,
          "spoken_seconds": 5.07,
          "tempo_factor": 1.0,
          "speech_start": 67.03,
          "speech_end": 72.1,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "铅灰色的眼罩，映着最后一点红光。",
          "start": 73.0,
          "duration": 4.0,
          "source_seconds": 3.541,
          "natural_clip_seconds": 3.32,
          "natural_speech_seconds": 3.21,
          "spoken_seconds": 3.21,
          "tempo_factor": 1.0,
          "speech_start": 73.03,
          "speech_end": 76.24,
          "characters": 14,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "笔记本上写着：十六点三十到达，十八点三十服下胶囊，然后等待信号。",
          "start": 77.0,
          "duration": 8.0,
          "source_seconds": 6.78,
          "natural_clip_seconds": 6.6,
          "natural_speech_seconds": 6.49,
          "spoken_seconds": 6.49,
          "tempo_factor": 1.0,
          "speech_start": 77.03,
          "speech_end": 83.52,
          "characters": 28,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "警局里，几名探员围着地图争论了一整夜：究竟是谁，把他们叫上那座山？",
          "start": 85.0,
          "duration": 7.0,
          "source_seconds": 6.908,
          "natural_clip_seconds": 6.7,
          "natural_speech_seconds": 6.59,
          "spoken_seconds": 6.59,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 91.62,
          "characters": 29,
          "target_chars_per_second": 4.143
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "医生摘下眼镜：没有枪伤，没有刀伤，也没有任何打斗的痕迹。",
          "start": 92.0,
          "duration": 7.0,
          "source_seconds": 6.397,
          "natural_clip_seconds": 6.25,
          "natural_speech_seconds": 6.14,
          "spoken_seconds": 6.14,
          "tempo_factor": 1.0,
          "speech_start": 92.03,
          "speech_end": 98.17,
          "characters": 24,
          "target_chars_per_second": 3.429
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "时间太久，毒物检测做不了；铅板上也没有放射性。",
          "start": 99.0,
          "duration": 6.0,
          "source_seconds": 5.12,
          "natural_clip_seconds": 5.02,
          "natural_speech_seconds": 4.91,
          "spoken_seconds": 4.91,
          "tempo_factor": 1.0,
          "speech_start": 99.03,
          "speech_end": 103.94,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "两条路线都通向山顶，可死因却谁也说不清。",
          "start": 105.0,
          "duration": 5.0,
          "source_seconds": 4.899,
          "natural_clip_seconds": 4.63,
          "natural_speech_seconds": 4.52,
          "spoken_seconds": 4.52,
          "tempo_factor": 1.0,
          "speech_start": 105.03,
          "speech_end": 109.55,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "有渔民说，那晚山顶上空有过一团红橙色的光，还带着低低的嗡鸣。",
          "start": 110.0,
          "duration": 7.0,
          "source_seconds": 7.21,
          "natural_clip_seconds": 6.95,
          "natural_speech_seconds": 6.84,
          "spoken_seconds": 6.79,
          "tempo_factor": 1.0108,
          "speech_start": 110.03,
          "speech_end": 116.82,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "第一种说法：他们是来找外星人的，那铅面具就是为了挡住强光。",
          "start": 117.0,
          "duration": 7.0,
          "source_seconds": 6.304,
          "natural_clip_seconds": 6.12,
          "natural_speech_seconds": 6.01,
          "spoken_seconds": 6.01,
          "tempo_factor": 1.0,
          "speech_start": 117.03,
          "speech_end": 123.04,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "两位技师痴迷实验和神秘学，桌上堆满图纸、线圈和旧书。",
          "start": 124.0,
          "duration": 6.0,
          "source_seconds": 6.014,
          "natural_clip_seconds": 5.84,
          "natural_speech_seconds": 5.73,
          "spoken_seconds": 5.73,
          "tempo_factor": 1.0,
          "speech_start": 124.03,
          "speech_end": 129.76,
          "characters": 23,
          "target_chars_per_second": 3.833
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "他们在等天上一个信号——可这，只是传闻罢了。",
          "start": 130.0,
          "duration": 5.0,
          "source_seconds": 4.598,
          "natural_clip_seconds": 4.46,
          "natural_speech_seconds": 4.35,
          "spoken_seconds": 4.35,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 134.38,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "第二种说法：某个神秘团体用药物做实验，他们乖乖吞下了胶囊。",
          "start": 135.0,
          "duration": 7.0,
          "source_seconds": 6.177,
          "natural_clip_seconds": 6.119,
          "natural_speech_seconds": 6.03,
          "spoken_seconds": 6.03,
          "tempo_factor": 1.0,
          "speech_start": 135.03,
          "speech_end": 141.06,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "第三种说法：有人利用他们对飞碟的痴迷，一步步把他们骗上山。",
          "start": 142.0,
          "duration": 7.0,
          "source_seconds": 6.014,
          "natural_clip_seconds": 5.84,
          "natural_speech_seconds": 5.73,
          "spoken_seconds": 5.73,
          "tempo_factor": 1.0,
          "speech_start": 142.03,
          "speech_end": 147.76,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "可这三种说法，一个也没有被证实过，警方也没留下证据。",
          "start": 149.0,
          "duration": 6.0,
          "source_seconds": 5.4,
          "natural_clip_seconds": 5.03,
          "natural_speech_seconds": 4.92,
          "spoken_seconds": 4.92,
          "tempo_factor": 1.0,
          "speech_start": 149.03,
          "speech_end": 153.95,
          "characters": 23,
          "target_chars_per_second": 3.833
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "六十多年过去，案件始终没有定论，山顶上只剩野草。",
          "start": 155.0,
          "duration": 6.0,
          "source_seconds": 6.223,
          "natural_clip_seconds": 5.98,
          "natural_speech_seconds": 5.87,
          "spoken_seconds": 5.77,
          "tempo_factor": 1.0169,
          "speech_start": 155.03,
          "speech_end": 160.8,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "两位妻子守着一台老收音机，在窗前等了很多年。",
          "start": 161.0,
          "duration": 6.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.39,
          "natural_speech_seconds": 5.28,
          "spoken_seconds": 5.28,
          "tempo_factor": 1.0,
          "speech_start": 161.03,
          "speech_end": 166.31,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "字条上的信号、金属、胶囊和面具，全都没有答案。",
          "start": 167.0,
          "duration": 5.0,
          "source_seconds": 5.793,
          "natural_clip_seconds": 5.56,
          "natural_speech_seconds": 5.45,
          "spoken_seconds": 4.81,
          "tempo_factor": 1.1301,
          "speech_start": 167.03,
          "speech_end": 171.84,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "到今天，仍然没人知道答案。你觉得，那晚他们究竟在等什么？评论区告诉我。",
          "start": 172.0,
          "duration": 8.0,
          "source_seconds": 7.21,
          "natural_clip_seconds": 6.99,
          "natural_speech_seconds": 6.88,
          "spoken_seconds": 6.88,
          "tempo_factor": 1.0,
          "speech_start": 172.03,
          "speech_end": 178.91,
          "characters": 30,
          "target_chars_per_second": 3.75
        }
      ],
