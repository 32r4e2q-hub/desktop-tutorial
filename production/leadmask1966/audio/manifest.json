  "clips": [
    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "一九六六年，巴西，山顶上亮起一道红光。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "用户试听选定的中文男声；悬疑叙事，沉稳有磁性",
