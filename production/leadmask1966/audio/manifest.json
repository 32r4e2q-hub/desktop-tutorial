      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "两条路线都通向山顶，可死因却谁也说不清。",
      "sha256": "f11a65f7402d6bf47e1d9a32a90d0d647411cbed0269291367c34800186e3045",
