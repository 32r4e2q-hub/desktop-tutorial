      "narration_id": "N05",
      "target_start": 92,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "时间太久，毒物检测做不了；铅板上也没有放射性。",
      "sha256": "3c08802390f310b357ec6f2b73dbd80bf82e335d684ab04f45ea6a7b60710f44",
      "voice_id": "voice-01",
      "voice_description": "用户重选的低沉悬疑男声；叙事沉稳、气压低、句尾收得很轻",
      "narration_id": "N05",
