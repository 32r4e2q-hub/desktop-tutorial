      "target_start": 99,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "死因，成了第一个说不清的谜。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "用户试听选定的中文男声；悬疑叙事，沉稳有磁性",
      "narration_id": "N05",
