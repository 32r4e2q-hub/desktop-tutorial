      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "验尸报告写着：没有枪伤，没有刀伤，没有打斗痕迹。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "用户试听选定的中文男声；悬疑叙事，沉稳有磁性",
      "narration_id": "N05",
