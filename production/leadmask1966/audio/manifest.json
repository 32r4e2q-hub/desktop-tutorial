      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "常见毒物查不出来，铅板上也没有放射性。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "用户试听选定的中文男声；悬疑叙事，沉稳有磁性",
