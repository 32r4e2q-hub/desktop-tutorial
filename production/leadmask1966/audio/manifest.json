      "voice_id": "voice-00",
      "voice_description": "用户试听选定的中文男声；悬疑叙事，沉稳有磁性",
      "narration_id": "N07",
      "target_start": 149,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S26",
      "file": "S26.mp3",
