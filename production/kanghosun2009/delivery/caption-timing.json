[
  {
    "start": 0.6102747855310531,
    "end": 3.1789711682943356,
    "text": "二〇〇八年十二月十九日下午，"
  },
  {
    "start": 3.2817190236048672,
    "end": 4.781837711138624,
    "text": "京畿道军浦市，"
  },
  {
    "start": 4.874310780918101,
    "end": 8.21361607851037,
    "text": "一名女大学生在保健所前下了公交车，"
  },
  {
    "start": 8.24444043510353,
    "end": 9.415765985643585,
    "text": "再也没有出来。"
  },
  {
    "start": 9.518513840954116,
    "end": 10.566541965121536,
    "text": "二十多天后，"
  },
  {
    "start": 10.669289820432068,
    "end": 15.334042451530188,
    "text": "警方发现一辆黑色轿车反复出现在她回家的那条路上。"
  },
  {
    "start": 15.447065092371771,
    "end": 19.721375873289876,
    "text": "而先把警方目光拽过去的，"
  },
  {
    "start": 19.82412372860041,
    "end": 21.73523383737629,
    "text": "是一台自动取款机的摄像头："
  },
  {
    "start": 21.73523383737629,
    "end": 22.731888033888442,
    "text": "有人用她的信用卡取钱，"
  },
  {
    "start": 22.82436110366792,
    "end": 24.519700716291684,
    "text": "戴着假发，"
  },
  {
    "start": 24.519700716291688,
    "end": 25.711575837893847,
    "text": "手指上套着避孕套，"
  },
  {
    "start": 25.762949765549113,
    "end": 26.096880295308342,
    "text": "怕留下指纹。"
  },
  {
    "start": 26.096880295308342,
    "end": 26.543833465909152,
    "text": "这个人，"
  },
  {
    "start": 26.656856106750737,
    "end": 28.846477120827732,
    "text": "正是车主三十九岁的儿子。"
  },
  {
    "start": 29.926477120827734,
    "end": 31.23137488327148,
    "text": "要读懂这条线，"
  },
  {
    "start": 31.282748810926748,
    "end": 32.61847092996366,
    "text": "得回到三年前。"
  },
  {
    "start": 32.73149357080524,
    "end": 35.0638698863543,
    "text": "二〇〇五年十月三十日夜里，"
  },
  {
    "start": 35.17689252719588,
    "end": 37.47844448615179,
    "text": "京畿道安山一栋住宅起火，"
  },
  {
    "start": 37.58119234146231,
    "end": 39.90329387148032,
    "text": "他的妻子和岳母死在火里，"
  },
  {
    "start": 40.006041726790855,
    "end": 41.58835869857303,
    "text": "他从火里逃了出来。"
  },
  {
    "start": 41.58835869857303,
    "end": 42.7802338201752,
    "text": "起火前一周，"
  },
  {
    "start": 42.7802338201752,
    "end": 45.24618234762795,
    "text": "他刚给妻子买了大额人寿保险；"
  },
  {
    "start": 45.34893020293848,
    "end": 46.03734083351904,
    "text": "事后，"
  },
  {
    "start": 46.03734083351904,
    "end": 49.099226921772875,
    "text": "约四亿八千万韩元理赔金进了他的账户。"
  },
  {
    "start": 49.181425206021295,
    "end": 49.808187123415536,
    "text": "他说，"
  },
  {
    "start": 49.808187123415536,
    "end": 50.93841353183139,
    "text": "这是一场意外。"
  },
  {
    "start": 51.03088660161086,
    "end": 51.28188493386944,
    "text": "三年后，"
  },
  {
    "start": 51.28188493386944,
    "end": 51.811770301970896,
    "text": "法院认定："
  },
  {
    "start": 51.811770301970896,
    "end": 53.55848384224993,
    "text": "这是纵火，"
  },
  {
    "start": 53.55848384224993,
    "end": 54.50230851648992,
    "text": "是谋杀。"
  },
  {
    "start": 55.582308516489924,
    "end": 57.626990837169494,
    "text": "放火之后的第十一个月，"
  },
  {
    "start": 57.75028826354213,
    "end": 60.051840222498036,
    "text": "二〇〇六年九月七日清晨，"
  },
  {
    "start": 60.15458807780857,
    "end": 61.50058498237653,
    "text": "江原道旌善，"
  },
  {
    "start": 61.53140933896969,
    "end": 65.8262696909499,
    "text": "一位二十三岁的郡政府女职员在上班路上上了他的车，"
  },
  {
    "start": 65.93929233179148,
    "end": 67.21336573764206,
    "text": "当晚没有回家。"
  },
  {
    "start": 67.32638837848366,
    "end": 68.59018699880319,
    "text": "此后两年多，"
  },
  {
    "start": 68.68266006858266,
    "end": 71.32327995006332,
    "text": "京畿道西南部的一个个公交站、"
  },
  {
    "start": 71.4363025909049,
    "end": 72.9261464929076,
    "text": "夜路和家门口，"
  },
  {
    "start": 73.00834477715603,
    "end": 74.55983739234506,
    "text": "女人们接连消失。"
  },
  {
    "start": 74.55983739234506,
    "end": 77.33402948572939,
    "text": "她们年纪从十九岁到五十二岁，"
  },
  {
    "start": 77.44705212657098,
    "end": 80.22124421995532,
    "text": "职业各不相同——唯一的共同点，"
  },
  {
    "start": 80.28289293314165,
    "end": 82.38922396700754,
    "text": "是独自走在回家的路上，"
  },
  {
    "start": 82.49197182231808,
    "end": 84.65209563959966,
    "text": "而没有人把她们连成一条线。"
  },
  {
    "start": 85.73209563959966,
    "end": 87.11919168629184,
    "text": "警方把车辆、"
  },
  {
    "start": 87.11919168629184,
    "end": 89.15359922144036,
    "text": "银行和监控拼在一起。"
  },
  {
    "start": 89.23579750568878,
    "end": 90.63316833791201,
    "text": "他提前一步动手："
  },
  {
    "start": 90.74619097875359,
    "end": 92.2771340228805,
    "text": "一月二十四日凌晨，"
  },
  {
    "start": 92.2771340228805,
    "end": 94.19851891718744,
    "text": "他烧掉那辆黑色轿车，"
  },
  {
    "start": 94.26016763037376,
    "end": 95.94523245746647,
    "text": "格式化了家里的硬盘。"
  },
  {
    "start": 96.03770552724595,
    "end": 96.94188665397863,
    "text": "当天傍晚，"
  },
  {
    "start": 96.94188665397863,
    "end": 98.56530276788502,
    "text": "警方把他紧急逮捕。"
  },
  {
    "start": 98.6577758376645,
    "end": 100.75383208599933,
    "text": "而在国科搜的实验室里，"
  },
  {
    "start": 100.86685472684093,
    "end": 103.01428490283102,
    "text": "一件夹克右侧的袖口上，"
  },
  {
    "start": 103.07593361601735,
    "end": 106.45633805573382,
    "text": "检出一点几乎看不见的血痕——只有一滴，"
  },
  {
    "start": 106.55908591104435,
    "end": 109.78536856779505,
    "text": "DNA 却与另一名失踪女性完全相同。"
  },
  {
    "start": 109.78536856779505,
    "end": 110.80257233536929,
    "text": "这一点血，"
  },
  {
    "start": 110.83339669196246,
    "end": 112.98369524557998,
    "text": "成了整条证据链的锁扣。"
  },
  {
    "start": 114.1253439587663,
    "end": 116.20085063603904,
    "text": "一开始，"
  },
  {
    "start": 116.26249934922535,
    "end": 117.05365783511644,
    "text": "他只反问一句："
  },
  {
    "start": 117.16668047595802,
    "end": 117.98866331844228,
    "text": "证据呢。"
  },
  {
    "start": 117.99893810397333,
    "end": 118.94421837283022,
    "text": "第六天，"
  },
  {
    "start": 118.98531751495443,
    "end": 120.45461184589503,
    "text": "他开口了，"
  },
  {
    "start": 120.56763448673661,
    "end": 121.57456346877981,
    "text": "供出七起杀人。"
  },
  {
    "start": 121.57456346877981,
    "end": 123.20825436821727,
    "text": "几周之后，"
  },
  {
    "start": 123.32127700905885,
    "end": 125.59200461142159,
    "text": "他又主动补上一句——我藏了一件："
  },
  {
    "start": 125.69475246673213,
    "end": 127.32844336616957,
    "text": "二〇〇六年旌善那位女职员，"
  },
  {
    "start": 127.44146600701116,
    "end": 128.2018001363091,
    "text": "也是我。"
  },
  {
    "start": 128.31482277715068,
    "end": 130.0204371753055,
    "text": "那是物证最少的一起，"
  },
  {
    "start": 130.09236067402287,
    "end": 131.55138021943242,
    "text": "是他自己交出来的。"
  },
  {
    "start": 131.55138021943242,
    "end": 133.05149890696617,
    "text": "二〇〇九年二月，"
  },
  {
    "start": 133.12342240568353,
    "end": 134.52079323790676,
    "text": "他被以杀人、"
  },
  {
    "start": 134.53106802343783,
    "end": 135.30167693826678,
    "text": "纵火、"
  },
  {
    "start": 135.3222265093289,
    "end": 137.83954896443691,
    "text": "保险诈骗等罪名起诉；"
  },
  {
    "start": 137.94229681974744,
    "end": 138.96977537285275,
    "text": "四月八日，"
  },
  {
    "start": 139.08279801369434,
    "end": 141.87828888125244,
    "text": "检方在结审庭上请求死刑。"
  },
  {
    "start": 143.01993759443874,
    "end": 144.97214684533884,
    "text": "二〇〇九年四月二十二日，"
  },
  {
    "start": 145.08516948618043,
    "end": 149.19508369860168,
    "text": "水原地方法院安山支院认定他杀害十名女性，"
  },
  {
    "start": 149.2978315539122,
    "end": 150.77740067038386,
    "text": "包括妻子和岳母，"
  },
  {
    "start": 150.77740067038386,
    "end": 151.8870775077376,
    "text": "判处死刑；"
  },
  {
    "start": 152.00010014857918,
    "end": 155.35995501723355,
    "text": "七月二十三日，"
  },
  {
    "start": 155.47297765807514,
    "end": 156.69567713627046,
    "text": "首尔高等法院维持判决；"
  },
  {
    "start": 156.69567713627046,
    "end": 157.80307068795062,
    "text": "他放弃上告，"
  },
  {
    "start": 157.80307068795062,
    "end": 158.9047560254469,
    "text": "死刑确定。"
  },
  {
    "start": 158.9047560254469,
    "end": 161.38097933843068,
    "text": "十七年过去，"
  },
  {
    "start": 161.47345240821016,
    "end": 163.17906680636497,
    "text": "韩国没有再执行过一次死刑，"
  },
  {
    "start": 163.28181466167553,
    "end": 164.7511089926161,
    "text": "他还关在拘留所里。"
  },
  {
    "start": 164.8435820623956,
    "end": 168.28563521529838,
    "text": "而在他的牛棚里，"
  },
  {
    "start": 168.34728392848473,
    "end": 170.15564618195006,
    "text": "一把镐头的镐刃上检出两名女性的 DNA，"
  },
  {
    "start": 170.15564618195006,
    "end": 172.22087807369175,
    "text": "至今没有对上任何人。"
  },
  {
    "start": 172.3133511434712,
    "end": 173.15588355701757,
    "text": "十个人是被认定的数字；"
  },
  {
    "start": 173.15588355701757,
    "end": 173.530913228901,
    "text": "不确定的，"
  },
  {
    "start": 173.530913228901,
    "end": 173.99999999999997,
    "text": "还在那里。"
  }
]