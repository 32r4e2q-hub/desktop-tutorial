[
  {
    "start": 0.682198284248425,
    "end": 3.065948527452751,
    "text": "二〇〇八年十二月十九日下午，"
  },
  {
    "start": 3.353642522322239,
    "end": 4.668815070297039,
    "text": "京畿道军浦市，"
  },
  {
    "start": 4.9462342796354735,
    "end": 8.100593437668785,
    "text": "一名女大学生在保健所前下了公交车，"
  },
  {
    "start": 8.3163639338209,
    "end": 9.302743344802,
    "text": "再也没有出来。"
  },
  {
    "start": 9.590437339671487,
    "end": 10.45351932427995,
    "text": "二十多天后，"
  },
  {
    "start": 10.74121331914944,
    "end": 15.2210198106886,
    "text": "警方发现一辆黑色轿车反复出现在她回家的那条路上。"
  },
  {
    "start": 15.518988591089142,
    "end": 17.481472627520294,
    "text": "而先把警方目光拽过去的，"
  },
  {
    "start": 17.512296984113455,
    "end": 19.60835323244829,
    "text": "是一台自动取款机的摄像头："
  },
  {
    "start": 19.89604722731778,
    "end": 21.67358512418997,
    "text": "有人用她的信用卡取钱，"
  },
  {
    "start": 21.80715733609366,
    "end": 22.618865393046857,
    "text": "戴着假发，"
  },
  {
    "start": 22.896284602385293,
    "end": 24.4066780754501,
    "text": "手指上套着避孕套，"
  },
  {
    "start": 24.59162421500906,
    "end": 25.598553197052265,
    "text": "怕留下指纹。"
  },
  {
    "start": 25.834873264266488,
    "end": 26.43081082506757,
    "text": "这个人，"
  },
  {
    "start": 26.72877960546811,
    "end": 28.846477120827732,
    "text": "正是车主三十九岁的儿子。"
  },
  {
    "start": 29.998400619545105,
    "end": 31.118352242429896,
    "text": "要读懂这条线，"
  },
  {
    "start": 31.35467230964412,
    "end": 32.50544828912207,
    "text": "得回到三年前。"
  },
  {
    "start": 32.80341706952261,
    "end": 34.95084724551271,
    "text": "二〇〇五年十月三十日夜里，"
  },
  {
    "start": 35.24881602591326,
    "end": 37.3654218453102,
    "text": "京畿道安山一栋住宅起火，"
  },
  {
    "start": 37.65311584017969,
    "end": 39.79027123063874,
    "text": "他的妻子和岳母死在火里，"
  },
  {
    "start": 40.07796522550822,
    "end": 41.50616041432461,
    "text": "他从火里逃了出来。"
  },
  {
    "start": 41.66028219729041,
    "end": 42.677485964864665,
    "text": "起火前一周，"
  },
  {
    "start": 42.85215731889257,
    "end": 45.133159706786365,
    "text": "他刚给妻子买了大额人寿保险；"
  },
  {
    "start": 45.42085370165585,
    "end": 45.95514254927062,
    "text": "事后，"
  },
  {
    "start": 46.109264332236414,
    "end": 48.98620428093129,
    "text": "约四亿八千万韩元理赔金进了他的账户。"
  },
  {
    "start": 49.25334870473867,
    "end": 49.74653841022922,
    "text": "他说，"
  },
  {
    "start": 49.88011062213292,
    "end": 50.825390890989794,
    "text": "这是一场意外。"
  },
  {
    "start": 51.102810100328234,
    "end": 51.75012158878458,
    "text": "三年后，"
  },
  {
    "start": 51.88369380068828,
    "end": 52.6440279299862,
    "text": "法院认定："
  },
  {
    "start": 52.746775785296734,
    "end": 53.48656034353256,
    "text": "这是纵火，"
  },
  {
    "start": 53.6304073409673,
    "end": 54.50230851648992,
    "text": "是谋杀。"
  },
  {
    "start": 55.63368244414519,
    "end": 57.51396819632791,
    "text": "放火之后的第十一个月，"
  },
  {
    "start": 57.822211762259506,
    "end": 59.93881758165645,
    "text": "二〇〇六年九月七日清晨，"
  },
  {
    "start": 60.22651157652594,
    "end": 61.387562341534945,
    "text": "江原道旌善，"
  },
  {
    "start": 61.603332837687056,
    "end": 65.71324705010831,
    "text": "一位二十三岁的郡政府女职员在上班路上上了他的车，"
  },
  {
    "start": 66.01121583050885,
    "end": 67.10034309680049,
    "text": "当晚没有回家。"
  },
  {
    "start": 67.39831187720102,
    "end": 68.4771643579616,
    "text": "此后两年多，"
  },
  {
    "start": 68.75458356730003,
    "end": 71.21025730922173,
    "text": "京畿道西南部的一个个公交站、"
  },
  {
    "start": 71.50822608962227,
    "end": 72.81312385206601,
    "text": "夜路和家门口，"
  },
  {
    "start": 73.08026827587341,
    "end": 74.47763910809662,
    "text": "女人们接连消失。"
  },
  {
    "start": 74.63176089106243,
    "end": 77.22100684488781,
    "text": "她们年纪从十九岁到五十二岁，"
  },
  {
    "start": 77.51897562528836,
    "end": 78.77249946007683,
    "text": "职业各不相同——"
  },
  {
    "start": 79.06019345494633,
    "end": 80.10822157911375,
    "text": "唯一的共同点，"
  },
  {
    "start": 80.35481643185902,
    "end": 82.27620132616596,
    "text": "是独自走在回家的路上，"
  },
  {
    "start": 82.56389532103545,
    "end": 84.65209563959966,
    "text": "而没有人把她们连成一条线。"
  },
  {
    "start": 85.80401913831703,
    "end": 87.0164438309813,
    "text": "警方把车辆、"
  },
  {
    "start": 87.19111518500921,
    "end": 89.04057658059877,
    "text": "银行和监控拼在一起。"
  },
  {
    "start": 89.30772100440615,
    "end": 90.52014569707042,
    "text": "他提前一步动手："
  },
  {
    "start": 90.81811447747096,
    "end": 92.21548530969419,
    "text": "一月二十四日凌晨，"
  },
  {
    "start": 92.34905752159789,
    "end": 94.08549627634585,
    "text": "他烧掉那辆黑色轿车，"
  },
  {
    "start": 94.33209112909114,
    "end": 95.83220981662488,
    "text": "格式化了家里的硬盘。"
  },
  {
    "start": 96.10962902596333,
    "end": 96.86996315526126,
    "text": "当天傍晚，"
  },
  {
    "start": 97.013810152696,
    "end": 98.45228012704344,
    "text": "警方把他紧急逮捕。"
  },
  {
    "start": 98.72969933638187,
    "end": 100.64080944515776,
    "text": "而在国科搜的实验室里，"
  },
  {
    "start": 100.9387782255583,
    "end": 102.90126226198944,
    "text": "一件夹克右侧的袖口上，"
  },
  {
    "start": 103.14785711473472,
    "end": 105.37748557497324,
    "text": "检出一点几乎看不见的血痕——"
  },
  {
    "start": 105.59325607112537,
    "end": 106.34331541489223,
    "text": "只有一滴，"
  },
  {
    "start": 106.63100940976173,
    "end": 109.67234592695345,
    "text": "DNA 却与另一名失踪女性完全相同。"
  },
  {
    "start": 109.85729206651241,
    "end": 110.68954969452771,
    "text": "这一点血，"
  },
  {
    "start": 110.90532019067983,
    "end": 112.98369524557998,
    "text": "成了整条证据链的锁扣。"
  },
  {
    "start": 114.19726745748368,
    "end": 114.90622765912633,
    "text": "一开始，"
  },
  {
    "start": 115.01925029996792,
    "end": 116.08782799519744,
    "text": "他只反问一句："
  },
  {
    "start": 116.33442284794272,
    "end": 116.94063519427486,
    "text": "证据呢。"
  },
  {
    "start": 117.2386039746754,
    "end": 117.87564067760069,
    "text": "第六天，"
  },
  {
    "start": 118.0708616026907,
    "end": 118.83119573198863,
    "text": "他开口了，"
  },
  {
    "start": 119.0572410136718,
    "end": 120.34158920505344,
    "text": "供出七起杀人。"
  },
  {
    "start": 120.63955798545398,
    "end": 121.4923651845314,
    "text": "几周之后，"
  },
  {
    "start": 121.6464869674972,
    "end": 123.09523172737568,
    "text": "他又主动补上一句——"
  },
  {
    "start": 123.39320050777621,
    "end": 124.24600770685363,
    "text": "我藏了一件："
  },
  {
    "start": 124.53370170172312,
    "end": 127.21542072532799,
    "text": "二〇〇六年旌善那位女职员，"
  },
  {
    "start": 127.51338950572853,
    "end": 128.0887774954675,
    "text": "也是我。"
  },
  {
    "start": 128.38674627586803,
    "end": 129.9074145344639,
    "text": "那是物证最少的一起，"
  },
  {
    "start": 130.16428417274022,
    "end": 131.48973150624607,
    "text": "是他自己交出来的。"
  },
  {
    "start": 131.62330371814977,
    "end": 132.93847626612458,
    "text": "二〇〇九年二月，"
  },
  {
    "start": 133.1953459044009,
    "end": 134.40777059706517,
    "text": "他被以杀人、"
  },
  {
    "start": 134.60299152215518,
    "end": 135.18865429742522,
    "text": "纵火、"
  },
  {
    "start": 135.39415000804627,
    "end": 137.72652632359532,
    "text": "保险诈骗等罪名起诉；"
  },
  {
    "start": 138.01422031846482,
    "end": 138.8567527320112,
    "text": "四月八日，"
  },
  {
    "start": 139.15472151241173,
    "end": 141.87828888125244,
    "text": "检方在结审庭上请求死刑。"
  },
  {
    "start": 143.09186109315613,
    "end": 144.85912420449725,
    "text": "二〇〇九年四月二十二日，"
  },
  {
    "start": 145.1570929848978,
    "end": 149.0820610577601,
    "text": "水原地方法院安山支院认定他杀害十名女性，"
  },
  {
    "start": 149.36975505262959,
    "end": 150.71575195719754,
    "text": "包括妻子和岳母，"
  },
  {
    "start": 150.84932416910124,
    "end": 151.77405486689602,
    "text": "判处死刑；"
  },
  {
    "start": 152.07202364729656,
    "end": 153.14060134252608,
    "text": "七月二十三日，"
  },
  {
    "start": 153.2433491978366,
    "end": 155.24693237639198,
    "text": "首尔高等法院维持判决；"
  },
  {
    "start": 155.54490115679252,
    "end": 156.59292928095994,
    "text": "他放弃上告，"
  },
  {
    "start": 156.76760063498784,
    "end": 157.69233133278263,
    "text": "死刑确定。"
  },
  {
    "start": 157.75398004596894,
    "end": 158.82255774119847,
    "text": "十七年过去，"
  },
  {
    "start": 158.97667952416427,
    "end": 161.2679566975891,
    "text": "韩国没有再执行过一次死刑，"
  },
  {
    "start": 161.54537590692755,
    "end": 163.0660441655234,
    "text": "他还关在拘留所里。"
  },
  {
    "start": 163.35373816039288,
    "end": 164.63808635177452,
    "text": "而在他的牛棚里，"
  },
  {
    "start": 164.91550556111298,
    "end": 168.17261257445682,
    "text": "一把镐头的镐刃上检出两名女性的 DNA，"
  },
  {
    "start": 168.41920742720208,
    "end": 170.06317311217057,
    "text": "至今没有对上任何人。"
  },
  {
    "start": 170.22756968066744,
    "end": 172.10785543285016,
    "text": "十个人是被认定的数字；"
  },
  {
    "start": 172.3852746421886,
    "end": 173.09423484383126,
    "text": "不确定的，"
  },
  {
    "start": 173.22780705573496,
    "end": 173.99999999999997,
    "text": "还在那里。"
  }
]