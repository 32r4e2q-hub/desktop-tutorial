{
 "N01": {
  "duration": 27.491,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 2.36,
    "text": "二〇〇八年十二月十九日下午",
    "chars_per_second": 4.87
   },
   {
    "i": 1,
    "start": 2.7,
    "end": 3.92,
    "text": "京畿道军浦市",
    "chars_per_second": 4.92
   },
   {
    "i": 2,
    "start": 4.25,
    "end": 7.26,
    "text": "一名女大学生在保健所前下了公交车",
    "chars_per_second": 5.32
   },
   {
    "i": 3,
    "start": 7.53,
    "end": 8.43,
    "text": "再也没有出来",
    "chars_per_second": 6.67
   },
   {
    "i": 4,
    "start": 8.77,
    "end": 9.55,
    "text": "二十多天后",
    "chars_per_second": 6.41
   },
   {
    "i": 5,
    "start": 9.89,
    "end": 14.19,
    "text": "警方发现一辆黑色轿车反复出现在她回家的那条路上",
    "chars_per_second": 5.35
   },
   {
    "i": 6,
    "start": 14.54,
    "end": 18.46,
    "text": "而先把警方目光拽过去的",
    "chars_per_second": 2.81
   },
   {
    "i": 7,
    "start": 18.8,
    "end": 20.47,
    "text": "是一台自动取款机的摄像头",
    "chars_per_second": 7.19
   },
   {
    "i": 8,
    "start": 20.66,
    "end": 21.39,
    "text": "有人用她的信用卡取钱",
    "chars_per_second": 13.7
   },
   {
    "i": 9,
    "start": 21.72,
    "end": 23.13,
    "text": "戴着假发",
    "chars_per_second": 2.84
   },
   {
    "i": 10,
    "start": 23.37,
    "end": 24.29,
    "text": "手指上套着避孕套",
    "chars_per_second": 8.7
   },
   {
    "i": 11,
    "start": 24.58,
    "end": 25.1,
    "text": "怕留下指纹，这个人",
    "chars_per_second": 15.38
   },
   {
    "i": 12,
    "start": 25.45,
    "end": 27.49,
    "text": "正是车主三十九岁的儿子",
    "chars_per_second": 5.39
   }
  ]
 },
 "N02": {
  "duration": 23.919,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.12,
    "text": "要读懂这条线",
    "chars_per_second": 5.83
   },
   {
    "i": 1,
    "start": 1.41,
    "end": 2.47,
    "text": "得回到三年前",
    "chars_per_second": 5.66
   },
   {
    "i": 2,
    "start": 2.82,
    "end": 4.85,
    "text": "二〇〇五年十月三十日夜里",
    "chars_per_second": 4.93
   },
   {
    "i": 3,
    "start": 5.2,
    "end": 7.2,
    "text": "京畿道安山一栋住宅起火",
    "chars_per_second": 5.5
   },
   {
    "i": 4,
    "start": 7.54,
    "end": 9.56,
    "text": "他的妻子和岳母死在火里",
    "chars_per_second": 5.45
   },
   {
    "i": 5,
    "start": 9.9,
    "end": 11.23,
    "text": "他从火里逃了出来",
    "chars_per_second": 6.02
   },
   {
    "i": 6,
    "start": 11.44,
    "end": 12.37,
    "text": "起火前一周",
    "chars_per_second": 5.38
   },
   {
    "i": 7,
    "start": 12.6,
    "end": 14.76,
    "text": "他刚给妻子买了大额人寿保险",
    "chars_per_second": 6.02
   },
   {
    "i": 8,
    "start": 15.1,
    "end": 15.56,
    "text": "事后",
    "chars_per_second": 4.35
   },
   {
    "i": 9,
    "start": 15.77,
    "end": 18.51,
    "text": "约四亿八千万韩元理赔金进了他的账户",
    "chars_per_second": 6.2
   },
   {
    "i": 10,
    "start": 18.83,
    "end": 19.25,
    "text": "他说",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 19.44,
    "end": 20.3,
    "text": "这是一场意外",
    "chars_per_second": 6.98
   },
   {
    "i": 12,
    "start": 20.63,
    "end": 21.2,
    "text": "三年后，法院认定",
    "chars_per_second": 12.28
   },
   {
    "i": 13,
    "start": 21.39,
    "end": 22.89,
    "text": "这是纵火",
    "chars_per_second": 2.67
   },
   {
    "i": 14,
    "start": 23.09,
    "end": 23.92,
    "text": "是谋杀",
    "chars_per_second": 3.62
   }
  ]
 },
 "N03": {
  "duration": 28.292,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 1.84,
    "text": "放火之后的第十一个月",
    "chars_per_second": 5.65
   },
   {
    "i": 1,
    "start": 2.2,
    "end": 4.2,
    "text": "二〇〇六年九月七日清晨",
    "chars_per_second": 4.5
   },
   {
    "i": 2,
    "start": 4.54,
    "end": 5.61,
    "text": "江原道旌善",
    "chars_per_second": 4.67
   },
   {
    "i": 3,
    "start": 5.88,
    "end": 9.82,
    "text": "一位二十三岁的郡政府女职员在上班路上上了他的车",
    "chars_per_second": 5.84
   },
   {
    "i": 4,
    "start": 10.17,
    "end": 11.17,
    "text": "当晚没有回家",
    "chars_per_second": 6.0
   },
   {
    "i": 5,
    "start": 11.52,
    "end": 12.51,
    "text": "此后两年多",
    "chars_per_second": 5.05
   },
   {
    "i": 6,
    "start": 12.84,
    "end": 15.17,
    "text": "京畿道西南部的一个个公交站",
    "chars_per_second": 5.58
   },
   {
    "i": 7,
    "start": 15.52,
    "end": 16.73,
    "text": "夜路和家门口",
    "chars_per_second": 4.96
   },
   {
    "i": 8,
    "start": 17.05,
    "end": 18.35,
    "text": "女人们接连消失",
    "chars_per_second": 5.38
   },
   {
    "i": 9,
    "start": 18.56,
    "end": 21.02,
    "text": "她们年纪从十九岁到五十二岁",
    "chars_per_second": 5.28
   },
   {
    "i": 10,
    "start": 21.37,
    "end": 22.53,
    "text": "职业各不相同",
    "chars_per_second": 5.17
   },
   {
    "i": 11,
    "start": 22.87,
    "end": 23.83,
    "text": "唯一的共同点",
    "chars_per_second": 6.25
   },
   {
    "i": 12,
    "start": 24.13,
    "end": 25.94,
    "text": "是独自走在回家的路上",
    "chars_per_second": 5.52
   },
   {
    "i": 13,
    "start": 26.28,
    "end": 28.29,
    "text": "而没有人把她们连成一条线",
    "chars_per_second": 5.96
   }
  ]
 },
 "N04": {
  "duration": 26.523,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.21,
    "text": "警方把车辆",
    "chars_per_second": 4.46
   },
   {
    "i": 1,
    "start": 1.44,
    "end": 3.18,
    "text": "银行和监控拼在一起",
    "chars_per_second": 5.17
   },
   {
    "i": 2,
    "start": 3.5,
    "end": 4.62,
    "text": "他提前一步动手",
    "chars_per_second": 6.25
   },
   {
    "i": 3,
    "start": 4.97,
    "end": 6.27,
    "text": "一月二十四日凌晨",
    "chars_per_second": 6.15
   },
   {
    "i": 4,
    "start": 6.46,
    "end": 8.09,
    "text": "他烧掉那辆黑色轿车",
    "chars_per_second": 5.52
   },
   {
    "i": 5,
    "start": 8.39,
    "end": 9.79,
    "text": "格式化了家里的硬盘",
    "chars_per_second": 6.43
   },
   {
    "i": 6,
    "start": 10.12,
    "end": 10.8,
    "text": "当天傍晚",
    "chars_per_second": 5.88
   },
   {
    "i": 7,
    "start": 11.0,
    "end": 12.34,
    "text": "警方把他紧急逮捕",
    "chars_per_second": 5.97
   },
   {
    "i": 8,
    "start": 12.67,
    "end": 14.47,
    "text": "而在国科搜的实验室里",
    "chars_per_second": 5.56
   },
   {
    "i": 9,
    "start": 14.82,
    "end": 16.67,
    "text": "一件夹克右侧的袖口上",
    "chars_per_second": 5.41
   },
   {
    "i": 10,
    "start": 16.97,
    "end": 19.08,
    "text": "检出一点几乎看不见的血痕",
    "chars_per_second": 5.69
   },
   {
    "i": 11,
    "start": 19.35,
    "end": 20.02,
    "text": "只有一滴",
    "chars_per_second": 5.97
   },
   {
    "i": 12,
    "start": 20.36,
    "end": 23.26,
    "text": "DNA 却与另一名失踪女性完全相同",
    "chars_per_second": 5.52
   },
   {
    "i": 13,
    "start": 23.5,
    "end": 24.25,
    "text": "这一点血",
    "chars_per_second": 5.33
   },
   {
    "i": 14,
    "start": 24.52,
    "end": 26.52,
    "text": "成了整条证据链的锁扣",
    "chars_per_second": 4.99
   }
  ]
 },
 "N05": {
  "duration": 27.071,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.93,
    "text": "一开始",
    "chars_per_second": 1.69
   },
   {
    "i": 1,
    "start": 2.23,
    "end": 2.76,
    "text": "他只反问一句",
    "chars_per_second": 11.32
   },
   {
    "i": 2,
    "start": 3.11,
    "end": 3.67,
    "text": "证据呢",
    "chars_per_second": 5.36
   },
   {
    "i": 3,
    "start": 3.92,
    "end": 4.6,
    "text": "第六天",
    "chars_per_second": 4.41
   },
   {
    "i": 4,
    "start": 4.88,
    "end": 6.07,
    "text": "他开口了",
    "chars_per_second": 3.36
   },
   {
    "i": 5,
    "start": 6.42,
    "end": 7.19,
    "text": "供出七起杀人",
    "chars_per_second": 7.79
   },
   {
    "i": 6,
    "start": 7.4,
    "end": 8.75,
    "text": "几周之后",
    "chars_per_second": 2.96
   },
   {
    "i": 7,
    "start": 9.1,
    "end": 9.87,
    "text": "他又主动补上一句",
    "chars_per_second": 10.39
   },
   {
    "i": 8,
    "start": 10.21,
    "end": 11.07,
    "text": "我藏了一件",
    "chars_per_second": 5.81
   },
   {
    "i": 9,
    "start": 11.41,
    "end": 12.76,
    "text": "二〇〇六年旌善那位女职员",
    "chars_per_second": 7.41
   },
   {
    "i": 10,
    "start": 13.11,
    "end": 13.61,
    "text": "也是我",
    "chars_per_second": 6.0
   },
   {
    "i": 11,
    "start": 13.96,
    "end": 15.38,
    "text": "那是物证最少的一起",
    "chars_per_second": 6.34
   },
   {
    "i": 12,
    "start": 15.69,
    "end": 16.92,
    "text": "是他自己交出来的",
    "chars_per_second": 6.5
   },
   {
    "i": 13,
    "start": 17.11,
    "end": 18.33,
    "text": "二〇〇九年二月",
    "chars_per_second": 4.1
   },
   {
    "i": 14,
    "start": 18.64,
    "end": 19.76,
    "text": "他被以杀人",
    "chars_per_second": 4.46
   },
   {
    "i": 15,
    "start": 20.01,
    "end": 20.52,
    "text": "纵火",
    "chars_per_second": 3.92
   },
   {
    "i": 16,
    "start": 20.78,
    "end": 22.99,
    "text": "保险诈骗等罪名起诉",
    "chars_per_second": 4.07
   },
   {
    "i": 17,
    "start": 23.33,
    "end": 24.09,
    "text": "四月八日",
    "chars_per_second": 5.26
   },
   {
    "i": 18,
    "start": 24.44,
    "end": 27.07,
    "text": "检方在结审庭上请求死刑",
    "chars_per_second": 4.18
   }
  ]
 },
 "N06": {
  "duration": 30.212,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.81,
    "text": "二〇〇九年四月二十二日",
    "chars_per_second": 5.42
   },
   {
    "i": 1,
    "start": 2.16,
    "end": 5.92,
    "text": "水原地方法院安山支院认定他杀害十名女性",
    "chars_per_second": 5.05
   },
   {
    "i": 2,
    "start": 6.26,
    "end": 7.51,
    "text": "包括妻子和岳母",
    "chars_per_second": 5.6
   },
   {
    "i": 3,
    "start": 7.7,
    "end": 8.54,
    "text": "判处死刑",
    "chars_per_second": 4.76
   },
   {
    "i": 4,
    "start": 8.89,
    "end": 11.92,
    "text": "七月二十三日",
    "chars_per_second": 1.98
   },
   {
    "i": 5,
    "start": 12.27,
    "end": 13.23,
    "text": "首尔高等法院维持判决",
    "chars_per_second": 10.42
   },
   {
    "i": 6,
    "start": 13.46,
    "end": 15.4,
    "text": "他放弃上告，死刑确定",
    "chars_per_second": 4.64
   },
   {
    "i": 7,
    "start": 15.61,
    "end": 17.78,
    "text": "十七年过去",
    "chars_per_second": 2.3
   },
   {
    "i": 8,
    "start": 18.11,
    "end": 19.53,
    "text": "韩国没有再执行过一次死刑",
    "chars_per_second": 8.45
   },
   {
    "i": 9,
    "start": 19.87,
    "end": 21.06,
    "text": "他还关在拘留所里",
    "chars_per_second": 6.72
   },
   {
    "i": 10,
    "start": 21.39,
    "end": 24.5,
    "text": "而在他的牛棚里",
    "chars_per_second": 2.25
   },
   {
    "i": 11,
    "start": 24.8,
    "end": 26.34,
    "text": "一把镐头的镐刃上检出两名女性的 DNA",
    "chars_per_second": 11.69
   },
   {
    "i": 12,
    "start": 26.56,
    "end": 28.33,
    "text": "至今没有对上任何人",
    "chars_per_second": 5.08
   },
   {
    "i": 13,
    "start": 28.66,
    "end": 29.29,
    "text": "十个人是被认定的数字",
    "chars_per_second": 15.87
   },
   {
    "i": 14,
    "start": 29.48,
    "end": 30.21,
    "text": "不确定的，还在那里",
    "chars_per_second": 10.94
   }
  ]
 }
}