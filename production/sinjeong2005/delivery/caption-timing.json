[
  {
    "start": 0.6,
    "end": 3.0408005787316132,
    "text": "首尔最普通的一个住宅区，"
  },
  {
    "start": 3.3243790692066555,
    "end": 5.187894863756933,
    "text": "藏着一个找了二十年的凶手。"
  },
  {
    "start": 5.187894863756933,
    "end": 8.145213407282373,
    "text": "他就守在受害者走进的那栋楼里，"
  },
  {
    "start": 8.287002652519893,
    "end": 10.899975886182782,
    "text": "每天看着人群从眼前走过。"
  },
  {
    "start": 11.062020737882806,
    "end": 11.95326742223294,
    "text": "二零二五年，"
  },
  {
    "start": 12.09505666747046,
    "end": 14.140872920183266,
    "text": "警方终于叫出了他的身份。"
  },
  {
    "start": 14.262406558958283,
    "end": 15.092886423920907,
    "text": "可那时，"
  },
  {
    "start": 15.437231733783458,
    "end": 17.138702676633713,
    "text": "他已经死了整整十年。"
  },
  {
    "start": 17.300747528333737,
    "end": 20.845478659271762,
    "text": "这就是新亭洞连环杀人案。"
  },
  {
    "start": 22.067267904509286,
    "end": 24.548579696165906,
    "text": "二零零五年六月七日清晨，"
  },
  {
    "start": 24.811902580178444,
    "end": 26.67541837472872,
    "text": "新亭洞住宅区的巷口，"
  },
  {
    "start": 26.85771883289125,
    "end": 29.55171449240415,
    "text": "环卫工看见两只米袋绑在一起，"
  },
  {
    "start": 29.855548589341694,
    "end": 31.840598022666992,
    "text": "袋口露出一只苍白的手。"
  },
  {
    "start": 32.00264287436701,
    "end": 32.69133349409212,
    "text": "袋子里，"
  },
  {
    "start": 32.77235591994213,
    "end": 34.14973715939233,
    "text": "是第一名受害者，"
  },
  {
    "start": 34.25101519170485,
    "end": 36.19555341210514,
    "text": "一名二十多岁的女子。"
  },
  {
    "start": 36.296831444417656,
    "end": 37.61344586448035,
    "text": "没有目击者，"
  },
  {
    "start": 37.83625753556788,
    "end": 40.38846394984326,
    "text": "也没有拍下凶手的监控。"
  },
  {
    "start": 40.50999758861828,
    "end": 41.988656860381,
    "text": "第一起命案，"
  },
  {
    "start": 42.13044610561852,
    "end": 44.19651796479383,
    "text": "就这样摆在首尔警方眼前。"
  },
  {
    "start": 45.48920183265012,
    "end": 46.55262117193152,
    "text": "五个月后，",
    "en": "Five months later"
  },
  {
    "start": 46.653899204244034,
    "end": 48.09204726308175,
    "text": "十一月二十日，",
    "en": "on November 20"
  },
  {
    "start": 48.19332529539427,
    "end": 50.87719315167592,
    "text": "同一个社区又出现一个包裹，",
    "en": "another bundle appeared in the same neighborhood"
  },
  {
    "start": 50.98859898721968,
    "end": 52.396363636363645,
    "text": "席垫裹着死者，",
    "en": "the body wrapped in a mat"
  },
  {
    "start": 52.477386062213654,
    "end": 54.01681215336389,
    "text": "绳索捆得死紧。",
    "en": "bound tightly with rope"
  },
  {
    "start": 54.1180901856764,
    "end": 56.19428984808296,
    "text": "死者是四十多岁的女子，",
    "en": "The victim was a woman in her forties"
  },
  {
    "start": 56.30569568362672,
    "end": 59.1921196045334,
    "text": "前一晚还出现在新亭站的监控里，",
    "en": "last seen on station cameras the night before"
  },
  {
    "start": 59.29339763684592,
    "end": 60.41758379551484,
    "text": "再也没有回家。",
    "en": "who never made it home"
  },
  {
    "start": 60.53911743428986,
    "end": 62.46340004822764,
    "text": "两名受害者素不相识，",
    "en": "The two victims had never met"
  },
  {
    "start": 62.58493368700266,
    "end": 63.617969616590315,
    "text": "死因相同，",
    "en": "yet the cause of death was the same"
  },
  {
    "start": 63.678736435977825,
    "end": 65.2282903303593,
    "text": "捆绑的手法也相同。",
    "en": "and so was the binding"
  },
  {
    "start": 65.34982396913432,
    "end": 66.9196334699783,
    "text": "警方终于意识到，",
    "en": "Police finally realized"
  },
  {
    "start": 67.03103930552207,
    "end": 68.54008198697855,
    "text": "这不是两起命案，",
    "en": "this was not two separate cases"
  },
  {
    "start": 68.64136001929106,
    "end": 70.92517964793828,
    "text": "是一个人第二次伸出了手。",
    "en": "the same man had struck a second time."
  },
  {
    "start": 72.06594646732579,
    "end": 73.89907885218231,
    "text": "三十八人的专案组，",
    "en": "A 38-officer task force"
  },
  {
    "start": 73.89907885218231,
    "end": 75.39799373040753,
    "text": "一查就是八年。",
    "en": "investigated for eight years"
  },
  {
    "start": 75.51952736918255,
    "end": 78.52748492886425,
    "text": "可现场没留下能认出他的基因，",
    "en": "But the scene left no DNA that could name him"
  },
  {
    "start": 78.598379551483,
    "end": 81.12020255606464,
    "text": "模糊的画面也拼不出一张脸。",
    "en": "and grainy footage drew no face"
  },
  {
    "start": 81.2316083916084,
    "end": 82.5279672052086,
    "text": "二零零六年，",
    "en": "In 2006"
  },
  {
    "start": 82.5279672052086,
    "end": 85.01940680009646,
    "text": "另一名女子被挟持后逃生，",
    "en": "another woman escaped an abduction"
  },
  {
    "start": 85.12068483240898,
    "end": 88.543882324572,
    "text": "只记得藏身处有一张流氓兔贴纸。",
    "en": "remembering only a cartoon-rabbit sticker where she hid"
  },
  {
    "start": 88.65528816011576,
    "end": 90.05292500602846,
    "text": "所有人都以为，",
    "en": "Everyone believed"
  },
  {
    "start": 90.05292500602846,
    "end": 91.967079816735,
    "text": "她逃出的是同一双手。",
    "en": "she had escaped the same hands"
  },
  {
    "start": 92.06835784904752,
    "end": 94.42813600192912,
    "text": "直到多年以后警方才确认，",
    "en": "Only years later did police confirm"
  },
  {
    "start": 94.53954183747288,
    "end": 97.03098143236075,
    "text": "那是另一个人留下的假线索。",
    "en": "it was a false lead left by a different man"
  },
  {
    "start": 97.14238726790452,
    "end": 98.38810706534845,
    "text": "二零一三年，",
    "en": "In 2013"
  },
  {
    "start": 98.49951290089223,
    "end": 100.61115987460816,
    "text": "案件被列为悬案。",
    "en": "the case went cold."
  },
  {
    "start": 101.74179889076441,
    "end": 102.65330118157705,
    "text": "转机，",
    "en": "The break"
  },
  {
    "start": 102.74445141065831,
    "end": 104.87129008922113,
    "text": "来自二十年前的旧证物。",
    "en": "came from twenty-year-old evidence"
  },
  {
    "start": 104.97256812153366,
    "end": 106.16764890282133,
    "text": "二零一六年，",
    "en": "In 2016"
  },
  {
    "start": 106.20816011574634,
    "end": 108.62870508801544,
    "text": "悬案专案组重新接手。",
    "en": "a cold-case team took over the file"
  },
  {
    "start": 108.75023872679046,
    "end": 109.78327465637811,
    "text": "二零二零年，",
    "en": "In 2020"
  },
  {
    "start": 109.87442488545938,
    "end": 111.0593778635158,
    "text": "新的鉴定技术，",
    "en": "new forensic technology"
  },
  {
    "start": 111.16065589582831,
    "end": 113.11532191945986,
    "text": "从第一名受害者的衣物上，",
    "en": "from the first victim's clothing"
  },
  {
    "start": 113.22672775500362,
    "end": 115.34343863033519,
    "text": "从第二起案件的绳索上，",
    "en": "and from the rope in the second case"
  },
  {
    "start": 115.4447166626477,
    "end": 117.60193875090428,
    "text": "检出了同一个男人的基因。",
    "en": "recovered one man's DNA"
  },
  {
    "start": 117.71334458644804,
    "end": 119.93133349409212,
    "text": "警方筛查二十三万多人，",
    "en": "Police screened more than 230,000 people"
  },
  {
    "start": 120.00222811671088,
    "end": 122.62532915360502,
    "text": "采集一千五百一十四人的样本，",
    "en": "collected samples from 1,514 of them"
  },
  {
    "start": 122.62532915360504,
    "end": 125.26868579696166,
    "text": "甚至远赴海外协查比对，",
    "en": "and even compared databases overseas"
  },
  {
    "start": 125.38009163250544,
    "end": 127.8512756209308,
    "text": "活人里依然没有一个对得上。",
    "en": "yet no living person matched"
  },
  {
    "start": 127.96268145647457,
    "end": 128.68175548589343,
    "text": "于是，",
    "en": "So"
  },
  {
    "start": 128.71213889558717,
    "end": 131.17825898239693,
    "text": "他们把名单转向了死者。",
    "en": "they turned their list to the dead."
  },
  {
    "start": 132.31902580178442,
    "end": 134.80033759344104,
    "text": "五十六名已故候选人中，",
    "en": "Among 56 deceased candidates"
  },
  {
    "start": 134.90161562575355,
    "end": 137.858934169279,
    "text": "浮出当年那栋楼的管理员A某。",
    "en": "emerged the building caretaker, Mr. A"
  },
  {
    "start": 137.97034000482276,
    "end": 141.70749939715458,
    "text": "两名受害者都曾走进他看守的楼，",
    "en": "Both victims had entered the building he kept"
  },
  {
    "start": 141.81890523269834,
    "end": 145.19146370870507,
    "text": "二零零六年他又因另一起侵害被捕，",
    "en": "and in 2006 he was arrested for another assault"
  },
  {
    "start": 145.30286954424886,
    "end": 148.55389438148057,
    "text": "却没人把他和两起命案连在一起。",
    "en": "yet no one linked him to the two murders"
  },
  {
    "start": 148.6551724137931,
    "end": 151.33904027007475,
    "text": "他已在二零一五年病逝火化，",
    "en": "He had died in 2015 and been cremated"
  },
  {
    "start": 151.4504461056185,
    "end": 153.69881842295635,
    "text": "警方跑遍四十家医疗机构，",
    "en": "so police searched forty medical facilities"
  },
  {
    "start": 153.75958524234386,
    "end": 156.0687243790692,
    "text": "才找到一份留存至今的检体。",
    "en": "until one stored sample was found"
  },
  {
    "start": 156.18013021461297,
    "end": 158.32722449963828,
    "text": "二零二五年十一月二十一日，",
    "en": "On November 21, 2025"
  },
  {
    "start": 158.43863033518207,
    "end": 160.29201832650108,
    "text": "基因比对的结果只有一个，",
    "en": "the DNA result gave one answer"
  },
  {
    "start": 160.3932963588136,
    "end": 161.0819869785387,
    "text": "对上了。",
    "en": "a match"
  },
  {
    "start": 161.18326501085122,
    "end": 162.3986013986014,
    "text": "凶手找到了，",
    "en": "The killer was found"
  },
  {
    "start": 162.51000723414518,
    "end": 164.19122257053291,
    "text": "却等不到开庭那一天。",
    "en": "but he will never stand trial"
  },
  {
    "start": 164.30262840607668,
    "end": 165.35591994212683,
    "text": "警方说，",
    "en": "Police said"
  },
  {
    "start": 165.45719797443934,
    "end": 166.40921147817699,
    "text": "杀人犯，",
    "en": "a murderer"
  },
  {
    "start": 166.48010610079575,
    "end": 168.09042681456475,
    "text": "要追到阴间为止。",
    "en": "must be tracked even into the afterlife"
  },
  {
    "start": 168.2018326501085,
    "end": 170.17675428020254,
    "text": "这句迟到二十年的回答，",
    "en": "This answer, twenty years late"
  },
  {
    "start": 170.27803231251505,
    "end": 171.57439112611524,
    "text": "留给家属的，",
    "en": "left the families"
  },
  {
    "start": 171.67566915842778,
    "end": 172.78972751386544,
    "text": "只有真相，",
    "en": "only the truth"
  },
  {
    "start": 172.89100554617795,
    "end": 174.0,
    "text": "没有审判。",
    "en": "and no trial."
  }
]