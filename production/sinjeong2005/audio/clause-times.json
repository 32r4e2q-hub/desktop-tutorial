{
 "N01": {
  "duration": 20.13,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.3,
    "text": "首尔最普通的一个住宅区",
    "chars_per_second": 5.09
   },
   {
    "i": 1,
    "start": 2.65,
    "end": 4.39,
    "text": "藏着一个找了二十年的凶手",
    "chars_per_second": 6.9
   },
   {
    "i": 2,
    "start": 4.73,
    "end": 7.3,
    "text": "他就守在受害者走进的那栋楼里",
    "chars_per_second": 5.45
   },
   {
    "i": 3,
    "start": 7.65,
    "end": 10.05,
    "text": "每天看着人群从眼前走过",
    "chars_per_second": 4.58
   },
   {
    "i": 4,
    "start": 10.39,
    "end": 11.16,
    "text": "二零二五年",
    "chars_per_second": 6.49
   },
   {
    "i": 5,
    "start": 11.41,
    "end": 13.28,
    "text": "警方终于叫出了他的身份",
    "chars_per_second": 5.88
   },
   {
    "i": 6,
    "start": 13.67,
    "end": 14.34,
    "text": "可那时",
    "chars_per_second": 4.48
   },
   {
    "i": 7,
    "start": 14.66,
    "end": 17.41,
    "text": "他已经死了整整十年",
    "chars_per_second": 3.27
   },
   {
    "i": 8,
    "start": 17.68,
    "end": 20.13,
    "text": "这就是新亭洞连环杀人案",
    "chars_per_second": 4.49
   }
  ]
 },
 "N02": {
  "duration": 22.01,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.32,
    "text": "二零零五年六月七日清晨",
    "chars_per_second": 5.07
   },
   {
    "i": 1,
    "start": 2.66,
    "end": 4.42,
    "text": "新亭洞住宅区的巷口",
    "chars_per_second": 5.11
   },
   {
    "i": 2,
    "start": 4.76,
    "end": 7.34,
    "text": "环卫工看见两只米袋绑在一起",
    "chars_per_second": 5.04
   },
   {
    "i": 3,
    "start": 7.77,
    "end": 9.55,
    "text": "袋口露出一只苍白的手",
    "chars_per_second": 5.62
   },
   {
    "i": 4,
    "start": 9.89,
    "end": 11.76,
    "text": "袋子里",
    "chars_per_second": 1.6
   },
   {
    "i": 5,
    "start": 12.1,
    "end": 12.49,
    "text": "是第一名受害者",
    "chars_per_second": 17.95
   },
   {
    "i": 6,
    "start": 12.67,
    "end": 13.77,
    "text": "一名二十多岁的女子",
    "chars_per_second": 8.18
   },
   {
    "i": 7,
    "start": 14.11,
    "end": 15.35,
    "text": "没有目击者",
    "chars_per_second": 4.03
   },
   {
    "i": 8,
    "start": 15.69,
    "end": 17.97,
    "text": "也没有拍下凶手的监控",
    "chars_per_second": 4.39
   },
   {
    "i": 9,
    "start": 18.32,
    "end": 19.56,
    "text": "第一起命案",
    "chars_per_second": 4.03
   },
   {
    "i": 10,
    "start": 19.91,
    "end": 22.01,
    "text": "就这样摆在首尔警方眼前",
    "chars_per_second": 5.24
   }
  ]
 },
 "N03": {
  "duration": 25.165,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.95,
    "text": "五个月后",
    "chars_per_second": 4.94
   },
   {
    "i": 1,
    "start": 1.29,
    "end": 2.47,
    "text": "十一月二十日",
    "chars_per_second": 5.08
   },
   {
    "i": 2,
    "start": 2.81,
    "end": 5.22,
    "text": "同一个社区又出现一个包裹",
    "chars_per_second": 4.98
   },
   {
    "i": 3,
    "start": 5.57,
    "end": 6.72,
    "text": "席垫裹着死者",
    "chars_per_second": 5.22
   },
   {
    "i": 4,
    "start": 7.04,
    "end": 8.32,
    "text": "绳索捆得死紧",
    "chars_per_second": 4.69
   },
   {
    "i": 5,
    "start": 8.66,
    "end": 10.47,
    "text": "死者是四十多岁的女子",
    "chars_per_second": 5.52
   },
   {
    "i": 6,
    "start": 10.82,
    "end": 13.43,
    "text": "前一晚还出现在新亭站的监控里",
    "chars_per_second": 5.36
   },
   {
    "i": 7,
    "start": 13.77,
    "end": 14.64,
    "text": "再也没有回家",
    "chars_per_second": 6.9
   },
   {
    "i": 8,
    "start": 15.0,
    "end": 16.66,
    "text": "两名受害者素不相识",
    "chars_per_second": 5.42
   },
   {
    "i": 9,
    "start": 17.02,
    "end": 17.8,
    "text": "死因相同",
    "chars_per_second": 5.13
   },
   {
    "i": 10,
    "start": 18.1,
    "end": 19.39,
    "text": "捆绑的手法也相同",
    "chars_per_second": 6.2
   },
   {
    "i": 11,
    "start": 19.75,
    "end": 21.06,
    "text": "警方终于意识到",
    "chars_per_second": 5.34
   },
   {
    "i": 12,
    "start": 21.41,
    "end": 22.66,
    "text": "这不是两起命案",
    "chars_per_second": 5.6
   },
   {
    "i": 13,
    "start": 23.0,
    "end": 25.16,
    "text": "是一个人第二次伸出了手",
    "chars_per_second": 5.08
   }
  ]
 },
 "N04": {
  "duration": 28.245,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.76,
    "text": "三十八人的专案组",
    "chars_per_second": 4.97
   },
   {
    "i": 1,
    "start": 1.96,
    "end": 3.2,
    "text": "一查就是八年",
    "chars_per_second": 4.84
   },
   {
    "i": 2,
    "start": 3.56,
    "end": 6.29,
    "text": "可现场没留下能认出他的基因",
    "chars_per_second": 4.76
   },
   {
    "i": 3,
    "start": 6.6,
    "end": 8.85,
    "text": "模糊的画面也拼不出一张脸",
    "chars_per_second": 5.33
   },
   {
    "i": 4,
    "start": 9.2,
    "end": 10.25,
    "text": "二零零六年",
    "chars_per_second": 4.76
   },
   {
    "i": 5,
    "start": 10.48,
    "end": 12.7,
    "text": "另一名女子被挟持后逃生",
    "chars_per_second": 4.95
   },
   {
    "i": 6,
    "start": 13.04,
    "end": 16.18,
    "text": "只记得藏身处有一张流氓兔贴纸",
    "chars_per_second": 4.46
   },
   {
    "i": 7,
    "start": 16.53,
    "end": 17.7,
    "text": "所有人都以为",
    "chars_per_second": 5.13
   },
   {
    "i": 8,
    "start": 17.91,
    "end": 19.56,
    "text": "她逃出的是同一双手",
    "chars_per_second": 5.45
   },
   {
    "i": 9,
    "start": 19.9,
    "end": 21.99,
    "text": "直到多年以后警方才确认",
    "chars_per_second": 5.26
   },
   {
    "i": 10,
    "start": 22.34,
    "end": 24.56,
    "text": "那是另一个人留下的假线索",
    "chars_per_second": 5.41
   },
   {
    "i": 11,
    "start": 24.91,
    "end": 25.9,
    "text": "二零一三年",
    "chars_per_second": 5.05
   },
   {
    "i": 12,
    "start": 26.25,
    "end": 28.25,
    "text": "案件被列为悬案",
    "chars_per_second": 3.51
   }
  ]
 },
 "N05": {
  "duration": 29.115,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.8,
    "text": "转机",
    "chars_per_second": 3.03
   },
   {
    "i": 1,
    "start": 1.13,
    "end": 2.99,
    "text": "来自二十年前的旧证物",
    "chars_per_second": 5.38
   },
   {
    "i": 2,
    "start": 3.33,
    "end": 4.27,
    "text": "二零一六年",
    "chars_per_second": 5.32
   },
   {
    "i": 3,
    "start": 4.55,
    "end": 6.7,
    "text": "悬案专案组重新接手",
    "chars_per_second": 4.19
   },
   {
    "i": 4,
    "start": 7.06,
    "end": 7.84,
    "text": "二零二零年",
    "chars_per_second": 6.41
   },
   {
    "i": 5,
    "start": 8.17,
    "end": 9.1,
    "text": "新的鉴定技术",
    "chars_per_second": 6.45
   },
   {
    "i": 6,
    "start": 9.44,
    "end": 11.13,
    "text": "从第一名受害者的衣物上",
    "chars_per_second": 6.51
   },
   {
    "i": 7,
    "start": 11.48,
    "end": 13.33,
    "text": "从第二起案件的绳索上",
    "chars_per_second": 5.41
   },
   {
    "i": 8,
    "start": 13.67,
    "end": 15.56,
    "text": "检出了同一个男人的基因",
    "chars_per_second": 5.82
   },
   {
    "i": 9,
    "start": 15.91,
    "end": 17.86,
    "text": "警方筛查二十三万多人",
    "chars_per_second": 5.13
   },
   {
    "i": 10,
    "start": 18.17,
    "end": 20.52,
    "text": "采集一千五百一十四人的样本",
    "chars_per_second": 5.53
   },
   {
    "i": 11,
    "start": 20.76,
    "end": 23.13,
    "text": "甚至远赴海外协查比对",
    "chars_per_second": 4.22
   },
   {
    "i": 12,
    "start": 23.48,
    "end": 25.68,
    "text": "活人里依然没有一个对得上",
    "chars_per_second": 5.45
   },
   {
    "i": 13,
    "start": 26.03,
    "end": 26.5,
    "text": "于是",
    "chars_per_second": 4.26
   },
   {
    "i": 14,
    "start": 26.77,
    "end": 29.11,
    "text": "他们把名单转向了死者",
    "chars_per_second": 4.26
   }
  ]
 },
 "N06": {
  "duration": 41.215,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.36,
    "text": "五十六名已故候选人中",
    "chars_per_second": 4.52
   },
   {
    "i": 1,
    "start": 2.7,
    "end": 5.38,
    "text": "浮出当年那栋楼的管理员A某",
    "chars_per_second": 4.85
   },
   {
    "i": 2,
    "start": 5.73,
    "end": 9.18,
    "text": "两名受害者都曾走进他看守的楼",
    "chars_per_second": 4.06
   },
   {
    "i": 3,
    "start": 9.53,
    "end": 12.62,
    "text": "二零零六年他又因另一起侵害被捕",
    "chars_per_second": 4.85
   },
   {
    "i": 4,
    "start": 12.97,
    "end": 15.94,
    "text": "却没人把他和两起命案连在一起",
    "chars_per_second": 4.71
   },
   {
    "i": 5,
    "start": 16.28,
    "end": 18.69,
    "text": "他已在二零一五年病逝火化",
    "chars_per_second": 4.98
   },
   {
    "i": 6,
    "start": 19.04,
    "end": 21.02,
    "text": "警方跑遍四十家医疗机构",
    "chars_per_second": 5.56
   },
   {
    "i": 7,
    "start": 21.32,
    "end": 23.36,
    "text": "才找到一份留存至今的检体",
    "chars_per_second": 5.88
   },
   {
    "i": 8,
    "start": 23.71,
    "end": 25.59,
    "text": "二零二五年十一月二十一日",
    "chars_per_second": 6.38
   },
   {
    "i": 9,
    "start": 25.94,
    "end": 27.53,
    "text": "基因比对的结果只有一个",
    "chars_per_second": 6.92
   },
   {
    "i": 10,
    "start": 27.87,
    "end": 28.31,
    "text": "对上了",
    "chars_per_second": 6.82
   },
   {
    "i": 11,
    "start": 28.65,
    "end": 29.61,
    "text": "凶手找到了",
    "chars_per_second": 5.21
   },
   {
    "i": 12,
    "start": 29.96,
    "end": 31.38,
    "text": "却等不到开庭那一天",
    "chars_per_second": 6.34
   },
   {
    "i": 13,
    "start": 31.73,
    "end": 32.53,
    "text": "警方说",
    "chars_per_second": 3.75
   },
   {
    "i": 14,
    "start": 32.87,
    "end": 33.57,
    "text": "杀人犯",
    "chars_per_second": 4.29
   },
   {
    "i": 15,
    "start": 33.88,
    "end": 35.23,
    "text": "要追到阴间为止",
    "chars_per_second": 5.19
   },
   {
    "i": 16,
    "start": 35.58,
    "end": 37.29,
    "text": "这句迟到二十年的回答",
    "chars_per_second": 5.85
   },
   {
    "i": 17,
    "start": 37.63,
    "end": 38.67,
    "text": "留给家属的",
    "chars_per_second": 4.81
   },
   {
    "i": 18,
    "start": 39.01,
    "end": 39.87,
    "text": "只有真相",
    "chars_per_second": 4.65
   },
   {
    "i": 19,
    "start": 40.21,
    "end": 41.22,
    "text": "没有审判",
    "chars_per_second": 3.98
   }
  ]
 }
}