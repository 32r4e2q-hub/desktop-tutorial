[
  {
    "start": 0.6,
    "end": 3.0418327371827627,
    "text": "一个曼哈顿的建筑咨询师，"
  },
  {
    "start": 3.0418327371827627,
    "end": 5.617203202180208,
    "text": "办公室就在帝国大厦旁边，"
  },
  {
    "start": 5.617203202180208,
    "end": 6.990734116845512,
    "text": "有老婆有孩子，"
  },
  {
    "start": 6.990734116845512,
    "end": 8.860262306251064,
    "text": "邻居眼里的模范爸爸。"
  },
  {
    "start": 8.860262306251064,
    "end": 9.718719127916879,
    "text": "三十年，"
  },
  {
    "start": 9.718719127916879,
    "end": 10.84425140521206,
    "text": "没人怀疑过他。"
  },
  {
    "start": 10.84425140521206,
    "end": 12.67562595809913,
    "text": "最后让他暴露的，"
  },
  {
    "start": 12.67562595809913,
    "end": 14.850383239652528,
    "text": "是一个扔进垃圾桶的披萨盒。"
  },
  {
    "start": 14.850383239652528,
    "end": 17.864520524612505,
    "text": "这就是美国近年最离奇的悬案："
  },
  {
    "start": 17.864520524612505,
    "end": 19.982047351388182,
    "text": "长岛吉尔戈海滩连环案。"
  },
  {
    "start": 19.982047351388182,
    "end": 21.870652359052976,
    "text": "今天一口气讲清楚："
  },
  {
    "start": 21.870652359052976,
    "end": 23.4921819110884,
    "text": "他是怎么隐藏的，"
  },
  {
    "start": 23.4921819110884,
    "end": 25.371248509623573,
    "text": "又是怎么栽的。"
  },
  {
    "start": 26.451248509623575,
    "end": 27.30970533128939,
    "text": "先说他是谁。"
  },
  {
    "start": 27.30970533128939,
    "end": 28.33985351728837,
    "text": "雷克斯·赫曼，"
  },
  {
    "start": 28.33985351728837,
    "end": 29.52261624936127,
    "text": "身高一米九三，"
  },
  {
    "start": 29.52261624936127,
    "end": 31.2395298926929,
    "text": "长岛马萨皮夸公园人，"
  },
  {
    "start": 31.2395298926929,
    "end": 33.26167262817238,
    "text": "住的还是他小时候的房子。"
  },
  {
    "start": 33.26167262817238,
    "end": 33.910284448986545,
    "text": "白天，"
  },
  {
    "start": 33.910284448986545,
    "end": 35.398276273207294,
    "text": "他坐火车进曼哈顿，"
  },
  {
    "start": 35.398276273207294,
    "end": 37.68749446431613,
    "text": "给纽约的大楼做建筑合规咨询；"
  },
  {
    "start": 37.68749446431613,
    "end": 38.01180037472322,
    "text": "晚上，"
  },
  {
    "start": 38.01180037472322,
    "end": 40.205634474535856,
    "text": "回家陪妻子和两个孩子。"
  },
  {
    "start": 40.205634474535856,
    "end": 42.43762221086698,
    "text": "可就在这栋房子的地下室里，"
  },
  {
    "start": 42.43762221086698,
    "end": 44.6696099471981,
    "text": "藏着一份写于两千年的文件。"
  },
  {
    "start": 44.6696099471981,
    "end": 45.58529722364163,
    "text": "它是什么，"
  },
  {
    "start": 45.58529722364163,
    "end": 47.035135411343894,
    "text": "我们后面再说。"
  },
  {
    "start": 48.11513541134389,
    "end": 49.11666836995401,
    "text": "他盯上的，"
  },
  {
    "start": 49.21205246125021,
    "end": 52.130805654913985,
    "text": "大多是在网上招揽客人的年轻女性。"
  },
  {
    "start": 52.18803610969171,
    "end": 53.79048884346789,
    "text": "套路极其固定："
  },
  {
    "start": 53.86679611650485,
    "end": 55.58370975983648,
    "text": "等老婆孩子出门旅行，"
  },
  {
    "start": 55.69817066939193,
    "end": 57.54862204053824,
    "text": "用一次性手机联系对方，"
  },
  {
    "start": 57.68215976835292,
    "end": 58.616923863055696,
    "text": "约到家里。"
  },
  {
    "start": 58.88399931868506,
    "end": 60.52460568897973,
    "text": "地下室里发生了什么，"
  },
  {
    "start": 60.71537387157213,
    "end": 61.80275251234883,
    "text": "只有他知道。"
  },
  {
    "start": 61.936290240163515,
    "end": 62.413210696644526,
    "text": "之后，"
  },
  {
    "start": 62.47044115142224,
    "end": 64.28273888605008,
    "text": "他用粗麻布把她们裹住，"
  },
  {
    "start": 64.41627661386477,
    "end": 66.0950366206779,
    "text": "沿着海洋公园大道，"
  },
  {
    "start": 66.28580480327031,
    "end": 68.86117526826776,
    "text": "弃置在吉尔戈海滩的荒草丛里。"
  },
  {
    "start": 68.93748254130472,
    "end": 71.05500936808039,
    "text": "从一九九三到二零一零，"
  },
  {
    "start": 71.341161641969,
    "end": 72.27592573667178,
    "text": "十七年，"
  },
  {
    "start": 72.37130982796798,
    "end": 73.87837847044796,
    "text": "至少八名受害者。"
  },
  {
    "start": 73.87837847044796,
    "end": 74.83221938340998,
    "text": "更过分的是，"
  },
  {
    "start": 75.00391074774315,
    "end": 77.0642071197411,
    "text": "他还用其中一名受害者的手机，"
  },
  {
    "start": 77.21682166581502,
    "end": 79.04819621870209,
    "text": "打电话挑衅她的家人。"
  },
  {
    "start": 80.21881110543349,
    "end": 81.61141883835803,
    "text": "二零一零年底，"
  },
  {
    "start": 81.61141883835803,
    "end": 83.40463975472662,
    "text": "四名受害者的遗体被发现，"
  },
  {
    "start": 83.40463975472662,
    "end": 84.4347879407256,
    "text": "全美震动。"
  },
  {
    "start": 84.4347879407256,
    "end": 85.71293476409471,
    "text": "可十几年过去，"
  },
  {
    "start": 85.71293476409471,
    "end": 87.54430931698178,
    "text": "警方一无所获。"
  },
  {
    "start": 87.54430931698178,
    "end": 89.12768523249872,
    "text": "转机在二零二二年："
  },
  {
    "start": 89.12768523249872,
    "end": 90.93998296712655,
    "text": "新任局长成立专案组，"
  },
  {
    "start": 90.93998296712655,
    "end": 93.00027933912452,
    "text": "把老卷宗翻了个底朝天。"
  },
  {
    "start": 93.00027933912452,
    "end": 95.53749616760348,
    "text": "一条被忽略的目击证词跳了出来："
  },
  {
    "start": 95.53749616760348,
    "end": 98.68517118037813,
    "text": "嫌疑人开一辆墨绿色的雪佛兰雪崩皮卡。"
  },
  {
    "start": 98.68517118037813,
    "end": 99.48639754726622,
    "text": "数据库一查，"
  },
  {
    "start": 99.48639754726622,
    "end": 100.11593254982115,
    "text": "车主，"
  },
  {
    "start": 100.11593254982115,
    "end": 101.14608073582014,
    "text": "正是赫曼。"
  },
  {
    "start": 101.14608073582014,
    "end": 102.78668710611481,
    "text": "接下来一年半，"
  },
  {
    "start": 102.78668710611481,
    "end": 103.79775847385454,
    "text": "警察没抓人，"
  },
  {
    "start": 103.79775847385454,
    "end": 106.44466700732414,
    "text": "而是悄悄跟着他——等他扔垃圾。"
  },
  {
    "start": 107.52466700732414,
    "end": 109.45142565150742,
    "text": "二零二三年一月二十六日，"
  },
  {
    "start": 109.45142565150742,
    "end": 110.55788111054335,
    "text": "曼哈顿街头，"
  },
  {
    "start": 110.55788111054335,
    "end": 111.81695111565321,
    "text": "赫曼吃完披萨，"
  },
  {
    "start": 111.81695111565321,
    "end": 113.74370975983649,
    "text": "随手把盒子扔进垃圾桶。"
  },
  {
    "start": 113.74370975983649,
    "end": 115.34616249361268,
    "text": "跟踪小组马上捡走。"
  },
  {
    "start": 115.34616249361268,
    "end": 117.13938340998126,
    "text": "披萨边上的DNA，"
  },
  {
    "start": 117.13938340998126,
    "end": 120.17259751320049,
    "text": "和当年麻布上留下的一根男性毛发比对："
  },
  {
    "start": 120.17259751320049,
    "end": 123.43473343553057,
    "text": "百分之九十九点九六的北美人都能排除，"
  },
  {
    "start": 123.43473343553057,
    "end": 123.96888434678931,
    "text": "他不能。"
  },
  {
    "start": 123.96888434678931,
    "end": 125.39964571623233,
    "text": "七月十三日，"
  },
  {
    "start": 125.39964571623233,
    "end": 127.45994208823029,
    "text": "他在办公室门口被捕。"
  },
  {
    "start": 127.45994208823029,
    "end": 129.2531630045989,
    "text": "警方搜了他家十二天，"
  },
  {
    "start": 129.2531630045989,
    "end": 131.04638392096746,
    "text": "拉走了地下室的硬盘。"
  },
  {
    "start": 131.04638392096746,
    "end": 132.40083801737353,
    "text": "后来在里面，"
  },
  {
    "start": 132.40083801737353,
    "end": 135.43405212059275,
    "text": "翻出一份两千年建的Word文档，"
  },
  {
    "start": 135.43405212059275,
    "end": 137.03650485436893,
    "text": "一份作案清单："
  },
  {
    "start": 137.03650485436893,
    "end": 138.73434167944131,
    "text": "问题栏写着毛发、"
  },
  {
    "start": 138.73434167944131,
    "end": 139.55464486458865,
    "text": "DNA、"
  },
  {
    "start": 139.55464486458865,
    "end": 140.1841798671436,
    "text": "指纹；"
  },
  {
    "start": 140.1841798671436,
    "end": 141.29063532617954,
    "text": "目标栏写着，"
  },
  {
    "start": 141.29063532617954,
    "end": 142.3207835121785,
    "text": "小个子好。"
  },
  {
    "start": 143.40078351217852,
    "end": 144.69800715380686,
    "text": "清单里还有一条："
  },
  {
    "start": 144.69800715380686,
    "end": 146.12876852324987,
    "text": "行动前要睡够，"
  },
  {
    "start": 146.12876852324987,
    "end": 147.54045307443369,
    "text": "太累会出问题。"
  },
  {
    "start": 147.54045307443369,
    "end": 149.0284448986544,
    "text": "写下这句话的人，"
  },
  {
    "start": 149.0284448986544,
    "end": 150.821665815023,
    "text": "第二天照常去上班。"
  },
  {
    "start": 150.821665815023,
    "end": 152.67211718616932,
    "text": "二零二六年四月八日，"
  },
  {
    "start": 152.67211718616932,
    "end": 155.05671946857436,
    "text": "六十二岁的赫曼当庭认罪，"
  },
  {
    "start": 155.05671946857436,
    "end": 156.64009538409132,
    "text": "承认了八起命案；"
  },
  {
    "start": 156.64009538409132,
    "end": 156.9644012944984,
    "text": "六月，"
  },
  {
    "start": 156.9644012944984,
    "end": 158.60500766479308,
    "text": "被判终身监禁，"
  },
  {
    "start": 158.60500766479308,
    "end": 159.53977175949584,
    "text": "不得假释。"
  },
  {
    "start": 159.53977175949584,
    "end": 160.85607221938344,
    "text": "三十年的悬案，"
  },
  {
    "start": 160.85607221938344,
    "end": 163.5840572304548,
    "text": "最后输给了一块没吃完的披萨边。"
  },
  {
    "start": 163.5840572304548,
    "end": 164.27082268778744,
    "text": "所以，"
  },
  {
    "start": 164.27082268778744,
    "end": 166.2357349684892,
    "text": "别再迷信什么完美犯罪。"
  },
  {
    "start": 166.2357349684892,
    "end": 168.04803270311703,
    "text": "你扔掉的每一样东西，"
  },
  {
    "start": 168.04803270311703,
    "end": 169.6886390734117,
    "text": "都在替你说话。"
  },
  {
    "start": 169.6886390734117,
    "end": 170.41355816726283,
    "text": "你觉得，"
  },
  {
    "start": 170.41355816726283,
    "end": 171.11940044285473,
    "text": "是他太蠢，"
  },
  {
    "start": 171.11940044285473,
    "end": 172.60739226707548,
    "text": "还是警察太耐心？"
  },
  {
    "start": 172.60739226707548,
    "end": 174.0,
    "text": "评论区聊聊。"
  }
]