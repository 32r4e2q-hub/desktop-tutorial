    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "目前为止，这些都只是检方的指控。",
      "sha256": "1560b5fc7acb548feeaf250b467990ac6ba5dd8f2fd4dae0fb5cc208a9b55b1f",
      "voice_id": "voice-00",
