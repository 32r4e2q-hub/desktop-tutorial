    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "面对侦查，宫本始终保持沉默，关键答案仍悬而未决。",
      "sha256": "b5323a0f8a21b5c9199ffba6b8c065565f08c5415189a9443c1e5a63b6a2cd29",
      "voice_id": "voice-00",
