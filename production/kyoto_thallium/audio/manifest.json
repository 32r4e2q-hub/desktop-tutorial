      "tail_silence_seconds": 0.792
    },
    {
      "id": "S21",
      "file": "S21.mp3",
      "text": "检方的罪名是：对叔母的杀人未遂。",
      "sha256": "98595e164102b6df71984c6da46c6a5e2068b219961f93d733c3d71bb3d9a704",
