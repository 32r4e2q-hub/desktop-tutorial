    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "text": "2022年10月，京都。立命馆大学三年级，21岁。",
      "sha256": "457883ee168af654da266081cdd5baff202f6fd808aa55c94eacf620a16b9d63",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
