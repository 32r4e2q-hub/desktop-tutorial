      "target_duration": 7,
      "alignment": "shot-locked",
      "source_duration": 5.544,
      "atempo": 1.0,
      "tail_silence_seconds": 1.456
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "中毒的线索，往往藏在看似平常的病情里。",
      "sha256": "a3f7de56aa2a9f49545e9d1d439cd7e4a081f5537dbd256b3b6ad3169c024225",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
      "narration_id": "N04",
      "target_start": 74,
      "target_duration": 6,
