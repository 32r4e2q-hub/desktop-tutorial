      "tail_silence_seconds": 0.944
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "体内检出一种被遗忘的毒：铊。",
      "sha256": "e586e2b893f41df7461b003906522860e1bb94f2762a0b641a92247e5d19c611",
