    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "法庭审的是证据，而案件背后，还有一个问题。",
      "sha256": "5195e2540819b2e79eb7f5655b1b9c1894a5bec22114b4a31939c4f04e66c8bd",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
