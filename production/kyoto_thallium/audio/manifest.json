    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "一顿饭，三天后，滨野日菜子去世了。",
      "sha256": "8cc76df3bcfe86b627e6253814d3b0fb5f1981d63aa6f6ce188dc9b4fde9fdf9",
      "voice_id": "voice-00",
