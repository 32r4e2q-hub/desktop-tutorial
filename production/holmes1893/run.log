  "soundtrack": {
    "duration_seconds": 180.0,
    "sample_rate": 48000,
    "channels": 2,
    "rms_dbfs": -20.64,
    "peak_dbfs": -1.5,
    "silent_windows": 1,
    "window_count": 180,
    "silent_fraction": 0.0056,
    "target_rms_dbfs": -20.0,
    "peak_ceiling_dbfs": -1.5,
    "bgm_under_voice_target_db": -18.0,
    "bgm_sidechain_makeup_db": 1.5,
    "bgm_under_voice_measured_db": -19.23,
    "bgm_silence_gain": 0.24,
    "sfx_level": 0.5,
    "narration": {
      "voice_id": "voice-00",
      "alignment": "one-clip-one-shot-one-caption",
      "slowdown_allowed": false,
      "max_speedup_factor": 1.55,
      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "传说，1893年芝加哥世博会旁，有一栋旅馆。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 5.503,
          "natural_clip_seconds": 5.14,
          "natural_speech_seconds": 5.03,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.0521,
          "speech_start": 0.03,
          "speech_end": 4.81,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "住进去的人，很多再也没有走出来。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 3.32,
          "natural_clip_seconds": 3.05,
          "natural_speech_seconds": 2.94,
          "spoken_seconds": 2.94,
          "tempo_factor": 1.0,
          "speech_start": 5.03,
          "speech_end": 7.97,
          "characters": 14,
          "target_chars_per_second": 2.8
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "他本名赫尔曼·马吉特，1861年生在新罕布什尔州。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 5.793,
          "natural_clip_seconds": 5.65,
          "natural_speech_seconds": 5.54,
          "spoken_seconds": 5.54,
          "tempo_factor": 1.0,
          "speech_start": 10.03,
          "speech_end": 15.57,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "聪明、善谈，在密歇根大学学医；据说那时就开始用尸体骗保险。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 6.954,
          "natural_clip_seconds": 6.83,
          "natural_speech_seconds": 6.72,
          "spoken_seconds": 6.72,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 23.75,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "一份保险单，一枚红印章，他靠这套把戏骗过钱。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 5.0,
          "natural_clip_seconds": 4.82,
          "natural_speech_seconds": 4.71,
          "spoken_seconds": 4.71,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 28.74,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "后来他改名霍姆斯，搬到芝加哥，准备大干一场。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 5.503,
          "natural_clip_seconds": 5.31,
          "natural_speech_seconds": 5.2,
          "spoken_seconds": 4.79,
          "tempo_factor": 1.0869,
          "speech_start": 30.03,
          "speech_end": 34.82,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "1886年，他来到芝加哥，接手了英格尔伍德街角的一家药店。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 6.014,
          "natural_clip_seconds": 5.81,
          "natural_speech_seconds": 5.7,
          "spoken_seconds": 5.7,
          "tempo_factor": 1.0,
          "speech_start": 35.03,
          "speech_end": 40.73,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "又在对面盖起一栋三层大楼，取名“世界博览会旅馆”。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 6.095,
          "natural_clip_seconds": 5.89,
          "natural_speech_seconds": 5.78,
          "spoken_seconds": 5.78,
          "tempo_factor": 1.0,
          "speech_start": 42.03,
          "speech_end": 47.81,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "传说，楼里有暗道、活板门，还有没有窗户的房间。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 5.4,
          "natural_clip_seconds": 5.08,
          "natural_speech_seconds": 4.97,
          "spoken_seconds": 4.97,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 54.0,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "他不断换工人，一批走了又来，没人知道大楼全貌。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 4.818,
          "natural_clip_seconds": 4.68,
          "natural_speech_seconds": 4.57,
          "spoken_seconds": 4.57,
          "tempo_factor": 1.0,
          "speech_start": 55.03,
          "speech_end": 59.6,
          "characters": 20,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "1893年世博会期间，全城挤满外地游客，失踪几个人没人注意。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 6.908,
          "natural_clip_seconds": 6.67,
          "natural_speech_seconds": 6.56,
          "spoken_seconds": 6.56,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 66.59,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "传说，独自来游览的年轻女子，进了那栋楼，再没消息。",
          "start": 67.0,
          "duration": 7.0,
          "source_seconds": 6.095,
          "natural_clip_seconds": 5.86,
          "natural_speech_seconds": 5.75,
          "spoken_seconds": 5.75,
          "tempo_factor": 1.0,
          "speech_start": 67.03,
          "speech_end": 72.78,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "报纸一篇接一篇地渲染，数字越写越大，两百、三百。",
          "start": 74.0,
          "duration": 6.0,
          "source_seconds": 5.329,
          "natural_clip_seconds": 5.02,
          "natural_speech_seconds": 4.91,
          "spoken_seconds": 4.91,
          "tempo_factor": 1.0,
          "speech_start": 74.03,
          "speech_end": 78.94,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "杀人城堡的传说，就这样诞生了。",
          "start": 80.0,
          "duration": 5.0,
          "source_seconds": 4.005,
          "natural_clip_seconds": 3.77,
          "natural_speech_seconds": 3.66,
          "spoken_seconds": 3.66,
          "tempo_factor": 1.0,
          "speech_start": 80.03,
          "speech_end": 83.69,
          "characters": 13,
          "target_chars_per_second": 2.6
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "但真相，比传说更让人不安。",
          "start": 85.0,
          "duration": 6.0,
          "source_seconds": 3.831,
          "natural_clip_seconds": 3.54,
          "natural_speech_seconds": 3.43,
          "spoken_seconds": 3.43,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 88.46,
          "characters": 11,
          "target_chars_per_second": 1.833
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "1894年，他和皮泰泽尔策划假死，想骗一万美元。",
          "start": 91.0,
          "duration": 6.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.32,
          "natural_speech_seconds": 5.21,
          "spoken_seconds": 5.21,
          "tempo_factor": 1.0,
          "speech_start": 91.03,
          "speech_end": 96.24,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "可他临时改了主意，真的害死了皮泰泽尔，自己动的手。",
          "start": 97.0,
          "duration": 6.0,
          "source_seconds": 5.201,
          "natural_clip_seconds": 4.94,
          "natural_speech_seconds": 4.83,
          "spoken_seconds": 4.83,
          "tempo_factor": 1.0,
          "speech_start": 97.03,
          "speech_end": 101.86,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "让他败露的不是那座楼，而是保险诈骗。",
          "start": 103.0,
          "duration": 5.0,
          "source_seconds": 4.725,
          "natural_clip_seconds": 4.42,
          "natural_speech_seconds": 4.31,
          "spoken_seconds": 4.31,
          "tempo_factor": 1.0,
          "speech_start": 103.03,
          "speech_end": 107.34,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "霍姆斯谎称带孩子们去见父亲，一路辗转多个城市。",
          "start": 108.0,
          "duration": 6.0,
          "source_seconds": 6.014,
          "natural_clip_seconds": 5.74,
          "natural_speech_seconds": 5.63,
          "spoken_seconds": 5.63,
          "tempo_factor": 1.0,
          "speech_start": 108.03,
          "speech_end": 113.66,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "三个孩子：艾丽斯十五岁，内莉十一岁，霍华德八岁。",
          "start": 114.0,
          "duration": 6.0,
          "source_seconds": 6.9,
          "natural_clip_seconds": 6.51,
          "natural_speech_seconds": 6.4,
          "spoken_seconds": 5.78,
          "tempo_factor": 1.1089,
          "speech_start": 114.03,
          "speech_end": 119.81,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "在多伦多，他们没能等到回家的那一天。",
          "start": 120.0,
          "duration": 5.0,
          "source_seconds": 3.413,
          "natural_clip_seconds": 3.23,
          "natural_speech_seconds": 3.12,
          "spoken_seconds": 3.12,
          "tempo_factor": 1.0,
          "speech_start": 120.03,
          "speech_end": 123.15,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "印第安纳波利斯的窗台上，放着一只小鞋。",
          "start": 125.0,
          "duration": 5.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 4.06,
          "natural_speech_seconds": 3.95,
          "spoken_seconds": 3.95,
          "tempo_factor": 1.0,
          "speech_start": 125.03,
          "speech_end": 128.98,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "费城侦探弗兰克·盖耶盯着地图，一个城市一个城市地划线。",
          "start": 130.0,
          "duration": 7.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.46,
          "natural_speech_seconds": 5.35,
          "spoken_seconds": 5.35,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 135.38,
          "characters": 24,
          "target_chars_per_second": 3.429
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "他沿着铁路追下去，车站、旅馆、码头，一路问过去。",
          "start": 137.0,
          "duration": 7.0,
          "source_seconds": 5.921,
          "natural_clip_seconds": 5.58,
          "natural_speech_seconds": 5.47,
          "spoken_seconds": 5.47,
          "tempo_factor": 1.0,
          "speech_start": 137.03,
          "speech_end": 142.5,
          "characters": 19,
          "target_chars_per_second": 2.714
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "在多伦多的地窖深处，他找到了那只箱子，撬开时天已经黑了。",
          "start": 144.0,
          "duration": 6.0,
          "source_seconds": 6.223,
          "natural_clip_seconds": 5.98,
          "natural_speech_seconds": 5.87,
          "spoken_seconds": 5.77,
          "tempo_factor": 1.0169,
          "speech_start": 144.03,
          "speech_end": 149.8,
          "characters": 25,
          "target_chars_per_second": 4.167
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "1895年，他承认杀了二十七个人，可其中有人还活着。",
          "start": 150.0,
          "duration": 6.0,
          "source_seconds": 5.7,
          "natural_clip_seconds": 5.4,
          "natural_speech_seconds": 5.29,
          "spoken_seconds": 5.29,
          "tempo_factor": 1.0,
          "speech_start": 150.03,
          "speech_end": 155.32,
          "characters": 23,
          "target_chars_per_second": 3.833
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "法庭只以谋杀皮泰泽尔一案，判他死刑。",
          "start": 156.0,
          "duration": 6.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.29,
          "natural_speech_seconds": 4.18,
          "spoken_seconds": 4.18,
          "tempo_factor": 1.0,
          "speech_start": 156.03,
          "speech_end": 160.21,
          "characters": 16,
          "target_chars_per_second": 2.667
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "1896年5月7日，他在莫亚门辛监狱被执行死刑。",
          "start": 162.0,
          "duration": 6.0,
          "source_seconds": 5.503,
          "natural_clip_seconds": 5.24,
          "natural_speech_seconds": 5.13,
          "spoken_seconds": 5.13,
          "tempo_factor": 1.0,
          "speech_start": 162.03,
          "speech_end": 167.16,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "他要了一口木棺，还要求用水泥把它封死。",
          "start": 168.0,
          "duration": 6.0,
          "source_seconds": 4.598,
          "natural_clip_seconds": 4.36,
          "natural_speech_seconds": 4.25,
          "spoken_seconds": 4.25,
          "tempo_factor": 1.0,
          "speech_start": 168.03,
          "speech_end": 172.28,
          "characters": 17,
          "target_chars_per_second": 2.833
        },
        {
          "id": "S30",
          "narration_id": "N09",
          "text": "能确认的只有九个人；传说和真相，哪个更可怕？",
          "start": 174.0,
          "duration": 6.0,
          "source_seconds": 5.2,
          "natural_clip_seconds": 4.82,
          "natural_speech_seconds": 4.71,
          "spoken_seconds": 4.71,
          "tempo_factor": 1.0,
          "speech_start": 174.03,
          "speech_end": 178.74,
          "characters": 19,
          "target_chars_per_second": 3.167
        }
      ],
      "chapters": [
        {
          "id": "N01",
          "start": 0.0,
          "duration": 10.0,
          "characters": 33,
          "target_chars_per_second": 3.3,
          "source_seconds": 8.823,
          "tempo_factor": 1.0521,
          "inserted_pause_seconds": 0.0,
          "inserted_pause_at_chapter_seconds": null,
          "speech_seconds": 7.72,
          "shot_ids": [
            "S01",
            "S02"
          ]
        },
        {
          "id": "N02",
          "start": 10.0,
          "duration": 25.0,
          "characters": 85,
          "target_chars_per_second": 3.4,
