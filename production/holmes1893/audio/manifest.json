      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "住进去的人，很多再也没有走出来，也没人问起。",
      "sha256": "187eadb0be0975eb46a773ca8b1f56d8c29f0d2a6da788ef0313364ea8b18cb8",
      "voice_id": "voice-03",
      "voice_description": "沉稳磁性男声；讲故事语气，句尾收得轻，像真实犯罪纪录片",
      "narration_id": "N01",
