      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "报纸一篇接一篇地渲染，数字越写越大，两百、三百。",
      "sha256": "bae35b3788f07349909c61314c4fae6cf184a72dfd24bc24abd5cf4ac3a8ec99",
