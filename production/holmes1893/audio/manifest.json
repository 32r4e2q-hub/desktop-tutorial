      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "印第安纳波利斯，艾丽斯只留下一只小鞋。",
      "sha256": "64b9e2fe33f8c205a31c676e8d69ca67666c2f459ab453c8b9f2993484465461",
