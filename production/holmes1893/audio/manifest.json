    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "住进去的人，很多再也没有走出来。",
      "sha256": null,
      "voice_id": "voice-00",
      "voice_description": "沉稳磁性男声；讲故事语气，句尾收得轻，像真实犯罪纪录片",
