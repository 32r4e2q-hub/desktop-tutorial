    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "传说，1893年芝加哥世博会旁，有一栋旅馆。",
      "sha256": "d0addeb3d9491c5a46f51d56976c00d3d0ffdaada22cae9dc5b92cbc063bf981",
      "voice_id": "voice-00",
