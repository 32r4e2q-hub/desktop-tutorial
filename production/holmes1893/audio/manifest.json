      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "1894年，他和皮泰泽尔假死骗保，一万美元。",
      "sha256": "c54102ec9fc4c69c2ae4719163d5750501cd0a88e25572594a17ac4853495444",
