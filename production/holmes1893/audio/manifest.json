      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "他骗皮泰泽尔的妻子，说带三个孩子坐火车，去见父亲。",
      "sha256": "66ef472392aaea437f397cd394f25c9772726c0f018019e16c48f283b8a0acf4",
