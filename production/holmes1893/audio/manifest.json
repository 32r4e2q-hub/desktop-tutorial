      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "让他败露的不是那座楼，而是保险诈骗。",
      "sha256": "2a213ad67237b435f743d641cc4f86ee405cf3ae6eceb3f43fd43f7df6d51cd8",
