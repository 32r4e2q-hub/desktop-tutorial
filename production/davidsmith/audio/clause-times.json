{
 "N01": {
  "duration": 21.885,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.68,
    "text": "他第一次被控杀人",
    "chars_per_second": 5.19
   },
   {
    "i": 1,
    "start": 2.0,
    "end": 3.54,
    "text": "陪审团却给了他无罪",
    "chars_per_second": 5.84
   },
   {
    "i": 2,
    "start": 3.89,
    "end": 4.64,
    "text": "走出法庭",
    "chars_per_second": 5.33
   },
   {
    "i": 3,
    "start": 4.93,
    "end": 6.26,
    "text": "他还向陪审团道谢",
    "chars_per_second": 6.02
   },
   {
    "i": 4,
    "start": 6.61,
    "end": 7.19,
    "text": "六年后",
    "chars_per_second": 5.17
   },
   {
    "i": 5,
    "start": 7.46,
    "end": 8.32,
    "text": "他再杀一人",
    "chars_per_second": 5.81
   },
   {
    "i": 6,
    "start": 8.68,
    "end": 9.36,
    "text": "三十年后",
    "chars_per_second": 5.88
   },
   {
    "i": 7,
    "start": 9.7,
    "end": 11.88,
    "text": "英国修改“一罪不二审”规则",
    "chars_per_second": 5.05
   },
   {
    "i": 8,
    "start": 12.23,
    "end": 13.38,
    "text": "他又站回被告席",
    "chars_per_second": 6.09
   },
   {
    "i": 9,
    "start": 13.73,
    "end": 16.08,
    "text": "这就是卡车司机大卫·史密斯案",
    "chars_per_second": 5.53
   },
   {
    "i": 10,
    "start": 16.43,
    "end": 17.05,
    "text": "今天讲清",
    "chars_per_second": 6.45
   },
   {
    "i": 11,
    "start": 17.39,
    "end": 19.14,
    "text": "他怎样从无罪里走出",
    "chars_per_second": 5.14
   },
   {
    "i": 12,
    "start": 19.48,
    "end": 21.89,
    "text": "又怎样被自己的一句话绊倒",
    "chars_per_second": 4.99
   }
  ]
 },
 "N02": {
  "duration": 29.635,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.95,
    "text": "大卫·史密斯是英国卡车司机",
    "chars_per_second": 4.29
   },
   {
    "i": 1,
    "start": 3.3,
    "end": 4.12,
    "text": "身材高大",
    "chars_per_second": 4.88
   },
   {
    "i": 2,
    "start": 4.46,
    "end": 7.14,
    "text": "绰号“蜂蜜怪兽”或“Lurch”",
    "chars_per_second": 4.48
   },
   {
    "i": 3,
    "start": 7.49,
    "end": 8.01,
    "text": "表面上",
    "chars_per_second": 5.77
   },
   {
    "i": 4,
    "start": 8.28,
    "end": 10.48,
    "text": "他只是伦敦西部一个普通男人",
    "chars_per_second": 5.91
   },
   {
    "i": 5,
    "start": 10.82,
    "end": 12.06,
    "text": "但法庭资料显示",
    "chars_per_second": 5.65
   },
   {
    "i": 6,
    "start": 12.41,
    "end": 16.14,
    "text": "他年轻时就有针对女性的暴力和性犯罪记录",
    "chars_per_second": 5.09
   },
   {
    "i": 7,
    "start": 16.48,
    "end": 18.22,
    "text": "一九七六年持刀强奸",
    "chars_per_second": 5.17
   },
   {
    "i": 8,
    "start": 18.56,
    "end": 21.09,
    "text": "上世纪八十年代非法拘禁女性",
    "chars_per_second": 5.14
   },
   {
    "i": 9,
    "start": 21.44,
    "end": 22.06,
    "text": "九十年代",
    "chars_per_second": 6.45
   },
   {
    "i": 10,
    "start": 22.31,
    "end": 24.33,
    "text": "他用假名接近性工作者",
    "chars_per_second": 4.95
   },
   {
    "i": 11,
    "start": 24.68,
    "end": 25.47,
    "text": "最危险的",
    "chars_per_second": 5.06
   },
   {
    "i": 12,
    "start": 25.82,
    "end": 27.34,
    "text": "往往不是长得像怪物",
    "chars_per_second": 5.92
   },
   {
    "i": 13,
    "start": 27.67,
    "end": 29.64,
    "text": "而是看起来太普通",
    "chars_per_second": 4.07
   }
  ]
 },
 "N03": {
  "duration": 26.465,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.4,
    "text": "一九九一年八月",
    "chars_per_second": 5.6
   },
   {
    "i": 1,
    "start": 1.75,
    "end": 5.94,
    "text": "三十三岁的萨拉·克拉姆在伦敦南奥尔公寓遇害",
    "chars_per_second": 4.77
   },
   {
    "i": 2,
    "start": 6.29,
    "end": 9.55,
    "text": "史密斯承认用假名“邓肯”付钱去见她",
    "chars_per_second": 4.6
   },
   {
    "i": 3,
    "start": 9.89,
    "end": 11.78,
    "text": "却说离开时她还活着",
    "chars_per_second": 4.76
   },
   {
    "i": 4,
    "start": 12.13,
    "end": 12.77,
    "text": "检方认为",
    "chars_per_second": 6.25
   },
   {
    "i": 5,
    "start": 13.12,
    "end": 14.9,
    "text": "他把约见带进密闭空间",
    "chars_per_second": 5.62
   },
   {
    "i": 6,
    "start": 15.19,
    "end": 16.83,
    "text": "再发动袭击并毁尸",
    "chars_per_second": 4.88
   },
   {
    "i": 7,
    "start": 17.17,
    "end": 17.63,
    "text": "六年后",
    "chars_per_second": 6.52
   },
   {
    "i": 8,
    "start": 17.81,
    "end": 19.93,
    "text": "二十一岁的阿曼达·沃克失踪",
    "chars_per_second": 5.66
   },
   {
    "i": 9,
    "start": 20.28,
    "end": 22.57,
    "text": "遗体在萨里郡浅墓中被发现",
    "chars_per_second": 5.24
   },
   {
    "i": 10,
    "start": 22.91,
    "end": 24.42,
    "text": "两案出现相似特征",
    "chars_per_second": 5.3
   },
   {
    "i": 11,
    "start": 24.76,
    "end": 26.46,
    "text": "但第一案的证据链断了",
    "chars_per_second": 5.87
   }
  ]
 },
 "N04": {
  "duration": 24.96,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.05,
    "text": "一九九三年",
    "chars_per_second": 5.49
   },
   {
    "i": 1,
    "start": 1.45,
    "end": 3.34,
    "text": "史密斯在老贝利受审",
    "chars_per_second": 4.76
   },
   {
    "i": 2,
    "start": 3.69,
    "end": 5.11,
    "text": "门把手",
    "chars_per_second": 2.11
   },
   {
    "i": 3,
    "start": 5.3,
    "end": 7.2,
    "text": "抽屉和床下的几枚不明指纹",
    "chars_per_second": 6.32
   },
   {
    "i": 4,
    "start": 7.55,
    "end": 9.92,
    "text": "被辩方解释成“还有另一个人”",
    "chars_per_second": 5.06
   },
   {
    "i": 5,
    "start": 10.27,
    "end": 12.29,
    "text": "警方也被指未披露证据",
    "chars_per_second": 4.95
   },
   {
    "i": 6,
    "start": 12.63,
    "end": 13.75,
    "text": "陪审团判他无罪",
    "chars_per_second": 6.25
   },
   {
    "i": 7,
    "start": 14.1,
    "end": 15.06,
    "text": "他走出法庭",
    "chars_per_second": 5.21
   },
   {
    "i": 8,
    "start": 15.24,
    "end": 16.44,
    "text": "还向陪审团道谢",
    "chars_per_second": 5.83
   },
   {
    "i": 9,
    "start": 16.79,
    "end": 18.48,
    "text": "按当时的“一罪不二审”",
    "chars_per_second": 5.33
   },
   {
    "i": 10,
    "start": 18.83,
    "end": 20.28,
    "text": "同一罪名不能再审",
    "chars_per_second": 5.52
   },
   {
    "i": 11,
    "start": 20.62,
    "end": 22.75,
    "text": "这桩命案像被法律锁死",
    "chars_per_second": 4.69
   },
   {
    "i": 12,
    "start": 23.1,
    "end": 24.96,
    "text": "可史密斯没有停手",
    "chars_per_second": 4.3
   }
  ]
 },
 "N05": {
  "duration": 31.135,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.24,
    "text": "一九九九年",
    "chars_per_second": 4.59
   },
   {
    "i": 1,
    "start": 1.58,
    "end": 3.62,
    "text": "阿曼达案把他送进监狱",
    "chars_per_second": 4.9
   },
   {
    "i": 2,
    "start": 3.96,
    "end": 6.96,
    "text": "她衣物上的血迹 DNA 指向史密斯",
    "chars_per_second": 5.0
   },
   {
    "i": 3,
    "start": 7.3,
    "end": 8.99,
    "text": "陪审团不信他的辩解",
    "chars_per_second": 5.33
   },
   {
    "i": 4,
    "start": 9.34,
    "end": 10.06,
    "text": "候审期间",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 10.32,
    "end": 12.09,
    "text": "他还向同仓犯人吹嘘",
    "chars_per_second": 5.08
   },
   {
    "i": 6,
    "start": 12.44,
    "end": 14.22,
    "text": "“上一桩谋杀我走掉了",
    "chars_per_second": 5.06
   },
   {
    "i": 7,
    "start": 14.56,
    "end": 15.46,
    "text": "他们没有证据",
    "chars_per_second": 6.67
   },
   {
    "i": 8,
    "start": 15.8,
    "end": 18.1,
    "text": "”二零零三年英国修改法律",
    "chars_per_second": 4.78
   },
   {
    "i": 9,
    "start": 18.44,
    "end": 21.59,
    "text": "允许新且有说服力的证据触发重审",
    "chars_per_second": 4.76
   },
   {
    "i": 10,
    "start": 21.93,
    "end": 22.78,
    "text": "二零二二年",
    "chars_per_second": 5.88
   },
   {
    "i": 11,
    "start": 23.03,
    "end": 24.63,
    "text": "上诉法院准许重审",
    "chars_per_second": 5.0
   },
   {
    "i": 12,
    "start": 24.97,
    "end": 25.77,
    "text": "狱中吹嘘",
    "chars_per_second": 5.0
   },
   {
    "i": 13,
    "start": 26.09,
    "end": 27.13,
    "text": "两案相似性",
    "chars_per_second": 4.81
   },
   {
    "i": 14,
    "start": 27.48,
    "end": 29.39,
    "text": "以及指纹属于前房主",
    "chars_per_second": 4.71
   },
   {
    "i": 15,
    "start": 29.74,
    "end": 31.14,
    "text": "拼成新证据链",
    "chars_per_second": 4.3
   }
  ]
 },
 "N06": {
  "duration": 27.75,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.47,
    "text": "二零二三年五月",
    "chars_per_second": 5.3
   },
   {
    "i": 1,
    "start": 1.81,
    "end": 3.34,
    "text": "萨拉遇害三十二年",
    "chars_per_second": 5.23
   },
   {
    "i": 2,
    "start": 3.69,
    "end": 5.4,
    "text": "史密斯无罪三十年后",
    "chars_per_second": 5.26
   },
   {
    "i": 3,
    "start": 5.75,
    "end": 8.76,
    "text": "陪审团用不到三小时判他有罪",
    "chars_per_second": 4.32
   },
   {
    "i": 4,
    "start": 9.1,
    "end": 10.65,
    "text": "法官判终身监禁",
    "chars_per_second": 4.52
   },
   {
    "i": 5,
    "start": 11.0,
    "end": 12.06,
    "text": "最低二十七年",
    "chars_per_second": 5.66
   },
   {
    "i": 6,
    "start": 12.4,
    "end": 14.44,
    "text": "扣除九十年代羁押时间",
    "chars_per_second": 4.9
   },
   {
    "i": 7,
    "start": 14.62,
    "end": 17.13,
    "text": "他本来已因阿曼达案服终身刑",
    "chars_per_second": 5.18
   },
   {
    "i": 8,
    "start": 17.57,
    "end": 18.89,
    "text": "判决还不回生命",
    "chars_per_second": 5.3
   },
   {
    "i": 9,
    "start": 19.23,
    "end": 21.38,
    "text": "却把“无罪”改写成“有罪”",
    "chars_per_second": 4.19
   },
   {
    "i": 10,
    "start": 21.72,
    "end": 22.12,
    "text": "你觉得",
    "chars_per_second": 7.5
   },
   {
    "i": 11,
    "start": 22.46,
    "end": 24.64,
    "text": "击穿他的到底是法律改变",
    "chars_per_second": 5.05
   },
   {
    "i": 12,
    "start": 24.99,
    "end": 26.47,
    "text": "还是那句狱中吹嘘",
    "chars_per_second": 5.41
   },
   {
    "i": 13,
    "start": 26.82,
    "end": 27.75,
    "text": "评论区聊聊",
    "chars_per_second": 5.38
   }
  ]
 }
}