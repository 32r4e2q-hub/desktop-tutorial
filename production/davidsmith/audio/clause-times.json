{
 "N01": {
  "duration": 25.03,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.79,
    "text": "一个男人",
    "chars_per_second": 6.25
   },
   {
    "i": 1,
    "start": 1.15,
    "end": 2.89,
    "text": "刚在法庭上被判无罪",
    "chars_per_second": 5.17
   },
   {
    "i": 2,
    "start": 3.23,
    "end": 4.91,
    "text": "竟然还向陪审团道谢",
    "chars_per_second": 5.36
   },
   {
    "i": 3,
    "start": 5.25,
    "end": 5.85,
    "text": "六年后",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 6.2,
    "end": 7.3,
    "text": "他再次杀人",
    "chars_per_second": 4.55
   },
   {
    "i": 5,
    "start": 7.64,
    "end": 8.38,
    "text": "三十年后",
    "chars_per_second": 5.41
   },
   {
    "i": 6,
    "start": 8.73,
    "end": 11.23,
    "text": "一条改过的「一罪不二审」法律",
    "chars_per_second": 4.8
   },
   {
    "i": 7,
    "start": 11.57,
    "end": 13.32,
    "text": "加上一句狱中吹嘘",
    "chars_per_second": 4.57
   },
   {
    "i": 8,
    "start": 13.67,
    "end": 15.33,
    "text": "把他重新送上被告席",
    "chars_per_second": 5.42
   },
   {
    "i": 9,
    "start": 15.68,
    "end": 17.92,
    "text": "他就是英国的大卫·史密斯",
    "chars_per_second": 4.91
   },
   {
    "i": 10,
    "start": 18.26,
    "end": 18.58,
    "text": "今天",
    "chars_per_second": 6.25
   },
   {
    "i": 11,
    "start": 18.91,
    "end": 21.7,
    "text": "一口气看懂这场迟到三十年的翻案",
    "chars_per_second": 5.38
   },
   {
    "i": 12,
    "start": 22.03,
    "end": 22.36,
    "text": "关键",
    "chars_per_second": 6.06
   },
   {
    "i": 13,
    "start": 22.7,
    "end": 25.03,
    "text": "是旧证据被重新读懂",
    "chars_per_second": 3.86
   }
  ]
 },
 "N02": {
  "duration": 24.045,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.51,
    "text": "史密斯是英国卡车司机",
    "chars_per_second": 4.22
   },
   {
    "i": 1,
    "start": 2.86,
    "end": 3.55,
    "text": "身材高大",
    "chars_per_second": 5.8
   },
   {
    "i": 2,
    "start": 3.9,
    "end": 5.0,
    "text": "外号「大脚怪」",
    "chars_per_second": 4.55
   },
   {
    "i": 3,
    "start": 5.34,
    "end": 5.96,
    "text": "同事眼里",
    "chars_per_second": 6.45
   },
   {
    "i": 4,
    "start": 6.22,
    "end": 7.93,
    "text": "他只是个沉默的普通人",
    "chars_per_second": 5.85
   },
   {
    "i": 5,
    "start": 8.28,
    "end": 9.55,
    "text": "但在这层外表下面",
    "chars_per_second": 6.3
   },
   {
    "i": 6,
    "start": 9.86,
    "end": 13.33,
    "text": "是从年轻时就不断升级的性暴力前科",
    "chars_per_second": 4.61
   },
   {
    "i": 7,
    "start": 13.68,
    "end": 14.25,
    "text": "九十年代",
    "chars_per_second": 7.02
   },
   {
    "i": 8,
    "start": 14.53,
    "end": 18.39,
    "text": "他用假名「邓肯」接近三十三岁的萨拉·克拉姆",
    "chars_per_second": 4.66
   },
   {
    "i": 9,
    "start": 18.74,
    "end": 20.11,
    "text": "表面是付费见面",
    "chars_per_second": 5.11
   },
   {
    "i": 10,
    "start": 20.46,
    "end": 24.05,
    "text": "背后却是一场没人能及时阻止的危险",
    "chars_per_second": 4.46
   }
  ]
 },
 "N03": {
  "duration": 29.365,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.41,
    "text": "一九九一年八月",
    "chars_per_second": 5.56
   },
   {
    "i": 1,
    "start": 1.76,
    "end": 4.26,
    "text": "克拉姆在伦敦南豪尔的公寓遇害",
    "chars_per_second": 5.6
   },
   {
    "i": 2,
    "start": 4.6,
    "end": 5.31,
    "text": "警方发现",
    "chars_per_second": 5.63
   },
   {
    "i": 3,
    "start": 5.57,
    "end": 7.27,
    "text": "现场留下的伤害方式",
    "chars_per_second": 5.29
   },
   {
    "i": 4,
    "start": 7.61,
    "end": 10.25,
    "text": "后来被认为与另一宗案件高度相似",
    "chars_per_second": 5.68
   },
   {
    "i": 5,
    "start": 10.6,
    "end": 11.09,
    "text": "六年后",
    "chars_per_second": 6.12
   },
   {
    "i": 6,
    "start": 11.44,
    "end": 13.43,
    "text": "二十一岁的阿曼达·沃克失踪",
    "chars_per_second": 6.03
   },
   {
    "i": 7,
    "start": 13.78,
    "end": 16.18,
    "text": "遗体在萨里郡威斯利附近被发现",
    "chars_per_second": 5.83
   },
   {
    "i": 8,
    "start": 16.53,
    "end": 18.45,
    "text": "两案都指向同一个模式",
    "chars_per_second": 5.21
   },
   {
    "i": 9,
    "start": 18.98,
    "end": 19.99,
    "text": "用假名接触",
    "chars_per_second": 4.95
   },
   {
    "i": 10,
    "start": 20.33,
    "end": 22.49,
    "text": "在相对封闭的空间里实施暴力",
    "chars_per_second": 6.02
   },
   {
    "i": 11,
    "start": 22.84,
    "end": 24.41,
    "text": "再把受害者带离现场",
    "chars_per_second": 5.73
   },
   {
    "i": 12,
    "start": 24.72,
    "end": 25.91,
    "text": "藏匿或弃置",
    "chars_per_second": 4.2
   },
   {
    "i": 13,
    "start": 26.25,
    "end": 27.38,
    "text": "可真正可怕的",
    "chars_per_second": 5.31
   },
   {
    "i": 14,
    "start": 27.63,
    "end": 29.36,
    "text": "是第一次审判之后",
    "chars_per_second": 4.61
   }
  ]
 },
 "N04": {
  "duration": 23.305,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.16,
    "text": "一九九三年",
    "chars_per_second": 4.95
   },
   {
    "i": 1,
    "start": 1.49,
    "end": 3.49,
    "text": "史密斯因克拉姆案受审",
    "chars_per_second": 5.0
   },
   {
    "i": 2,
    "start": 3.83,
    "end": 8.07,
    "text": "辩方抓住了现场指纹没有及时解释这一证据链瑕疵",
    "chars_per_second": 5.19
   },
   {
    "i": 3,
    "start": 8.42,
    "end": 10.03,
    "text": "陪审团最终判他无罪",
    "chars_per_second": 5.59
   },
   {
    "i": 4,
    "start": 10.38,
    "end": 11.91,
    "text": "史密斯走出法庭时",
    "chars_per_second": 5.23
   },
   {
    "i": 5,
    "start": 12.11,
    "end": 13.45,
    "text": "甚至向陪审团道谢",
    "chars_per_second": 5.97
   },
   {
    "i": 6,
    "start": 13.8,
    "end": 15.45,
    "text": "受害者母亲当庭警告",
    "chars_per_second": 5.45
   },
   {
    "i": 7,
    "start": 15.8,
    "end": 16.99,
    "text": "他还会再杀人",
    "chars_per_second": 5.04
   },
   {
    "i": 8,
    "start": 17.34,
    "end": 17.9,
    "text": "六年后",
    "chars_per_second": 5.36
   },
   {
    "i": 9,
    "start": 18.22,
    "end": 20.42,
    "text": "沃克案让这句警告成了事实",
    "chars_per_second": 5.45
   },
   {
    "i": 10,
    "start": 20.77,
    "end": 22.07,
    "text": "史密斯被判谋杀",
    "chars_per_second": 5.38
   },
   {
    "i": 11,
    "start": 22.36,
    "end": 23.3,
    "text": "终身监禁",
    "chars_per_second": 4.23
   }
  ]
 },
 "N05": {
  "duration": 29.23,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.92,
    "text": "但他在狱中又犯了一个致命错误",
    "chars_per_second": 5.05
   },
   {
    "i": 1,
    "start": 3.25,
    "end": 4.72,
    "text": "向同仓犯人吹嘘",
    "chars_per_second": 4.76
   },
   {
    "i": 2,
    "start": 5.03,
    "end": 7.06,
    "text": "自己当年「已经逃过了」",
    "chars_per_second": 4.43
   },
   {
    "i": 3,
    "start": 7.4,
    "end": 10.44,
    "text": "英国后来通过二零零三年《刑事司法法》",
    "chars_per_second": 5.26
   },
   {
    "i": 4,
    "start": 10.79,
    "end": 13.64,
    "text": "给「一罪不二审」开出极窄的例外",
    "chars_per_second": 4.56
   },
   {
    "i": 5,
    "start": 13.98,
    "end": 14.98,
    "text": "只有出现新的",
    "chars_per_second": 6.0
   },
   {
    "i": 6,
    "start": 15.2,
    "end": 16.5,
    "text": "令人信服的证据",
    "chars_per_second": 5.38
   },
   {
    "i": 7,
    "start": 16.71,
    "end": 17.7,
    "text": "才可能重审",
    "chars_per_second": 5.05
   },
   {
    "i": 8,
    "start": 18.05,
    "end": 18.83,
    "text": "二零二二年",
    "chars_per_second": 6.41
   },
   {
    "i": 9,
    "start": 19.02,
    "end": 20.84,
    "text": "上诉法院推翻旧判决",
    "chars_per_second": 4.95
   },
   {
    "i": 10,
    "start": 21.18,
    "end": 23.31,
    "text": "旧指纹被查明属于前屋主",
    "chars_per_second": 5.16
   },
   {
    "i": 11,
    "start": 23.65,
    "end": 26.23,
    "text": "加上狱中吹嘘和沃克案的相似性",
    "chars_per_second": 5.43
   },
   {
    "i": 12,
    "start": 26.58,
    "end": 29.23,
    "text": "三十年前的证据链终于闭合",
    "chars_per_second": 4.53
   }
  ]
 },
 "N06": {
  "duration": 26.695,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.35,
    "text": "二零二三年五月",
    "chars_per_second": 5.83
   },
   {
    "i": 1,
    "start": 1.7,
    "end": 6.72,
    "text": "重审陪审团不到三小时就裁定史密斯谋杀克拉姆罪名成立",
    "chars_per_second": 4.98
   },
   {
    "i": 2,
    "start": 7.07,
    "end": 8.43,
    "text": "他被判终身监禁",
    "chars_per_second": 5.15
   },
   {
    "i": 3,
    "start": 8.78,
    "end": 10.29,
    "text": "最低刑期二十七年",
    "chars_per_second": 5.3
   },
   {
    "i": 4,
    "start": 10.63,
    "end": 11.99,
    "text": "而沃克案的无期刑",
    "chars_per_second": 5.88
   },
   {
    "i": 5,
    "start": 12.26,
    "end": 13.15,
    "text": "他早已在服",
    "chars_per_second": 5.62
   },
   {
    "i": 6,
    "start": 13.5,
    "end": 14.98,
    "text": "迟到三十年的正义",
    "chars_per_second": 5.41
   },
   {
    "i": 7,
    "start": 15.33,
    "end": 16.63,
    "text": "靠的不是一句传闻",
    "chars_per_second": 6.15
   },
   {
    "i": 8,
    "start": 16.97,
    "end": 19.34,
    "text": "而是法律给证据留下的窄门",
    "chars_per_second": 5.06
   },
   {
    "i": 9,
    "start": 19.56,
    "end": 21.82,
    "text": "以及凶手亲口留下的回声",
    "chars_per_second": 4.87
   },
   {
    "i": 10,
    "start": 22.16,
    "end": 22.53,
    "text": "你觉得",
    "chars_per_second": 8.11
   },
   {
    "i": 11,
    "start": 22.88,
    "end": 24.18,
    "text": "「一罪不二审」的例外",
    "chars_per_second": 6.15
   },
   {
    "i": 12,
    "start": 24.52,
    "end": 25.4,
    "text": "应该更严格",
    "chars_per_second": 5.68
   },
   {
    "i": 13,
    "start": 25.72,
    "end": 26.7,
    "text": "还是更勇敢",
    "chars_per_second": 5.13
   }
  ]
 }
}