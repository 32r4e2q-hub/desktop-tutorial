[
  {
    "start": 0.6639309951163823,
    "end": 1.6015855901566565,
    "text": "一个男人，"
  },
  {
    "start": 1.729447580389421,
    "end": 3.8391704192300375,
    "text": "刚在法庭上被判无罪，"
  },
  {
    "start": 3.945722077757342,
    "end": 5.991513921481576,
    "text": "竟然还向陪审团道谢。"
  },
  {
    "start": 6.098065580008879,
    "end": 6.993099511638231,
    "text": "六年后，"
  },
  {
    "start": 7.110306336018266,
    "end": 8.538098560284139,
    "text": "他再次杀人；"
  },
  {
    "start": 8.644650218811442,
    "end": 9.68885647237902,
    "text": "三十年后，"
  },
  {
    "start": 9.806063296759055,
    "end": 12.725578740407181,
    "text": "一条改过的「一罪不二审」法律，"
  },
  {
    "start": 12.832130398934485,
    "end": 14.952508403627832,
    "text": "加上一句狱中吹嘘，"
  },
  {
    "start": 15.069715228007865,
    "end": 17.09419674002664,
    "text": "把他重新送上被告席。"
  },
  {
    "start": 17.211403564406673,
    "end": 19.85388469588381,
    "text": "他就是英国的大卫·史密斯。"
  },
  {
    "start": 19.960436354411115,
    "end": 20.557125642164014,
    "text": "今天，"
  },
  {
    "start": 20.65302213483859,
    "end": 23.881537388215893,
    "text": "一口气看懂这场迟到三十年的翻案。"
  },
  {
    "start": 23.977433880890473,
    "end": 24.5847783344961,
    "text": "关键，"
  },
  {
    "start": 24.691329993023405,
    "end": 27.26988012938416,
    "text": "是旧证据被重新读懂。"
  },
  {
    "start": 28.34988012938416,
    "end": 31.130878416946793,
    "text": "史密斯是英国卡车司机，"
  },
  {
    "start": 31.36529206570686,
    "end": 32.281636329041675,
    "text": "身材高大，"
  },
  {
    "start": 32.45211898268536,
    "end": 33.83729054354031,
    "text": "外号「大脚怪」；"
  },
  {
    "start": 33.96515253377308,
    "end": 34.83887613369697,
    "text": "同事眼里，"
  },
  {
    "start": 34.90280712881335,
    "end": 37.01252996765397,
    "text": "他只是个沉默的普通人。"
  },
  {
    "start": 37.01252996765397,
    "end": 38.65342550897444,
    "text": "但在这层外表下面，"
  },
  {
    "start": 38.759977167501745,
    "end": 42.70238853301199,
    "text": "是从年轻时就不断升级的性暴力前科。"
  },
  {
    "start": 42.72369886471745,
    "end": 43.682663791463185,
    "text": "九十年代，"
  },
  {
    "start": 43.83183611340141,
    "end": 48.115212786199024,
    "text": "他用假名「邓肯」接近三十三岁的萨拉·克拉姆。"
  },
  {
    "start": 48.15783344960995,
    "end": 49.926590981163194,
    "text": "表面是付费见面，"
  },
  {
    "start": 50.01183230798504,
    "end": 53.86900234667344,
    "text": "背后却是一场没人能及时阻止的危险。"
  },
  {
    "start": 55.05022642227438,
    "end": 56.72308746115305,
    "text": "一九九一年八月，"
  },
  {
    "start": 56.914880446502195,
    "end": 59.749154563328474,
    "text": "克拉姆在伦敦南豪尔的公寓遇害。"
  },
  {
    "start": 59.91963721697216,
    "end": 60.81467114860152,
    "text": "警方发现，"
  },
  {
    "start": 60.9851538022452,
    "end": 62.945704319147595,
    "text": "现场留下的伤害方式，"
  },
  {
    "start": 63.13749730449674,
    "end": 66.14225407496671,
    "text": "后来被认为与另一宗案件高度相似。"
  },
  {
    "start": 66.14225407496671,
    "end": 67.05859833830152,
    "text": "六年后，"
  },
  {
    "start": 67.05859833830152,
    "end": 69.48797615272406,
    "text": "二十一岁的阿曼达·沃克失踪，"
  },
  {
    "start": 69.59452781125135,
    "end": 72.47142259148856,
    "text": "遗体在萨里郡威斯利附近被发现。"
  },
  {
    "start": 72.59928458172132,
    "end": 74.87949007420562,
    "text": "两案都指向同一个模式："
  },
  {
    "start": 75.13521405467117,
    "end": 76.49907528382064,
    "text": "用假名接触，"
  },
  {
    "start": 76.60562694234795,
    "end": 79.22679774211963,
    "text": "在相对封闭的空间里实施暴力，"
  },
  {
    "start": 79.26941840553054,
    "end": 81.22996892243293,
    "text": "再把受害者带离现场、"
  },
  {
    "start": 81.40045157607662,
    "end": 82.80693346863703,
    "text": "藏匿或弃置。"
  },
  {
    "start": 82.80693346863703,
    "end": 84.38389801484112,
    "text": "可真正可怕的，"
  },
  {
    "start": 84.46913934166298,
    "end": 86.23789687321621,
    "text": "是第一次审判之后。"
  },
  {
    "start": 87.41912094881715,
    "end": 88.7723270121139,
    "text": "一九九三年，"
  },
  {
    "start": 89.09198198769582,
    "end": 91.28694615335829,
    "text": "史密斯因克拉姆案受审。"
  },
  {
    "start": 91.39349781188558,
    "end": 96.12439145049788,
    "text": "辩方抓住了现场指纹没有及时解释这一证据链瑕疵，"
  },
  {
    "start": 96.42273609437433,
    "end": 98.36197627957125,
    "text": "陪审团最终判他无罪。"
  },
  {
    "start": 98.46852793809856,
    "end": 100.1946648062409,
    "text": "史密斯走出法庭时，"
  },
  {
    "start": 100.36514745988457,
    "end": 101.89949134267775,
    "text": "甚至向陪审团道谢。"
  },
  {
    "start": 102.06997399632144,
    "end": 104.03052451322382,
    "text": "受害者母亲当庭警告："
  },
  {
    "start": 104.13707617175113,
    "end": 105.65010972283885,
    "text": "他还会再杀人。"
  },
  {
    "start": 105.69273038624976,
    "end": 106.63038498129004,
    "text": "六年后，"
  },
  {
    "start": 106.7582469715228,
    "end": 111.04162364432042,
    "text": "沃克案让这句警告成了事实——史密斯被判谋杀，"
  },
  {
    "start": 111.12686497114227,
    "end": 112.12845056129892,
    "text": "终身监禁。"
  },
  {
    "start": 113.33098496860532,
    "end": 116.62343121709901,
    "text": "但他在狱中又犯了一个致命错误："
  },
  {
    "start": 116.62343121709901,
    "end": 118.4774300754741,
    "text": "向同仓犯人吹嘘，"
  },
  {
    "start": 118.73315405593962,
    "end": 121.18384220206761,
    "text": "自己当年「已经逃过了」。"
  },
  {
    "start": 121.18384220206761,
    "end": 124.4017022895922,
    "text": "英国后来通过二零零三年《刑事司法法》，"
  },
  {
    "start": 124.65742627005773,
    "end": 128.06707934293144,
    "text": "给「一罪不二审」开出极窄的例外："
  },
  {
    "start": 128.06707934293144,
    "end": 129.49487156719732,
    "text": "只有出现新的、"
  },
  {
    "start": 129.49487156719732,
    "end": 131.05052578169597,
    "text": "令人信服的证据，"
  },
  {
    "start": 131.15707744022325,
    "end": 132.35045601572907,
    "text": "才可能重审。"
  },
  {
    "start": 132.35045601572907,
    "end": 133.47990359611848,
    "text": "二零二二年，"
  },
  {
    "start": 133.54383459123486,
    "end": 135.6961780934864,
    "text": "上诉法院推翻旧判决；"
  },
  {
    "start": 135.93059174224646,
    "end": 138.359969556669,
    "text": "旧指纹被查明属于前屋主，"
  },
  {
    "start": 138.42390055178538,
    "end": 141.47127798566626,
    "text": "加上狱中吹嘘和沃克案的相似性，"
  },
  {
    "start": 141.47127798566626,
    "end": 144.39079342931439,
    "text": "三十年前的证据链终于闭合。"
  },
  {
    "start": 145.55603475613623,
    "end": 146.96251664869664,
    "text": "二零二三年五月，"
  },
  {
    "start": 146.96251664869664,
    "end": 151.67209995560347,
    "text": "重审陪审团不到三小时就裁定史密斯谋杀克拉姆罪"
  },
  {
    "start": 151.67209995560347,
    "end": 152.26878924335637,
    "text": "名成立。"
  },
  {
    "start": 152.26878924335637,
    "end": 154.101477770026,
    "text": "他被判终身监禁，"
  },
  {
    "start": 154.101477770026,
    "end": 155.998097291812,
    "text": "最低刑期二十七年；"
  },
  {
    "start": 155.998097291812,
    "end": 157.80947548677617,
    "text": "而沃克案的无期刑，"
  },
  {
    "start": 157.80947548677617,
    "end": 158.9815437305765,
    "text": "他早已在服。"
  },
  {
    "start": 158.9815437305765,
    "end": 160.87816325236253,
    "text": "迟到三十年的正义，"
  },
  {
    "start": 160.87816325236253,
    "end": 162.81740343755945,
    "text": "靠的不是一句传闻，"
  },
  {
    "start": 162.81740343755945,
    "end": 165.75822921291305,
    "text": "而是法律给证据留下的窄门，"
  },
  {
    "start": 165.75822921291305,
    "end": 168.2302276907465,
    "text": "以及凶手亲口留下的回声。"
  },
  {
    "start": 168.2302276907465,
    "end": 169.23181328090314,
    "text": "你觉得，"
  },
  {
    "start": 169.23181328090314,
    "end": 171.12843280268916,
    "text": "「一罪不二审」的例外，"
  },
  {
    "start": 171.12843280268916,
    "end": 172.44967336842774,
    "text": "应该更严格，"
  },
  {
    "start": 172.44967336842774,
    "end": 174.0,
    "text": "还是更勇敢？"
  }
]