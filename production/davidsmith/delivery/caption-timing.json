[
  {
    "start": 0.6639309951163823,
    "end": 1.6015855901566565,
    "text": "一个男人，"
  },
  {
    "start": 1.729447580389421,
    "end": 3.8391704192300375,
    "text": "刚在法庭上被判无罪，"
  },
  {
    "start": 3.945722077757342,
    "end": 5.991513921481576,
    "text": "竟然还向陪审团道谢。"
  },
  {
    "start": 6.098065580008879,
    "end": 6.993099511638231,
    "text": "六年后，"
  },
  {
    "start": 7.110306336018266,
    "end": 8.538098560284139,
    "text": "他再次杀人；"
  },
  {
    "start": 8.644650218811442,
    "end": 9.68885647237902,
    "text": "三十年后，"
  },
  {
    "start": 9.806063296759055,
    "end": 12.725578740407181,
    "text": "一条改过的「一罪不二审」法律，"
  },
  {
    "start": 12.832130398934485,
    "end": 14.952508403627832,
    "text": "加上一句狱中吹嘘，"
  },
  {
    "start": 15.069715228007865,
    "end": 17.09419674002664,
    "text": "把他重新送上被告席。"
  },
  {
    "start": 17.211403564406673,
    "end": 19.85388469588381,
    "text": "他就是英国的大卫·史密斯。"
  },
  {
    "start": 19.960436354411115,
    "end": 20.557125642164014,
    "text": "今天，"
  },
  {
    "start": 20.65302213483859,
    "end": 23.881537388215893,
    "text": "一口气看懂这场迟到三十年的翻案。"
  },
  {
    "start": 23.977433880890473,
    "end": 24.5847783344961,
    "text": "关键，"
  },
  {
    "start": 24.691329993023405,
    "end": 27.26988012938416,
    "text": "是旧证据被重新读懂。"
  },
  {
    "start": 28.40315595864781,
    "end": 31.184154246210444,
    "text": "史密斯是英国卡车司机，"
  },
  {
    "start": 31.301361070590477,
    "end": 32.29229149489441,
    "text": "身材高大，"
  },
  {
    "start": 32.40949831927444,
    "end": 33.83729054354031,
    "text": "外号「大脚怪」；"
  },
  {
    "start": 33.943842202067614,
    "end": 34.86018646540243,
    "text": "同事眼里，"
  },
  {
    "start": 34.881496797107886,
    "end": 36.959254138390314,
    "text": "他只是个沉默的普通人。"
  },
  {
    "start": 37.07646096277035,
    "end": 38.68539100653264,
    "text": "但在这层外表下面，"
  },
  {
    "start": 38.759977167501745,
    "end": 42.71304369886472,
    "text": "是从年轻时就不断升级的性暴力前科。"
  },
  {
    "start": 42.83025052324476,
    "end": 43.69331895731592,
    "text": "九十年代，"
  },
  {
    "start": 43.73593962072684,
    "end": 48.1045576203463,
    "text": "他用假名「邓肯」接近三十三岁的萨拉·克拉姆。"
  },
  {
    "start": 48.22176444472633,
    "end": 49.93724614701593,
    "text": "表面是付费见面，"
  },
  {
    "start": 50.05445297139596,
    "end": 53.97022642227438,
    "text": "背后却是一场没人能及时阻止的危险。"
  },
  {
    "start": 55.05022642227438,
    "end": 56.72308746115305,
    "text": "一九九一年八月，"
  },
  {
    "start": 56.914880446502195,
    "end": 59.72784423162302,
    "text": "克拉姆在伦敦南豪尔的公寓遇害。"
  },
  {
    "start": 59.83439589015032,
    "end": 60.793360816896055,
    "text": "警方发现，"
  },
  {
    "start": 61.02777446565612,
    "end": 62.92439398744213,
    "text": "现场留下的伤害方式，"
  },
  {
    "start": 63.052255977674896,
    "end": 66.14225407496671,
    "text": "后来被认为与另一宗案件高度相似。"
  },
  {
    "start": 66.14225407496671,
    "end": 67.03728800659606,
    "text": "六年后，"
  },
  {
    "start": 67.22908099194521,
    "end": 69.48797615272406,
    "text": "二十一岁的阿曼达·沃克失踪，"
  },
  {
    "start": 69.57321747954589,
    "end": 72.47142259148856,
    "text": "遗体在萨里郡威斯利附近被发现。"
  },
  {
    "start": 72.59928458172132,
    "end": 74.87949007420562,
    "text": "两案都指向同一个模式："
  },
  {
    "start": 75.07128305955477,
    "end": 76.47776495211518,
    "text": "用假名接触，"
  },
  {
    "start": 76.52038561552611,
    "end": 79.20548741041416,
    "text": "在相对封闭的空间里实施暴力，"
  },
  {
    "start": 79.29072873723601,
    "end": 81.22996892243293,
    "text": "再把受害者带离现场、"
  },
  {
    "start": 81.42176190778208,
    "end": 82.80693346863703,
    "text": "藏匿或弃置。"
  },
  {
    "start": 82.89217479545889,
    "end": 84.40520834654659,
    "text": "可真正可怕的，"
  },
  {
    "start": 84.49044967336843,
    "end": 86.23789687321621,
    "text": "是第一次审判之后。"
  },
  {
    "start": 87.48305194393353,
    "end": 88.81494767552483,
    "text": "一九九三年，"
  },
  {
    "start": 88.9108441681994,
    "end": 91.29760131921101,
    "text": "史密斯因克拉姆案受审。"
  },
  {
    "start": 91.40415297773832,
    "end": 96.17766727976154,
    "text": "辩方抓住了现场指纹没有及时解释这一证据链瑕疵，"
  },
  {
    "start": 96.29487410414157,
    "end": 98.26607978689668,
    "text": "陪审团最终判他无罪。"
  },
  {
    "start": 98.38328661127672,
    "end": 100.22663030379908,
    "text": "史密斯走出法庭时，"
  },
  {
    "start": 100.22663030379908,
    "end": 101.91014650853047,
    "text": "甚至向陪审团道谢。"
  },
  {
    "start": 102.02735333291051,
    "end": 104.04117967907655,
    "text": "受害者母亲当庭警告："
  },
  {
    "start": 104.1583865034566,
    "end": 105.68207522039702,
    "text": "他还会再杀人。"
  },
  {
    "start": 105.79928204477707,
    "end": 106.6516953129955,
    "text": "六年后，"
  },
  {
    "start": 106.73693663981734,
    "end": 111.09489947358406,
    "text": "沃克案让这句警告成了事实——史密斯被判谋杀，"
  },
  {
    "start": 111.14817530284772,
    "end": 112.25098496860532,
    "text": "终身监禁。"
  },
  {
    "start": 113.33098496860532,
    "end": 116.60212088539355,
    "text": "但他在狱中又犯了一个致命错误："
  },
  {
    "start": 116.77260353903723,
    "end": 118.4774300754741,
    "text": "向同仓犯人吹嘘，"
  },
  {
    "start": 118.73315405593962,
    "end": 121.18384220206761,
    "text": "自己当年「已经逃过了」。"
  },
  {
    "start": 121.18384220206761,
    "end": 124.4017022895922,
    "text": "英国后来通过二零零三年《刑事司法法》，"
  },
  {
    "start": 124.70004693346864,
    "end": 128.08838967463691,
    "text": "给「一罪不二审」开出极窄的例外："
  },
  {
    "start": 128.08838967463691,
    "end": 129.51618189890277,
    "text": "只有出现新的、"
  },
  {
    "start": 129.51618189890277,
    "end": 131.05052578169597,
    "text": "令人信服的证据，"
  },
  {
    "start": 131.15707744022325,
    "end": 132.35045601572907,
    "text": "才可能重审。"
  },
  {
    "start": 132.41438701084545,
    "end": 133.47990359611848,
    "text": "二零二二年，"
  },
  {
    "start": 133.47990359611848,
    "end": 135.71748842519187,
    "text": "上诉法院推翻旧判决；"
  },
  {
    "start": 135.93059174224646,
    "end": 138.33865922496355,
    "text": "旧指纹被查明属于前屋主，"
  },
  {
    "start": 138.33865922496355,
    "end": 141.47127798566626,
    "text": "加上狱中吹嘘和沃克案的相似性，"
  },
  {
    "start": 141.47127798566626,
    "end": 144.41210376101986,
    "text": "三十年前的证据链终于闭合。"
  },
  {
    "start": 145.55603475613623,
    "end": 146.96251664869664,
    "text": "二零二三年五月，"
  },
  {
    "start": 146.96251664869664,
    "end": 151.67209995560347,
    "text": "重审陪审团不到三小时就裁定史密斯谋杀克拉姆罪"
  },
  {
    "start": 151.67209995560347,
    "end": 152.26878924335637,
    "text": "名成立。"
  },
  {
    "start": 152.26878924335637,
    "end": 154.101477770026,
    "text": "他被判终身监禁，"
  },
  {
    "start": 154.101477770026,
    "end": 155.998097291812,
    "text": "最低刑期二十七年；"
  },
  {
    "start": 155.998097291812,
    "end": 157.80947548677617,
    "text": "而沃克案的无期刑，"
  },
  {
    "start": 157.80947548677617,
    "end": 158.9815437305765,
    "text": "他早已在服。"
  },
  {
    "start": 158.9815437305765,
    "end": 160.87816325236253,
    "text": "迟到三十年的正义，"
  },
  {
    "start": 160.87816325236253,
    "end": 162.81740343755945,
    "text": "靠的不是一句传闻，"
  },
  {
    "start": 162.81740343755945,
    "end": 165.75822921291305,
    "text": "而是法律给证据留下的窄门，"
  },
  {
    "start": 165.75822921291305,
    "end": 168.2302276907465,
    "text": "以及凶手亲口留下的回声。"
  },
  {
    "start": 168.2302276907465,
    "end": 169.23181328090314,
    "text": "你觉得，"
  },
  {
    "start": 169.23181328090314,
    "end": 171.12843280268916,
    "text": "「一罪不二审」的例外，"
  },
  {
    "start": 171.12843280268916,
    "end": 172.44967336842774,
    "text": "应该更严格，"
  },
  {
    "start": 172.44967336842774,
    "end": 174.0,
    "text": "还是更勇敢？"
  }
]