[
  {
    "start": 0.6,
    "end": 3.063343108504399,
    "text": "一九六八年十二月二十日，"
  },
  {
    "start": 3.063343108504399,
    "end": 4.730836905030453,
    "text": "加州贝尼西亚。"
  },
  {
    "start": 4.730836905030453,
    "end": 8.880622603203248,
    "text": "十七岁的少年和十六岁的女孩第一次约会，"
  },
  {
    "start": 8.880622603203248,
    "end": 12.348251748251748,
    "text": "把车停在湖赫尔曼路旁的碎石空地。"
  },
  {
    "start": 12.348251748251748,
    "end": 13.504128129934582,
    "text": "当晚，"
  },
  {
    "start": 13.504128129934582,
    "end": 14.641055718475073,
    "text": "两人遇害。"
  },
  {
    "start": 14.641055718475073,
    "end": 16.952808481840744,
    "text": "凶手没有留下名字，"
  },
  {
    "start": 16.952808481840744,
    "end": 18.847687796074897,
    "text": "警方也找不到线索。"
  },
  {
    "start": 18.847687796074897,
    "end": 21.576314008572076,
    "text": "八个月后，"
  },
  {
    "start": 21.576314008572076,
    "end": 24.949199187908867,
    "text": "同样的手法再次出现——这一次，"
  },
  {
    "start": 24.949199187908867,
    "end": 27.166207985562824,
    "text": "有人活了下来。"
  },
  {
    "start": 28.246207985562826,
    "end": 30.36847281750508,
    "text": "一九六九年七月四日深夜，"
  },
  {
    "start": 30.36847281750508,
    "end": 32.37704489059328,
    "text": "瓦列霍蓝岩泉公园，"
  },
  {
    "start": 32.37704489059328,
    "end": 34.87828558538236,
    "text": "一对年轻情侣在车里中枪。"
  },
  {
    "start": 34.87828558538236,
    "end": 36.261547484773295,
    "text": "女子遇难，"
  },
  {
    "start": 36.261547484773295,
    "end": 38.53540266185428,
    "text": "十九岁的男子身中数枪，"
  },
  {
    "start": 38.53540266185428,
    "end": 39.69127904353711,
    "text": "却活了下来，"
  },
  {
    "start": 39.69127904353711,
    "end": 42.15462215204151,
    "text": "他向警方描述了袭击者。"
  },
  {
    "start": 42.15462215204151,
    "end": 43.594730430859464,
    "text": "九月底，"
  },
  {
    "start": 43.594730430859464,
    "end": 45.58435371080533,
    "text": "湖边野餐的一对情侣，"
  },
  {
    "start": 45.58435371080533,
    "end": 46.60758854049177,
    "text": "女子遇害，"
  },
  {
    "start": 46.60758854049177,
    "end": 47.61187457703587,
    "text": "男友幸存。"
  },
  {
    "start": 47.61187457703587,
    "end": 49.03303406271149,
    "text": "十月初，"
  },
  {
    "start": 49.03303406271149,
    "end": 52.121687344913155,
    "text": "一名出租车司机在旧金山街头遇害。"
  },
  {
    "start": 52.121687344913155,
    "end": 54.262900969997744,
    "text": "五个人死了，"
  },
  {
    "start": 54.262900969997744,
    "end": 55.53247011053463,
    "text": "七个受害者，"
  },
  {
    "start": 55.53247011053463,
    "end": 57.578939769907514,
    "text": "只有两人幸存。"
  },
  {
    "start": 58.65893976990751,
    "end": 60.98016692984435,
    "text": "一九六九年八月一日，"
  },
  {
    "start": 61.52968193097225,
    "end": 63.5572027972028,
    "text": "三封几乎一模一样的信，"
  },
  {
    "start": 63.879332280622606,
    "end": 66.89219039025491,
    "text": "寄到了瓦列霍和旧金山的三家报社。"
  },
  {
    "start": 67.46065418452515,
    "end": 69.99979246559892,
    "text": "写信人承认了前两起命案，"
  },
  {
    "start": 70.2650755695917,
    "end": 72.93685540266185,
    "text": "还说出了只有警方才知道的细节。"
  },
  {
    "start": 73.54321678321679,
    "end": 76.61292127227611,
    "text": "信末画着一个圆圈加十字的符号，"
  },
  {
    "start": 76.84030678998421,
    "end": 78.4320054139409,
    "text": "媒体开始这样叫他："
  },
  {
    "start": 78.659390931649,
    "end": 80.40267990074442,
    "text": "十二宫杀手。"
  },
  {
    "start": 81.4448635235732,
    "end": 83.20710128581096,
    "text": "信里还附着一段密码，"
  },
  {
    "start": 83.41553801037672,
    "end": 84.68510715091361,
    "text": "拆成三份寄出。"
  },
  {
    "start": 85.06408301376044,
    "end": 85.95467629145048,
    "text": "他写道："
  },
  {
    "start": 86.25785698172795,
    "end": 87.64111888111889,
    "text": "在这段密码里，"
  },
  {
    "start": 87.69796526054591,
    "end": 89.25176629821792,
    "text": "藏着我的身份。"
  },
  {
    "start": 90.51177983307015,
    "end": 92.19822242273855,
    "text": "警方解不开的密码，"
  },
  {
    "start": 92.19822242273855,
    "end": 93.92256259869163,
    "text": "一个星期内就破了。"
  },
  {
    "start": 93.92256259869163,
    "end": 96.08272501691856,
    "text": "解开它的不是侦探，"
  },
  {
    "start": 96.08272501691856,
    "end": 100.78202571621927,
    "text": "而是加州萨拉伊纳斯的一对普通夫妇——唐纳德和"
  },
  {
    "start": 100.78202571621927,
    "end": 102.20318520189487,
    "text": "贝蒂·哈登。"
  },
  {
    "start": 102.20318520189487,
    "end": 103.45380554928941,
    "text": "他们靠词频分析，"
  },
  {
    "start": 103.45380554928941,
    "end": 105.93609745093616,
    "text": "一点点剥开四百零八个符号。"
  },
  {
    "start": 105.93609745093616,
    "end": 108.03941348973606,
    "text": "译文里没有地址，"
  },
  {
    "start": 108.03941348973606,
    "end": 108.9679043537108,
    "text": "没有身份，"
  },
  {
    "start": 108.9679043537108,
    "end": 111.56388901421158,
    "text": "只有一句让人脊背发凉的话："
  },
  {
    "start": 111.56388901421158,
    "end": 113.95143695014663,
    "text": "我期待自己的照片，"
  },
  {
    "start": 113.95143695014663,
    "end": 116.73690954207083,
    "text": "登上《旧金山纪事报》的头版。"
  },
  {
    "start": 117.81690954207082,
    "end": 119.61704489059326,
    "text": "他留下的另一段密码，"
  },
  {
    "start": 119.61704489059326,
    "end": 121.92879765395892,
    "text": "只有三百四十个符号，"
  },
  {
    "start": 121.92879765395892,
    "end": 125.18799007444167,
    "text": "却成了最著名的未解密码之一。"
  },
  {
    "start": 125.18799007444167,
    "end": 126.2491224904128,
    "text": "一九七一年，"
  },
  {
    "start": 126.2491224904128,
    "end": 128.99669749605232,
    "text": "他在信里自称杀了十七人。"
  },
  {
    "start": 128.99669749605232,
    "end": 130.19047146401982,
    "text": "一九七四年，"
  },
  {
    "start": 130.19047146401982,
    "end": 132.02850439882695,
    "text": "最后一封信写下："
  },
  {
    "start": 132.02850439882695,
    "end": 133.56335664335663,
    "text": "我等于三十七，"
  },
  {
    "start": 133.56335664335663,
    "end": 135.136106474171,
    "text": "旧金山警局等于零。"
  },
  {
    "start": 135.136106474171,
    "end": 137.0120369952628,
    "text": "二〇二〇年十二月，"
  },
  {
    "start": 137.0120369952628,
    "end": 140.72600045116172,
    "text": "三名来自三个国家的业余密码迷解开了它。"
  },
  {
    "start": 140.72600045116172,
    "end": 143.1324971802391,
    "text": "五十一年的沉默之后，"
  },
  {
    "start": 143.1324971802391,
    "end": 145.52004511617412,
    "text": "译文里依然没有名字。"
  },
  {
    "start": 146.60004511617413,
    "end": 148.1348973607038,
    "text": "五十年里，"
  },
  {
    "start": 148.1348973607038,
    "end": 149.4613128806677,
    "text": "案件被归档，"
  },
  {
    "start": 149.4613128806677,
    "end": 151.45093616061357,
    "text": "又被人重新打开。"
  },
  {
    "start": 151.45093616061357,
    "end": 152.64471012858107,
    "text": "电影上映之后，"
  },
  {
    "start": 152.64471012858107,
    "end": 154.31220392510713,
    "text": "线索像潮水一样涌来，"
  },
  {
    "start": 154.31220392510713,
    "end": 156.3397247913377,
    "text": "嫌疑人被一个个排除，"
  },
  {
    "start": 156.3397247913377,
    "end": 158.36724565756822,
    "text": "新的说法又轮番登场。"
  },
  {
    "start": 158.36724565756822,
    "end": 159.5989172118204,
    "text": "今天，"
  },
  {
    "start": 159.5989172118204,
    "end": 161.74013083690502,
    "text": "警方确认的死亡是五起，"
  },
  {
    "start": 161.74013083690502,
    "end": 164.27926911797877,
    "text": "他声称的数字是三十七。"
  },
  {
    "start": 164.27926911797877,
    "end": 167.6142567110309,
    "text": "那个圆圈加十字的符号背后，"
  },
  {
    "start": 167.6142567110309,
    "end": 168.8080306789984,
    "text": "站着的是谁？"
  },
  {
    "start": 168.8080306789984,
    "end": 170.8166027520866,
    "text": "五十年过去了，"
  },
  {
    "start": 170.8166027520866,
    "end": 171.87773516805774,
    "text": "这个名字，"
  },
  {
    "start": 171.87773516805774,
    "end": 173.99999999999997,
    "text": "仍然没有被说出。"
  }
]