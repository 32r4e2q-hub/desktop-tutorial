[
  {
    "start": 0.7672402183967005,
    "end": 2.7964215349433337,
    "text": "一九六八年十二月二十日，"
  },
  {
    "start": 2.930213709660695,
    "end": 4.268135456834298,
    "text": "加州贝尼西亚。"
  },
  {
    "start": 4.268135456834298,
    "end": 8.192705915210205,
    "text": "十七岁的少年和十六岁的女孩第一次约会，"
  },
  {
    "start": 8.415692873072471,
    "end": 11.649003762075349,
    "text": "把车停在湖赫尔曼路旁的碎石空地。"
  },
  {
    "start": 11.805094632578937,
    "end": 12.563250289310647,
    "text": "当晚，"
  },
  {
    "start": 12.563250289310647,
    "end": 13.477496816545942,
    "text": "两人遇害。"
  },
  {
    "start": 13.767379861766889,
    "end": 15.083002913154267,
    "text": "凶手没有留下名字，"
  },
  {
    "start": 15.1944963920854,
    "end": 17.089885533914675,
    "text": "警方也找不到线索。"
  },
  {
    "start": 17.156781621273357,
    "end": 18.316313802157147,
    "text": "八个月后，"
  },
  {
    "start": 18.583898151591864,
    "end": 22.151689477388143,
    "text": "同样的手法再次出现——这一次，"
  },
  {
    "start": 22.39697513103664,
    "end": 23.690299486637787,
    "text": "有人活了下来。"
  },
  {
    "start": 24.889272319780552,
    "end": 27.375576899944832,
    "text": "一九六九年七月四日深夜，"
  },
  {
    "start": 27.5985638578071,
    "end": 29.895329523788455,
    "text": "瓦列霍蓝岩泉公园，"
  },
  {
    "start": 30.162913873223175,
    "end": 33.03944562964642,
    "text": "一对年轻情侣在车里中枪。"
  },
  {
    "start": 33.128640412791334,
    "end": 34.39966607260626,
    "text": "女子遇难，"
  },
  {
    "start": 34.64495172625475,
    "end": 37.008613479594786,
    "text": "十九岁的男子身中数枪，"
  },
  {
    "start": 37.008613479594786,
    "end": 38.16814566047857,
    "text": "却活了下来，"
  },
  {
    "start": 38.301937835195936,
    "end": 40.55410610960484,
    "text": "他向警方描述了袭击者。"
  },
  {
    "start": 40.66559958853597,
    "end": 41.6913395947024,
    "text": "九月底，"
  },
  {
    "start": 41.958923944137126,
    "end": 43.96580656489753,
    "text": "湖边野餐的一对情侣，"
  },
  {
    "start": 44.21109221854603,
    "end": 45.370624399429815,
    "text": "女子遇害，"
  },
  {
    "start": 45.549013965719624,
    "end": 46.68624745081719,
    "text": "男友幸存。"
  },
  {
    "start": 46.75314353817587,
    "end": 47.77888354434229,
    "text": "十月初，"
  },
  {
    "start": 47.77888354434229,
    "end": 51.212882695421214,
    "text": "一名出租车司机在旧金山街头遇害。"
  },
  {
    "start": 51.32437617435235,
    "end": 52.21632400580142,
    "text": "五个人死了，"
  },
  {
    "start": 52.97447966253313,
    "end": 54.17860923498937,
    "text": "七个受害者，"
  },
  {
    "start": 54.42389488863787,
    "end": 55.5388296779492,
    "text": "只有两人幸存。"
  },
  {
    "start": 56.72509690005544,
    "end": 59.49013517754756,
    "text": "一九六九年八月一日，"
  },
  {
    "start": 59.49013517754756,
    "end": 61.92069301824627,
    "text": "三封几乎一模一样的信，"
  },
  {
    "start": 61.92069301824627,
    "end": 65.93445825976708,
    "text": "寄到了瓦列霍和旧金山的三家报社。"
  },
  {
    "start": 65.93445825976708,
    "end": 68.32041870889334,
    "text": "写信人承认了前两起命案，"
  },
  {
    "start": 68.32041870889334,
    "end": 71.82131394733095,
    "text": "还说出了只有警方才知道的细节。"
  },
  {
    "start": 71.82131394733095,
    "end": 75.4560013604859,
    "text": "信末画着一个圆圈加十字的符号，"
  },
  {
    "start": 75.4560013604859,
    "end": 77.68587093910858,
    "text": "媒体开始这样叫他："
  },
  {
    "start": 77.68587093910858,
    "end": 78.86770181577859,
    "text": "十二宫杀手。"
  },
  {
    "start": 78.86770181577859,
    "end": 81.32055835226353,
    "text": "信里还附着一段密码，"
  },
  {
    "start": 81.32055835226353,
    "end": 83.01525923201677,
    "text": "拆成三份寄出。"
  },
  {
    "start": 83.01525923201677,
    "end": 84.17479141290056,
    "text": "他写道："
  },
  {
    "start": 84.17479141290056,
    "end": 85.51271316007416,
    "text": "在这段密码里，"
  },
  {
    "start": 85.51271316007416,
    "end": 87.06669997829306,
    "text": "藏着我的身份。"
  },
  {
    "start": 88.14669997829306,
    "end": 89.93059564119119,
    "text": "警方解不开的密码，"
  },
  {
    "start": 89.93059564119119,
    "end": 91.95977695773783,
    "text": "一个星期内就破了。"
  },
  {
    "start": 91.95977695773783,
    "end": 93.81056870799465,
    "text": "解开它的不是侦探，"
  },
  {
    "start": 93.81056870799465,
    "end": 98.98386613039925,
    "text": "而是加州萨拉伊纳斯的一对普通夫妇——唐纳德和"
  },
  {
    "start": 98.98386613039925,
    "end": 100.25489179021417,
    "text": "贝蒂·哈登。"
  },
  {
    "start": 100.25489179021417,
    "end": 102.08338484468477,
    "text": "他们靠词频分析，"
  },
  {
    "start": 102.08338484468477,
    "end": 105.04911138425292,
    "text": "一点点剥开四百零八个符号。"
  },
  {
    "start": 105.04911138425292,
    "end": 106.67691617664748,
    "text": "译文里没有地址，"
  },
  {
    "start": 106.67691617664748,
    "end": 107.83644835753127,
    "text": "没有身份，"
  },
  {
    "start": 107.83644835753127,
    "end": 110.71298011395452,
    "text": "只有一句让人脊背发凉的话："
  },
  {
    "start": 110.71298011395452,
    "end": 112.51917447263888,
    "text": "我期待自己的照片，"
  },
  {
    "start": 112.51917447263888,
    "end": 115.23926694143688,
    "text": "登上《旧金山纪事报》的头版。"
  },
  {
    "start": 116.3192669414369,
    "end": 118.19235738747994,
    "text": "他留下的另一段密码，"
  },
  {
    "start": 118.19235738747994,
    "end": 120.31073348717148,
    "text": "只有三百四十个符号，"
  },
  {
    "start": 120.31073348717148,
    "end": 123.43255089724322,
    "text": "却成了最著名的未解密码之一。"
  },
  {
    "start": 123.43255089724322,
    "end": 124.56978438234079,
    "text": "一九七一年，"
  },
  {
    "start": 124.56978438234079,
    "end": 126.95574483146704,
    "text": "他在信里自称杀了十七人。"
  },
  {
    "start": 126.95574483146704,
    "end": 128.22677049128197,
    "text": "一九七四年，"
  },
  {
    "start": 128.22677049128197,
    "end": 129.67618571738672,
    "text": "最后一封信写下："
  },
  {
    "start": 129.67618571738672,
    "end": 131.43778268449861,
    "text": "我等于三十七，"
  },
  {
    "start": 131.43778268449861,
    "end": 133.37776921790035,
    "text": "旧金山警局等于零。"
  },
  {
    "start": 133.37776921790035,
    "end": 134.78258705243263,
    "text": "二〇二〇年十二月，"
  },
  {
    "start": 134.78258705243263,
    "end": 138.90784577288457,
    "text": "三名来自三个国家的业余密码迷解开了它。"
  },
  {
    "start": 138.90784577288457,
    "end": 140.8255336105001,
    "text": "五十一年的沉默之后，"
  },
  {
    "start": 140.8255336105001,
    "end": 142.8034511545465,
    "text": "译文里依然没有名字。"
  },
  {
    "start": 143.8834511545465,
    "end": 144.93148985649916,
    "text": "五十年里，"
  },
  {
    "start": 144.93148985649916,
    "end": 146.67078812782484,
    "text": "案件被归档，"
  },
  {
    "start": 146.67078812782484,
    "end": 148.78916422751638,
    "text": "又被人重新打开。"
  },
  {
    "start": 148.78916422751638,
    "end": 150.66225467355943,
    "text": "电影上映之后，"
  },
  {
    "start": 150.66225467355943,
    "end": 152.6468385985336,
    "text": "线索像潮水一样涌来，"
  },
  {
    "start": 152.6468385985336,
    "end": 155.65716252967422,
    "text": "嫌疑人被一个个排除，"
  },
  {
    "start": 155.65716252967422,
    "end": 158.3999021113801,
    "text": "新的说法又轮番登场。"
  },
  {
    "start": 158.3999021113801,
    "end": 158.8235773313184,
    "text": "今天，"
  },
  {
    "start": 158.8235773313184,
    "end": 161.85619995824524,
    "text": "警方确认的死亡是五起，"
  },
  {
    "start": 161.85619995824524,
    "end": 164.53204345259246,
    "text": "他声称的数字是三十七。"
  },
  {
    "start": 164.53204345259246,
    "end": 167.832250428954,
    "text": "那个圆圈加十字的符号背后，"
  },
  {
    "start": 167.832250428954,
    "end": 168.9917826098378,
    "text": "站着的是谁？"
  },
  {
    "start": 168.9917826098378,
    "end": 170.86487305588085,
    "text": "五十年过去了，"
  },
  {
    "start": 170.86487305588085,
    "end": 171.9129117578335,
    "text": "这个名字，"
  },
  {
    "start": 171.9129117578335,
    "end": 174.0,
    "text": "仍然没有被说出。"
  }
]