[
  {
    "start": 0.6,
    "end": 2.055087759550304,
    "text": "一九八二年二月，"
  },
  {
    "start": 2.401996099575542,
    "end": 3.5198118618790866,
    "text": "香港的雨夜。"
  },
  {
    "start": 3.751084088562579,
    "end": 5.639807273144431,
    "text": "有人从沙田城门河里，"
  },
  {
    "start": 5.774716072043134,
    "end": 9.764161982333372,
    "text": "捞起一颗人头和一双女人的手臂——这起案子，"
  },
  {
    "start": 9.879798095675119,
    "end": 11.633612481358266,
    "text": "让整个香港慌了。"
  },
  {
    "start": 11.633612481358266,
    "end": 13.406699552598372,
    "text": "但真正钉死凶手的，"
  },
  {
    "start": 13.58015372261099,
    "end": 14.640151428243662,
    "text": "不是目击者，"
  },
  {
    "start": 14.948514397154984,
    "end": 15.700149133876334,
    "text": "不是指纹，"
  },
  {
    "start": 16.027784788344615,
    "end": 19.015051049673055,
    "text": "而是一卷送去冲印店的菲林。"
  },
  {
    "start": 19.30414133302742,
    "end": 22.792497418836756,
    "text": "今天讲雨夜屠夫林过云："
  },
  {
    "start": 22.908133532178503,
    "end": 24.816129402317312,
    "text": "一个夜班出租车司机，"
  },
  {
    "start": 24.873947458988187,
    "end": 26.107399334633474,
    "text": "和四条人命。"
  },
  {
    "start": 27.32712630492142,
    "end": 28.030579327750377,
    "text": "林过云，"
  },
  {
    "start": 28.261851554433868,
    "end": 29.032758976712174,
    "text": "二十七岁，"
  },
  {
    "start": 29.302576574509583,
    "end": 30.767300676838364,
    "text": "夜班的士司机，"
  },
  {
    "start": 30.921482161294026,
    "end": 33.002932201445454,
    "text": "住在土瓜湾一栋旧唐楼里。"
  },
  {
    "start": 33.002932201445454,
    "end": 34.71820121601469,
    "text": "白天他几乎不出现，"
  },
  {
    "start": 34.94947344269818,
    "end": 36.414197545026965,
    "text": "入夜才开车上街。"
  },
  {
    "start": 36.66474245726741,
    "end": 37.74401284845704,
    "text": "凌晨的尖沙咀，"
  },
  {
    "start": 37.95601238958358,
    "end": 40.21091659974762,
    "text": "搭车的大多是下班回家的女人。"
  },
  {
    "start": 40.268734656418495,
    "end": 41.810549500975114,
    "text": "从二月到七月，"
  },
  {
    "start": 42.15745784100035,
    "end": 43.83418148445566,
    "text": "四名女子坐上他的车，"
  },
  {
    "start": 44.10399908225307,
    "end": 45.067633360100956,
    "text": "再没有下车："
  },
  {
    "start": 45.29890558678444,
    "end": 46.87926580245498,
    "text": "二十二岁的陈凤兰，"
  },
  {
    "start": 47.16835608580934,
    "end": 48.671625559252035,
    "text": "三十一岁的陈云洁，"
  },
  {
    "start": 48.94144315704945,
    "end": 50.56034874383389,
    "text": "二十九岁的梁秀云，"
  },
  {
    "start": 50.8301663416313,
    "end": 52.468344613972704,
    "text": "还有十七岁的梁惠心。"
  },
  {
    "start": 53.72661695537456,
    "end": 55.94297579442469,
    "text": "作案几乎都挑在雨夜。"
  },
  {
    "start": 55.94297579442469,
    "end": 57.966607777905246,
    "text": "他把车开到僻静处，"
  },
  {
    "start": 57.966607777905246,
    "end": 60.08660318917059,
    "text": "然后在车里勒死对方。"
  },
  {
    "start": 60.08660318917059,
    "end": 60.87678329700586,
    "text": "四个月里，"
  },
  {
    "start": 60.87678329700586,
    "end": 63.1316875071699,
    "text": "香港连着发生四起命案，"
  },
  {
    "start": 63.1316875071699,
    "end": 67.91131352529541,
    "text": "警方一开始并不确定它们出自同一双手——因为现"
  },
  {
    "start": 67.91131352529541,
    "end": 69.97349087988988,
    "text": "场几乎没有留下什么。"
  },
  {
    "start": 69.97349087988988,
    "end": 73.94366410462315,
    "text": "而林过云做了一件他自以为很聪明的事："
  },
  {
    "start": 73.94366410462315,
    "end": 76.23711368590112,
    "text": "他把整个过程拍了下来，"
  },
  {
    "start": 76.23711368590112,
    "end": 77.7018377882299,
    "text": "照片和录像带，"
  },
  {
    "start": 77.7018377882299,
    "end": 79.48937937363772,
    "text": "整整齐齐收在家里。"
  },
  {
    "start": 80.61756108753012,
    "end": 82.64119307101068,
    "text": "转折点是一间冲印店。"
  },
  {
    "start": 82.74719284157395,
    "end": 84.55882528392797,
    "text": "林过云家里没有暗房，"
  },
  {
    "start": 84.65518871171275,
    "end": 88.31699896753472,
    "text": "习惯把菲林拿到尖沙咀一间相铺冲洗。"
  },
  {
    "start": 88.43263508087647,
    "end": 89.88772284042676,
    "text": "一九八二年八月，"
  },
  {
    "start": 89.98408626821156,
    "end": 91.61262819777447,
    "text": "他想放大一批相片，"
  },
  {
    "start": 91.71862796833774,
    "end": 93.85789606516005,
    "text": "偏巧放大机坏了，"
  },
  {
    "start": 93.9638958357233,
    "end": 95.65989216473558,
    "text": "底片被转到分店，"
  },
  {
    "start": 95.75625559252038,
    "end": 96.83552598371,
    "text": "由人手冲晒。"
  },
  {
    "start": 96.95116209705175,
    "end": 99.62042904669039,
    "text": "店员把照片看清楚的那一刻，"
  },
  {
    "start": 99.72642881725365,
    "end": 103.36896638751865,
    "text": "就知道这不是普通摄影——画面里的东西，"
  },
  {
    "start": 103.47496615808191,
    "end": 106.0767787082712,
    "text": "和报纸上正在报道的那宗案子，"
  },
  {
    "start": 106.18277847883448,
    "end": 107.1271400711254,
    "text": "太像了。"
  },
  {
    "start": 107.23313984168867,
    "end": 108.93395434209017,
    "text": "负责人报了警。"
  },
  {
    "start": 110.06213605598258,
    "end": 111.94122289778595,
    "text": "警方没有立刻上门。"
  },
  {
    "start": 112.04722266834922,
    "end": 114.18649076517153,
    "text": "他们让店员照常打电话，"
  },
  {
    "start": 114.29249053573479,
    "end": 117.64593782264542,
    "text": "通知客人来取相——因为底片还在店里，"
  },
  {
    "start": 117.76157393598717,
    "end": 119.59247906389815,
    "text": "来取的人只能是他。"
  },
  {
    "start": 119.68884249168293,
    "end": 120.53684065618907,
    "text": "八月十八日，"
  },
  {
    "start": 120.63320408397387,
    "end": 122.04974647241025,
    "text": "林过云走进冲印店，"
  },
  {
    "start": 122.13647355741656,
    "end": 123.59156131696686,
    "text": "埋伏的探员一拥而上。"
  },
  {
    "start": 123.69756108753013,
    "end": 124.42992313869452,
    "text": "同一天，"
  },
  {
    "start": 124.53592290925779,
    "end": 127.91827922450386,
    "text": "警方搜查他在土瓜湾贵州街的住所："
  },
  {
    "start": 128.01464265228864,
    "end": 128.69882298956065,
    "text": "照片、"
  },
  {
    "start": 128.73736836067457,
    "end": 129.50827578295286,
    "text": "录像带、"
  },
  {
    "start": 129.61427555351614,
    "end": 130.56827348858553,
    "text": "手术器材，"
  },
  {
    "start": 130.66463691637034,
    "end": 132.24499713204085,
    "text": "一件一件被翻出来。"
  },
  {
    "start": 132.34136055982566,
    "end": 134.20117471607205,
    "text": "四起互不相干的命案，"
  },
  {
    "start": 134.30717448663532,
    "end": 136.29226109900196,
    "text": "从此串成一条线。"
  },
  {
    "start": 137.43007915567284,
    "end": 139.06825742801425,
    "text": "一九八三年三月，"
  },
  {
    "start": 139.16462085579903,
    "end": 141.4195250659631,
    "text": "案件在高等法院开审。"
  },
  {
    "start": 141.52552483652636,
    "end": 142.33497762991857,
    "text": "争的是："
  },
  {
    "start": 142.37352300103248,
    "end": 144.17551910060803,
    "text": "他到底有没有精神病。"
  },
  {
    "start": 144.29115521394976,
    "end": 146.72914993690492,
    "text": "五名精神科医生评估过他，"
  },
  {
    "start": 146.8255133646897,
    "end": 149.1960536881955,
    "text": "陪审团最终不接受这个说法。"
  },
  {
    "start": 149.2924171159803,
    "end": 150.37168750716992,
    "text": "四月八日，"
  },
  {
    "start": 150.45841459217624,
    "end": 152.27004703453025,
    "text": "四项谋杀罪名成立，"
  },
  {
    "start": 152.37604680509352,
    "end": 153.78295285075143,
    "text": "判处死刑。"
  },
  {
    "start": 153.8889526213147,
    "end": 157.95548927383277,
    "text": "但香港多年没有执行死刑——一九八四年八月，"
  },
  {
    "start": 158.06148904439604,
    "end": 160.82711942181945,
    "text": "港督会同行政局赦免死刑，"
  },
  {
    "start": 160.82711942181945,
    "end": 162.25329815303434,
    "text": "改判终身监禁。"
  },
  {
    "start": 162.35929792359758,
    "end": 165.25020075714124,
    "text": "他想让全世界看见自己的作品，"
  },
  {
    "start": 165.34656418492602,
    "end": 166.78237925891938,
    "text": "把他送上法庭的，"
  },
  {
    "start": 166.84983365836874,
    "end": 168.32419410347597,
    "text": "正是那卷菲林。"
  },
  {
    "start": 168.42055753126078,
    "end": 169.34564643799476,
    "text": "你觉得，"
  },
  {
    "start": 169.43237352300105,
    "end": 171.57164161982337,
    "text": "如果那台放大机没有坏，"
  },
  {
    "start": 171.6776413903866,
    "end": 174.00000000000003,
    "text": "这个案子还会被揭开吗？"
  }
]