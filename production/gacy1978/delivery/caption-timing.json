[
  {
    "start": 0.732452941756184,
    "end": 3.8782103084655564,
    "text": "一个能在聚会上逗人发笑的小丑，"
  },
  {
    "start": 4.198304917709667,
    "end": 7.4765152261752235,
    "text": "为什么会和三十三条生命联系在一起？"
  },
  {
    "start": 7.796609835419335,
    "end": 8.74585591800532,
    "text": "一九七八年，"
  },
  {
    "start": 8.823120134029761,
    "end": 9.960007884103673,
    "text": "芝加哥郊外，"
  },
  {
    "start": 10.180762787030648,
    "end": 12.763595151276236,
    "text": "一栋普通住宅被警方封锁。"
  },
  {
    "start": 13.08368976052035,
    "end": 14.584823100423769,
    "text": "令人不安的秘密，"
  },
  {
    "start": 14.904917709667881,
    "end": 15.953503498571003,
    "text": "就在地板下。"
  },
  {
    "start": 16.383975559278603,
    "end": 17.33322164186459,
    "text": "房主盖西，"
  },
  {
    "start": 17.653316251108702,
    "end": 18.436996156499458,
    "text": "是承包商，"
  },
  {
    "start": 18.536335862816596,
    "end": 20.23614861535429,
    "text": "也是邻里熟悉的面孔。"
  },
  {
    "start": 20.545205479452054,
    "end": 22.13464078052626,
    "text": "他的舞台名字叫波戈。"
  },
  {
    "start": 22.443697644624024,
    "end": 23.80134029762491,
    "text": "但揭开妆容的，"
  },
  {
    "start": 24.121434906869023,
    "end": 25.368700108406422,
    "text": "不是一场表演，"
  },
  {
    "start": 25.688794717650538,
    "end": 28.332334680201043,
    "text": "而是一名少年没有回家。"
  },
  {
    "start": 29.544787621957227,
    "end": 30.052523898689266,
    "text": "白天，"
  },
  {
    "start": 30.361580762787028,
    "end": 32.16073322164186,
    "text": "盖西经营建筑生意，"
  },
  {
    "start": 32.469790085739625,
    "end": 34.20271607371637,
    "text": "参加社区活动；"
  },
  {
    "start": 34.25790479944811,
    "end": 35.1850753917414,
    "text": "换上戏服，"
  },
  {
    "start": 35.48309451069281,
    "end": 37.834134226865075,
    "text": "他又成了派对上的小丑。"
  },
  {
    "start": 37.93347393318222,
    "end": 40.626683748891296,
    "text": "人们容易把熟悉误认为可靠。"
  },
  {
    "start": 40.946778358135404,
    "end": 41.8297979698433,
    "text": "可他的过去，"
  },
  {
    "start": 42.149892579087414,
    "end": 43.37508229033211,
    "text": "并非没有警报。"
  },
  {
    "start": 43.68413915442987,
    "end": 44.88725337538188,
    "text": "一九六八年，"
  },
  {
    "start": 45.196310239479644,
    "end": 46.95131171774908,
    "text": "他曾因性侵被判刑，"
  },
  {
    "start": 47.271406326993194,
    "end": 48.308954370749966,
    "text": "后来获假释，"
  },
  {
    "start": 48.4965960382379,
    "end": 49.3133891790677,
    "text": "回到社区。"
  },
  {
    "start": 49.62244604316546,
    "end": 52.10593870109391,
    "text": "旧案没让危险永远消失。"
  },
  {
    "start": 52.42603331033803,
    "end": 54.50112939785158,
    "text": "当一个人看起来正常，"
  },
  {
    "start": 54.82122400709569,
    "end": 57.817971814329354,
    "text": "谁会留意那些已经出现的异常？"
  },
  {
    "start": 59.041462501231884,
    "end": 61.22693604020892,
    "text": "一九七八年十二月十一日，"
  },
  {
    "start": 61.53599290430669,
    "end": 63.379296343746915,
    "text": "十五岁的罗伯特·皮斯特，"
  },
  {
    "start": 63.63316448211293,
    "end": 65.52061890213855,
    "text": "在一家药店工作后失踪。"
  },
  {
    "start": 65.84071351138267,
    "end": 66.97760126145658,
    "text": "他曾告诉母亲，"
  },
  {
    "start": 67.04382773233468,
    "end": 69.11892381984822,
    "text": "要去和一位承包商谈工作。"
  },
  {
    "start": 69.43901842909233,
    "end": 69.86949048979993,
    "text": "那个人，"
  },
  {
    "start": 70.18958509904405,
    "end": 70.96222725928845,
    "text": "就是盖西。"
  },
  {
    "start": 71.27128412338621,
    "end": 71.97769981275253,
    "text": "工作机会，"
  },
  {
    "start": 72.18741697053315,
    "end": 73.67751256529023,
    "text": "本该通向新的生活；"
  },
  {
    "start": 73.98656942938798,
    "end": 74.46119247068098,
    "text": "这一次，"
  },
  {
    "start": 74.715060609047,
    "end": 76.03959002660883,
    "text": "却成为调查线索。"
  },
  {
    "start": 76.3486468907066,
    "end": 77.49657238592687,
    "text": "母亲等不到儿子，"
  },
  {
    "start": 77.80562925002462,
    "end": 79.14119641273282,
    "text": "警方开始寻找他。"
  },
  {
    "start": 79.46129102197693,
    "end": 81.28251897112446,
    "text": "一个家庭的报案，"
  },
  {
    "start": 81.3377076968562,
    "end": 83.50110574554054,
    "text": "留下了必须回答的问题："
  },
  {
    "start": 83.62252094215039,
    "end": 84.94705035971222,
    "text": "少年最后见了谁？"
  },
  {
    "start": 86.17054104661476,
    "end": 88.54365625307972,
    "text": "警探循着线索找到盖西，"
  },
  {
    "start": 88.86375086232383,
    "end": 89.76884596432443,
    "text": "核对说法，"
  },
  {
    "start": 90.06686508327583,
    "end": 91.24790381393514,
    "text": "也查到了前科。"
  },
  {
    "start": 91.56799842317926,
    "end": 92.88149009559474,
    "text": "十二月十三日，"
  },
  {
    "start": 93.20158470483887,
    "end": 95.30979402779145,
    "text": "警方第一次搜查他的住宅，"
  },
  {
    "start": 95.61885089188922,
    "end": 96.74470089681678,
    "text": "带走多件物品；"
  },
  {
    "start": 97.05375776091455,
    "end": 99.11781610328174,
    "text": "监视和调查继续推进。"
  },
  {
    "start": 99.42687296737951,
    "end": 101.59027101606385,
    "text": "盖西的日常还在上演，"
  },
  {
    "start": 101.89932788016161,
    "end": 104.23932985118753,
    "text": "证据却正一点点靠近。"
  },
  {
    "start": 104.54838671528529,
    "end": 105.92810485857888,
    "text": "十二月二十一日，"
  },
  {
    "start": 106.23716172267663,
    "end": 107.56169114023848,
    "text": "警方再次搜查。"
  },
  {
    "start": 107.87074800433624,
    "end": 110.90612791958213,
    "text": "镜头停在关闭的地板入口。"
  },
  {
    "start": 111.11584507736276,
    "end": 111.9657514536316,
    "text": "有些事实，"
  },
  {
    "start": 112.27480831772937,
    "end": 113.72075293190105,
    "text": "不需要猎奇的画面，"
  },
  {
    "start": 114.0298097959988,
    "end": 116.34221740415884,
    "text": "也足以说明事情的重量。"
  },
  {
    "start": 117.5657080910614,
    "end": 120.39137084852665,
    "text": "调查最终指向三十三名遇害者。"
  },
  {
    "start": 120.71146545777076,
    "end": 124.32080812062678,
    "text": "警方在盖西住宅内外发现二十九人的遗骸，"
  },
  {
    "start": 124.69609145560264,
    "end": 126.51731940475017,
    "text": "另有四人在河中找到。"
  },
  {
    "start": 126.82637626884792,
    "end": 129.2877934364837,
    "text": "不是三十三人都埋在地板下面，"
  },
  {
    "start": 129.61892579087413,
    "end": 132.17968266482703,
    "text": "也不能把他们缩成一个数字。"
  },
  {
    "start": 132.26798462599783,
    "end": 134.34308071351137,
    "text": "他们是少年和年轻男子，"
  },
  {
    "start": 134.66317532275548,
    "end": 135.3916665024145,
    "text": "有名字、"
  },
  {
    "start": 135.66761013107322,
    "end": 137.0252527840741,
    "text": "家人与未来。"
  },
  {
    "start": 137.33430964817185,
    "end": 138.23940475017247,
    "text": "有的身份，"
  },
  {
    "start": 138.39393318222133,
    "end": 140.43591603429584,
    "text": "直到多年后才逐步确认。"
  },
  {
    "start": 140.87742584014978,
    "end": 142.64346506356557,
    "text": "我们不再看小丑的笑脸。"
  },
  {
    "start": 142.96355967280968,
    "end": 144.4205420321277,
    "text": "镜头留给空椅子，"
  },
  {
    "start": 144.71856115107911,
    "end": 146.13691140238492,
    "text": "和等待答案的人。"
  },
  {
    "start": 147.34936434414112,
    "end": 148.27653493643442,
    "text": "一九八零年，"
  },
  {
    "start": 148.58559180053217,
    "end": 151.36710357741202,
    "text": "盖西被裁定三十三项谋杀罪成立，"
  },
  {
    "start": 151.6540849512171,
    "end": 152.79097270129103,
    "text": "并被判处死刑。"
  },
  {
    "start": 153.11106731053513,
    "end": 154.87710653395092,
    "text": "一九九四年五月十日，"
  },
  {
    "start": 155.18616339804868,
    "end": 156.13540948063468,
    "text": "死刑执行。"
  },
  {
    "start": 156.44446634473243,
    "end": 159.6343746920272,
    "text": "但判决不能替家人补回失去的岁月。"
  },
  {
    "start": 159.9544693012713,
    "end": 161.08031930619887,
    "text": "妆容和真相，"
  },
  {
    "start": 161.32314969941854,
    "end": 162.91258500049275,
    "text": "形成了刺眼的反差；"
  },
  {
    "start": 163.2216418645905,
    "end": 165.13117177490884,
    "text": "可妆容不是罪恶的原因，"
  },
  {
    "start": 165.4402286390066,
    "end": 167.7140041391544,
    "text": "证据和行为才是判断依据。"
  },
  {
    "start": 168.0230610032522,
    "end": 169.06060904700897,
    "text": "我们需要记住的，"
  },
  {
    "start": 169.34759042081402,
    "end": 171.02532768305903,
    "text": "不是一个怪物有多出名，"
  },
  {
    "start": 171.34542229230314,
    "end": 174.0,
    "text": "而是每条生命都不该被遗忘。"
  }
]