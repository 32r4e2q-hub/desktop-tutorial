{
 "N01": {
  "duration": 25.125,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.93,
    "text": "一个能在聚会上逗人发笑的小丑",
    "chars_per_second": 5.02
   },
   {
    "i": 1,
    "start": 3.28,
    "end": 6.19,
    "text": "为什么会和三十三条生命联系在一起",
    "chars_per_second": 5.5
   },
   {
    "i": 2,
    "start": 6.54,
    "end": 7.34,
    "text": "一九七八年",
    "chars_per_second": 6.25
   },
   {
    "i": 3,
    "start": 7.47,
    "end": 8.44,
    "text": "芝加哥郊外",
    "chars_per_second": 5.15
   },
   {
    "i": 4,
    "start": 8.7,
    "end": 10.98,
    "text": "一栋普通住宅被警方封锁",
    "chars_per_second": 4.82
   },
   {
    "i": 5,
    "start": 11.33,
    "end": 12.63,
    "text": "令人不安的秘密",
    "chars_per_second": 5.38
   },
   {
    "i": 6,
    "start": 12.98,
    "end": 13.87,
    "text": "就在地板下",
    "chars_per_second": 5.62
   },
   {
    "i": 7,
    "start": 14.32,
    "end": 15.12,
    "text": "房主盖西",
    "chars_per_second": 5.0
   },
   {
    "i": 8,
    "start": 15.47,
    "end": 16.12,
    "text": "是承包商",
    "chars_per_second": 6.15
   },
   {
    "i": 9,
    "start": 16.27,
    "end": 17.75,
    "text": "也是邻里熟悉的面孔",
    "chars_per_second": 6.08
   },
   {
    "i": 10,
    "start": 18.09,
    "end": 19.47,
    "text": "他的舞台名字叫波戈",
    "chars_per_second": 6.52
   },
   {
    "i": 11,
    "start": 19.81,
    "end": 20.98,
    "text": "但揭开妆容的",
    "chars_per_second": 5.13
   },
   {
    "i": 12,
    "start": 21.33,
    "end": 22.4,
    "text": "不是一场表演",
    "chars_per_second": 5.61
   },
   {
    "i": 13,
    "start": 22.75,
    "end": 25.12,
    "text": "而是一名少年没有回家",
    "chars_per_second": 4.21
   }
  ]
 },
 "N02": {
  "duration": 25.735,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.54,
    "text": "白天",
    "chars_per_second": 5.0
   },
   {
    "i": 1,
    "start": 0.88,
    "end": 2.45,
    "text": "盖西经营建筑生意",
    "chars_per_second": 5.1
   },
   {
    "i": 2,
    "start": 2.79,
    "end": 4.3,
    "text": "参加社区活动",
    "chars_per_second": 3.97
   },
   {
    "i": 3,
    "start": 4.41,
    "end": 5.19,
    "text": "换上戏服",
    "chars_per_second": 5.13
   },
   {
    "i": 4,
    "start": 5.52,
    "end": 7.59,
    "text": "他又成了派对上的小丑",
    "chars_per_second": 4.83
   },
   {
    "i": 5,
    "start": 7.74,
    "end": 10.12,
    "text": "人们容易把熟悉误认为可靠",
    "chars_per_second": 5.04
   },
   {
    "i": 6,
    "start": 10.47,
    "end": 11.21,
    "text": "可他的过去",
    "chars_per_second": 6.76
   },
   {
    "i": 7,
    "start": 11.56,
    "end": 12.61,
    "text": "并非没有警报",
    "chars_per_second": 5.71
   },
   {
    "i": 8,
    "start": 12.95,
    "end": 13.98,
    "text": "一九六八年",
    "chars_per_second": 4.85
   },
   {
    "i": 9,
    "start": 14.32,
    "end": 15.85,
    "text": "他曾因性侵被判刑",
    "chars_per_second": 5.23
   },
   {
    "i": 10,
    "start": 16.2,
    "end": 17.08,
    "text": "后来获假释",
    "chars_per_second": 5.68
   },
   {
    "i": 11,
    "start": 17.31,
    "end": 17.99,
    "text": "回到社区",
    "chars_per_second": 5.88
   },
   {
    "i": 12,
    "start": 18.33,
    "end": 20.52,
    "text": "旧案没让危险永远消失",
    "chars_per_second": 4.57
   },
   {
    "i": 13,
    "start": 20.87,
    "end": 22.69,
    "text": "当一个人看起来正常",
    "chars_per_second": 4.95
   },
   {
    "i": 14,
    "start": 23.04,
    "end": 25.73,
    "text": "谁会留意那些已经出现的异常",
    "chars_per_second": 4.82
   }
  ]
 },
 "N03": {
  "duration": 23.6,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.07,
    "text": "一九七八年十二月十一日",
    "chars_per_second": 5.73
   },
   {
    "i": 1,
    "start": 2.41,
    "end": 4.02,
    "text": "十五岁的罗伯特·皮斯特",
    "chars_per_second": 6.21
   },
   {
    "i": 2,
    "start": 4.31,
    "end": 5.96,
    "text": "在一家药店工作后失踪",
    "chars_per_second": 6.06
   },
   {
    "i": 3,
    "start": 6.31,
    "end": 7.28,
    "text": "他曾告诉母亲",
    "chars_per_second": 6.19
   },
   {
    "i": 4,
    "start": 7.4,
    "end": 9.22,
    "text": "要去和一位承包商谈工作",
    "chars_per_second": 6.04
   },
   {
    "i": 5,
    "start": 9.57,
    "end": 9.9,
    "text": "那个人",
    "chars_per_second": 9.09
   },
   {
    "i": 6,
    "start": 10.25,
    "end": 10.89,
    "text": "就是盖西",
    "chars_per_second": 6.25
   },
   {
    "i": 7,
    "start": 11.23,
    "end": 11.81,
    "text": "工作机会",
    "chars_per_second": 6.9
   },
   {
    "i": 8,
    "start": 12.06,
    "end": 13.35,
    "text": "本该通向新的生活",
    "chars_per_second": 6.2
   },
   {
    "i": 9,
    "start": 13.69,
    "end": 14.06,
    "text": "这一次",
    "chars_per_second": 8.11
   },
   {
    "i": 10,
    "start": 14.35,
    "end": 15.49,
    "text": "却成为调查线索",
    "chars_per_second": 6.14
   },
   {
    "i": 11,
    "start": 15.83,
    "end": 16.81,
    "text": "母亲等不到儿子",
    "chars_per_second": 7.14
   },
   {
    "i": 12,
    "start": 17.15,
    "end": 18.3,
    "text": "警方开始寻找他",
    "chars_per_second": 6.09
   },
   {
    "i": 13,
    "start": 18.65,
    "end": 20.24,
    "text": "一个家庭的报案",
    "chars_per_second": 4.4
   },
   {
    "i": 14,
    "start": 20.35,
    "end": 22.25,
    "text": "留下了必须回答的问题",
    "chars_per_second": 5.26
   },
   {
    "i": 15,
    "start": 22.42,
    "end": 23.6,
    "text": "少年最后见了谁",
    "chars_per_second": 5.93
   }
  ]
 },
 "N04": {
  "duration": 27.465,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.24,
    "text": "警探循着线索找到盖西",
    "chars_per_second": 4.78
   },
   {
    "i": 1,
    "start": 2.59,
    "end": 3.35,
    "text": "核对说法",
    "chars_per_second": 5.26
   },
   {
    "i": 2,
    "start": 3.68,
    "end": 4.69,
    "text": "也查到了前科",
    "chars_per_second": 5.94
   },
   {
    "i": 3,
    "start": 5.04,
    "end": 6.17,
    "text": "十二月十三日",
    "chars_per_second": 5.31
   },
   {
    "i": 4,
    "start": 6.52,
    "end": 8.37,
    "text": "警方第一次搜查他的住宅",
    "chars_per_second": 5.95
   },
   {
    "i": 5,
    "start": 8.71,
    "end": 9.67,
    "text": "带走多件物品",
    "chars_per_second": 6.25
   },
   {
    "i": 6,
    "start": 10.01,
    "end": 11.82,
    "text": "监视和调查继续推进",
    "chars_per_second": 4.97
   },
   {
    "i": 7,
    "start": 12.16,
    "end": 14.06,
    "text": "盖西的日常还在上演",
    "chars_per_second": 4.74
   },
   {
    "i": 8,
    "start": 14.4,
    "end": 16.46,
    "text": "证据却正一点点靠近",
    "chars_per_second": 4.37
   },
   {
    "i": 9,
    "start": 16.8,
    "end": 17.99,
    "text": "十二月二十一日",
    "chars_per_second": 5.88
   },
   {
    "i": 10,
    "start": 18.33,
    "end": 19.47,
    "text": "警方再次搜查",
    "chars_per_second": 5.26
   },
   {
    "i": 11,
    "start": 19.81,
    "end": 22.5,
    "text": "镜头停在关闭的地板入口",
    "chars_per_second": 4.09
   },
   {
    "i": 12,
    "start": 22.75,
    "end": 23.46,
    "text": "有些事实",
    "chars_per_second": 5.63
   },
   {
    "i": 13,
    "start": 23.8,
    "end": 25.05,
    "text": "不需要猎奇的画面",
    "chars_per_second": 6.4
   },
   {
    "i": 14,
    "start": 25.39,
    "end": 27.46,
    "text": "也足以说明事情的重量",
    "chars_per_second": 4.82
   }
  ]
 },
 "N05": {
  "duration": 26.015,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.65,
    "text": "调查最终指向三十三名遇害者",
    "chars_per_second": 5.2
   },
   {
    "i": 1,
    "start": 3.0,
    "end": 6.21,
    "text": "警方在盖西住宅内外发现二十九人的遗骸",
    "chars_per_second": 5.61
   },
   {
    "i": 2,
    "start": 6.61,
    "end": 8.2,
    "text": "另有四人在河中找到",
    "chars_per_second": 5.66
   },
   {
    "i": 3,
    "start": 8.54,
    "end": 10.71,
    "text": "不是三十三人都埋在地板下面",
    "chars_per_second": 5.99
   },
   {
    "i": 4,
    "start": 11.07,
    "end": 13.33,
    "text": "也不能把他们缩成一个数字",
    "chars_per_second": 5.31
   },
   {
    "i": 5,
    "start": 13.47,
    "end": 15.29,
    "text": "他们是少年和年轻男子",
    "chars_per_second": 5.49
   },
   {
    "i": 6,
    "start": 15.64,
    "end": 16.24,
    "text": "有名字",
    "chars_per_second": 5.0
   },
   {
    "i": 7,
    "start": 16.55,
    "end": 17.72,
    "text": "家人与未来",
    "chars_per_second": 4.27
   },
   {
    "i": 8,
    "start": 18.06,
    "end": 18.82,
    "text": "有的身份",
    "chars_per_second": 5.26
   },
   {
    "i": 9,
    "start": 19.02,
    "end": 20.81,
    "text": "直到多年后才逐步确认",
    "chars_per_second": 5.59
   },
   {
    "i": 10,
    "start": 21.27,
    "end": 22.81,
    "text": "我们不再看小丑的笑脸",
    "chars_per_second": 6.49
   },
   {
    "i": 11,
    "start": 23.16,
    "end": 24.42,
    "text": "镜头留给空椅子",
    "chars_per_second": 5.56
   },
   {
    "i": 12,
    "start": 24.75,
    "end": 26.02,
    "text": "和等待答案的人",
    "chars_per_second": 5.53
   }
  ]
 },
 "N06": {
  "duration": 24.265,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.92,
    "text": "一九八零年",
    "chars_per_second": 6.41
   },
   {
    "i": 1,
    "start": 1.26,
    "end": 3.72,
    "text": "盖西被裁定三十三项谋杀罪成立",
    "chars_per_second": 5.69
   },
   {
    "i": 2,
    "start": 4.04,
    "end": 5.01,
    "text": "并被判处死刑",
    "chars_per_second": 6.19
   },
   {
    "i": 3,
    "start": 5.36,
    "end": 6.9,
    "text": "一九九四年五月十日",
    "chars_per_second": 5.84
   },
   {
    "i": 4,
    "start": 7.24,
    "end": 8.04,
    "text": "死刑执行",
    "chars_per_second": 5.0
   },
   {
    "i": 5,
    "start": 8.38,
    "end": 11.21,
    "text": "但判决不能替家人补回失去的岁月",
    "chars_per_second": 5.3
   },
   {
    "i": 6,
    "start": 11.56,
    "end": 12.52,
    "text": "妆容和真相",
    "chars_per_second": 5.21
   },
   {
    "i": 7,
    "start": 12.8,
    "end": 14.18,
    "text": "形成了刺眼的反差",
    "chars_per_second": 5.8
   },
   {
    "i": 8,
    "start": 14.52,
    "end": 16.19,
    "text": "可妆容不是罪恶的原因",
    "chars_per_second": 5.99
   },
   {
    "i": 9,
    "start": 16.53,
    "end": 18.53,
    "text": "证据和行为才是判断依据",
    "chars_per_second": 5.5
   },
   {
    "i": 10,
    "start": 18.87,
    "end": 19.75,
    "text": "我们需要记住的",
    "chars_per_second": 7.95
   },
   {
    "i": 11,
    "start": 20.07,
    "end": 21.53,
    "text": "不是一个怪物有多出名",
    "chars_per_second": 6.85
   },
   {
    "i": 12,
    "start": 21.88,
    "end": 24.27,
    "text": "而是每条生命都不该被遗忘",
    "chars_per_second": 5.03
   }
  ]
 }
}