[
  {
    "start": 0.6612131189187301,
    "end": 2.5792241783722756,
    "text": "一九九一年三月二十六日，"
  },
  {
    "start": 2.8648853999930166,
    "end": 3.742273437828149,
    "text": "韩国大邱。"
  },
  {
    "start": 3.905508421611429,
    "end": 5.609273564849419,
    "text": "五个孩子像往常一样，"
  },
  {
    "start": 5.854126040524339,
    "end": 7.5578911837623295,
    "text": "背起书包走出了家门。"
  },
  {
    "start": 7.853754591869525,
    "end": 8.435279221597462,
    "text": "那一天，"
  },
  {
    "start": 8.669929510785927,
    "end": 9.506508802675238,
    "text": "没有人知道，"
  },
  {
    "start": 9.751361278350162,
    "end": 13.536372464824975,
    "text": "这会成为韩国历史上最令人痛心的失踪案件之一。"
  },
  {
    "start": 13.832235872932172,
    "end": 14.791241402658942,
    "text": "那时的大邱，"
  },
  {
    "start": 14.995285132388046,
    "end": 15.872673170223177,
    "text": "春天的下午，"
  },
  {
    "start": 16.066514713465825,
    "end": 18.178367316162017,
    "text": "街道上到处是放学回家的孩子，"
  },
  {
    "start": 18.443624164809847,
    "end": 20.239208986425933,
    "text": "巷口的老人还在晾晒衣服。"
  },
  {
    "start": 20.545274581019584,
    "end": 22.14701785939302,
    "text": "他们只是普通的小学生，"
  },
  {
    "start": 22.320455029662757,
    "end": 23.350875864794716,
    "text": "有自己的兴趣，"
  },
  {
    "start": 23.493706475605087,
    "end": 25.370908789112807,
    "text": "也有等着他们回家吃饭的父母。"
  },
  {
    "start": 25.46272846749091,
    "end": 26.299307759380216,
    "text": "孩子们约好，"
  },
  {
    "start": 26.56456460802805,
    "end": 27.971021033406597,
    "text": "天黑之前一定回来。"
  },
  {
    "start": 29.11223415232533,
    "end": 29.856993765836545,
    "text": "放学后，"
  },
  {
    "start": 30.15285717394374,
    "end": 33.10128906852925,
    "text": "五个孩子决定一起去附近的卧龙山玩。"
  },
  {
    "start": 33.22371530636671,
    "end": 36.03951877662829,
    "text": "金钟植最喜欢找小虫子和小东西，"
  },
  {
    "start": 36.325179998249034,
    "end": 37.61065549554237,
    "text": "朴灿仁爱笑、"
  },
  {
    "start": 37.79429485229856,
    "end": 38.38602166851295,
    "text": "爱运动，"
  },
  {
    "start": 38.68188507662015,
    "end": 40.834546425262154,
    "text": "金永奎是孩子们的小领头，"
  },
  {
    "start": 41.130409833369356,
    "end": 42.97700558741771,
    "text": "赵浩延比同伴们沉稳，"
  },
  {
    "start": 43.27286899552491,
    "end": 45.700989379301205,
    "text": "禹哲元则常跟着哥哥们一起玩。"
  },
  {
    "start": 45.86422436308449,
    "end": 47.567989506322476,
    "text": "他们最后一次被人看到，"
  },
  {
    "start": 47.71082011713284,
    "end": 49.17993497118237,
    "text": "就是在那片山脚下。"
  },
  {
    "start": 49.41458526037084,
    "end": 49.90429021172068,
    "text": "后来，"
  },
  {
    "start": 50.13894050090914,
    "end": 52.55685869819898,
    "text": "媒体误把他们说成是去找青蛙，"
  },
  {
    "start": 52.740498054955175,
    "end": 54.94417033602946,
    "text": "于是他们被叫作青蛙少年。"
  },
  {
    "start": 55.209427184677295,
    "end": 55.75014306845941,
    "text": "其实，"
  },
  {
    "start": 55.984793357647874,
    "end": 57.35188634683284,
    "text": "他们是去找蝾螈卵。"
  },
  {
    "start": 57.535525703589045,
    "end": 58.29048750358671,
    "text": "那天傍晚，"
  },
  {
    "start": 58.586350911693906,
    "end": 61.01982744337559,
    "text": "他们本该像往常一样回家吃饭。"
  },
  {
    "start": 62.16104056229432,
    "end": 63.140450464994004,
    "text": "他们没有回来。"
  },
  {
    "start": 63.42611168661474,
    "end": 63.82399695958649,
    "text": "夜里，"
  },
  {
    "start": 64.11986036769369,
    "end": 65.8848386298504,
    "text": "家长开始意识到事情不对。"
  },
  {
    "start": 66.1807020379576,
    "end": 68.61902460822036,
    "text": "警察和军队进入卧龙山搜索，"
  },
  {
    "start": 68.9046858298411,
    "end": 70.75128158388945,
    "text": "许多志愿者也加入其中。"
  },
  {
    "start": 71.02674061902374,
    "end": 73.88335283523115,
    "text": "这场搜索一共动用了约三十五万人次。"
  },
  {
    "start": 73.99557688658216,
    "end": 76.49511257576363,
    "text": "电视和报纸一遍遍播出这件事。"
  },
  {
    "start": 76.68895411900628,
    "end": 79.35172479197104,
    "text": "父母们每天都在希望和绝望之间来回。"
  },
  {
    "start": 79.39253353791686,
    "end": 80.9942768162903,
    "text": "房间保持原样，"
  },
  {
    "start": 81.04528774872257,
    "end": 83.0143097406084,
    "text": "仿佛孩子随时会推门回来。"
  },
  {
    "start": 83.06532067304067,
    "end": 86.53406407843538,
    "text": "这个案子成了韩国最著名的未解失踪事件之一，"
  },
  {
    "start": 86.81972530005612,
    "end": 87.87055050816099,
    "text": "而山上的答案，"
  },
  {
    "start": 87.982774559512,
    "end": 89.19968286179429,
    "text": "始终没有出现。"
  },
  {
    "start": 90.35109816719945,
    "end": 91.5651583590876,
    "text": "一九九三年九月，"
  },
  {
    "start": 91.8610217671948,
    "end": 94.91147552664485,
    "text": "部分家长宣布暂时放弃亲自寻找，"
  },
  {
    "start": 95.19713674826559,
    "end": 96.5132188050183,
    "text": "回到了各自的生活。"
  },
  {
    "start": 96.79888002663904,
    "end": 98.17617520231046,
    "text": "时间一年年过去。"
  },
  {
    "start": 98.32920799960729,
    "end": 100.62469995905967,
    "text": "直到二〇〇二年九月二十六日，"
  },
  {
    "start": 100.92056336716686,
    "end": 102.58351976445903,
    "text": "一个上山采橡子的人，"
  },
  {
    "start": 102.86918098607978,
    "end": 106.24610471309639,
    "text": "在卧龙山的一处荒地上发现了人体遗骸。"
  },
  {
    "start": 106.39913751039322,
    "end": 106.92965120768888,
    "text": "那里，"
  },
  {
    "start": 107.15409931039089,
    "end": 109.15372786173607,
    "text": "是旧军队靶场的旧址。"
  },
  {
    "start": 109.34756940497871,
    "end": 110.68405583470432,
    "text": "警方当年一度认为，"
  },
  {
    "start": 110.79627988605533,
    "end": 113.23460245631809,
    "text": "孩子们可能是迷路后在寒冷中死去；"
  },
  {
    "start": 113.52026367793883,
    "end": 115.15261351577163,
    "text": "但负责鉴定的法医团队，"
  },
  {
    "start": 115.25463538063619,
    "end": 117.6113404590073,
    "text": "在颅骨上发现了外力造成的损伤，"
  },
  {
    "start": 117.82558637522285,
    "end": 119.39166451000406,
    "text": "认定他们是被杀害的。"
  },
  {
    "start": 120.56348418838215,
    "end": 122.17542965324203,
    "text": "遗骸经过 DNA 鉴定，"
  },
  {
    "start": 122.37947338297114,
    "end": 124.52193254512669,
    "text": "确认属于失踪的五名孩子。"
  },
  {
    "start": 124.78718939377453,
    "end": 126.53176328295834,
    "text": "他们已经消失了十一年半。"
  },
  {
    "start": 126.82762669106553,
    "end": 127.97027157754849,
    "text": "法医团队的鉴定，"
  },
  {
    "start": 128.07229344241304,
    "end": 130.79627723429653,
    "text": "让这起案件从失踪变成了一桩命案。"
  },
  {
    "start": 131.02072533699854,
    "end": 132.5510533099668,
    "text": "而警方当年的判断，"
  },
  {
    "start": 132.78570359915526,
    "end": 133.92834848563822,
    "text": "则是另一种说法。"
  },
  {
    "start": 134.09158346942152,
    "end": 134.58128842077136,
    "text": "可是，"
  },
  {
    "start": 134.85674745590563,
    "end": 137.23385690724967,
    "text": "风雨和时间已经改写了现场，"
  },
  {
    "start": 137.4583050099517,
    "end": 138.37650179373261,
    "text": "凶手是谁、"
  },
  {
    "start": 138.60094989643463,
    "end": 139.77420134237695,
    "text": "事发经过如何，"
  },
  {
    "start": 139.98844725859252,
    "end": 141.20250745048065,
    "text": "始终没有查清。"
  },
  {
    "start": 141.49837085858786,
    "end": 143.47759503696014,
    "text": "二〇〇六年三月二十五日，"
  },
  {
    "start": 143.7326496991215,
    "end": 145.10994487479294,
    "text": "法定追诉期届满，"
  },
  {
    "start": 145.40580828290013,
    "end": 147.7861909357419,
    "text": "这起案件仍然没有找到凶手。"
  },
  {
    "start": 148.93760624114708,
    "end": 149.855803024928,
    "text": "二〇一九年，"
  },
  {
    "start": 149.98843144925195,
    "end": 151.64118566005766,
    "text": "警方重新启动调查，"
  },
  {
    "start": 151.83502720330029,
    "end": 155.4399476196229,
    "text": "把遗留的衣物送去国立科学搜查研究院做 DNA"
  },
  {
    "start": 155.4399476196229,
    "end": 155.84448649247713,
    "text": "检测。"
  },
  {
    "start": 156.13014771409786,
    "end": 156.90551388706845,
    "text": "新的技术，"
  },
  {
    "start": 157.04834449787882,
    "end": 158.9153446249001,
    "text": "让人们期待找到更多线索。"
  },
  {
    "start": 159.2112080330073,
    "end": 160.13960700327468,
    "text": "但直到今天，"
  },
  {
    "start": 160.37425729246317,
    "end": 161.4964978059732,
    "text": "真正发生了什么，"
  },
  {
    "start": 161.78215902759396,
    "end": 163.16965638975182,
    "text": "仍然没有完整的答案。"
  },
  {
    "start": 163.33289137353512,
    "end": 165.15908275461055,
    "text": "五个孩子离开的那个下午，"
  },
  {
    "start": 165.4447439762313,
    "end": 167.40356378163068,
    "text": "成了一个社会永远的记忆。"
  },
  {
    "start": 167.69942718973786,
    "end": 168.576815227573,
    "text": "他们留下的，"
  },
  {
    "start": 168.76045458432918,
    "end": 169.99491914919025,
    "text": "不只是一个案件，"
  },
  {
    "start": 170.27037818432453,
    "end": 171.86191927621152,
    "text": "还有一个关于寻找、"
  },
  {
    "start": 172.14758049783225,
    "end": 173.99999999999997,
    "text": "等待和希望的故事。"
  }
]