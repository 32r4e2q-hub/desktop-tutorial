{
 "N01": {
  "duration": 19.058,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 1.85,
    "text": "一九九一年三月二十六日",
    "chars_per_second": 6.36
   },
   {
    "i": 1,
    "start": 2.12,
    "end": 2.9,
    "text": "韩国大邱",
    "chars_per_second": 5.13
   },
   {
    "i": 2,
    "start": 3.24,
    "end": 4.82,
    "text": "五个孩子像往常一样",
    "chars_per_second": 5.7
   },
   {
    "i": 3,
    "start": 5.09,
    "end": 6.89,
    "text": "背起书包走出了家门",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 7.24,
    "end": 7.79,
    "text": "那一天",
    "chars_per_second": 5.45
   },
   {
    "i": 5,
    "start": 8.08,
    "end": 8.87,
    "text": "没有人知道",
    "chars_per_second": 6.33
   },
   {
    "i": 6,
    "start": 9.18,
    "end": 13.29,
    "text": "这会成为韩国历史上最令人痛心的失踪案件之一",
    "chars_per_second": 5.11
   },
   {
    "i": 7,
    "start": 13.58,
    "end": 15.24,
    "text": "他们只是普通的小学生",
    "chars_per_second": 6.02
   },
   {
    "i": 8,
    "start": 15.58,
    "end": 16.57,
    "text": "有自己的兴趣",
    "chars_per_second": 6.06
   },
   {
    "i": 9,
    "start": 16.92,
    "end": 19.06,
    "text": "也有等着他们回家吃饭的父母",
    "chars_per_second": 6.08
   }
  ]
 },
 "N02": {
  "duration": 31.335,
  "clauses": [
   {
    "i": 0,
    "start": 0.08,
    "end": 0.75,
    "text": "放学后",
    "chars_per_second": 4.48
   },
   {
    "i": 1,
    "start": 1.1,
    "end": 3.93,
    "text": "五个孩子决定一起去附近的卧龙山玩",
    "chars_per_second": 5.65
   },
   {
    "i": 2,
    "start": 4.11,
    "end": 6.81,
    "text": "金钟植最喜欢找小虫子和小东西",
    "chars_per_second": 5.19
   },
   {
    "i": 3,
    "start": 7.15,
    "end": 8.35,
    "text": "朴灿仁爱笑",
    "chars_per_second": 4.17
   },
   {
    "i": 4,
    "start": 8.59,
    "end": 9.11,
    "text": "爱运动",
    "chars_per_second": 5.77
   },
   {
    "i": 5,
    "start": 9.46,
    "end": 11.51,
    "text": "金永奎是孩子们的小领头",
    "chars_per_second": 5.37
   },
   {
    "i": 6,
    "start": 11.86,
    "end": 13.61,
    "text": "赵浩延比同伴们沉稳",
    "chars_per_second": 5.14
   },
   {
    "i": 7,
    "start": 13.96,
    "end": 16.28,
    "text": "禹哲元则常跟着哥哥们一起玩",
    "chars_per_second": 5.6
   },
   {
    "i": 8,
    "start": 16.5,
    "end": 18.11,
    "text": "他们最后一次被人看到",
    "chars_per_second": 6.21
   },
   {
    "i": 9,
    "start": 18.31,
    "end": 19.69,
    "text": "就是在那片山脚下",
    "chars_per_second": 5.8
   },
   {
    "i": 10,
    "start": 19.98,
    "end": 20.4,
    "text": "后来",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 20.69,
    "end": 23.0,
    "text": "媒体误把他们说成是去找青蛙",
    "chars_per_second": 5.63
   },
   {
    "i": 12,
    "start": 23.24,
    "end": 25.34,
    "text": "于是他们被叫作青蛙少年",
    "chars_per_second": 5.24
   },
   {
    "i": 13,
    "start": 25.66,
    "end": 26.13,
    "text": "其实",
    "chars_per_second": 4.26
   },
   {
    "i": 14,
    "start": 26.42,
    "end": 27.7,
    "text": "他们是去找蝾螈卵",
    "chars_per_second": 6.25
   },
   {
    "i": 15,
    "start": 27.94,
    "end": 28.62,
    "text": "那天傍晚",
    "chars_per_second": 5.88
   },
   {
    "i": 16,
    "start": 28.97,
    "end": 31.34,
    "text": "他们本该像往常一样回家吃饭",
    "chars_per_second": 5.5
   }
  ]
 },
 "N03": {
  "duration": 26.485,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 1.01,
    "text": "他们没有回来",
    "chars_per_second": 6.38
   },
   {
    "i": 1,
    "start": 1.36,
    "end": 1.74,
    "text": "夜里",
    "chars_per_second": 5.26
   },
   {
    "i": 2,
    "start": 2.01,
    "end": 4.55,
    "text": "家长开始意识到事情不对",
    "chars_per_second": 4.33
   },
   {
    "i": 3,
    "start": 4.79,
    "end": 5.23,
    "text": "警察",
    "chars_per_second": 4.55
   },
   {
    "i": 4,
    "start": 5.43,
    "end": 7.5,
    "text": "军队和志愿者进入卧龙山搜索",
    "chars_per_second": 6.28
   },
   {
    "i": 5,
    "start": 7.89,
    "end": 10.99,
    "text": "一年之内动用的搜索人力约三十五万人次",
    "chars_per_second": 5.81
   },
   {
    "i": 6,
    "start": 11.29,
    "end": 12.39,
    "text": "电视和报纸一遍遍播出这件事",
    "chars_per_second": 11.82
   },
   {
    "i": 7,
    "start": 12.52,
    "end": 13.9,
    "text": "父母们每天都在希望和绝望之间来回",
    "chars_per_second": 11.59
   },
   {
    "i": 8,
    "start": 14.15,
    "end": 18.07,
    "text": "房间保持原样",
    "chars_per_second": 1.53
   },
   {
    "i": 9,
    "start": 18.39,
    "end": 20.21,
    "text": "仿佛孩子随时会推门回来",
    "chars_per_second": 6.04
   },
   {
    "i": 10,
    "start": 20.49,
    "end": 23.8,
    "text": "这个案子成了韩国最著名的未解失踪事件之一",
    "chars_per_second": 6.04
   },
   {
    "i": 11,
    "start": 24.12,
    "end": 25.08,
    "text": "而山上的答案",
    "chars_per_second": 6.25
   },
   {
    "i": 12,
    "start": 25.27,
    "end": 26.49,
    "text": "始终没有出现",
    "chars_per_second": 4.94
   }
  ]
 },
 "N04": {
  "duration": 28.535,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.22,
    "text": "一九九三年九月",
    "chars_per_second": 6.19
   },
   {
    "i": 1,
    "start": 1.57,
    "end": 4.5,
    "text": "部分家长宣布暂时放弃亲自寻找",
    "chars_per_second": 4.78
   },
   {
    "i": 2,
    "start": 4.84,
    "end": 6.07,
    "text": "回到了各自的生活",
    "chars_per_second": 6.5
   },
   {
    "i": 3,
    "start": 6.41,
    "end": 7.7,
    "text": "时间一年年过去",
    "chars_per_second": 5.43
   },
   {
    "i": 4,
    "start": 7.91,
    "end": 10.1,
    "text": "直到二〇〇二年九月二十六日",
    "chars_per_second": 5.02
   },
   {
    "i": 5,
    "start": 10.45,
    "end": 12.02,
    "text": "一个上山采橡子的人",
    "chars_per_second": 5.73
   },
   {
    "i": 6,
    "start": 12.36,
    "end": 15.61,
    "text": "在卧龙山的一处荒地上发现了人体遗骸",
    "chars_per_second": 5.23
   },
   {
    "i": 7,
    "start": 15.82,
    "end": 16.28,
    "text": "那里",
    "chars_per_second": 4.35
   },
   {
    "i": 8,
    "start": 16.56,
    "end": 18.46,
    "text": "是旧军队靶场的旧址",
    "chars_per_second": 4.74
   },
   {
    "i": 9,
    "start": 18.71,
    "end": 19.96,
    "text": "警方当年一度认为",
    "chars_per_second": 6.4
   },
   {
    "i": 10,
    "start": 20.13,
    "end": 22.46,
    "text": "孩子们可能是迷路后在寒冷中死去",
    "chars_per_second": 6.44
   },
   {
    "i": 11,
    "start": 22.8,
    "end": 24.34,
    "text": "但负责鉴定的法医团队",
    "chars_per_second": 6.49
   },
   {
    "i": 12,
    "start": 24.5,
    "end": 26.75,
    "text": "在颅骨上发现了外力造成的损伤",
    "chars_per_second": 6.22
   },
   {
    "i": 13,
    "start": 27.02,
    "end": 28.54,
    "text": "认定他们是被杀害的",
    "chars_per_second": 5.94
   }
  ]
 },
 "N05": {
  "duration": 18.71,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.67,
    "text": "遗骸经过 DNA 鉴定",
    "chars_per_second": 5.88
   },
   {
    "i": 1,
    "start": 1.96,
    "end": 3.85,
    "text": "确认属于失踪的五名孩子",
    "chars_per_second": 5.82
   },
   {
    "i": 2,
    "start": 4.13,
    "end": 5.93,
    "text": "他们已经消失了十一年半",
    "chars_per_second": 6.11
   },
   {
    "i": 3,
    "start": 6.28,
    "end": 6.68,
    "text": "可是",
    "chars_per_second": 5.0
   },
   {
    "i": 4,
    "start": 7.01,
    "end": 9.0,
    "text": "风雨和时间已经改写了现场",
    "chars_per_second": 6.03
   },
   {
    "i": 5,
    "start": 9.33,
    "end": 10.13,
    "text": "凶手是谁",
    "chars_per_second": 5.0
   },
   {
    "i": 6,
    "start": 10.34,
    "end": 11.42,
    "text": "事发经过如何",
    "chars_per_second": 5.56
   },
   {
    "i": 7,
    "start": 11.64,
    "end": 12.65,
    "text": "始终没有查清",
    "chars_per_second": 5.94
   },
   {
    "i": 8,
    "start": 12.92,
    "end": 14.7,
    "text": "二〇〇六年三月二十五日",
    "chars_per_second": 5.06
   },
   {
    "i": 9,
    "start": 15.05,
    "end": 16.29,
    "text": "法定追诉期届满",
    "chars_per_second": 5.65
   },
   {
    "i": 10,
    "start": 16.63,
    "end": 18.71,
    "text": "这起案件仍然没有找到凶手",
    "chars_per_second": 5.77
   }
  ]
 },
 "N06": {
  "duration": 24.636,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 0.93,
    "text": "二〇一九年",
    "chars_per_second": 4.76
   },
   {
    "i": 1,
    "start": 1.12,
    "end": 2.68,
    "text": "警方重新启动调查",
    "chars_per_second": 5.13
   },
   {
    "i": 2,
    "start": 2.93,
    "end": 6.8,
    "text": "把遗留的衣物送去国立科学搜查研究院做 DNA 检测",
    "chars_per_second": 5.94
   },
   {
    "i": 3,
    "start": 7.14,
    "end": 7.84,
    "text": "新的技术",
    "chars_per_second": 5.71
   },
   {
    "i": 4,
    "start": 8.04,
    "end": 9.81,
    "text": "让人们期待找到更多线索",
    "chars_per_second": 6.21
   },
   {
    "i": 5,
    "start": 10.16,
    "end": 11.01,
    "text": "但直到今天",
    "chars_per_second": 5.88
   },
   {
    "i": 6,
    "start": 11.3,
    "end": 12.34,
    "text": "真正发生了什么",
    "chars_per_second": 6.73
   },
   {
    "i": 7,
    "start": 12.68,
    "end": 13.98,
    "text": "仍然没有完整的答案",
    "chars_per_second": 6.92
   },
   {
    "i": 8,
    "start": 14.2,
    "end": 15.93,
    "text": "五个孩子离开的那个下午",
    "chars_per_second": 6.36
   },
   {
    "i": 9,
    "start": 16.27,
    "end": 18.13,
    "text": "成了一个社会永远的记忆",
    "chars_per_second": 5.91
   },
   {
    "i": 10,
    "start": 18.48,
    "end": 19.28,
    "text": "他们留下的",
    "chars_per_second": 6.25
   },
   {
    "i": 11,
    "start": 19.52,
    "end": 20.67,
    "text": "不只是一个案件",
    "chars_per_second": 6.09
   },
   {
    "i": 12,
    "start": 21.0,
    "end": 22.5,
    "text": "还有一个关于寻找",
    "chars_per_second": 5.33
   },
   {
    "i": 13,
    "start": 22.84,
    "end": 24.64,
    "text": "等待和希望的故事",
    "chars_per_second": 4.46
   }
  ]
 }
}