[
  {
    "start": 0.6,
    "end": 2.2695169863646867,
    "text": "上世纪七八十年代，"
  },
  {
    "start": 2.2695169863646867,
    "end": 5.822093829443032,
    "text": "加利福尼亚州笼罩在巨大的阴影之中。"
  },
  {
    "start": 5.822093829443032,
    "end": 10.151190201063093,
    "text": "一名代号金州杀手的凶徒接连作案几十起，"
  },
  {
    "start": 10.151190201063093,
    "end": 11.645990293505895,
    "text": "随后销声匿迹。"
  },
  {
    "start": 11.645990293505895,
    "end": 14.752068407672754,
    "text": "现场留下的微量毛发与物证，"
  },
  {
    "start": 14.752068407672754,
    "end": 18.382297203605273,
    "text": "在当年的技术条件下无法提取有效线索，"
  },
  {
    "start": 18.382297203605273,
    "end": 21.993113011324244,
    "text": "最终成了躺在档案库里厚厚的死档。"
  },
  {
    "start": 21.993113011324244,
    "end": 24.65269239657962,
    "text": "谁也没有想到，"
  },
  {
    "start": 24.65269239657962,
    "end": 25.68158077189739,
    "text": "三十年后，"
  },
  {
    "start": 25.68158077189739,
    "end": 29.680656343887225,
    "text": "这批沉睡的物证将彻底改写刑事侦查的历史。"
  },
  {
    "start": 30.760656343887227,
    "end": 34.11910330483014,
    "text": "传统的法医比对依赖STR基因分型，"
  },
  {
    "start": 34.11910330483014,
    "end": 38.778220476080435,
    "text": "必须在现有的前科犯罪数据库中碰撞出完全吻合的人。"
  },
  {
    "start": 38.778220476080435,
    "end": 40.835997226715975,
    "text": "如果凶手从未被捕，"
  },
  {
    "start": 40.835997226715975,
    "end": 42.77729604807027,
    "text": "数据库里就查无此人。"
  },
  {
    "start": 42.77729604807027,
    "end": 45.281571527617295,
    "text": "冷案之所以冰封数十年，"
  },
  {
    "start": 45.281571527617295,
    "end": 48.21293274786227,
    "text": "根源正是传统刑侦数据库的盲区。"
  },
  {
    "start": 48.21293274786227,
    "end": 50.67838225098221,
    "text": "然而进入二十一世纪，"
  },
  {
    "start": 50.67838225098221,
    "end": 53.357374624451126,
    "text": "高通量基因测序技术突飞猛进，"
  },
  {
    "start": 53.357374624451126,
    "end": 57.62823203143056,
    "text": "让法医学界迎来了一场划时代的认知飞跃。"
  },
  {
    "start": 58.70823203143056,
    "end": 62.270515368615676,
    "text": "第一项突破性技术是DNA表型分析。"
  },
  {
    "start": 62.40640628611048,
    "end": 65.78426623526694,
    "text": "科学家不再只把基因当成一组身份条码，"
  },
  {
    "start": 65.9007441645482,
    "end": 69.14271319620985,
    "text": "而是通过海量单核苷酸多态性位点，"
  },
  {
    "start": 69.3950820429859,
    "end": 71.53051074647563,
    "text": "直接反推生理外貌特征。"
  },
  {
    "start": 71.95759648717357,
    "end": 74.11243817887683,
    "text": "从几微升陈旧物证中，"
  },
  {
    "start": 74.20950311994454,
    "end": 77.3155812341114,
    "text": "算法能够精准推断出嫌疑人的虹膜颜色、"
  },
  {
    "start": 77.47088513981976,
    "end": 78.0338617980125,
    "text": "发色、"
  },
  {
    "start": 78.18916570372083,
    "end": 80.09163854864804,
    "text": "肤色乃至祖源构成，"
  },
  {
    "start": 80.42165934827827,
    "end": 81.91645944072107,
    "text": "甚至生成预测画像，"
  },
  {
    "start": 82.26589322856483,
    "end": 85.19725444880982,
    "text": "直接刺破了未知幽灵的伪装迷雾。"
  },
  {
    "start": 86.3840258839843,
    "end": 89.45127802172406,
    "text": "真正扭转全局的是法医遗传谱系学。"
  },
  {
    "start": 89.45127802172406,
    "end": 93.13974578229721,
    "text": "调查人员做出了一个前所未有的决定："
  },
  {
    "start": 93.13974578229721,
    "end": 96.38171481395887,
    "text": "他们没有继续死守警方封闭数据库，"
  },
  {
    "start": 96.38171481395887,
    "end": 101.02141899699562,
    "text": "而是将嫌疑人的基因数据上传到了公开的家谱基因"
  },
  {
    "start": 101.02141899699562,
    "end": 103.4092165472614,
    "text": "检索平台GEDmatch。"
  },
  {
    "start": 103.4092165472614,
    "end": 104.59340882828751,
    "text": "在这里，"
  },
  {
    "start": 104.59340882828751,
    "end": 109.60195978738157,
    "text": "几万名普通公众为了寻找远祖上传了自己的基因，"
  },
  {
    "start": 109.60195978738157,
    "end": 114.29990293505895,
    "text": "这也无意间织就了一张覆盖全社会的基因互联网络。"
  },
  {
    "start": 115.37990293505894,
    "end": 117.78711347353826,
    "text": "系统没有匹配到凶手本人，"
  },
  {
    "start": 117.78711347353826,
    "end": 121.53382019875203,
    "text": "却揪出了几位共享基因片段的远房表亲。"
  },
  {
    "start": 121.53382019875203,
    "end": 127.7265634388722,
    "text": "遗传谱系学家柯琳·菲茨帕特里克与调查组顺藤摸瓜，"
  },
  {
    "start": 127.7265634388722,
    "end": 131.37620522301827,
    "text": "沿着十九世纪的曾祖父母向上回溯，"
  },
  {
    "start": 131.37620522301827,
    "end": 135.31704183036746,
    "text": "绘制出拥有数千名后代的庞大家族树。"
  },
  {
    "start": 135.31704183036746,
    "end": 137.18068869886758,
    "text": "通过逐条排查支系、"
  },
  {
    "start": 137.18068869886758,
    "end": 137.67571989831293,
    "text": "年龄、"
  },
  {
    "start": 137.67571989831293,
    "end": 140.11204991911256,
    "text": "居住地与外貌表型，"
  },
  {
    "start": 140.11204991911256,
    "end": 143.60638779755027,
    "text": "嫌疑范围被奇迹般收窄到唯一个体。"
  },
  {
    "start": 144.68638779755025,
    "end": 145.69586318465448,
    "text": "二〇一八年，"
  },
  {
    "start": 145.69586318465448,
    "end": 150.21908943840998,
    "text": "警方暗中提取了已经七十二岁的前警官约瑟夫·迪"
  },
  {
    "start": 150.21908943840998,
    "end": 152.33510515368616,
    "text": "安杰洛丢弃的物品，"
  },
  {
    "start": 152.33510515368616,
    "end": 155.441183267853,
    "text": "确认DNA百分之百吻合。"
  },
  {
    "start": 155.441183267853,
    "end": 158.68315229951466,
    "text": "满头白发的恶魔终于落网。"
  },
  {
    "start": 158.68315229951466,
    "end": 161.71157846082735,
    "text": "从一根微量毛发到家族树检索，"
  },
  {
    "start": 161.71157846082735,
    "end": 166.29304367922347,
    "text": "法医基因组学让几十年前的冷案全面复活。"
  },
  {
    "start": 166.29304367922347,
    "end": 167.82666974809337,
    "text": "基因不会说谎，"
  },
  {
    "start": 167.82666974809337,
    "end": 170.35035821585393,
    "text": "岁月也无法洗脱罪恶，"
  },
  {
    "start": 170.35035821585393,
    "end": 174.0,
    "text": "科学终将照亮一切被遗忘的黑暗角落。"
  }
]