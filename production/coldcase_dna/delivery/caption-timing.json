[
  {
    "start": 1.221215622833372,
    "end": 2.6577767506355445,
    "text": "上世纪七八十年代，"
  },
  {
    "start": 2.6771897388490875,
    "end": 6.21035359371389,
    "text": "加利福尼亚州笼罩在巨大的阴影之中。"
  },
  {
    "start": 6.501548416917033,
    "end": 10.850057776750637,
    "text": "一名代号金州杀手的凶徒接连作案几十起，"
  },
  {
    "start": 10.927709729604809,
    "end": 12.519574763115324,
    "text": "随后销声匿迹。"
  },
  {
    "start": 13.31550727987058,
    "end": 15.664478853709268,
    "text": "现场留下的微量毛发与物证，"
  },
  {
    "start": 15.703304830136354,
    "end": 18.9840998382251,
    "text": "在当年的技术条件下无法提取有效线索，"
  },
  {
    "start": 19.217055696787614,
    "end": 22.187242893459672,
    "text": "最终成了躺在档案库里厚厚的死档。"
  },
  {
    "start": 22.963762422001388,
    "end": 24.322671596949387,
    "text": "谁也没有想到，"
  },
  {
    "start": 24.322671596949387,
    "end": 25.429211925121333,
    "text": "三十年后，"
  },
  {
    "start": 25.429211925121333,
    "end": 29.66124335567368,
    "text": "这批沉睡的物证将彻底改写刑事侦查的历史。"
  },
  {
    "start": 30.760656343887227,
    "end": 34.45883059856715,
    "text": "传统的法医比对依赖STR基因分型，"
  },
  {
    "start": 34.45883059856715,
    "end": 39.27325167552578,
    "text": "必须在现有的前科犯罪数据库中碰撞出完全吻合的人。"
  },
  {
    "start": 39.603272475156004,
    "end": 41.27278946152069,
    "text": "如果凶手从未被捕，"
  },
  {
    "start": 41.3698544025884,
    "end": 43.21408828287498,
    "text": "数据库里就查无此人。"
  },
  {
    "start": 43.66058701178647,
    "end": 45.737776750635554,
    "text": "冷案之所以冰封数十年，"
  },
  {
    "start": 45.8930806563439,
    "end": 48.70796394730761,
    "text": "根源正是传统刑侦数据库的盲区。"
  },
  {
    "start": 49.17387566443264,
    "end": 50.979283568292125,
    "text": "然而进入二十一世纪，"
  },
  {
    "start": 51.037522532932755,
    "end": 53.65827594176105,
    "text": "高通量基因测序技术突飞猛进，"
  },
  {
    "start": 53.852405823896476,
    "end": 57.42439565518836,
    "text": "让法医学界迎来了一场划时代的认知飞跃。"
  },
  {
    "start": 58.70823203143056,
    "end": 62.28992835682922,
    "text": "第一项突破性技术是DNA表型分析。"
  },
  {
    "start": 62.28992835682922,
    "end": 65.93957014097528,
    "text": "科学家不再只把基因当成一组身份条码，"
  },
  {
    "start": 65.95898312918882,
    "end": 69.1621261844234,
    "text": "而是通过海量单核苷酸多态性位点，"
  },
  {
    "start": 69.20095216085048,
    "end": 71.54992373468917,
    "text": "直接反推生理外貌特征。"
  },
  {
    "start": 71.86053154610586,
    "end": 74.0541992142362,
    "text": "从几微升陈旧物证中，"
  },
  {
    "start": 74.15126415530392,
    "end": 77.37382019875203,
    "text": "算法能够精准推断出嫌疑人的虹膜颜色、"
  },
  {
    "start": 77.4514721516062,
    "end": 78.07268777443957,
    "text": "发色、"
  },
  {
    "start": 78.16975271550729,
    "end": 80.09163854864804,
    "text": "肤色乃至祖源构成，"
  },
  {
    "start": 80.34400739542409,
    "end": 81.91645944072107,
    "text": "甚至生成预测画像，"
  },
  {
    "start": 82.13000231107003,
    "end": 85.19725444880982,
    "text": "直接刺破了未知幽灵的伪装迷雾。"
  },
  {
    "start": 86.3840258839843,
    "end": 89.45127802172406,
    "text": "真正扭转全局的是法医遗传谱系学。"
  },
  {
    "start": 89.45127802172406,
    "end": 93.13974578229721,
    "text": "调查人员做出了一个前所未有的决定："
  },
  {
    "start": 93.13974578229721,
    "end": 96.38171481395887,
    "text": "他们没有继续死守警方封闭数据库，"
  },
  {
    "start": 96.38171481395887,
    "end": 101.02141899699562,
    "text": "而是将嫌疑人的基因数据上传到了公开的家谱基因"
  },
  {
    "start": 101.02141899699562,
    "end": 103.4092165472614,
    "text": "检索平台GEDmatch。"
  },
  {
    "start": 103.4092165472614,
    "end": 104.59340882828751,
    "text": "在这里，"
  },
  {
    "start": 104.59340882828751,
    "end": 109.60195978738157,
    "text": "几万名普通公众为了寻找远祖上传了自己的基因，"
  },
  {
    "start": 109.60195978738157,
    "end": 114.29990293505895,
    "text": "这也无意间织就了一张覆盖全社会的基因互联网络。"
  },
  {
    "start": 115.37990293505894,
    "end": 116.10788999306679,
    "text": "系统没有匹配到凶手本人，"
  },
  {
    "start": 116.10788999306679,
    "end": 116.5078899930668,
    "text": "却揪出了几位共享基因片段的远房表亲。"
  },
  {
    "start": 122.3879916801479,
    "end": 127.10534781603883,
    "text": "遗传谱系学家柯琳·菲茨帕特里克与调查组顺藤摸瓜，"
  },
  {
    "start": 127.68773746244511,
    "end": 130.4832077651953,
    "text": "沿着十九世纪的曾祖父母向上回溯，"
  },
  {
    "start": 130.7161636237578,
    "end": 134.44345736075803,
    "text": "绘制出拥有数千名后代的庞大家族树。"
  },
  {
    "start": 134.8317171250289,
    "end": 136.83125491102382,
    "text": "通过逐条排查支系、"
  },
  {
    "start": 136.9671458285186,
    "end": 137.62718742777906,
    "text": "年龄、"
  },
  {
    "start": 137.7436653570603,
    "end": 139.74320314305524,
    "text": "居住地与外貌表型，"
  },
  {
    "start": 139.89850704876358,
    "end": 143.3928449272013,
    "text": "嫌疑范围被奇迹般收窄到唯一个体。"
  },
  {
    "start": 144.68638779755025,
    "end": 145.91911254911022,
    "text": "二〇一八年，"
  },
  {
    "start": 145.91911254911022,
    "end": 150.32586087358445,
    "text": "警方暗中提取了已经七十二岁的前警官约瑟夫·迪"
  },
  {
    "start": 150.345273861798,
    "end": 152.07302981280333,
    "text": "安杰洛丢弃的物品，"
  },
  {
    "start": 152.09244280101686,
    "end": 154.5967182805639,
    "text": "确认DNA百分之百吻合。"
  },
  {
    "start": 155.101455974116,
    "end": 157.5863184654495,
    "text": "满头白发的恶魔终于落网。"
  },
  {
    "start": 158.30459902935058,
    "end": 161.19713427316847,
    "text": "从一根微量毛发到家族树检索，"
  },
  {
    "start": 161.37185116709034,
    "end": 165.5262306447885,
    "text": "法医基因组学让几十年前的冷案全面复活。"
  },
  {
    "start": 166.06979431476773,
    "end": 167.44811647792926,
    "text": "基因不会说谎，"
  },
  {
    "start": 167.58400739542407,
    "end": 169.7776750635544,
    "text": "岁月也无法洗脱罪恶，"
  },
  {
    "start": 170.1271088513982,
    "end": 173.9320545412526,
    "text": "科学终将照亮一切被遗忘的黑暗角落。"
  }
]