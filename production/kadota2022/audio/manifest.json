      "source_duration": 5.538,
      "atempo": 1.0,
      "tail_silence_seconds": 0.462
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "她们在同一家店上夜班，追同一个男公关，钱也一起花。",
      "sha256": "051934e3f8fc45f81a7ca139d1309cf1c5e8cabdf100b4890f238c48f0b8e9aa",
      "voice_id": "voice-03",
