      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.825,
      "atempo": 1.0,
      "tail_silence_seconds": 0.175
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "检方说，他们以讨债为名要钱，她拿不出来，人被带走。",
      "sha256": "83414904975f47f535350399fd03bd519500308d37bf731803e01444b87a620a",
      "voice_id": "voice-03",
      "voice_description": "低沉悬疑纪录片男声（第26期主创 add_voice 试听选定 voice-03；克制压抑，实测约 4.8 字/秒）",
