      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.956,
      "atempo": 1.0,
      "tail_silence_seconds": 0.044
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "三月十五日前后，在一辆停着的车里，她停止了呼吸。",
      "sha256": "79ac5251705ee376de9c367bdf29fcb6f9b0b991e021d67c633b7aa9527d05f8",
      "voice_id": "voice-03",
      "voice_description": "低沉悬疑纪录片男声（第26期主创 add_voice 试听选定 voice-03；克制压抑，实测约 4.8 字/秒）",
      "narration_id": "S19",
