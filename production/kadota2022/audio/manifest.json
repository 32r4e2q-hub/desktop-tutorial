      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.669,
      "atempo": 1.0,
      "tail_silence_seconds": 0.331
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "带走她的是天池由佳理，和当时住在车里的山下克己。",
      "sha256": "31bb7193f67ee477f9e4be76d37ad66ddf619a082dbc2ba4a4c5c0cdd69bbd73",
      "voice_id": "voice-03",
      "voice_description": "低沉悬疑纪录片男声（第26期主创 add_voice 试听选定 voice-03；克制压抑，实测约 4.8 字/秒）",
      "narration_id": "S17",
