      ],
      "references": [
        "C01",
        "C09",
        "S10",
        "C01_face"
      ],
      "narration": "仅二十七分钟，他被裁定有罪。伊瑟尔另案受审，获判无罪。",
      "narration_id": "N08",
      "prompt": "陪审员返回，首席站起口头宣告，克里平缓缓低头，法官稳坐。无伊瑟尔同庭宣判，不拍英式法庭并不存在的法槌。中景轻推。"
    },
    {
      "id": "S28",
      "start": 162,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
      "style_variant": "real",
      "seed": 191028,
      "characters": [],
      "references": [
        "S11"
      ],
      "narration": "十一月二十三日，克里平被处决，故事似乎画上了句号。",
      "narration_id": "N08",
      "prompt": "空监狱走廊，石墙与铁门，一盏盏灯依次熄灭，铁门缓慢关上，镜头沿长廊对称推进。无人，无刑场无绞刑无人体轮廓。"
    },
    {
      "id": "S29",
      "start": 168,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
