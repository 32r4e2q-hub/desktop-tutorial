      ],
      "references": [
        "C01B",
        "C04B",
        "S06_deck",
        "S09"
      ],
      "narration": "小船靠上蒙特罗斯号，探长登船，走到毫无防备的克里平身后。",
      "narration_id": "N07",
      "prompt": "大船甲板上克里平扶栏看海，探长从身后稳步走近，海风吹动两人衣摆，晨雾缓流。中景跟随探长背影。"
    },
    {
      "id": "S25",
      "start": 144,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
      "style_variant": "real",
      "seed": 191025,
      "characters": [
        "C01B",
        "C04B"
      ],
      "references": [
        "C01B",
        "C04B",
        "S09",
        "S06_deck"
      ],
      "narration": "帽子摘下，身份揭晓。这场跨海逃亡，终于结束了。",
      "narration_id": "N07",
      "prompt": "探长在甲板克里平面前摘下制帽，克里平转身惊愕后肩膀松弛，轻叹，不呈现未经核实的历史原话。双方面部特写移焦，雾被阳光穿透。"
    },
    {
      "id": "S26",
      "start": 150,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
