      ],
      "narration": "七月三十一日清晨，探长换上引航员制服，在父亲角等候。",
      "narration_id": "N07",
      "prompt": "圣劳伦斯河口晨雾，小引航船在波浪上起伏靠近大船，探长压低制帽，扶栏站稳。低机位海面跟拍，衣角随风动。"
    },
    {
      "id": "S24",
      "start": 137,
      "duration": 7,
      "seconds": 7,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
      "style_variant": "real",
      "seed": 191024,
      "characters": [
