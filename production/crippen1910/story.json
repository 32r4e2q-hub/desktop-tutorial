      "characters": [],
      "references": [
        "S13",
        "P01"
      ],
      "narration": "可二〇〇七年的DNA研究提出：地窖里的人，可能不是科拉。",
      "narration_id": "N09",
      "prompt": "明确2007年现代生物实验室，冷白灯，研究员戴手套将封闭样本管送入仪器，无可见人体组织。屏幕两条抽象DNA曲线错开，蓝色同心电波从曲线扩散。微距跟随手部移焦。"
    },
    {
      "id": "S30",
      "start": 174,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
      "style_variant": "real",
      "seed": 191030,
      "characters": [],
      "references": [
        "S03",
        "S01"
      ],
      "narration": "结论仍有争议，未能推翻原判。科拉，究竟在哪？",
      "narration_id": "N09",
      "prompt": "煤窖砖地平整，尘埃缓流，镜头上升经过地下门和街道雾气到伦敦屋顶，逐渐淡白。金色标题由后期叠加，画内不生成文字。最后一秒静音。"
    }
