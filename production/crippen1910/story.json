      ],
      "references": [
        "C01",
        "C09",
        "S10",
        "C01_face"
      ],
      "narration": "十月，克里平在老贝利受审，陪审团开始商议判决。",
      "narration_id": "N08",
      "prompt": "木质法庭全景，克里平站被告席，法官与十二名陪审员肃穆，陪审员起身走出。此为克里平单独审判，伊瑟尔不出现在同一被告席。冷灰横向环绕。"
    },
    {
      "id": "S27",
      "start": 156,
      "duration": 6,
      "seconds": 6,
      "aspect": "16:9",
      "source_size": "720P",
      "kind": "agnes",
      "style_variant": "real",
      "seed": 191027,
      "characters": [
        "C01",
