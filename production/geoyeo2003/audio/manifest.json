  "clips": [
    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "二零零三年十二月二十九日傍晚，首尔七楼一扇防盗门从里面反锁。",
      "sha256": "4cb8fb623fa3af057bc0a6c0922825da631fae9035122106b7f2039754bfedc1",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S01",
      "target_start": 0,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.338,
      "atempo": 1.2229,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "丈夫金某下班回家敲了很久的门，屋里却连一点脚步声都没有。",
      "sha256": "a0bc5e0e3983fc5880ca4e86cd0e12707caa1cc6df3ff39c829b26cdef3efec8",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S02",
      "target_start": 6,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.631,
      "atempo": 1.0,
      "tail_silence_seconds": 0.369
    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "text": "明明妻子平时都在家带两个年幼的孩子，今天却反常地毫无回应。",
      "sha256": "6ea70f89611ea61bc8747990c40a6a6995d976e22962f083c20d95a722b82750",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S03",
      "target_start": 12,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.432,
      "atempo": 1.072,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "无奈之下，金某打电话叫来了常来家里走动的妻子高中同学李某。",
      "sha256": "0c1df51be32b2484b36739952f590f14739f4aad116e59ff0f78c51568d95bd5",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S04",
      "target_start": 18,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.525,
      "atempo": 1.0875,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "很快李某赶到门外，一边安慰金某，一边在走廊里来回张望。",
      "sha256": "5c5fdcfe2258edccd729b05c25071f3baaeff9897f2b8540c21058ebb53a3c68",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S05",
      "target_start": 24,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.793,
      "atempo": 1.0,
      "tail_silence_seconds": 0.207
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "text": "就在这时，李某突然注意到走廊一侧的小窗并没有完全锁死。",
      "sha256": "6192d03e8368577a5edac013d1ab12abbee349d281ba0f5d2aa4c528a6cb92d3",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S06",
      "target_start": 30,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.712,
      "atempo": 1.0,
      "tail_silence_seconds": 0.288
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "text": "她顺着窗缝伸手进去摸索，竟然直接掏出了妻子的随身手提包。",
      "sha256": "c1f4f2d777c213a08f9c0ee2ecc2b027379520d3b47af4b3c9856e1bfa803f38",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S07",
      "target_start": 36,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.329,
      "atempo": 1.0,
      "tail_silence_seconds": 0.671
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "text": "打开手提包，门锁钥匙果然就安静地躺在里面，让人松了口气。",
      "sha256": "50aabc8577dbfec4235bcdc877746ccf20f84e10198b6e85013ba688e4099386",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S08",
      "target_start": 42,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.014,
      "atempo": 1.0023,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S09",
      "file": "S09.mp3",
      "text": "可当房门终于被拧开的那一刻，门外两人的呼吸瞬间凝固了。",
      "sha256": "1cb27c1ab1d77f23bc61048ecf9c28f19c4248ca46cfae0c07d48da45463637a",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S09",
      "target_start": 48,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.712,
      "atempo": 1.0,
      "tail_silence_seconds": 0.288
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "text": "三十一岁的妻子朴某倒在卧室门边，三岁儿子和十个月女儿也已遇难。",
      "sha256": "012ecf7bc99033230e322e5d7ce7753dfe329d41c828237b1f3b281e36c51c9d",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S10",
      "target_start": 54,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 8.104,
      "atempo": 1.3506,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S11",
      "file": "S11.mp3",
      "text": "警方第一时间封锁七楼现场，却发现所有门窗和防盗栏都完好无损。",
      "sha256": "3bd8a9ba9789fbfc0c79697c78765f3a27c00b53bbfa6fd4ea74c141ccbdf46c",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S11",
      "target_start": 60,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.223,
      "atempo": 1.0372,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S12",
      "file": "S12.mp3",
      "text": "外部攀爬几乎不可能，厨房里甚至还留着准备做晚饭的新鲜食材。",
      "sha256": "8c6edcd957a5bb342769e8dfb87ef03eeed2ea26fc20ddd41d30fac41dabedb7",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S12",
      "target_start": 66,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.921,
      "atempo": 1.0,
      "tail_silence_seconds": 0.079
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "表面上看，这像是一起母亲带着孩子轻生的密室悲剧，几乎无懈可击。",
      "sha256": "09dd46f8613d2766b91c07bb44dbc649b6579fa7182464a05110d1a9ba276687",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S13",
      "target_start": 72,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.036,
      "atempo": 1.1726,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S14",
      "file": "S14.mp3",
      "text": "但负责现场的刑警越看越不对劲，因为屋里根本找不到任何遗书。",
      "sha256": "1826abfebfd631200da5c7f9f33b0c7adc563cfc19fb05383268410d7b4253c6",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S14",
      "target_start": 78,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 5.41,
      "atempo": 1.0,
      "tail_silence_seconds": 0.59
    },
    {
      "id": "S15",
      "file": "S15.mp3",
      "text": "而且朴某性格开朗，生前没有任何抑郁症或轻生倾向，线索断了。",
      "sha256": "6aa7e0ae2d1086e3090c41dd9329a1b801a7ce0ccba3fc1786a601ee77e38974",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S15",
      "target_start": 84,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.525,
      "atempo": 1.0875,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "更反常的是，法医在朴某紧握的手心里，发现了一张来源不明的小纸片。",
      "sha256": "9bf97d935290cc5d25d516615acdf321c32338c0a884642781fe9055b3c95c31",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S16",
      "target_start": 90,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.117,
      "atempo": 1.1862,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "两个年幼的孩子身上也留有异常压迫伤痕，绝不是轻生该有的样子。",
      "sha256": "0327a49a101841ed4d816a64c078d785666b9b9ac83935ac7810a01d3ebccf72",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S17",
      "target_start": 96,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.908,
      "atempo": 1.1513,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "警方立刻推翻自杀判断，把侦查方向锁定在熟人作案的密室谋杀上。",
      "sha256": "2b59aa215cf2503abbfbe734792cd13c8f7b6a163e051102040c31f7211ad590",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S18",
      "target_start": 102,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.419,
      "atempo": 1.2365,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "所有近期进出过这间公寓的熟人被逐一传唤，高中同学李某也在其中。",
      "sha256": "c72787c44ea8267534bc60ea0d6c728089eeac0759bf60a3ebd1e2fd2278670d",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S19",
      "target_start": 108,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.628,
      "atempo": 1.2713,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "坐在刑警面前时，李某神情镇定，却总是不自觉地把右手藏在袖口里。",
      "sha256": "19626388d9f9e48e403fa568983ab907095a38ec6bc0d809dfbf86000aef2bab",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S20",
      "target_start": 114,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.419,
      "atempo": 1.2365,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S21",
      "file": "S21.mp3",
      "text": "经验老到的刑警一眼盯住了她手背上那道像被细绳勒出来的伤痕。",
      "sha256": "c7816ff3764a0ade29e84637855c65d39e316188f6eb4f6379faad4743c26bb3",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S21",
      "target_start": 120,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.095,
      "atempo": 1.0159,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "警方随即搜查了李某的住处，果然在屋里翻出了被切开的塑料瓶。",
      "sha256": "35f8aaf688f21a100f4ef5f317abac0aa15b6ca7636e325655edd246d0529972",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S22",
      "target_start": 126,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.014,
      "atempo": 1.0023,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "原来她作案时用塑料瓶垫在门框上防留痕，又贴了纸片方便事后撕掉。",
      "sha256": "d0408e9dbb3ae5463e4fa34de59ea2642c1d837dc6369a97190bc97ae9053b78",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S23",
      "target_start": 132,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.036,
      "atempo": 1.1726,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S24",
      "file": "S24.mp3",
      "text": "可她万万没想到，那片不起眼的小纸片最终粘在了朴某的手心里。",
      "sha256": "c33b3a88d2f6ea8f3370c2ca676683e17cc20e2c718b2069307445d55a921491",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S24",
      "target_start": 138,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.4,
      "atempo": 1.0667,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S25",
      "file": "S25.mp3",
      "text": "面对铁证，李某终于交代自己因嫉妒朴某婚姻美满，还与金某有染而动了杀机。",
      "sha256": "5dbbc8a3e4ec04ab9791d8ee40514eff73f89cf31426b8599200b6dd2bd8b4b6",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S25",
      "target_start": 144,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.419,
      "atempo": 1.2365,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "她先在屋里制造出母子轻生的假象，最后用钥匙从外面反锁了防盗门。",
      "sha256": "40d01b9e1241e0c964b3e3b0f545b7efdb1ed61af749f22478193609771c6c86",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S26",
      "target_start": 150,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 6.827,
      "atempo": 1.1378,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "随后她把装钥匙的手提包顺着走廊窗缝扔回小房间，完成了整场密室骗局。",
      "sha256": "aeeefaba93d91d9bcd35b3f1fd7bec6a665af21e99641066927e73405a6e34f1",
      "voice_id": "voice-02",
      "voice_description": "悬疑纪录片向低沉普通话男声，克制压抑（第二十一期主创试听选定，沿用至第二十二期）",
      "narration_id": "S27",
      "target_start": 156,
      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 7.628,
      "atempo": 1.2713,
      "tail_silence_seconds": 0.0
    },
    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "这起震惊韩国的巨余洞密室案，最终以李某被判处无期徒刑画上句号。",
