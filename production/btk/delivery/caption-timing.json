[
  {
    "start": 0.6315925851972701,
    "end": 1.8531725461583837,
    "text": "一个教会领袖，"
  },
  {
    "start": 1.8531725461583837,
    "end": 4.370048500207575,
    "text": "亲手把自己的名字塞进证据里。"
  },
  {
    "start": 4.370048500207575,
    "end": 5.696937078492922,
    "text": "二零零五年，"
  },
  {
    "start": 5.696937078492922,
    "end": 9.656541089884117,
    "text": "BTK杀手寄给电视台一张三点五英寸软盘，"
  },
  {
    "start": 9.656541089884117,
    "end": 10.835997603915537,
    "text": "还先问警察："
  },
  {
    "start": 10.835997603915537,
    "end": 12.857923056540828,
    "text": "这东西能追到寄件人吗？"
  },
  {
    "start": 12.857923056540828,
    "end": 14.584984380658263,
    "text": "他等来的不是答案，"
  },
  {
    "start": 14.584984380658263,
    "end": 16.01718157626785,
    "text": "是九天后的手铐。"
  },
  {
    "start": 16.01718157626785,
    "end": 16.92283568525626,
    "text": "更离谱的是，"
  },
  {
    "start": 16.92283568525626,
    "end": 18.323440295668572,
    "text": "出卖他的线索，"
  },
  {
    "start": 18.323440295668572,
    "end": 21.514291400592857,
    "text": "藏在他以为已经删掉的文件信息里。"
  },
  {
    "start": 21.514291400592857,
    "end": 22.388352924384,
    "text": "BTK案，"
  },
  {
    "start": 22.388352924384,
    "end": 24.63142647339018,
    "text": "今天从这张软盘讲起。"
  },
  {
    "start": 25.73248819685503,
    "end": 27.238401424591576,
    "text": "他叫丹尼斯·雷德，"
  },
  {
    "start": 27.238401424591576,
    "end": 29.713153931711073,
    "text": "住在堪萨斯州威奇托附近，"
  },
  {
    "start": 29.713153931711073,
    "end": 31.061104233461265,
    "text": "有妻子和孩子。"
  },
  {
    "start": 31.061104233461265,
    "end": 33.03037537742444,
    "text": "教会会众委员会主席、"
  },
  {
    "start": 33.03037537742444,
    "end": 34.06239982720193,
    "text": "童子军领队、"
  },
  {
    "start": 34.06239982720193,
    "end": 38.358991414030676,
    "text": "帕克城法规执行员——邻居看到的是一个讲规矩、"
  },
  {
    "start": 38.358991414030676,
    "end": 39.28570724648394,
    "text": "管社区的人。"
  },
  {
    "start": 39.28570724648394,
    "end": 42.192225084632796,
    "text": "可一九七四年至一九九一年间，"
  },
  {
    "start": 42.192225084632796,
    "end": 44.972372581992566,
    "text": "威奇托地区有十人遭他杀害，"
  },
  {
    "start": 44.972372581992566,
    "end": 47.36287819525268,
    "text": "其中包括奥特罗一家四口。"
  },
  {
    "start": 47.36287819525268,
    "end": 49.59542088252644,
    "text": "整齐的日常与连环暴行，"
  },
  {
    "start": 49.59542088252644,
    "end": 51.941236151309575,
    "text": "竟装在同一个人身上。"
  },
  {
    "start": 53.07389045997169,
    "end": 55.51705038189392,
    "text": "BTK不是警方起的名字，"
  },
  {
    "start": 55.51705038189392,
    "end": 57.78118565436495,
    "text": "而是雷德自己取的缩写："
  },
  {
    "start": 57.78118565436495,
    "end": 58.676308901620935,
    "text": "Bind，"
  },
  {
    "start": 58.676308901620935,
    "end": 59.118605094382715,
    "text": "捆绑；"
  },
  {
    "start": 59.118605094382715,
    "end": 60.61398746038684,
    "text": "Torture，"
  },
  {
    "start": 60.61398746038684,
    "end": 61.14053054700801,
    "text": "折磨；"
  },
  {
    "start": 61.14053054700801,
    "end": 62.09883896465854,
    "text": "Kill，"
  },
  {
    "start": 62.09883896465854,
    "end": 62.50954257222305,
    "text": "杀害。"
  },
  {
    "start": 62.50954257222305,
    "end": 64.04704838515687,
    "text": "案件细节很残酷，"
  },
  {
    "start": 64.04704838515687,
    "end": 65.01588766453982,
    "text": "我们不复现。"
  },
  {
    "start": 65.01588766453982,
    "end": 66.46914658361425,
    "text": "警方后来确认，"
  },
  {
    "start": 66.46914658361425,
    "end": 68.31204738678834,
    "text": "他会预先挑选目标、"
  },
  {
    "start": 68.31204738678834,
    "end": 68.64903496222588,
    "text": "踩点，"
  },
  {
    "start": 68.64903496222588,
    "end": 70.67096041485118,
    "text": "趁人独自在家时下手；"
  },
  {
    "start": 70.67096041485118,
    "end": 73.38792274181641,
    "text": "作案后还留下信件和线索，"
  },
  {
    "start": 73.38792274181641,
    "end": 73.94605841363486,
    "text": "向媒体、"
  },
  {
    "start": 73.94605841363486,
    "end": 74.820119937426,
    "text": "警方炫耀。"
  },
  {
    "start": 74.820119937426,
    "end": 76.84204539005128,
    "text": "案件始于一九七四年，"
  },
  {
    "start": 76.84204539005128,
    "end": 80.43306924080767,
    "text": "最后一起已知命案发生在一九九一年。"
  },
  {
    "start": 80.43306924080767,
    "end": 80.97014318916126,
    "text": "然后，"
  },
  {
    "start": 80.97014318916126,
    "end": 81.99163677720632,
    "text": "他突然沉默，"
  },
  {
    "start": 81.99163677720632,
    "end": 84.36843033091901,
    "text": "调查也陷入漫长冷案。"
  },
  {
    "start": 85.48002291611628,
    "end": 86.24877582258318,
    "text": "十三年后，"
  },
  {
    "start": 86.24877582258318,
    "end": 88.6392814358433,
    "text": "他在二零零四年重新写信挑衅，"
  },
  {
    "start": 88.6392814358433,
    "end": 90.31368845129862,
    "text": "想让人们记起BTK。"
  },
  {
    "start": 90.31368845129862,
    "end": 91.2088116985546,
    "text": "他向警方问："
  },
  {
    "start": 91.2088116985546,
    "end": 92.5567620003048,
    "text": "把文件放进软盘，"
  },
  {
    "start": 92.5567620003048,
    "end": 94.21010729229528,
    "text": "能查到是哪台电脑吗？"
  },
  {
    "start": 94.21010729229528,
    "end": 96.81123014020385,
    "text": "警方通过报纸广告给了他模糊保证。"
  },
  {
    "start": 96.81123014020385,
    "end": 98.20130388888374,
    "text": "二零零五年二月，"
  },
  {
    "start": 98.20130388888374,
    "end": 100.93932793931381,
    "text": "他把软盘寄到威奇托一家电视台。"
  },
  {
    "start": 100.93932793931381,
    "end": 103.34036441430635,
    "text": "取证人员恢复被删的Word文件，"
  },
  {
    "start": 103.34036441430635,
    "end": 105.27804297307226,
    "text": "元数据里出现两条线索："
  },
  {
    "start": 105.27804297307226,
    "end": 109.0796840584771,
    "text": "Christ Lutheran Church，"
  },
  {
    "start": 109.0796840584771,
    "end": 110.92258486165119,
    "text": "和修改者Dennis。"
  },
  {
    "start": 110.92258486165119,
    "end": 112.76548566482529,
    "text": "教会网页上的一个名字，"
  },
  {
    "start": 112.76548566482529,
    "end": 115.52068818345639,
    "text": "让冷案第一次有了明确嫌疑人。"
  },
  {
    "start": 116.62174990692124,
    "end": 118.33828036930625,
    "text": "但软盘指向嫌疑人，"
  },
  {
    "start": 118.33828036930625,
    "end": 119.71782325625371,
    "text": "不等于足以定罪。"
  },
  {
    "start": 119.71782325625371,
    "end": 121.80293387927354,
    "text": "调查员继续找独立证据："
  },
  {
    "start": 121.80293387927354,
    "end": 126.47863648846953,
    "text": "警方依法调取雷德女儿在大学诊所留下的医学样本，"
  },
  {
    "start": 126.47863648846953,
    "end": 127.84764851368456,
    "text": "进行亲缘比对。"
  },
  {
    "start": 127.84764851368456,
    "end": 128.5742779732218,
    "text": "结果显示，"
  },
  {
    "start": 128.5742779732218,
    "end": 131.57557356696245,
    "text": "案发现场DNA与她有亲缘关联，"
  },
  {
    "start": 131.57557356696245,
    "end": 132.91299300698023,
    "text": "指向她的父亲。"
  },
  {
    "start": 132.91299300698023,
    "end": 133.33422747627716,
    "text": "注意，"
  },
  {
    "start": 133.33422747627716,
    "end": 136.3355230700178,
    "text": "这不是女儿样本与凶手“完美匹配”，"
  },
  {
    "start": 136.3355230700178,
    "end": 138.27320162878374,
    "text": "而是帮助警方锁定雷德。"
  },
  {
    "start": 138.27320162878374,
    "end": 139.69486796266088,
    "text": "二月二十五日，"
  },
  {
    "start": 139.69486796266088,
    "end": 141.03228740267866,
    "text": "丹尼斯·雷德被捕。"
  },
  {
    "start": 141.03228740267866,
    "end": 142.83306475892306,
    "text": "数字取证给出名字，"
  },
  {
    "start": 142.83306475892306,
    "end": 145.09193460052788,
    "text": "DNA提供关键支撑。"
  },
  {
    "start": 146.2351197709224,
    "end": 146.9933418156569,
    "text": "六月，"
  },
  {
    "start": 146.9933418156569,
    "end": 152.47992077824946,
    "text": "雷德在法庭上承认十项一级谋杀罪，"
  },
  {
    "start": 152.59576025730613,
    "end": 153.63831556881604,
    "text": "并平静、"
  },
  {
    "start": 153.7541550478727,
    "end": 156.2289075549922,
    "text": "细节化地陈述案情；"
  },
  {
    "start": 156.30262358711917,
    "end": 158.387734210139,
    "text": "同年八月，"
  },
  {
    "start": 158.49304282746323,
    "end": 160.0094869169322,
    "text": "法院判处十个连续终身监禁，"
  },
  {
    "start": 160.02001777866462,
    "end": 161.43115325080936,
    "text": "最低服刑一百七十五年。"
  },
  {
    "start": 161.46274583600663,
    "end": 162.39999253019232,
    "text": "答案不是天才警探瞬间破案："
  },
  {
    "start": 162.42105425365716,
    "end": 163.08449854279982,
    "text": "数十年证物、"
  },
  {
    "start": 163.08449854279982,
    "end": 164.8747450373118,
    "text": "数字取证和DNA，"
  },
  {
    "start": 164.93793020770636,
    "end": 167.60223822600946,
    "text": "最后被他对关注的渴望串在一起。"
  },
  {
    "start": 167.71807770506612,
    "end": 169.33983041185934,
    "text": "你觉得最致命的，"
  },
  {
    "start": 169.4135464439863,
    "end": 170.83521277786343,
    "text": "是软盘元数据，"
  },
  {
    "start": 170.9510522569201,
    "end": 172.7518296131645,
    "text": "还是他停不下来的炫耀？"
  },
  {
    "start": 172.81501478355904,
    "end": 174.0,
    "text": "评论区说说。"
  }
]