[
  {
    "start": 0.6,
    "end": 1.5843906307176103,
    "text": "一个教会领袖，"
  },
  {
    "start": 1.5843906307176103,
    "end": 3.9649644407642817,
    "text": "亲手把自己的名字塞进证据里。"
  },
  {
    "start": 4.068184208885886,
    "end": 5.162313750974884,
    "text": "二零零五年，"
  },
  {
    "start": 5.162313750974884,
    "end": 8.754361681606696,
    "text": "BTK杀手寄给电视台一张三点五英寸软盘，"
  },
  {
    "start": 8.867903426540458,
    "end": 9.99299889906594,
    "text": "还先问警察："
  },
  {
    "start": 9.99299889906594,
    "end": 11.809666818006166,
    "text": "这东西能追到寄件人吗？"
  },
  {
    "start": 11.850954725254807,
    "end": 13.554080899261269,
    "text": "他等来的不是答案，"
  },
  {
    "start": 13.646978690570712,
    "end": 15.28817300370421,
    "text": "是九天后的手铐。"
  },
  {
    "start": 15.28817300370421,
    "end": 16.423590453041854,
    "text": "更离谱的是，"
  },
  {
    "start": 16.506166267539136,
    "end": 17.786091392247023,
    "text": "出卖他的线索，"
  },
  {
    "start": 17.848023253119987,
    "end": 20.676244899651927,
    "text": "藏在他以为已经删掉的文件信息里。"
  },
  {
    "start": 20.78978664458569,
    "end": 21.83230630261389,
    "text": "BTK案，"
  },
  {
    "start": 21.935526070735495,
    "end": 23.999921433167568,
    "text": "今天从这张软盘讲起。"
  },
  {
    "start": 25.07992143316757,
    "end": 26.669505862240268,
    "text": "他叫丹尼斯·雷德，"
  },
  {
    "start": 26.79336958398619,
    "end": 29.353219833401965,
    "text": "住在堪萨斯州威奇托附近，"
  },
  {
    "start": 29.45643960152357,
    "end": 30.86022844797738,
    "text": "有妻子和孩子。"
  },
  {
    "start": 30.86022844797738,
    "end": 32.934945787221615,
    "text": "教会会众委员会主席、"
  },
  {
    "start": 32.98655567128242,
    "end": 34.25615881917814,
    "text": "童子军领队、"
  },
  {
    "start": 34.30776870323894,
    "end": 36.12443662217917,
    "text": "帕克城法规执行员——"
  },
  {
    "start": 36.22765639030077,
    "end": 38.60171105709766,
    "text": "邻居看到的是一个讲规矩、"
  },
  {
    "start": 38.60171105709766,
    "end": 39.75777246005962,
    "text": "管社区的人。"
  },
  {
    "start": 39.75777246005962,
    "end": 42.72017980514965,
    "text": "可一九七四年至一九九一年间，"
  },
  {
    "start": 42.83372155008341,
    "end": 45.4142157531235,
    "text": "威奇托地区有十人遭他杀害，"
  },
  {
    "start": 45.517435521245105,
    "end": 47.705694605423105,
    "text": "其中包括奥特罗一家四口。"
  },
  {
    "start": 47.819236350356874,
    "end": 49.893953689601105,
    "text": "整齐的日常与连环暴行，"
  },
  {
    "start": 49.893953689601105,
    "end": 51.54039500761412,
    "text": "竟装在同一个人身上。"
  },
  {
    "start": 52.68232686848708,
    "end": 54.984127697598844,
    "text": "BTK不是警方起的名字，"
  },
  {
    "start": 55.08734746572045,
    "end": 56.88337143103635,
    "text": "而是雷德自己取的缩写："
  },
  {
    "start": 56.99691317597012,
    "end": 57.574943877451105,
    "text": "Bind，"
  },
  {
    "start": 57.68848562238487,
    "end": 58.42134597604825,
    "text": "捆绑；"
  },
  {
    "start": 58.462633883296895,
    "end": 59.17485028333596,
    "text": "Torture，"
  },
  {
    "start": 59.22646016739676,
    "end": 59.93867656743583,
    "text": "折磨；"
  },
  {
    "start": 59.93867656743583,
    "end": 60.516707268916804,
    "text": "Kill，"
  },
  {
    "start": 60.568317152977606,
    "end": 61.280533553016674,
    "text": "杀害。"
  },
  {
    "start": 61.38375332113828,
    "end": 62.97333775021097,
    "text": "案件细节很残酷，"
  },
  {
    "start": 63.08687949514474,
    "end": 64.15004310679726,
    "text": "我们不复现。"
  },
  {
    "start": 64.26358485173103,
    "end": 65.58479788368754,
    "text": "警方后来确认，"
  },
  {
    "start": 65.61576381412404,
    "end": 67.55629545481018,
    "text": "他会预先挑选目标、"
  },
  {
    "start": 67.58726138524666,
    "end": 69.44521721143553,
    "text": "踩点，"
  },
  {
    "start": 69.55875895636929,
    "end": 71.0249284452966,
    "text": "趁人独自在家时下手；"
  },
  {
    "start": 71.0249284452966,
    "end": 72.81691337620774,
    "text": "作案后还留下信件和线索，"
  },
  {
    "start": 72.81691337620774,
    "end": 73.55336398267536,
    "text": "向媒体、"
  },
  {
    "start": 73.66690572760912,
    "end": 74.24906521981497,
    "text": "警方炫耀。"
  },
  {
    "start": 74.24906521981497,
    "end": 76.81510865531804,
    "text": "最后一起已知命案发生在一九九一年。"
  },
  {
    "start": 76.81510865531804,
    "end": 77.53764703216926,
    "text": "然后，"
  },
  {
    "start": 77.58925691623007,
    "end": 78.75564029600419,
    "text": "他突然沉默，"
  },
  {
    "start": 78.82789413368931,
    "end": 81.03574346969205,
    "text": "调查也陷入漫长冷案。"
  },
  {
    "start": 82.11574346969206,
    "end": 83.40599057121212,
    "text": "沉默十三年后，"
  },
  {
    "start": 83.61243010745531,
    "end": 84.64462778867136,
    "text": "二零零四年，"
  },
  {
    "start": 84.68591569592,
    "end": 85.8832650061306,
    "text": "他重新写信，"
  },
  {
    "start": 85.9864847742522,
    "end": 86.93610664097096,
    "text": "频繁挑衅，"
  },
  {
    "start": 87.1838340844628,
    "end": 89.08307781790032,
    "text": "想让全世界记起BTK。"
  },
  {
    "start": 89.18629758602192,
    "end": 90.38364689623252,
    "text": "他向警方问："
  },
  {
    "start": 90.46622271072981,
    "end": 92.01451923255387,
    "text": "把文件放进软盘，"
  },
  {
    "start": 92.28289062967004,
    "end": 93.91376296599137,
    "text": "能查到是哪台电脑吗？"
  },
  {
    "start": 93.97569482686433,
    "end": 96.98971205601516,
    "text": "警方通过报纸广告给了他模糊保证。"
  },
  {
    "start": 96.98971205601516,
    "end": 98.33156904159601,
    "text": "二零零五年二月，"
  },
  {
    "start": 98.47607671696625,
    "end": 101.11850278087931,
    "text": "他把软盘寄到威奇托一家电视台。"
  },
  {
    "start": 101.2010785953766,
    "end": 103.84350465928965,
    "text": "取证人员恢复被删的Word文件，"
  },
  {
    "start": 103.9880123346599,
    "end": 106.11433955796494,
    "text": "元数据里出现两条线索："
  },
  {
    "start": 106.30013514058382,
    "end": 107.72456794066196,
    "text": "Christ Lutheran Church，"
  },
  {
    "start": 107.72456794066196,
    "end": 109.33479632335897,
    "text": "和修改者Dennis。"
  },
  {
    "start": 109.45866004510489,
    "end": 111.06888842780191,
    "text": "教会网页上的一个名字，"
  },
  {
    "start": 111.19275214954783,
    "end": 113.56680681634472,
    "text": "让冷案第一次有了明确嫌疑人。"
  },
  {
    "start": 114.7522200045389,
    "end": 116.48631210898185,
    "text": "但软盘指向嫌疑人，"
  },
  {
    "start": 116.48631210898185,
    "end": 117.84881304818701,
    "text": "不等于足以定罪。"
  },
  {
    "start": 117.96235479312078,
    "end": 119.98546224830422,
    "text": "调查员继续找独立证据："
  },
  {
    "start": 120.08868201642582,
    "end": 124.03425765287412,
    "text": "他们依法申请调取雷德女儿在大学诊所留下的医学"
  },
  {
    "start": 124.03425765287412,
    "end": 124.64067379058855,
    "text": "样本，"
  },
  {
    "start": 124.74389355871014,
    "end": 126.47798566315309,
    "text": "进行亲缘关系比对。"
  },
  {
    "start": 126.5812054312747,
    "end": 127.27183951616107,
    "text": "结果显示，"
  },
  {
    "start": 127.27183951616107,
    "end": 130.62742034164157,
    "text": "案发现场保存的DNA与她存在亲缘关联，"
  },
  {
    "start": 130.73064010976316,
    "end": 132.34086849246017,
    "text": "线索指向她的父亲。"
  },
  {
    "start": 132.40280035333313,
    "end": 133.81691117659912,
    "text": "这只是亲缘线索，"
  },
  {
    "start": 133.85819908384775,
    "end": 135.1174802549313,
    "text": "并非直接匹配，"
  },
  {
    "start": 135.18973409261645,
    "end": 136.8206064289378,
    "text": "却让警方锁定雷德。"
  },
  {
    "start": 136.92382619705938,
    "end": 138.03859969277272,
    "text": "二月二十五日，"
  },
  {
    "start": 138.03859969277272,
    "end": 139.70043795953052,
    "text": "丹尼斯·雷德被捕。"
  },
  {
    "start": 139.8139797044643,
    "end": 141.51710587847074,
    "text": "数字取证给出名字，"
  },
  {
    "start": 141.56871576253155,
    "end": 143.7676193852971,
    "text": "DNA提供关键支撑。"
  },
  {
    "start": 144.87858531573357,
    "end": 145.549513808524,
    "text": "六月，"
  },
  {
    "start": 145.62176764620912,
    "end": 148.4912771999897,
    "text": "雷德在法庭上承认十项一级谋杀罪，"
  },
  {
    "start": 148.59449696811132,
    "end": 149.15188371596798,
    "text": "并平静、"
  },
  {
    "start": 149.15188371596798,
    "end": 150.88597582041092,
    "text": "细节化地陈述案情；"
  },
  {
    "start": 150.97887361172036,
    "end": 151.94913943206342,
    "text": "同年八月，"
  },
  {
    "start": 151.94913943206342,
    "end": 154.58124351916433,
    "text": "法院判处十个连续终身监禁，"
  },
  {
    "start": 154.70510724091025,
    "end": 156.5940289975356,
    "text": "最低服刑一百七十五年。"
  },
  {
    "start": 156.66628283522073,
    "end": 159.453216574504,
    "text": "答案不是某个天才警探瞬间破案："
  },
  {
    "start": 159.52547041218915,
    "end": 161.50728996012393,
    "text": "是数十年积累的证物、"
  },
  {
    "start": 161.55889984418474,
    "end": 162.98333264426287,
    "text": "一次数字取证，"
  },
  {
    "start": 162.98333264426287,
    "end": 164.5832390501477,
    "text": "再加DNA验证，"
  },
  {
    "start": 164.67613684145718,
    "end": 167.9275595372877,
    "text": "最后被他自己对关注的渴望串在一起。"
  },
  {
    "start": 168.02045732859713,
    "end": 169.5377879199847,
    "text": "你觉得最致命的，"
  },
  {
    "start": 169.65132966491848,
    "end": 171.07576246499661,
    "text": "是软盘元数据，"
  },
  {
    "start": 171.1789822331182,
    "end": 172.94404026799762,
    "text": "还是他停不下来的炫耀？"
  },
  {
    "start": 173.0266160824949,
    "end": 174.0,
    "text": "评论区说说。"
  }
]