[
  {
    "start": 0.6,
    "end": 3.1469762291271994,
    "text": "他寄出一张三点五英寸软盘前，"
  },
  {
    "start": 3.3738324114786105,
    "end": 4.1987639836655575,
    "text": "先问警方："
  },
  {
    "start": 4.3225037194936,
    "end": 5.931120285258147,
    "text": "能追到是哪台电脑吗？"
  },
  {
    "start": 6.0548600210861885,
    "end": 7.91095605850682,
    "text": "警方在报纸广告里暗示："
  },
  {
    "start": 7.972825926420842,
    "end": 8.6327711841704,
    "text": "没问题。"
  },
  {
    "start": 8.880250655826483,
    "end": 9.705182228013431,
    "text": "九天后，"
  },
  {
    "start": 9.705182228013431,
    "end": 11.891250894308842,
    "text": "教会领袖丹尼斯·雷德被捕。"
  },
  {
    "start": 11.932497472918188,
    "end": 12.633689309277093,
    "text": "原来，"
  },
  {
    "start": 12.778052334409809,
    "end": 13.706100353120126,
    "text": "删掉文件，"
  },
  {
    "start": 13.871086667557515,
    "end": 16.26338822689966,
    "text": "不等于删掉它留下的元数据。"
  },
  {
    "start": 16.325258094813684,
    "end": 17.68639518892215,
    "text": "这就是BTK案："
  },
  {
    "start": 17.748265056836168,
    "end": 19.459998069124083,
    "text": "一个渴望关注的杀手，"
  },
  {
    "start": 19.6043610942568,
    "end": 21.769806471247534,
    "text": "怎样被自己寄出的软盘出卖？"
  },
  {
    "start": 22.96585543877238,
    "end": 24.729146674321978,
    "text": "他叫丹尼斯·雷德，"
  },
  {
    "start": 24.801328186888338,
    "end": 27.286434548101518,
    "text": "住在堪萨斯州威奇托附近，"
  },
  {
    "start": 27.389550994624884,
    "end": 28.668194931514652,
    "text": "有妻子和孩子。"
  },
  {
    "start": 28.71975315477634,
    "end": 30.8645752424624,
    "text": "教会会众委员会主席、"
  },
  {
    "start": 30.916133465724084,
    "end": 32.12259589004749,
    "text": "童子军领队、"
  },
  {
    "start": 32.153530824004505,
    "end": 36.44317499937663,
    "text": "帕克城法规执行员——邻居看到的是一个讲规矩、"
  },
  {
    "start": 36.48442157798598,
    "end": 37.608390845090696,
    "text": "管社区的人。"
  },
  {
    "start": 37.680572357657056,
    "end": 40.165678718870225,
    "text": "可一九七四年至一九九一年间，"
  },
  {
    "start": 40.2687951653936,
    "end": 42.72296659264977,
    "text": "威奇托地区有十人遭他杀害，"
  },
  {
    "start": 42.82608303917314,
    "end": 44.847165391031155,
    "text": "其中包括奥特罗一家四口。"
  },
  {
    "start": 44.95028183755453,
    "end": 47.105415569892926,
    "text": "整齐的日常与连环暴行，"
  },
  {
    "start": 47.177597082459286,
    "end": 48.87676277782717,
    "text": "竟装在同一个人身上。"
  },
  {
    "start": 50.00832100108885,
    "end": 52.400622560430996,
    "text": "BTK不是警方起的名字，"
  },
  {
    "start": 52.400622560430996,
    "end": 54.57637958207407,
    "text": "而是雷德自己取的缩写："
  },
  {
    "start": 54.57637958207407,
    "end": 55.44255773287036,
    "text": "Bind，"
  },
  {
    "start": 55.44255773287036,
    "end": 55.87564680826851,
    "text": "捆绑；"
  },
  {
    "start": 55.87564680826851,
    "end": 57.40177021681436,
    "text": "Torture，"
  },
  {
    "start": 57.40177021681436,
    "end": 57.83485929221251,
    "text": "折磨；"
  },
  {
    "start": 57.83485929221251,
    "end": 58.70103744300881,
    "text": "Kill，"
  },
  {
    "start": 58.70103744300881,
    "end": 59.14443816305929,
    "text": "杀害。"
  },
  {
    "start": 59.14443816305929,
    "end": 60.66024992695281,
    "text": "案件细节很残酷，"
  },
  {
    "start": 60.66024992695281,
    "end": 61.753284260100514,
    "text": "我们不复现。"
  },
  {
    "start": 61.753284260100514,
    "end": 63.05255148629495,
    "text": "警方后来确认，"
  },
  {
    "start": 63.05255148629495,
    "end": 64.79521943253988,
    "text": "他会预先挑选目标、"
  },
  {
    "start": 64.79521943253988,
    "end": 65.22830850793802,
    "text": "踩点，"
  },
  {
    "start": 65.22830850793802,
    "end": 67.18752099188202,
    "text": "趁人独自在家时下手；"
  },
  {
    "start": 67.18752099188202,
    "end": 69.57982255122417,
    "text": "作案后还留下信件和线索，"
  },
  {
    "start": 69.57982255122417,
    "end": 70.22945616432139,
    "text": "向媒体、"
  },
  {
    "start": 70.22945616432139,
    "end": 71.09563431511769,
    "text": "警方炫耀。"
  },
  {
    "start": 71.09563431511769,
    "end": 73.05484679906169,
    "text": "案件始于一九七四年，"
  },
  {
    "start": 73.05484679906169,
    "end": 76.5298710468992,
    "text": "最后一起已知命案发生在一九九一年。"
  },
  {
    "start": 76.5298710468992,
    "end": 76.9732717669497,
    "text": "然后，"
  },
  {
    "start": 76.9732717669497,
    "end": 78.05599445544506,
    "text": "他突然沉默，"
  },
  {
    "start": 78.05599445544506,
    "end": 80.10532641713188,
    "text": "调查也陷入漫长冷案。"
  },
  {
    "start": 81.18532641713188,
    "end": 82.21649088236556,
    "text": "沉默十三年后，"
  },
  {
    "start": 82.21649088236556,
    "end": 84.42318283796564,
    "text": "雷德在二零零四年重写挑衅信，"
  },
  {
    "start": 84.42318283796564,
    "end": 86.07304598233954,
    "text": "想让世界记起BTK。"
  },
  {
    "start": 86.07304598233954,
    "end": 86.89797755452649,
    "text": "他又问警方："
  },
  {
    "start": 86.89797755452649,
    "end": 88.98092977429853,
    "text": "软盘能追到哪台电脑？"
  },
  {
    "start": 88.98092977429853,
    "end": 90.52767647214905,
    "text": "报纸广告模糊暗示："
  },
  {
    "start": 90.52767647214905,
    "end": 91.02263541546122,
    "text": "没问题。"
  },
  {
    "start": 91.02263541546122,
    "end": 92.44564237748371,
    "text": "二零零五年二月，"
  },
  {
    "start": 92.44564237748371,
    "end": 94.8791905154352,
    "text": "他把软盘寄到威奇托电视台。"
  },
  {
    "start": 94.8791905154352,
    "end": 97.3127386533867,
    "text": "调查员恢复出被删Word文件。"
  },
  {
    "start": 97.3127386533867,
    "end": 100.34436218117372,
    "text": "Metadata（元数据）就是记录作者、"
  },
  {
    "start": 100.34436218117372,
    "end": 101.95297874693827,
    "text": "设备等信息的文件属性；"
  },
  {
    "start": 101.95297874693827,
    "end": 102.65417058329717,
    "text": "正文删了，"
  },
  {
    "start": 102.65417058329717,
    "end": 103.60284189131217,
    "text": "属性未必消失。"
  },
  {
    "start": 103.60284189131217,
    "end": 107.52126685920017,
    "text": "残留线索出现Christ Lutheran "
  },
  {
    "start": 107.52126685920017,
    "end": 110.51164380837785,
    "text": "Church与修改者Dennis。"
  },
  {
    "start": 110.51164380837785,
    "end": 112.05839050622838,
    "text": "教会网页上的名字，"
  },
  {
    "start": 112.05839050622838,
    "end": 113.24493856681696,
    "text": "让警方锁定雷德。"
  },
  {
    "start": 114.32493856681697,
    "end": 116.02635993445254,
    "text": "但软盘指向嫌疑人，"
  },
  {
    "start": 116.06760651306189,
    "end": 117.38749702856101,
    "text": "不等于足以定罪。"
  },
  {
    "start": 117.51123676438905,
    "end": 119.44982595902837,
    "text": "调查员继续找独立证据："
  },
  {
    "start": 119.5941889841611,
    "end": 123.47136737343975,
    "text": "他们依法申请调取雷德女儿在大学诊所留下的医学"
  },
  {
    "start": 123.47136737343975,
    "end": 123.86320987022854,
    "text": "样本，"
  },
  {
    "start": 123.98694960605658,
    "end": 125.59556617182113,
    "text": "进行亲缘关系比对。"
  },
  {
    "start": 125.7811757755632,
    "end": 126.66797721566417,
    "text": "结果显示，"
  },
  {
    "start": 126.7917169514922,
    "end": 130.38016929050542,
    "text": "案发现场保存的DNA与她存在亲缘关联，"
  },
  {
    "start": 130.58640218355217,
    "end": 132.050655724184,
    "text": "线索指向她的父亲。"
  },
  {
    "start": 132.1331488814027,
    "end": 132.68997769262887,
    "text": "注意，"
  },
  {
    "start": 132.77247084984756,
    "end": 135.3503820129318,
    "text": "这不是女儿的样本直接“匹配成凶手”，"
  },
  {
    "start": 135.61848477389253,
    "end": 137.3714643647898,
    "text": "而是帮助警方锁定雷德。"
  },
  {
    "start": 137.5364506792272,
    "end": 138.7119781695936,
    "text": "二月二十五日，"
  },
  {
    "start": 138.89758777333566,
    "end": 140.34121802466282,
    "text": "丹尼斯·雷德被捕。"
  },
  {
    "start": 140.3618413139675,
    "end": 142.11482090486476,
    "text": "数字取证给出名字，"
  },
  {
    "start": 142.11482090486476,
    "end": 143.92967036367602,
    "text": "DNA提供关键支撑。"
  },
  {
    "start": 145.1762678725904,
    "end": 145.62998023729318,
    "text": "六月，"
  },
  {
    "start": 145.7949665517306,
    "end": 148.78534350090825,
    "text": "雷德在法庭上承认十项一级谋杀罪，"
  },
  {
    "start": 148.86783665812698,
    "end": 149.50715862657185,
    "text": "并平静、"
  },
  {
    "start": 149.50715862657185,
    "end": 150.95078887789902,
    "text": "细节化地陈述案情；"
  },
  {
    "start": 151.21889163885976,
    "end": 152.06444650035138,
    "text": "同年八月，"
  },
  {
    "start": 152.2913026827028,
    "end": 154.60111108482624,
    "text": "法院判处十个连续终身监禁，"
  },
  {
    "start": 154.807343977873,
    "end": 156.58094685807492,
    "text": "最低服刑一百七十五年。"
  },
  {
    "start": 156.62219343668426,
    "end": 159.30322104629184,
    "text": "答案不是某个天才警探瞬间破案："
  },
  {
    "start": 159.46820736072922,
    "end": 161.34492668745455,
    "text": "是数十年积累的证物、"
  },
  {
    "start": 161.38617326606388,
    "end": 162.8710500960004,
    "text": "一次数字取证，"
  },
  {
    "start": 162.99478983182843,
    "end": 164.39717350454623,
    "text": "再加DNA验证，"
  },
  {
    "start": 164.665276265507,
    "end": 167.71752308259872,
    "text": "最后被他自己对关注的渴望串在一起。"
  },
  {
    "start": 167.71752308259872,
    "end": 169.32613964836327,
    "text": "你觉得最致命的，"
  },
  {
    "start": 169.49112596280065,
    "end": 170.89350963551846,
    "text": "是软盘元数据，"
  },
  {
    "start": 171.12036581786987,
    "end": 172.83209883015778,
    "text": "还是他停不下来的炫耀？"
  },
  {
    "start": 172.91459198737647,
    "end": 173.9870030312195,
    "text": "评论区说说。"
  }
]