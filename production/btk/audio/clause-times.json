{
 "N01": {
  "duration": 22.67,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 3.11,
    "text": "一个教会领袖，亲手把自己的名字塞进证据里。",
    "chars_per_second": 6.29
   },
   {
    "i": 1,
    "start": 3.45,
    "end": 4.3,
    "text": "二零零五年，",
    "chars_per_second": 5.88
   },
   {
    "i": 2,
    "start": 4.51,
    "end": 7.75,
    "text": "BTK杀手寄给电视台一张三点五英寸软盘，",
    "chars_per_second": 5.86
   },
   {
    "i": 3,
    "start": 8.1,
    "end": 8.97,
    "text": "还先问警察：",
    "chars_per_second": 5.75
   },
   {
    "i": 4,
    "start": 9.19,
    "end": 10.71,
    "text": "这东西能追到寄件人吗？",
    "chars_per_second": 6.58
   },
   {
    "i": 5,
    "start": 10.99,
    "end": 12.4,
    "text": "他等来的不是答案，",
    "chars_per_second": 5.67
   },
   {
    "i": 6,
    "start": 12.73,
    "end": 14.14,
    "text": "是九天后的手铐。",
    "chars_per_second": 4.96
   },
   {
    "i": 7,
    "start": 14.32,
    "end": 15.18,
    "text": "更离谱的是，",
    "chars_per_second": 5.81
   },
   {
    "i": 8,
    "start": 15.5,
    "end": 16.5,
    "text": "出卖他的线索，",
    "chars_per_second": 6.0
   },
   {
    "i": 9,
    "start": 16.8,
    "end": 19.3,
    "text": "藏在他以为已经删掉的文件信息里。",
    "chars_per_second": 6.0
   },
   {
    "i": 10,
    "start": 19.65,
    "end": 20.42,
    "text": "BTK案，",
    "chars_per_second": 5.19
   },
   {
    "i": 11,
    "start": 20.76,
    "end": 22.67,
    "text": "今天从这张软盘讲起。",
    "chars_per_second": 4.71
   }
  ]
 },
 "N02": {
  "duration": 25.635,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 1.39,
    "text": "他叫丹尼斯·雷德，",
    "chars_per_second": 5.3
   },
   {
    "i": 1,
    "start": 1.75,
    "end": 3.99,
    "text": "住在堪萨斯州威奇托附近，",
    "chars_per_second": 4.91
   },
   {
    "i": 2,
    "start": 4.33,
    "end": 5.47,
    "text": "有妻子和孩子。",
    "chars_per_second": 5.26
   },
   {
    "i": 3,
    "start": 5.69,
    "end": 7.46,
    "text": "教会会众委员会主席、",
    "chars_per_second": 5.08
   },
   {
    "i": 4,
    "start": 7.75,
    "end": 8.74,
    "text": "童子军领队、",
    "chars_per_second": 5.05
   },
   {
    "i": 5,
    "start": 9.03,
    "end": 10.55,
    "text": "帕克城法规执行员——",
    "chars_per_second": 5.26
   },
   {
    "i": 6,
    "start": 10.89,
    "end": 12.97,
    "text": "邻居看到的是一个讲规矩、",
    "chars_per_second": 5.29
   },
   {
    "i": 7,
    "start": 13.19,
    "end": 14.11,
    "text": "管社区的人。",
    "chars_per_second": 5.43
   },
   {
    "i": 8,
    "start": 14.31,
    "end": 16.94,
    "text": "可一九七四年至一九九一年间，",
    "chars_per_second": 4.94
   },
   {
    "i": 9,
    "start": 17.29,
    "end": 19.55,
    "text": "威奇托地区有十人遭他杀害，",
    "chars_per_second": 5.31
   },
   {
    "i": 10,
    "start": 19.89,
    "end": 21.77,
    "text": "其中包括奥特罗一家四口。",
    "chars_per_second": 5.85
   },
   {
    "i": 11,
    "start": 22.12,
    "end": 23.89,
    "text": "整齐的日常与连环暴行，",
    "chars_per_second": 5.65
   },
   {
    "i": 12,
    "start": 24.13,
    "end": 25.64,
    "text": "竟装在同一个人身上。",
    "chars_per_second": 5.98
   }
  ]
 },
 "N03": {
  "duration": 27.529,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.14,
    "text": "BTK不是警方起的名字，",
    "chars_per_second": 5.53
   },
   {
    "i": 1,
    "start": 2.48,
    "end": 3.98,
    "text": "而是雷德自己取的缩写：",
    "chars_per_second": 6.67
   },
   {
    "i": 2,
    "start": 4.33,
    "end": 4.65,
    "text": "Bind，",
    "chars_per_second": 12.5
   },
   {
    "i": 3,
    "start": 5.0,
    "end": 5.47,
    "text": "捆绑；",
    "chars_per_second": 4.26
   },
   {
    "i": 4,
    "start": 5.75,
    "end": 6.2,
    "text": "Torture，",
    "chars_per_second": 15.56
   },
   {
    "i": 5,
    "start": 6.49,
    "end": 6.97,
    "text": "折磨；",
    "chars_per_second": 4.17
   },
   {
    "i": 6,
    "start": 7.18,
    "end": 7.5,
    "text": "Kill，",
    "chars_per_second": 12.5
   },
   {
    "i": 7,
    "start": 7.79,
    "end": 8.24,
    "text": "杀害。",
    "chars_per_second": 4.44
   },
   {
    "i": 8,
    "start": 8.58,
    "end": 9.88,
    "text": "案件细节很残酷，",
    "chars_per_second": 5.38
   },
   {
    "i": 9,
    "start": 10.23,
    "end": 11.02,
    "text": "我们不复现。",
    "chars_per_second": 6.33
   },
   {
    "i": 10,
    "start": 11.37,
    "end": 12.41,
    "text": "警方后来确认，",
    "chars_per_second": 5.77
   },
   {
    "i": 11,
    "start": 12.68,
    "end": 14.32,
    "text": "他会预先挑选目标、",
    "chars_per_second": 4.88
   },
   {
    "i": 12,
    "start": 14.59,
    "end": 16.15,
    "text": "踩点，",
    "chars_per_second": 1.28
   },
   {
    "i": 13,
    "start": 16.5,
    "end": 20.13,
    "text": "趁人独自在家时下手；作案后还留下信件和线索，向媒体、",
    "chars_per_second": 6.34
   },
   {
    "i": 14,
    "start": 20.48,
    "end": 23.3,
    "text": "警方炫耀。最后一起已知命案发生在一九九一年。",
    "chars_per_second": 7.09
   },
   {
    "i": 15,
    "start": 23.53,
    "end": 23.99,
    "text": "然后，",
    "chars_per_second": 4.35
   },
   {
    "i": 16,
    "start": 24.28,
    "end": 25.17,
    "text": "他突然沉默，",
    "chars_per_second": 5.62
   },
   {
    "i": 17,
    "start": 25.48,
    "end": 27.53,
    "text": "调查也陷入漫长冷案。",
    "chars_per_second": 4.39
   }
  ]
 },
 "N04": {
  "duration": 30.522,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.2,
    "text": "沉默十三年后，",
    "chars_per_second": 5.41
   },
   {
    "i": 1,
    "start": 1.47,
    "end": 2.34,
    "text": "二零零四年，",
    "chars_per_second": 5.75
   },
   {
    "i": 2,
    "start": 2.68,
    "end": 3.63,
    "text": "他重新写信，",
    "chars_per_second": 5.26
   },
   {
    "i": 3,
    "start": 3.83,
    "end": 4.65,
    "text": "频繁挑衅，",
    "chars_per_second": 4.88
   },
   {
    "i": 4,
    "start": 4.99,
    "end": 6.75,
    "text": "想让全世界记起BTK。",
    "chars_per_second": 5.68
   },
   {
    "i": 5,
    "start": 7.1,
    "end": 8.0,
    "text": "他向警方问：",
    "chars_per_second": 5.56
   },
   {
    "i": 6,
    "start": 8.36,
    "end": 9.62,
    "text": "把文件放进软盘，",
    "chars_per_second": 5.56
   },
   {
    "i": 7,
    "start": 9.94,
    "end": 11.37,
    "text": "能查到是哪台电脑吗？",
    "chars_per_second": 6.29
   },
   {
    "i": 8,
    "start": 11.66,
    "end": 13.45,
    "text": "警方通过报纸广告给了他模糊保证。",
    "chars_per_second": 8.38
   },
   {
    "i": 9,
    "start": 13.71,
    "end": 15.67,
    "text": "二零零五年二月，",
    "chars_per_second": 3.57
   },
   {
    "i": 10,
    "start": 15.97,
    "end": 18.37,
    "text": "他把软盘寄到威奇托一家电视台。",
    "chars_per_second": 5.83
   },
   {
    "i": 11,
    "start": 18.67,
    "end": 20.97,
    "text": "取证人员恢复被删的Word文件，",
    "chars_per_second": 6.52
   },
   {
    "i": 12,
    "start": 21.31,
    "end": 23.15,
    "text": "元数据里出现两条线索：",
    "chars_per_second": 5.43
   },
   {
    "i": 13,
    "start": 23.47,
    "end": 24.75,
    "text": "Christ Lutheran Church，",
    "chars_per_second": 15.63
   },
   {
    "i": 14,
    "start": 24.98,
    "end": 26.32,
    "text": "和修改者Dennis。",
    "chars_per_second": 7.46
   },
   {
    "i": 15,
    "start": 26.58,
    "end": 27.96,
    "text": "教会网页上的一个名字，",
    "chars_per_second": 7.25
   },
   {
    "i": 16,
    "start": 28.29,
    "end": 30.52,
    "text": "让冷案第一次有了明确嫌疑人。",
    "chars_per_second": 5.82
   }
  ]
 },
 "N05": {
  "duration": 28.16,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.62,
    "text": "但软盘指向嫌疑人，",
    "chars_per_second": 5.41
   },
   {
    "i": 1,
    "start": 1.82,
    "end": 2.9,
    "text": "不等于足以定罪。",
    "chars_per_second": 6.48
   },
   {
    "i": 2,
    "start": 3.25,
    "end": 4.97,
    "text": "调查员继续找独立证据：",
    "chars_per_second": 5.81
   },
   {
    "i": 3,
    "start": 5.31,
    "end": 9.48,
    "text": "他们依法申请调取雷德女儿在大学诊所留下的医学样本，",
    "chars_per_second": 5.76
   },
   {
    "i": 4,
    "start": 9.82,
    "end": 11.26,
    "text": "进行亲缘关系比对。",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 11.6,
    "end": 15.28,
    "text": "结果显示，案发现场保存的DNA与她存在亲缘关联，",
    "chars_per_second": 5.98
   },
   {
    "i": 6,
    "start": 15.62,
    "end": 16.94,
    "text": "线索指向她的父亲。",
    "chars_per_second": 6.06
   },
   {
    "i": 7,
    "start": 17.24,
    "end": 18.37,
    "text": "这只是亲缘线索，",
    "chars_per_second": 6.19
   },
   {
    "i": 8,
    "start": 18.65,
    "end": 19.63,
    "text": "并非直接匹配，",
    "chars_per_second": 6.12
   },
   {
    "i": 9,
    "start": 19.94,
    "end": 21.28,
    "text": "却让警方锁定雷德。",
    "chars_per_second": 5.97
   },
   {
    "i": 10,
    "start": 21.62,
    "end": 22.49,
    "text": "二月二十五日，",
    "chars_per_second": 6.9
   },
   {
    "i": 11,
    "start": 22.7,
    "end": 24.07,
    "text": "丹尼斯·雷德被捕。",
    "chars_per_second": 5.11
   },
   {
    "i": 12,
    "start": 24.42,
    "end": 25.83,
    "text": "数字取证给出名字，",
    "chars_per_second": 5.67
   },
   {
    "i": 13,
    "start": 26.12,
    "end": 28.16,
    "text": "DNA提供关键支撑。",
    "chars_per_second": 4.41
   }
  ]
 },
 "N06": {
  "duration": 28.243,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 0.53,
    "text": "六月，",
    "chars_per_second": 4.88
   },
   {
    "i": 1,
    "start": 0.84,
    "end": 3.38,
    "text": "雷德在法庭上承认十项一级谋杀罪，",
    "chars_per_second": 5.91
   },
   {
    "i": 2,
    "start": 3.72,
    "end": 5.7,
    "text": "并平静、细节化地陈述案情；",
    "chars_per_second": 5.56
   },
   {
    "i": 3,
    "start": 6.03,
    "end": 6.74,
    "text": "同年八月，",
    "chars_per_second": 5.63
   },
   {
    "i": 4,
    "start": 6.97,
    "end": 9.28,
    "text": "法院判处十个连续终身监禁，",
    "chars_per_second": 5.19
   },
   {
    "i": 5,
    "start": 9.64,
    "end": 11.23,
    "text": "最低服刑一百七十五年。",
    "chars_per_second": 6.29
   },
   {
    "i": 6,
    "start": 11.54,
    "end": 14.0,
    "text": "答案不是某个天才警探瞬间破案：",
    "chars_per_second": 5.69
   },
   {
    "i": 7,
    "start": 14.31,
    "end": 15.99,
    "text": "是数十年积累的证物、",
    "chars_per_second": 5.36
   },
   {
    "i": 8,
    "start": 16.28,
    "end": 17.43,
    "text": "一次数字取证，",
    "chars_per_second": 5.22
   },
   {
    "i": 9,
    "start": 17.66,
    "end": 18.97,
    "text": "再加DNA验证，",
    "chars_per_second": 5.34
   },
   {
    "i": 10,
    "start": 19.3,
    "end": 22.21,
    "text": "最后被他自己对关注的渴望串在一起。",
    "chars_per_second": 5.5
   },
   {
    "i": 11,
    "start": 22.54,
    "end": 23.77,
    "text": "你觉得最致命的，",
    "chars_per_second": 5.69
   },
   {
    "i": 12,
    "start": 24.12,
    "end": 25.26,
    "text": "是软盘元数据，",
    "chars_per_second": 5.26
   },
   {
    "i": 13,
    "start": 25.6,
    "end": 27.07,
    "text": "还是他停不下来的炫耀？",
    "chars_per_second": 6.8
   },
   {
    "i": 14,
    "start": 27.39,
    "end": 28.24,
    "text": "评论区说说。",
    "chars_per_second": 5.86
   }
  ]
 }
}