   },
   {
    "i": 15,
    "start": 19.43,
    "end": 19.96,
    "text": "向媒体",
    "chars_per_second": 5.66
   },
   {
    "i": 16,
    "start": 19.96,
    "end": 20.79,
    "text": "警方炫耀",
    "chars_per_second": 4.82
   },
   {
    "i": 17,
    "start": 20.79,
    "end": 22.71,
    "text": "案件始于一九七四年",
    "chars_per_second": 4.69
   },
   {
    "i": 18,
    "start": 22.71,
    "end": 26.12,
    "text": "最后一起已知命案发生在一九九一年",
    "chars_per_second": 4.69
   },
   {
    "i": 19,
    "start": 26.12,
    "end": 26.63,
    "text": "然后",
    "chars_per_second": 3.92
   },
   {
    "i": 20,
    "start": 26.63,
    "end": 27.6,
    "text": "他突然沉默",
    "chars_per_second": 5.15
   },
   {
    "i": 21,
    "start": 27.6,
    "end": 29.77,
    "text": "调查也陷入漫长冷案",
    "chars_per_second": 4.15
   }
  ]
 },
 "N04": {
