   },
   {
    "i": 7,
    "start": 12.1,
    "end": 12.98,
    "text": "管社区的人",
    "chars_per_second": 5.68
   },
   {
    "i": 8,
    "start": 12.98,
    "end": 15.74,
    "text": "可一九七四年至一九九一年间",
    "chars_per_second": 4.71
   },
   {
    "i": 9,
    "start": 15.74,
    "end": 18.38,
    "text": "威奇托地区有十人遭他杀害",
    "chars_per_second": 4.55
   },
   {
    "i": 10,
    "start": 18.38,
    "end": 20.65,
    "text": "其中包括奥特罗一家四口",
    "chars_per_second": 4.85
   },
   {
    "i": 11,
    "start": 20.65,
    "end": 22.77,
    "text": "整齐的日常与连环暴行",
    "chars_per_second": 4.72
   },
   {
    "i": 12,
    "start": 22.77,
    "end": 24.91,
    "text": "竟装在同一个人身上",
    "chars_per_second": 4.21
   }
  ]
 },
 "N03": {
  "duration": 29.767,
  "method": "proportional-energy-fallback",
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.46,
