   },
   {
    "i": 10,
    "start": 11.48,
    "end": 12.86,
    "text": "警方后来确认",
    "chars_per_second": 4.35
   },
   {
    "i": 11,
    "start": 12.86,
    "end": 14.61,
    "text": "他会预先挑选目标",
    "chars_per_second": 4.57
   },
   {
    "i": 12,
    "start": 14.61,
    "end": 14.93,
    "text": "踩点",
