{
 "N01": {
  "duration": 20.643,
  "clauses": [
   {
    "i": 0,
    "start": 0.13,
    "end": 2.82,
    "text": "他寄出一张三点五英寸软盘前",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 1,
    "start": 2.82,
    "end": 3.65,
    "text": "先问警方",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 2,
    "start": 3.65,
    "end": 5.52,
    "text": "能追到是哪台电脑吗",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 3,
    "start": 5.52,
    "end": 7.59,
    "text": "警方在报纸广告里暗示",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 4,
    "start": 7.59,
    "end": 8.21,
    "text": "没问题",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 5,
    "start": 8.21,
    "end": 8.83,
    "text": "九天后",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 6,
    "start": 8.83,
    "end": 11.11,
    "text": "教会领袖丹尼斯·雷德被捕",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 7,
    "start": 11.11,
    "end": 11.53,
    "text": "原来",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 8,
    "start": 11.53,
    "end": 12.35,
    "text": "删掉文件",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 9,
    "start": 12.35,
    "end": 14.84,
    "text": "不等于删掉它留下的元数据",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 10,
    "start": 14.84,
    "end": 16.29,
    "text": "这就是BTK案",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 11,
    "start": 16.29,
    "end": 18.16,
    "text": "一个渴望关注的杀手",
    "chars_per_second": 4.83,
    "estimated": true
   },
   {
    "i": 12,
    "start": 18.16,
    "end": 20.64,
    "text": "怎样被自己寄出的软盘出卖",
    "chars_per_second": 4.83,
    "estimated": true
   }
  ]
 },
 "N02": {
  "duration": 25.128,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.56,
    "text": "他叫丹尼斯·雷德",
    "chars_per_second": 4.76
   },
   {
    "i": 1,
    "start": 1.87,
    "end": 4.04,
    "text": "住在堪萨斯州威奇托附近",
    "chars_per_second": 5.07
   },
   {
    "i": 2,
    "start": 4.38,
    "end": 5.38,
    "text": "有妻子和孩子",
    "chars_per_second": 6.0
   },
   {
    "i": 3,
    "start": 5.67,
    "end": 7.51,
    "text": "教会会众委员会主席",
    "chars_per_second": 4.89
   },
   {
    "i": 4,
    "start": 7.8,
    "end": 8.73,
    "text": "童子军领队",
    "chars_per_second": 5.38
   },
   {
    "i": 5,
    "start": 9.0,
    "end": 10.47,
    "text": "帕克城法规执行员",
    "chars_per_second": 5.44
   },
   {
    "i": 6,
    "start": 10.81,
    "end": 12.92,
    "text": "邻居看到的是一个讲规矩",
    "chars_per_second": 5.21
   },
   {
    "i": 7,
    "start": 13.2,
    "end": 14.05,
    "text": "管社区的人",
    "chars_per_second": 5.88
   },
   {
    "i": 8,
    "start": 14.36,
    "end": 16.53,
    "text": "可一九七四年至一九九一年间",
    "chars_per_second": 5.99
   },
   {
    "i": 9,
    "start": 16.87,
    "end": 19.01,
    "text": "威奇托地区有十人遭他杀害",
    "chars_per_second": 5.61
   },
   {
    "i": 10,
    "start": 19.35,
    "end": 21.07,
    "text": "其中包括奥特罗一家四口",
    "chars_per_second": 6.4
   },
   {
    "i": 11,
    "start": 21.41,
    "end": 23.26,
    "text": "整齐的日常与连环暴行",
    "chars_per_second": 5.41
   },
   {
    "i": 12,
    "start": 23.57,
    "end": 25.13,
    "text": "竟装在同一个人身上",
    "chars_per_second": 5.78
   }
  ]
 },
 "N03": {
  "duration": 29.237,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.46,
    "text": "BTK不是警方起的名字",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 1,
    "start": 2.46,
    "end": 4.57,
    "text": "而是雷德自己取的缩写",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 2,
    "start": 4.57,
    "end": 5.41,
    "text": "Bind",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 3,
    "start": 5.41,
    "end": 5.83,
    "text": "捆绑",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 4,
    "start": 5.83,
    "end": 7.31,
    "text": "Torture",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 5,
    "start": 7.31,
    "end": 7.73,
    "text": "折磨",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 6,
    "start": 7.73,
    "end": 8.57,
    "text": "Kill",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 7,
    "start": 8.57,
    "end": 9.0,
    "text": "杀害",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 8,
    "start": 9.0,
    "end": 10.47,
    "text": "案件细节很残酷",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 9,
    "start": 10.47,
    "end": 11.53,
    "text": "我们不复现",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 10,
    "start": 11.53,
    "end": 12.79,
    "text": "警方后来确认",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 11,
    "start": 12.79,
    "end": 14.48,
    "text": "他会预先挑选目标",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 12,
    "start": 14.48,
    "end": 14.9,
    "text": "踩点",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 13,
    "start": 14.9,
    "end": 16.8,
    "text": "趁人独自在家时下手",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 14,
    "start": 16.8,
    "end": 19.12,
    "text": "作案后还留下信件和线索",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 15,
    "start": 19.12,
    "end": 19.75,
    "text": "向媒体",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 16,
    "start": 19.75,
    "end": 20.59,
    "text": "警方炫耀",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 17,
    "start": 20.59,
    "end": 22.49,
    "text": "案件始于一九七四年",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 18,
    "start": 22.49,
    "end": 25.86,
    "text": "最后一起已知命案发生在一九九一年",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 19,
    "start": 25.86,
    "end": 26.29,
    "text": "然后",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 20,
    "start": 26.29,
    "end": 27.34,
    "text": "他突然沉默",
    "chars_per_second": 4.74,
    "estimated": true
   },
   {
    "i": 21,
    "start": 27.34,
    "end": 29.24,
    "text": "调查也陷入漫长冷案",
    "chars_per_second": 4.74,
    "estimated": true
   }
  ]
 },
 "N04": {
  "duration": 31.091,
  "clauses": [
   {
    "i": 0,
    "start": 0.13,
    "end": 1.23,
    "text": "沉默十三年后",
    "chars_per_second": 5.45
   },
   {
    "i": 1,
    "start": 1.43,
    "end": 3.86,
    "text": "雷德在二零零四年重写挑衅信",
    "chars_per_second": 5.35
   },
   {
    "i": 2,
    "start": 4.08,
    "end": 5.69,
    "text": "想让世界记起BTK",
    "chars_per_second": 5.59
   },
   {
    "i": 3,
    "start": 6.03,
    "end": 6.9,
    "text": "他又问警方",
    "chars_per_second": 5.75
   },
   {
    "i": 4,
    "start": 7.25,
    "end": 8.67,
    "text": "软盘能追到哪台电脑",
    "chars_per_second": 6.34
   },
   {
    "i": 5,
    "start": 9.01,
    "end": 10.52,
    "text": "报纸广告模糊暗示",
    "chars_per_second": 5.3
   },
   {
    "i": 6,
    "start": 10.86,
    "end": 11.37,
    "text": "没问题",
    "chars_per_second": 5.88
   },
   {
    "i": 7,
    "start": 11.69,
    "end": 12.81,
    "text": "二零零五年二月",
    "chars_per_second": 6.25
   },
   {
    "i": 8,
    "start": 13.11,
    "end": 15.13,
    "text": "他把软盘寄到威奇托电视台",
    "chars_per_second": 5.94
   },
   {
    "i": 9,
    "start": 15.36,
    "end": 17.52,
    "text": "调查员恢复出被删Word文件",
    "chars_per_second": 6.48
   },
   {
    "i": 10,
    "start": 17.81,
    "end": 22.0,
    "text": "Metadata（元数据）就是记录作者",
    "chars_per_second": 4.06
   },
   {
    "i": 11,
    "start": 22.27,
    "end": 23.99,
    "text": "设备等信息的文件属性",
    "chars_per_second": 5.81
   },
   {
    "i": 12,
    "start": 24.28,
    "end": 25.23,
    "text": "正文删了",
    "chars_per_second": 4.21
   },
   {
    "i": 13,
    "start": 25.53,
    "end": 26.62,
    "text": "属性未必消失",
    "chars_per_second": 5.5
   },
   {
    "i": 14,
    "start": 26.84,
    "end": 27.9,
    "text": "残留线索出现Christ Lutheran Church与修改者Dennis",
    "chars_per_second": 33.96
   },
   {
    "i": 15,
    "start": 28.14,
    "end": 29.41,
    "text": "教会网页上的名字",
    "chars_per_second": 6.3
   },
   {
    "i": 16,
    "start": 29.74,
    "end": 31.09,
    "text": "让警方锁定雷德",
    "chars_per_second": 5.18
   }
  ]
 },
 "N05": {
  "duration": 28.722,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.73,
    "text": "但软盘指向嫌疑人",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 1,
    "start": 1.73,
    "end": 3.12,
    "text": "不等于足以定罪",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 2,
    "start": 3.12,
    "end": 5.1,
    "text": "调查员继续找独立证据",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 3,
    "start": 5.1,
    "end": 9.87,
    "text": "他们依法申请调取雷德女儿在大学诊所留下的医学样本",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 4,
    "start": 9.87,
    "end": 11.45,
    "text": "进行亲缘关系比对",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 5,
    "start": 11.45,
    "end": 12.25,
    "text": "结果显示",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 6,
    "start": 12.25,
    "end": 15.82,
    "text": "案发现场保存的DNA与她存在亲缘关联",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 7,
    "start": 15.82,
    "end": 17.41,
    "text": "线索指向她的父亲",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 8,
    "start": 17.41,
    "end": 17.8,
    "text": "注意",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 9,
    "start": 17.8,
    "end": 20.78,
    "text": "这不是女儿的样本直接“匹配成凶手”",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 10,
    "start": 20.78,
    "end": 22.77,
    "text": "而是帮助警方锁定雷德",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 11,
    "start": 22.77,
    "end": 23.96,
    "text": "二月二十五日",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 12,
    "start": 23.96,
    "end": 25.35,
    "text": "丹尼斯·雷德被捕",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 13,
    "start": 25.35,
    "end": 26.94,
    "text": "数字取证给出名字",
    "chars_per_second": 5.04,
    "estimated": true
   },
   {
    "i": 14,
    "start": 26.94,
    "end": 28.72,
    "text": "DNA提供关键支撑",
    "chars_per_second": 5.04,
    "estimated": true
   }
  ]
 },
 "N06": {
  "duration": 28.103,
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 0.54,
    "text": "六月",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 1,
    "start": 0.54,
    "end": 3.67,
    "text": "雷德在法庭上承认十项一级谋杀罪",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 2,
    "start": 3.67,
    "end": 4.3,
    "text": "并平静",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 3,
    "start": 4.3,
    "end": 5.97,
    "text": "细节化地陈述案情",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 4,
    "start": 5.97,
    "end": 6.8,
    "text": "同年八月",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 5,
    "start": 6.8,
    "end": 9.31,
    "text": "法院判处十个连续终身监禁",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 6,
    "start": 9.31,
    "end": 11.4,
    "text": "最低服刑一百七十五年",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 7,
    "start": 11.4,
    "end": 14.32,
    "text": "答案不是某个天才警探瞬间破案",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 8,
    "start": 14.32,
    "end": 16.2,
    "text": "是数十年积累的证物",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 9,
    "start": 16.2,
    "end": 17.45,
    "text": "一次数字取证",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 10,
    "start": 17.45,
    "end": 18.91,
    "text": "再加DNA验证",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 11,
    "start": 18.91,
    "end": 22.26,
    "text": "最后被他自己对关注的渴望串在一起",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 12,
    "start": 22.26,
    "end": 23.72,
    "text": "你觉得最致命的",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 13,
    "start": 23.72,
    "end": 24.97,
    "text": "是软盘元数据",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 14,
    "start": 24.97,
    "end": 27.06,
    "text": "还是他停不下来的炫耀",
    "chars_per_second": 4.79,
    "estimated": true
   },
   {
    "i": 15,
    "start": 27.06,
    "end": 28.1,
    "text": "评论区说说",
    "chars_per_second": 4.79,
    "estimated": true
   }
  ]
 }
}