   },
   {
    "i": 5,
    "start": 8.02,
    "end": 9.68,
    "text": "帕克城法规执行员",
    "chars_per_second": 4.82
   },
   {
    "i": 6,
    "start": 9.68,
    "end": 12.1,
    "text": "邻居看到的是一个讲规矩",
