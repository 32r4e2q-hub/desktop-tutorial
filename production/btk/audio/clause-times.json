{
 "N01": {
  "duration": 22.82,
  "method": "proportional-energy-fallback",
  "clauses": [
   {
    "i": 0,
    "start": 0.12,
    "end": 1.28,
    "text": "一个教会领袖",
    "chars_per_second": 5.17
   },
   {
    "i": 1,
    "start": 1.28,
    "end": 3.67,
    "text": "亲手把自己的名字塞进证据里",
    "chars_per_second": 5.44
   },
   {
    "i": 2,
    "start": 3.67,
    "end": 4.93,
    "text": "二零零五年",
    "chars_per_second": 3.97
   },
   {
    "i": 3,
    "start": 4.93,
    "end": 8.69,
    "text": "BTK杀手寄给电视台一张三点五英寸软盘",
    "chars_per_second": 5.05
   },
   {
    "i": 4,
    "start": 8.69,
    "end": 9.81,
    "text": "还先问警察",
    "chars_per_second": 4.46
   },
   {
    "i": 5,
    "start": 9.81,
    "end": 11.73,
    "text": "这东西能追到寄件人吗",
    "chars_per_second": 5.21
   },
   {
    "i": 6,
    "start": 11.73,
    "end": 13.37,
    "text": "他等来的不是答案",
    "chars_per_second": 4.88
   },
   {
    "i": 7,
    "start": 13.37,
    "end": 14.73,
    "text": "是九天后的手铐",
    "chars_per_second": 5.15
   },
   {
    "i": 8,
    "start": 14.73,
    "end": 15.59,
    "text": "更离谱的是",
    "chars_per_second": 5.81
   },
   {
    "i": 9,
    "start": 15.59,
    "end": 16.92,
    "text": "出卖他的线索",
    "chars_per_second": 4.51
   },
   {
    "i": 10,
    "start": 16.92,
    "end": 19.95,
    "text": "藏在他以为已经删掉的文件信息里",
    "chars_per_second": 4.95
   },
   {
    "i": 11,
    "start": 19.95,
    "end": 20.78,
    "text": "BTK案",
    "chars_per_second": 4.82
   },
   {
    "i": 12,
    "start": 20.78,
    "end": 22.82,
    "text": "今天从这张软盘讲起",
    "chars_per_second": 4.41
   }
  ]
 },
 "N02": {
  "duration": 24.908,
  "method": "proportional-energy-fallback",
  "clauses": [
   {
    "i": 0,
    "start": 0.11,
    "end": 1.54,
    "text": "他叫丹尼斯·雷德",
    "chars_per_second": 4.9
   },
   {
    "i": 1,
    "start": 1.54,
    "end": 3.89,
    "text": "住在堪萨斯州威奇托附近",
    "chars_per_second": 4.68
   },
   {
    "i": 2,
    "start": 3.89,
    "end": 5.17,
    "text": "有妻子和孩子",
