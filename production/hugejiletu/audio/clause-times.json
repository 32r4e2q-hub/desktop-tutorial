{
 "N01": {
  "duration": 27.982,
  "clauses": [
   {
    "i": 0,
    "start": 0.11,
    "end": 2.16,
    "text": "一九九六年四月九日的夜里",
    "chars_per_second": 5.85
   },
   {
    "i": 1,
    "start": 2.44,
    "end": 3.25,
    "text": "呼和浩特",
    "chars_per_second": 4.94
   },
   {
    "i": 2,
    "start": 3.57,
    "end": 5.01,
    "text": "第一毛纺厂家属区",
    "chars_per_second": 5.56
   },
   {
    "i": 3,
    "start": 5.36,
    "end": 6.84,
    "text": "十八岁的呼格吉勒图",
    "chars_per_second": 6.08
   },
   {
    "i": 4,
    "start": 7.17,
    "end": 8.36,
    "text": "在公共女厕所里",
    "chars_per_second": 5.88
   },
   {
    "i": 5,
    "start": 8.68,
    "end": 10.52,
    "text": "看见了他不该看见的东西",
    "chars_per_second": 5.98
   },
   {
    "i": 6,
    "start": 10.68,
    "end": 11.96,
    "text": "他拉着同事闫峰",
    "chars_per_second": 5.47
   },
   {
    "i": 7,
    "start": 12.31,
    "end": 14.45,
    "text": "跑向几十米外的治安岗亭报案",
    "chars_per_second": 6.07
   },
   {
    "i": 8,
    "start": 14.68,
    "end": 16.25,
    "text": "可被留下反复问话的",
    "chars_per_second": 5.73
   },
   {
    "i": 9,
    "start": 16.5,
    "end": 17.15,
    "text": "不是别人",
    "chars_per_second": 6.15
   },
   {
    "i": 10,
    "start": 17.38,
    "end": 17.8,
    "text": "是他",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 18.15,
    "end": 19.95,
    "text": "案子推进得快得反常",
    "chars_per_second": 5.0
   },
   {
    "i": 12,
    "start": 20.29,
    "end": 21.09,
    "text": "五月十七日",
    "chars_per_second": 6.25
   },
   {
    "i": 13,
    "start": 21.33,
    "end": 22.09,
    "text": "一审开庭",
    "chars_per_second": 5.26
   },
   {
    "i": 14,
    "start": 22.33,
    "end": 23.37,
    "text": "当天判了死刑",
    "chars_per_second": 5.77
   },
   {
    "i": 15,
    "start": 23.7,
    "end": 25.04,
    "text": "从报案到死刑",
    "chars_per_second": 4.48
   },
   {
    "i": 16,
    "start": 25.23,
    "end": 26.27,
    "text": "只有三十八天",
    "chars_per_second": 5.77
   },
   {
    "i": 17,
    "start": 26.62,
    "end": 27.98,
    "text": "他还不满十九岁",
    "chars_per_second": 5.14
   }
  ]
 },
 "N02": {
  "duration": 24.98,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.82,
    "text": "他不认罪",
    "chars_per_second": 5.88
   },
   {
    "i": 1,
    "start": 1.08,
    "end": 1.79,
    "text": "上诉状上",
    "chars_per_second": 5.63
   },
   {
    "i": 2,
    "start": 2.07,
    "end": 2.93,
    "text": "他写下一句话",
    "chars_per_second": 6.98
   },
   {
    "i": 3,
    "start": 3.17,
    "end": 4.3,
    "text": "我没有杀人动机",
    "chars_per_second": 6.19
   },
   {
    "i": 4,
    "start": 4.6,
    "end": 5.22,
    "text": "六月五日",
    "chars_per_second": 6.45
   },
   {
    "i": 5,
    "start": 5.39,
    "end": 6.13,
    "text": "二审开庭",
    "chars_per_second": 5.41
   },
   {
    "i": 6,
    "start": 6.39,
    "end": 7.11,
    "text": "当天驳回",
    "chars_per_second": 5.56
   },
   {
    "i": 7,
    "start": 7.34,
    "end": 8.01,
    "text": "维持原判",
    "chars_per_second": 5.97
   },
   {
    "i": 8,
    "start": 8.33,
    "end": 9.04,
    "text": "卷宗合上",
    "chars_per_second": 5.63
   },
   {
    "i": 9,
    "start": 9.36,
    "end": 10.41,
    "text": "一个十八岁的人",
    "chars_per_second": 6.67
   },
   {
    "i": 10,
    "start": 10.59,
    "end": 11.27,
    "text": "成了死囚",
    "chars_per_second": 5.88
   },
   {
    "i": 11,
    "start": 11.59,
    "end": 12.93,
    "text": "从案发到执行",
    "chars_per_second": 4.48
   },
   {
    "i": 12,
    "start": 13.27,
    "end": 13.97,
    "text": "六十二天",
    "chars_per_second": 5.71
   },
   {
    "i": 13,
    "start": 14.26,
    "end": 14.97,
    "text": "六月十日",
    "chars_per_second": 5.63
   },
   {
    "i": 14,
    "start": 15.31,
    "end": 15.97,
    "text": "天还没亮",
    "chars_per_second": 6.06
   },
   {
    "i": 15,
    "start": 16.24,
    "end": 16.87,
    "text": "他被带走",
    "chars_per_second": 6.35
   },
   {
    "i": 16,
    "start": 17.22,
    "end": 18.8,
    "text": "他的父母在门外等了一夜",
    "chars_per_second": 6.96
   },
   {
    "i": 17,
    "start": 19.13,
    "end": 20.15,
    "text": "等来的不是儿子",
    "chars_per_second": 6.86
   },
   {
    "i": 18,
    "start": 20.5,
    "end": 21.26,
    "text": "从那天起",
    "chars_per_second": 5.26
   },
   {
    "i": 19,
    "start": 21.47,
    "end": 22.42,
    "text": "他们开始申诉",
    "chars_per_second": 6.32
   },
   {
    "i": 20,
    "start": 22.76,
    "end": 23.9,
    "text": "一年又一年",
    "chars_per_second": 4.39
   },
   {
    "i": 21,
    "start": 24.24,
    "end": 24.98,
    "text": "十年",
    "chars_per_second": 2.7
   }
  ]
 },
 "N03": {
  "duration": 26.665,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 0.93,
    "text": "故事到这里",
    "chars_per_second": 5.95
   },
   {
    "i": 1,
    "start": 1.19,
    "end": 1.94,
    "text": "本该结束",
    "chars_per_second": 5.33
   },
   {
    "i": 2,
    "start": 2.28,
    "end": 4.63,
    "text": "可九年后的二〇〇五年十月",
    "chars_per_second": 4.26
   },
   {
    "i": 3,
    "start": 4.98,
    "end": 7.21,
    "text": "内蒙古警方破获一系列案件",
    "chars_per_second": 5.38
   },
   {
    "i": 4,
    "start": 7.45,
    "end": 8.47,
    "text": "抓到了赵志红",
    "chars_per_second": 5.88
   },
   {
    "i": 5,
    "start": 8.82,
    "end": 9.59,
    "text": "押解车上",
    "chars_per_second": 5.19
   },
   {
    "i": 6,
    "start": 9.88,
    "end": 10.86,
    "text": "他一直低着头",
    "chars_per_second": 6.12
   },
   {
    "i": 7,
    "start": 11.03,
    "end": 11.72,
    "text": "审讯中",
    "chars_per_second": 4.35
   },
   {
    "i": 8,
    "start": 11.86,
    "end": 12.76,
    "text": "他主动开口",
    "chars_per_second": 5.56
   },
   {
    "i": 9,
    "start": 13.11,
    "end": 14.53,
    "text": "四月九日那起命案",
    "chars_per_second": 5.63
   },
   {
    "i": 10,
    "start": 14.61,
    "end": 15.38,
    "text": "也是他做的",
    "chars_per_second": 6.49
   },
   {
    "i": 11,
    "start": 15.74,
    "end": 16.45,
    "text": "两本案卷",
    "chars_per_second": 5.63
   },
   {
    "i": 12,
    "start": 16.7,
    "end": 18.16,
    "text": "被摆到了同一张桌上",
    "chars_per_second": 6.16
   },
   {
    "i": 13,
    "start": 18.51,
    "end": 18.95,
    "text": "这时",
    "chars_per_second": 4.55
   },
   {
    "i": 14,
    "start": 19.17,
    "end": 21.42,
    "text": "距离呼格吉勒图被执行死刑",
    "chars_per_second": 5.33
   },
   {
    "i": 15,
    "start": 21.6,
    "end": 22.71,
    "text": "已经过去九年",
    "chars_per_second": 5.41
   },
   {
    "i": 16,
    "start": 23.06,
    "end": 24.35,
    "text": "有一个人开始追问",
    "chars_per_second": 6.2
   },
   {
    "i": 17,
    "start": 24.69,
    "end": 25.3,
    "text": "一个电话",
    "chars_per_second": 6.56
   },
   {
    "i": 18,
    "start": 25.64,
    "end": 26.66,
    "text": "接一个电话",
    "chars_per_second": 4.88
   }
  ]
 },
 "N04": {
  "duration": 27.32,
  "clauses": [
   {
    "i": 0,
    "start": 0.07,
    "end": 1.08,
    "text": "他的父母还在等",
    "chars_per_second": 6.93
   },
   {
    "i": 1,
    "start": 1.43,
    "end": 2.25,
    "text": "二〇一四年",
    "chars_per_second": 4.88
   },
   {
    "i": 2,
    "start": 2.45,
    "end": 3.99,
    "text": "这起案子被重新翻开",
    "chars_per_second": 5.84
   },
   {
    "i": 3,
    "start": 4.33,
    "end": 5.2,
    "text": "当年的证据",
    "chars_per_second": 5.75
   },
   {
    "i": 4,
    "start": 5.41,
    "end": 7.05,
    "text": "要一条一条重新核对",
    "chars_per_second": 5.49
   },
   {
    "i": 5,
    "start": 7.41,
    "end": 8.69,
    "text": "供述和尸检报告",
    "chars_per_second": 5.47
   },
   {
    "i": 6,
    "start": 8.93,
    "end": 9.38,
    "text": "对不上",
    "chars_per_second": 6.67
   },
   {
    "i": 7,
    "start": 9.72,
    "end": 11.39,
    "text": "指甲缝里的血是O型",
    "chars_per_second": 5.39
   },
   {
    "i": 8,
    "start": 11.73,
    "end": 12.81,
    "text": "可呼格吉勒图也是O型",
    "chars_per_second": 9.26
   },
   {
    "i": 9,
    "start": 12.86,
    "end": 13.72,
    "text": "血型只能说明类型",
    "chars_per_second": 9.3
   },
   {
    "i": 10,
    "start": 14.07,
    "end": 15.8,
    "text": "锁不住一个人",
    "chars_per_second": 3.47
   },
   {
    "i": 11,
    "start": 16.02,
    "end": 17.03,
    "text": "证据和证据之间",
    "chars_per_second": 6.93
   },
   {
    "i": 12,
    "start": 17.32,
    "end": 19.81,
    "text": "也无法相互印证",
    "chars_per_second": 2.81
   },
   {
    "i": 13,
    "start": 20.14,
    "end": 21.38,
    "text": "检察机关也认为",
    "chars_per_second": 5.65
   },
   {
    "i": 14,
    "start": 21.53,
    "end": 22.62,
    "text": "原判事实不清",
    "chars_per_second": 5.5
   },
   {
    "i": 15,
    "start": 22.71,
    "end": 23.43,
    "text": "证据不足",
    "chars_per_second": 5.56
   },
   {
    "i": 16,
    "start": 23.78,
    "end": 25.08,
    "text": "二〇一四年十一月",
    "chars_per_second": 5.38
   },
   {
    "i": 17,
    "start": 25.42,
    "end": 27.32,
    "text": "内蒙古高院决定再审",
    "chars_per_second": 4.74
   }
  ]
 },
 "N05": {
  "duration": 28.419,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.19,
    "text": "再审决定书",
    "chars_per_second": 4.81
   },
   {
    "i": 1,
    "start": 1.4,
    "end": 2.84,
    "text": "送到了他父母手里",
    "chars_per_second": 5.56
   },
   {
    "i": 2,
    "start": 3.19,
    "end": 4.28,
    "text": "十二月十五日",
    "chars_per_second": 5.5
   },
   {
    "i": 3,
    "start": 4.63,
    "end": 6.5,
    "text": "内蒙古高院再审宣判",
    "chars_per_second": 4.81
   },
   {
    "i": 4,
    "start": 6.84,
    "end": 8.07,
    "text": "原判事实不清",
    "chars_per_second": 4.88
   },
   {
    "i": 5,
    "start": 8.3,
    "end": 9.02,
    "text": "证据不足",
    "chars_per_second": 5.56
   },
   {
    "i": 6,
    "start": 9.35,
    "end": 10.16,
    "text": "撤销原判",
    "chars_per_second": 4.94
   },
   {
    "i": 7,
    "start": 10.51,
    "end": 12.53,
    "text": "宣告呼格吉勒图无罪",
    "chars_per_second": 4.46
   },
   {
    "i": 8,
    "start": 12.87,
    "end": 13.7,
    "text": "被告席上",
    "chars_per_second": 4.82
   },
   {
    "i": 9,
    "start": 14.04,
    "end": 14.6,
    "text": "是空的",
    "chars_per_second": 5.36
   },
   {
    "i": 10,
    "start": 14.95,
    "end": 15.89,
    "text": "他等这一天",
    "chars_per_second": 5.32
   },
   {
    "i": 11,
    "start": 16.24,
    "end": 17.53,
    "text": "等了十八年",
    "chars_per_second": 3.88
   },
   {
    "i": 12,
    "start": 17.88,
    "end": 18.92,
    "text": "十二月三十日",
    "chars_per_second": 5.77
   },
   {
    "i": 13,
    "start": 19.18,
    "end": 20.66,
    "text": "国家赔偿决定作出",
    "chars_per_second": 5.41
   },
   {
    "i": 14,
    "start": 20.95,
    "end": 22.1,
    "text": "二百零五万余元",
    "chars_per_second": 6.09
   },
   {
    "i": 15,
    "start": 22.44,
    "end": 23.27,
    "text": "可这份清白",
    "chars_per_second": 6.02
   },
   {
    "i": 16,
    "start": 23.54,
    "end": 24.91,
    "text": "迟到了整整十八年",
    "chars_per_second": 5.84
   },
   {
    "i": 17,
    "start": 25.25,
    "end": 26.73,
    "text": "钱能补偿损失",
    "chars_per_second": 4.05
   },
   {
    "i": 18,
    "start": 27.08,
    "end": 28.42,
    "text": "却补不回一个人",
    "chars_per_second": 5.23
   }
  ]
 },
 "N06": {
  "duration": 32.435,
  "clauses": [
   {
    "i": 0,
    "start": 0.09,
    "end": 1.24,
    "text": "但真正的反转",
    "chars_per_second": 5.22
   },
   {
    "i": 1,
    "start": 1.47,
    "end": 2.51,
    "text": "不是真凶出现",
    "chars_per_second": 5.77
   },
   {
    "i": 2,
    "start": 2.85,
    "end": 3.74,
    "text": "二〇一九年",
    "chars_per_second": 4.49
   },
   {
    "i": 3,
    "start": 4.06,
    "end": 6.19,
    "text": "最高人民法院复核赵志红案",
    "chars_per_second": 5.63
   },
   {
    "i": 4,
    "start": 6.54,
    "end": 8.87,
    "text": "对包括这起在内的四起事实",
    "chars_per_second": 5.15
   },
   {
    "i": 5,
    "start": 9.21,
    "end": 9.85,
    "text": "不予确认",
    "chars_per_second": 6.25
   },
   {
    "i": 6,
    "start": 10.03,
    "end": 10.77,
    "text": "并且明确",
    "chars_per_second": 5.41
   },
   {
    "i": 7,
    "start": 11.03,
    "end": 12.66,
    "text": "呼格吉勒图案改判无罪",
    "chars_per_second": 6.13
   },
   {
    "i": 8,
    "start": 12.78,
    "end": 14.03,
    "text": "是因为证据不足",
    "chars_per_second": 5.6
   },
   {
    "i": 9,
    "start": 14.27,
    "end": 16.17,
    "text": "不是因为赵志红自认真凶",
    "chars_per_second": 5.79
   },
   {
    "i": 10,
    "start": 16.52,
    "end": 17.22,
    "text": "这个结论",
    "chars_per_second": 5.71
   },
   {
    "i": 11,
    "start": 17.41,
    "end": 18.93,
    "text": "把故事从传奇",
    "chars_per_second": 3.95
   },
   {
    "i": 12,
    "start": 19.17,
    "end": 19.98,
    "text": "拉回了法律",
    "chars_per_second": 6.17
   },
   {
    "i": 13,
    "start": 20.33,
    "end": 21.75,
    "text": "怀疑不能代替证据",
    "chars_per_second": 5.63
   },
   {
    "i": 14,
    "start": 22.09,
    "end": 23.61,
    "text": "供述不能代替核实",
    "chars_per_second": 5.26
   },
   {
    "i": 15,
    "start": 23.95,
    "end": 24.88,
    "text": "一个人的清白",
    "chars_per_second": 6.45
   },
   {
    "i": 16,
    "start": 25.22,
    "end": 27.14,
    "text": "必须经得起证据的检验",
    "chars_per_second": 5.21
   },
   {
    "i": 17,
    "start": 27.49,
    "end": 28.82,
    "text": "这也是这起案件",
    "chars_per_second": 5.26
   },
   {
    "i": 18,
    "start": 29.12,
    "end": 30.32,
    "text": "留给所有人的问题",
    "chars_per_second": 6.67
   },
   {
    "i": 19,
    "start": 30.65,
    "end": 32.43,
    "text": "这不是一个人的悲剧",
    "chars_per_second": 5.04
   }
  ]
 }
}