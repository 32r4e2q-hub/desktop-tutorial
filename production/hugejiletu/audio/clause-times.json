{
 "N01": {
  "duration": 24.55,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.67,
    "text": "一九九六年四月九日",
    "chars_per_second": 5.88
   },
   {
    "i": 1,
    "start": 1.95,
    "end": 3.21,
    "text": "内蒙古呼和浩特",
    "chars_per_second": 5.56
   },
   {
    "i": 2,
    "start": 3.44,
    "end": 4.84,
    "text": "第一毛纺厂家属区",
    "chars_per_second": 5.71
   },
   {
    "i": 3,
    "start": 5.17,
    "end": 8.8,
    "text": "十八岁的呼格吉勒图在夜里发现女厕所里的异常",
    "chars_per_second": 5.79
   },
   {
    "i": 4,
    "start": 9.14,
    "end": 11.71,
    "text": "拉着同事闫峰跑向治安岗亭报案",
    "chars_per_second": 5.45
   },
   {
    "i": 5,
    "start": 12.06,
    "end": 13.14,
    "text": "可谁也没想到",
    "chars_per_second": 5.56
   },
   {
    "i": 6,
    "start": 13.4,
    "end": 14.68,
    "text": "短短六十二天后",
    "chars_per_second": 5.47
   },
   {
    "i": 7,
    "start": 14.91,
    "end": 16.01,
    "text": "被押上刑场的",
    "chars_per_second": 5.45
   },
   {
    "i": 8,
    "start": 16.25,
    "end": 17.5,
    "text": "正是这个报案的人",
    "chars_per_second": 6.4
   },
   {
    "i": 9,
    "start": 17.85,
    "end": 18.37,
    "text": "那一晚",
    "chars_per_second": 5.77
   },
   {
    "i": 10,
    "start": 18.57,
    "end": 19.66,
    "text": "他只是想帮忙",
    "chars_per_second": 5.5
   },
   {
    "i": 11,
    "start": 20.0,
    "end": 20.55,
    "text": "他以为",
    "chars_per_second": 5.45
   },
   {
    "i": 12,
    "start": 20.79,
    "end": 22.76,
    "text": "报警就能救下那个陌生女人",
    "chars_per_second": 6.09
   },
   {
    "i": 13,
    "start": 23.1,
    "end": 24.55,
    "text": "他还不满十九岁",
    "chars_per_second": 4.83
   }
  ]
 },
 "N02": {
  "duration": 29.192,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.57,
    "text": "当晚",
    "chars_per_second": 4.76
   },
   {
    "i": 1,
    "start": 0.78,
    "end": 2.21,
    "text": "一名二十四岁的女子",
    "chars_per_second": 6.29
   },
   {
    "i": 2,
    "start": 2.55,
    "end": 4.12,
    "text": "在公共女厕所内遇害",
    "chars_per_second": 5.73
   },
   {
    "i": 3,
    "start": 4.47,
    "end": 5.19,
    "text": "报警之后",
    "chars_per_second": 5.56
   },
   {
    "i": 4,
    "start": 5.53,
    "end": 7.1,
    "text": "呼格吉勒图没有回家",
    "chars_per_second": 5.73
   },
   {
    "i": 5,
    "start": 7.45,
    "end": 8.54,
    "text": "他被留在警局",
    "chars_per_second": 5.5
   },
   {
    "i": 6,
    "start": 8.74,
    "end": 9.97,
    "text": "一遍遍接受询问",
    "chars_per_second": 5.69
   },
   {
    "i": 7,
    "start": 10.32,
    "end": 11.92,
    "text": "案件以惊人的速度推进",
    "chars_per_second": 6.25
   },
   {
    "i": 8,
    "start": 12.26,
    "end": 13.07,
    "text": "五月十七日",
    "chars_per_second": 6.17
   },
   {
    "i": 9,
    "start": 13.26,
    "end": 15.18,
    "text": "呼和浩特市中级人民法院一审",
    "chars_per_second": 6.77
   },
   {
    "i": 10,
    "start": 15.52,
    "end": 16.46,
    "text": "以故意杀人罪",
    "chars_per_second": 6.38
   },
   {
    "i": 11,
    "start": 16.66,
    "end": 17.18,
    "text": "流氓罪",
    "chars_per_second": 5.77
   },
   {
    "i": 12,
    "start": 17.36,
    "end": 18.26,
    "text": "判处他死刑",
    "chars_per_second": 5.56
   },
   {
    "i": 13,
    "start": 18.61,
    "end": 19.23,
    "text": "六月五日",
    "chars_per_second": 6.45
   },
   {
    "i": 14,
    "start": 19.48,
    "end": 20.42,
    "text": "上诉被驳回",
    "chars_per_second": 5.32
   },
   {
    "i": 15,
    "start": 20.77,
    "end": 21.44,
    "text": "六月十日",
    "chars_per_second": 5.97
   },
   {
    "i": 16,
    "start": 21.61,
    "end": 22.46,
    "text": "死刑执行",
    "chars_per_second": 4.71
   },
   {
    "i": 17,
    "start": 22.81,
    "end": 24.16,
    "text": "从案发到执行",
    "chars_per_second": 4.44
   },
   {
    "i": 18,
    "start": 24.45,
    "end": 25.42,
    "text": "只有六十二天",
    "chars_per_second": 6.19
   },
   {
    "i": 19,
    "start": 25.77,
    "end": 26.66,
    "text": "这六十二天",
    "chars_per_second": 5.62
   },
   {
    "i": 20,
    "start": 26.97,
    "end": 29.19,
    "text": "成了一条无法挽回的生命线",
    "chars_per_second": 5.4
   }
  ]
 },
 "N03": {
  "duration": 27.23,
  "clauses": [
   {
    "i": 0,
    "start": 0.11,
    "end": 1.59,
    "text": "故事本该到此结束",
    "chars_per_second": 5.41
   },
   {
    "i": 1,
    "start": 1.93,
    "end": 3.99,
    "text": "可九年后的二〇〇五年十月",
    "chars_per_second": 4.85
   },
   {
    "i": 2,
    "start": 4.34,
    "end": 7.29,
    "text": "内蒙古警方抓获了连环案嫌疑人赵志红",
    "chars_per_second": 5.76
   },
   {
    "i": 3,
    "start": 7.64,
    "end": 8.38,
    "text": "审讯中",
    "chars_per_second": 4.05
   },
   {
    "i": 4,
    "start": 8.63,
    "end": 9.6,
    "text": "他主动供称",
    "chars_per_second": 5.15
   },
   {
    "i": 5,
    "start": 9.81,
    "end": 11.47,
    "text": "一九九六年四月九日",
    "chars_per_second": 5.42
   },
   {
    "i": 6,
    "start": 11.81,
    "end": 14.32,
    "text": "毛纺厂家属区女厕所里的那起命案",
    "chars_per_second": 5.98
   },
   {
    "i": 7,
    "start": 14.59,
    "end": 15.39,
    "text": "也是他做的",
    "chars_per_second": 6.25
   },
   {
    "i": 8,
    "start": 15.69,
    "end": 16.35,
    "text": "这句话",
    "chars_per_second": 4.55
   },
   {
    "i": 9,
    "start": 16.51,
    "end": 19.05,
    "text": "让一桩已经尘封的旧案重新被翻开",
    "chars_per_second": 5.91
   },
   {
    "i": 10,
    "start": 19.39,
    "end": 19.98,
    "text": "而这时",
    "chars_per_second": 5.08
   },
   {
    "i": 11,
    "start": 20.25,
    "end": 22.34,
    "text": "距离呼格吉勒图被执行死刑",
    "chars_per_second": 5.74
   },
   {
    "i": 12,
    "start": 22.57,
    "end": 23.56,
    "text": "已经过去九年",
    "chars_per_second": 6.06
   },
   {
    "i": 13,
    "start": 23.9,
    "end": 24.76,
    "text": "没有人想到",
    "chars_per_second": 5.81
   },
   {
    "i": 14,
    "start": 25.01,
    "end": 27.23,
    "text": "这会成为一场漫长申诉的起点",
    "chars_per_second": 5.86
   }
  ]
 },
 "N04": {
  "duration": 26.54,
  "clauses": [
   {
    "i": 0,
    "start": 0.1,
    "end": 1.89,
    "text": "一桩已经执行死刑的案子",
    "chars_per_second": 6.15
   },
   {
    "i": 1,
    "start": 2.11,
    "end": 3.84,
    "text": "忽然多了一个自称凶手的人",
    "chars_per_second": 6.94
   },
   {
    "i": 2,
    "start": 4.18,
    "end": 5.58,
    "text": "记者汤计开始追踪",
    "chars_per_second": 5.71
   },
   {
    "i": 3,
    "start": 5.93,
    "end": 8.21,
    "text": "呼格吉勒图的父母也一次次申诉",
    "chars_per_second": 6.14
   },
   {
    "i": 4,
    "start": 8.47,
    "end": 10.97,
    "text": "可再审要面对的不是一份供述",
    "chars_per_second": 5.2
   },
   {
    "i": 5,
    "start": 11.31,
    "end": 12.86,
    "text": "而是当年的全部证据",
    "chars_per_second": 5.81
   },
   {
    "i": 6,
    "start": 13.2,
    "end": 15.34,
    "text": "供述与尸检报告对不上",
    "chars_per_second": 4.67
   },
   {
    "i": 7,
    "start": 15.68,
    "end": 18.52,
    "text": "指甲缝里的O型血只能证明血型",
    "chars_per_second": 4.93
   },
   {
    "i": 8,
    "start": 18.72,
    "end": 19.8,
    "text": "不能锁定凶手",
    "chars_per_second": 5.56
   },
   {
    "i": 9,
    "start": 20.14,
    "end": 21.73,
    "text": "原判认定的流氓罪",
    "chars_per_second": 5.03
   },
   {
    "i": 10,
    "start": 22.02,
    "end": 23.67,
    "text": "除口供外没有别的证据",
    "chars_per_second": 6.06
   },
   {
    "i": 11,
    "start": 23.85,
    "end": 24.53,
    "text": "这些矛盾",
    "chars_per_second": 5.88
   },
   {
    "i": 12,
    "start": 24.87,
    "end": 26.54,
    "text": "成了再审最重要的入口",
    "chars_per_second": 5.99
   }
  ]
 },
 "N05": {
  "duration": 25.269,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.29,
    "text": "二〇一四年十一月",
    "chars_per_second": 6.09
   },
   {
    "i": 1,
    "start": 1.64,
    "end": 4.36,
    "text": "内蒙古自治区高级人民法院决定再审",
    "chars_per_second": 5.88
   },
   {
    "i": 2,
    "start": 4.7,
    "end": 5.75,
    "text": "十二月十五日",
    "chars_per_second": 5.71
   },
   {
    "i": 3,
    "start": 6.05,
    "end": 6.84,
    "text": "再审判决",
    "chars_per_second": 5.06
   },
   {
    "i": 4,
    "start": 7.11,
    "end": 8.19,
    "text": "原判事实不清",
    "chars_per_second": 5.56
   },
   {
    "i": 5,
    "start": 8.31,
    "end": 8.99,
    "text": "证据不足",
    "chars_per_second": 5.88
   },
   {
    "i": 6,
    "start": 9.3,
    "end": 10.01,
    "text": "撤销原判",
    "chars_per_second": 5.63
   },
   {
    "i": 7,
    "start": 10.36,
    "end": 11.85,
    "text": "宣告呼格吉勒图无罪",
    "chars_per_second": 6.04
   },
   {
    "i": 8,
    "start": 12.17,
    "end": 12.8,
    "text": "十八年",
    "chars_per_second": 4.76
   },
   {
    "i": 9,
    "start": 13.15,
    "end": 14.42,
    "text": "一纸迟到的清白",
    "chars_per_second": 5.51
   },
   {
    "i": 10,
    "start": 14.6,
    "end": 15.69,
    "text": "十二月三十日",
    "chars_per_second": 5.5
   },
   {
    "i": 11,
    "start": 15.9,
    "end": 17.43,
    "text": "国家赔偿决定作出",
    "chars_per_second": 5.23
   },
   {
    "i": 12,
    "start": 17.77,
    "end": 19.31,
    "text": "共计二百零五万余元",
    "chars_per_second": 5.84
   },
   {
    "i": 13,
    "start": 19.66,
    "end": 20.58,
    "text": "可这份清白",
    "chars_per_second": 5.43
   },
   {
    "i": 14,
    "start": 20.75,
    "end": 22.16,
    "text": "迟到了整整十八年",
    "chars_per_second": 5.67
   },
   {
    "i": 15,
    "start": 22.5,
    "end": 23.68,
    "text": "钱能补偿损失",
    "chars_per_second": 5.08
   },
   {
    "i": 16,
    "start": 23.92,
    "end": 25.27,
    "text": "却补不回一个人",
    "chars_per_second": 5.19
   }
  ]
 },
 "N06": {
  "duration": 27.446,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.28,
    "text": "但真正的反转",
    "chars_per_second": 5.31
   },
   {
    "i": 1,
    "start": 1.4,
    "end": 2.64,
    "text": "不是真凶出现",
    "chars_per_second": 4.84
   },
   {
    "i": 2,
    "start": 2.98,
    "end": 3.91,
    "text": "二〇一九年",
    "chars_per_second": 4.3
   },
   {
    "i": 3,
    "start": 4.09,
    "end": 6.45,
    "text": "最高人民法院复核赵志红案时",
    "chars_per_second": 5.51
   },
   {
    "i": 4,
    "start": 6.77,
    "end": 8.96,
    "text": "对包括这起在内的四起事实",
    "chars_per_second": 5.48
   },
   {
    "i": 5,
    "start": 9.09,
    "end": 9.79,
    "text": "不予确认",
    "chars_per_second": 5.71
   },
   {
    "i": 6,
    "start": 10.14,
    "end": 10.73,
    "text": "并明确",
    "chars_per_second": 5.08
   },
   {
    "i": 7,
    "start": 11.06,
    "end": 12.88,
    "text": "呼格吉勒图案改判无罪",
    "chars_per_second": 5.49
   },
   {
    "i": 8,
    "start": 13.14,
    "end": 14.37,
    "text": "是因为证据不足",
    "chars_per_second": 5.69
   },
   {
    "i": 9,
    "start": 14.71,
    "end": 16.49,
    "text": "不是因为赵志红自认真凶",
    "chars_per_second": 6.18
   },
   {
    "i": 10,
    "start": 16.83,
    "end": 18.21,
    "text": "怀疑不能代替证据",
    "chars_per_second": 5.8
   },
   {
    "i": 11,
    "start": 18.55,
    "end": 20.04,
    "text": "供述不能代替核实",
    "chars_per_second": 5.37
   },
   {
    "i": 12,
    "start": 20.38,
    "end": 21.29,
    "text": "一个人的清白",
    "chars_per_second": 6.59
   },
   {
    "i": 13,
    "start": 21.41,
    "end": 22.93,
    "text": "必须经得起证据的检验",
    "chars_per_second": 6.58
   },
   {
    "i": 14,
    "start": 23.27,
    "end": 24.27,
    "text": "这也是这起案件",
    "chars_per_second": 7.0
   },
   {
    "i": 15,
    "start": 24.45,
    "end": 25.63,
    "text": "留给所有人的问题",
    "chars_per_second": 6.78
   },
   {
    "i": 16,
    "start": 25.98,
    "end": 27.45,
    "text": "这不是一个人的悲剧",
    "chars_per_second": 6.14
   }
  ]
 }
}