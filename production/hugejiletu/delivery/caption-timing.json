[
  {
    "start": 0.6901067335713136,
    "end": 2.8026090428543338,
    "text": "一九九六年四月九日的夜里。"
  },
  {
    "start": 3.0228699471397666,
    "end": 3.8939017049957987,
    "text": "呼和浩特，"
  },
  {
    "start": 4.154210046424038,
    "end": 5.655988939279265,
    "text": "第一毛纺厂家属区。"
  },
  {
    "start": 5.94633285856461,
    "end": 7.488159188562642,
    "text": "十八岁的呼格吉勒图，"
  },
  {
    "start": 7.758479389276584,
    "end": 9.009961799989272,
    "text": "在公共女厕所里，"
  },
  {
    "start": 9.270270141417512,
    "end": 11.1725234057008,
    "text": "看见了他不该看见的东西。"
  },
  {
    "start": 11.272641998557816,
    "end": 12.614231142841819,
    "text": "他拉着同事闫峰，"
  },
  {
    "start": 12.904575062127163,
    "end": 15.107184104981494,
    "text": "跑向几十米外的治安岗亭报案。"
  },
  {
    "start": 15.277385712838422,
    "end": 16.90931877640777,
    "text": "可被留下反复问话的，"
  },
  {
    "start": 17.0995441028361,
    "end": 17.810386112120906,
    "text": "不是别人，"
  },
  {
    "start": 17.980587719977834,
    "end": 18.461156965691504,
    "text": "是他。"
  },
  {
    "start": 18.75150088497685,
    "end": 20.61370671211733,
    "text": "案子推进得快得反常。"
  },
  {
    "start": 20.894038772116975,
    "end": 21.755058670687305,
    "text": "五月十七日，"
  },
  {
    "start": 21.93527213782993,
    "end": 22.756244599257453,
    "text": "一审开庭，"
  },
  {
    "start": 22.936458066400082,
    "end": 24.03776258782725,
    "text": "当天判了死刑。"
  },
  {
    "start": 24.30808278854119,
    "end": 25.7097430885394,
    "text": "从报案到死刑，"
  },
  {
    "start": 25.839897259253522,
    "end": 26.94120178068069,
    "text": "只有三十八天。"
  },
  {
    "start": 27.231545699966034,
    "end": 28.61510122108927,
    "text": "他还不满十九岁。"
  },
  {
    "start": 29.815243532517684,
    "end": 30.556121119659597,
    "text": "他不认罪。"
  },
  {
    "start": 30.756358305373627,
    "end": 31.527271470372643,
    "text": "上诉状上，"
  },
  {
    "start": 31.74753237465808,
    "end": 32.66862342894262,
    "text": "他写下一句话："
  },
  {
    "start": 32.848836896085245,
    "end": 34.04024815108372,
    "text": "我没有杀人动机。"
  },
  {
    "start": 34.280532773940564,
    "end": 34.96133920536826,
    "text": "六月五日，"
  },
  {
    "start": 35.07146965751098,
    "end": 35.8724184003671,
    "text": "二审开庭，"
  },
  {
    "start": 36.07265558608113,
    "end": 36.85358061036585,
    "text": "当天驳回，"
  },
  {
    "start": 37.02378221822278,
    "end": 37.75464794607899,
    "text": "维持原判。"
  },
  {
    "start": 38.014956287507225,
    "end": 38.78586945250624,
    "text": "卷宗合上，"
  },
  {
    "start": 39.04617779393448,
    "end": 40.157494174647354,
    "text": "一个十八岁的人，"
  },
  {
    "start": 40.27763648607577,
    "end": 41.01851407321768,
    "text": "成了死囚。"
  },
  {
    "start": 41.27882241464592,
    "end": 42.68048271464413,
    "text": "从案发到执行，"
  },
  {
    "start": 42.96081477464378,
    "end": 43.72171608035709,
    "text": "六十二天。"
  },
  {
    "start": 43.95198884392823,
    "end": 44.72290200892724,
    "text": "六月十日，"
  },
  {
    "start": 45.003234068926886,
    "end": 45.724087937497394,
    "text": "天还没亮，"
  },
  {
    "start": 45.93433698249713,
    "end": 46.62515527321053,
    "text": "他被带走。"
  },
  {
    "start": 46.91549919249587,
    "end": 48.55744411535092,
    "text": "他的父母在门外等了一夜，"
  },
  {
    "start": 48.82776431606486,
    "end": 49.90904511892062,
    "text": "等来的不是儿子。"
  },
  {
    "start": 50.19938903820597,
    "end": 51.020361499633495,
    "text": "从那天起，"
  },
  {
    "start": 51.17053938891902,
    "end": 52.181737176774874,
    "text": "他们开始申诉。"
  },
  {
    "start": 52.46206923677451,
    "end": 53.66349235105869,
    "text": "一年又一年，"
  },
  {
    "start": 53.94382441105834,
    "end": 54.704725716771655,
    "text": "十年。"
  },
  {
    "start": 55.85480873177156,
    "end": 56.7558760674847,
    "text": "故事到这里，"
  },
  {
    "start": 56.95611325319873,
    "end": 57.767073855340556,
    "text": "本该结束。"
  },
  {
    "start": 58.04740591534019,
    "end": 60.46026400319426,
    "text": "可九年后的二〇〇五年十月，"
  },
  {
    "start": 60.7506079224796,
    "end": 63.043323698905255,
    "text": "内蒙古警方破获一系列案件，"
  },
  {
    "start": 63.22353716604788,
    "end": 64.30481796890365,
    "text": "抓到了赵志红。"
  },
  {
    "start": 64.59516188818898,
    "end": 65.42614620890221,
    "text": "押解车上，"
  },
  {
    "start": 65.65641897247335,
    "end": 66.6976523381863,
    "text": "他一直低着头。"
  },
  {
    "start": 66.80778279032901,
    "end": 67.55867223675664,
    "text": "审讯中，"
  },
  {
    "start": 67.63876711104224,
    "end": 68.59990560246959,
    "text": "他主动开口："
  },
  {
    "start": 68.89024952175494,
    "end": 70.37200469603876,
    "text": "四月九日那起命案，"
  },
  {
    "start": 70.39202841461017,
    "end": 71.2230127353234,
    "text": "也是他做的。"
  },
  {
    "start": 71.52336851389444,
    "end": 72.29428167889346,
    "text": "两本案卷，"
  },
  {
    "start": 72.48450700532177,
    "end": 74.00630961674841,
    "text": "被摆到了同一张桌上。"
  },
  {
    "start": 74.29665353603376,
    "end": 74.79724650031883,
    "text": "这时，"
  },
  {
    "start": 74.95743624889006,
    "end": 77.27017574388711,
    "text": "距离呼格吉勒图被执行死刑，"
  },
  {
    "start": 77.39031805531553,
    "end": 78.5617055917426,
    "text": "已经过去九年。"
  },
  {
    "start": 78.85204951102794,
    "end": 80.20365051459765,
    "text": "有一个人开始追问。"
  },
  {
    "start": 80.48398257459729,
    "end": 81.15477714673929,
    "text": "一个电话，"
  },
  {
    "start": 81.43510920673893,
    "end": 82.48134850209475,
    "text": "接一个电话。"
  },
  {
    "start": 83.61140779852325,
    "end": 84.68267674209332,
    "text": "他的父母还在等。"
  },
  {
    "start": 84.97302066137865,
    "end": 85.8540642785204,
    "text": "二〇一四年，"
  },
  {
    "start": 85.99423030852022,
    "end": 87.59612779423246,
    "text": "这起案子被重新翻开，"
  },
  {
    "start": 87.8764598542321,
    "end": 88.80756276780234,
    "text": "当年的证据，"
  },
  {
    "start": 88.95774065708787,
    "end": 90.65975673565713,
    "text": "要一条一条重新核对。"
  },
  {
    "start": 90.96011251422817,
    "end": 92.30170165851217,
    "text": "供述和尸检报告，"
  },
  {
    "start": 92.4819151256548,
    "end": 92.99251994922557,
    "text": "对不上。"
  },
  {
    "start": 93.27285200922522,
    "end": 95.00490366565158,
    "text": "指甲缝里的血是O型，"
  },
  {
    "start": 95.28523572565122,
    "end": 96.41657582493549,
    "text": "可呼格吉勒图也是O型。"
  },
  {
    "start": 96.41657582493549,
    "end": 97.33766687922002,
    "text": "血型只能说明类型，"
  },
  {
    "start": 97.62801079850537,
    "end": 99.42013361064595,
    "text": "锁不住一个人。"
  },
  {
    "start": 99.58032335921718,
    "end": 100.65159230278724,
    "text": "证据和证据之间，"
  },
  {
    "start": 100.88186506635837,
    "end": 103.43488918421225,
    "text": "也无法相互印证。"
  },
  {
    "start": 103.70520938492619,
    "end": 105.00675109206739,
    "text": "检察机关也认为："
  },
  {
    "start": 105.09685782563871,
    "end": 106.24822164349438,
    "text": "原判事实不清，"
  },
  {
    "start": 106.27825722135148,
    "end": 107.05918224563621,
    "text": "证据不足。"
  },
  {
    "start": 107.34952616492154,
    "end": 108.71113902777695,
    "text": "二〇一四年十一月，"
  },
  {
    "start": 108.9914710877766,
    "end": 110.91374807063129,
    "text": "内蒙古高院决定再审。"
  },
  {
    "start": 112.1239022413454,
    "end": 113.22520676277257,
    "text": "再审决定书，"
  },
  {
    "start": 113.37538465205809,
    "end": 114.87716354491332,
    "text": "送到了他父母手里。"
  },
  {
    "start": 115.16750746419866,
    "end": 116.31887128205435,
    "text": "十二月十五日，"
  },
  {
    "start": 116.60921520133968,
    "end": 118.54150404348007,
    "text": "内蒙古高院再审宣判。"
  },
  {
    "start": 118.82183610347971,
    "end": 120.11336595133521,
    "text": "原判事实不清，"
  },
  {
    "start": 120.28356755919214,
    "end": 121.06449258347686,
    "text": "证据不足——"
  },
  {
    "start": 121.3348127841908,
    "end": 122.20584454204683,
    "text": "撤销原判，"
  },
  {
    "start": 122.49618846133217,
    "end": 124.57865519275809,
    "text": "宣告呼格吉勒图无罪。"
  },
  {
    "start": 124.85898725275773,
    "end": 125.75004272918517,
    "text": "被告席上，"
  },
  {
    "start": 126.0303747891848,
    "end": 126.6511100648983,
    "text": "是空的。"
  },
  {
    "start": 126.94145398418365,
    "end": 127.9426399127538,
    "text": "他等这一天，"
  },
  {
    "start": 128.23298383203914,
    "end": 129.58458483560884,
    "text": "等了十八年。"
  },
  {
    "start": 129.8749287548942,
    "end": 130.97623327632135,
    "text": "十二月三十日，"
  },
  {
    "start": 131.17647046203538,
    "end": 132.7182967920334,
    "text": "国家赔偿决定作出，"
  },
  {
    "start": 132.94856955560456,
    "end": 134.16000452917444,
    "text": "二百零五万余元。"
  },
  {
    "start": 134.44033658917408,
    "end": 135.3313920656015,
    "text": "可这份清白，"
  },
  {
    "start": 135.54164111060123,
    "end": 136.97333698845657,
    "text": "迟到了整整十八年。"
  },
  {
    "start": 137.2536690484562,
    "end": 138.79549537845423,
    "text": "钱能补偿损失，"
  },
  {
    "start": 139.0858392977396,
    "end": 140.44688899351019,
    "text": "却补不回一个人。"
  },
  {
    "start": 141.59697200851008,
    "end": 142.80840698207996,
    "text": "但真正的反转，"
  },
  {
    "start": 142.9786085899369,
    "end": 144.07991311136405,
    "text": "不是真凶出现。"
  },
  {
    "start": 144.3602451713637,
    "end": 145.31137180350535,
    "text": "二〇一九年，"
  },
  {
    "start": 145.5716801449336,
    "end": 147.7642773285022,
    "text": "最高人民法院复核赵志红案，"
  },
  {
    "start": 148.05462124778757,
    "end": 150.4474556170702,
    "text": "对包括这起在内的四起事实，"
  },
  {
    "start": 150.72778767706987,
    "end": 151.42861782706896,
    "text": "不予确认。"
  },
  {
    "start": 151.54876013849739,
    "end": 152.3497088813535,
    "text": "并且明确："
  },
  {
    "start": 152.54994606706754,
    "end": 154.24195028635108,
    "text": "呼格吉勒图案改判无罪，"
  },
  {
    "start": 154.3020214420653,
    "end": 155.6135750084922,
    "text": "是因为证据不足，"
  },
  {
    "start": 155.79378847563484,
    "end": 157.75611289563233,
    "text": "不是因为赵志红自认真凶。"
  },
  {
    "start": 158.04645681491766,
    "end": 158.807358120631,
    "text": "这个结论，"
  },
  {
    "start": 158.93751229134512,
    "end": 160.51938605848594,
    "text": "把故事从传奇，"
  },
  {
    "start": 160.69959952562857,
    "end": 161.5706312834846,
    "text": "拉回了法律。"
  },
  {
    "start": 161.86097520276994,
    "end": 163.34273037705378,
    "text": "怀疑不能代替证据，"
  },
  {
    "start": 163.62306243705342,
    "end": 165.20493620419427,
    "text": "供述不能代替核实。"
  },
  {
    "start": 165.4852682641939,
    "end": 166.47644233347836,
    "text": "一个人的清白，"
  },
  {
    "start": 166.756774393478,
    "end": 168.73912253204688,
    "text": "必须经得起证据的检验。"
  },
  {
    "start": 169.02946645133224,
    "end": 170.42111489204476,
    "text": "这也是这起案件，"
  },
  {
    "start": 170.66139951490158,
    "end": 171.92289378489997,
    "text": "留给所有人的问题。"
  },
  {
    "start": 172.1932139856139,
    "end": 174.0,
    "text": "这不是一个人的悲剧。"
  }
]