[
  {
    "start": 0.7258209345293742,
    "end": 2.392948317043582,
    "text": "一九九六年四月九日，"
  },
  {
    "start": 2.623620030347435,
    "end": 4.007650310170551,
    "text": "内蒙古呼和浩特，"
  },
  {
    "start": 4.185896634087165,
    "end": 5.716718004194551,
    "text": "第一毛纺厂家属区。"
  },
  {
    "start": 5.999815106885643,
    "end": 9.8688088436639,
    "text": "十八岁的呼格吉勒图在夜里发现女厕所里的异常，"
  },
  {
    "start": 10.16239102423244,
    "end": 12.919966506001224,
    "text": "拉着同事闫峰跑向治安岗亭报案。"
  },
  {
    "start": 13.224033764447212,
    "end": 14.419332642476267,
    "text": "可谁也没想到，"
  },
  {
    "start": 14.629034200025224,
    "end": 16.034034635603234,
    "text": "短短六十二天后，"
  },
  {
    "start": 16.212280959519852,
    "end": 17.4285499933038,
    "text": "被押上刑场的，"
  },
  {
    "start": 17.617281395097862,
    "end": 18.99082659704353,
    "text": "正是这个报案的人。"
  },
  {
    "start": 19.29489385548952,
    "end": 19.903028372381495,
    "text": "那一晚，"
  },
  {
    "start": 20.049819462665763,
    "end": 21.255603418572267,
    "text": "他只是想帮忙；"
  },
  {
    "start": 21.549185599140806,
    "end": 22.188775349665125,
    "text": "他以为，"
  },
  {
    "start": 22.377506751459187,
    "end": 24.5059775605811,
    "text": "报警就能救下那个陌生女人。"
  },
  {
    "start": 24.799559741149643,
    "end": 26.341324911291615,
    "text": "他还不满十九岁。"
  },
  {
    "start": 27.557630923698436,
    "end": 28.060914661815932,
    "text": "当晚，"
  },
  {
    "start": 28.21819082997765,
    "end": 29.78046743371738,
    "text": "一名二十四岁的女子，"
  },
  {
    "start": 30.07404961428592,
    "end": 31.78311730830992,
    "text": "在公共女厕所内遇害。"
  },
  {
    "start": 32.08718456675591,
    "end": 32.90502064119684,
    "text": "报警之后，"
  },
  {
    "start": 33.19860282176538,
    "end": 34.90767051578938,
    "text": "呼格吉勒图没有回家，"
  },
  {
    "start": 35.21173777423537,
    "end": 36.41752173014187,
    "text": "他被留在警局，"
  },
  {
    "start": 36.56431282042614,
    "end": 37.91688786661691,
    "text": "一遍遍接受询问。"
  },
  {
    "start": 38.2209551250629,
    "end": 39.961478052719244,
    "text": "案件以惊人的速度推进："
  },
  {
    "start": 40.25506023328778,
    "end": 41.16726200862574,
    "text": "五月十七日，"
  },
  {
    "start": 41.30356802103257,
    "end": 43.379613440767244,
    "text": "呼和浩特市中级人民法院一审，"
  },
  {
    "start": 43.67319562133578,
    "end": 44.72170340908056,
    "text": "以故意杀人罪、"
  },
  {
    "start": 44.868494499364836,
    "end": 45.47662901625681,
    "text": "流氓罪，"
  },
  {
    "start": 45.60244995078618,
    "end": 46.60901742702118,
    "text": "判处他死刑；"
  },
  {
    "start": 46.91308468546717,
    "end": 47.626069981133625,
    "text": "六月五日，"
  },
  {
    "start": 47.82528646080513,
    "end": 48.87379424854991,
    "text": "上诉被驳回；"
  },
  {
    "start": 49.1778615069959,
    "end": 49.94327219204959,
    "text": "六月十日，"
  },
  {
    "start": 50.05860804870152,
    "end": 51.012750135549275,
    "text": "死刑执行。"
  },
  {
    "start": 51.316817393995265,
    "end": 52.79521337471541,
    "text": "从案发到执行，"
  },
  {
    "start": 53.03637016589671,
    "end": 54.11633318727384,
    "text": "只有六十二天——"
  },
  {
    "start": 54.42040044571983,
    "end": 55.41648284407737,
    "text": "这六十二天，"
  },
  {
    "start": 55.67860979101357,
    "end": 58.029604534172066,
    "text": "成了一条无法挽回的生命线。"
  },
  {
    "start": 59.2039702350691,
    "end": 60.81867222819607,
    "text": "故事本该到此结束。"
  },
  {
    "start": 61.11225440876461,
    "end": 63.33509091878356,
    "text": "可九年后的二〇〇五年十月，"
  },
  {
    "start": 63.63915817722954,
    "end": 66.79516661834134,
    "text": "内蒙古警方抓获了连环案嫌疑人赵志红。"
  },
  {
    "start": 67.09923387678734,
    "end": 67.93804010698317,
    "text": "审讯中，"
  },
  {
    "start": 68.13725658665467,
    "end": 69.2172196080318,
    "text": "他主动供称："
  },
  {
    "start": 69.37449577619351,
    "end": 71.17792917111454,
    "text": "一九九六年四月九日，"
  },
  {
    "start": 71.47151135168309,
    "end": 74.16617636618719,
    "text": "毛纺厂家属区女厕所里的那起命案，"
  },
  {
    "start": 74.38636300161359,
    "end": 75.2880796990741,
    "text": "也是他做的。"
  },
  {
    "start": 75.53972156813285,
    "end": 76.2946471753091,
    "text": "这句话，"
  },
  {
    "start": 76.39949795408359,
    "end": 79.12561820222001,
    "text": "让一桩已经尘封的旧案重新被翻开。"
  },
  {
    "start": 79.41920038278856,
    "end": 80.10073044482266,
    "text": "而这时，"
  },
  {
    "start": 80.32091708024907,
    "end": 82.57520882390035,
    "text": "距离呼格吉勒图被执行死刑，"
  },
  {
    "start": 82.75345514781698,
    "end": 83.854388324949,
    "text": "已经过去九年。"
  },
  {
    "start": 84.14797050551753,
    "end": 85.11259767024274,
    "text": "没有人想到，"
  },
  {
    "start": 85.31181414991426,
    "end": 87.66047159446256,
    "text": "这会成为一场漫长申诉的起点。"
  },
  {
    "start": 88.82435221748216,
    "end": 90.76409162481,
    "text": "一桩已经执行死刑的案子，"
  },
  {
    "start": 90.93185287084918,
    "end": 92.80868181091235,
    "text": "忽然多了一个自称凶手的人。"
  },
  {
    "start": 93.10226399148088,
    "end": 94.63308536158827,
    "text": "记者汤计开始追踪，"
  },
  {
    "start": 94.93715262003425,
    "end": 97.39066084335705,
    "text": "呼格吉勒图的父母也一次次申诉。"
  },
  {
    "start": 97.60036240090601,
    "end": 100.28454233753266,
    "text": "可再审要面对的不是一份供述，"
  },
  {
    "start": 100.5781245181012,
    "end": 102.2662220563703,
    "text": "而是当年的全部证据："
  },
  {
    "start": 102.55980423693885,
    "end": 104.86652136997736,
    "text": "供述与尸检报告对不上，"
  },
  {
    "start": 105.16010355054591,
    "end": 108.20077613500578,
    "text": "指甲缝里的O型血只能证明血型，"
  },
  {
    "start": 108.34756722529005,
    "end": 109.54286610331911,
    "text": "不能锁定凶手；"
  },
  {
    "start": 109.83644828388765,
    "end": 111.56648613366654,
    "text": "原判认定的流氓罪，"
  },
  {
    "start": 111.80764292484784,
    "end": 113.60059124189144,
    "text": "除口供外没有别的证据。"
  },
  {
    "start": 113.72641217642081,
    "end": 114.50230793935194,
    "text": "这些矛盾，"
  },
  {
    "start": 114.79589011992049,
    "end": 116.56793381294591,
    "text": "成了再审最重要的入口。"
  },
  {
    "start": 117.77375474747528,
    "end": 119.04244917064648,
    "text": "二〇一四年十一月，"
  },
  {
    "start": 119.34651642909246,
    "end": 122.26136807902296,
    "text": "内蒙古自治区高级人民法院决定再审。"
  },
  {
    "start": 122.55495025959151,
    "end": 123.71879390398821,
    "text": "十二月十五日，"
  },
  {
    "start": 123.97043577304696,
    "end": 124.86166739263003,
    "text": "再审判决："
  },
  {
    "start": 125.08185402805644,
    "end": 126.27715290608549,
    "text": "原判事实不清、"
  },
  {
    "start": 126.34006337335018,
    "end": 127.11595913628132,
    "text": "证据不足，"
  },
  {
    "start": 127.37808608321751,
    "end": 128.185437079781,
    "text": "撤销原判，"
  },
  {
    "start": 128.489504338227,
    "end": 130.1146914092314,
    "text": "宣告呼格吉勒图无罪。"
  },
  {
    "start": 130.38730343404504,
    "end": 131.11077380758894,
    "text": "十八年，"
  },
  {
    "start": 131.41484106603494,
    "end": 132.8093564237355,
    "text": "一纸迟到的清白。"
  },
  {
    "start": 132.93517735826487,
    "end": 134.14096131417136,
    "text": "十二月三十日，"
  },
  {
    "start": 134.2982374823331,
    "end": 135.9653648648473,
    "text": "国家赔偿决定作出，"
  },
  {
    "start": 136.25894704541585,
    "end": 137.9365595058075,
    "text": "共计二百零五万余元。"
  },
  {
    "start": 138.24062676425348,
    "end": 139.26816439624338,
    "text": "可这份清白，"
  },
  {
    "start": 139.38350025289532,
    "end": 140.92480670088014,
    "text": "迟到了整整十八年；"
  },
  {
    "start": 141.21838888144867,
    "end": 142.51853853825222,
    "text": "钱能补偿损失，"
  },
  {
    "start": 142.70726994004627,
    "end": 144.14230575496072,
    "text": "却补不回一个人。"
  },
  {
    "start": 145.35861176736756,
    "end": 146.60633603478385,
    "text": "但真正的反转，"
  },
  {
    "start": 146.66924650204854,
    "end": 148.03230662611676,
    "text": "不是真凶出现。"
  },
  {
    "start": 148.3258888066853,
    "end": 149.36391151655263,
    "text": "二〇一九年，"
  },
  {
    "start": 149.489732451082,
    "end": 152.02712129742437,
    "text": "最高人民法院复核赵志红案时，"
  },
  {
    "start": 152.29973332223804,
    "end": 154.65887584466378,
    "text": "对包括这起在内的四起事实，"
  },
  {
    "start": 154.73227138980593,
    "end": 155.52913730849195,
    "text": "不予确认，"
  },
  {
    "start": 155.83320456693795,
    "end": 156.51473462897206,
    "text": "并明确："
  },
  {
    "start": 156.79783173166317,
    "end": 158.76902637262336,
    "text": "呼格吉勒图案改判无罪，"
  },
  {
    "start": 158.9787279301723,
    "end": 160.33130297636308,
    "text": "是因为证据不足，"
  },
  {
    "start": 160.6248851569316,
    "end": 162.554139486382,
    "text": "不是因为赵志红自认真凶。"
  },
  {
    "start": 162.84772166695058,
    "end": 164.35757288130304,
    "text": "怀疑不能代替证据，"
  },
  {
    "start": 164.6511550618716,
    "end": 166.276342132876,
    "text": "供述不能代替核实。"
  },
  {
    "start": 166.56992431344455,
    "end": 167.58697686755698,
    "text": "一个人的清白，"
  },
  {
    "start": 167.64988733482167,
    "end": 169.30652963945843,
    "text": "必须经得起证据的检验。"
  },
  {
    "start": 169.600111820027,
    "end": 170.71153007503645,
    "text": "这也是这起案件，"
  },
  {
    "start": 170.83735100956582,
    "end": 172.13750066636936,
    "text": "留给所有人的问题。"
  },
  {
    "start": 172.44156792481536,
    "end": 174.0,
    "text": "这不是一个人的悲剧。"
  }
]