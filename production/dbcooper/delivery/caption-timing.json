[
  {
    "start": 0.6,
    "end": 3.139912917271408,
    "text": "一九七一年十一月二十四日，"
  },
  {
    "start": 3.139912917271408,
    "end": 4.765457184325108,
    "text": "感恩节前一天，"
  },
  {
    "start": 4.765457184325108,
    "end": 5.92365747460087,
    "text": "波特兰。"
  },
  {
    "start": 5.92365747460087,
    "end": 8.849637155297533,
    "text": "一名自称丹·库珀的男子，"
  },
  {
    "start": 8.849637155297533,
    "end": 11.145718432510886,
    "text": "用现金买了一张单程票，"
  },
  {
    "start": 11.145718432510886,
    "end": 13.909143686502176,
    "text": "登上西北航空三百零五班机。"
  },
  {
    "start": 13.909143686502176,
    "end": 16.20522496371553,
    "text": "他四十岁上下，"
  },
  {
    "start": 16.20522496371553,
    "end": 18.155878084179975,
    "text": "穿西装打黑领带，"
  },
  {
    "start": 18.155878084179975,
    "end": 19.334397677793906,
    "text": "样子平淡。"
  },
  {
    "start": 19.334397677793906,
    "end": 20.919303338171265,
    "text": "起飞后，"
  },
  {
    "start": 20.919303338171265,
    "end": 23.5811320754717,
    "text": "他要了一杯波本加苏打水。"
  },
  {
    "start": 23.5811320754717,
    "end": 28.051378809869377,
    "text": "没有人注意到他——而这架飞机，"
  },
  {
    "start": 28.051378809869377,
    "end": 29.981712626995648,
    "text": "将改写美国民航史。"
  },
  {
    "start": 31.06171262699565,
    "end": 33.174920174165464,
    "text": "起飞后不到一小时，"
  },
  {
    "start": 33.174920174165464,
    "end": 35.81642960812773,
    "text": "他把一张纸条递给后舱的空姐："
  },
  {
    "start": 35.81642960812773,
    "end": 38.13283018867925,
    "text": "我手提箱里有炸弹，"
  },
  {
    "start": 38.13283018867925,
    "end": 39.73805515239478,
    "text": "请你坐到我身边。"
  },
  {
    "start": 39.73805515239478,
    "end": 42.66403483309144,
    "text": "他打开那个廉价手提箱，"
  },
  {
    "start": 42.66403483309144,
    "end": 45.305544267053705,
    "text": "露出里面一团电线和红火柴，"
  },
  {
    "start": 45.305544267053705,
    "end": 47.784499274310605,
    "text": "要求她记下他说的每个字。"
  },
  {
    "start": 47.784499274310605,
    "end": 49.51164005805516,
    "text": "随后，"
  },
  {
    "start": 49.51164005805516,
    "end": 51.11686502177069,
    "text": "条件递进了驾驶舱："
  },
  {
    "start": 51.11686502177069,
    "end": 52.92528301886793,
    "text": "二十万美元，"
  },
  {
    "start": 52.92528301886793,
    "end": 55.20104499274311,
    "text": "只要二十美元面额的钞票，"
  },
  {
    "start": 55.20104499274311,
    "end": 57.02978229317852,
    "text": "还要四个降落伞。"
  },
  {
    "start": 58.10978229317852,
    "end": 59.64388969521045,
    "text": "西雅图上空，"
  },
  {
    "start": 59.64388969521045,
    "end": 62.000928882438316,
    "text": "飞机盘旋了两个多小时，"
  },
  {
    "start": 62.021248185776486,
    "end": 64.39860667634252,
    "text": "等银行把钱装进帆布袋。"
  },
  {
    "start": 64.88626995645863,
    "end": 66.7556458635704,
    "text": "傍晚五点四十六分，"
  },
  {
    "start": 66.8166037735849,
    "end": 69.07204644412192,
    "text": "三十六名乘客全部下机，"
  },
  {
    "start": 69.13300435413643,
    "end": 71.24621190130624,
    "text": "只留下四名机组人员。"
  },
  {
    "start": 71.73387518142235,
    "end": 74.33474600870827,
    "text": "钱和四个降落伞装上飞机，"
  },
  {
    "start": 74.33474600870827,
    "end": 75.57422351233672,
    "text": "它再次起飞，"
  },
  {
    "start": 75.77741654571844,
    "end": 76.40731494920173,
    "text": "航线："
  },
  {
    "start": 76.5698693759071,
    "end": 77.62647314949201,
    "text": "墨西哥城。"
  },
  {
    "start": 78.50020319303339,
    "end": 79.94287373004354,
    "text": "库珀下了新指令："
  },
  {
    "start": 80.16638606676342,
    "end": 81.58873730043541,
    "text": "一万英尺以下，"
  },
  {
    "start": 81.75129172714078,
    "end": 83.72226415094339,
    "text": "速度不超过二百节。"
  },
  {
    "start": 84.25056603773585,
    "end": 86.56696661828737,
    "text": "飞机低低地掠过山谷。"
  },
  {
    "start": 88.50037735849057,
    "end": 90.04464441219159,
    "text": "晚上八点十三分，"
  },
  {
    "start": 90.04464441219159,
    "end": 91.75146589259796,
    "text": "机尾忽然一轻，"
  },
  {
    "start": 92.0156168359942,
    "end": 95.40894049346879,
    "text": "客舱压力骤降——他打开后舱门，"
  },
  {
    "start": 95.51053701015965,
    "end": 96.7500145137881,
    "text": "跳进了黑夜。"
  },
  {
    "start": 97.33927431059507,
    "end": 98.76162554426705,
    "text": "那晚温度低，"
  },
  {
    "start": 98.86322206095791,
    "end": 99.45248185776488,
    "text": "风大。"
  },
  {
    "start": 100.10269956458636,
    "end": 102.45973875181423,
    "text": "搜救从飞机记录的位置开始，"
  },
  {
    "start": 102.84580551523948,
    "end": 106.23912917271407,
    "text": "飞机和直升机在山区与河谷间搜索，"
  },
  {
    "start": 106.3610449927431,
    "end": 107.35669085631349,
    "text": "直到凌晨，"
  },
  {
    "start": 107.53956458635705,
    "end": 108.57584905660377,
    "text": "一无所获。"
  },
  {
    "start": 109.30734397677793,
    "end": 110.89224963715529,
    "text": "联邦调查局也写道："
  },
  {
    "start": 111.21735849056603,
    "end": 111.86757619738752,
    "text": "也许，"
  },
  {
    "start": 111.96917271407838,
    "end": 113.7775907111756,
    "text": "他没能撑过那一跳。"
  },
  {
    "start": 115.0099854862119,
    "end": 117.40766328011611,
    "text": "案子没有随着黑夜结束。"
  },
  {
    "start": 117.40766328011611,
    "end": 119.58182873730044,
    "text": "一九八零年十一月，"
  },
  {
    "start": 119.58182873730044,
    "end": 121.10577648766328,
    "text": "哥伦比亚河畔，"
  },
  {
    "start": 121.10577648766328,
    "end": 123.74728592162555,
    "text": "有人发现一袋腐烂的钞票："
  },
  {
    "start": 123.74728592162555,
    "end": 125.4744267053701,
    "text": "五千八百美元，"
  },
  {
    "start": 125.4744267053701,
    "end": 128.44104499274312,
    "text": "编号与当年记录的完全吻合。"
  },
  {
    "start": 128.44104499274312,
    "end": 130.51361393323657,
    "text": "领带上的DNA、"
  },
  {
    "start": 130.51361393323657,
    "end": 131.16383164005805,
    "text": "指纹，"
  },
  {
    "start": 131.16383164005805,
    "end": 132.52522496371554,
    "text": "比对了一圈，"
  },
  {
    "start": 132.52522496371554,
    "end": 134.13044992743107,
    "text": "没有给出名字。"
  },
  {
    "start": 134.13044992743107,
    "end": 135.77631349782294,
    "text": "头五年，"
  },
  {
    "start": 135.77631349782294,
    "end": 138.05207547169812,
    "text": "八百多名嫌疑人被核查，"
  },
  {
    "start": 138.05207547169812,
    "end": 140.13480406386066,
    "text": "只剩二十几人。"
  },
  {
    "start": 140.13480406386066,
    "end": 141.64859216255442,
    "text": "线索越来越多，"
  },
  {
    "start": 141.64859216255442,
    "end": 144.7168069666183,
    "text": "谜底却没有近一步。"
  },
  {
    "start": 145.79680696661828,
    "end": 147.16835994194483,
    "text": "二〇一六年，"
  },
  {
    "start": 147.16835994194483,
    "end": 151.76052249637155,
    "text": "联邦调查局宣布不再主动追查这个悬了四十五年的"
  },
  {
    "start": 151.76052249637155,
    "end": 152.26850507982581,
    "text": "案子。"
  },
  {
    "start": 152.39042089985486,
    "end": 154.6255442670537,
    "text": "它是美国民航史上，"
  },
  {
    "start": 154.6255442670537,
    "end": 157.83599419448475,
    "text": "唯一一起至今未破的劫机案。"
  },
  {
    "start": 158.42525399129173,
    "end": 160.74165457184324,
    "text": "他留下一个名字——那个名字，"
  },
  {
    "start": 160.74165457184324,
    "end": 162.44847605224962,
    "text": "还是媒体印错的。"
  },
  {
    "start": 162.91582002902757,
    "end": 163.70827285921624,
    "text": "飞机、"
  },
  {
    "start": 163.9521044992743,
    "end": 164.43976777939042,
    "text": "钱、"
  },
  {
    "start": 164.68359941944846,
    "end": 165.49637155297532,
    "text": "降落伞、"
  },
  {
    "start": 165.7198838896952,
    "end": 166.3701015965167,
    "text": "领带，"
  },
  {
    "start": 166.6545718432511,
    "end": 167.85341074020317,
    "text": "都在档案里；"
  },
  {
    "start": 168.23947750362845,
    "end": 168.74746008708271,
    "text": "人，"
  },
  {
    "start": 169.1132075471698,
    "end": 169.76342525399127,
    "text": "没有。"
  },
  {
    "start": 170.21044992743106,
    "end": 172.2830188679245,
    "text": "一九七一年的雨夜之后，"
  },
  {
    "start": 172.3846153846154,
    "end": 173.80696661828736,
    "text": "他就消失了。"
  }
]