[
  {
    "start": 0.6,
    "end": 3.139912917271408,
    "text": "一九七一年十一月二十四日，"
  },
  {
    "start": 3.139912917271408,
    "end": 4.765457184325109,
    "text": "感恩节前一天，"
  },
  {
    "start": 4.765457184325109,
    "end": 5.923657474600871,
    "text": "波特兰。"
  },
  {
    "start": 5.923657474600871,
    "end": 8.849637155297534,
    "text": "一名自称丹·库珀的男子，"
  },
  {
    "start": 8.849637155297534,
    "end": 11.145718432510886,
    "text": "用现金买了一张单程票，"
  },
  {
    "start": 11.145718432510886,
    "end": 13.909143686502178,
    "text": "登上西北航空三百零五班机。"
  },
  {
    "start": 13.909143686502178,
    "end": 16.20522496371553,
    "text": "他四十岁上下，"
  },
  {
    "start": 16.20522496371553,
    "end": 18.155878084179975,
    "text": "穿西装打黑领带，"
  },
  {
    "start": 18.155878084179975,
    "end": 19.33439767779391,
    "text": "样子平淡。"
  },
  {
    "start": 19.33439767779391,
    "end": 20.919303338171265,
    "text": "起飞后，"
  },
  {
    "start": 20.919303338171265,
    "end": 23.581132075471704,
    "text": "他要了一杯波本加苏打水。"
  },
  {
    "start": 23.581132075471704,
    "end": 28.05137880986938,
    "text": "没有人注意到他——而这架飞机，"
  },
  {
    "start": 28.05137880986938,
    "end": 29.98171262699565,
    "text": "将改写美国民航史。"
  },
  {
    "start": 31.06171262699565,
    "end": 33.174920174165464,
    "text": "起飞后不到一小时，"
  },
  {
    "start": 33.174920174165464,
    "end": 35.81642960812773,
    "text": "他把一张纸条递给后舱的空姐："
  },
  {
    "start": 35.81642960812773,
    "end": 38.13283018867925,
    "text": "我手提箱里有炸弹，"
  },
  {
    "start": 38.13283018867925,
    "end": 39.73805515239478,
    "text": "请你坐到我身边。"
  },
  {
    "start": 39.73805515239478,
    "end": 42.66403483309144,
    "text": "他打开那个廉价手提箱，"
  },
  {
    "start": 42.66403483309144,
    "end": 45.305544267053705,
    "text": "露出里面一团电线和红火柴，"
  },
  {
    "start": 45.305544267053705,
    "end": 47.784499274310605,
    "text": "要求她记下他说的每个字。"
  },
  {
    "start": 47.784499274310605,
    "end": 49.51164005805516,
    "text": "随后，"
  },
  {
    "start": 49.51164005805516,
    "end": 51.11686502177069,
    "text": "条件递进了驾驶舱："
  },
  {
    "start": 51.11686502177069,
    "end": 52.92528301886793,
    "text": "二十万美元，"
  },
  {
    "start": 52.92528301886793,
    "end": 55.201044992743114,
    "text": "只要二十美元面额的钞票，"
  },
  {
    "start": 55.201044992743114,
    "end": 57.02978229317853,
    "text": "还要四个降落伞。"
  },
  {
    "start": 58.109782293178526,
    "end": 59.582931785195946,
    "text": "西雅图上空，"
  },
  {
    "start": 59.786124818577655,
    "end": 62.00092888243832,
    "text": "飞机盘旋了两个多小时，"
  },
  {
    "start": 62.143164005805524,
    "end": 64.41892597968071,
    "text": "等银行把钱装进帆布袋。"
  },
  {
    "start": 64.74403483309145,
    "end": 66.73532656023222,
    "text": "傍晚五点四十六分，"
  },
  {
    "start": 66.93851959361393,
    "end": 69.05172714078375,
    "text": "三十六名乘客全部下机，"
  },
  {
    "start": 69.27523947750363,
    "end": 71.22589259796808,
    "text": "只留下四名机组人员。"
  },
  {
    "start": 71.69323657474601,
    "end": 74.31442670537011,
    "text": "钱和四个降落伞装上飞机，"
  },
  {
    "start": 74.41602322206097,
    "end": 75.55390420899855,
    "text": "它再次起飞，"
  },
  {
    "start": 75.8790130624093,
    "end": 76.40731494920175,
    "text": "航线："
  },
  {
    "start": 76.59018867924529,
    "end": 77.60615384615386,
    "text": "墨西哥城。"
  },
  {
    "start": 78.31732946298985,
    "end": 79.92255442670537,
    "text": "库珀下了新指令："
  },
  {
    "start": 80.10542815674891,
    "end": 81.58873730043543,
    "text": "一万英尺以下，"
  },
  {
    "start": 81.83256894049347,
    "end": 83.68162554426706,
    "text": "速度不超过二百节。"
  },
  {
    "start": 84.16928882438317,
    "end": 86.54664731494921,
    "text": "飞机低低地掠过山谷。"
  },
  {
    "start": 87.88063860667634,
    "end": 89.68905660377358,
    "text": "晚上八点十三分，"
  },
  {
    "start": 89.68905660377358,
    "end": 91.27396226415094,
    "text": "机尾忽然一轻，"
  },
  {
    "start": 91.27396226415094,
    "end": 94.87047895500726,
    "text": "客舱压力骤降——他打开后舱门，"
  },
  {
    "start": 94.87047895500726,
    "end": 96.10995645863571,
    "text": "跳进了黑夜。"
  },
  {
    "start": 96.10995645863571,
    "end": 97.97933236574747,
    "text": "那晚温度低，"
  },
  {
    "start": 97.97933236574747,
    "end": 98.36539912917272,
    "text": "风大。"
  },
  {
    "start": 98.36539912917272,
    "end": 101.90095791001451,
    "text": "搜救从飞机记录的位置开始，"
  },
  {
    "start": 101.90095791001451,
    "end": 105.45683599419449,
    "text": "飞机和直升机在山区与河谷间搜索，"
  },
  {
    "start": 105.45683599419449,
    "end": 106.69631349782293,
    "text": "直到凌晨，"
  },
  {
    "start": 106.69631349782293,
    "end": 107.77323657474601,
    "text": "一无所获。"
  },
  {
    "start": 107.77323657474601,
    "end": 110.43506531204645,
    "text": "联邦调查局也写道："
  },
  {
    "start": 110.43506531204645,
    "end": 111.51198838896953,
    "text": "也许，"
  },
  {
    "start": 111.51198838896953,
    "end": 113.9299854862119,
    "text": "他没能撑过那一跳。"
  },
  {
    "start": 115.0099854862119,
    "end": 117.82420899854863,
    "text": "案子没有随着黑夜结束。"
  },
  {
    "start": 118.37283018867925,
    "end": 120.0390130624093,
    "text": "一九八零年十一月，"
  },
  {
    "start": 120.242206095791,
    "end": 121.4410449927431,
    "text": "哥伦比亚河畔，"
  },
  {
    "start": 121.60359941944847,
    "end": 123.92,
    "text": "有人发现一袋腐烂的钞票："
  },
  {
    "start": 124.30606676342526,
    "end": 125.6877793904209,
    "text": "五千八百美元，"
  },
  {
    "start": 125.93161103047896,
    "end": 128.75599419448477,
    "text": "编号与当年记录的完全吻合。"
  },
  {
    "start": 129.12174165457185,
    "end": 130.72696661828738,
    "text": "领带上的DNA、"
  },
  {
    "start": 131.03175616835995,
    "end": 131.53973875181424,
    "text": "指纹，"
  },
  {
    "start": 131.86484760522495,
    "end": 132.88081277213354,
    "text": "比对了一圈，"
  },
  {
    "start": 133.20592162554428,
    "end": 134.54699564586357,
    "text": "没有给出名字。"
  },
  {
    "start": 135.11593613933238,
    "end": 136.27413642960812,
    "text": "头五年，"
  },
  {
    "start": 136.41637155297533,
    "end": 138.38734397677794,
    "text": "八百多名嫌疑人被核查，"
  },
  {
    "start": 138.67181422351234,
    "end": 139.93161103047896,
    "text": "只剩二十几人。"
  },
  {
    "start": 140.35831640058055,
    "end": 142.06513788098695,
    "text": "线索越来越多，"
  },
  {
    "start": 142.34960812772135,
    "end": 144.50345428156749,
    "text": "谜底却没有近一步。"
  },
  {
    "start": 145.7968069666183,
    "end": 146.89404934687954,
    "text": "二〇一六年，"
  },
  {
    "start": 146.89404934687954,
    "end": 151.77068214804066,
    "text": "联邦调查局宣布不再主动追查这个悬了四十五年的"
  },
  {
    "start": 151.77068214804066,
    "end": 152.90856313497824,
    "text": "案子。"
  },
  {
    "start": 152.90856313497824,
    "end": 154.79825834542817,
    "text": "它是美国民航史上，"
  },
  {
    "start": 154.79825834542817,
    "end": 157.50072568940496,
    "text": "唯一一起至今未破的劫机案。"
  },
  {
    "start": 157.50072568940496,
    "end": 161.0769230769231,
    "text": "他留下一个名字——那个名字，"
  },
  {
    "start": 161.0769230769231,
    "end": 163.43396226415098,
    "text": "还是媒体印错的。"
  },
  {
    "start": 163.43396226415098,
    "end": 164.16545718432513,
    "text": "飞机、"
  },
  {
    "start": 164.16545718432513,
    "end": 164.36865021770683,
    "text": "钱、"
  },
  {
    "start": 164.36865021770683,
    "end": 165.32365747460088,
    "text": "降落伞、"
  },
  {
    "start": 165.32365747460088,
    "end": 166.0348330914369,
    "text": "领带，"
  },
  {
    "start": 166.0348330914369,
    "end": 167.59941944847608,
    "text": "都在档案里；"
  },
  {
    "start": 167.59941944847608,
    "end": 168.4325108853411,
    "text": "人，"
  },
  {
    "start": 168.4325108853411,
    "end": 169.50943396226418,
    "text": "没有。"
  },
  {
    "start": 169.50943396226418,
    "end": 172.57764876632802,
    "text": "一九七一年的雨夜之后，"
  },
  {
    "start": 172.57764876632802,
    "end": 174.00000000000003,
    "text": "他就消失了。"
  }
]