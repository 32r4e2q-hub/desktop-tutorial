[
  {
    "start": 0.6,
    "end": 3.71117891816921,
    "text": "一九七一年十一月二十四日，"
  },
  {
    "start": 3.71117891816921,
    "end": 5.406074895977808,
    "text": "感恩节前夜，"
  },
  {
    "start": 5.406074895977808,
    "end": 7.0313176144244105,
    "text": "波特兰机场。"
  },
  {
    "start": 7.0313176144244105,
    "end": 10.444327323162275,
    "text": "一个自称丹·库珀的男人，"
  },
  {
    "start": 10.444327323162275,
    "end": 14.484216366158115,
    "text": "用现金买了一张飞往西雅图的单程票。"
  },
  {
    "start": 14.484216366158115,
    "end": 16.736338418862694,
    "text": "他穿着西装，"
  },
  {
    "start": 16.736338418862694,
    "end": 18.268710124826633,
    "text": "打着黑色领带，"
  },
  {
    "start": 18.268710124826633,
    "end": 20.242219140083222,
    "text": "看起来毫不起眼。"
  },
  {
    "start": 20.242219140083222,
    "end": 22.656865464632457,
    "text": "谁也没想到，"
  },
  {
    "start": 22.656865464632457,
    "end": 25.16438280166436,
    "text": "这趟三十分钟的航班，"
  },
  {
    "start": 25.16438280166436,
    "end": 29.57575589459085,
    "text": "会成为美国航空史上最大的谜团。"
  },
  {
    "start": 30.775755894590848,
    "end": 32.67961165048544,
    "text": "飞机起飞后不久，"
  },
  {
    "start": 32.67961165048544,
    "end": 35.60504854368932,
    "text": "库珀递给空姐一张纸条，"
  },
  {
    "start": 35.60504854368932,
    "end": 38.01969486823856,
    "text": "说公文包里有炸弹。"
  },
  {
    "start": 38.01969486823856,
    "end": 39.96998613037448,
    "text": "他打开箱子，"
  },
  {
    "start": 39.96998613037448,
    "end": 43.05794729542303,
    "text": "里面是电线和红色管状物。"
  },
  {
    "start": 43.05794729542303,
    "end": 45.61190013869626,
    "text": "他要求飞机降落后，"
  },
  {
    "start": 45.61190013869626,
    "end": 49.001692094313455,
    "text": "准备二十万美元的二十元旧钞，"
  },
  {
    "start": 49.001692094313455,
    "end": 50.696588072122054,
    "text": "和四个降落伞。"
  },
  {
    "start": 50.696588072122054,
    "end": 53.15766990291263,
    "text": "机长接到通知，"
  },
  {
    "start": 53.15766990291263,
    "end": 55.68840499306519,
    "text": "开始在西雅图上空盘旋，"
  },
  {
    "start": 55.68840499306519,
    "end": 58.12626907073509,
    "text": "为地面争取时间。"
  },
  {
    "start": 59.326269070735094,
    "end": 61.94987517337032,
    "text": "经过两个多小时的盘旋，"
  },
  {
    "start": 61.94987517337032,
    "end": 65.03783633841887,
    "text": "飞机在西雅图塔科马机场降落。"
  },
  {
    "start": 65.03783633841887,
    "end": 67.63822468793343,
    "text": "库珀拿到了钱和伞，"
  },
  {
    "start": 67.63822468793343,
    "end": 71.70133148404993,
    "text": "释放了三十六名乘客和两名机组。"
  },
  {
    "start": 71.70133148404993,
    "end": 73.81414701803052,
    "text": "他留下两名飞行员、"
  },
  {
    "start": 73.81414701803052,
    "end": 76.85567267683773,
    "text": "一名机械师和一名空姐，"
  },
  {
    "start": 76.85567267683773,
    "end": 78.15586685159501,
    "text": "下令再次起飞，"
  },
  {
    "start": 78.15586685159501,
    "end": 81.10452149791956,
    "text": "目的地墨西哥城，"
  },
  {
    "start": 81.10452149791956,
    "end": 83.70490984743412,
    "text": "但要求低空低速飞行，"
  },
  {
    "start": 83.70490984743412,
    "end": 86.21242718446602,
    "text": "并保持后舱门可打开。"
  },
  {
    "start": 87.41242718446603,
    "end": 88.9912343966713,
    "text": "晚上八点左右，"
  },
  {
    "start": 88.9912343966713,
    "end": 93.70443828016644,
    "text": "飞机飞在华盛顿州西南部的暴雨和夜空中。"
  },
  {
    "start": 93.70443828016644,
    "end": 96.90848821081832,
    "text": "库珀让所有人留在驾驶舱，"
  },
  {
    "start": 96.90848821081832,
    "end": 98.8123439667129,
    "text": "自己留在客舱。"
  },
  {
    "start": 98.8123439667129,
    "end": 103.64163661581138,
    "text": "他打开了波音七二七特有的后部登机梯，"
  },
  {
    "start": 103.64163661581138,
    "end": 106.98499306518724,
    "text": "在狂风中抱着钱袋跳了下去。"
  },
  {
    "start": 106.98499306518724,
    "end": 110.51409153952844,
    "text": "机组只感到机身轻微晃动，"
  },
  {
    "start": 110.51409153952844,
    "end": 113.41631067961166,
    "text": "他就这样消失了。"
  },
  {
    "start": 114.61631067961166,
    "end": 118.81872399445216,
    "text": "联邦调查局代号NORJAK，"
  },
  {
    "start": 118.81872399445216,
    "end": 121.51198335644938,
    "text": "展开了史上最漫长的调查之一。"
  },
  {
    "start": 121.51198335644938,
    "end": 125.4706102635229,
    "text": "五年内排查超过八百名嫌疑人，"
  },
  {
    "start": 125.4706102635229,
    "end": 127.89686546463247,
    "text": "搜遍了预判的降落区，"
  },
  {
    "start": 127.89686546463247,
    "end": 129.0809708737864,
    "text": "却一无所获。"
  },
  {
    "start": 129.0809708737864,
    "end": 131.98319001386963,
    "text": "直到一九八零年，"
  },
  {
    "start": 131.98319001386963,
    "end": 136.90535367545078,
    "text": "一个男孩在哥伦比亚河边挖出了五千八百美元，"
  },
  {
    "start": 136.90535367545078,
    "end": 139.18069348127602,
    "text": "编号与赎金一致。"
  },
  {
    "start": 139.18069348127602,
    "end": 142.1061303744799,
    "text": "这是此案唯一的实物突破。"
  },
  {
    "start": 143.3061303744799,
    "end": 148.66943134535367,
    "text": "库珀留下的黑色领带提供了脱氧核糖核酸样本，"
  },
  {
    "start": 148.66943134535367,
    "end": 150.34110957004162,
    "text": "但已被污染，"
  },
  {
    "start": 150.34110957004162,
    "end": 152.72092926490984,
    "text": "无法确定身份。"
  },
  {
    "start": 152.72092926490984,
    "end": 157.44574202496534,
    "text": "有人认为他根本没能活过那一夜。"
  },
  {
    "start": 157.44574202496534,
    "end": 161.09092926490985,
    "text": "也有人相信他成功了。"
  },
  {
    "start": 161.09092926490985,
    "end": 163.06443828016643,
    "text": "二零一六年七月，"
  },
  {
    "start": 163.06443828016643,
    "end": 167.38294036061026,
    "text": "联邦调查局正式停止主动调查。"
  },
  {
    "start": 167.38294036061026,
    "end": 168.8456588072122,
    "text": "这起劫机案，"
  },
  {
    "start": 168.8456588072122,
    "end": 174.0,
    "text": "至今仍是美国唯一未被侦破的商业航空劫机案。"
  }
]