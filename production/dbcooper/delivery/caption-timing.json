[
  {
    "start": 0.6,
    "end": 3.139912917271408,
    "text": "一九七一年十一月二十四日，"
  },
  {
    "start": 3.139912917271408,
    "end": 4.765457184325109,
    "text": "感恩节前一天，"
  },
  {
    "start": 4.765457184325109,
    "end": 5.923657474600871,
    "text": "波特兰。"
  },
  {
    "start": 5.923657474600871,
    "end": 8.849637155297534,
    "text": "一名自称丹·库珀的男子，"
  },
  {
    "start": 8.849637155297534,
    "end": 11.145718432510886,
    "text": "用现金买了一张单程票，"
  },
  {
    "start": 11.145718432510886,
    "end": 13.909143686502178,
    "text": "登上西北航空三百零五班机。"
  },
  {
    "start": 13.909143686502178,
    "end": 16.20522496371553,
    "text": "他四十岁上下，"
  },
  {
    "start": 16.20522496371553,
    "end": 18.155878084179975,
    "text": "穿西装打黑领带，"
  },
  {
    "start": 18.155878084179975,
    "end": 19.33439767779391,
    "text": "样子平淡。"
  },
  {
    "start": 19.33439767779391,
    "end": 20.919303338171265,
    "text": "起飞后，"
  },
  {
    "start": 20.919303338171265,
    "end": 23.581132075471704,
    "text": "他要了一杯波本加苏打水。"
  },
  {
    "start": 23.581132075471704,
    "end": 28.05137880986938,
    "text": "没有人注意到他——而这架飞机，"
  },
  {
    "start": 28.05137880986938,
    "end": 29.98171262699565,
    "text": "将改写美国民航史。"
  },
  {
    "start": 31.78304789550073,
    "end": 33.571146589259804,
    "text": "起飞后不到一小时，"
  },
  {
    "start": 33.571146589259804,
    "end": 36.45648766328012,
    "text": "他把一张纸条递给后舱的空姐："
  },
  {
    "start": 37.08638606676343,
    "end": 38.71193033381713,
    "text": "我手提箱里有炸弹，"
  },
  {
    "start": 38.894804063860676,
    "end": 40.032685050798264,
    "text": "请你坐到我身边。"
  },
  {
    "start": 40.70322206095791,
    "end": 42.89770682148041,
    "text": "他打开那个廉价手提箱，"
  },
  {
    "start": 42.95866473149493,
    "end": 45.823686502177075,
    "text": "露出里面一团电线和红火柴，"
  },
  {
    "start": 45.986240928882445,
    "end": 48.16040638606677,
    "text": "要求她记下他说的每个字。"
  },
  {
    "start": 49.23732946298985,
    "end": 49.928185776487666,
    "text": "随后，"
  },
  {
    "start": 49.928185776487666,
    "end": 51.492772133526856,
    "text": "条件递进了驾驶舱："
  },
  {
    "start": 52.122670537010166,
    "end": 53.28087082728592,
    "text": "二十万美元，"
  },
  {
    "start": 53.423105950653124,
    "end": 55.45503628447025,
    "text": "只要二十美元面额的钞票，"
  },
  {
    "start": 55.47535558780842,
    "end": 56.8367489114659,
    "text": "还要四个降落伞。"
  },
  {
    "start": 58.109782293178526,
    "end": 59.643889695210454,
    "text": "西雅图上空，"
  },
  {
    "start": 59.643889695210454,
    "end": 62.00092888243832,
    "text": "飞机盘旋了两个多小时，"
  },
  {
    "start": 62.00092888243832,
    "end": 64.39860667634254,
    "text": "等银行把钱装进帆布袋。"
  },
  {
    "start": 64.86595065312048,
    "end": 66.7556458635704,
    "text": "傍晚五点四十六分，"
  },
  {
    "start": 66.81660377358492,
    "end": 69.07204644412192,
    "text": "三十六名乘客全部下机，"
  },
  {
    "start": 69.17364296081278,
    "end": 71.24621190130625,
    "text": "只留下四名机组人员。"
  },
  {
    "start": 71.7745137880987,
    "end": 74.33474600870828,
    "text": "钱和四个降落伞装上飞机，"
  },
  {
    "start": 74.33474600870828,
    "end": 75.57422351233673,
    "text": "它再次起飞，"
  },
  {
    "start": 75.77741654571844,
    "end": 76.40731494920175,
    "text": "航线："
  },
  {
    "start": 76.56986937590712,
    "end": 77.62647314949203,
    "text": "墨西哥城。"
  },
  {
    "start": 78.50020319303339,
    "end": 79.94287373004354,
    "text": "库珀下了新指令："
  },
  {
    "start": 80.20702467343978,
    "end": 81.58873730043543,
    "text": "一万英尺以下，"
  },
  {
    "start": 81.7512917271408,
    "end": 83.7222641509434,
    "text": "速度不超过二百节。"
  },
  {
    "start": 84.25056603773587,
    "end": 86.56696661828738,
    "text": "飞机低低地掠过山谷。"
  },
  {
    "start": 88.56133526850508,
    "end": 90.08528301886793,
    "text": "晚上八点十三分，"
  },
  {
    "start": 90.08528301886793,
    "end": 91.75146589259796,
    "text": "机尾忽然一轻，"
  },
  {
    "start": 92.03593613933236,
    "end": 95.40894049346879,
    "text": "客舱压力骤降——他打开后舱门，"
  },
  {
    "start": 95.55117561683599,
    "end": 96.7500145137881,
    "text": "跳进了黑夜。"
  },
  {
    "start": 97.33927431059507,
    "end": 98.76162554426705,
    "text": "那晚温度低，"
  },
  {
    "start": 98.86322206095791,
    "end": 99.45248185776488,
    "text": "风大。"
  },
  {
    "start": 100.10269956458636,
    "end": 102.45973875181423,
    "text": "搜救从飞机记录的位置开始，"
  },
  {
    "start": 102.84580551523948,
    "end": 106.23912917271409,
    "text": "飞机和直升机在山区与河谷间搜索，"
  },
  {
    "start": 106.3610449927431,
    "end": 107.33637155297532,
    "text": "直到凌晨，"
  },
  {
    "start": 107.53956458635705,
    "end": 108.57584905660377,
    "text": "一无所获。"
  },
  {
    "start": 109.32766328011611,
    "end": 110.8922496371553,
    "text": "联邦调查局也写道："
  },
  {
    "start": 111.23767779390421,
    "end": 111.86757619738752,
    "text": "也许，"
  },
  {
    "start": 111.98949201741655,
    "end": 113.75727140783745,
    "text": "他没能撑过那一跳。"
  },
  {
    "start": 115.42653120464442,
    "end": 117.86484760522497,
    "text": "案子没有随着黑夜结束。"
  },
  {
    "start": 117.86484760522497,
    "end": 120.0999709724238,
    "text": "一九八零年十一月，"
  },
  {
    "start": 120.26252539912917,
    "end": 121.4410449927431,
    "text": "哥伦比亚河畔，"
  },
  {
    "start": 121.64423802612482,
    "end": 123.92,
    "text": "有人发现一袋腐烂的钞票："
  },
  {
    "start": 124.16383164005806,
    "end": 125.6877793904209,
    "text": "五千八百美元，"
  },
  {
    "start": 125.99256894049347,
    "end": 128.7966328011611,
    "text": "编号与当年记录的完全吻合。"
  },
  {
    "start": 129.24365747460087,
    "end": 130.74728592162555,
    "text": "领带上的DNA、"
  },
  {
    "start": 130.88952104499276,
    "end": 131.5600580551524,
    "text": "指纹，"
  },
  {
    "start": 131.7632510885341,
    "end": 132.9011320754717,
    "text": "比对了一圈，"
  },
  {
    "start": 133.16528301886794,
    "end": 134.54699564586357,
    "text": "没有给出名字。"
  },
  {
    "start": 135.2988098693759,
    "end": 136.25381712626995,
    "text": "头五年，"
  },
  {
    "start": 136.41637155297533,
    "end": 138.44830188679245,
    "text": "八百多名嫌疑人被核查，"
  },
  {
    "start": 138.5702177068215,
    "end": 139.9722496371553,
    "text": "只剩二十几人。"
  },
  {
    "start": 140.43959361393325,
    "end": 142.06513788098695,
    "text": "线索越来越多，"
  },
  {
    "start": 142.308969521045,
    "end": 144.52377358490565,
    "text": "谜底却没有近一步。"
  },
  {
    "start": 145.7968069666183,
    "end": 147.16835994194486,
    "text": "二〇一六年，"
  },
  {
    "start": 147.16835994194486,
    "end": 151.76052249637158,
    "text": "联邦调查局宣布不再主动追查这个悬了四十五年的"
  },
  {
    "start": 151.76052249637158,
    "end": 152.24818577648767,
    "text": "案子。"
  },
  {
    "start": 152.3904208998549,
    "end": 154.62554426705373,
    "text": "它是美国民航史上，"
  },
  {
    "start": 154.86937590711176,
    "end": 157.83599419448478,
    "text": "唯一一起至今未破的劫机案。"
  },
  {
    "start": 158.42525399129175,
    "end": 160.74165457184327,
    "text": "他留下一个名字——那个名字，"
  },
  {
    "start": 160.74165457184327,
    "end": 162.42815674891148,
    "text": "还是媒体印错的。"
  },
  {
    "start": 162.93613933236577,
    "end": 163.70827285921627,
    "text": "飞机、"
  },
  {
    "start": 163.93178519593616,
    "end": 164.43976777939045,
    "text": "钱、"
  },
  {
    "start": 164.68359941944848,
    "end": 165.49637155297535,
    "text": "降落伞、"
  },
  {
    "start": 165.71988388969524,
    "end": 166.34978229317852,
    "text": "领带，"
  },
  {
    "start": 166.65457184325112,
    "end": 167.83309143686503,
    "text": "都在档案里；"
  },
  {
    "start": 168.1988388969521,
    "end": 168.74746008708274,
    "text": "人，"
  },
  {
    "start": 169.11320754716982,
    "end": 169.7634252539913,
    "text": "没有。"
  },
  {
    "start": 170.19013062409292,
    "end": 172.28301886792454,
    "text": "一九七一年的雨夜之后，"
  },
  {
    "start": 172.36429608127725,
    "end": 173.8069666182874,
    "text": "他就消失了。"
  }
]