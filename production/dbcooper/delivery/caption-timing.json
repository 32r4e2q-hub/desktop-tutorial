[
  {
    "start": 0.6,
    "end": 3.774908682214105,
    "text": "一九七一年十一月二十四日，"
  },
  {
    "start": 3.774908682214105,
    "end": 5.562264681090193,
    "text": "感恩节前夜，"
  },
  {
    "start": 5.562264681090193,
    "end": 7.326102837875807,
    "text": "波特兰机场。"
  },
  {
    "start": 7.326102837875807,
    "end": 10.900814835627985,
    "text": "一个自称丹·库珀的男人，"
  },
  {
    "start": 10.900814835627985,
    "end": 15.416240516999157,
    "text": "用现金买了一张飞往西雅图的单程票。"
  },
  {
    "start": 15.416240516999157,
    "end": 17.55636414723237,
    "text": "他穿着西装，"
  },
  {
    "start": 17.55636414723237,
    "end": 19.367237988198934,
    "text": "打着黑色领带，"
  },
  {
    "start": 19.367237988198934,
    "end": 21.4603259342512,
    "text": "看起来毫不起眼。"
  },
  {
    "start": 21.4603259342512,
    "end": 24.117842090474852,
    "text": "谁也没想到，"
  },
  {
    "start": 24.117842090474852,
    "end": 27.069331272829448,
    "text": "这趟三十分钟的航班，"
  },
  {
    "start": 27.069331272829448,
    "end": 31.17319471761731,
    "text": "会成为美国航空史上最大的谜团。"
  },
  {
    "start": 32.37319471761731,
    "end": 34.30165776903625,
    "text": "飞机起飞后不久，"
  },
  {
    "start": 34.30165776903625,
    "end": 36.98269176735038,
    "text": "库珀递给空姐一张纸条，"
  },
  {
    "start": 36.98269176735038,
    "end": 39.31095813430739,
    "text": "说公文包里有炸弹。"
  },
  {
    "start": 39.31095813430739,
    "end": 41.474599606631074,
    "text": "他打开箱子，"
  },
  {
    "start": 41.474599606631074,
    "end": 44.57895476257376,
    "text": "里面是电线和红色管状物。"
  },
  {
    "start": 44.57895476257376,
    "end": 46.62500702444507,
    "text": "他要求飞机降落后，"
  },
  {
    "start": 46.62500702444507,
    "end": 49.72936218038775,
    "text": "准备二十万美元的二十元旧钞，"
  },
  {
    "start": 49.72936218038775,
    "end": 51.28153975835909,
    "text": "和四个降落伞。"
  },
  {
    "start": 51.28153975835909,
    "end": 53.7979488620399,
    "text": "机长接到通知，"
  },
  {
    "start": 53.7979488620399,
    "end": 56.31435796572071,
    "text": "开始在西雅图上空盘旋，"
  },
  {
    "start": 56.31435796572071,
    "end": 58.61910649058724,
    "text": "为地面争取时间。"
  },
  {
    "start": 59.819106490587245,
    "end": 62.61772969935375,
    "text": "经过两个多小时的盘旋，"
  },
  {
    "start": 62.61772969935375,
    "end": 65.46338859230121,
    "text": "飞机在西雅图塔科马机场降落。"
  },
  {
    "start": 65.46338859230121,
    "end": 67.86220848552965,
    "text": "库珀拿到了钱和伞，"
  },
  {
    "start": 67.86220848552965,
    "end": 71.34284911491993,
    "text": "释放了三十六名乘客和两名机组。"
  },
  {
    "start": 71.34284911491993,
    "end": 73.74166900814836,
    "text": "他留下两名飞行员、"
  },
  {
    "start": 73.74166900814836,
    "end": 76.77547063781961,
    "text": "一名机械师和一名空姐，"
  },
  {
    "start": 76.77547063781961,
    "end": 78.51579095251475,
    "text": "下令再次起飞，"
  },
  {
    "start": 78.51579095251475,
    "end": 80.49128968811465,
    "text": "目的地墨西哥城，"
  },
  {
    "start": 80.49128968811465,
    "end": 82.74900252880022,
    "text": "但要求低空低速飞行，"
  },
  {
    "start": 82.74900252880022,
    "end": 85.12430457993818,
    "text": "并保持后舱门可打开。"
  },
  {
    "start": 86.32430457993819,
    "end": 87.92351784209048,
    "text": "晚上八点左右，"
  },
  {
    "start": 87.92351784209048,
    "end": 92.69763978645688,
    "text": "飞机飞在华盛顿州西南部的暴雨和夜空中。"
  },
  {
    "start": 92.69763978645688,
    "end": 95.9431019949424,
    "text": "库珀让所有人留在驾驶舱，"
  },
  {
    "start": 95.9431019949424,
    "end": 97.87156504636134,
    "text": "自己留在客舱。"
  },
  {
    "start": 97.87156504636134,
    "end": 102.7632762011801,
    "text": "他打开了波音七二七特有的后部登机梯，"
  },
  {
    "start": 102.7632762011801,
    "end": 106.14984546220849,
    "text": "在狂风中抱着钱袋跳了下去。"
  },
  {
    "start": 106.14984546220849,
    "end": 109.72455745996066,
    "text": "机组只感到机身轻微晃动，"
  },
  {
    "start": 109.72455745996066,
    "end": 112.66428772127001,
    "text": "他就这样消失了。"
  },
  {
    "start": 113.86428772127002,
    "end": 118.12101713964597,
    "text": "联邦调查局代号NORJAK，"
  },
  {
    "start": 118.12101713964597,
    "end": 120.84908682214105,
    "text": "展开了史上最漫长的调查之一。"
  },
  {
    "start": 120.84908682214105,
    "end": 124.85887889856701,
    "text": "五年内排查超过八百名嫌疑人，"
  },
  {
    "start": 124.85887889856701,
    "end": 127.31649339702163,
    "text": "搜遍了预判的降落区，"
  },
  {
    "start": 127.31649339702163,
    "end": 128.51590334363584,
    "text": "却一无所获。"
  },
  {
    "start": 128.51590334363584,
    "end": 131.4556336049452,
    "text": "直到一九八零年，"
  },
  {
    "start": 131.4556336049452,
    "end": 136.44141612812587,
    "text": "一个男孩在哥伦比亚河边挖出了五千八百美元，"
  },
  {
    "start": 136.44141612812587,
    "end": 138.7461646529924,
    "text": "编号与赎金一致。"
  },
  {
    "start": 138.7461646529924,
    "end": 141.70941275639223,
    "text": "这是此案唯一的实物突破。"
  },
  {
    "start": 142.90941275639224,
    "end": 148.34203427929194,
    "text": "库珀留下的黑色领带提供了脱氧核糖核酸样本，"
  },
  {
    "start": 148.34203427929194,
    "end": 150.03531890980614,
    "text": "但已被污染，"
  },
  {
    "start": 150.03531890980614,
    "end": 152.4458977240798,
    "text": "无法确定身份。"
  },
  {
    "start": 152.4458977240798,
    "end": 157.23177858949143,
    "text": "有人认为他根本没能活过那一夜。"
  },
  {
    "start": 157.23177858949143,
    "end": 160.92407979769598,
    "text": "也有人相信他成功了。"
  },
  {
    "start": 160.92407979769598,
    "end": 162.92309637538634,
    "text": "二零一六年七月，"
  },
  {
    "start": 162.92309637538634,
    "end": 167.29741500421466,
    "text": "联邦调查局正式停止主动调查。"
  },
  {
    "start": 167.29741500421466,
    "end": 168.77903905591458,
    "text": "这起劫机案，"
  },
  {
    "start": 168.77903905591458,
    "end": 174.0,
    "text": "至今仍是美国唯一未被侦破的商业航空劫机案。"
  }
]