{
 "N01": {
  "duration": 27.225,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.64,
    "text": "只要被疯狗咬上一口",
    "chars_per_second": 6.04
   },
   {
    "i": 1,
    "start": 1.94,
    "end": 3.35,
    "text": "哪怕只是一道血痕",
    "chars_per_second": 5.67
   },
   {
    "i": 2,
    "start": 3.63,
    "end": 5.15,
    "text": "你就已经进入了倒计时",
    "chars_per_second": 6.58
   },
   {
    "i": 3,
    "start": 5.49,
    "end": 6.04,
    "text": "恐水",
    "chars_per_second": 3.64
   },
   {
    "i": 4,
    "start": 6.35,
    "end": 6.78,
    "text": "痉挛",
    "chars_per_second": 4.65
   },
   {
    "i": 5,
    "start": 7.03,
    "end": 7.46,
    "text": "窒息",
    "chars_per_second": 4.65
   },
   {
    "i": 6,
    "start": 7.8,
    "end": 9.75,
    "text": "人会在清醒里走向终点",
    "chars_per_second": 5.13
   },
   {
    "i": 7,
    "start": 10.1,
    "end": 11.38,
    "text": "在疫苗出现之前",
    "chars_per_second": 5.47
   },
   {
    "i": 8,
    "start": 11.72,
    "end": 13.01,
    "text": "狂犬病一旦发病",
    "chars_per_second": 5.43
   },
   {
    "i": 9,
    "start": 13.36,
    "end": 15.61,
    "text": "病死率几乎就是百分之百",
    "chars_per_second": 4.89
   },
   {
    "i": 10,
    "start": 15.96,
    "end": 17.45,
    "text": "史料里的抢救办法",
    "chars_per_second": 5.37
   },
   {
    "i": 11,
    "start": 17.83,
    "end": 19.04,
    "text": "是烧灼伤口",
    "chars_per_second": 4.13
   },
   {
    "i": 12,
    "start": 19.39,
    "end": 20.64,
    "text": "甚至把病人闷死",
    "chars_per_second": 5.6
   },
   {
    "i": 13,
    "start": 21.01,
    "end": 22.43,
    "text": "而改写这个数字的",
    "chars_per_second": 5.63
   },
   {
    "i": 14,
    "start": 22.75,
    "end": 23.75,
    "text": "不是救世主",
    "chars_per_second": 5.0
   },
   {
    "i": 15,
    "start": 24.09,
    "end": 27.23,
    "text": "是一个连行医资格都没有的化学家",
    "chars_per_second": 4.78
   }
  ]
 },
 "N02": {
  "duration": 33.41,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.97,
    "text": "他叫路易·巴斯德",
    "chars_per_second": 3.85
   },
   {
    "i": 1,
    "start": 2.31,
    "end": 4.04,
    "text": "从一八八零年起",
    "chars_per_second": 4.05
   },
   {
    "i": 2,
    "start": 4.39,
    "end": 7.34,
    "text": "他在巴黎的实验室里跟这种病较劲",
    "chars_per_second": 5.08
   },
   {
    "i": 3,
    "start": 7.68,
    "end": 9.75,
    "text": "把患病兔子的脊髓取出来",
    "chars_per_second": 5.31
   },
   {
    "i": 4,
    "start": 10.03,
    "end": 10.67,
    "text": "干燥",
    "chars_per_second": 3.12
   },
   {
    "i": 5,
    "start": 11.01,
    "end": 12.97,
    "text": "再接种到下一只兔子体内",
    "chars_per_second": 5.61
   },
   {
    "i": 6,
    "start": 13.32,
    "end": 15.12,
    "text": "这样传了三十九次以上",
    "chars_per_second": 5.56
   },
   {
    "i": 7,
    "start": 15.52,
    "end": 17.14,
    "text": "毒性一点一点减弱",
    "chars_per_second": 4.94
   },
   {
    "i": 8,
    "start": 17.48,
    "end": 18.17,
    "text": "四年后",
    "chars_per_second": 4.35
   },
   {
    "i": 9,
    "start": 18.52,
    "end": 19.98,
    "text": "这个办法在狗身上成了",
    "chars_per_second": 6.85
   },
   {
    "i": 10,
    "start": 20.33,
    "end": 21.3,
    "text": "可同行质问他",
    "chars_per_second": 6.19
   },
   {
    "i": 11,
    "start": 21.65,
    "end": 22.81,
    "text": "病原体都看不见",
    "chars_per_second": 6.03
   },
   {
    "i": 12,
    "start": 23.03,
    "end": 23.59,
    "text": "你凭什么",
    "chars_per_second": 7.14
   },
   {
    "i": 13,
    "start": 23.94,
    "end": 24.72,
    "text": "更麻烦的是",
    "chars_per_second": 6.41
   },
   {
    "i": 14,
    "start": 25.01,
    "end": 25.77,
    "text": "他不是医生",
    "chars_per_second": 6.58
   },
   {
    "i": 15,
    "start": 26.12,
    "end": 28.43,
    "text": "给人打一种没验证过的东西",
    "chars_per_second": 5.19
   },
   {
    "i": 16,
    "start": 28.78,
    "end": 29.63,
    "text": "一旦出事",
    "chars_per_second": 4.71
   },
   {
    "i": 17,
    "start": 29.99,
    "end": 33.41,
    "text": "等着他的就是身败名裂和牢狱之灾",
    "chars_per_second": 4.39
   }
  ]
 },
 "N03": {
  "duration": 34.65,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.45,
    "text": "一八八五年七月六日清晨",
    "chars_per_second": 4.78
   },
   {
    "i": 1,
    "start": 2.8,
    "end": 6.61,
    "text": "一个九岁的男孩被母亲从阿尔萨斯带到他面前",
    "chars_per_second": 5.25
   },
   {
    "i": 2,
    "start": 6.95,
    "end": 8.27,
    "text": "孩子叫约瑟夫",
    "chars_per_second": 4.55
   },
   {
    "i": 3,
    "start": 8.62,
    "end": 11.07,
    "text": "两天前被疯狗咬伤十几处",
    "chars_per_second": 4.49
   },
   {
    "i": 4,
    "start": 11.41,
    "end": 12.79,
    "text": "母亲只求他救一救",
    "chars_per_second": 5.8
   },
   {
    "i": 5,
    "start": 13.14,
    "end": 14.81,
    "text": "巴斯德后来写下",
    "chars_per_second": 4.19
   },
   {
    "i": 6,
    "start": 15.16,
    "end": 17.58,
    "text": "孩子的结局看起来无法避免",
    "chars_per_second": 4.96
   },
   {
    "i": 7,
    "start": 17.88,
    "end": 18.82,
    "text": "我极度焦虑",
    "chars_per_second": 5.32
   },
   {
    "i": 8,
    "start": 19.17,
    "end": 23.43,
    "text": "还是决定用在狗身上从未失败过的办法试一次",
    "chars_per_second": 4.69
   },
   {
    "i": 9,
    "start": 23.79,
    "end": 24.43,
    "text": "不治",
    "chars_per_second": 3.12
   },
   {
    "i": 10,
    "start": 24.77,
    "end": 26.21,
    "text": "孩子几乎没有生路",
    "chars_per_second": 5.56
   },
   {
    "i": 11,
    "start": 26.55,
    "end": 26.89,
    "text": "治",
    "chars_per_second": 2.94
   },
   {
    "i": 12,
    "start": 27.24,
    "end": 28.04,
    "text": "一旦失败",
    "chars_per_second": 5.0
   },
   {
    "i": 13,
    "start": 28.39,
    "end": 31.2,
    "text": "所有的责难都会落在他一个人身上",
    "chars_per_second": 5.34
   },
   {
    "i": 14,
    "start": 31.54,
    "end": 32.5,
    "text": "这位老人的手",
    "chars_per_second": 6.25
   },
   {
    "i": 15,
    "start": 32.84,
    "end": 34.65,
    "text": "抖着拿起了注射器",
    "chars_per_second": 4.42
   }
  ]
 },
 "N04": {
  "duration": 26.46,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.09,
    "text": "接下来的十天",
    "chars_per_second": 6.38
   },
   {
    "i": 1,
    "start": 1.44,
    "end": 4.0,
    "text": "是这个实验室最难熬的十天",
    "chars_per_second": 4.69
   },
   {
    "i": 2,
    "start": 4.35,
    "end": 5.06,
    "text": "每天一针",
    "chars_per_second": 5.63
   },
   {
    "i": 3,
    "start": 5.44,
    "end": 6.5,
    "text": "一针比一针毒",
    "chars_per_second": 5.66
   },
   {
    "i": 4,
    "start": 6.84,
    "end": 7.47,
    "text": "按记载",
    "chars_per_second": 4.76
   },
   {
    "i": 5,
    "start": 7.79,
    "end": 9.96,
    "text": "后面用的是毒性更强的制剂",
    "chars_per_second": 5.53
   },
   {
    "i": 6,
    "start": 10.31,
    "end": 13.79,
    "text": "他是在拿一个孩子的命跟死神抢时间",
    "chars_per_second": 4.6
   },
   {
    "i": 7,
    "start": 14.11,
    "end": 15.39,
    "text": "夜夜守着病床",
    "chars_per_second": 4.69
   },
   {
    "i": 8,
    "start": 15.73,
    "end": 16.87,
    "text": "最后一针打完",
    "chars_per_second": 5.26
   },
   {
    "i": 9,
    "start": 17.22,
    "end": 18.69,
    "text": "他等着最坏的消息",
    "chars_per_second": 5.44
   },
   {
    "i": 10,
    "start": 19.03,
    "end": 20.68,
    "text": "可约瑟夫没有发病",
    "chars_per_second": 4.85
   },
   {
    "i": 11,
    "start": 21.02,
    "end": 22.15,
    "text": "一天天好起来",
    "chars_per_second": 5.31
   },
   {
    "i": 12,
    "start": 22.5,
    "end": 26.46,
    "text": "成了人类历史上第一个被狂犬病疫苗救下来的人",
    "chars_per_second": 5.3
   }
  ]
 },
 "N05": {
  "duration": 28.625,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.01,
    "text": "消息传开",
    "chars_per_second": 4.6
   },
   {
    "i": 1,
    "start": 1.33,
    "end": 2.25,
    "text": "病人从英国",
    "chars_per_second": 5.43
   },
   {
    "i": 2,
    "start": 2.47,
    "end": 2.98,
    "text": "俄国",
    "chars_per_second": 3.92
   },
   {
    "i": 3,
    "start": 3.2,
    "end": 3.66,
    "text": "意大利",
    "chars_per_second": 6.52
   },
   {
    "i": 4,
    "start": 3.99,
    "end": 5.53,
    "text": "德国涌向巴黎",
    "chars_per_second": 3.9
   },
   {
    "i": 5,
    "start": 5.88,
    "end": 7.34,
    "text": "到一八八六年十一月",
    "chars_per_second": 6.16
   },
   {
    "i": 6,
    "start": 7.57,
    "end": 9.96,
    "text": "已有大约两千五百人接受这种治疗",
    "chars_per_second": 6.28
   },
   {
    "i": 7,
    "start": 10.24,
    "end": 12.26,
    "text": "到一八九五年巴斯德去世时",
    "chars_per_second": 5.94
   },
   {
    "i": 8,
    "start": 12.59,
    "end": 14.19,
    "text": "接受过的人接近两万",
    "chars_per_second": 5.63
   },
   {
    "i": 9,
    "start": 14.55,
    "end": 16.3,
    "text": "死亡率不到千分之五",
    "chars_per_second": 5.14
   },
   {
    "i": 10,
    "start": 16.65,
    "end": 18.87,
    "text": "一八八八年十一月十四日",
    "chars_per_second": 4.95
   },
   {
    "i": 11,
    "start": 19.22,
    "end": 21.18,
    "text": "巴斯德研究所在巴黎落成",
    "chars_per_second": 5.61
   },
   {
    "i": 12,
    "start": 21.54,
    "end": 22.39,
    "text": "而直到今天",
    "chars_per_second": 5.88
   },
   {
    "i": 13,
    "start": 22.81,
    "end": 25.52,
    "text": "全球每年仍有数万人死于狂犬病",
    "chars_per_second": 5.17
   },
   {
    "i": 14,
    "start": 25.87,
    "end": 28.62,
    "text": "其中约四成是十五岁以下的孩子",
    "chars_per_second": 5.08
   }
  ]
 },
 "N06": {
  "duration": 28.075,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.67,
    "text": "今天",
    "chars_per_second": 3.85
   },
   {
    "i": 1,
    "start": 1.01,
    "end": 2.61,
    "text": "我们被猫狗抓伤",
    "chars_per_second": 4.38
   },
   {
    "i": 2,
    "start": 2.95,
    "end": 4.96,
    "text": "能淡定地去疾控中心",
    "chars_per_second": 4.48
   },
   {
    "i": 3,
    "start": 5.28,
    "end": 6.89,
    "text": "按五针法或者四针法打完疫苗回家",
    "chars_per_second": 9.32
   },
   {
    "i": 4,
    "start": 7.21,
    "end": 9.16,
    "text": "平常得像顺手关灯",
    "chars_per_second": 4.1
   },
   {
    "i": 5,
    "start": 9.37,
    "end": 10.48,
    "text": "可一百四十年前",
    "chars_per_second": 6.31
   },
   {
    "i": 6,
    "start": 10.83,
    "end": 14.29,
    "text": "这是有人拿名声和一个孩子的命换来的",
    "chars_per_second": 4.91
   },
   {
    "i": 7,
    "start": 14.54,
    "end": 16.09,
    "text": "科学从来不是从天而降的幸运",
    "chars_per_second": 8.39
   },
   {
    "i": 8,
    "start": 16.44,
    "end": 18.86,
    "text": "而是有人敢在深渊面前不退",
    "chars_per_second": 4.96
   },
   {
    "i": 9,
    "start": 19.2,
    "end": 21.15,
    "text": "那管针剂",
    "chars_per_second": 2.05
   },
   {
    "i": 10,
    "start": 21.5,
    "end": 24.95,
    "text": "到今天还在护着每一个被抓伤的人",
    "chars_per_second": 4.35
   },
   {
    "i": 11,
    "start": 25.3,
    "end": 26.77,
    "text": "你上一次被小动物弄伤",
    "chars_per_second": 6.8
   },
   {
    "i": 12,
    "start": 27.09,
    "end": 28.07,
    "text": "是什么时候",
    "chars_per_second": 5.08
   }
  ]
 }
}