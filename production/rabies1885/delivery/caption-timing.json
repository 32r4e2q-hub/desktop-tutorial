[
  {
    "start": 0.6564879934993976,
    "end": 2.285225139398694,
    "text": "只要被疯狗咬上一口，"
  },
  {
    "start": 2.3417131328980916,
    "end": 3.895132954131525,
    "text": "哪怕只是一道血痕，"
  },
  {
    "start": 3.9327916164644567,
    "end": 5.589772759113453,
    "text": "你就已经进入了倒计时。"
  },
  {
    "start": 5.683919414945781,
    "end": 6.427677996021183,
    "text": "恐水、"
  },
  {
    "start": 6.493580655103813,
    "end": 7.12436324918042,
    "text": "痉挛、"
  },
  {
    "start": 7.133777914763653,
    "end": 7.764560508840259,
    "text": "窒息，"
  },
  {
    "start": 7.8587071646725875,
    "end": 9.9205189274006,
    "text": "人会在清醒里走向终点。"
  },
  {
    "start": 10.024080248816162,
    "end": 11.455109417467568,
    "text": "在疫苗出现之前，"
  },
  {
    "start": 11.549256073299897,
    "end": 12.989699907534535,
    "text": "狂犬病一旦发病，"
  },
  {
    "start": 13.093261228950096,
    "end": 15.437512959175095,
    "text": "病死率几乎就是百分之百。"
  },
  {
    "start": 15.541074280590658,
    "end": 17.169811426489954,
    "text": "史料里的抢救办法，"
  },
  {
    "start": 17.301616744655217,
    "end": 18.666743254223988,
    "text": "是烧灼伤口，"
  },
  {
    "start": 18.770304575639553,
    "end": 20.17308974754126,
    "text": "甚至把病人闷死。"
  },
  {
    "start": 20.29548040012329,
    "end": 21.858314886939954,
    "text": "而改写这个数字的，"
  },
  {
    "start": 21.93363221160582,
    "end": 23.1010507439267,
    "text": "不是救世主，"
  },
  {
    "start": 23.19519739975903,
    "end": 26.231427050351652,
    "text": "是一个连行医资格都没有的化学家。"
  },
  {
    "start": 27.367915043851053,
    "end": 29.307336153997035,
    "text": "他叫路易·巴斯德。"
  },
  {
    "start": 29.401482809829364,
    "end": 31.25617192972625,
    "text": "从一八八零年起，"
  },
  {
    "start": 31.35973325114181,
    "end": 34.363011572193116,
    "text": "他在巴黎的实验室里跟这种病较劲："
  },
  {
    "start": 34.45715822802545,
    "end": 36.63194597775225,
    "text": "把患病兔子的脊髓取出来、"
  },
  {
    "start": 36.66960464008518,
    "end": 37.498095211409684,
    "text": "干燥，"
  },
  {
    "start": 37.59224186724201,
    "end": 39.66346829555326,
    "text": "再接种到下一只兔子体内，"
  },
  {
    "start": 39.76702961696882,
    "end": 41.687621395948334,
    "text": "这样传了三十九次以上，"
  },
  {
    "start": 41.83825604528006,
    "end": 43.58938384376138,
    "text": "毒性一点一点减弱。"
  },
  {
    "start": 43.683530499593715,
    "end": 44.559094398834375,
    "text": "四年后，"
  },
  {
    "start": 44.662655720249944,
    "end": 46.263148869399544,
    "text": "这个办法在狗身上成了。"
  },
  {
    "start": 46.3667101908151,
    "end": 47.505884726386284,
    "text": "可同行质问他："
  },
  {
    "start": 47.609446047801846,
    "end": 48.908669898288,
    "text": "病原体都看不见，"
  },
  {
    "start": 48.908669898288,
    "end": 49.66184314494663,
    "text": "你凭什么？"
  },
  {
    "start": 49.76540446636219,
    "end": 50.72570035585194,
    "text": "更麻烦的是，"
  },
  {
    "start": 50.772773683768115,
    "end": 51.71424024209141,
    "text": "他不是医生。"
  },
  {
    "start": 51.81780156350697,
    "end": 54.21854128723136,
    "text": "给人打一种没验证过的东西，"
  },
  {
    "start": 54.32210260864693,
    "end": 55.34830115721931,
    "text": "一旦出事，"
  },
  {
    "start": 55.46127714421811,
    "end": 58.76582476393287,
    "text": "等着他的就是身败名裂和牢狱之灾。"
  },
  {
    "start": 59.84582476393287,
    "end": 62.2842231499902,
    "text": "一八八五年七月六日清晨，"
  },
  {
    "start": 62.49134579282132,
    "end": 66.12540670794922,
    "text": "一个九岁的男孩被母亲从阿尔萨斯带到他面前。"
  },
  {
    "start": 66.33252935078036,
    "end": 67.70707052593237,
    "text": "孩子叫约瑟夫，"
  },
  {
    "start": 67.7447291882653,
    "end": 70.39966488273699,
    "text": "两天前被疯狗咬伤十几处。"
  },
  {
    "start": 70.5502995320687,
    "end": 72.03781669421952,
    "text": "母亲只求他救一救。"
  },
  {
    "start": 72.11313401888538,
    "end": 73.88309114853317,
    "text": "巴斯德后来写下："
  },
  {
    "start": 73.99606713553196,
    "end": 76.36856286250665,
    "text": "孩子的结局看起来无法避免，"
  },
  {
    "start": 76.57568550533779,
    "end": 77.6112987194934,
    "text": "我极度焦虑，"
  },
  {
    "start": 77.70544537532574,
    "end": 81.94204488778055,
    "text": "还是决定用在狗身上从未失败过的办法试一次。"
  },
  {
    "start": 82.11150886827875,
    "end": 82.67638880327272,
    "text": "不治，"
  },
  {
    "start": 82.77053545910505,
    "end": 84.59698058225223,
    "text": "孩子几乎没有生路；"
  },
  {
    "start": 84.76644456275042,
    "end": 85.16186051724621,
    "text": "治，"
  },
  {
    "start": 85.274836504245,
    "end": 86.31044971840063,
    "text": "一旦失败，"
  },
  {
    "start": 86.42342570539942,
    "end": 88.21221216621367,
    "text": "所有的责难都会落在他一个人身上。"
  },
  {
    "start": 89.1913373868699,
    "end": 90.52821989968898,
    "text": "这位老人的手，"
  },
  {
    "start": 90.52821989968898,
    "end": 92.35466502283617,
    "text": "抖着拿起了注射器。"
  },
  {
    "start": 93.54764100983496,
    "end": 94.66798621423968,
    "text": "接下来的十天，"
  },
  {
    "start": 94.91276751940373,
    "end": 97.39823923337723,
    "text": "是这个实验室最难熬的十天。"
  },
  {
    "start": 97.56770321387542,
    "end": 98.39619378519993,
    "text": "每天一针，"
  },
  {
    "start": 98.39619378519993,
    "end": 100.65571352517583,
    "text": "一针比一针毒——按记载，"
  },
  {
    "start": 100.65571352517583,
    "end": 102.7081106223206,
    "text": "后面用的是毒性更强的制剂。"
  },
  {
    "start": 102.78342794698646,
    "end": 106.6246115049455,
    "text": "他是在拿一个孩子的命跟死神抢时间，"
  },
  {
    "start": 106.6246115049455,
    "end": 108.09329933592984,
    "text": "夜夜守着病床。"
  },
  {
    "start": 108.09329933592984,
    "end": 109.5431578357477,
    "text": "最后一针打完，"
  },
  {
    "start": 109.5431578357477,
    "end": 111.3131149653955,
    "text": "他等着最坏的消息。"
  },
  {
    "start": 111.3131149653955,
    "end": 113.13956008854268,
    "text": "可约瑟夫没有发病，"
  },
  {
    "start": 113.13956008854268,
    "end": 114.62707725069349,
    "text": "一天天好起来，"
  },
  {
    "start": 114.62707725069349,
    "end": 118.33645549048725,
    "text": "成了人类历史上第一个被狂犬病疫苗救下来的人。"
  },
  {
    "start": 119.58591947098546,
    "end": 120.63094735072431,
    "text": "消息传开，"
  },
  {
    "start": 120.70626467539017,
    "end": 121.77953655187873,
    "text": "病人从英国、"
  },
  {
    "start": 121.77953655187873,
    "end": 122.46680713945473,
    "text": "俄国、"
  },
  {
    "start": 122.46680713945473,
    "end": 123.12583373028104,
    "text": "意大利、"
  },
  {
    "start": 123.21056572053014,
    "end": 124.8863761943456,
    "text": "德国涌向巴黎。"
  },
  {
    "start": 124.98993751576116,
    "end": 126.58101599932752,
    "text": "到一八八六年十一月，"
  },
  {
    "start": 126.58101599932752,
    "end": 129.05707304771778,
    "text": "已有大约两千五百人接受这种治疗；"
  },
  {
    "start": 129.09473171005072,
    "end": 131.22244613186135,
    "text": "到一八九五年巴斯德去世时，"
  },
  {
    "start": 131.30717812211046,
    "end": 133.0394765894253,
    "text": "接受过的人接近两万，"
  },
  {
    "start": 133.1524525764241,
    "end": 135.02597102748746,
    "text": "死亡率不到千分之五。"
  },
  {
    "start": 135.129532348903,
    "end": 137.44554008237833,
    "text": "一八八八年十一月十四日，"
  },
  {
    "start": 137.54910140379388,
    "end": 139.62032783210512,
    "text": "巴斯德研究所在巴黎落成。"
  },
  {
    "start": 139.73330381910392,
    "end": 140.7595023676763,
    "text": "而直到今天，"
  },
  {
    "start": 140.9289663481745,
    "end": 143.70629269522823,
    "text": "全球每年仍有数万人死于狂犬病，"
  },
  {
    "start": 143.80985401664378,
    "end": 146.48832637507354,
    "text": "其中约四成是十五岁以下的孩子。"
  },
  {
    "start": 147.56832637507355,
    "end": 148.02023032306874,
    "text": "今天，"
  },
  {
    "start": 148.02023032306874,
    "end": 149.526576816386,
    "text": "我们被猫狗抓伤，"
  },
  {
    "start": 149.526576816386,
    "end": 151.57897391353077,
    "text": "能淡定地去疾控中心，"
  },
  {
    "start": 151.57897391353077,
    "end": 155.90972008181794,
    "text": "按五针法或者四针法打完疫苗回家——平常得像顺"
  },
  {
    "start": 155.90972008181794,
    "end": 156.62523466614363,
    "text": "手关灯。"
  },
  {
    "start": 156.62523466614363,
    "end": 158.3575331334585,
    "text": "可一百四十年前，"
  },
  {
    "start": 158.3575331334585,
    "end": 161.7656420745888,
    "text": "这是有人拿名声和一个孩子的命换来的。"
  },
  {
    "start": 161.7656420745888,
    "end": 164.3076017820617,
    "text": "科学从来不是从天而降的幸运，"
  },
  {
    "start": 164.3076017820617,
    "end": 166.66126817786994,
    "text": "而是有人敢在深渊面前不退。"
  },
  {
    "start": 166.66126817786994,
    "end": 167.33912409986272,
    "text": "那管针剂，"
  },
  {
    "start": 167.33912409986272,
    "end": 170.63425705399422,
    "text": "到今天还在护着每一个被抓伤的人。"
  },
  {
    "start": 170.63425705399422,
    "end": 172.63016615763962,
    "text": "你上一次被小动物弄伤，"
  },
  {
    "start": 172.63016615763962,
    "end": 174.0,
    "text": "是什么时候？"
  }
]