[
  {
    "start": 0.6,
    "end": 2.3914691943127964,
    "text": "狂犬病可怕在："
  },
  {
    "start": 2.6429034671988028,
    "end": 4.109603392367174,
    "text": "症状一旦出现，"
  },
  {
    "start": 4.3819905213270145,
    "end": 5.890596158643054,
    "text": "几乎没有回头路。"
  },
  {
    "start": 5.890596158643054,
    "end": 8.09064604639561,
    "text": "恐水等神经症状之后，"
  },
  {
    "start": 8.342080319281617,
    "end": 10.039261661262161,
    "text": "患者可能走向死亡。"
  },
  {
    "start": 10.144025941631329,
    "end": 11.38024444998753,
    "text": "疫苗出现前，"
  },
  {
    "start": 11.526914442504365,
    "end": 13.391718633075582,
    "text": "人们试过烧灼伤口，"
  },
  {
    "start": 13.622200049887754,
    "end": 15.067947118982291,
    "text": "却没有可靠保护。"
  },
  {
    "start": 15.088899975056124,
    "end": 16.51369418807683,
    "text": "改写这一切的，"
  },
  {
    "start": 16.6813170366675,
    "end": 17.77086555250686,
    "text": "不是一位医生，"
  },
  {
    "start": 17.9175355450237,
    "end": 19.363282614118237,
    "text": "而是一位化学家："
  },
  {
    "start": 19.572811174856575,
    "end": 20.68331254676977,
    "text": "路易·巴斯德。"
  },
  {
    "start": 20.809029683212774,
    "end": 22.443352456971816,
    "text": "可他即将面对的，"
  },
  {
    "start": 22.443352456971816,
    "end": 23.972910950361687,
    "text": "不是一道理论题，"
  },
  {
    "start": 23.993863806435524,
    "end": 25.837715140932904,
    "text": "而是一个九岁男孩。"
  },
  {
    "start": 26.991050137191323,
    "end": 28.71966076328262,
    "text": "从一八八零年起，"
  },
  {
    "start": 28.908236467947123,
    "end": 31.96735345472687,
    "text": "巴斯德团队在巴黎研究狂犬病。"
  },
  {
    "start": 32.072117735096036,
    "end": 35.571244699426295,
    "text": "他们先让病原在兔之间连续传代，"
  },
  {
    "start": 35.634103267647795,
    "end": 38.4208331254677,
    "text": "得到潜伏期稳定的固定病毒；"
  },
  {
    "start": 38.56750311798454,
    "end": 41.752337241207286,
    "text": "再把感染兔的脊髓悬在干燥空气中，"
  },
  {
    "start": 41.83614866550262,
    "end": 43.65904714392617,
    "text": "令毒力下降。随后，"
  },
  {
    "start": 43.82666999251684,
    "end": 46.99055125966576,
    "text": "团队按由弱到强的次序给动物接种，"
  },
  {
    "start": 47.05340982788726,
    "end": 48.582968321277136,
    "text": "狗的实验给了希望。"
  },
  {
    "start": 48.582968321277136,
    "end": 50.42681965577451,
    "text": "但病原肉眼看不见，"
  },
  {
    "start": 50.59444250436518,
    "end": 52.43829383886256,
    "text": "巴斯德又不是执业医生。"
  },
  {
    "start": 52.48019955101023,
    "end": 55.1202594163133,
    "text": "把尚无人体证据的方法用于人，"
  },
  {
    "start": 55.39264654527314,
    "end": 56.775535046146175,
    "text": "后果无法预料。"
  },
  {
    "start": 57.91315540034922,
    "end": 59.914153155400356,
    "text": "一八八五年七月六日，"
  },
  {
    "start": 60.12368171613869,
    "end": 63.45518583187828,
    "text": "阿尔萨斯的约瑟夫·迈斯特被母亲带到巴黎；"
  },
  {
    "start": 63.55759291593914,
    "end": 64.55759291593914,
    "text": "他九岁，"
  },
  {
    "start": 64.60759291593914,
    "end": 68.92388126714891,
    "text": "两天前被一只据报患狂犬病的狗咬了十四处。"
  },
  {
    "start": 69.00769269144425,
    "end": 70.00769269144425,
    "text": "巴斯德写道，"
  },
  {
    "start": 70.30676976802195,
    "end": 72.42300823147917,
    "text": "孩子的死亡看起来不可避免，"
  },
  {
    "start": 72.59063108006984,
    "end": 75.02116238463458,
    "text": "自己是在极度焦虑中作出决定。"
  },
  {
    "start": 75.06306809678225,
    "end": 76.29928660513843,
    "text": "他没有亲手注射："
  },
  {
    "start": 76.42500374158145,
    "end": 77.80789224245449,
    "text": "在医生支持下，"
  },
  {
    "start": 78.05932651534049,
    "end": 81.43273634322775,
    "text": "儿科医生雅克—约瑟夫·格朗谢执行第一针。"
  },
  {
    "start": 81.51654776752308,
    "end": 82.73181341980543,
    "text": "没有随机对照，"
  },
  {
    "start": 82.85753055624845,
    "end": 84.59661761037665,
    "text": "也没有今天的伦理审查。"
  },
  {
    "start": 85.77614367672737,
    "end": 87.00188575704665,
    "text": "随后十天，"
  },
  {
    "start": 87.211414317785,
    "end": 90.9200698428536,
    "text": "迈斯特接受十几次由弱到强的制剂；"
  },
  {
    "start": 91.1086455475181,
    "end": 94.146809678224,
    "text": "不同史料记为十三针或十四剂。"
  },
  {
    "start": 94.29347967074085,
    "end": 96.15828386131206,
    "text": "原理简单也冒险："
  },
  {
    "start": 96.45162384634573,
    "end": 98.08594662010478,
    "text": "先给免疫系统时间，"
  },
  {
    "start": 98.29547518084311,
    "end": 100.99839361436769,
    "text": "再让它迎向更强的病毒材料。"
  },
  {
    "start": 101.12411075081069,
    "end": 103.15653778997257,
    "text": "迈斯特最终没有发病。"
  },
  {
    "start": 103.24034921426791,
    "end": 107.0747218757795,
    "text": "但一个成功病例不能替代今天的临床试验；"
  },
  {
    "start": 107.1247218757795,
    "end": 108.1247218757795,
    "text": "它提示，"
  },
  {
    "start": 108.1747218757795,
    "end": 110.86718882514344,
    "text": "暴露之后仍可能追上疾病。"
  },
  {
    "start": 112.05719131953106,
    "end": 113.1362634073335,
    "text": "消息传开，"
  },
  {
    "start": 113.24102768770267,
    "end": 116.27919181840858,
    "text": "被动物咬伤的人从多国赶到巴黎。"
  },
  {
    "start": 116.27919181840858,
    "end": 118.22780743327513,
    "text": "到一八八六年十一月，"
  },
  {
    "start": 118.41638313793963,
    "end": 121.0564430032427,
    "text": "约两千五百人接受过这种治疗；"
  },
  {
    "start": 121.07739585931654,
    "end": 123.67555001247194,
    "text": "到巴斯德一八九五年去世时，"
  },
  {
    "start": 123.75936143676728,
    "end": 125.07939136941881,
    "text": "人数接近两万。"
  },
  {
    "start": 125.16320279371415,
    "end": 127.4261112496882,
    "text": "需求推动建立专门机构："
  },
  {
    "start": 127.5518283861312,
    "end": 129.43758543277625,
    "text": "一八八七年募款启动，"
  },
  {
    "start": 129.54234971314543,
    "end": 131.65858817660265,
    "text": "一八八八年十一月十四日，"
  },
  {
    "start": 131.74239960089798,
    "end": 134.27769518583187,
    "text": "巴斯德研究所在巴黎正式开放。"
  },
  {
    "start": 134.27769518583187,
    "end": 135.74439511100024,
    "text": "一次紧急救治，"
  },
  {
    "start": 135.7653479670741,
    "end": 138.21683212771265,
    "text": "变成持续的公共卫生事业。"
  },
  {
    "start": 139.39635819406337,
    "end": 140.39635819406337,
    "text": "今天，"
  },
  {
    "start": 140.45447742579196,
    "end": 143.59740583686707,
    "text": "狂犬病仍会夺走数万人的生命，"
  },
  {
    "start": 143.78598154153156,
    "end": 146.3422299825393,
    "text": "儿童承受的负担尤其重。"
  },
  {
    "start": 146.3422299825393,
    "end": 149.0032427039162,
    "text": "但现代暴露后预防已不同："
  },
  {
    "start": 149.25467697680222,
    "end": 150.6166126216014,
    "text": "细胞培养疫苗、"
  },
  {
    "start": 150.8680468944874,
    "end": 153.5919181840858,
    "text": "免疫球蛋白和规范评估，"
  },
  {
    "start": 153.88525816911948,
    "end": 155.83387378398604,
    "text": "取代了干燥兔脊髓。"
  },
  {
    "start": 156.04340234472437,
    "end": 158.07582938388626,
    "text": "遇到动物咬伤或抓伤，"
  },
  {
    "start": 158.1596408081816,
    "end": 161.3025692192567,
    "text": "先用肥皂和流动水彻底清洗，"
  },
  {
    "start": 161.3025692192567,
    "end": 164.92741332002993,
    "text": "再尽快联系当地医生或公共卫生机构，"
  },
  {
    "start": 165.0112247443253,
    "end": 167.10651035170866,
    "text": "由专业人员判断下一步。"
  },
  {
    "start": 167.1274632077825,
    "end": 168.42654028436021,
    "text": "巴斯德留下的，"
  },
  {
    "start": 168.46844599650788,
    "end": 169.51608880019955,
    "text": "是一个原则："
  },
  {
    "start": 169.51608880019955,
    "end": 171.67423297580444,
    "text": "证据要先于传奇，"
  },
  {
    "start": 171.8837615365428,
    "end": 173.85333000748318,
    "text": "救治要快于病毒。"
  }
]