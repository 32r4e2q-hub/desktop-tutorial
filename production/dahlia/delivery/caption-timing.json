[
  {
    "start": 0.6,
    "end": 3.2989247311827956,
    "text": "一九四七年一月十五日，"
  },
  {
    "start": 3.664516129032258,
    "end": 4.417204301075269,
    "text": "洛杉矶。"
  },
  {
    "start": 5.06236559139785,
    "end": 7.750537634408602,
    "text": "一位母亲带着孩子经过空地，"
  },
  {
    "start": 8.13763440860215,
    "end": 10.739784946236558,
    "text": "最初以为路边躺着一个假人。"
  },
  {
    "start": 11.277419354838708,
    "end": 12.610752688172042,
    "text": "走近后，"
  },
  {
    "start": 12.6752688172043,
    "end": 13.513978494623654,
    "text": "她才发现，"
  },
  {
    "start": 13.686021505376344,
    "end": 16.073118279569893,
    "text": "那是一名遇害的年轻女子。"
  },
  {
    "start": 16.653763440860214,
    "end": 18.39569892473118,
    "text": "更反常的是，"
  },
  {
    "start": 18.63225806451613,
    "end": 20.202150537634406,
    "text": "现场没有血迹。"
  },
  {
    "start": 20.847311827956993,
    "end": 22.632258064516126,
    "text": "警方由此判断："
  },
  {
    "start": 22.825806451612905,
    "end": 25.126881720430106,
    "text": "这里很可能不是第一现场。"
  },
  {
    "start": 25.836559139784946,
    "end": 26.460215053763438,
    "text": "是谁，"
  },
  {
    "start": 26.782795698924733,
    "end": 28.051612903225802,
    "text": "把她带到了这里？"
  },
  {
    "start": 29.292903225806448,
    "end": 33.86279569892473,
    "text": "警方把指纹通过照片传真传给联邦调查局。"
  },
  {
    "start": 34.27139784946236,
    "end": 35.71225806451613,
    "text": "五十六分钟后，"
  },
  {
    "start": 35.94881720430107,
    "end": 37.067096774193544,
    "text": "身份得到确认。"
  },
  {
    "start": 37.38967741935483,
    "end": 39.497204301075264,
    "text": "她叫伊丽莎白·肖特，"
  },
  {
    "start": 39.81978494623655,
    "end": 40.615483870967736,
    "text": "二十二岁。"
  },
  {
    "start": 41.497204301075264,
    "end": 44.09935483870967,
    "text": "她曾因求职等原因留下指纹，"
  },
  {
    "start": 44.52946236559139,
    "end": 45.99182795698924,
    "text": "旧档案认出了她，"
  },
  {
    "start": 46.35741935483871,
    "end": 47.60473118279569,
    "text": "却指不出凶手。"
  },
  {
    "start": 48.314408602150536,
    "end": 50.70150537634408,
    "text": "媒体后来给她起了一个名字："
  },
  {
    "start": 50.91655913978494,
    "end": 52.27139784946236,
    "text": "黑色大丽花。"
  },
  {
    "start": 53.067096774193544,
    "end": 54.87354838709677,
    "text": "可一个耸动的称呼，"
  },
  {
    "start": 55.067096774193544,
    "end": 57.02408602150537,
    "text": "并不能解释她遭遇了什么。"
  },
  {
    "start": 57.84129032258064,
    "end": 60.787526881720424,
    "text": "调查必须回到她失踪前的生活。"
  },
  {
    "start": 62.114838709677414,
    "end": 64.20086021505375,
    "text": "警方当年的调查通告，"
  },
  {
    "start": 64.20086021505375,
    "end": 67.79225806451612,
    "text": "把目光锁定在一月九日至十五日。"
  },
  {
    "start": 67.79225806451612,
    "end": 69.44817204301074,
    "text": "通告记录，"
  },
  {
    "start": 69.44817204301074,
    "end": 73.44817204301074,
    "text": "她一月九日曾在比尔特莫尔酒店下车。"
  },
  {
    "start": 73.44817204301074,
    "end": 75.14709677419354,
    "text": "此后几天，"
  },
  {
    "start": 75.14709677419354,
    "end": 76.41591397849461,
    "text": "她去了哪里，"
  },
  {
    "start": 76.41591397849461,
    "end": 77.31913978494623,
    "text": "见过谁？"
  },
  {
    "start": 77.31913978494623,
    "end": 79.94279569892473,
    "text": "时间线出现了空白。"
  },
  {
    "start": 79.94279569892473,
    "end": 82.05032258064516,
    "text": "要找到凶手，"
  },
  {
    "start": 82.05032258064516,
    "end": 84.97505376344085,
    "text": "首先要把这段行踪接起来，"
  },
  {
    "start": 84.97505376344085,
    "end": 87.23311827956988,
    "text": "而不是用传闻填满它。"
  },
  {
    "start": 88.31311827956989,
    "end": 89.20559139784946,
    "text": "随后，"
  },
  {
    "start": 89.4421505376344,
    "end": 92.10881720430108,
    "text": "一封匿名信带来了新的希望。"
  },
  {
    "start": 92.60344086021506,
    "end": 94.25935483870968,
    "text": "它会不会来自凶手？"
  },
  {
    "start": 94.94752688172044,
    "end": 98.10881720430108,
    "text": "联邦调查局尝试比对信上的指纹，"
  },
  {
    "start": 98.3883870967742,
    "end": 100.53892473118279,
    "text": "却没有在档案中找到匹配。"
  },
  {
    "start": 101.1410752688172,
    "end": 102.77548387096775,
    "text": "信是谁寄的，"
  },
  {
    "start": 102.94752688172042,
    "end": 104.13032258064516,
    "text": "依然不能确定。"
  },
  {
    "start": 104.90451612903226,
    "end": 106.00129032258064,
    "text": "另一方面，"
  },
  {
    "start": 106.25935483870967,
    "end": 109.4636559139785,
    "text": "警方怀疑作案者可能具有解剖技能，"
  },
  {
    "start": 109.74322580645162,
    "end": 111.57118279569892,
    "text": "于是扩大调查范围。"
  },
  {
    "start": 112.04430107526882,
    "end": 113.09806451612903,
    "text": "但怀疑，"
  },
  {
    "start": 113.2916129032258,
    "end": 114.51741935483871,
    "text": "并不是证据。"
  },
  {
    "start": 115.80172043010752,
    "end": 118.5974193548387,
    "text": "调查人员核查嫌疑人的记录，"
  },
  {
    "start": 118.5974193548387,
    "end": 121.26408602150538,
    "text": "并在美国多地展开访谈。"
  },
  {
    "start": 121.26408602150538,
    "end": 123.11354838709677,
    "text": "线索不断增加，"
  },
  {
    "start": 123.11354838709677,
    "end": 125.00602150537634,
    "text": "却始终没能把身份、"
  },
  {
    "start": 125.00602150537634,
    "end": 129.11354838709678,
    "text": "地点和作案过程连成一条可证实的链。"
  },
  {
    "start": 129.11354838709678,
    "end": 130.83397849462364,
    "text": "几十年里，"
  },
  {
    "start": 130.83397849462364,
    "end": 132.83397849462364,
    "text": "各种理论轮番出现。"
  },
  {
    "start": 132.83397849462364,
    "end": 135.2210752688172,
    "text": "有人指向某个嫌疑人，"
  },
  {
    "start": 135.2210752688172,
    "end": 137.13505376344085,
    "text": "有人声称已经破案。"
  },
  {
    "start": 137.13505376344085,
    "end": 139.78021505376344,
    "text": "可一个讲得通的故事，"
  },
  {
    "start": 139.78021505376344,
    "end": 142.98451612903224,
    "text": "不等于一个被证明的事实。"
  },
  {
    "start": 144.06451612903226,
    "end": 146.32258064516128,
    "text": "我们能够确认的，"
  },
  {
    "start": 146.32258064516128,
    "end": 147.29032258064515,
    "text": "是她的身份、"
  },
  {
    "start": 147.29032258064515,
    "end": 149.3763440860215,
    "text": "遗体被发现的日期，"
  },
  {
    "start": 149.3763440860215,
    "end": 151.54838709677418,
    "text": "以及调查留下的缺口。"
  },
  {
    "start": 151.54838709677418,
    "end": 155.67741935483872,
    "text": "按照联邦调查局公布的案件资料，"
  },
  {
    "start": 155.67741935483872,
    "end": 157.91397849462365,
    "text": "这起谋杀案仍未侦破。"
  },
  {
    "start": 157.91397849462365,
    "end": 162.81720430107526,
    "text": "悬念没有一个可以负责任写下的凶手名字。"
  },
  {
    "start": 162.81720430107526,
    "end": 165.11827956989248,
    "text": "而在所有传说之前，"
  },
  {
    "start": 165.11827956989248,
    "end": 166.94623655913978,
    "text": "应该被记住的，"
  },
  {
    "start": 166.94623655913978,
    "end": 169.0752688172043,
    "text": "是一个真实的人。"
  },
  {
    "start": 169.0752688172043,
    "end": 171.16129032258064,
    "text": "伊丽莎白·肖特。"
  },
  {
    "start": 171.16129032258064,
    "end": 174.0,
    "text": "她只有二十二岁。"
  }
]