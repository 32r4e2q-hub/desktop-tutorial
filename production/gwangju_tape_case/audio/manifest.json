      "target_start": 30,
      "target_duration": 5,
      "alignment": "shot-locked",
      "source_duration": 4.545,
      "atempo": 1.0,
      "tail_silence_seconds": 0.455
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "text": "晚上八点左右，母亲结束聚会，朝公寓走回家。",
      "sha256": "e53bf8913a88baa4970546d0ccabc0acfda227c4421f0b171bd9e20354f34a05",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
      "narration_id": "N03",
      "target_start": 35,
      "target_duration": 7,
      "alignment": "shot-locked",
      "source_duration": 4.754,
      "atempo": 1.0,
      "tail_silence_seconds": 2.246
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "text": "晚上八点左右，母亲回家，玄关却一片凌乱。",
