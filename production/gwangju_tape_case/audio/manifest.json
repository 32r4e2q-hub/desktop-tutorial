      "atempo": 1.0,
      "tail_silence_seconds": 2.063
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "母亲离开后，善雅起床，准备去学校上课。",
      "sha256": "646a85896ae61609221ea44db117ff40f3036b52180d16facbe7593c6900a7a8",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
