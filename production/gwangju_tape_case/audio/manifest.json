      "target_duration": 6,
      "alignment": "shot-locked",
      "source_duration": 4.467,
      "atempo": 1.0,
      "tail_silence_seconds": 1.533
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "text": "她想拨112报警，却慌乱中按成119。",
      "sha256": "c19ec2a4b9973a8c6c77669e73a100d544bc72aa1df694ef5a45e430c7418fbd",
      "voice_id": "voice-00",
      "voice_description": "悬疑低沉、克制的成熟普通话男声",
