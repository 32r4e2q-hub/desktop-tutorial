      "atempo": 1.0,
      "tail_silence_seconds": 1.044
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "八点五十五分，母亲留下便当，轻轻关门离开。",
      "sha256": "5e7c3092da275e4dabbc62f017b691ca6665b4420a6db605e105f17ddf4646af",
