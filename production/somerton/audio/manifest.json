  "clips": [
    {
      "id": "S01",
      "file": "S01.mp3",
      "text": "一九四八年，阿德莱德索马顿海滩，天亮前异常安静。",
      "sha256": "75bc49c0aafae77a24e5cfecc2ca2c508ef00ffcaa76149c0987c5882d5b0b15",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N01",
      "target_start": 0,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S02",
      "file": "S02.mp3",
      "text": "海堤边坐着一名西装整齐的陌生人；他是谁，无人知晓。",
      "sha256": "bca13b48ce85bff5d9cfacd2ab7a269f3c209a6af80d0e40c58612ccf7774157",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N01",
      "target_start": 5,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S03",
      "file": "S03.mp3",
      "text": "十二月一日清晨，海边行人走近海堤，发现他已没有生命迹象。",
      "sha256": "d3ab3350a6461ac22c600de85c31a4032515077a03ea40bcdbe384d92be9d76a",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N02",
      "target_start": 10,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S04",
      "file": "S04.mp3",
      "text": "警方迅速赶到现场；他没有证件，也没有明显外伤，身份无从查起。",
      "sha256": "a5af29aa68fcd61e35aae6257fb3a929bcaba8e4826591d7fe246e74bccff175",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N02",
      "target_start": 17,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S05",
      "file": "S05.mp3",
      "text": "有人回忆，前一晚他靠着海堤一动不动；路人以为他只是睡着了。",
      "sha256": "ce26c27f188d5ae0ead577dafefa6d54722cba6c252e6f3b68d070003766bc07",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N02",
      "target_start": 24,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S06",
      "file": "S06.mp3",
      "text": "警方逐件检查随身物品，却找不到姓名、住址或身份凭证。",
      "sha256": "29f9e4be227011bfc9328218f5a3e2ef5c70c2d415392cd68e6836ca1d2a214f",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N02",
      "target_start": 30,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S07",
      "file": "S07.mp3",
      "text": "他身上几乎所有衣物标签都被剪掉，连来源和姓名也难以追查。",
      "sha256": "833f5752ef1f52bc48a8c045e8788407384000b70f9df981de6546ac2253df94",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N03",
      "target_start": 35,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S08",
      "file": "S08.mp3",
      "text": "指纹和牙齿记录送去比对，档案里仍找不到任何身份匹配。",
      "sha256": "6d8427a29917376812e375530b90bd68515dab655c8ed6c791d2ad0aaff2ac23",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N03",
      "target_start": 42,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S09",
      "file": "S09.mp3",
      "text": "尸检发现内脏充血，疑似中毒；常见毒物检测无结果，死因未明。",
      "sha256": "42c31bbd2dd4973d5ba5c2e70685c369c7a8e20459b616a8480b165faf40dcc0",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N03",
      "target_start": 49,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S10",
      "file": "S10.mp3",
      "text": "一九四九年一月，阿德莱德火车站寄存处发现一只旧皮箱。",
      "sha256": "8ea51dafd1499bddd33dc7044e7a8d4c7b0bb87fe59d56a5424f304c2d88132c",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N04",
      "target_start": 55,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S11",
      "file": "S11.mp3",
      "text": "警方怀疑皮箱属于死者；箱内装着衣物、剃须用品和橙色缝线。",
      "sha256": "2919ebe165478777a60dd9d507c411e109d184ea158a97555f4a216e1dd0efa6",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N04",
      "target_start": 62,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S12",
      "file": "S12.mp3",
      "text": "线头与裤子修补处相合；衣物出现“基恩”姓氏，却无匹配失踪报告。",
      "sha256": "a1c2fa605fea4a6bc6246ea1c2dd338e02ac904273e37c62b2ba34f960028af5",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N04",
      "target_start": 69,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S13",
      "file": "S13.mp3",
      "text": "复查衣物时，验尸官从裤子暗袋里取出一卷被藏起的小纸片。",
      "sha256": "3d26b6f159010d532891844527a711eca6626ad3ab7919c4e7f48d034ef433c3",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N05",
      "target_start": 75,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S14",
      "file": "S14.mp3",
      "text": "纸上印着两个波斯语词：“Tamam Shud”，通常译作“结束了”。",
      "sha256": "b01c1f7e567f24303d1772c69adae88f70b9d6e3a1caa9b9ff83ce40b51820a8",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N05",
      "target_start": 82,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S15",
      "file": "S15.mp3",
      "text": "纸片来自《鲁拜集》末页；那本诗集恰好缺了最后一页。",
      "sha256": "1792eb16603651170fe1c05817822dc978528dad85b3133c0844e11c9d7a6ab0",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N05",
      "target_start": 89,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S16",
      "file": "S16.mp3",
      "text": "警方找到诗集后，撕口与纸片边缘严丝合缝。",
      "sha256": "d2b91d5f26268771cce2a15caafb9203190c41421dd4b8d2d5596df6a35ae478",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N05",
      "target_start": 95,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S17",
      "file": "S17.mp3",
      "text": "研究者在诗集封底发现潦草字母；几十年来，仍没人能可靠解读。",
      "sha256": "10d0cea29ce801f1c3f209a90e2ee157d39626a35c5798e35b75a1d0d848692e",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N06",
      "target_start": 100,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S18",
      "file": "S18.mp3",
      "text": "探员和研究者反复比对各种可能，依然没有公认的密码解读。",
      "sha256": "a49b4545169d8eaac12bf61895cc8c496f886ae2a932bc2af7ec656915434ae9",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N06",
      "target_start": 107,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S19",
      "file": "S19.mp3",
      "text": "书页上的电话号码追查到附近一位护士，警方于是登门询问。",
      "sha256": "f0ba61af33a7ee04c923f05889dc4b46253a9b57230d81fb87df452421605a4e",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N06",
      "target_start": 114,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S20",
      "file": "S20.mp3",
      "text": "她说不认识死者，也不知道自己的号码为何出现在诗集里。",
      "sha256": "b48b21c6e402119d1b0cc2fc4e2a7f26aaa8c7d6acae6be8728b05b343216eba",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N06",
      "target_start": 120,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S21",
      "file": "S21.mp3",
      "text": "案件登上报纸，公众追问：这个衣着整齐、没有身份的男人是谁？",
      "sha256": "115f594cad1e5d173201f7585ad7a7edaedca5345ae30c56967f3d06db794821",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N07",
      "target_start": 125,
      "target_duration": 8,
      "alignment": "shot-locked"
    },
    {
      "id": "S22",
      "file": "S22.mp3",
      "text": "冷战时期，间谍猜想甚嚣尘上；但没有证据证明他参与秘密行动。",
      "sha256": "5f9e8c6567fe85aa5bb6527379bb0c1999c6a3acc52d5b39d98da0c924c0b466",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N07",
      "target_start": 133,
      "target_duration": 8,
      "alignment": "shot-locked"
    },
    {
      "id": "S23",
      "file": "S23.mp3",
      "text": "情杀、毒杀后抛尸，这些说法反复流传；至今都没有证据证实。",
      "sha256": "cbb4204d7706c953328d2c05ac8c479053badb6728d5312c1d9f1a3ae97af67d",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N07",
      "target_start": 141,
      "target_duration": 9,
      "alignment": "shot-locked"
    },
    {
      "id": "S24",
      "file": "S24.mp3",
      "text": "二〇二二年，研究团队用石膏死亡面模里的头发做DNA家谱分析。",
      "sha256": "7470b77c268d1229a32f35645f453964bbbb61eaae463e03427346e16f0b0fd8",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N08",
      "target_start": 150,
      "target_duration": 7,
      "alignment": "shot-locked"
    },
    {
      "id": "S25",
      "file": "S25.mp3",
      "text": "家谱线索层层追溯，研究者把身份指向卡尔·查尔斯·韦伯。",
      "sha256": "6ccdc57dccd9048f644d32e45ce7060f435f110a930abe781facf8ef3ab0dca0",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N08",
      "target_start": 157,
      "target_duration": 6,
      "alignment": "shot-locked"
    },
    {
      "id": "S26",
      "file": "S26.mp3",
      "text": "韦伯一九〇五年出生于墨尔本，是一名电气工程师。",
      "sha256": "189ca2ff546d97fa183d34d461b3dc2499f39f0bb76c620d9e7008c9af259b71",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N08",
      "target_start": 163,
      "target_duration": 5,
      "alignment": "shot-locked"
    },
    {
      "id": "S27",
      "file": "S27.mp3",
      "text": "研究者称把握超九成九；警方仍未正式确认。",
      "sha256": "2a598a83febbd0cfd3eb65804bb08e39f75a04c487602281fe476ff3a1a7a5e4",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N08",
      "target_start": 168,
      "target_duration": 4,
      "alignment": "shot-locked"
    },
    {
      "id": "S28",
      "file": "S28.mp3",
      "text": "身份线索有了方向，死因和密码依旧没有答案。",
      "sha256": "5950e14be464102b42d5c80950eade1a29d5b402ca72801f14b8325250d5db21",
      "voice_id": "voice-01",
      "voice_description": "用户试听选定的普通话男声；逐镜独立生成，叙事要求利落、有精神",
      "narration_id": "N09",
      "target_start": 172,
      "target_duration": 4,
      "alignment": "shot-locked"
    },
    {
      "id": "S29",
      "file": "S29.mp3",
      "text": "你觉得他是谁？评论区说说你的判断。",
      "sha256": "0f8cdaf86872761173a1c5c35651392631da42b8d7255d6fcbbbbee2c7c05ee3",
      "voice_id": "voice-01",
