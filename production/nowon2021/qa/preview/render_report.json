  "voice_windows": [
    {
      "id": "SH01",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH01.mp3",
      "start": 0.12,
      "end": 4.9,
      "tempo": 1.00418410041841,
      "caption_start": 0.4300357791666667,
      "caption_end": 4.623531770833334,
      "pauses": [
        1.53290078125,
        2.736219972916667,
        4.007920052083334
      ],
      "text": "他没有撬锁，也没有破窗，只说了一句：快递。",
      "keywords": [
        "快递"
      ]
    },
    {
      "id": "SH02",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH02.mp3",
      "start": 5.12,
      "end": 8.48,
      "tempo": 1.0,
      "caption_start": 5.407125,
      "caption_end": 8.132958,
      "pauses": [
        6.4342085
      ],
      "text": "门开了，那个人却没有离开。",
      "keywords": [
        "门"
      ]
    },
    {
      "id": "SH03",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH03.mp3",
      "start": 10.12,
      "end": 16.88,
      "tempo": 1.0,
      "caption_start": 10.425332999999998,
      "caption_end": 16.563958,
      "pauses": [
        12.132375,
        14.562895999999999,
        15.606458
      ],
      "text": "二零二一年三月，首尔芦原区的一栋公寓里，住着母亲和两个女儿。",
      "keywords": [
        "二零二一年",
        "芦原区"
      ]
    },
    {
      "id": "SH04",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH04.mp3",
      "start": 17.12,
      "end": 23.36,
      "tempo": 1.0,
      "caption_start": 17.409958,
      "caption_end": 23.118958,
      "pauses": [
        19.012104,
        19.245792,
        21.5045
      ],
      "text": "小女儿还在读书，家里有书页翻动的声音，也有平常的晚餐。",
      "keywords": [
        "小女儿"
      ]
    },
    {
      "id": "SH05",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH05.mp3",
      "start": 24.12,
      "end": 29.6,
      "tempo": 1.0,
      "caption_start": 24.423958000000002,
      "caption_end": 29.228833,
      "pauses": [
        26.180667,
        27.131
      ],
      "text": "大女儿在公司工作，她不知道，危险正一步步靠近。",
      "keywords": [
        "大女儿"
      ]
    },
    {
      "id": "SH06",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH06.mp3",
      "start": 30.12,
      "end": 33.24,
      "tempo": 1.0,
      "caption_start": 30.492125,
      "caption_end": 32.942167,
      "pauses": [
        31.988291500000003
      ],
      "text": "母亲忙完一天，准备回家。",
      "keywords": [
        "母亲"
      ]
    },
    {
      "id": "SH07",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH07.mp3",
      "start": 35.12,
      "end": 41.9,
      "tempo": 1.014749262536873,
      "caption_start": 35.405087174418604,
      "caption_end": 41.55085759302325,
      "pauses": [
        37.190298129360464,
        39.864973638081395
      ],
      "text": "男子叫金泰贤，他和大女儿因网络游戏相识，后来开始不断纠缠。",
      "keywords": [
        "金泰贤",
        "网络游戏"
      ]
    },
    {
      "id": "SH08",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH08.mp3",
      "start": 42.12,
      "end": 48.32,
      "tempo": 1.0,
      "caption_start": 42.445,
      "caption_end": 48.053332999999995,
      "pauses": [
        43.619249999999994,
        45.036604499999996,
        45.3444375,
        46.8845835
      ],
      "text": "线下相处后，双方关系恶化；大女儿拒绝联系，也切断了沟通。",
      "keywords": [
        "拒绝联系"
      ]
    },
    {
      "id": "SH09",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH09.mp3",
      "start": 49.12,
      "end": 54.9,
      "tempo": 1.024221453287197,
      "caption_start": 49.448135091216216,
      "caption_end": 54.51991422972973,
      "pauses": [
        51.269539528716216,
        52.709128589527026
      ],
      "text": "拒绝已经很清楚，可他没有停下，反而继续寻找她。",
      "keywords": [
        "拒绝"
      ]
    },
    {
      "id": "SH10",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH10.mp3",
      "start": 55.12,
      "end": 59.9,
      "tempo": 1.0962343096234308,
      "caption_start": 55.362459114503814,
      "caption_end": 59.63929661068702,
      "pauses": [
        56.14618344465649,
        57.77275541412214,
        58.00873416221374,
        58.50286848664122
      ],
      "text": "被拉黑，不是这场纠缠的终点，而是危险的前兆。",
      "keywords": [
        "拉黑"
      ]
    },
    {
      "id": "SH11",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH11.mp3",
      "start": 60.12,
      "end": 66.39999999999999,
      "tempo": 1.0,
      "caption_start": 60.451958,
      "caption_end": 66.114875,
      "pauses": [
        61.772583499999996,
        62.669582999999996,
        64.7579795
      ],
      "text": "警方调查显示，案发前他曾搜索伤害他人的方法，并打探她的行踪。",
      "keywords": [
        "警方调查"
      ]
    },
    {
      "id": "SH12",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH12.mp3",
      "start": 67.12,
      "end": 73.9,
      "tempo": 1.0088495575221237,
      "caption_start": 67.4762225877193,
      "caption_end": 73.39579499122807,
      "pauses": [
        68.34868914473685,
        69.27724285526317,
        70.34502247807018
      ],
      "text": "他把注意力从游戏转向现实，甚至试图掌握大女儿上下班的时间。",
      "keywords": [
        "上下班"
      ]
    },
    {
      "id": "SH13",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH13.mp3",
      "start": 74.12,
      "end": 79.9,
      "tempo": 1.065743944636678,
      "caption_start": 74.39519931168832,
      "caption_end": 79.62925766883117,
      "pauses": [
        76.61057244318182,
        77.76905521590909,
        78.62784451948052
      ],
      "text": "公寓里仍是寻常的一天；楼外的人，让危险一步步逼近。",
      "keywords": [
        "危险"
      ]
    },
    {
      "id": "SH14",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH14.mp3",
      "start": 80.12,
      "end": 84.60000000000001,
      "tempo": 1.0,
      "caption_start": 80.41891700000001,
      "caption_end": 84.251875,
      "pauses": [
        81.884771,
        82.8777915
      ],
      "text": "他准备了一个纸箱，下一步，就是走到那扇门前。",
      "keywords": [
        "纸箱"
      ]
    },
    {
      "id": "SH15",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH15.mp3",
      "start": 85.12,
      "end": 90.2,
      "tempo": 1.0,
      "caption_start": 85.382958,
      "caption_end": 89.92045800000001,
      "pauses": [
        87.11912500000001,
        88.84135400000001
      ],
      "text": "三月二十三日傍晚，他假扮送货员，来到这栋公寓。",
      "keywords": [
        "三月二十三日",
        "送货员"
      ]
    },
    {
      "id": "SH16",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH16.mp3",
      "start": 91.12,
      "end": 96.80000000000001,
      "tempo": 1.0,
      "caption_start": 91.539833,
      "caption_end": 96.406458,
      "pauses": [
        92.7835625,
        94.8521455
      ],
      "text": "电梯向上时，家里只有小女儿一个人，她并不认识门外的人。",
      "keywords": [
        "小女儿"
      ]
    },
    {
      "id": "SH17",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH17.mp3",
      "start": 97.12,
      "end": 102.52000000000001,
      "tempo": 1.0,
      "caption_start": 97.40125,
      "caption_end": 102.18991700000001,
      "pauses": [
        98.396896,
        99.66104200000001,
        99.96029150000001
      ],
      "text": "他来到门口谎称送货，小女儿让他把东西放在门前。",
      "keywords": [
        "门前"
      ]
    },
    {
      "id": "SH18",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH18.mp3",
      "start": 103.12,
      "end": 107.9,
      "tempo": 1.02928870292887,
      "caption_start": 103.46975609756097,
      "caption_end": 107.56761026422765,
      "pauses": [
        104.74043554471545,
        106.12140523373984
      ],
      "text": "可他没有离开，等到门打开，便趁机闯了进去。",
      "keywords": [
        "闯了进去"
      ]
    },
    {
      "id": "SH19",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH19.mp3",
      "start": 108.12,
      "end": 113.9,
      "tempo": 1.107266435986159,
      "caption_start": 108.414945271875,
      "caption_end": 113.623079296875,
      "pauses": [
        110.2188810140625,
        111.827403084375,
        113.30183005781251
      ],
      "text": "时间一分一秒过去，家里的灯还亮着，走廊里传来了脚步声。",
      "keywords": [
        "时间"
      ]
    },
    {
      "id": "SH20",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH20.mp3",
      "start": 114.12,
      "end": 119.04,
      "tempo": 1.0,
      "caption_start": 114.425792,
      "caption_end": 118.71258300000001,
      "pauses": [
        115.73714600000001,
        116.9870415
      ],
      "text": "晚上十点过后，母亲回到家，推开了那扇熟悉的门。",
      "keywords": [
        "十点过后",
        "母亲"
      ]
    },
    {
      "id": "SH21",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH21.mp3",
      "start": 120.12,
      "end": 124.9,
      "tempo": 1.1046025104602508,
      "caption_start": 120.35752888257576,
      "caption_end": 124.64168717045455,
      "pauses": [
        120.9100651969697,
        122.32490355303031
      ],
      "text": "之后，大女儿下班回来；她面对的，还是同一扇门。",
      "keywords": [
        "大女儿"
      ]
    },
    {
      "id": "SH22",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH22.mp3",
      "start": 125.12,
      "end": 129.72,
      "tempo": 1.0,
      "caption_start": 125.515792,
      "caption_end": 129.439042,
      "pauses": [
        126.436479,
        128.11391650000002
      ],
      "text": "那天夜里，三名女性遇害，屋内的灯暗了。",
      "keywords": [
        "三名女性遇害"
      ]
    },
    {
      "id": "SH23",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH23.mp3",
      "start": 130.12,
      "end": 136.16,
      "tempo": 1.0,
      "caption_start": 130.44133300000001,
      "caption_end": 135.91108300000002,
      "pauses": [
        131.3573125,
        132.8454375,
        134.2036455,
        135.58489600000001
      ],
      "text": "事发之后，他仍留在屋内，窗帘紧闭，时间过去了两天。",
      "keywords": [
        "两天"
      ]
    },
    {
      "id": "SH24",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH24.mp3",
      "start": 137.12,
      "end": 142.52,
      "tempo": 1.0,
      "caption_start": 137.411667,
      "caption_end": 142.088583,
      "pauses": [
        139.5651875,
        141.382229
      ],
      "text": "大女儿始终没有回复消息，一位朋友越想越不安，决定报警。",
      "keywords": [
        "报警"
      ]
    },
    {
      "id": "SH25",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH25.mp3",
      "start": 144.12,
      "end": 149.8,
      "tempo": 1.0,
      "caption_start": 144.414958,
      "caption_end": 149.468458,
      "pauses": [
        145.600479,
        147.0601875
      ],
      "text": "三月二十五日，警察赶到公寓，在屋内发现了受伤的金泰贤。",
      "keywords": [
        "三月二十五日"
      ]
    },
    {
      "id": "SH26",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH26.mp3",
      "start": 150.12,
      "end": 155.9,
      "tempo": 1.0311418685121105,
      "caption_start": 150.45805532550335,
      "caption_end": 155.54400339932886,
      "pauses": [
        152.22902889932885,
        153.68443435402685
      ],
      "text": "检方求处死刑，一审判无期，附三十年电子监控。",
      "keywords": [
        "无期徒刑",
        "三十年"
      ]
    },
    {
      "id": "SH27",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH27.mp3",
      "start": 156.12,
      "end": 161.9,
      "tempo": 1.0173010380622836,
      "caption_start": 156.3961798027211,
      "caption_end": 161.5547236394558,
      "pauses": [
        158.0348501054422,
        160.09383207993199
      ],
      "text": "二审维持判决，法官主张不予假释；双方继续上诉。",
      "keywords": [
        "二审",
        "假释"
      ]
    },
    {
      "id": "SH28",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH28.mp3",
      "start": 162.12,
      "end": 167.9,
      "tempo": 1.1003460207612454,
      "caption_start": 162.38911988993712,
      "caption_end": 167.6035777893082,
      "pauses": [
        163.9481181210692,
        165.86444713050315
      ],
      "text": "二零二二年四月，最高法院驳回上诉，无期徒刑最终确定。",
      "keywords": [
        "最高法院",
        "无期徒刑"
      ]
    },
    {
      "id": "SH29",
      "file": "/home/runner/work/desktop-tutorial/desktop-tutorial/production/nowon2021/audio/voice/SH29.mp3",
      "start": 168.12,
      "end": 173.9,
      "tempo": 1.0865051903114185,
      "caption_start": 168.38744741082803,
      "caption_end": 173.56816357324843,
      "pauses": [
        169.41747056210193,
        171.18076908757962,
        172.49060728503184
      ],
      "text": "一声门铃，三个生命消逝。跟踪纠缠绝不是小事。",
      "keywords": [
        "三个生命",
        "跟踪"
      ]
    },
