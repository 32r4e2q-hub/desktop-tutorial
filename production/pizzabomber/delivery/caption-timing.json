[
  {
    "start": 0.6,
    "end": 3.610442519316319,
    "text": "二〇〇三年八月二十八日下午，"
  },
  {
    "start": 3.7992507609459145,
    "end": 6.0859283540154525,
    "text": "宾夕法尼亚州伊利城，"
  },
  {
    "start": 6.232779208616249,
    "end": 8.288691173027393,
    "text": "披萨店接到一通电话："
  },
  {
    "start": 8.477499414656988,
    "end": 9.652306251463358,
    "text": "两份披萨，"
  },
  {
    "start": 9.841114493092952,
    "end": 12.14877077967689,
    "text": "送到城外的电视发射塔。"
  },
  {
    "start": 12.86204635916647,
    "end": 17.519316319363146,
    "text": "四十六岁的布莱恩·韦尔斯在这家店跑了十年外卖，"
  },
  {
    "start": 17.540295012877543,
    "end": 18.757059236712713,
    "text": "接下了这一单。"
  },
  {
    "start": 19.491313509716697,
    "end": 20.771013814095056,
    "text": "塔下等着他的，"
  },
  {
    "start": 20.791992507609457,
    "end": 21.861905876843828,
    "text": "不是小费，"
  },
  {
    "start": 21.861905876843828,
    "end": 24.547178646686955,
    "text": "是一副锁上就摘不下来的金属领圈，"
  },
  {
    "start": 24.610114727230158,
    "end": 27.043643174900488,
    "text": "和领圈上挂着的定时炸弹。"
  },
  {
    "start": 28.126265511589793,
    "end": 29.164710840552566,
    "text": "下午两点半，"
  },
  {
    "start": 29.164710840552566,
    "end": 31.5772605947085,
    "text": "韦尔斯走进PNC银行，"
  },
  {
    "start": 31.5772605947085,
    "end": 32.66815265745727,
    "text": "安静排队，"
  },
  {
    "start": 32.77304612502927,
    "end": 34.53525638023882,
    "text": "嘴里还含着棒棒糖。"
  },
  {
    "start": 35.01776633107001,
    "end": 36.04572231327558,
    "text": "轮到柜台，"
  },
  {
    "start": 36.12963708733318,
    "end": 37.59814563334114,
    "text": "他递进一张纸条："
  },
  {
    "start": 37.93380472957153,
    "end": 39.884823226410674,
    "text": "把能开金库的人叫来，"
  },
  {
    "start": 39.98971669398267,
    "end": 41.05963006321704,
    "text": "十五分钟，"
  },
  {
    "start": 41.18550222430344,
    "end": 42.8008616249122,
    "text": "装够二十五万美元，"
  },
  {
    "start": 42.8637977054554,
    "end": 44.79383750878014,
    "text": "不然脖子上的炸弹就响。"
  },
  {
    "start": 45.213411379068134,
    "end": 46.89170686022008,
    "text": "金库开不了那么快，"
  },
  {
    "start": 46.97562163427769,
    "end": 50.54199953172559,
    "text": "柜员只好把能凑出的八千七百零二美元，"
  },
  {
    "start": 50.75178646686959,
    "end": 52.30420978693514,
    "text": "装进他的披萨袋。"
  },
  {
    "start": 52.681826270194335,
    "end": 54.31816436431749,
    "text": "目击者后来说，"
  },
  {
    "start": 54.38110044486069,
    "end": 56.94050105361742,
    "text": "他离开时摆弄纸袋和拐杖，"
  },
  {
    "start": 56.98245844064622,
    "end": 58.115307890423786,
    "text": "像卓别林。"
  },
  {
    "start": 59.29757902130648,
    "end": 60.00036525403886,
    "text": "他没跑，"
  },
  {
    "start": 60.00036525403886,
    "end": 62.91640365254038,
    "text": "也没报警——纸条替他安排好了路线："
  },
  {
    "start": 63.18912666822758,
    "end": 65.72754858346991,
    "text": "先去隔壁快餐店取下一个线索。"
  },
  {
    "start": 66.1890798407867,
    "end": 69.4407773355186,
    "text": "警方在他车里搜出九页手写指令，"
  },
  {
    "start": 69.52469210957621,
    "end": 70.76243502692577,
    "text": "收件人写着："
  },
  {
    "start": 70.88830718801218,
    "end": 71.93724186373214,
    "text": "炸弹人质。"
  },
  {
    "start": 72.27290095996253,
    "end": 73.5106438773121,
    "text": "纸上的说法是，"
  },
  {
    "start": 73.6365160383985,
    "end": 76.48961835635681,
    "text": "找齐几把钥匙就能拖延引爆，"
  },
  {
    "start": 76.63646921095761,
    "end": 79.00706157808474,
    "text": "最后一步给出拆弹暗号，"
  },
  {
    "start": 79.15391243268554,
    "end": 80.9161226878951,
    "text": "每一步都有人盯着；"
  },
  {
    "start": 81.2098243970967,
    "end": 82.59441816904706,
    "text": "页末一行大字："
  },
  {
    "start": 82.76224771716225,
    "end": 83.53845937719504,
    "text": "先行动，"
  },
  {
    "start": 83.55943807070943,
    "end": 84.482500585343,
    "text": "后思考，"
  },
  {
    "start": 84.50347927885741,
    "end": 85.44752048700538,
    "text": "否则死。"
  },
  {
    "start": 86.58783423085927,
    "end": 88.57032076797002,
    "text": "离开银行约一刻钟后，"
  },
  {
    "start": 88.57032076797002,
    "end": 91.40244439241394,
    "text": "韦尔斯被警察按倒铐在停车场。"
  },
  {
    "start": 91.59125263404354,
    "end": 93.0597611800515,
    "text": "他冲警察喊："
  },
  {
    "start": 93.12269726059469,
    "end": 94.02478108171387,
    "text": "快炸了，"
  },
  {
    "start": 94.02478108171387,
    "end": 94.80099274174665,
    "text": "我不骗你们。"
  },
  {
    "start": 95.22056661203465,
    "end": 96.7729899321002,
    "text": "警方不敢碰领圈，"
  },
  {
    "start": 96.8359260126434,
    "end": 99.22749707328494,
    "text": "只拉起封锁线等拆弹的人。"
  },
  {
    "start": 99.58413486302972,
    "end": 100.98970732849449,
    "text": "三点零四分，"
  },
  {
    "start": 100.98970732849449,
    "end": 102.45821587450244,
    "text": "拆弹队接到呼叫；"
  },
  {
    "start": 102.54213064856005,
    "end": 103.73791617888081,
    "text": "三点十八分，"
  },
  {
    "start": 103.92672442051041,
    "end": 106.10850854600795,
    "text": "炸弹抢先三分钟起爆。"
  },
  {
    "start": 106.40221025520954,
    "end": 109.86369468508545,
    "text": "事后警方按九页纸条重跑任务路线，"
  },
  {
    "start": 109.90565207211425,
    "end": 110.66088503863263,
    "text": "结论是："
  },
  {
    "start": 110.78675719971902,
    "end": 112.04547881058299,
    "text": "在时限之内，"
  },
  {
    "start": 112.15037227815499,
    "end": 113.28322172793256,
    "text": "根本跑不完。"
  },
  {
    "start": 114.58612034652305,
    "end": 115.80288457035822,
    "text": "案子卡了两年，"
  },
  {
    "start": 115.80288457035822,
    "end": 117.50215874502457,
    "text": "栽在一台冰柜上。"
  },
  {
    "start": 117.50215874502457,
    "end": 119.05458206509013,
    "text": "二〇〇三年九月，"
  },
  {
    "start": 119.05458206509013,
    "end": 121.63496136736126,
    "text": "造弹的罗斯斯坦主动报警："
  },
  {
    "start": 121.63496136736126,
    "end": 124.76078670100678,
    "text": "自家车库冰柜里有一具尸体，"
  },
  {
    "start": 124.76078670100678,
    "end": 129.43903535471784,
    "text": "死者是玛乔丽·迪尔-阿姆斯特朗的同居男友，"
  },
  {
    "start": 129.43903535471784,
    "end": 130.5299274174666,
    "text": "据检方说法，"
  },
  {
    "start": 130.5299274174666,
    "end": 133.08932802622334,
    "text": "他因知道太多被灭口。"
  },
  {
    "start": 133.08932802622334,
    "end": 134.9774104425193,
    "text": "同案人在庭上作证："
  },
  {
    "start": 134.9774104425193,
    "end": 135.81655818309528,
    "text": "那副领圈，"
  },
  {
    "start": 135.81655818309528,
    "end": 139.90740341840316,
    "text": "是她照着韦尔斯的脖子量了尺寸做的。"
  },
  {
    "start": 139.90740341840316,
    "end": 140.70459377195036,
    "text": "而动机，"
  },
  {
    "start": 140.70459377195036,
    "end": 142.5507188012175,
    "text": "检方只有一句话："
  },
  {
    "start": 142.5507188012175,
    "end": 144.39684383048464,
    "text": "凑二十五万美元，"
  },
  {
    "start": 144.39684383048464,
    "end": 145.9099321002107,
    "text": "雇凶杀她父亲。"
  },
  {
    "start": 146.9899321002107,
    "end": 147.55635682509947,
    "text": "二〇一〇年，"
  },
  {
    "start": 147.55635682509947,
    "end": 150.4304378365722,
    "text": "陪审团裁定玛乔丽三项罪名成立，"
  },
  {
    "start": 150.4304378365722,
    "end": 152.42341372044015,
    "text": "次年判无期加三十年，"
  },
  {
    "start": 152.42341372044015,
    "end": 154.0807305080777,
    "text": "上诉全部被驳回。"
  },
  {
    "start": 154.0807305080777,
    "end": 154.94085694216807,
    "text": "她当庭说："
  },
  {
    "start": 154.94085694216807,
    "end": 157.14361976118002,
    "text": "我不是疯子杀手，"
  },
  {
    "start": 157.14361976118002,
    "end": 158.52821353313038,
    "text": "真凶还在外面；"
  },
  {
    "start": 158.52821353313038,
    "end": 163.20646218684146,
    "text": "她至死把主谋推给罗斯斯坦——那人在起诉前便已"
  },
  {
    "start": 163.20646218684146,
    "end": 163.83582299227345,
    "text": "病故，"
  },
  {
    "start": 163.83582299227345,
    "end": 166.83577616483257,
    "text": "她自己在二〇一七年病死狱中。"
  },
  {
    "start": 166.83577616483257,
    "end": 167.92666822758133,
    "text": "至于韦尔斯，"
  },
  {
    "start": 167.92666822758133,
    "end": 169.98258019199247,
    "text": "是共谋还是替死鬼？"
  },
  {
    "start": 169.98258019199247,
    "end": 171.84968391477403,
    "text": "警方与家属各执一词，"
  },
  {
    "start": 171.84968391477403,
    "end": 173.99999999999997,
    "text": "至今没有第三种答案。"
  }
]