{
 "N01": {
  "duration": 28.885,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.96,
    "text": "一九一一年八月二十一日",
    "chars_per_second": 6.08
   },
   {
    "i": 1,
    "start": 2.17,
    "end": 2.77,
    "text": "星期一",
    "chars_per_second": 5.0
   },
   {
    "i": 2,
    "start": 3.1,
    "end": 3.99,
    "text": "卢浮宫闭馆",
    "chars_per_second": 5.62
   },
   {
    "i": 3,
    "start": 4.34,
    "end": 5.17,
    "text": "早上七点",
    "chars_per_second": 4.82
   },
   {
    "i": 4,
    "start": 5.41,
    "end": 8.82,
    "text": "一个穿白色工作服的油漆工从员工通道走进去",
    "chars_per_second": 5.87
   },
   {
    "i": 5,
    "start": 9.16,
    "end": 10.31,
    "text": "没人多看他一眼",
    "chars_per_second": 6.09
   },
   {
    "i": 6,
    "start": 10.66,
    "end": 11.42,
    "text": "七点一刻",
    "chars_per_second": 5.26
   },
   {
    "i": 7,
    "start": 11.77,
    "end": 13.74,
    "text": "他把全世界最有名的一幅画",
    "chars_per_second": 6.09
   },
   {
    "i": 8,
    "start": 13.94,
    "end": 15.59,
    "text": "从四颗铁钉上取下来",
    "chars_per_second": 5.45
   },
   {
    "i": 9,
    "start": 15.94,
    "end": 17.66,
    "text": "抱着它走下员工楼梯",
    "chars_per_second": 5.23
   },
   {
    "i": 10,
    "start": 18.01,
    "end": 18.92,
    "text": "走出了大门",
    "chars_per_second": 5.49
   },
   {
    "i": 11,
    "start": 19.27,
    "end": 21.82,
    "text": "卢浮宫过了一整天才发现画没了",
    "chars_per_second": 5.49
   },
   {
    "i": 12,
    "start": 22.17,
    "end": 22.8,
    "text": "没有枪",
    "chars_per_second": 4.76
   },
   {
    "i": 13,
    "start": 23.13,
    "end": 23.88,
    "text": "没有人质",
    "chars_per_second": 5.33
   },
   {
    "i": 14,
    "start": 24.23,
    "end": 24.92,
    "text": "没有警报",
    "chars_per_second": 5.8
   },
   {
    "i": 15,
    "start": 25.17,
    "end": 26.0,
    "text": "他怎么做到的",
    "chars_per_second": 7.23
   },
   {
    "i": 16,
    "start": 26.24,
    "end": 27.05,
    "text": "又是怎么栽的",
    "chars_per_second": 7.41
   },
   {
    "i": 17,
    "start": 27.39,
    "end": 28.89,
    "text": "今天一口气讲清楚",
    "chars_per_second": 5.35
   }
  ]
 },
 "N02": {
  "duration": 28.073,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.04,
    "text": "先说他是谁",
    "chars_per_second": 5.62
   },
   {
    "i": 1,
    "start": 1.39,
    "end": 2.48,
    "text": "文森佐·佩鲁贾",
    "chars_per_second": 5.5
   },
   {
    "i": 2,
    "start": 2.82,
    "end": 3.65,
    "text": "意大利移民",
    "chars_per_second": 6.02
   },
   {
    "i": 3,
    "start": 4.0,
    "end": 5.0,
    "text": "一八八一年生",
    "chars_per_second": 6.0
   },
   {
    "i": 4,
    "start": 5.26,
    "end": 6.02,
    "text": "身高一米六",
    "chars_per_second": 6.58
   },
   {
    "i": 5,
    "start": 6.37,
    "end": 8.51,
    "text": "在巴黎靠刷漆和镶玻璃为生",
    "chars_per_second": 5.61
   },
   {
    "i": 6,
    "start": 8.8,
    "end": 9.66,
    "text": "一九零八年",
    "chars_per_second": 5.81
   },
   {
    "i": 7,
    "start": 9.97,
    "end": 13.28,
    "text": "卢浮宫给最贵重的几幅画加装防碎玻璃罩",
    "chars_per_second": 5.44
   },
   {
    "i": 8,
    "start": 13.63,
    "end": 15.25,
    "text": "工程包给一家玻璃公司",
    "chars_per_second": 6.17
   },
   {
    "i": 9,
    "start": 15.53,
    "end": 16.78,
    "text": "他就是其中一个工人",
    "chars_per_second": 7.2
   },
   {
    "i": 10,
    "start": 16.99,
    "end": 18.3,
    "text": "《蒙娜丽莎》那个罩子",
    "chars_per_second": 6.11
   },
   {
    "i": 11,
    "start": 18.61,
    "end": 19.83,
    "text": "很可能就是他装的",
    "chars_per_second": 6.56
   },
   {
    "i": 12,
    "start": 20.18,
    "end": 21.45,
    "text": "他知道钉子怎么卸",
    "chars_per_second": 6.3
   },
   {
    "i": 13,
    "start": 21.68,
    "end": 22.68,
    "text": "知道周一闭馆",
    "chars_per_second": 6.0
   },
   {
    "i": 14,
    "start": 23.02,
    "end": 24.47,
    "text": "知道保安几点抽烟",
    "chars_per_second": 5.52
   },
   {
    "i": 15,
    "start": 24.75,
    "end": 26.02,
    "text": "而他之前两次被捕",
    "chars_per_second": 6.3
   },
   {
    "i": 16,
    "start": 26.37,
    "end": 28.07,
    "text": "指纹早就在警局档案里",
    "chars_per_second": 5.87
   }
  ]
 },
 "N03": {
  "duration": 28.867,
  "clauses": [
   {
    "i": 0,
    "start": 0.13,
    "end": 2.08,
    "text": "他的计划简单到让人无语",
    "chars_per_second": 5.64
   },
   {
    "i": 1,
    "start": 2.42,
    "end": 3.42,
    "text": "星期天傍晚",
    "chars_per_second": 5.0
   },
   {
    "i": 2,
    "start": 3.54,
    "end": 5.65,
    "text": "他混在收工的维修工里进门",
    "chars_per_second": 5.69
   },
   {
    "i": 3,
    "start": 6.0,
    "end": 7.73,
    "text": "躲进展厅旁边的储物间",
    "chars_per_second": 5.78
   },
   {
    "i": 4,
    "start": 8.08,
    "end": 10.02,
    "text": "在一堆画框中间过了一夜",
    "chars_per_second": 5.67
   },
   {
    "i": 5,
    "start": 10.29,
    "end": 11.22,
    "text": "星期一早上",
    "chars_per_second": 5.38
   },
   {
    "i": 6,
    "start": 11.54,
    "end": 13.73,
    "text": "他把白工作服扣到最上面一颗",
    "chars_per_second": 5.94
   },
   {
    "i": 7,
    "start": 14.07,
    "end": 15.01,
    "text": "等展厅空了",
    "chars_per_second": 5.32
   },
   {
    "i": 8,
    "start": 15.35,
    "end": 16.97,
    "text": "把画从钉子上取下",
    "chars_per_second": 4.94
   },
   {
    "i": 9,
    "start": 17.31,
    "end": 18.52,
    "text": "抱到隔壁楼梯间",
    "chars_per_second": 5.79
   },
   {
    "i": 10,
    "start": 18.87,
    "end": 20.39,
    "text": "卸下玻璃罩和画框",
    "chars_per_second": 5.26
   },
   {
    "i": 11,
    "start": 20.73,
    "end": 21.48,
    "text": "丢在拐角",
    "chars_per_second": 5.33
   },
   {
    "i": 12,
    "start": 21.81,
    "end": 23.51,
    "text": "然后把画裹进工作服",
    "chars_per_second": 5.29
   },
   {
    "i": 13,
    "start": 23.86,
    "end": 24.83,
    "text": "夹在胳膊底下",
    "chars_per_second": 6.19
   },
   {
    "i": 14,
    "start": 25.17,
    "end": 27.02,
    "text": "一个水管工以为他是同事",
    "chars_per_second": 5.95
   },
   {
    "i": 15,
    "start": 27.37,
    "end": 28.87,
    "text": "顺手替他开了门",
    "chars_per_second": 4.68
   }
  ]
 },
 "N04": {
  "duration": 31.418,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.72,
    "text": "第二天",
    "chars_per_second": 5.26
   },
   {
    "i": 1,
    "start": 0.94,
    "end": 3.14,
    "text": "一个准备临摹的画家支好画架",
    "chars_per_second": 5.91
   },
   {
    "i": 2,
    "start": 3.48,
    "end": 4.03,
    "text": "一抬头",
    "chars_per_second": 5.45
   },
   {
    "i": 3,
    "start": 4.21,
    "end": 5.69,
    "text": "墙上只剩四颗钉子",
    "chars_per_second": 5.41
   },
   {
    "i": 4,
    "start": 6.04,
    "end": 7.98,
    "text": "六十名警察翻遍了卢浮宫",
    "chars_per_second": 5.67
   },
   {
    "i": 5,
    "start": 8.31,
    "end": 11.39,
    "text": "还请来当时最出名的指纹专家贝尔蒂永",
    "chars_per_second": 5.52
   },
   {
    "i": 6,
    "start": 11.68,
    "end": 14.14,
    "text": "他在画框上提到一枚左手拇指指纹",
    "chars_per_second": 6.1
   },
   {
    "i": 7,
    "start": 14.37,
    "end": 16.22,
    "text": "跟两百多名馆员挨个比对",
    "chars_per_second": 5.95
   },
   {
    "i": 8,
    "start": 16.43,
    "end": 17.28,
    "text": "一个都对不上",
    "chars_per_second": 7.06
   },
   {
    "i": 9,
    "start": 17.63,
    "end": 18.94,
    "text": "因为当年佩鲁贾被捕",
    "chars_per_second": 6.87
   },
   {
    "i": 10,
    "start": 19.23,
    "end": 20.41,
    "text": "警方只采了右手",
    "chars_per_second": 5.93
   },
   {
    "i": 11,
    "start": 20.71,
    "end": 21.68,
    "text": "接下来两周",
    "chars_per_second": 5.15
   },
   {
    "i": 12,
    "start": 22.03,
    "end": 22.86,
    "text": "警方封路",
    "chars_per_second": 4.82
   },
   {
    "i": 13,
    "start": 23.14,
    "end": 23.71,
    "text": "搜船",
    "chars_per_second": 3.51
   },
   {
    "i": 14,
    "start": 24.02,
    "end": 26.48,
    "text": "把毕加索和诗人阿波利奈尔抓去问话",
    "chars_per_second": 6.5
   },
   {
    "i": 15,
    "start": 26.7,
    "end": 28.13,
    "text": "而搜到他家的警员",
    "chars_per_second": 5.59
   },
   {
    "i": 16,
    "start": 28.44,
    "end": 31.42,
    "text": "就靠在那张藏画的桌子上写完报告",
    "chars_per_second": 5.04
   }
  ]
 },
 "N05": {
  "duration": 28.83,
  "clauses": [
   {
    "i": 0,
    "start": 0.16,
    "end": 1.87,
    "text": "画就在巴黎一间出租屋里",
    "chars_per_second": 6.43
   },
   {
    "i": 1,
    "start": 2.21,
    "end": 4.24,
    "text": "藏在一口木箱的假底板下面",
    "chars_per_second": 5.91
   },
   {
    "i": 2,
    "start": 4.59,
    "end": 5.39,
    "text": "躺了两年",
    "chars_per_second": 5.0
   },
   {
    "i": 3,
    "start": 5.74,
    "end": 7.04,
    "text": "一九一三年十一月",
    "chars_per_second": 6.15
   },
   {
    "i": 4,
    "start": 7.32,
    "end": 9.25,
    "text": "佛罗伦萨的古董商杰里收到一封信",
    "chars_per_second": 7.77
   },
   {
    "i": 5,
    "start": 9.4,
    "end": 10.26,
    "text": "署名「列奥纳多·V」",
    "chars_per_second": 8.14
   },
   {
    "i": 6,
    "start": 10.59,
    "end": 11.09,
    "text": "画在佛罗伦萨",
    "chars_per_second": 12.0
   },
   {
    "i": 7,
    "start": 11.25,
    "end": 12.15,
    "text": "愿意交还意大利",
    "chars_per_second": 7.78
   },
   {
    "i": 8,
    "start": 12.36,
    "end": 13.43,
    "text": "要五十万里拉",
    "chars_per_second": 5.61
   },
   {
    "i": 9,
    "start": 13.79,
    "end": 14.91,
    "text": "杰里拉上乌菲兹馆长波吉去旅馆",
    "chars_per_second": 12.5
   },
   {
    "i": 10,
    "start": 15.16,
    "end": 16.2,
    "text": "房间里",
    "chars_per_second": 2.88
   },
   {
    "i": 11,
    "start": 16.48,
    "end": 18.98,
    "text": "佩鲁贾掀开假底板",
    "chars_per_second": 3.2
   },
   {
    "i": 12,
    "start": 19.32,
    "end": 21.41,
    "text": "波吉什么也没说",
    "chars_per_second": 3.35
   },
   {
    "i": 13,
    "start": 21.76,
    "end": 22.9,
    "text": "只把画板翻过来",
    "chars_per_second": 6.14
   },
   {
    "i": 14,
    "start": 23.24,
    "end": 24.48,
    "text": "对着窗光看背面",
    "chars_per_second": 5.65
   },
   {
    "i": 15,
    "start": 24.63,
    "end": 25.91,
    "text": "卢浮宫的馆藏编号",
    "chars_per_second": 6.25
   },
   {
    "i": 16,
    "start": 26.25,
    "end": 28.83,
    "text": "七百七十九",
    "chars_per_second": 1.94
   }
  ]
 },
 "N06": {
  "duration": 33.043,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.53,
    "text": "网上还流传着一个更戏剧化的版本",
    "chars_per_second": 6.3
   },
   {
    "i": 1,
    "start": 2.87,
    "end": 5.52,
    "text": "一根藏在他工作服里的白杨木纤维",
    "chars_per_second": 5.66
   },
   {
    "i": 2,
    "start": 5.86,
    "end": 7.48,
    "text": "和画板材质比对上了",
    "chars_per_second": 5.56
   },
   {
    "i": 3,
    "start": 7.82,
    "end": 8.57,
    "text": "把他钉死",
    "chars_per_second": 5.33
   },
   {
    "i": 4,
    "start": 8.92,
    "end": 10.45,
    "text": "档案里没有这根纤维",
    "chars_per_second": 5.88
   },
   {
    "i": 5,
    "start": 10.74,
    "end": 11.75,
    "text": "真正出卖他的",
    "chars_per_second": 5.94
   },
   {
    "i": 6,
    "start": 12.09,
    "end": 13.42,
    "text": "是博物馆自己的登记本",
    "chars_per_second": 7.52
   },
   {
    "i": 7,
    "start": 13.66,
    "end": 16.09,
    "text": "名画一九一四年一月回到卢浮宫",
    "chars_per_second": 5.76
   },
   {
    "i": 8,
    "start": 16.44,
    "end": 17.94,
    "text": "同年佛洛伦萨开庭",
    "chars_per_second": 5.33
   },
   {
    "i": 9,
    "start": 18.28,
    "end": 20.41,
    "text": "他说自己只是把画还给祖国",
    "chars_per_second": 5.63
   },
   {
    "i": 10,
    "start": 20.75,
    "end": 22.19,
    "text": "被判一年零十五天",
    "chars_per_second": 5.56
   },
   {
    "i": 11,
    "start": 22.53,
    "end": 23.76,
    "text": "实际坐了七个月",
    "chars_per_second": 5.69
   },
   {
    "i": 12,
    "start": 24.1,
    "end": 24.92,
    "text": "而这桩案子",
    "chars_per_second": 6.1
   },
   {
    "i": 13,
    "start": 25.27,
    "end": 27.17,
    "text": "把一幅四百年没人回头看的画",
    "chars_per_second": 6.84
   },
   {
    "i": 14,
    "start": 27.45,
    "end": 29.08,
    "text": "抬成了全世界最有名的画",
    "chars_per_second": 6.75
   },
   {
    "i": 15,
    "start": 29.37,
    "end": 29.99,
    "text": "你觉得",
    "chars_per_second": 4.84
   },
   {
    "i": 16,
    "start": 30.33,
    "end": 31.29,
    "text": "是他太大意",
    "chars_per_second": 5.21
   },
   {
    "i": 17,
    "start": 31.64,
    "end": 33.04,
    "text": "还是卢浮宫太自信",
    "chars_per_second": 5.7
   }
  ]
 }
}