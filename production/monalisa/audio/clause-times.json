{
 "N01": {
  "duration": 23.43,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.08,
    "text": "一九一一年",
    "chars_per_second": 5.38,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 1.42,
    "end": 3.48,
    "text": "如今全世界最有名的那幅画",
    "chars_per_second": 5.83,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 3.76,
    "end": 5.55,
    "text": "在卢浮宫里凭空消失了",
    "chars_per_second": 5.59,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 5.89,
    "end": 7.65,
    "text": "偷走它的不是国际大盗",
    "chars_per_second": 5.68,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 8.0,
    "end": 9.37,
    "text": "而是一个意大利油漆工",
    "chars_per_second": 7.3,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 9.71,
    "end": 11.6,
    "text": "他把画往白大褂里一裹",
    "chars_per_second": 5.29,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 11.95,
    "end": 13.81,
    "text": "大摇大摆走出了大门",
    "chars_per_second": 4.84,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 14.15,
    "end": 15.03,
    "text": "更离谱的是",
    "chars_per_second": 5.68,
    "group": "1块/1句"
   },
   {
    "i": 8,
    "start": 15.33,
    "end": 17.48,
    "text": "他的指纹早就在警察档案里",
    "chars_per_second": 5.58,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 17.82,
    "end": 19.57,
    "text": "却让他逍遥了二十八个月",
    "chars_per_second": 6.29,
    "group": "1块/1句"
   },
   {
    "i": 10,
    "start": 19.91,
    "end": 21.42,
    "text": "今天一口气讲清楚",
    "chars_per_second": 5.3,
    "group": "1块/1句"
   },
   {
    "i": 11,
    "start": 21.77,
    "end": 23.19,
    "text": "蒙娜丽莎失窃案",
    "chars_per_second": 4.93,
    "group": "1块/1句"
   }
  ]
 },
 "N02": {
  "duration": 24.285,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.02,
    "text": "先说这个人",
    "chars_per_second": 5.75,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 1.37,
    "end": 2.62,
    "text": "文森佐·佩鲁贾",
    "chars_per_second": 4.8,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 2.96,
    "end": 3.83,
    "text": "油漆工出身",
    "chars_per_second": 5.75,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 4.18,
    "end": 5.18,
    "text": "在巴黎打零工",
    "chars_per_second": 6.0,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 5.52,
    "end": 7.02,
    "text": "还在卢浮宫干过一阵",
    "chars_per_second": 6.0,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 7.37,
    "end": 8.78,
    "text": "给名画装玻璃罩",
    "chars_per_second": 4.96,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 9.12,
    "end": 10.49,
    "text": "蒙娜丽莎那个罩子",
    "chars_per_second": 5.84,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 10.84,
    "end": 11.69,
    "text": "他也参与过",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 8,
    "start": 12.02,
    "end": 13.63,
    "text": "他看上去老实巴交",
    "chars_per_second": 4.97,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 13.98,
    "end": 16.53,
    "text": "可这份活让他摸清了三件事",
    "chars_per_second": 4.71,
    "group": "2块/1句"
   },
   {
    "i": 10,
    "start": 16.87,
    "end": 19.0,
    "text": "画只挂在四个铁钩上",
    "chars_per_second": 4.23,
    "group": "2块/1句"
   },
   {
    "i": 11,
    "start": 19.35,
    "end": 20.1,
    "text": "周一闭馆",
    "chars_per_second": 5.33,
    "group": "1块/1句"
   },
   {
    "i": 12,
    "start": 20.45,
    "end": 21.56,
    "text": "馆里只剩工人",
    "chars_per_second": 5.41,
    "group": "1块/1句"
   },
   {
    "i": 13,
    "start": 21.91,
    "end": 22.54,
    "text": "而工人",
    "chars_per_second": 4.76,
    "group": "1块/1句"
   },
   {
    "i": 14,
    "start": 22.85,
    "end": 24.04,
    "text": "人人都穿白大褂",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   }
  ]
 },
 "N03": {
  "duration": 27.303,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.93,
    "text": "一九一一年八月二十一日",
    "chars_per_second": 6.15,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 2.23,
    "end": 3.09,
    "text": "星期一清早",
    "chars_per_second": 5.81,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 3.44,
    "end": 5.89,
    "text": "佩鲁贾穿着白大褂混进馆里",
    "chars_per_second": 4.9,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 6.23,
    "end": 7.96,
    "text": "方形大厅四下无人",
    "chars_per_second": 4.62,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 8.31,
    "end": 10.12,
    "text": "他把画从铁钩上摘下",
    "chars_per_second": 4.97,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 10.47,
    "end": 11.66,
    "text": "躲进员工楼梯间",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 12.01,
    "end": 13.55,
    "text": "拆掉玻璃罩和画框",
    "chars_per_second": 5.19,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 13.89,
    "end": 15.29,
    "text": "只剩一块白杨木板",
    "chars_per_second": 5.71,
    "group": "1块/1句"
   },
   {
    "i": 8,
    "start": 15.64,
    "end": 17.69,
    "text": "可楼梯底下的门锁着",
    "chars_per_second": 4.39,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 18.02,
    "end": 19.21,
    "text": "一个水管工路过",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 10,
    "start": 19.53,
    "end": 20.63,
    "text": "把他当成同事",
    "chars_per_second": 5.45,
    "group": "1块/1句"
   },
   {
    "i": 11,
    "start": 20.97,
    "end": 22.22,
    "text": "顺手帮他开了门",
    "chars_per_second": 5.6,
    "group": "1块/1句"
   },
   {
    "i": 12,
    "start": 22.5,
    "end": 23.36,
    "text": "直到第二天",
    "chars_per_second": 5.81,
    "group": "1块/1句"
   },
   {
    "i": 13,
    "start": 23.7,
    "end": 25.22,
    "text": "来写生的画家才发现",
    "chars_per_second": 5.92,
    "group": "1块/1句"
   },
   {
    "i": 14,
    "start": 25.57,
    "end": 27.06,
    "text": "墙上只剩四个铁钩",
    "chars_per_second": 5.37,
    "group": "1块/1句"
   }
  ]
 },
 "N04": {
  "duration": 29.655,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.38,
    "text": "卢浮宫闭馆一周",
    "chars_per_second": 5.65,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 1.65,
    "end": 2.45,
    "text": "边境封锁",
    "chars_per_second": 5.0,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 2.8,
    "end": 4.73,
    "text": "连毕加索都被叫去问话",
    "chars_per_second": 5.18,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 5.08,
    "end": 6.41,
    "text": "现场最硬的线索",
    "chars_per_second": 5.26,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 6.76,
    "end": 9.1,
    "text": "玻璃罩上一枚清晰的拇指印",
    "chars_per_second": 5.13,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 9.45,
    "end": 11.93,
    "text": "人称法国福尔摩斯的贝蒂荣",
    "chars_per_second": 4.84,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 12.28,
    "end": 13.93,
    "text": "手握七十五万份档案",
    "chars_per_second": 5.45,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 14.27,
    "end": 15.41,
    "text": "佩鲁贾有前科",
    "chars_per_second": 5.26,
    "group": "1块/1句"
   },
   {
    "i": 8,
    "start": 15.77,
    "end": 16.85,
    "text": "指纹就在里面",
    "chars_per_second": 5.56,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 17.19,
    "end": 18.2,
    "text": "可就是没对上",
    "chars_per_second": 5.94,
    "group": "1块/1句"
   },
   {
    "i": 10,
    "start": 18.54,
    "end": 20.58,
    "text": "因为档案只按右手拇指分类",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 11,
    "start": 20.93,
    "end": 21.73,
    "text": "而玻璃上的",
    "chars_per_second": 6.25,
    "group": "1块/1句"
   },
   {
    "i": 12,
    "start": 22.02,
    "end": 23.02,
    "text": "偏偏是左手",
    "chars_per_second": 5.0,
    "group": "1块/1句"
   },
   {
    "i": 13,
    "start": 23.37,
    "end": 24.26,
    "text": "更讽刺的是",
    "chars_per_second": 5.62,
    "group": "1块/1句"
   },
   {
    "i": 14,
    "start": 24.6,
    "end": 25.96,
    "text": "警探上门问话时",
    "chars_per_second": 5.15,
    "group": "1块/1句"
   },
   {
    "i": 15,
    "start": 26.31,
    "end": 29.41,
    "text": "就趴在藏画的那张桌子上写完了笔录",
    "chars_per_second": 5.16,
    "group": "2块/1句"
   }
  ]
 },
 "N05": {
  "duration": 35.45,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.77,
    "text": "两年后",
    "chars_per_second": 4.76,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 1.12,
    "end": 1.87,
    "text": "他憋不住了",
    "chars_per_second": 6.67,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 2.21,
    "end": 3.32,
    "text": "化名莱昂纳多",
    "chars_per_second": 5.41,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 3.67,
    "end": 5.22,
    "text": "联系佛罗伦萨的画商",
    "chars_per_second": 5.81,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 5.56,
    "end": 6.77,
    "text": "开价五十万里拉",
    "chars_per_second": 5.79,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 7.12,
    "end": 8.5,
    "text": "把画带回了意大利",
    "chars_per_second": 5.8,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 8.85,
    "end": 11.1,
    "text": "画商拉上乌菲兹美术馆馆长",
    "chars_per_second": 5.33,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 11.45,
    "end": 12.61,
    "text": "来到他住的旅馆",
    "chars_per_second": 6.03,
    "group": "1块/1句"
   },
   {
    "i": 8,
    "start": 12.95,
    "end": 15.7,
    "text": "他从箱子夹层里捧出一个红布包",
    "chars_per_second": 5.09,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 16.03,
    "end": 17.25,
    "text": "馆长把画翻过来",
    "chars_per_second": 5.74,
    "group": "1块/1句"
   },
   {
    "i": 10,
    "start": 17.59,
    "end": 18.79,
    "text": "白杨木画板背面",
    "chars_per_second": 5.83,
    "group": "1块/1句"
   },
   {
    "i": 11,
    "start": 19.14,
    "end": 21.39,
    "text": "卢浮宫的印章和编号全对得上",
    "chars_per_second": 5.78,
    "group": "1块/1句"
   },
   {
    "i": 12,
    "start": 21.75,
    "end": 22.66,
    "text": "再比对照片",
    "chars_per_second": 5.49,
    "group": "1块/1句"
   },
   {
    "i": 13,
    "start": 23.0,
    "end": 24.01,
    "text": "顶上那道裂缝",
    "chars_per_second": 5.94,
    "group": "1块/1句"
   },
   {
    "i": 14,
    "start": 24.35,
    "end": 25.62,
    "text": "细密的裂纹网",
    "chars_per_second": 4.72,
    "group": "1块/2句"
   },
   {
    "i": 15,
    "start": 25.62,
    "end": 26.47,
    "text": "全部吻合",
    "chars_per_second": 4.72,
    "group": "1块/2句"
   },
   {
    "i": 16,
    "start": 26.81,
    "end": 29.11,
    "text": "这是四百年里油彩干缩",
    "chars_per_second": 4.35,
    "group": "2块/1句"
   },
   {
    "i": 17,
    "start": 29.42,
    "end": 30.82,
    "text": "木板胀缩撑出来的",
    "chars_per_second": 5.71,
    "group": "1块/1句"
   },
   {
    "i": 18,
    "start": 31.17,
    "end": 32.53,
    "text": "没人造得出第二张",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 19,
    "start": 32.87,
    "end": 33.28,
    "text": "很快",
    "chars_per_second": 4.88,
    "group": "1块/1句"
   },
   {
    "i": 20,
    "start": 33.63,
    "end": 35.21,
    "text": "警察敲开了他的房门",
    "chars_per_second": 5.7,
    "group": "1块/1句"
   }
  ]
 },
 "N06": {
  "duration": 37.47,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 0.71,
    "text": "被捕后",
    "chars_per_second": 5.26,
    "group": "1块/1句"
   },
   {
    "i": 1,
    "start": 0.97,
    "end": 1.93,
    "text": "他理直气壮",
    "chars_per_second": 5.21,
    "group": "1块/1句"
   },
   {
    "i": 2,
    "start": 2.29,
    "end": 3.0,
    "text": "我是爱国",
    "chars_per_second": 5.63,
    "group": "1块/1句"
   },
   {
    "i": 3,
    "start": 3.35,
    "end": 5.82,
    "text": "这画是拿破仑从意大利抢走的",
    "chars_per_second": 5.26,
    "group": "1块/1句"
   },
   {
    "i": 4,
    "start": 6.17,
    "end": 7.42,
    "text": "可历史当场打脸",
    "chars_per_second": 5.6,
    "group": "1块/1句"
   },
   {
    "i": 5,
    "start": 7.77,
    "end": 10.16,
    "text": "这幅画是达芬奇自己带去法国的",
    "chars_per_second": 5.86,
    "group": "1块/1句"
   },
   {
    "i": 6,
    "start": 10.51,
    "end": 12.57,
    "text": "比拿破仑出生早了两百多年",
    "chars_per_second": 5.83,
    "group": "1块/1句"
   },
   {
    "i": 7,
    "start": 12.92,
    "end": 15.02,
    "text": "何况他开口就要五十万",
    "chars_per_second": 4.76,
    "group": "2块/1句"
   },
   {
    "i": 8,
    "start": 15.36,
    "end": 17.97,
    "text": "还写信跟父亲说要发大财",
    "chars_per_second": 4.21,
    "group": "1块/1句"
   },
   {
    "i": 9,
    "start": 18.32,
    "end": 20.54,
    "text": "而那枚左手拇指印一比",
    "chars_per_second": 4.5,
    "group": "1块/1句"
   },
   {
    "i": 10,
    "start": 20.9,
    "end": 21.78,
    "text": "分毫不差",
    "chars_per_second": 4.55,
    "group": "1块/1句"
   },
   {
    "i": 11,
    "start": 22.12,
    "end": 23.4,
    "text": "一九一四年一月",
    "chars_per_second": 5.47,
    "group": "1块/1句"
   },
   {
    "i": 12,
    "start": 23.75,
    "end": 25.28,
    "text": "蒙娜丽莎回到卢浮宫",
    "chars_per_second": 5.88,
    "group": "1块/1句"
   },
   {
    "i": 13,
    "start": 25.62,
    "end": 27.44,
    "text": "佩鲁贾只坐了七个月牢",
    "chars_per_second": 5.49,
    "group": "1块/1句"
   },
   {
    "i": 14,
    "start": 27.78,
    "end": 28.86,
    "text": "他骗过了警察",
    "chars_per_second": 5.56,
    "group": "1块/1句"
