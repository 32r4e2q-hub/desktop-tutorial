[
  {
    "start": 0.6,
    "end": 2.565772131242803,
    "text": "二零一七年十月三十日，"
  },
  {
    "start": 2.820791218539167,
    "end": 4.797189145085984,
    "text": "日本神奈川县座间市，"
  },
  {
    "start": 4.945950279342196,
    "end": 7.3898831992656815,
    "text": "警察敲开了一间普通公寓的门。"
  },
  {
    "start": 7.517392742913863,
    "end": 8.367456367235077,
    "text": "门一开，"
  },
  {
    "start": 8.622475454531438,
    "end": 9.791312937973105,
    "text": "警察就意识到："
  },
  {
    "start": 10.003828844053407,
    "end": 12.107736314248408,
    "text": "这间十几平方米的小屋里，"
  },
  {
    "start": 12.32025222032871,
    "end": 14.402908099915681,
    "text": "藏着九名失踪者的下落。"
  },
  {
    "start": 14.487914462347803,
    "end": 16.44306079828659,
    "text": "而把警察带到这里的，"
  },
  {
    "start": 16.676828294974925,
    "end": 19.33327712097871,
    "text": "是一名二十三岁女孩失踪前，"
  },
  {
    "start": 19.58829620827508,
    "end": 22.01097753759053,
    "text": "留在社交媒体上的一条消息。"
  },
  {
    "start": 23.259728449262422,
    "end": 25.948054661178254,
    "text": "这间公寓的主人叫白石隆浩，"
  },
  {
    "start": 26.064938409522423,
    "end": 28.264478037453557,
    "text": "一九九零年出生在座间，"
  },
  {
    "start": 28.37073599049371,
    "end": 30.27275334991242,
    "text": "案发时二十七岁。"
  },
  {
    "start": 30.379011302952573,
    "end": 33.66238205189325,
    "text": "他之前在东京街头做过拉人的星探，"
  },
  {
    "start": 33.7686400049334,
    "end": 36.45696621684924,
    "text": "还因为这份工作被警察抓过。"
  },
  {
    "start": 36.5738499651934,
    "end": 38.709634821300455,
    "text": "二零一七年八月二十二日，"
  },
  {
    "start": 38.815892774340604,
    "end": 41.10043876470386,
    "text": "他搬进这间公寓："
  },
  {
    "start": 41.20669671774401,
    "end": 42.874946580474386,
    "text": "绿丘一栋旧公寓的二楼，"
  },
  {
    "start": 42.98120453351454,
    "end": 45.36138268161393,
    "text": "月租只要一万九千日元。"
  },
  {
    "start": 45.46764063465409,
    "end": 46.48771698383954,
    "text": "邻居们说，"
  },
  {
    "start": 46.60460073218371,
    "end": 49.4003360249643,
    "text": "这个年轻人看起来普普通通。"
  },
  {
    "start": 50.480336024964295,
    "end": 51.574792941277856,
    "text": "搬进来之后，"
  },
  {
    "start": 51.936069981614374,
    "end": 54.52876403579407,
    "text": "他在社交媒体上注册了好几个账号，"
  },
  {
    "start": 54.74127994187437,
    "end": 57.673999445782556,
    "text": "专门找那些说自己活不下去的年轻人。"
  },
  {
    "start": 57.80150898943074,
    "end": 59.73540373476149,
    "text": "他假装自己也一样绝望，"
  },
  {
    "start": 59.820410097193616,
    "end": 61.563040527052095,
    "text": "说要陪对方一起走，"
  },
  {
    "start": 61.64804688948422,
    "end": 63.53943845359892,
    "text": "把对方约到自己的公寓。"
  },
  {
    "start": 63.77320595028725,
    "end": 66.2596420514268,
    "text": "从八月下旬到十月下旬，"
  },
  {
    "start": 66.38715159507498,
    "end": 67.51348589730058,
    "text": "短短两个月，"
  },
  {
    "start": 67.68349862216482,
    "end": 69.46863223323936,
    "text": "九个人走进这间公寓，"
  },
  {
    "start": 69.53238700506346,
    "end": 70.76497926032921,
    "text": "再也没有出来："
  },
  {
    "start": 70.87123721336937,
    "end": 72.06132628741906,
    "text": "八名女性，"
  },
  {
    "start": 72.2950937841074,
    "end": 73.27266695207679,
    "text": "一名男性，"
  },
  {
    "start": 73.44267967694104,
    "end": 76.14163168416088,
    "text": "年龄从十五岁到二十六岁。"
  },
  {
    "start": 76.26914122780906,
    "end": 77.629243026723,
    "text": "其中那名男性，"
  },
  {
    "start": 77.71424938915513,
    "end": 79.01059641624497,
    "text": "是来找女友的。"
  },
  {
    "start": 80.27123493641324,
    "end": 83.38459296048967,
    "text": "转机来自八王子一名二十三岁的女孩。"
  },
  {
    "start": 83.4695993229218,
    "end": 85.55225520250876,
    "text": "十月下旬她突然失踪，"
  },
  {
    "start": 85.84977747102118,
    "end": 87.82617539756801,
    "text": "哥哥翻看她的社交账号，"
  },
  {
    "start": 88.0386913036483,
    "end": 92.24650624403832,
    "text": "发现她失踪前一直在和一个陌生账号聊天。"
  },
  {
    "start": 92.37401578768649,
    "end": 94.24415576119316,
    "text": "车站的监控还拍到，"
  },
  {
    "start": 94.49917484848953,
    "end": 98.32446115793498,
    "text": "女孩曾和一名男子一起出现在车站。"
  },
  {
    "start": 98.4732222921912,
    "end": 101.00216157454679,
    "text": "警方顺着这个账号设下埋伏，"
  },
  {
    "start": 101.23592907123513,
    "end": 102.91480472926952,
    "text": "约对方在车站见面。"
  },
  {
    "start": 103.06356586352574,
    "end": 104.2961581187915,
    "text": "十月三十日，"
  },
  {
    "start": 104.4449192530477,
    "end": 105.76251787074558,
    "text": "警察一路跟着他，"
  },
  {
    "start": 106.1875496829062,
    "end": 108.97150805255816,
    "text": "回到了座间市的那间公寓门口。"
  },
  {
    "start": 110.27464975394248,
    "end": 111.35848087495202,
    "text": "门一打开，"
  },
  {
    "start": 111.47536462329619,
    "end": 114.52496787554854,
    "text": "警察就看到了堆在屋里的几个箱子。"
  },
  {
    "start": 114.6312258285887,
    "end": 116.20384353358294,
    "text": "搜查很快确认，"
  },
  {
    "start": 116.31010148662308,
    "end": 118.10586089300165,
    "text": "此前失踪的九个人，"
  },
  {
    "start": 118.2121188460418,
    "end": 120.73043233309339,
    "text": "都在这间公寓里找到了下落。"
  },
  {
    "start": 120.83669028613355,
    "end": 121.73988288697483,
    "text": "第二天，"
  },
  {
    "start": 121.85676663531899,
    "end": 124.05630626325014,
    "text": "白石隆浩被警方逮捕。"
  },
  {
    "start": 124.16256421629028,
    "end": 125.21451795138779,
    "text": "面对审讯，"
  },
  {
    "start": 125.33140169973196,
    "end": 127.08465792489446,
    "text": "他承认了全部罪行，"
  },
  {
    "start": 127.1909158779346,
    "end": 130.61242196582748,
    "text": "还承认这间公寓就是为了作案才租下的。"
  },
  {
    "start": 130.71867991886762,
    "end": 133.75765737581597,
    "text": "警方靠遗留的银行卡和手机定位，"
  },
  {
    "start": 133.87454112416015,
    "end": 136.60537051729202,
    "text": "再比对家属的脱氧核糖核酸，"
  },
  {
    "start": 136.7222542656362,
    "end": 138.91116809826332,
    "text": "逐一确认了九人的身份。"
  },
  {
    "start": 139.02805184660747,
    "end": 141.11168175743066,
    "text": "案件震惊了整个日本。"
  },
  {
    "start": 142.19168175743064,
    "end": 144.36996979475376,
    "text": "二零二零年十二月十五日，"
  },
  {
    "start": 144.6249888820501,
    "end": 148.00399178872692,
    "text": "东京地方法院立川支部判处他死刑。"
  },
  {
    "start": 148.02524337933497,
    "end": 150.76669856777087,
    "text": "他在法庭上认下全部罪名，"
  },
  {
    "start": 151.02171765506722,
    "end": 152.1905551385089,
    "text": "又撤回上诉，"
  },
  {
    "start": 152.4668258164133,
    "end": 155.059519870593,
    "text": "死刑在二零二一年一月确定。"
  },
  {
    "start": 155.18702941424118,
    "end": 157.3121884750442,
    "text": "二零二五年六月二十七日，"
  },
  {
    "start": 157.5884591529486,
    "end": 158.52352913970194,
    "text": "死刑执行，"
  },
  {
    "start": 158.77854822699828,
    "end": 162.773847261308,
    "text": "这是日本时隔两年十一个月再次执行死刑。"
  },
  {
    "start": 162.9226083955642,
    "end": 163.9001815635336,
    "text": "九条人命，"
  },
  {
    "start": 163.9001815635336,
    "end": 164.96276109393511,
    "text": "两个月，"
  },
  {
    "start": 165.2177801812315,
    "end": 166.0040890337286,
    "text": "一间公寓。"
  },
  {
    "start": 166.25910812102495,
    "end": 168.36301559121995,
    "text": "网络对面的一句我陪你，"
  },
  {
    "start": 168.6605378597324,
    "end": 170.65818737688724,
    "text": "可能是世上最危险的话。"
  },
  {
    "start": 170.72194214871132,
    "end": 172.20955349127345,
    "text": "如果它发给了你，"
  },
  {
    "start": 172.44332098796178,
    "end": 173.80342278687573,
    "text": "你能分辨出来吗？"
  }
]