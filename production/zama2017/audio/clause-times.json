{
 "N01": {
  "duration": 20.249,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.75,
    "text": "二零一七年十月三十日",
    "chars_per_second": 6.25
   },
   {
    "i": 1,
    "start": 2.1,
    "end": 3.83,
    "text": "日本神奈川县座间市",
    "chars_per_second": 5.2
   },
   {
    "i": 2,
    "start": 4.17,
    "end": 6.36,
    "text": "警察敲开了一间普通公寓的门",
    "chars_per_second": 5.94
   },
   {
    "i": 3,
    "start": 6.7,
    "end": 7.31,
    "text": "门一开",
    "chars_per_second": 4.92
   },
   {
    "i": 4,
    "start": 7.65,
    "end": 8.6,
    "text": "警察就意识到",
    "chars_per_second": 6.32
   },
   {
    "i": 5,
    "start": 8.95,
    "end": 10.77,
    "text": "这间十几平方米的小屋里",
    "chars_per_second": 6.04
   },
   {
    "i": 6,
    "start": 11.11,
    "end": 12.95,
    "text": "藏着九名失踪者的下落",
    "chars_per_second": 5.43
   },
   {
    "i": 7,
    "start": 13.29,
    "end": 14.86,
    "text": "而把警察带到这里的",
    "chars_per_second": 5.73
   },
   {
    "i": 8,
    "start": 15.2,
    "end": 17.61,
    "text": "是一名二十三岁女孩失踪前",
    "chars_per_second": 4.98
   },
   {
    "i": 9,
    "start": 17.96,
    "end": 20.25,
    "text": "留在社交媒体上的一条消息",
    "chars_per_second": 5.24
   }
  ]
 },
 "N02": {
  "duration": 24.661,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 2.44,
    "text": "这间公寓的主人叫白石隆浩",
    "chars_per_second": 5.24
   },
   {
    "i": 1,
    "start": 2.79,
    "end": 4.62,
    "text": "一九九零年出生在座间",
    "chars_per_second": 5.46
   },
   {
    "i": 2,
    "start": 4.96,
    "end": 6.51,
    "text": "案发时二十七岁",
    "chars_per_second": 4.52
   },
   {
    "i": 3,
    "start": 6.85,
    "end": 9.7,
    "text": "他之前在东京街头做过拉人的星探",
    "chars_per_second": 5.26
   },
   {
    "i": 4,
    "start": 10.04,
    "end": 12.33,
    "text": "还因为这份工作被警察抓过",
    "chars_per_second": 5.24
   },
   {
    "i": 5,
    "start": 12.68,
    "end": 14.45,
    "text": "二零一七年八月二十二日",
    "chars_per_second": 6.21
   },
   {
    "i": 6,
    "start": 14.79,
    "end": 16.7,
    "text": "他搬进这间公寓",
    "chars_per_second": 3.66
   },
   {
    "i": 7,
    "start": 17.04,
    "end": 18.37,
    "text": "绿丘一栋旧公寓的二楼",
    "chars_per_second": 7.52
   },
   {
    "i": 8,
    "start": 18.71,
    "end": 20.71,
    "text": "月租只要一万九千日元",
    "chars_per_second": 5.0
   },
   {
    "i": 9,
    "start": 21.05,
    "end": 21.77,
    "text": "邻居们说",
    "chars_per_second": 5.56
   },
   {
    "i": 10,
    "start": 22.12,
    "end": 24.66,
    "text": "这个年轻人看起来普普通通",
    "chars_per_second": 4.72
   }
  ]
 },
 "N03": {
  "duration": 27.02,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 1.06,
    "text": "搬进来之后",
    "chars_per_second": 5.49
   },
   {
    "i": 1,
    "start": 1.4,
    "end": 3.74,
    "text": "他在社交媒体上注册了好几个账号",
    "chars_per_second": 6.41
   },
   {
    "i": 2,
    "start": 4.09,
    "end": 6.65,
    "text": "专门找那些说自己活不下去的年轻人",
    "chars_per_second": 6.25
   },
   {
    "i": 3,
    "start": 7.0,
    "end": 8.64,
    "text": "他假装自己也一样绝望",
    "chars_per_second": 6.1
   },
   {
    "i": 4,
    "start": 8.99,
    "end": 10.36,
    "text": "说要陪对方一起走",
    "chars_per_second": 5.84
   },
   {
    "i": 5,
    "start": 10.7,
    "end": 12.24,
    "text": "把对方约到自己的公寓",
    "chars_per_second": 6.49
   },
   {
    "i": 6,
    "start": 12.58,
    "end": 14.74,
    "text": "从八月下旬到十月下旬",
    "chars_per_second": 4.63
   },
   {
    "i": 7,
    "start": 15.08,
    "end": 15.96,
    "text": "短短两个月",
    "chars_per_second": 5.68
   },
   {
    "i": 8,
    "start": 16.3,
    "end": 17.8,
    "text": "九个人走进这间公寓",
    "chars_per_second": 6.0
   },
   {
    "i": 9,
    "start": 18.15,
    "end": 19.09,
    "text": "再也没有出来",
    "chars_per_second": 6.38
   },
   {
    "i": 10,
    "start": 19.44,
    "end": 20.28,
    "text": "八名女性",
    "chars_per_second": 4.76
   },
   {
    "i": 11,
    "start": 20.63,
    "end": 21.38,
    "text": "一名男性",
    "chars_per_second": 5.33
   },
   {
    "i": 12,
    "start": 21.72,
    "end": 24.05,
    "text": "年龄从十五岁到二十六岁",
    "chars_per_second": 4.72
   },
   {
    "i": 13,
    "start": 24.39,
    "end": 25.48,
    "text": "其中那名男性",
    "chars_per_second": 5.5
   },
   {
    "i": 14,
    "start": 25.75,
    "end": 27.02,
    "text": "是来找女友的",
    "chars_per_second": 4.72
   }
  ]
 },
 "N04": {
  "duration": 27.16,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 2.92,
    "text": "转机来自八王子一名二十三岁的女孩",
    "chars_per_second": 5.76
   },
   {
    "i": 1,
    "start": 3.27,
    "end": 4.92,
    "text": "十月下旬她突然失踪",
    "chars_per_second": 5.45
   },
   {
    "i": 2,
    "start": 5.27,
    "end": 7.05,
    "text": "哥哥翻看她的社交账号",
    "chars_per_second": 5.62
   },
   {
    "i": 3,
    "start": 7.4,
    "end": 11.23,
    "text": "发现她失踪前一直在和一个陌生账号聊天",
    "chars_per_second": 4.7
   },
   {
    "i": 4,
    "start": 11.59,
    "end": 13.11,
    "text": "车站的监控还拍到",
    "chars_per_second": 5.26
   },
   {
    "i": 5,
    "start": 13.46,
    "end": 16.89,
    "text": "女孩曾和一名男子一起出现在车站",
    "chars_per_second": 4.37
   },
   {
    "i": 6,
    "start": 17.23,
    "end": 19.4,
    "text": "警方顺着这个账号设下埋伏",
    "chars_per_second": 5.53
   },
   {
    "i": 7,
    "start": 19.75,
    "end": 21.24,
    "text": "约对方在车站见面",
    "chars_per_second": 5.37
   },
   {
    "i": 8,
    "start": 21.58,
    "end": 22.5,
    "text": "十月三十日",
    "chars_per_second": 5.43
   },
   {
    "i": 9,
    "start": 22.84,
    "end": 24.07,
    "text": "警察一路跟着他",
    "chars_per_second": 5.69
   },
   {
    "i": 10,
    "start": 24.42,
    "end": 27.16,
    "text": "回到了座间市的那间公寓门口",
    "chars_per_second": 4.74
   }
  ]
 },
 "N05": {
  "duration": 29.081,
  "clauses": [
   {
    "i": 0,
    "start": 0.15,
    "end": 0.93,
    "text": "门一打开",
    "chars_per_second": 5.13
   },
   {
    "i": 1,
    "start": 1.28,
    "end": 3.91,
    "text": "警察就看到了堆在屋里的几个箱子",
    "chars_per_second": 5.7
   },
   {
    "i": 2,
    "start": 4.25,
    "end": 5.49,
    "text": "搜查很快确认",
    "chars_per_second": 4.84
   },
   {
    "i": 3,
    "start": 5.83,
    "end": 7.28,
    "text": "此前失踪的九个人",
    "chars_per_second": 5.52
   },
   {
    "i": 4,
    "start": 7.62,
    "end": 9.75,
    "text": "都在这间公寓里找到了下落",
    "chars_per_second": 5.63
   },
   {
    "i": 5,
    "start": 10.09,
    "end": 10.7,
    "text": "第二天",
    "chars_per_second": 4.92
   },
   {
    "i": 6,
    "start": 11.05,
    "end": 12.88,
    "text": "白石隆浩被警方逮捕",
    "chars_per_second": 4.92
   },
   {
    "i": 7,
    "start": 13.22,
    "end": 13.97,
    "text": "面对审讯",
    "chars_per_second": 5.33
   },
   {
    "i": 8,
    "start": 14.32,
    "end": 15.73,
    "text": "他承认了全部罪行",
    "chars_per_second": 5.67
   },
   {
    "i": 9,
    "start": 16.07,
    "end": 19.05,
    "text": "还承认这间公寓就是为了作案才租下的",
    "chars_per_second": 5.7
   },
   {
    "i": 10,
    "start": 19.39,
    "end": 22.01,
    "text": "警方靠遗留的银行卡和手机定位",
    "chars_per_second": 5.34
   },
   {
    "i": 11,
    "start": 22.36,
    "end": 24.69,
    "text": "再比对家属的脱氧核糖核酸",
    "chars_per_second": 5.15
   },
   {
    "i": 12,
    "start": 25.04,
    "end": 26.86,
    "text": "逐一确认了九人的身份",
    "chars_per_second": 5.49
   },
   {
    "i": 13,
    "start": 27.21,
    "end": 29.08,
    "text": "案件震惊了整个日本",
    "chars_per_second": 4.81
   }
  ]
 },
 "N06": {
  "duration": 29.935,
  "clauses": [
   {
    "i": 0,
    "start": 0.14,
    "end": 1.96,
    "text": "二零二零年十二月十五日",
    "chars_per_second": 6.04
   },
   {
    "i": 1,
    "start": 2.31,
    "end": 5.45,
    "text": "东京地方法院立川支部判处他死刑",
    "chars_per_second": 4.78
   },
   {
    "i": 2,
    "start": 5.79,
    "end": 8.06,
    "text": "他在法庭上认下全部罪名",
    "chars_per_second": 4.85
   },
   {
    "i": 3,
    "start": 8.41,
    "end": 9.36,
    "text": "又撤回上诉",
    "chars_per_second": 5.26
   },
   {
    "i": 4,
    "start": 9.7,
    "end": 12.04,
    "text": "死刑在二零二一年一月确定",
    "chars_per_second": 5.13
   },
   {
    "i": 5,
    "start": 12.39,
    "end": 14.17,
    "text": "二零二五年六月二十七日",
    "chars_per_second": 6.18
   },
   {
    "i": 6,
    "start": 14.44,
    "end": 15.32,
    "text": "死刑执行",
    "chars_per_second": 4.55
   },
   {
    "i": 7,
    "start": 15.67,
    "end": 19.29,
    "text": "这是日本时隔两年十一个月再次执行死刑",
    "chars_per_second": 4.97
   },
   {
    "i": 8,
    "start": 19.63,
    "end": 20.39,
    "text": "九条人命",
    "chars_per_second": 5.26
   },
   {
    "i": 9,
    "start": 20.74,
    "end": 21.28,
    "text": "两个月",
    "chars_per_second": 5.56
   },
   {
    "i": 10,
    "start": 21.63,
    "end": 22.34,
    "text": "一间公寓",
    "chars_per_second": 5.63
   },
   {
    "i": 11,
    "start": 22.68,
    "end": 24.59,
    "text": "网络对面的一句我陪你",
    "chars_per_second": 5.24
   },
   {
    "i": 12,
    "start": 24.94,
    "end": 26.74,
    "text": "可能是世上最危险的话",
    "chars_per_second": 5.56
   },
   {
    "i": 13,
    "start": 27.08,
    "end": 28.21,
    "text": "如果它发给了你",
    "chars_per_second": 6.19
   },
   {
    "i": 14,
    "start": 28.55,
    "end": 29.93,
    "text": "你能分辨出来吗",
    "chars_per_second": 5.05
   }
  ]
 }
}