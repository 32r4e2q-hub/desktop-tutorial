# ── 鉴权（必填其一，否则 /v1 全部 503）────────────────────────────
# 客户端用的 key。随机长字符串：openssl rand -hex 24
ROUTER_API_KEY=

# 管理员看 /metrics 用的 key。留空 = /metrics 直接 503（不会退化成用 ROUTER_API_KEY 看）
ADMIN_KEY=

# 唯一"对外开放"开关。true 且 ROUTER_API_KEY 为空时才允许匿名调用；默认 false。
# 公网部署建议永远留 false —— 否则任何人都能用你的免费额度。
ALLOW_ANONYMOUS=false

# 允许跨域调用的站点（逗号分隔，支持 *.例.com）。留空 = 不发任何 CORS 头（仅同源）
ALLOWED_ORIGINS=

# ── 路由与容错 ─────────────────────────────────────────────
# 失败转移顺序，逗号分隔；只填你真正配了 key 的
PROVIDER_ORDER=groq,sambanova,mistral,openrouter,agnes,cohere,gemini,huggingface,nvidia,cloudflare
TIMEOUT_MS=15000
STREAM_TIMEOUT_MS=120000
COOLDOWN_MS=30000
CACHE_TTL_MS=300000
CACHE_MAX=200
RATE_LIMIT_RPM=60
DEBUG=false

# ── provider 凭据：填一个就能跑 ─────────────────────────────
# Groq https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
#GROQ_BASE_URL=https://api.groq.com/openai/v1   # 走自建反代时才改

# SambaNova https://cloud.sambanova.ai
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 各家窗口只在客户端探测时用（<ID>_CONTEXT），保守填、别贪大
# Mistral https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# OpenRouter https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Agnes AI https://platform.agnes-ai.com —— OpenAI 兼容，agnes-2.5-flash 当前 $0/百万 token
# 注意 agnes-2.5-pro-alpha 是付费的，别填进来
AGNES_API_KEY=
AGNES_MODEL=agnes-2.5-flash
#AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1   # 海外节点改 https://apihub.agnes-ai.com/v1

# Cohere https://dashboard.cohere.com
COHERE_API_KEY=
COHERE_MODEL=command-r-plus-08-2024

# Google AI Studio https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite   # gemini-2.5-* 于 2026-10-16 整代关停，别再用

# Hugging Face https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# NVIDIA NIM https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Cloudflare Workers AI（需要 token + account id 两样）
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
