      "max_speedup_factor": 1.55,
      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "一九六六年，巴西，山顶上亮起一道红光。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.3,
          "natural_speech_seconds": 4.19,
          "spoken_seconds": 4.19,
          "tempo_factor": 1.0,
          "speech_start": 0.03,
          "speech_end": 4.22,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "两个男人戴着铅面具并排躺着，身边一张字条。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 4.255,
          "natural_speech_seconds": 4.19,
          "spoken_seconds": 4.19,
          "tempo_factor": 1.0,
          "speech_start": 5.03,
          "speech_end": 9.22,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "他们叫米格尔和曼努埃尔，是坎普斯市的电子技师。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 4.435,
          "natural_clip_seconds": 4.16,
          "natural_speech_seconds": 4.05,
          "spoken_seconds": 4.05,
          "tempo_factor": 1.0,
          "speech_start": 10.03,
          "speech_end": 14.08,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "专门给电视台安装信号设备，也修电视和收音机。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 4.435,
          "natural_clip_seconds": 4.2,
          "natural_speech_seconds": 4.09,
          "spoken_seconds": 4.09,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 21.12,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "八月十七日，他们对家人说，要去圣保罗买车和仪器。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 4.725,
          "natural_clip_seconds": 4.47,
          "natural_speech_seconds": 4.36,
          "spoken_seconds": 4.36,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 28.39,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "可当天下午，他们出现在另一座城市：尼泰罗伊。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 4.563,
          "natural_clip_seconds": 4.36,
          "natural_speech_seconds": 4.25,
          "spoken_seconds": 4.25,
          "tempo_factor": 1.0,
          "speech_start": 30.03,
          "speech_end": 34.28,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "尼泰罗伊郊外，有一座荒凉的小山，叫文廷山。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 4.772,
          "natural_clip_seconds": 4.59,
          "natural_speech_seconds": 4.48,
          "spoken_seconds": 4.48,
          "tempo_factor": 1.0,
          "speech_start": 35.03,
          "speech_end": 39.51,
          "characters": 18,
          "target_chars_per_second": 2.571
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "八月二十日，一个十八岁的少年上山放风筝。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 3.93,
          "natural_speech_seconds": 3.83,
          "spoken_seconds": 3.83,
          "tempo_factor": 1.0,
          "speech_start": 42.03,
          "speech_end": 45.86,
          "characters": 18,
          "target_chars_per_second": 2.571
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "爬到山顶，他看见两个人并排躺着，一动不动。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 4.133,
          "natural_clip_seconds": 3.88,
          "natural_speech_seconds": 3.77,
          "spoken_seconds": 3.77,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 52.8,
          "characters": 18,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "风筝线从他手里滑落，风筝飘向远处的天空。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 4.214,
          "natural_clip_seconds": 4.07,
          "natural_speech_seconds": 3.96,
          "spoken_seconds": 3.96,
          "tempo_factor": 1.0,
          "speech_start": 55.03,
          "speech_end": 58.99,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "警方赶到现场，拉起警戒线，草地上只有两个人形轮廓。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 5.329,
          "natural_clip_seconds": 5.155,
          "natural_speech_seconds": 5.09,
          "spoken_seconds": 5.09,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 65.12,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "他们穿着西装，套着雨衣，身边放着水瓶和毛巾。",
          "start": 67.0,
          "duration": 6.0,
          "source_seconds": 4.899,
          "natural_clip_seconds": 4.81,
          "natural_speech_seconds": 4.7,
          "spoken_seconds": 4.7,
          "tempo_factor": 1.0,
          "speech_start": 67.03,
          "speech_end": 71.73,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "铅灰色的眼罩，倒映着天边的红光。",
          "start": 73.0,
          "duration": 4.0,
          "source_seconds": 3.111,
          "natural_clip_seconds": 3.061,
          "natural_speech_seconds": 3.0,
          "spoken_seconds": 3.0,
          "tempo_factor": 1.0,
          "speech_start": 73.03,
          "speech_end": 76.03,
          "characters": 14,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "笔记写着：十六点三十到达，十八点三十服下胶囊，然后等待信号。",
          "start": 77.0,
          "duration": 8.0,
          "source_seconds": 6.351,
          "natural_clip_seconds": 6.13,
          "natural_speech_seconds": 6.02,
          "spoken_seconds": 6.02,
          "tempo_factor": 1.0,
          "speech_start": 77.03,
          "speech_end": 83.05,
          "characters": 26,
          "target_chars_per_second": 3.25
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "警局里，探员围着地图争论：是谁把他们叫上山的？",
          "start": 85.0,
          "duration": 7.0,
          "source_seconds": 4.214,
          "natural_clip_seconds": 4.11,
          "natural_speech_seconds": 4.0,
          "spoken_seconds": 4.0,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 89.03,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "验尸报告写着：没有枪伤，没有刀伤，没有打斗痕迹。",
          "start": 92.0,
          "duration": 7.0,
          "source_seconds": 4.853,
          "natural_clip_seconds": 4.65,
          "natural_speech_seconds": 4.54,
          "spoken_seconds": 4.54,
          "tempo_factor": 1.0,
          "speech_start": 92.03,
          "speech_end": 96.57,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "常见毒物查不出来，铅板上也没有放射性。",
          "start": 99.0,
          "duration": 6.0,
          "source_seconds": 3.704,
          "natural_clip_seconds": 3.62,
          "natural_speech_seconds": 3.51,
          "spoken_seconds": 3.51,
          "tempo_factor": 1.0,
          "speech_start": 99.03,
          "speech_end": 102.54,
          "characters": 17,
          "target_chars_per_second": 2.833
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "死因，成了第一个说不清的谜。",
          "start": 105.0,
          "duration": 5.0,
          "source_seconds": 2.601,
          "natural_clip_seconds": 2.56,
          "natural_speech_seconds": 2.51,
          "spoken_seconds": 2.51,
          "tempo_factor": 1.0,
          "speech_start": 105.03,
          "speech_end": 107.54,
          "characters": 12,
          "target_chars_per_second": 2.4
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "有渔民说，那晚山顶上空，出现过红橙色的光。",
          "start": 110.0,
          "duration": 7.0,
          "source_seconds": 4.725,
          "natural_clip_seconds": 4.64,
          "natural_speech_seconds": 4.53,
          "spoken_seconds": 4.53,
          "tempo_factor": 1.0,
          "speech_start": 110.03,
          "speech_end": 114.56,
          "characters": 18,
          "target_chars_per_second": 2.571
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "于是有人说：这是外星人。铅面具，是为了挡住强光。",
          "start": 117.0,
          "duration": 7.0,
          "source_seconds": 4.772,
          "natural_clip_seconds": 4.62,
          "natural_speech_seconds": 4.51,
          "spoken_seconds": 4.51,
          "tempo_factor": 1.0,
          "speech_start": 117.03,
          "speech_end": 121.54,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "两位技师痴迷实验和神秘学，桌上堆满图纸和旧书。",
          "start": 124.0,
          "duration": 6.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.457,
          "natural_speech_seconds": 4.38,
          "spoken_seconds": 4.38,
          "tempo_factor": 1.0,
          "speech_start": 124.03,
          "speech_end": 128.41,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "他们在等一个信号——可这只是传闻。",
          "start": 130.0,
          "duration": 5.0,
          "source_seconds": 3.111,
          "natural_clip_seconds": 2.97,
          "natural_speech_seconds": 2.86,
          "spoken_seconds": 2.86,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 132.89,
          "characters": 14,
          "target_chars_per_second": 2.8
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "也有人说，他们在某个团体的指引下，吞下了药物。",
          "start": 135.0,
          "duration": 7.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.459,
          "natural_speech_seconds": 4.39,
          "spoken_seconds": 4.39,
          "tempo_factor": 1.0,
          "speech_start": 135.03,
          "speech_end": 139.42,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "还有人利用他们对飞碟的兴趣，把他们骗上了山。",
          "start": 142.0,
          "duration": 7.0,
          "source_seconds": 3.413,
          "natural_clip_seconds": 3.349,
          "natural_speech_seconds": 3.26,
          "spoken_seconds": 3.26,
          "tempo_factor": 1.0,
          "speech_start": 142.03,
          "speech_end": 145.29,
          "characters": 20,
          "target_chars_per_second": 2.857
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "可这些说法，一个也没有被证实。",
          "start": 149.0,
          "duration": 6.0,
          "source_seconds": 2.601,
          "natural_clip_seconds": 2.55,
          "natural_speech_seconds": 2.44,
          "spoken_seconds": 2.44,
          "tempo_factor": 1.0,
          "speech_start": 149.03,
          "speech_end": 151.47,
          "characters": 13,
          "target_chars_per_second": 2.167
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "案件至今没有定论，红橙色的夕阳照在空山上。",
          "start": 155.0,
          "duration": 6.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 4.252,
          "natural_speech_seconds": 4.2,
          "spoken_seconds": 4.2,
          "tempo_factor": 1.0,
          "speech_start": 155.03,
          "speech_end": 159.23,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "两位妻子一直在窗前等，再也没等到他们回家。",
          "start": 161.0,
          "duration": 6.0,
          "source_seconds": 3.831,
          "natural_clip_seconds": 3.791,
          "natural_speech_seconds": 3.71,
          "spoken_seconds": 3.71,
          "tempo_factor": 1.0,
          "speech_start": 161.03,
          "speech_end": 164.74,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "字条上的「信号」和「金属」，没有人知道答案。",
          "start": 167.0,
          "duration": 5.0,
          "source_seconds": 3.669,
          "natural_clip_seconds": 3.48,
          "natural_speech_seconds": 3.37,
          "spoken_seconds": 3.37,
          "tempo_factor": 1.0,
          "speech_start": 167.03,
          "speech_end": 170.4,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "你觉得，他们到底在等什么信号？评论区告诉我。",
          "start": 172.0,
          "duration": 8.0,
          "source_seconds": 4.005,
          "natural_clip_seconds": 3.963,
          "natural_speech_seconds": 3.9,
          "spoken_seconds": 3.9,
          "tempo_factor": 1.0,
          "speech_start": 172.03,
          "speech_end": 175.93,
          "characters": 19,
          "target_chars_per_second": 2.375
        }
      ],
