      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "2000年年底，东京世田谷，一家四口在家中被杀。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 5.41,
          "natural_clip_seconds": 5.21,
          "natural_speech_seconds": 5.1,
          "spoken_seconds": 4.81,
          "tempo_factor": 1.0589,
          "speech_start": 0.03,
          "speech_end": 4.84,
          "characters": 21,
          "target_chars_per_second": 4.2
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "现场留下了大量线索，可这起案件，至今没有侦破。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 5.41,
          "natural_clip_seconds": 5.04,
          "natural_speech_seconds": 4.93,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.0316,
          "speech_start": 5.03,
          "speech_end": 9.81,
          "characters": 20,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "父亲宫泽干男44岁，在外资企业做CI开发；学生时代演过话剧，喜欢动画。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 8.44,
          "natural_clip_seconds": 8.2,
          "natural_speech_seconds": 8.09,
          "spoken_seconds": 6.77,
          "tempo_factor": 1.1926,
          "speech_start": 10.03,
          "speech_end": 16.8,
          "characters": 31,
          "target_chars_per_second": 4.429
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "母亲泰子41岁，在家开补习班；女儿妮娜八岁，学芭蕾和钢琴；儿子礼六岁。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 9.3,
          "natural_clip_seconds": 9.1,
          "natural_speech_seconds": 8.99,
          "spoken_seconds": 6.77,
          "tempo_factor": 1.3292,
          "speech_start": 17.03,
          "speech_end": 23.8,
          "characters": 30,
          "target_chars_per_second": 4.286
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "12月30日傍晚，一家人在千岁乌山买完东西，回家吃饭、看电视。",
          "start": 24.0,
          "duration": 7.0,
          "source_seconds": 6.432,
          "natural_clip_seconds": 6.19,
          "natural_speech_seconds": 6.08,
          "spoken_seconds": 6.08,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 30.11,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S06",
          "narration_id": "N03",
          "text": "那天深夜十一点多，邻居听见一声闷响；之后，那栋房子安静得出奇。",
          "start": 31.0,
          "duration": 7.0,
          "source_seconds": 6.687,
          "natural_clip_seconds": 6.627,
          "natural_speech_seconds": 6.52,
          "spoken_seconds": 6.52,
          "tempo_factor": 1.0,
          "speech_start": 31.03,
          "speech_end": 37.55,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "凶手是从二楼浴室的窗户进去的，离开时，走的是玄关。",
          "start": 38.0,
          "duration": 6.0,
          "source_seconds": 5.201,
          "natural_clip_seconds": 4.92,
          "natural_speech_seconds": 4.81,
          "spoken_seconds": 4.81,
          "tempo_factor": 1.0,
          "speech_start": 38.03,
          "speech_end": 42.84,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "31日上午，住在隔壁的母亲过来查看，才发现出了事；警方随即赶到。",
          "start": 44.0,
          "duration": 7.0,
          "source_seconds": 8.104,
          "natural_clip_seconds": 7.95,
          "natural_speech_seconds": 7.84,
          "spoken_seconds": 6.78,
          "tempo_factor": 1.1579,
          "speech_start": 44.03,
          "speech_end": 50.81,
          "characters": 28,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S09",
          "narration_id": "N04",
          "text": "警方把这里定为重大案件现场，拉起警戒线，开始一寸一寸地勘查。",
          "start": 51.0,
          "duration": 7.0,
          "source_seconds": 5.793,
          "natural_clip_seconds": 5.44,
          "natural_speech_seconds": 5.33,
          "spoken_seconds": 5.33,
          "tempo_factor": 1.0,
          "speech_start": 51.03,
          "speech_end": 56.36,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S10",
          "narration_id": "N04",
          "text": "调查人员戴着手套，逐件记录物品的位置：拍照、装袋、编号、封存。",
          "start": 58.0,
          "duration": 7.0,
          "source_seconds": 7.036,
          "natural_clip_seconds": 6.81,
          "natural_speech_seconds": 6.7,
          "spoken_seconds": 6.7,
          "tempo_factor": 1.0,
          "speech_start": 58.03,
          "speech_end": 64.73,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "一件浅灰身、浅紫袖的拉格伦运动衫，被凶手脱下来，留在现场。",
          "start": 65.0,
          "duration": 7.0,
          "source_seconds": 8.104,
          "natural_clip_seconds": 7.84,
          "natural_speech_seconds": 7.73,
          "spoken_seconds": 6.77,
          "tempo_factor": 1.1419,
          "speech_start": 65.03,
          "speech_end": 71.8,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S12",
          "narration_id": "N05",
          "text": "还有两块黑色手帕：其中一块，中间割开三厘米，用来裹住刀柄。",
          "start": 72.0,
          "duration": 7.0,
          "source_seconds": 6.304,
          "natural_clip_seconds": 6.06,
          "natural_speech_seconds": 5.95,
          "spoken_seconds": 5.95,
          "tempo_factor": 1.0,
          "speech_start": 72.03,
          "speech_end": 77.98,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S13",
          "narration_id": "N05",
          "text": "刀柄、血迹、指纹，还有吃剩的冰淇淋，证据一件件被送进实验室。",
          "start": 79.0,
          "duration": 7.0,
          "source_seconds": 7.338,
          "natural_clip_seconds": 6.89,
          "natural_speech_seconds": 6.78,
          "spoken_seconds": 6.78,
          "tempo_factor": 1.0,
          "speech_start": 79.03,
          "speech_end": 85.81,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S14",
          "narration_id": "N05",
          "text": "可证据本身不等于答案；每一件东西，都要和别的线索互相印证。",
          "start": 86.0,
          "duration": 7.0,
          "source_seconds": 7.546,
          "natural_clip_seconds": 7.36,
          "natural_speech_seconds": 7.25,
          "spoken_seconds": 6.79,
          "tempo_factor": 1.0636,
          "speech_start": 86.03,
          "speech_end": 92.82,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S15",
          "narration_id": "N06",
          "text": "调查人员发现，案发之后，有人用过这台电脑：上网、建文件夹。",
          "start": 93.0,
          "duration": 7.0,
          "source_seconds": 7.465,
          "natural_clip_seconds": 7.27,
          "natural_speech_seconds": 7.16,
          "spoken_seconds": 6.81,
          "tempo_factor": 1.0506,
          "speech_start": 93.03,
          "speech_end": 99.84,
          "characters": 24,
          "target_chars_per_second": 3.429
        },
        {
          "id": "S16",
          "narration_id": "N06",
          "text": "冰箱里的四个冰淇淋被吃掉，厕所被使用过，急救箱也被翻动。",
          "start": 100.0,
          "duration": 7.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.52,
          "natural_speech_seconds": 5.41,
          "spoken_seconds": 5.41,
          "tempo_factor": 1.0,
          "speech_start": 100.03,
          "speech_end": 105.44,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S17",
          "narration_id": "N06",
          "text": "现场留下了他的血、他的鞋印，甚至他的指纹，可这个人始终没有名字。",
          "start": 107.0,
          "duration": 7.0,
          "source_seconds": 7.802,
          "natural_clip_seconds": 7.45,
          "natural_speech_seconds": 7.34,
          "spoken_seconds": 6.78,
          "tempo_factor": 1.0882,
          "speech_start": 107.03,
          "speech_end": 113.81,
          "characters": 28,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S18",
          "narration_id": "N07",
          "text": "二十多年里，警方投入近三十万人次，一遍遍重查物证、翻旧档案。",
          "start": 114.0,
          "duration": 7.0,
          "source_seconds": 6.223,
          "natural_clip_seconds": 6.03,
          "natural_speech_seconds": 5.92,
          "spoken_seconds": 5.92,
          "tempo_factor": 1.0,
          "speech_start": 114.03,
          "speech_end": 119.95,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S19",
          "narration_id": "N07",
          "text": "找到一件衣服，和证明它是谁的，是两件完全不同的事。",
          "start": 121.0,
          "duration": 7.0,
          "source_seconds": 5.329,
          "natural_clip_seconds": 4.93,
          "natural_speech_seconds": 4.82,
          "spoken_seconds": 4.82,
          "tempo_factor": 1.0,
          "speech_start": 121.03,
          "speech_end": 125.85,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S20",
          "narration_id": "N07",
          "text": "时间一年年过去，房子还在，街边的树绿了又黄，答案却一直没有来。",
          "start": 128.0,
          "duration": 7.0,
          "source_seconds": 7.3,
          "natural_clip_seconds": 6.89,
          "natural_speech_seconds": 6.78,
          "spoken_seconds": 6.78,
          "tempo_factor": 1.0,
          "speech_start": 128.03,
          "speech_end": 134.81,
          "characters": 27,
          "target_chars_per_second": 3.857
        },
        {
          "id": "S21",
          "narration_id": "N08",
          "text": "警方从未放弃，一遍遍公开物证，悬赏最高两千万日元，征集线索。",
          "start": 135.0,
          "duration": 7.0,
          "source_seconds": 7.338,
          "natural_clip_seconds": 6.99,
          "natural_speech_seconds": 6.88,
          "spoken_seconds": 6.77,
          "tempo_factor": 1.0166,
          "speech_start": 135.03,
          "speech_end": 141.8,
          "characters": 26,
          "target_chars_per_second": 3.714
        },
        {
          "id": "S22",
          "narration_id": "N08",
          "text": "关于凶手是谁、为什么动手，外面猜测很多，可猜测不能当证据。",
          "start": 142.0,
          "duration": 7.0,
          "source_seconds": 6.432,
          "natural_clip_seconds": 6.02,
          "natural_speech_seconds": 5.91,
          "spoken_seconds": 5.91,
          "tempo_factor": 1.0,
          "speech_start": 142.03,
          "speech_end": 147.94,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S23",
          "narration_id": "N08",
          "text": "那座房子里，那一夜发生的全部真相，至今没有被揭开。",
          "start": 149.0,
          "duration": 7.0,
          "source_seconds": 5.793,
          "natural_clip_seconds": 5.43,
          "natural_speech_seconds": 5.32,
          "spoken_seconds": 5.32,
          "tempo_factor": 1.0,
          "speech_start": 149.03,
          "speech_end": 154.35,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S24",
          "narration_id": "N09",
          "text": "运动衫、手帕，还有那些没解开的线索。",
          "start": 156.0,
          "duration": 4.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 3.9,
          "natural_speech_seconds": 3.79,
          "spoken_seconds": 3.79,
          "tempo_factor": 1.0,
          "speech_start": 156.03,
          "speech_end": 159.82,
          "characters": 15,
          "target_chars_per_second": 3.75
        },
        {
          "id": "S25",
          "narration_id": "N09",
          "text": "到底哪一条线索，才能真的接近答案？",
          "start": 160.0,
          "duration": 4.0,
          "source_seconds": 3.8,
          "natural_clip_seconds": 3.58,
          "natural_speech_seconds": 3.47,
          "spoken_seconds": 3.47,
          "tempo_factor": 1.0,
          "speech_start": 160.03,
          "speech_end": 163.5,
          "characters": 15,
          "target_chars_per_second": 3.75
        },
        {
          "id": "S26",
          "narration_id": "N09",
          "text": "真相，仍然在黑暗里，等着被揭开。",
          "start": 164.0,
          "duration": 4.0,
          "source_seconds": 4.516,
          "natural_clip_seconds": 4.15,
          "natural_speech_seconds": 4.04,
          "spoken_seconds": 3.81,
          "tempo_factor": 1.0587,
          "speech_start": 164.03,
          "speech_end": 167.84,
          "characters": 13,
          "target_chars_per_second": 3.25
        },
        {
          "id": "S27",
          "narration_id": "N09",
          "text": "你怎么看？",
          "start": 168.0,
          "duration": 4.0,
          "source_seconds": 1.103,
          "natural_clip_seconds": 0.73,
          "natural_speech_seconds": 0.62,
          "spoken_seconds": 0.62,
          "tempo_factor": 1.0,
          "speech_start": 168.03,
          "speech_end": 168.65,
          "characters": 4,
          "target_chars_per_second": 1.0
        },
        {
          "id": "S28",
          "narration_id": "N09",
          "text": "欢迎在评论区，理性讨论。",
          "start": 172.0,
          "duration": 4.0,
          "source_seconds": 2.81,
          "natural_clip_seconds": 2.45,
          "natural_speech_seconds": 2.34,
          "spoken_seconds": 2.34,
          "tempo_factor": 1.0,
          "speech_start": 172.03,
          "speech_end": 174.37,
          "characters": 10,
          "target_chars_per_second": 2.5
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "真实案件改编，部分画面为3D复原。",
          "start": 176.0,
          "duration": 4.0,
          "source_seconds": 4.598,
          "natural_clip_seconds": 4.38,
          "natural_speech_seconds": 4.27,
          "spoken_seconds": 2.87,
          "tempo_factor": 1.4722,
          "speech_start": 176.03,
          "speech_end": 178.9,
          "characters": 15,
          "target_chars_per_second": 3.75
        }
      ],
