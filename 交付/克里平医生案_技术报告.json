    "narration": {
      "voice_id": "voice-00",
      "alignment": "one-clip-one-shot-one-caption",
      "slowdown_allowed": false,
      "max_speedup_factor": 1.15,
      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "他逃上大西洋邮轮，以为这片海，能藏住自己。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 4.843,
          "natural_clip_seconds": 4.69,
          "natural_speech_seconds": 4.58,
          "spoken_seconds": 4.58,
          "tempo_factor": 1.0,
          "speech_start": 0.03,
          "speech_end": 4.61,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "可一道电波，已经跑在了他的前面。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 3.602,
          "natural_clip_seconds": 3.29,
          "natural_speech_seconds": 3.18,
          "spoken_seconds": 3.18,
          "tempo_factor": 1.0,
          "speech_start": 5.03,
          "speech_end": 8.21,
          "characters": 14,
          "target_chars_per_second": 2.8
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "一九一零年一月三十一日，伦敦的小楼里，聚会正热闹。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 5.418,
          "natural_clip_seconds": 5.31,
          "natural_speech_seconds": 5.23,
          "spoken_seconds": 5.23,
          "tempo_factor": 1.0,
          "speech_start": 10.0,
          "speech_end": 15.23,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "女歌手科拉放声高歌，丈夫克里平，却安静地坐在角落。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 5.897,
          "natural_clip_seconds": 5.68,
          "natural_speech_seconds": 5.57,
          "spoken_seconds": 5.57,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 22.6,
          "characters": 22,
          "target_chars_per_second": 3.143
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "可聚会之后，科拉再没露面，只留下了她的舞台帽。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 5.277,
          "natural_clip_seconds": 4.89,
          "natural_speech_seconds": 4.78,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 28.81,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "几周后，情人伊瑟尔住了进来，戴上科拉的首饰。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 4.833,
          "natural_clip_seconds": 4.52,
          "natural_speech_seconds": 4.41,
          "spoken_seconds": 4.41,
          "tempo_factor": 1.0,
          "speech_start": 30.03,
          "speech_end": 34.44,
          "characters": 19,
          "target_chars_per_second": 3.8
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "丈夫先说科拉回了美国，后来又说她病死，朋友们起了疑心。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 6.289,
          "natural_clip_seconds": 6.12,
          "natural_speech_seconds": 6.01,
          "spoken_seconds": 6.01,
          "tempo_factor": 1.0,
          "speech_start": 35.03,
          "speech_end": 41.04,
          "characters": 24,
          "target_chars_per_second": 3.429
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "她们报了警，苏格兰场的杜探长，开始调查这场失踪。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 5.408,
          "natural_clip_seconds": 5.22,
          "natural_speech_seconds": 5.11,
          "spoken_seconds": 5.11,
          "tempo_factor": 1.0,
          "speech_start": 42.03,
          "speech_end": 47.14,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "探长上门，克里平温和应答，第一次搜查，一无所获。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 5.157,
          "natural_clip_seconds": 5.03,
          "natural_speech_seconds": 4.92,
          "spoken_seconds": 4.92,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 53.95,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "可调查之后，这对情人突然不见了。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 3.652,
          "natural_clip_seconds": 3.45,
          "natural_speech_seconds": 3.34,
          "spoken_seconds": 3.34,
          "tempo_factor": 1.0,
          "speech_start": 55.03,
          "speech_end": 58.37,
          "characters": 14,
          "target_chars_per_second": 2.8
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "两人的消失，让探长折返回去，这次，他走向地下煤窖。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 5.848,
          "natural_clip_seconds": 5.5,
          "natural_speech_seconds": 5.39,
          "spoken_seconds": 5.39,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 65.42,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "他撬开松动的砖地，看到地下的东西，脸色变得凝重。",
          "start": 67.0,
          "duration": 7.0,
          "source_seconds": 5.684,
          "natural_clip_seconds": 5.51,
          "natural_speech_seconds": 5.43,
          "spoken_seconds": 5.43,
          "tempo_factor": 1.0,
          "speech_start": 67.0,
          "speech_end": 72.43,
          "characters": 21,
          "target_chars_per_second": 3.0
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "地下发现了遗骸，警方封锁现场。",
          "start": 74.0,
          "duration": 6.0,
          "source_seconds": 4.456,
          "natural_clip_seconds": 4.263,
          "natural_speech_seconds": 4.22,
          "spoken_seconds": 4.22,
          "tempo_factor": 1.0,
          "speech_start": 74.03,
          "speech_end": 78.25,
          "characters": 13,
          "target_chars_per_second": 2.167
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "检验发现了剧毒药物，警方随即发出通缉令。",
          "start": 80.0,
          "duration": 5.0,
          "source_seconds": 4.025,
          "natural_clip_seconds": 3.92,
          "natural_speech_seconds": 3.84,
          "spoken_seconds": 3.84,
          "tempo_factor": 1.0,
          "speech_start": 80.0,
          "speech_end": 83.84,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "七月二十日，两人化名罗宾逊父子，登上蒙特罗斯号。",
          "start": 85.0,
          "duration": 6.0,
          "source_seconds": 5.64,
          "natural_clip_seconds": 5.47,
          "natural_speech_seconds": 5.36,
          "spoken_seconds": 5.36,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 90.39,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "船长肯德尔，却留意上了这对举止奇怪的父子。",
          "start": 91.0,
          "duration": 6.0,
          "source_seconds": 5.881,
          "natural_clip_seconds": 5.64,
          "natural_speech_seconds": 5.53,
          "spoken_seconds": 5.53,
          "tempo_factor": 1.0,
          "speech_start": 91.03,
          "speech_end": 96.56,
          "characters": 19,
          "target_chars_per_second": 3.167
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "男孩的裤脚靠别针固定，两人牵手的动作，又过分亲密。",
          "start": 97.0,
          "duration": 6.0,
          "source_seconds": 5.888,
          "natural_clip_seconds": 5.86,
          "natural_speech_seconds": 5.76,
          "spoken_seconds": 5.76,
          "tempo_factor": 1.0,
          "speech_start": 97.02,
          "speech_end": 102.78,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "船长翻开通缉报纸，认出了这对逃亡者。",
          "start": 103.0,
          "duration": 5.0,
          "source_seconds": 3.597,
          "natural_clip_seconds": 3.26,
          "natural_speech_seconds": 3.15,
          "spoken_seconds": 3.15,
          "tempo_factor": 1.0,
          "speech_start": 103.03,
          "speech_end": 106.18,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "他让电报员向英国发报，一道电波，越过了大西洋。",
          "start": 108.0,
          "duration": 6.0,
          "source_seconds": 5.881,
          "natural_clip_seconds": 5.75,
          "natural_speech_seconds": 5.64,
          "spoken_seconds": 5.64,
          "tempo_factor": 1.0,
          "speech_start": 108.03,
          "speech_end": 113.67,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "线索送到警方手里，杜探长立即出发。",
          "start": 114.0,
          "duration": 6.0,
          "source_seconds": 4.997,
          "natural_clip_seconds": 4.86,
          "natural_speech_seconds": 4.78,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.0,
          "speech_start": 114.0,
          "speech_end": 118.78,
          "characters": 15,
          "target_chars_per_second": 2.5
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "他登上更快的劳伦蒂克号，要赶在两人前面。",
          "start": 120.0,
          "duration": 5.0,
          "source_seconds": 4.428,
          "natural_clip_seconds": 4.23,
          "natural_speech_seconds": 4.12,
          "spoken_seconds": 4.12,
          "tempo_factor": 1.0,
          "speech_start": 120.03,
          "speech_end": 124.15,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "一边还在悠闲看海，另一边，已经抢先抵达加拿大。",
          "start": 125.0,
          "duration": 5.0,
          "source_seconds": 4.886,
          "natural_clip_seconds": 4.71,
          "natural_speech_seconds": 4.6,
          "spoken_seconds": 4.6,
          "tempo_factor": 1.0,
          "speech_start": 125.03,
          "speech_end": 129.63,
          "characters": 20,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "七月三十一日清晨，探长换上引航员制服，在父亲角等候。",
          "start": 130.0,
          "duration": 7.0,
          "source_seconds": 6.836,
          "natural_clip_seconds": 6.48,
          "natural_speech_seconds": 6.37,
          "spoken_seconds": 6.37,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 136.4,
          "characters": 23,
          "target_chars_per_second": 3.286
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "小船靠上蒙特罗斯号，探长登船，走到毫无防备的克里平身后。",
          "start": 137.0,
          "duration": 7.0,
          "source_seconds": 6.434,
          "natural_clip_seconds": 6.28,
          "natural_speech_seconds": 6.17,
          "spoken_seconds": 6.17,
          "tempo_factor": 1.0,
          "speech_start": 137.03,
          "speech_end": 143.2,
          "characters": 25,
          "target_chars_per_second": 3.571
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "帽子摘下，这场跨海逃亡，终于结束了。",
          "start": 144.0,
          "duration": 6.0,
          "source_seconds": 4.568,
          "natural_clip_seconds": 4.33,
          "natural_speech_seconds": 4.22,
          "spoken_seconds": 4.22,
          "tempo_factor": 1.0,
          "speech_start": 144.03,
          "speech_end": 148.25,
          "characters": 15,
          "target_chars_per_second": 2.5
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "十月，克里平在老贝利受审，陪审团开始商议判决。",
          "start": 150.0,
          "duration": 6.0,
          "source_seconds": 5.879,
          "natural_clip_seconds": 5.56,
          "natural_speech_seconds": 5.45,
          "spoken_seconds": 5.45,
          "tempo_factor": 1.0,
          "speech_start": 150.03,
          "speech_end": 155.48,
          "characters": 20,
          "target_chars_per_second": 3.333
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "仅二十七分钟，他被裁定有罪。伊瑟尔另案受审，无罪。",
          "start": 156.0,
          "duration": 6.0,
          "source_seconds": 5.877,
          "natural_clip_seconds": 5.71,
          "natural_speech_seconds": 5.6,
          "spoken_seconds": 5.6,
          "tempo_factor": 1.0,
          "speech_start": 156.03,
          "speech_end": 161.63,
          "characters": 21,
          "target_chars_per_second": 3.5
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "十一月二十三日，克里平被处决，故事似乎画上了句号。",
          "start": 162.0,
          "duration": 6.0,
          "source_seconds": 5.881,
          "natural_clip_seconds": 5.73,
          "natural_speech_seconds": 5.62,
          "spoken_seconds": 5.62,
          "tempo_factor": 1.0,
          "speech_start": 162.03,
          "speech_end": 167.65,
          "characters": 22,
          "target_chars_per_second": 3.667
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "可二〇〇七年的DNA研究提出：地窖里的人，可能不是科拉。",
          "start": 168.0,
          "duration": 6.0,
          "source_seconds": 5.881,
          "natural_clip_seconds": 5.62,
          "natural_speech_seconds": 5.51,
          "spoken_seconds": 5.51,
          "tempo_factor": 1.0,
          "speech_start": 168.03,
          "speech_end": 173.54,
          "characters": 23,
          "target_chars_per_second": 3.833
        },
        {
          "id": "S30",
          "narration_id": "N09",
          "text": "结论仍有争议，原判未改。科拉，究竟在哪？",
          "start": 174.0,
          "duration": 6.0,
          "source_seconds": 4.96,
          "natural_clip_seconds": 4.86,
          "natural_speech_seconds": 4.75,
          "spoken_seconds": 4.75,
          "tempo_factor": 1.0,
          "speech_start": 174.03,
          "speech_end": 178.78,
          "characters": 16,
          "target_chars_per_second": 2.667
        }
      ],
