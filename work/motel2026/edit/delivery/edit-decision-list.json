[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "她问AI：安眠药加酒，会不会死？"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "AI说：可能致命。她看完，继续加大了药量。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "2025年12月，首尔江北区，金某让男友喝下掺了药的饮料。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他昏迷了两天才醒来，当时，她没有被追责。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "她没有收手，转头又问AI：药检，能查出来吗？"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "她把AI的回答，记在了心里。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "2026年1月28日晚九点半，江北区水踰洞的一家汽车旅馆。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "她陪着一位二十多岁的男子走了进去，前台递出一张门卡。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "两个小时后，有人看到她一个人走了出来。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "第二天，男子被发现死在了房间的床上。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "仅仅十二天后，2月9日，同样的旅馆街，另一名男子也再没有醒来。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "2月11日清晨，警察在公寓楼下抓到了她，她没有逃跑。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "她说：我们吵了一架，我只是想让他睡着。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "直到警察联系我，我才知道他死了。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 91,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "起初，她面对的只是伤害致死，她以为就这样了。"
  },
  {
    "id": "S16",
    "start": 91,
    "end": 97,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "可第二天，警察打开了她的手机，里面有一长串聊天记录。"
  },
  {
    "id": "S17",
    "start": 97,
    "end": 103,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "她反复问AI：过量会不会致死，药和酒一起会怎样？"
  },
  {
    "id": "S18",
    "start": 103,
    "end": 108,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "AI明确回答：可能致命。而她后来，加大了药量。"
  },
  {
    "id": "S19",
    "start": 108,
    "end": 114,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "警方还发现，她在作案前，已在家里提前调好了饮料。"
  },
  {
    "id": "S20",
    "start": 114,
    "end": 120,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "国立科学搜查研究院，检出了死者体内的药物成分。"
  },
  {
    "id": "S21",
    "start": 120,
    "end": 125,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "伤害致死，变成了杀人，罪名彻底反转。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 130,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "2026年3月，她被提起公诉，等待审判。"
  },
  {
    "id": "S23",
    "start": 130,
    "end": 137,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "案发后，她的社交账号十天涨粉，从两百涨到一万多。"
  },
  {
    "id": "S24",
    "start": 137,
    "end": 144,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "评论区里，不少人在写：颜值即正义，点赞数暴涨。"
  },
  {
    "id": "S25",
    "start": 144,
    "end": 150,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "一半在为受害者哀悼，另一半，却在为凶手点赞。"
  },
  {
    "id": "S26",
    "start": 150,
    "end": 156,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "法庭上，她说自己不记得那些对话，语气平静。"
  },
  {
    "id": "S27",
    "start": 156,
    "end": 162,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "法官不信：你记得每个细节，却唯独忘了这些？"
  },
  {
    "id": "S28",
    "start": 162,
    "end": 168,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "8月27日，她被判无期徒刑，检方要求死刑，双方都已上诉。"
  },
  {
    "id": "S29",
    "start": 168,
    "end": 174,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "AI警告过她，她没有听。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "你觉得，当一个人铁了心，一句警告，拦得住吗？"
  }
]
