[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "雨后的水踰洞，连着两起死亡。金素英，二十岁。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "三月，检方公开了她的姓名、年龄和照片。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "最早的一杯饮料，在南杨州咖啡馆外，递给了她当时的男友。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "2025年12月14日，南杨州咖啡馆外，男友喝下饮料后昏迷。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "两天后，他醒来，分手后报案。线索浮出水面。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他活了下来。可屏幕上的红光，没有熄灭。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "1月28日，水踰洞。认识不久、不是男友的男子，随她走进旅馆。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "饭后，是她提出去旅馆。门，在两人身后轻轻合上。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "警方认为，她选的不是偶遇地点，而是封闭、私密的空间。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "两小时后，她独自离开。次日，那名男子死亡。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "2月9日，第二名二十多岁男子，和她进了同区旅馆。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "他也不是男友。警方封锁现场；两人的姓名职业没有公开。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "两次短暂约会里，他们都替她付了饭钱和房费。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "警方认为，她接近这些男人，是为了满足消费。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 91,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "检方认为，冲突或索取回报出现时，她试图控制对方。"
  },
  {
    "id": "S16",
    "start": 91,
    "end": 97,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "她却说，自己怕身体接触，只想让他们睡过去。"
  },
  {
    "id": "S17",
    "start": 97,
    "end": 103,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "她说没想杀人。可这个解释，开始被证据推开。"
  },
  {
    "id": "S18",
    "start": 103,
    "end": 108,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "记录显示，她事前反复确认：这样做，可能致命。"
  },
  {
    "id": "S19",
    "start": 108,
    "end": 114,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "男友昏迷之后，她没有停下；同样的风险，越过下一扇门。"
  },
  {
    "id": "S20",
    "start": 114,
    "end": 120,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "鉴定、轨迹、聊天记录，扣成两起死亡的证据链。"
  },
  {
    "id": "S21",
    "start": 120,
    "end": 125,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "一审法院认为，她知道风险，却仍然继续。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 130,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "明知可能死亡，仍任由它发生——未必故意。"
  },
  {
    "id": "S23",
    "start": 130,
    "end": 137,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "法院认定，驱使她的主因不是爱情，而是经济和消费贪欲。"
  },
  {
    "id": "S24",
    "start": 137,
    "end": 144,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "过度警惕、回避冲突、缺乏共情，也让关系失了衡。"
  },
  {
    "id": "S25",
    "start": 144,
    "end": 150,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "没有性侵或强迫迹象。“只是防身”，法院没有采信。"
  },
  {
    "id": "S26",
    "start": 150,
    "end": 156,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "三月，她被起诉。8月27日，法庭判处无期徒刑。"
  },
  {
    "id": "S27",
    "start": 156,
    "end": 162,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "法庭还命令她接受三十年电子定位监管。"
  },
  {
    "id": "S28",
    "start": 162,
    "end": 168,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "检方曾求死刑。8月28日，她先提出上诉。"
  },
  {
    "id": "S29",
    "start": 168,
    "end": 174,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "9月2日，检方也上诉。案件，仍在二审。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "门关上了，红光还亮着。审判仍在继续。"
  }
]
