[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "1998年夏，和歌山园部，一场社区夏祭。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "锅里的咖喱还冒着热气，四个人再也没能回家。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "那天一早，园部的主妇们就在车库里架起这口大锅，煮了整整一天。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "开饭的时候，主妇们一勺一勺把咖喱盛进餐盘，队伍一直排到街口。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "孩子挨着妈妈坐下，捧着自己的小盘子，一口一口吃得很香。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "夕阳落下去，蝉声很响，没有人察觉任何异常。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "大人们围坐在折叠桌旁，慢慢吃着咖喱聊着家常，谁也没有在意。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "没过多久，有人扶住额头慢慢蹲了下去；接着，一个，又一个。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "一辆接一辆的救护车挤进窄街，警灯在墙上不停打转。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "医生起初以为，这只是夏天常见的一次食物中毒。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "可症状越来越重：六十七人中毒，送进医院，四个人再没能救回来。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "检验结果出来了：让所有人中毒的，是砒霜，也就是亚砷酸。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "毒物查明了：这不是意外，是有人故意把毒放进了那锅咖喱里。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "全城震惊。警方在那口锅四周拉起警戒线。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 92,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "专案组围着板子推演：谁靠近过那口锅？谁有机会一个人留下？"
  },
  {
    "id": "S16",
    "start": 92,
    "end": 99,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "那天经过这条街、进过那间车库的每一张脸，全被重新排查一遍。"
  },
  {
    "id": "S17",
    "start": 99,
    "end": 105,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "照片钉上墙，红线牵着名字：谁在什么时候站在锅边。"
  },
  {
    "id": "S18",
    "start": 105,
    "end": 110,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "街坊低声议论的，是同一个名字：林真须美。"
  },
  {
    "id": "S19",
    "start": 110,
    "end": 117,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "那年她三十七岁；和丈夫健治做过保险推销、灭白蚁，都碰过砷。"
  },
  {
    "id": "S20",
    "start": 117,
    "end": 124,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "警方在她家搜出一包白色粉末，送检之后，是和锅里同样的砷。"
  },
  {
    "id": "S21",
    "start": 124,
    "end": 130,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "案发之前那十年，夫妻俩多次靠保险诈骗，拿到过不少钱。"
  },
  {
    "id": "S22",
    "start": 130,
    "end": 135,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "检方说：家里的砷和锅里的砷，成分相同。"
  },
  {
    "id": "S23",
    "start": 135,
    "end": 142,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "记者把她家门口围住；她抓起水管朝镜头猛喷，水花溅在镜片上。"
  },
  {
    "id": "S24",
    "start": 142,
    "end": 149,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "这一幕当晚传遍全国。很多人看完那段画面，心里已经先给她定了罪。"
  },
  {
    "id": "S25",
    "start": 149,
    "end": 155,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "同年十二月，她因这锅咖喱被捕。她只说：我没有做。"
  },
  {
    "id": "S26",
    "start": 155,
    "end": 161,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "2002年12月，和歌山地方法院一审宣判，判处她死刑。"
  },
  {
    "id": "S27",
    "start": 161,
    "end": 167,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "没有动机，也没有直接证据；法院靠的，只有鉴定和证词。"
  },
  {
    "id": "S28",
    "start": 167,
    "end": 172,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "2009年，最高法院维持死刑；辩方质疑证据。"
  },
  {
    "id": "S29",
    "start": 172,
    "end": 180,
    "duration": 8,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "她至今在狱中喊冤，第三度再审仍在审理。你觉得，凶手是她吗？"
  }
]
