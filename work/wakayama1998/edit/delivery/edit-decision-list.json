[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "1998年夏，日本和歌山，一场社区夏祭。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "一锅咖喱，让四个人再也没有回家。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "7月25日，园部地区的主妇们，在车库里架起大锅。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "切土豆、搅咖喱、说说笑笑，汗顺着额头一直往下流。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "中午，孩子、老人、刚下班的邻居，排队来领饭。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "夕阳很好，蝉声很响，没有人察觉任何异常。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "没过多久，一位老人放下勺子，捂着额头说，头晕。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "紧接着，人们一个接一个蹲下，有人大喊：咖喱，停！"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "救护车一辆接一辆开进窄街，红灯在墙上打转。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "医生起初以为，这只是夏天的食物中毒。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "可症状越来越重：六十七人中毒，四个人没能救回来。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "检验结果出来了：让所有人中毒的，是砒霜，也就是砷。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "所以这不是食物中毒，这是一次蓄意的投毒。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "全城震惊。警方在那口锅周围拉起警戒线。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 92,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "警方要查清楚：谁靠近过那口锅？谁有机会一个人留下？"
  },
  {
    "id": "S16",
    "start": 92,
    "end": 99,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "那天进过车库的每一个人，都被重新排查一遍。"
  },
  {
    "id": "S17",
    "start": 99,
    "end": 105,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "法院后来认定：有一位主妇，曾独自看管过一段时间。"
  },
  {
    "id": "S18",
    "start": 105,
    "end": 110,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "她叫林真须美，那年37岁，就住在这条街上。"
  },
  {
    "id": "S19",
    "start": 110,
    "end": 117,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "她和丈夫健治，做过保险推销和灭白蚁，都碰过砷。"
  },
  {
    "id": "S20",
    "start": 117,
    "end": 124,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "警方在她家搜出一包白色粉末；检验之后，是同样的砷。"
  },
  {
    "id": "S21",
    "start": 124,
    "end": 130,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "案发之前那十年，夫妻俩多次靠保险诈骗拿到钱。"
  },
  {
    "id": "S22",
    "start": 130,
    "end": 135,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "检方说：家里的砷，和锅里的砷，成分相同。"
  },
  {
    "id": "S23",
    "start": 135,
    "end": 142,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "记者围住她家；她举起水管朝镜头喷水，水花溅在镜片上。"
  },
  {
    "id": "S24",
    "start": 142,
    "end": 149,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "这一幕传遍全国。很多人看完，心里已经先判了她。"
  },
  {
    "id": "S25",
    "start": 149,
    "end": 155,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "同年12月，她因这锅咖喱被捕；她说：我没有做。"
  },
  {
    "id": "S26",
    "start": 155,
    "end": 161,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "2002年，和歌山地方法院，判处她死刑。"
  },
  {
    "id": "S27",
    "start": 161,
    "end": 167,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "没有动机，没有直接证据；法院靠的是鉴定和证词。"
  },
  {
    "id": "S28",
    "start": 167,
    "end": 172,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "2009年，最高法院维持死刑；辩方质疑证据。"
  },
  {
    "id": "S29",
    "start": 172,
    "end": 180,
    "duration": 8,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "她至今在狱中喊冤；第三度再审还在审理。你觉得，凶手是她吗？"
  }
]
