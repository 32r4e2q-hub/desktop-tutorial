[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N1",
    "narration": "1977年夏天，一张25美元罚单飘过纽约街头。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N1",
    "narration": "它轻轻落在一辆黄色老式轿车的挡风玻璃上。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "1976年夏天，纽约酷热难耐，夜晚的街头却越来越安静。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "7月29日深夜，在布朗克斯，一对年轻情侣在车里遇袭。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "凶手用一把.44口径左轮手枪，没留下任何线索。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "此后一年，袭击一次次发生在皇后区和布朗克斯。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "从此纽约人互相提醒：天黑以后，别在车里待着。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "女人们纷纷剪短头发、换发色，有的人干脆不出门。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "1977年4月，凶手在案发现场留下了一封信。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "信的署名，是三个字：山姆之子。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "五月，他又写信给《每日新闻》专栏作家吉米·布雷斯林。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "信里问：7月29日，也就是他的首案周年，你会送我什么？"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "那一天，正是他第一次作案的周年。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "警方成立了庞大的专案组，通宵追查。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 91,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "7月31日深夜，布鲁克林海湾区，又一对年轻人遇袭。"
  },
  {
    "id": "S16",
    "start": 91,
    "end": 97,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "邻居西西莉亚·戴维斯出门遛狗，看到了什么？"
  },
  {
    "id": "S17",
    "start": 97,
    "end": 103,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "一个男人从黄色福特车上取走了一张罚单。"
  },
  {
    "id": "S18",
    "start": 103,
    "end": 108,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "她还说，那晚警察一直在街上开罚单。"
  },
  {
    "id": "S19",
    "start": 108,
    "end": 114,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "探长贾斯特斯翻遍了当晚开出的所有罚单。"
  },
  {
    "id": "S20",
    "start": 114,
    "end": 120,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "其中一张罚单的车牌，来自北边的扬克斯。"
  },
  {
    "id": "S21",
    "start": 120,
    "end": 125,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "他拨通了扬克斯警局的电话。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 130,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "接电话的调度员，叫惠特·卡尔。"
  },
  {
    "id": "S23",
    "start": 130,
    "end": 137,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "更巧的是，惠特的父亲山姆·卡尔不久前报过警："
  },
  {
    "id": "S24",
    "start": 137,
    "end": 144,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "自家的黑色拉布拉多被人打伤，还收到恐吓信。"
  },
  {
    "id": "S25",
    "start": 144,
    "end": 150,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "扬克斯警方早就在怀疑同一个邻居。"
  },
  {
    "id": "S26",
    "start": 150,
    "end": 156,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "8月10日夜，警方在扬克斯公寓外等到了他。"
  },
  {
    "id": "S27",
    "start": 156,
    "end": 162,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "走出大门的，是24岁的邮局职员大卫·伯科维茨。"
  },
  {
    "id": "S28",
    "start": 162,
    "end": 168,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "他停下脚步，说：好吧，你们抓到我了。"
  },
  {
    "id": "S29",
    "start": 168,
    "end": 174,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N9",
    "narration": "他被判终身监禁，纽约终于松了一口气。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N9",
    "narration": "一张小小的罚单，抓住了大案子。"
  }
]
