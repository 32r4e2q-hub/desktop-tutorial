[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "它在这里站了五百多年，美得让人不敢呼吸。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 11,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "1950年夏夜，一个二十一岁的僧人，把它烧成了灰。"
  },
  {
    "id": "S03",
    "start": 11,
    "end": 17,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "金阁寺本名鹿苑寺，1397年由足利义满建造。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 23,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "三层楼阁贴满金箔，整座建筑倒映在镜湖池里。"
  },
  {
    "id": "S05",
    "start": 23,
    "end": 30,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "春天樱花，冬天白雪，人们说，这就是日本的美。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 37,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "夏夜，萤火点点，僧人站在池边，久久望着金阁。"
  },
  {
    "id": "S07",
    "start": 37,
    "end": 43,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "他叫林养贤，1929年生在京都北边的舞鹤。"
  },
  {
    "id": "S08",
    "start": 43,
    "end": 50,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "家里是一座小寺院。他从小就口吃，一开口就被嘲笑。"
  },
  {
    "id": "S09",
    "start": 50,
    "end": 56,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "父亲病逝后，十六岁的他被送进金阁寺，成了见习僧。"
  },
  {
    "id": "S10",
    "start": 56,
    "end": 61,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "他仰头看着金阁的屋脊，眼睛里全是金光。"
  },
  {
    "id": "S11",
    "start": 61,
    "end": 66,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "他一边在寺里修行，一边在大谷大学读书。"
  },
  {
    "id": "S12",
    "start": 66,
    "end": 70,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "可口吃让他在人群里越来越沉默。"
  },
  {
    "id": "S13",
    "start": 70,
    "end": 77,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "战后的金阁寺，游客排队买票，寺院靠门票赚钱。"
  },
  {
    "id": "S14",
    "start": 77,
    "end": 83,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "他看不惯这些。他和住持之间，也慢慢有了隔阂。"
  },
  {
    "id": "S15",
    "start": 83,
    "end": 89,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "1950年7月1日深夜，他提着旧布包，走过回廊。"
  },
  {
    "id": "S16",
    "start": 89,
    "end": 94,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "金阁里面，佛像静静坐着，烛火轻轻摇晃。"
  },
  {
    "id": "S17",
    "start": 94,
    "end": 101,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "凌晨三点，窗口亮起一点火，接着，整座楼阁烧了起来。"
  },
  {
    "id": "S18",
    "start": 101,
    "end": 107,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "镜湖池里，燃烧的金阁倒映在水中，像另一片星空。"
  },
  {
    "id": "S19",
    "start": 107,
    "end": 112,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "没有人员伤亡。可是火起的时候，警报器没有响。"
  },
  {
    "id": "S20",
    "start": 112,
    "end": 119,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "屋顶塌了，五百年的国宝和足利义满的木像，全成了灰。"
  },
  {
    "id": "S21",
    "start": 119,
    "end": 125,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "天亮以后，废墟还在冒烟，焦黑的木头立在晨光里。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 132,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "那天傍晚，警方在后山找到了他。他也曾想过结束自己的生命。"
  },
  {
    "id": "S23",
    "start": 132,
    "end": 137,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "审讯室里，他低着头说，他嫉妒金阁的美。"
  },
  {
    "id": "S24",
    "start": 137,
    "end": 143,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "有时又说，他厌恶寺院里的钱味。供词前后不一。"
  },
  {
    "id": "S25",
    "start": 143,
    "end": 149,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "事发后，母亲被叫到京都。她一直盼着儿子当住持。"
  },
  {
    "id": "S26",
    "start": 149,
    "end": 155,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "她没能见到儿子。回程的火车上，她走了。"
  },
  {
    "id": "S27",
    "start": 155,
    "end": 160,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "1950年12月，京都地方法院判他七年。"
  },
  {
    "id": "S28",
    "start": 160,
    "end": 167,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "狱中，他的肺结核和精神疾病越来越重，后来提前获释。"
  },
  {
    "id": "S29",
    "start": 167,
    "end": 174,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "1955年，金阁重建，金光又一次洒满镜湖池。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "三岛由纪夫写下了《金阁寺》。美，究竟该如何守护？"
  }
]
