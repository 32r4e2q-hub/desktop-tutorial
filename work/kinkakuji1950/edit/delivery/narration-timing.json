{
  "voice_id": "voice-02",
  "alignment": "one-clip-one-shot-one-caption",
  "slowdown_allowed": false,
  "max_speedup_factor": 1.55,
  "shots": [
    {
      "id": "S01",
      "narration_id": "N01",
      "text": "它在这里站了五百多年，美得让人不敢呼吸。",
      "start": 0.0,
      "duration": 5.0,
      "source_seconds": 4.265,
      "natural_clip_seconds": 4.264,
      "natural_speech_seconds": 4.21,
      "spoken_seconds": 4.21,
      "tempo_factor": 1.0,
      "speech_start": 0.03,
      "speech_end": 4.24,
      "characters": 18,
      "target_chars_per_second": 3.6
    },
    {
      "id": "S02",
      "narration_id": "N01",
      "text": "1950年夏夜，一个二十一岁的僧人，把它烧成了灰。",
      "start": 5.0,
      "duration": 6.0,
      "source_seconds": 5.44,
      "natural_clip_seconds": 5.37,
      "natural_speech_seconds": 5.28,
      "spoken_seconds": 5.28,
      "tempo_factor": 1.0,
      "speech_start": 5.01,
      "speech_end": 10.29,
      "characters": 22,
      "target_chars_per_second": 3.667
    },
    {
      "id": "S03",
      "narration_id": "N02",
      "text": "金阁寺本名鹿苑寺，1397年由足利义满建造。",
      "start": 11.0,
      "duration": 6.0,
      "source_seconds": 5.555,
      "natural_clip_seconds": 5.52,
      "natural_speech_seconds": 5.43,
      "spoken_seconds": 5.43,
      "tempo_factor": 1.0,
      "speech_start": 11.01,
      "speech_end": 16.44,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S04",
      "narration_id": "N02",
      "text": "三层楼阁贴满金箔，整座建筑倒映在镜湖池里。",
      "start": 17.0,
      "duration": 6.0,
      "source_seconds": 5.5,
      "natural_clip_seconds": 5.13,
      "natural_speech_seconds": 5.04,
      "spoken_seconds": 5.04,
      "tempo_factor": 1.0,
      "speech_start": 17.01,
      "speech_end": 22.05,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S05",
      "narration_id": "N02",
      "text": "春天樱花，冬天白雪，人们说，这就是日本的美。",
      "start": 23.0,
      "duration": 7.0,
      "source_seconds": 6.44,
      "natural_clip_seconds": 5.61,
      "natural_speech_seconds": 5.5,
      "spoken_seconds": 5.5,
      "tempo_factor": 1.0,
      "speech_start": 23.03,
      "speech_end": 28.53,
      "characters": 18,
      "target_chars_per_second": 2.571
    },
    {
      "id": "S06",
      "narration_id": "N02",
      "text": "夏夜，萤火点点，僧人站在池边，久久望着金阁。",
      "start": 30.0,
      "duration": 7.0,
      "source_seconds": 6.08,
      "natural_clip_seconds": 5.54,
      "natural_speech_seconds": 5.43,
      "spoken_seconds": 5.43,
      "tempo_factor": 1.0,
      "speech_start": 30.03,
      "speech_end": 35.46,
      "characters": 18,
      "target_chars_per_second": 2.571
    },
    {
      "id": "S07",
      "narration_id": "N03",
      "text": "他叫林养贤，1929年生在京都北边的舞鹤。",
      "start": 37.0,
      "duration": 6.0,
      "source_seconds": 5.565,
      "natural_clip_seconds": 5.563,
      "natural_speech_seconds": 5.52,
      "spoken_seconds": 5.52,
      "tempo_factor": 1.0,
      "speech_start": 37.03,
      "speech_end": 42.55,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S08",
      "narration_id": "N03",
      "text": "家里是一座小寺院。他从小就口吃，一开口就被嘲笑。",
      "start": 43.0,
      "duration": 7.0,
      "source_seconds": 6.415,
      "natural_clip_seconds": 6.06,
      "natural_speech_seconds": 5.97,
      "spoken_seconds": 5.97,
      "tempo_factor": 1.0,
      "speech_start": 43.01,
      "speech_end": 48.98,
      "characters": 21,
      "target_chars_per_second": 3.0
    },
    {
      "id": "S09",
      "narration_id": "N03",
      "text": "父亲病逝后，十六岁的他被送进金阁寺，成了见习僧。",
      "start": 50.0,
      "duration": 6.0,
      "source_seconds": 5.59,
      "natural_clip_seconds": 5.25,
      "natural_speech_seconds": 5.14,
      "spoken_seconds": 5.14,
      "tempo_factor": 1.0,
      "speech_start": 50.03,
      "speech_end": 55.17,
      "characters": 21,
      "target_chars_per_second": 3.5
    },
    {
      "id": "S10",
      "narration_id": "N03",
      "text": "他仰头看着金阁的屋脊，眼睛里全是金光。",
      "start": 56.0,
      "duration": 5.0,
      "source_seconds": 4.055,
      "natural_clip_seconds": 3.56,
      "natural_speech_seconds": 3.45,
      "spoken_seconds": 3.45,
      "tempo_factor": 1.0,
      "speech_start": 56.03,
      "speech_end": 59.48,
      "characters": 17,
      "target_chars_per_second": 3.4
    },
    {
      "id": "S11",
      "narration_id": "N04",
      "text": "他一边在寺里修行，一边在大谷大学读书。",
      "start": 61.0,
      "duration": 5.0,
      "source_seconds": 4.45,
      "natural_clip_seconds": 4.319,
      "natural_speech_seconds": 4.28,
      "spoken_seconds": 4.28,
      "tempo_factor": 1.0,
      "speech_start": 61.03,
      "speech_end": 65.31,
      "characters": 17,
      "target_chars_per_second": 3.4
    },
    {
      "id": "S12",
      "narration_id": "N04",
      "text": "可口吃让他在人群里越来越沉默。",
      "start": 66.0,
      "duration": 4.0,
      "source_seconds": 3.135,
      "natural_clip_seconds": 3.08,
      "natural_speech_seconds": 2.97,
      "spoken_seconds": 2.97,
      "tempo_factor": 1.0,
      "speech_start": 66.03,
      "speech_end": 69.0,
      "characters": 14,
      "target_chars_per_second": 3.5
    },
    {
      "id": "S13",
      "narration_id": "N04",
      "text": "战后的金阁寺，游客排队买票，寺院靠门票赚钱。",
      "start": 70.0,
      "duration": 7.0,
      "source_seconds": 5.755,
      "natural_clip_seconds": 5.753,
      "natural_speech_seconds": 5.72,
      "spoken_seconds": 5.72,
      "tempo_factor": 1.0,
      "speech_start": 70.03,
      "speech_end": 75.75,
      "characters": 19,
      "target_chars_per_second": 2.714
    },
    {
      "id": "S14",
      "narration_id": "N04",
      "text": "他看不惯这些。他和住持之间，也慢慢有了隔阂。",
      "start": 77.0,
      "duration": 6.0,
      "source_seconds": 5.58,
      "natural_clip_seconds": 5.488,
      "natural_speech_seconds": 5.45,
      "spoken_seconds": 5.45,
      "tempo_factor": 1.0,
      "speech_start": 77.03,
      "speech_end": 82.48,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S15",
      "narration_id": "N05",
      "text": "1950年7月1日深夜，他提着旧布包，走过回廊。",
      "start": 83.0,
      "duration": 6.0,
      "source_seconds": 5.655,
      "natural_clip_seconds": 5.56,
      "natural_speech_seconds": 5.45,
      "spoken_seconds": 5.45,
      "tempo_factor": 1.0,
      "speech_start": 83.03,
      "speech_end": 88.48,
      "characters": 21,
      "target_chars_per_second": 3.5
    },
    {
      "id": "S16",
      "narration_id": "N05",
      "text": "金阁里面，佛像静静坐着，烛火轻轻摇晃。",
      "start": 89.0,
      "duration": 5.0,
      "source_seconds": 4.74,
      "natural_clip_seconds": 4.738,
      "natural_speech_seconds": 4.7,
      "spoken_seconds": 4.7,
      "tempo_factor": 1.0,
      "speech_start": 89.03,
      "speech_end": 93.73,
      "characters": 16,
      "target_chars_per_second": 3.2
    },
    {
      "id": "S17",
      "narration_id": "N05",
      "text": "凌晨三点，窗口亮起一点火，接着，整座楼阁烧了起来。",
      "start": 94.0,
      "duration": 7.0,
      "source_seconds": 6.14,
      "natural_clip_seconds": 6.099,
      "natural_speech_seconds": 6.05,
      "spoken_seconds": 6.05,
      "tempo_factor": 1.0,
      "speech_start": 94.03,
      "speech_end": 100.08,
      "characters": 21,
      "target_chars_per_second": 3.0
    },
    {
      "id": "S18",
      "narration_id": "N05",
      "text": "镜湖池里，燃烧的金阁倒映在水中，像另一片星空。",
      "start": 101.0,
      "duration": 6.0,
      "source_seconds": 5.67,
      "natural_clip_seconds": 5.63,
      "natural_speech_seconds": 5.52,
      "spoken_seconds": 5.52,
      "tempo_factor": 1.0,
      "speech_start": 101.03,
      "speech_end": 106.55,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S19",
      "narration_id": "N06",
      "text": "没有人员伤亡。可是火起的时候，警报器没有响。",
      "start": 107.0,
      "duration": 5.0,
      "source_seconds": 4.625,
      "natural_clip_seconds": 4.31,
      "natural_speech_seconds": 4.21,
      "spoken_seconds": 4.21,
      "tempo_factor": 1.0,
      "speech_start": 107.02,
      "speech_end": 111.23,
      "characters": 19,
      "target_chars_per_second": 3.8
    },
    {
      "id": "S20",
      "narration_id": "N06",
      "text": "屋顶塌了，五百年的国宝和足利义满的木像，全成了灰。",
      "start": 112.0,
      "duration": 7.0,
      "source_seconds": 5.89,
      "natural_clip_seconds": 5.51,
      "natural_speech_seconds": 5.4,
      "spoken_seconds": 5.4,
      "tempo_factor": 1.0,
      "speech_start": 112.03,
      "speech_end": 117.43,
      "characters": 22,
      "target_chars_per_second": 3.143
    },
    {
      "id": "S21",
      "narration_id": "N06",
      "text": "天亮以后，废墟还在冒烟，焦黑的木头立在晨光里。",
      "start": 119.0,
      "duration": 6.0,
      "source_seconds": 5.615,
      "natural_clip_seconds": 5.21,
      "natural_speech_seconds": 5.1,
      "spoken_seconds": 5.1,
      "tempo_factor": 1.0,
      "speech_start": 119.03,
      "speech_end": 124.13,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S22",
      "narration_id": "N06",
      "text": "那天傍晚，警方在后山找到了他。他也曾想过结束自己的生命。",
      "start": 125.0,
      "duration": 7.0,
      "source_seconds": 6.63,
      "natural_clip_seconds": 6.629,
      "natural_speech_seconds": 6.6,
      "spoken_seconds": 6.6,
      "tempo_factor": 1.0,
      "speech_start": 125.02,
      "speech_end": 131.62,
      "characters": 25,
      "target_chars_per_second": 3.571
    },
    {
      "id": "S23",
      "narration_id": "N07",
      "text": "审讯室里，他低着头说，他嫉妒金阁的美。",
      "start": 132.0,
      "duration": 5.0,
      "source_seconds": 4.66,
      "natural_clip_seconds": 4.629,
      "natural_speech_seconds": 4.59,
      "spoken_seconds": 4.59,
      "tempo_factor": 1.0,
      "speech_start": 132.03,
      "speech_end": 136.62,
      "characters": 16,
      "target_chars_per_second": 3.2
    },
    {
      "id": "S24",
      "narration_id": "N07",
      "text": "有时又说，他厌恶寺院里的钱味。供词前后不一。",
      "start": 137.0,
      "duration": 6.0,
      "source_seconds": 5.35,
      "natural_clip_seconds": 5.29,
      "natural_speech_seconds": 5.18,
      "spoken_seconds": 5.18,
      "tempo_factor": 1.0,
      "speech_start": 137.03,
      "speech_end": 142.21,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S25",
      "narration_id": "N07",
      "text": "事发后，母亲被叫到京都。她一直盼着儿子当住持。",
      "start": 143.0,
      "duration": 6.0,
      "source_seconds": 4.91,
      "natural_clip_seconds": 4.908,
      "natural_speech_seconds": 4.89,
      "spoken_seconds": 4.89,
      "tempo_factor": 1.0,
      "speech_start": 143.01,
      "speech_end": 147.9,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S26",
      "narration_id": "N08",
      "text": "她没能见到儿子。回程的火车上，她走了。",
      "start": 149.0,
      "duration": 6.0,
      "source_seconds": 4.835,
      "natural_clip_seconds": 4.761,
      "natural_speech_seconds": 4.72,
      "spoken_seconds": 4.72,
      "tempo_factor": 1.0,
      "speech_start": 149.03,
      "speech_end": 153.75,
      "characters": 16,
      "target_chars_per_second": 2.667
    },
    {
      "id": "S27",
      "narration_id": "N08",
      "text": "1950年12月，京都地方法院判他七年。",
      "start": 155.0,
      "duration": 5.0,
      "source_seconds": 4.735,
      "natural_clip_seconds": 4.61,
      "natural_speech_seconds": 4.5,
      "spoken_seconds": 4.5,
      "tempo_factor": 1.0,
      "speech_start": 155.03,
      "speech_end": 159.53,
      "characters": 18,
      "target_chars_per_second": 3.6
    },
    {
      "id": "S28",
      "narration_id": "N08",
      "text": "狱中，他的肺结核和精神疾病越来越重，后来提前获释。",
      "start": 160.0,
      "duration": 7.0,
      "source_seconds": 5.98,
      "natural_clip_seconds": 5.979,
      "natural_speech_seconds": 5.96,
      "spoken_seconds": 5.96,
      "tempo_factor": 1.0,
      "speech_start": 160.01,
      "speech_end": 165.97,
      "characters": 22,
      "target_chars_per_second": 3.143
    },
    {
      "id": "S29",
      "narration_id": "N09",
      "text": "1955年，金阁重建，金光又一次洒满镜湖池。",
      "start": 167.0,
      "duration": 7.0,
      "source_seconds": 6.03,
      "natural_clip_seconds": 5.907,
      "natural_speech_seconds": 5.87,
      "spoken_seconds": 5.87,
      "tempo_factor": 1.0,
      "speech_start": 167.03,
      "speech_end": 172.9,
      "characters": 19,
      "target_chars_per_second": 2.714
    },
    {
      "id": "S30",
      "narration_id": "N09",
      "text": "三岛由纪夫写下了《金阁寺》。美，究竟该如何守护？",
      "start": 174.0,
      "duration": 6.0,
      "source_seconds": 5.64,
      "natural_clip_seconds": 5.59,
      "natural_speech_seconds": 5.48,
      "spoken_seconds": 4.86,
      "tempo_factor": 1.1281,
      "speech_start": 174.03,
      "speech_end": 178.89,
      "characters": 19,
      "target_chars_per_second": 3.167
    }
  ],
