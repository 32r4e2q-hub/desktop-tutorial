[
  {
    "shot_id": "S01",
    "narration_id": "N01",
    "start": 0.03,
    "end": 4.82,
    "text": "一九四八年冬天，东京在战后的寒夜里飘着雪。"
  },
  {
    "shot_id": "S02",
    "narration_id": "N01",
    "start": 5.03,
    "end": 9.84,
    "text": "帝国银行大堂灯火未熄，职员们仍在整理账目。"
  },
  {
    "shot_id": "S03",
    "narration_id": "N02",
    "start": 10.03,
    "end": 16.84,
    "text": "门外，一个自称防疫官的男人递来名片，还自称叫山口二郎。"
  },
  {
    "shot_id": "S04",
    "narration_id": "N02",
    "start": 17.03,
    "end": 23.79,
    "text": "他声称附近发生痢疾疫情，奉命送来预防药，请众人立刻服下。"
  },
  {
    "shot_id": "S05",
    "narration_id": "N02",
    "start": 24.03,
    "end": 29.85,
    "text": "窗外，美军吉普车驶过废墟街道，忙碌的身影映进玻璃。"
  },
  {
    "shot_id": "S06",
    "narration_id": "N02",
    "start": 30.03,
    "end": 34.82,
    "text": "他打开药箱，取出两瓶透明液体，解释要分两次服用。"
  },
  {
    "shot_id": "S07",
    "narration_id": "N03",
    "start": 35.03,
    "end": 41.83,
    "text": "十六名银行职员依次站成一排，每个人面前的桌上，都放着一只小杯。"
  },
  {
    "shot_id": "S08",
    "narration_id": "N03",
    "start": 42.03,
    "end": 48.78,
    "text": "来人先举杯示范，职员们相互观望，最后还是照他说的喝下。"
  },
  {
    "shot_id": "S09",
    "narration_id": "N03",
    "start": 49.03,
    "end": 54.84,
    "text": "整座银行陷入沉静，职员们无声地等着秒针走过一分钟。"
  },
  {
    "shot_id": "S10",
    "narration_id": "N03",
    "start": 55.03,
    "end": 59.84,
    "text": "随后，第二种药水倒入杯中，职员再次服下。"
  },
  {
    "shot_id": "S11",
    "narration_id": "N04",
    "start": 60.03,
    "end": 66.84,
    "text": "几分钟后，大堂传来杯子碎裂声，散落的算盘珠滚进柜台底下。"
  },
  {
    "shot_id": "S12",
    "narration_id": "N04",
    "start": 67.03,
    "end": 73.83,
    "text": "来人趁着混乱取走现金和支票，拎起药箱，从后门匆匆离开。"
  },
  {
    "shot_id": "S13",
    "narration_id": "N04",
    "start": 74.03,
    "end": 79.83,
    "text": "警车与救护车相继赶到，医护人员进入银行，街边围起人群。"
  },
  {
    "shot_id": "S14",
    "narration_id": "N04",
    "start": 80.03,
    "end": 84.79,
    "text": "报社印刷机彻夜轰鸣，帝银案很快登上全国报纸头版。"
  },
  {
    "shot_id": "S15",
    "narration_id": "N05",
    "start": 85.03,
    "end": 91.81,
    "text": "调查人员后来发现，案发前，另外两家银行也遇到过相似的防疫说辞。"
  },
  {
    "shot_id": "S16",
    "narration_id": "N05",
    "start": 92.03,
    "end": 98.83,
    "text": "安田银行的职员当时拒绝服药，那个男人只好转身离开现场。"
  },
  {
    "shot_id": "S17",
    "narration_id": "N05",
    "start": 99.03,
    "end": 104.81,
    "text": "侦查人员循线追查，一张名片，成为确认身份的重要线索。"
  },
  {
    "shot_id": "S18",
    "narration_id": "N05",
    "start": 105.03,
    "end": 109.8,
    "text": "名片属于松井蔚医生；他却称，自己并不认识这个来人。"
  },
  {
    "shot_id": "S19",
    "narration_id": "N06",
    "start": 110.03,
    "end": 116.8,
    "text": "警方沿着名片上的身份继续调查，线索逐渐指向远在北海道。"
  },
  {
    "shot_id": "S20",
    "narration_id": "N06",
    "start": 117.03,
    "end": 123.81,
    "text": "在北海道的小樽，警方最终找到一位画家，他名叫平泽贞通。"
  },
  {
    "shot_id": "S21",
    "narration_id": "N06",
    "start": 124.03,
    "end": 129.82,
    "text": "当时五十七岁的平泽正在画室作画，生活与银行相距遥远。"
  },
  {
    "shot_id": "S22",
    "narration_id": "N06",
    "start": 130.03,
    "end": 134.84,
    "text": "一九四八年八月二十一日，平泽在北海道被警方逮捕。"
  },
  {
    "shot_id": "S23",
    "narration_id": "N07",
    "start": 135.03,
    "end": 141.81,
    "text": "审讯记录留下他的认罪供述；后来，他对这份供述提出异议。"
  },
  {
    "shot_id": "S24",
    "narration_id": "N07",
    "start": 142.03,
    "end": 148.78,
    "text": "到了法庭，平泽翻供，称先前的供述是在压力之下被迫作出的。"
  },
  {
    "shot_id": "S25",
    "narration_id": "N07",
    "start": 149.03,
    "end": 154.8,
    "text": "法槌落下，判决没有平息争议，关于证据的质疑仍在。"
  },
  {
    "shot_id": "S26",
    "narration_id": "N08",
    "start": 155.03,
    "end": 160.77,
    "text": "一九五〇年，东京地方法院一审判处画家平泽贞通死刑。"
  },
  {
    "shot_id": "S27",
    "narration_id": "N08",
    "start": 161.03,
    "end": 166.84,
    "text": "不同目击者对嫌疑人的辨认结果并不一致，案件因此留下诸多疑点。"
  },
  {
    "shot_id": "S28",
    "narration_id": "N08",
    "start": 167.03,
    "end": 171.81,
    "text": "关于731部队涉案，至今仍只是未经证实的传闻。"
  },
  {
    "shot_id": "S29",
    "narration_id": "N09",
    "start": 172.03,
    "end": 178.89,
    "text": "死刑没有执行；平泽喊冤近四十年，一九八七年病逝狱中。真凶是谁？"
  }
]
