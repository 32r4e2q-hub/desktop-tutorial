[
  {
    "shot_id": "S01",
    "narration_id": "N01",
    "start": 0.03,
    "end": 4.81,
    "text": "1948年的东京，雪夜里，帝国银行亮着一扇灯。"
  },
  {
    "shot_id": "S02",
    "narration_id": "N01",
    "start": 5.03,
    "end": 8.77,
    "text": "一个自称防疫官的男人，敲响了银行后门。"
  },
  {
    "shot_id": "S03",
    "narration_id": "N02",
    "start": 10.03,
    "end": 15.71,
    "text": "他递上名片，自称山口二郎，说附近爆发了痢疾。"
  },
  {
    "shot_id": "S04",
    "narration_id": "N02",
    "start": 17.03,
    "end": 21.86,
    "text": "他声称奉命送来预防药，要求职员立刻服用。"
  },
  {
    "shot_id": "S05",
    "narration_id": "N02",
    "start": 24.03,
    "end": 28.05,
    "text": "窗外，美军吉普车驶过，没人敢多问。"
  },
  {
    "shot_id": "S06",
    "narration_id": "N02",
    "start": 30.03,
    "end": 32.9,
    "text": "药箱里，装着两种透明药水。"
  },
  {
    "shot_id": "S07",
    "narration_id": "N03",
    "start": 35.03,
    "end": 39.24,
    "text": "他让十六个人排成一排，每人面前放一只小杯。"
  },
  {
    "shot_id": "S08",
    "narration_id": "N03",
    "start": 42.03,
    "end": 44.99,
    "text": "先喝第一种，他还亲自举杯示范。"
  },
  {
    "shot_id": "S09",
    "narration_id": "N03",
    "start": 49.03,
    "end": 52.71,
    "text": "一分钟，秒针一格一格地走过。"
  },
  {
    "shot_id": "S10",
    "narration_id": "N03",
    "start": 55.03,
    "end": 58.08,
    "text": "随后，第二种药水倒进杯中。"
  },
  {
    "shot_id": "S11",
    "narration_id": "N04",
    "start": 60.03,
    "end": 64.64,
    "text": "几分钟后，杯子落地，算盘珠滚进柜台底下。"
  },
  {
    "shot_id": "S12",
    "narration_id": "N04",
    "start": 67.03,
    "end": 69.95,
    "text": "他拿走现金和支票，趁乱离开银行。"
  },
  {
    "shot_id": "S13",
    "narration_id": "N04",
    "start": 74.03,
    "end": 77.58,
    "text": "警车和救护车赶到，街上聚来围观者。"
  },
  {
    "shot_id": "S14",
    "narration_id": "N04",
    "start": 80.03,
    "end": 83.33,
    "text": "印刷机轰鸣，案件迅速登上报纸。"
  },
  {
    "shot_id": "S15",
    "narration_id": "N05",
    "start": 85.03,
    "end": 89.42,
    "text": "警方发现，他曾在两家银行用相似说辞演练。"
  },
  {
    "shot_id": "S16",
    "narration_id": "N05",
    "start": 92.03,
    "end": 96.54,
    "text": "安田银行的职员拒绝了他，男人转身离开。"
  },
  {
    "shot_id": "S17",
    "narration_id": "N05",
    "start": 99.03,
    "end": 102.56,
    "text": "一张名片，成为追查身份的重要线索。"
  },
  {
    "shot_id": "S18",
    "narration_id": "N05",
    "start": 105.03,
    "end": 108.51,
    "text": "名片属于松井蔚医生，他却不认识来人。"
  },
  {
    "shot_id": "S19",
    "narration_id": "N06",
    "start": 110.03,
    "end": 113.94,
    "text": "警方顺着名片流向，把线索织成一张网。"
  },
  {
    "shot_id": "S20",
    "narration_id": "N06",
    "start": 117.03,
    "end": 120.74,
    "text": "网的尽头，是北海道小樽的一位画家。"
  },
  {
    "shot_id": "S21",
    "narration_id": "N06",
    "start": 124.03,
    "end": 128.86,
    "text": "他叫平泽贞通，五十七岁，正在画室作画。"
  },
  {
    "shot_id": "S22",
    "narration_id": "N06",
    "start": 130.03,
    "end": 133.47,
    "text": "1948年8月21日，他在北海道被捕。"
  },
  {
    "shot_id": "S23",
    "narration_id": "N07",
    "start": 135.03,
    "end": 139.56,
    "text": "审讯中，他承认了罪行，供述写在纸上。"
  },
  {
    "shot_id": "S24",
    "narration_id": "N07",
    "start": 142.03,
    "end": 146.27,
    "text": "但到了法庭，他立刻翻供，称口供被迫。"
  },
  {
    "shot_id": "S25",
    "narration_id": "N07",
    "start": 149.03,
    "end": 152.34,
    "text": "法槌落下，案子的争议却没有结束。"
  },
  {
    "shot_id": "S26",
    "narration_id": "N08",
    "start": 155.03,
    "end": 158.94,
    "text": "1950年，平泽贞通被判处死刑。"
  },
  {
    "shot_id": "S27",
    "narration_id": "N08",
    "start": 161.03,
    "end": 164.56,
    "text": "四十多名目击者，最终只有两人认出他。"
  },
  {
    "shot_id": "S28",
    "narration_id": "N08",
    "start": 167.03,
    "end": 171.0,
    "text": "关于731部队涉案的说法，至今只是传闻。"
  },
  {
    "shot_id": "S29",
    "narration_id": "N09",
    "start": 172.03,
    "end": 178.61,
    "text": "死刑从未执行。他喊冤近四十年，1987年病逝狱中。真凶是谁？"
  }
]
