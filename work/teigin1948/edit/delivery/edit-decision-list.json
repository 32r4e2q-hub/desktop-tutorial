[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "1948年的东京，雪夜里，帝国银行亮着一扇灯。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "一个自称防疫官的男人，敲响了银行后门。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他递上名片，自称山口二郎，说附近爆发了痢疾。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他声称奉命送来预防药，要求职员立刻服用。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "窗外，美军吉普车驶过，没人敢多问。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "药箱里，装着两种透明药水。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "他让十六个人排成一排，每人面前放一只小杯。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "先喝第一种，他还亲自举杯示范。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "一分钟，秒针一格一格地走过。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "随后，第二种药水倒进杯中。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "几分钟后，杯子落地，算盘珠滚进柜台底下。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "他拿走现金和支票，趁乱离开银行。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "警车和救护车赶到，街上聚来围观者。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "印刷机轰鸣，案件迅速登上报纸。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 92,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "警方发现，他曾在两家银行用相似说辞演练。"
  },
  {
    "id": "S16",
    "start": 92,
    "end": 99,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "安田银行的职员拒绝了他，男人转身离开。"
  },
  {
    "id": "S17",
    "start": 99,
    "end": 105,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "一张名片，成为追查身份的重要线索。"
  },
  {
    "id": "S18",
    "start": 105,
    "end": 110,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "名片属于松井蔚医生，他却不认识来人。"
  },
  {
    "id": "S19",
    "start": 110,
    "end": 117,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "警方顺着名片流向，把线索织成一张网。"
  },
  {
    "id": "S20",
    "start": 117,
    "end": 124,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "网的尽头，是北海道小樽的一位画家。"
  },
  {
    "id": "S21",
    "start": 124,
    "end": 130,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "他叫平泽贞通，五十七岁，正在画室作画。"
  },
  {
    "id": "S22",
    "start": 130,
    "end": 135,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "1948年8月21日，他在北海道被捕。"
  },
  {
    "id": "S23",
    "start": 135,
    "end": 142,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "审讯中，他承认了罪行，供述写在纸上。"
  },
  {
    "id": "S24",
    "start": 142,
    "end": 149,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "但到了法庭，他立刻翻供，称口供被迫。"
  },
  {
    "id": "S25",
    "start": 149,
    "end": 155,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "法槌落下，案子的争议却没有结束。"
  },
  {
    "id": "S26",
    "start": 155,
    "end": 161,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "1950年，东京地方法院判处他死刑。"
  },
  {
    "id": "S27",
    "start": 161,
    "end": 167,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "目击者的指认并不一致，疑点留到今天。"
  },
  {
    "id": "S28",
    "start": 167,
    "end": 172,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "关于731部队涉案的说法，至今只是传闻。"
  },
  {
    "id": "S29",
    "start": 172,
    "end": 180,
    "duration": 8,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "死刑从未执行。他喊冤近四十年，1987年病逝狱中。真凶是谁？"
  }
]
