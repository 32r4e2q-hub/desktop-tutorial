[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "一九四八年冬天，东京在战后的寒夜里飘着雪。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "帝国银行大堂灯火未熄，职员们仍在整理账目。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "门外，一个自称防疫官的男人递来名片，还自称叫山口二郎。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他声称附近发生痢疾疫情，奉命送来预防药，请众人立刻服下。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "窗外，美军吉普车驶过废墟街道，忙碌的身影映进玻璃。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "他打开药箱，取出两瓶透明液体，解释要分两次服用。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "十六名银行职员依次站成一排，每个人面前的桌上，都放着一只小杯。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "来人先举杯示范，职员们相互观望，最后还是照他说的喝下。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "整座银行陷入沉静，职员们无声地等着秒针走过一分钟。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "随后，第二种药水倒入杯中，职员再次服下。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "几分钟后，大堂传来杯子碎裂声，散落的算盘珠滚进柜台底下。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "来人趁着混乱取走现金和支票，拎起药箱，从后门匆匆离开。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "警车与救护车相继赶到，医护人员进入银行，街边围起人群。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "报社印刷机彻夜轰鸣，帝银案很快登上全国报纸头版。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 92,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "调查人员后来发现，案发前，另外两家银行也遇到过相似的防疫说辞。"
  },
  {
    "id": "S16",
    "start": 92,
    "end": 99,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "安田银行的职员当时拒绝服药，那个男人只好转身离开现场。"
  },
  {
    "id": "S17",
    "start": 99,
    "end": 105,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "侦查人员循线追查，一张名片，成为确认身份的重要线索。"
  },
  {
    "id": "S18",
    "start": 105,
    "end": 110,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "名片属于松井蔚医生；他却称，自己并不认识这个来人。"
  },
  {
    "id": "S19",
    "start": 110,
    "end": 117,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "警方沿着名片上的身份继续调查，线索逐渐指向远在北海道。"
  },
  {
    "id": "S20",
    "start": 117,
    "end": 124,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "在北海道的小樽，警方最终找到一位画家，他名叫平泽贞通。"
  },
  {
    "id": "S21",
    "start": 124,
    "end": 130,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "当时五十七岁的平泽正在画室作画，生活与银行相距遥远。"
  },
  {
    "id": "S22",
    "start": 130,
    "end": 135,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "一九四八年八月二十一日，平泽在北海道被警方逮捕。"
  },
  {
    "id": "S23",
    "start": 135,
    "end": 142,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "审讯记录留下他的认罪供述；后来，他对这份供述提出异议。"
  },
  {
    "id": "S24",
    "start": 142,
    "end": 149,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "到了法庭，平泽翻供，称先前的供述是在压力之下被迫作出的。"
  },
  {
    "id": "S25",
    "start": 149,
    "end": 155,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "法槌落下，判决没有平息争议，关于证据的质疑仍在。"
  },
  {
    "id": "S26",
    "start": 155,
    "end": 161,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "一九五〇年，东京地方法院一审判处画家平泽贞通死刑。"
  },
  {
    "id": "S27",
    "start": 161,
    "end": 167,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "不同目击者对嫌疑人的辨认结果并不一致，案件因此留下诸多疑点。"
  },
  {
    "id": "S28",
    "start": 167,
    "end": 172,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "关于731部队涉案，至今仍只是未经证实的传闻。"
  },
  {
    "id": "S29",
    "start": 172,
    "end": 180,
    "duration": 8,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "死刑没有执行；平泽喊冤近四十年，一九八七年病逝狱中。真凶是谁？"
  }
]
