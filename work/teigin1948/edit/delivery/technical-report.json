      "shots": [
        {
          "id": "S01",
          "narration_id": "N01",
          "text": "1948年的东京，雪夜里，帝国银行亮着一扇灯。",
          "start": 0.0,
          "duration": 5.0,
          "source_seconds": 5.712,
          "natural_clip_seconds": 5.43,
          "natural_speech_seconds": 5.32,
          "spoken_seconds": 4.78,
          "tempo_factor": 1.1137,
          "speech_start": 0.03,
          "speech_end": 4.81,
          "characters": 20,
          "target_chars_per_second": 4.0
        },
        {
          "id": "S02",
          "narration_id": "N01",
          "text": "一个自称防疫官的男人，敲响了银行后门。",
          "start": 5.0,
          "duration": 5.0,
          "source_seconds": 4.214,
          "natural_clip_seconds": 3.85,
          "natural_speech_seconds": 3.74,
          "spoken_seconds": 3.74,
          "tempo_factor": 1.0,
          "speech_start": 5.03,
          "speech_end": 8.77,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S03",
          "narration_id": "N02",
          "text": "他递上名片，自称山口二郎，说附近爆发了痢疾。",
          "start": 10.0,
          "duration": 7.0,
          "source_seconds": 6.095,
          "natural_clip_seconds": 5.79,
          "natural_speech_seconds": 5.68,
          "spoken_seconds": 5.68,
          "tempo_factor": 1.0,
          "speech_start": 10.03,
          "speech_end": 15.71,
          "characters": 19,
          "target_chars_per_second": 2.714
        },
        {
          "id": "S04",
          "narration_id": "N02",
          "text": "他声称奉命送来预防药，要求职员立刻服用。",
          "start": 17.0,
          "duration": 7.0,
          "source_seconds": 5.3,
          "natural_clip_seconds": 4.94,
          "natural_speech_seconds": 4.83,
          "spoken_seconds": 4.83,
          "tempo_factor": 1.0,
          "speech_start": 17.03,
          "speech_end": 21.86,
          "characters": 18,
          "target_chars_per_second": 2.571
        },
        {
          "id": "S05",
          "narration_id": "N02",
          "text": "窗外，美军吉普车驶过，没人敢多问。",
          "start": 24.0,
          "duration": 6.0,
          "source_seconds": 4.435,
          "natural_clip_seconds": 4.13,
          "natural_speech_seconds": 4.02,
          "spoken_seconds": 4.02,
          "tempo_factor": 1.0,
          "speech_start": 24.03,
          "speech_end": 28.05,
          "characters": 14,
          "target_chars_per_second": 2.333
        },
        {
          "id": "S06",
          "narration_id": "N02",
          "text": "药箱里，装着两种透明药水。",
          "start": 30.0,
          "duration": 5.0,
          "source_seconds": 3.32,
          "natural_clip_seconds": 2.98,
          "natural_speech_seconds": 2.87,
          "spoken_seconds": 2.87,
          "tempo_factor": 1.0,
          "speech_start": 30.03,
          "speech_end": 32.9,
          "characters": 11,
          "target_chars_per_second": 2.2
        },
        {
          "id": "S07",
          "narration_id": "N03",
          "text": "他让十六个人排成一排，每人面前放一只小杯。",
          "start": 35.0,
          "duration": 7.0,
          "source_seconds": 4.598,
          "natural_clip_seconds": 4.32,
          "natural_speech_seconds": 4.21,
          "spoken_seconds": 4.21,
          "tempo_factor": 1.0,
          "speech_start": 35.03,
          "speech_end": 39.24,
          "characters": 19,
          "target_chars_per_second": 2.714
        },
        {
          "id": "S08",
          "narration_id": "N03",
          "text": "先喝第一种，他还亲自举杯示范。",
          "start": 42.0,
          "duration": 7.0,
          "source_seconds": 3.413,
          "natural_clip_seconds": 3.07,
          "natural_speech_seconds": 2.96,
          "spoken_seconds": 2.96,
          "tempo_factor": 1.0,
          "speech_start": 42.03,
          "speech_end": 44.99,
          "characters": 13,
          "target_chars_per_second": 1.857
        },
        {
          "id": "S09",
          "narration_id": "N03",
          "text": "一分钟，秒针一格一格地走过。",
          "start": 49.0,
          "duration": 6.0,
          "source_seconds": 4.005,
          "natural_clip_seconds": 3.744,
          "natural_speech_seconds": 3.68,
          "spoken_seconds": 3.68,
          "tempo_factor": 1.0,
          "speech_start": 49.03,
          "speech_end": 52.71,
          "characters": 12,
          "target_chars_per_second": 2.0
        },
        {
          "id": "S10",
          "narration_id": "N03",
          "text": "随后，第二种药水倒进杯中。",
          "start": 55.0,
          "duration": 5.0,
          "source_seconds": 3.6,
          "natural_clip_seconds": 3.16,
          "natural_speech_seconds": 3.05,
          "spoken_seconds": 3.05,
          "tempo_factor": 1.0,
          "speech_start": 55.03,
          "speech_end": 58.08,
          "characters": 11,
          "target_chars_per_second": 2.2
        },
        {
          "id": "S11",
          "narration_id": "N04",
          "text": "几分钟后，杯子落地，算盘珠滚进柜台底下。",
          "start": 60.0,
          "duration": 7.0,
          "source_seconds": 5.027,
          "natural_clip_seconds": 4.72,
          "natural_speech_seconds": 4.61,
          "spoken_seconds": 4.61,
          "tempo_factor": 1.0,
          "speech_start": 60.03,
          "speech_end": 64.64,
          "characters": 17,
          "target_chars_per_second": 2.429
        },
        {
          "id": "S12",
          "narration_id": "N04",
          "text": "他拿走现金和支票，趁乱离开银行。",
          "start": 67.0,
          "duration": 7.0,
          "source_seconds": 3.413,
          "natural_clip_seconds": 3.03,
          "natural_speech_seconds": 2.92,
          "spoken_seconds": 2.92,
          "tempo_factor": 1.0,
          "speech_start": 67.03,
          "speech_end": 69.95,
          "characters": 14,
          "target_chars_per_second": 2.0
        },
        {
          "id": "S13",
          "narration_id": "N04",
          "text": "警车和救护车赶到，街上聚来围观者。",
          "start": 74.0,
          "duration": 6.0,
          "source_seconds": 3.924,
          "natural_clip_seconds": 3.66,
          "natural_speech_seconds": 3.55,
          "spoken_seconds": 3.55,
          "tempo_factor": 1.0,
          "speech_start": 74.03,
          "speech_end": 77.58,
          "characters": 15,
          "target_chars_per_second": 2.5
        },
        {
          "id": "S14",
          "narration_id": "N04",
          "text": "印刷机轰鸣，案件迅速登上报纸。",
          "start": 80.0,
          "duration": 5.0,
          "source_seconds": 3.704,
          "natural_clip_seconds": 3.41,
          "natural_speech_seconds": 3.3,
          "spoken_seconds": 3.3,
          "tempo_factor": 1.0,
          "speech_start": 80.03,
          "speech_end": 83.33,
          "characters": 13,
          "target_chars_per_second": 2.6
        },
        {
          "id": "S15",
          "narration_id": "N05",
          "text": "警方发现，他曾在两家银行用相似说辞演练。",
          "start": 85.0,
          "duration": 7.0,
          "source_seconds": 4.818,
          "natural_clip_seconds": 4.5,
          "natural_speech_seconds": 4.39,
          "spoken_seconds": 4.39,
          "tempo_factor": 1.0,
          "speech_start": 85.03,
          "speech_end": 89.42,
          "characters": 18,
          "target_chars_per_second": 2.571
        },
        {
          "id": "S16",
          "narration_id": "N05",
          "text": "安田银行的职员拒绝了他，男人转身离开。",
          "start": 92.0,
          "duration": 7.0,
          "source_seconds": 5.027,
          "natural_clip_seconds": 4.62,
          "natural_speech_seconds": 4.51,
          "spoken_seconds": 4.51,
          "tempo_factor": 1.0,
          "speech_start": 92.03,
          "speech_end": 96.54,
          "characters": 17,
          "target_chars_per_second": 2.429
        },
        {
          "id": "S17",
          "narration_id": "N05",
          "text": "一张名片，成为追查身份的重要线索。",
          "start": 99.0,
          "duration": 6.0,
          "source_seconds": 4.005,
          "natural_clip_seconds": 3.64,
          "natural_speech_seconds": 3.53,
          "spoken_seconds": 3.53,
          "tempo_factor": 1.0,
          "speech_start": 99.03,
          "speech_end": 102.56,
          "characters": 15,
          "target_chars_per_second": 2.5
        },
        {
          "id": "S18",
          "narration_id": "N05",
          "text": "名片属于松井蔚医生，他却不认识来人。",
          "start": 105.0,
          "duration": 5.0,
          "source_seconds": 3.924,
          "natural_clip_seconds": 3.59,
          "natural_speech_seconds": 3.48,
          "spoken_seconds": 3.48,
          "tempo_factor": 1.0,
          "speech_start": 105.03,
          "speech_end": 108.51,
          "characters": 16,
          "target_chars_per_second": 3.2
        },
        {
          "id": "S19",
          "narration_id": "N06",
          "text": "警方顺着名片流向，把线索织成一张网。",
          "start": 110.0,
          "duration": 7.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 4.02,
          "natural_speech_seconds": 3.91,
          "spoken_seconds": 3.91,
          "tempo_factor": 1.0,
          "speech_start": 110.03,
          "speech_end": 113.94,
          "characters": 16,
          "target_chars_per_second": 2.286
        },
        {
          "id": "S20",
          "narration_id": "N06",
          "text": "网的尽头，是北海道小樽的一位画家。",
          "start": 117.0,
          "duration": 7.0,
          "source_seconds": 4.133,
          "natural_clip_seconds": 3.82,
          "natural_speech_seconds": 3.71,
          "spoken_seconds": 3.71,
          "tempo_factor": 1.0,
          "speech_start": 117.03,
          "speech_end": 120.74,
          "characters": 15,
          "target_chars_per_second": 2.143
        },
        {
          "id": "S21",
          "narration_id": "N06",
          "text": "他叫平泽贞通，五十七岁，正在画室作画。",
          "start": 124.0,
          "duration": 6.0,
          "source_seconds": 5.329,
          "natural_clip_seconds": 4.94,
          "natural_speech_seconds": 4.83,
          "spoken_seconds": 4.83,
          "tempo_factor": 1.0,
          "speech_start": 124.03,
          "speech_end": 128.86,
          "characters": 16,
          "target_chars_per_second": 2.667
        },
        {
          "id": "S22",
          "narration_id": "N06",
          "text": "1948年8月21日，他在北海道被捕。",
          "start": 130.0,
          "duration": 5.0,
          "source_seconds": 3.924,
          "natural_clip_seconds": 3.55,
          "natural_speech_seconds": 3.44,
          "spoken_seconds": 3.44,
          "tempo_factor": 1.0,
          "speech_start": 130.03,
          "speech_end": 133.47,
          "characters": 17,
          "target_chars_per_second": 3.4
        },
        {
          "id": "S23",
          "narration_id": "N07",
          "text": "审讯中，他承认了罪行，供述写在纸上。",
          "start": 135.0,
          "duration": 7.0,
          "source_seconds": 5.1,
          "natural_clip_seconds": 4.64,
          "natural_speech_seconds": 4.53,
          "spoken_seconds": 4.53,
          "tempo_factor": 1.0,
          "speech_start": 135.03,
          "speech_end": 139.56,
          "characters": 15,
          "target_chars_per_second": 2.143
        },
        {
          "id": "S24",
          "narration_id": "N07",
          "text": "但到了法庭，他立刻翻供，称口供被迫。",
          "start": 142.0,
          "duration": 7.0,
          "source_seconds": 4.725,
          "natural_clip_seconds": 4.35,
          "natural_speech_seconds": 4.24,
          "spoken_seconds": 4.24,
          "tempo_factor": 1.0,
          "speech_start": 142.03,
          "speech_end": 146.27,
          "characters": 15,
          "target_chars_per_second": 2.143
        },
        {
          "id": "S25",
          "narration_id": "N07",
          "text": "法槌落下，案子的争议却没有结束。",
          "start": 149.0,
          "duration": 6.0,
          "source_seconds": 3.622,
          "natural_clip_seconds": 3.42,
          "natural_speech_seconds": 3.31,
          "spoken_seconds": 3.31,
          "tempo_factor": 1.0,
          "speech_start": 149.03,
          "speech_end": 152.34,
          "characters": 14,
          "target_chars_per_second": 2.333
        },
        {
          "id": "S26",
          "narration_id": "N08",
          "text": "1950年，东京地方法院判处他死刑。",
          "start": 155.0,
          "duration": 6.0,
          "source_seconds": 4.598,
          "natural_clip_seconds": 4.16,
          "natural_speech_seconds": 4.05,
          "spoken_seconds": 4.05,
          "tempo_factor": 1.0,
          "speech_start": 155.03,
          "speech_end": 159.08,
          "characters": 16,
          "target_chars_per_second": 2.667
        },
        {
          "id": "S27",
          "narration_id": "N08",
          "text": "目击者的指认并不一致，疑点留到今天。",
          "start": 161.0,
          "duration": 6.0,
          "source_seconds": 4.0,
          "natural_clip_seconds": 3.56,
          "natural_speech_seconds": 3.45,
          "spoken_seconds": 3.45,
          "tempo_factor": 1.0,
          "speech_start": 161.03,
          "speech_end": 164.48,
          "characters": 16,
          "target_chars_per_second": 2.667
        },
        {
          "id": "S28",
          "narration_id": "N08",
          "text": "关于731部队涉案的说法，至今只是传闻。",
          "start": 167.0,
          "duration": 5.0,
          "source_seconds": 4.307,
          "natural_clip_seconds": 4.08,
          "natural_speech_seconds": 3.97,
          "spoken_seconds": 3.97,
          "tempo_factor": 1.0,
          "speech_start": 167.03,
          "speech_end": 171.0,
          "characters": 18,
          "target_chars_per_second": 3.6
        },
        {
          "id": "S29",
          "narration_id": "N09",
          "text": "死刑从未执行。他喊冤近四十年，1987年病逝狱中。真凶是谁？",
          "start": 172.0,
          "duration": 8.0,
          "source_seconds": 7.036,
          "natural_clip_seconds": 6.69,
          "natural_speech_seconds": 6.58,
          "spoken_seconds": 6.58,
          "tempo_factor": 1.0,
          "speech_start": 172.03,
          "speech_end": 178.61,
          "characters": 26,
          "target_chars_per_second": 3.25
        }
      ],
