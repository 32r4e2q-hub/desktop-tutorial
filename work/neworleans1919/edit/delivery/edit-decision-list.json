[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N1",
    "narration": "1919年午夜，全城同时放起了爵士乐。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N1",
    "narration": "因为一封信说：放爵士的家，斧头不会落下。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "故事要从一年前说起。1918年5月，新奥尔良的杂货店主夫妇。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "深夜，凶手蹲在后门口，用凿子，一点一点凿开一个方洞。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "他没有惊动任何人，只在墙上留下一个斧头影子。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N2",
    "narration": "清晨，弟弟推开门，抽屉里的钱，一分没少。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "接下来一年多，斧头一次次落在意大利裔杂货店家中。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "凶手总是从后门进来，用的，常常是主人家自己的斧头。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "警方疲于奔命，居民把斧头藏进柜子，把门窗钉死。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N3",
    "narration": "入夜以后，整座城市被恐惧笼罩，天一黑，门窗紧闭。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "1919年3月10日，河对岸的格雷特纳，一家杂货店。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "那一夜，店主夫妇受了重伤。屋里，摇篮空着。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "警方一度把邻居父子当成凶手，两人被判重刑。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N4",
    "narration": "一年多后，那份关键证词，被指有问题。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 91,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "三月中旬，报纸头版登出一封奇怪的信，署名“来自地狱”。"
  },
  {
    "id": "S16",
    "start": 91,
    "end": 97,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "落款：来自地狱。写于1919年3月13日。"
  },
  {
    "id": "S17",
    "start": 97,
    "end": 103,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "信里说：下周二午夜十二点十五分，我会经过新奥尔良。"
  },
  {
    "id": "S18",
    "start": 103,
    "end": 108,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N5",
    "narration": "信里说：屋里要放着爵士乐，我就放过这一家。"
  },
  {
    "id": "S19",
    "start": 108,
    "end": 114,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "3月19日，圣约瑟夫节前夜，全城行动起来。"
  },
  {
    "id": "S20",
    "start": 114,
    "end": 120,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "作曲家达维拉，连夜写出一首《神秘斧头手的爵士》。"
  },
  {
    "id": "S21",
    "start": 120,
    "end": 125,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "午夜十二点十五分，整座城的爵士乐，震耳欲聋。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 130,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N6",
    "narration": "那一夜，没有人遇害。全城的乐声，响到天亮。"
  },
  {
    "id": "S23",
    "start": 130,
    "end": 137,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "可半年后，1919年10月27日，斧头杀手又回来了一次。"
  },
  {
    "id": "S24",
    "start": 137,
    "end": 144,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "杂货店主迈克·佩皮托内，在卧室里遇害。这是最后一起。"
  },
  {
    "id": "S25",
    "start": 144,
    "end": 150,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N7",
    "narration": "妻子埃丝特冲进卧室，只看见一个背影，从后门逃走。"
  },
  {
    "id": "S26",
    "start": 150,
    "end": 156,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "之后，斧头杀手再也没出现。案卷被推进档案柜。"
  },
  {
    "id": "S27",
    "start": 156,
    "end": 162,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "一年多后，洛杉矶，埃丝特开枪打死一个男人。"
  },
  {
    "id": "S28",
    "start": 162,
    "end": 168,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N8",
    "narration": "她说，那个人叫蒙弗尔，就是斧头杀手。可研究者找不到他。"
  },
  {
    "id": "S29",
    "start": 168,
    "end": 174,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N9",
    "narration": "斧头杀手到底是谁？一百年了，没有答案。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N9",
    "narration": "今晚他要是再来敲门，你家放哪首歌？"
  }
]
