[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "2000年年底，东京世田谷，一家四口在家中被杀。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "narration": "现场留下了大量线索，可这起案件，至今没有侦破。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "父亲宫泽干男44岁，在外资企业做CI开发；学生时代演过话剧，喜欢动画。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "母亲泰子41岁，在家开补习班；女儿妮娜八岁，学芭蕾和钢琴；儿子礼六岁。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 31,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "narration": "12月30日傍晚，一家人在千岁乌山买完东西，回家吃饭、看电视。"
  },
  {
    "id": "S06",
    "start": 31,
    "end": 38,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "那天深夜十一点多，邻居听见一声闷响；之后，那栋房子安静得出奇。"
  },
  {
    "id": "S07",
    "start": 38,
    "end": 44,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "凶手是从二楼浴室的窗户进去的，离开时，走的是玄关。"
  },
  {
    "id": "S08",
    "start": 44,
    "end": 51,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "narration": "31日上午，住在隔壁的母亲过来查看，才发现出了事；警方随即赶到。"
  },
  {
    "id": "S09",
    "start": 51,
    "end": 58,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "警方把这里定为重大案件现场，拉起警戒线，开始一寸一寸地勘查。"
  },
  {
    "id": "S10",
    "start": 58,
    "end": 65,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "调查人员戴着手套，逐件记录物品的位置：拍照、装袋、编号、封存。"
  },
  {
    "id": "S11",
    "start": 65,
    "end": 72,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "narration": "一件浅灰身、浅紫袖的拉格伦运动衫，被凶手脱下来，留在现场。"
  },
  {
    "id": "S12",
    "start": 72,
    "end": 79,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "还有两块黑色手帕：其中一块，中间割开三厘米，用来裹住刀柄。"
  },
  {
    "id": "S13",
    "start": 79,
    "end": 86,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "刀柄、血迹、指纹，还有吃剩的冰淇淋，证据一件件被送进实验室。"
  },
  {
    "id": "S14",
    "start": 86,
    "end": 93,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N05",
    "narration": "可证据本身不等于答案；每一件东西，都要和别的线索互相印证。"
  },
  {
    "id": "S15",
    "start": 93,
    "end": 100,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "调查人员发现，案发之后，有人用过这台电脑：上网、建文件夹。"
  },
  {
    "id": "S16",
    "start": 100,
    "end": 107,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "冰箱里的四个冰淇淋被吃掉，厕所被使用过，急救箱也被翻动。"
  },
  {
    "id": "S17",
    "start": 107,
    "end": 114,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N06",
    "narration": "现场留下了他的血、他的鞋印，甚至他的指纹，可这个人始终没有名字。"
  },
  {
    "id": "S18",
    "start": 114,
    "end": 121,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "二十多年里，警方投入近三十万人次，一遍遍重查物证、翻旧档案。"
  },
  {
    "id": "S19",
    "start": 121,
    "end": 128,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "找到一件衣服，和证明它是谁的，是两件完全不同的事。"
  },
  {
    "id": "S20",
    "start": 128,
    "end": 135,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "narration": "时间一年年过去，房子还在，街边的树绿了又黄，答案却一直没有来。"
  },
  {
    "id": "S21",
    "start": 135,
    "end": 142,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "警方从未放弃，一遍遍公开物证，悬赏最高两千万日元，征集线索。"
  },
  {
    "id": "S22",
    "start": 142,
    "end": 149,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "关于凶手是谁、为什么动手，外面猜测很多，可猜测不能当证据。"
  },
  {
    "id": "S23",
    "start": 149,
    "end": 156,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N08",
    "narration": "那座房子里，那一夜发生的全部真相，至今没有被揭开。"
  },
  {
    "id": "S24",
    "start": 156,
    "end": 160,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "运动衫、手帕，还有那些没解开的线索。"
  },
  {
    "id": "S25",
    "start": 160,
    "end": 164,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "到底哪一条线索，才能真的接近答案？"
  },
  {
    "id": "S26",
    "start": 164,
    "end": 168,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "真相，仍然在黑暗里，等着被揭开。"
  },
  {
    "id": "S27",
    "start": 168,
    "end": 172,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "你怎么看？"
  },
  {
    "id": "S28",
    "start": 172,
    "end": 176,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "欢迎在评论区，理性讨论。"
  },
  {
    "id": "S29",
    "start": 176,
    "end": 180,
    "duration": 4,
    "kind": "agnes",
    "narration_id": "N09",
    "narration": "这个案子，还在等一个名字。"
  }
]
