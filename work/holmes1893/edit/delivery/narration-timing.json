{
  "voice_id": "voice-03",
  "alignment": "one-clip-one-shot-one-caption",
  "slowdown_allowed": false,
  "max_speedup_factor": 1.55,
  "shots": [
    {
      "id": "S01",
      "narration_id": "N01",
      "text": "传说，1893年芝加哥世博会旁，有一栋旅馆。",
      "start": 0.0,
      "duration": 5.0,
      "source_seconds": 4.818,
      "natural_clip_seconds": 4.62,
      "natural_speech_seconds": 4.51,
      "spoken_seconds": 4.51,
      "tempo_factor": 1.0,
      "speech_start": 0.03,
      "speech_end": 4.54,
      "characters": 19,
      "target_chars_per_second": 3.8
    },
    {
      "id": "S02",
      "narration_id": "N01",
      "text": "住进去的人，很多再也没有走出来，也没人问起。",
      "start": 5.0,
      "duration": 5.0,
      "source_seconds": 4.8,
      "natural_clip_seconds": 4.52,
      "natural_speech_seconds": 4.41,
      "spoken_seconds": 4.41,
      "tempo_factor": 1.0,
      "speech_start": 5.03,
      "speech_end": 9.44,
      "characters": 19,
      "target_chars_per_second": 3.8
    },
    {
      "id": "S03",
      "narration_id": "N02",
      "text": "他本名赫尔曼·马吉特，1861年生在新罕布什尔州。",
      "start": 10.0,
      "duration": 7.0,
      "source_seconds": 6.606,
      "natural_clip_seconds": 6.37,
      "natural_speech_seconds": 6.26,
      "spoken_seconds": 6.26,
      "tempo_factor": 1.0,
      "speech_start": 10.03,
      "speech_end": 16.29,
      "characters": 22,
      "target_chars_per_second": 3.143
    },
    {
      "id": "S04",
      "narration_id": "N02",
      "text": "聪明、善谈，在密歇根大学学医；据说那时就开始用尸体骗保险。",
      "start": 17.0,
      "duration": 7.0,
      "source_seconds": 7.593,
      "natural_clip_seconds": 7.5,
      "natural_speech_seconds": 7.39,
      "spoken_seconds": 6.81,
      "tempo_factor": 1.0838,
      "speech_start": 17.03,
      "speech_end": 23.84,
      "characters": 25,
      "target_chars_per_second": 3.571
    },
    {
      "id": "S05",
      "narration_id": "N02",
      "text": "一份保险单，一枚红印章，他靠这套把戏骗过钱。",
      "start": 24.0,
      "duration": 6.0,
      "source_seconds": 5.201,
      "natural_clip_seconds": 5.06,
      "natural_speech_seconds": 4.95,
      "spoken_seconds": 4.95,
      "tempo_factor": 1.0,
      "speech_start": 24.03,
      "speech_end": 28.98,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S06",
      "narration_id": "N02",
      "text": "后来他改名霍姆斯，搬到芝加哥，准备大干一场。",
      "start": 30.0,
      "duration": 5.0,
      "source_seconds": 5.201,
      "natural_clip_seconds": 4.92,
      "natural_speech_seconds": 4.81,
      "spoken_seconds": 4.81,
      "tempo_factor": 1.0,
      "speech_start": 30.03,
      "speech_end": 34.84,
      "characters": 19,
      "target_chars_per_second": 3.8
    },
    {
      "id": "S07",
      "narration_id": "N03",
      "text": "1886年，他来到芝加哥，接手了英格尔伍德街角的一家药店。",
      "start": 35.0,
      "duration": 7.0,
      "source_seconds": 5.503,
      "natural_clip_seconds": 5.23,
      "natural_speech_seconds": 5.12,
      "spoken_seconds": 5.12,
      "tempo_factor": 1.0,
      "speech_start": 35.03,
      "speech_end": 40.15,
      "characters": 26,
      "target_chars_per_second": 3.714
    },
    {
      "id": "S08",
      "narration_id": "N03",
      "text": "又在对面盖起一栋三层大楼，取名“世界博览会旅馆”。",
      "start": 42.0,
      "duration": 7.0,
      "source_seconds": 5.329,
      "natural_clip_seconds": 5.26,
      "natural_speech_seconds": 5.15,
      "spoken_seconds": 5.15,
      "tempo_factor": 1.0,
      "speech_start": 42.03,
      "speech_end": 47.18,
      "characters": 21,
      "target_chars_per_second": 3.0
    },
    {
      "id": "S09",
      "narration_id": "N03",
      "text": "传说，楼里有暗道、活板门，还有没有窗户的房间。",
      "start": 49.0,
      "duration": 6.0,
      "source_seconds": 6.014,
      "natural_clip_seconds": 5.76,
      "natural_speech_seconds": 5.65,
      "spoken_seconds": 5.65,
      "tempo_factor": 1.0,
      "speech_start": 49.03,
      "speech_end": 54.68,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S10",
      "narration_id": "N03",
      "text": "他不断换工人，一批走了又来，没人知道大楼全貌。",
      "start": 55.0,
      "duration": 5.0,
      "source_seconds": 4.725,
      "natural_clip_seconds": 4.52,
      "natural_speech_seconds": 4.41,
      "spoken_seconds": 4.41,
      "tempo_factor": 1.0,
      "speech_start": 55.03,
      "speech_end": 59.44,
      "characters": 20,
      "target_chars_per_second": 4.0
    },
    {
      "id": "S11",
      "narration_id": "N04",
      "text": "1893年世博会期间，全城挤满外地游客，失踪几个人没人注意。",
      "start": 60.0,
      "duration": 7.0,
      "source_seconds": 6.908,
      "natural_clip_seconds": 6.69,
      "natural_speech_seconds": 6.58,
      "spoken_seconds": 6.58,
      "tempo_factor": 1.0,
      "speech_start": 60.03,
      "speech_end": 66.61,
      "characters": 27,
      "target_chars_per_second": 3.857
    },
    {
      "id": "S12",
      "narration_id": "N04",
      "text": "传说，独自来游览的年轻女子，进了那栋楼，再没消息。",
      "start": 67.0,
      "duration": 7.0,
      "source_seconds": 5.712,
      "natural_clip_seconds": 5.45,
      "natural_speech_seconds": 5.34,
      "spoken_seconds": 5.34,
      "tempo_factor": 1.0,
      "speech_start": 67.03,
      "speech_end": 72.37,
      "characters": 21,
      "target_chars_per_second": 3.0
    },
    {
      "id": "S13",
      "narration_id": "N04",
      "text": "报纸一篇接一篇地渲染，数字越写越大，两百、三百。",
      "start": 74.0,
      "duration": 6.0,
      "source_seconds": 6.432,
      "natural_clip_seconds": 6.14,
      "natural_speech_seconds": 6.03,
      "spoken_seconds": 5.78,
      "tempo_factor": 1.0459,
      "speech_start": 74.03,
      "speech_end": 79.81,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S14",
      "narration_id": "N04",
      "text": "杀人城堡的传说，就这样诞生了。",
      "start": 80.0,
      "duration": 5.0,
      "source_seconds": 3.622,
      "natural_clip_seconds": 3.31,
      "natural_speech_seconds": 3.2,
      "spoken_seconds": 3.2,
      "tempo_factor": 1.0,
      "speech_start": 80.03,
      "speech_end": 83.23,
      "characters": 13,
      "target_chars_per_second": 2.6
    },
    {
      "id": "S15",
      "narration_id": "N05",
      "text": "但真相比传说更冷：他杀的多半不是游客，而是身边的熟人。",
      "start": 85.0,
      "duration": 6.0,
      "source_seconds": 5.921,
      "natural_clip_seconds": 5.68,
      "natural_speech_seconds": 5.57,
      "spoken_seconds": 5.57,
      "tempo_factor": 1.0,
      "speech_start": 85.03,
      "speech_end": 90.6,
      "characters": 24,
      "target_chars_per_second": 4.0
    },
    {
      "id": "S16",
      "narration_id": "N05",
      "text": "1894年，他和皮泰泽尔假死骗保，一万美元。",
      "start": 91.0,
      "duration": 6.0,
      "source_seconds": 5.793,
      "natural_clip_seconds": 5.63,
      "natural_speech_seconds": 5.52,
      "spoken_seconds": 5.52,
      "tempo_factor": 1.0,
      "speech_start": 91.03,
      "speech_end": 96.55,
      "characters": 19,
      "target_chars_per_second": 3.167
    },
    {
      "id": "S17",
      "narration_id": "N05",
      "text": "可他半路改了主意：皮泰泽尔死了，保险金归了他。",
      "start": 97.0,
      "duration": 6.0,
      "source_seconds": 5.12,
      "natural_clip_seconds": 4.99,
      "natural_speech_seconds": 4.88,
      "spoken_seconds": 4.88,
      "tempo_factor": 1.0,
      "speech_start": 97.03,
      "speech_end": 101.91,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S18",
      "narration_id": "N05",
      "text": "让他败露的不是那座楼，而是保险诈骗。",
      "start": 103.0,
      "duration": 5.0,
      "source_seconds": 4.307,
      "natural_clip_seconds": 4.13,
      "natural_speech_seconds": 4.02,
      "spoken_seconds": 4.02,
      "tempo_factor": 1.0,
      "speech_start": 103.03,
      "speech_end": 107.05,
      "characters": 16,
      "target_chars_per_second": 3.2
    },
    {
      "id": "S19",
      "narration_id": "N06",
      "text": "他骗皮泰泽尔的妻子，说带三个孩子坐火车，去见父亲。",
      "start": 108.0,
      "duration": 6.0,
      "source_seconds": 5.631,
      "natural_clip_seconds": 5.37,
      "natural_speech_seconds": 5.26,
      "spoken_seconds": 5.26,
      "tempo_factor": 1.0,
      "speech_start": 108.03,
      "speech_end": 113.29,
      "characters": 22,
      "target_chars_per_second": 3.667
    },
    {
      "id": "S20",
      "narration_id": "N06",
      "text": "三个孩子：艾丽斯十五岁，内莉十一，霍华德才八岁。",
      "start": 114.0,
      "duration": 6.0,
      "source_seconds": 5.968,
      "natural_clip_seconds": 5.86,
      "natural_speech_seconds": 5.75,
      "spoken_seconds": 5.75,
      "tempo_factor": 1.0,
      "speech_start": 114.03,
      "speech_end": 119.78,
      "characters": 20,
      "target_chars_per_second": 3.333
    },
    {
      "id": "S21",
      "narration_id": "N06",
      "text": "在多伦多，内莉和霍华德跟着他进了地窖门。",
      "start": 120.0,
      "duration": 5.0,
      "source_seconds": 4.005,
      "natural_clip_seconds": 3.8,
      "natural_speech_seconds": 3.69,
      "spoken_seconds": 3.69,
      "tempo_factor": 1.0,
      "speech_start": 120.03,
      "speech_end": 123.72,
      "characters": 18,
      "target_chars_per_second": 3.6
    },
    {
      "id": "S22",
      "narration_id": "N06",
      "text": "印第安纳波利斯，艾丽斯只留下一只小鞋。",
      "start": 125.0,
      "duration": 5.0,
      "source_seconds": 4.214,
      "natural_clip_seconds": 4.03,
      "natural_speech_seconds": 3.92,
      "spoken_seconds": 3.92,
      "tempo_factor": 1.0,
      "speech_start": 125.03,
      "speech_end": 128.95,
      "characters": 17,
      "target_chars_per_second": 3.4
    },
    {
      "id": "S23",
      "narration_id": "N07",
      "text": "费城侦探弗兰克·盖耶盯着地图，一个城市一个城市地划线。",
      "start": 130.0,
      "duration": 7.0,
      "source_seconds": 6.734,
      "natural_clip_seconds": 6.52,
      "natural_speech_seconds": 6.41,
      "spoken_seconds": 6.41,
      "tempo_factor": 1.0,
      "speech_start": 130.03,
      "speech_end": 136.44,
      "characters": 24,
      "target_chars_per_second": 3.429
    },
    {
      "id": "S24",
      "narration_id": "N07",
      "text": "他沿着铁路追下去，车站、旅馆、码头，一路问过去。",
      "start": 137.0,
      "duration": 7.0,
      "source_seconds": 5.41,
      "natural_clip_seconds": 5.23,
      "natural_speech_seconds": 5.12,
      "spoken_seconds": 5.12,
      "tempo_factor": 1.0,
      "speech_start": 137.03,
      "speech_end": 142.15,
      "characters": 19,
      "target_chars_per_second": 2.714
    },
    {
      "id": "S25",
      "narration_id": "N07",
      "text": "在多伦多的地窖，他撬开箱子，认出两个孩子的衣物。",
      "start": 144.0,
      "duration": 6.0,
      "source_seconds": 4.899,
      "natural_clip_seconds": 4.6,
      "natural_speech_seconds": 4.49,
      "spoken_seconds": 4.49,
      "tempo_factor": 1.0,
      "speech_start": 144.03,
      "speech_end": 148.52,
      "characters": 21,
      "target_chars_per_second": 3.5
    },
    {
      "id": "S26",
      "narration_id": "N08",
      "text": "1895年，他承认杀了二十七个人，可其中有人还活着。",
      "start": 150.0,
      "duration": 6.0,
      "source_seconds": 4.818,
      "natural_clip_seconds": 4.5,
      "natural_speech_seconds": 4.39,
      "spoken_seconds": 4.39,
      "tempo_factor": 1.0,
      "speech_start": 150.03,
      "speech_end": 154.42,
      "characters": 23,
      "target_chars_per_second": 3.833
    },
    {
      "id": "S27",
      "narration_id": "N08",
      "text": "法庭只以谋杀皮泰泽尔一案，判他死刑。",
      "start": 156.0,
      "duration": 6.0,
      "source_seconds": 4.214,
      "natural_clip_seconds": 4.06,
      "natural_speech_seconds": 3.95,
      "spoken_seconds": 3.95,
      "tempo_factor": 1.0,
      "speech_start": 156.03,
      "speech_end": 159.98,
      "characters": 16,
      "target_chars_per_second": 2.667
    },
    {
      "id": "S28",
      "narration_id": "N08",
      "text": "1896年5月7日，他在莫亚门辛监狱被执行死刑。",
      "start": 162.0,
      "duration": 6.0,
      "source_seconds": 5.503,
      "natural_clip_seconds": 5.26,
      "natural_speech_seconds": 5.15,
      "spoken_seconds": 5.15,
      "tempo_factor": 1.0,
      "speech_start": 162.03,
      "speech_end": 167.18,
      "characters": 22,
      "target_chars_per_second": 3.667
    },
    {
      "id": "S29",
      "narration_id": "N09",
      "text": "他要了一口木棺，还要求用水泥把它封死。",
      "start": 168.0,
      "duration": 6.0,
      "source_seconds": 4.214,
      "natural_clip_seconds": 4.03,
      "natural_speech_seconds": 3.92,
      "spoken_seconds": 3.92,
      "tempo_factor": 1.0,
      "speech_start": 168.03,
      "speech_end": 171.95,
      "characters": 17,
      "target_chars_per_second": 2.833
    },
    {
      "id": "S30",
      "narration_id": "N09",
      "text": "能确认的只有九个人；传说和真相，哪个更可怕？",
      "start": 174.0,
      "duration": 6.0,
      "source_seconds": 4.725,
      "natural_clip_seconds": 4.61,
      "natural_speech_seconds": 4.5,
      "spoken_seconds": 4.5,
      "tempo_factor": 1.0,
      "speech_start": 174.03,
      "speech_end": 178.53,
      "characters": 19,
      "target_chars_per_second": 3.167
    }
  ],
