[
  {
    "id": "S01",
    "start": 0,
    "end": 5,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "style_variant": "real",
    "transition_in": null,
    "narration": "传说，1893年芝加哥世博会旁，有一栋旅馆。"
  },
  {
    "id": "S02",
    "start": 5,
    "end": 10,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N01",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "住进去的人，很多再也没有走出来，也没人问起。"
  },
  {
    "id": "S03",
    "start": 10,
    "end": 17,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "他本名赫尔曼·马吉特，1861年生在新罕布什尔州。"
  },
  {
    "id": "S04",
    "start": 17,
    "end": 24,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N02",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "聪明、善谈，在密歇根大学学医；据说那时就开始用尸体骗保险。"
  },
  {
    "id": "S05",
    "start": 24,
    "end": 30,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N02",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "一份保险单，一枚红印章，他靠这套把戏骗过钱。"
  },
  {
    "id": "S06",
    "start": 30,
    "end": 35,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N02",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "后来他改名霍姆斯，搬到芝加哥，准备大干一场。"
  },
  {
    "id": "S07",
    "start": 35,
    "end": 42,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "1886年，他来到芝加哥，接手了英格尔伍德街角的一家药店。"
  },
  {
    "id": "S08",
    "start": 42,
    "end": 49,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N03",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "又在对面盖起一栋三层大楼，取名“世界博览会旅馆”。"
  },
  {
    "id": "S09",
    "start": 49,
    "end": 55,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N03",
    "style_variant": "print",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "传说，楼里有暗道、活板门，还有没有窗户的房间。"
  },
  {
    "id": "S10",
    "start": 55,
    "end": 60,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N03",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.12
    ],
    "narration": "他不断换工人，一批走了又来，没人知道大楼全貌。"
  },
  {
    "id": "S11",
    "start": 60,
    "end": 67,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "1893年世博会期间，全城挤满外地游客，失踪几个人没人注意。"
  },
  {
    "id": "S12",
    "start": 67,
    "end": 74,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N04",
    "style_variant": "print",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "传说，独自来游览的年轻女子，进了那栋楼，再没消息。"
  },
  {
    "id": "S13",
    "start": 74,
    "end": 80,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N04",
    "style_variant": "print",
    "transition_in": [
      "smoothright",
      0.35
    ],
    "narration": "报纸一篇接一篇地渲染，数字越写越大，两百、三百。"
  },
  {
    "id": "S14",
    "start": 80,
    "end": 85,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N04",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.12
    ],
    "narration": "杀人城堡的传说，就这样诞生了。"
  },
  {
    "id": "S15",
    "start": 85,
    "end": 91,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "但真相比传说更冷：他杀的多不是游客。"
  },
  {
    "id": "S16",
    "start": 91,
    "end": 97,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "1894年，他和皮泰泽尔假死骗保，一万美元。"
  },
  {
    "id": "S17",
    "start": 97,
    "end": 103,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N05",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "可他半路改了主意：皮泰泽尔死了，保险金归了他。"
  },
  {
    "id": "S18",
    "start": 103,
    "end": 108,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N05",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "让他败露的不是那座楼，而是保险诈骗。"
  },
  {
    "id": "S19",
    "start": 108,
    "end": 114,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "他骗皮泰泽尔的妻子，说带孩子去见父亲。"
  },
  {
    "id": "S20",
    "start": 114,
    "end": 120,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N06",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "艾丽斯十五，内莉十一，霍华德八岁。"
  },
  {
    "id": "S21",
    "start": 120,
    "end": 125,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "在多伦多，内莉和霍华德跟着他进了地窖门。"
  },
  {
    "id": "S22",
    "start": 125,
    "end": 130,
    "duration": 5,
    "kind": "agnes",
    "narration_id": "N06",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "印第安纳波利斯，艾丽斯只留下一只小鞋。"
  },
  {
    "id": "S23",
    "start": 130,
    "end": 137,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "费城侦探弗兰克·盖耶盯着地图，一个城市一个城市地划线。"
  },
  {
    "id": "S24",
    "start": 137,
    "end": 144,
    "duration": 7,
    "kind": "agnes",
    "narration_id": "N07",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "他沿着铁路追下去，车站、旅馆、码头，一路问过去。"
  },
  {
    "id": "S25",
    "start": 144,
    "end": 150,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N07",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "在多伦多的地窖，他撬开箱子，认出两个孩子的衣物。"
  },
  {
    "id": "S26",
    "start": 150,
    "end": 156,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "1895年，他承认杀了二十七个人，可其中有人还活着。"
  },
  {
    "id": "S27",
    "start": 156,
    "end": 162,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "法庭只以谋杀皮泰泽尔一案，判他死刑。"
  },
  {
    "id": "S28",
    "start": 162,
    "end": 168,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N08",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "1896年5月7日，他在莫亚门辛监狱被执行死刑。"
  },
  {
    "id": "S29",
    "start": 168,
    "end": 174,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "他要了一口木棺，还要求用水泥把它封死。"
  },
  {
    "id": "S30",
    "start": 174,
    "end": 180,
    "duration": 6,
    "kind": "agnes",
    "narration_id": "N09",
    "style_variant": "real",
    "transition_in": [
      "fade",
      0.3
    ],
    "narration": "能确认的只有九个人；传说和真相，哪个更可怕？"
  }
]
