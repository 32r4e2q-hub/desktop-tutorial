-    "cue_activity": [
-      {
-        "cue": 1,
-        "start": 0.0,
-        "end": 1.32,
-        "text": "一九四八年，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.32
-      },
-      {
-        "cue": 2,
-        "start": 1.7,
-        "end": 3.74,
-        "text": "澳大利亚索马顿海滩，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.04
-      },
-      {
-        "cue": 3,
-        "start": 4.17,
-        "end": 6.44,
-        "text": "一个男人靠着海堤坐着。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.27
-      },
-      {
-        "cue": 4,
-        "start": 6.87,
-        "end": 7.63,
-        "text": "他死了，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.76
-      },
-      {
-        "cue": 5,
-        "start": 7.98,
-        "end": 10.0,
-        "text": "却无人知道他是谁。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.02
-      },
-      {
-        "cue": 6,
-        "start": 10.0,
-        "end": 11.99,
-        "text": "十二月一日清晨，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.99
-      },
-      {
-        "cue": 7,
-        "start": 12.43,
-        "end": 15.7,
-        "text": "路人在索马顿海滩发现了他。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.27
-      },
-      {
-        "cue": 8,
-        "start": 16.28,
-        "end": 17.79,
-        "text": "他西装笔挺，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.51
-      },
-      {
-        "cue": 9,
-        "start": 18.26,
-        "end": 19.46,
-        "text": "领带整齐，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.2
-      },
-      {
-        "cue": 10,
-        "start": 19.86,
-        "end": 21.47,
-        "text": "身上没有证件，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.61
-      },
-      {
-        "cue": 11,
-        "start": 21.88,
-        "end": 23.56,
-        "text": "也没有明显外伤。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.68
-      },
-      {
-        "cue": 12,
-        "start": 23.75,
-        "end": 24.55,
-        "text": "前一晚，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.8
-      },
-      {
-        "cue": 13,
-        "start": 24.87,
-        "end": 27.42,
-        "text": "有人看见他靠在海堤边一动不动，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.55
-      },
-      {
-        "cue": 14,
-        "start": 27.54,
-        "end": 30.6,
-        "text": "以为他只是睡着了。",
-        "active_fraction_above_minus42dbfs": 0.862,
-        "duration_seconds": 3.06
-      },
-      {
-        "cue": 15,
-        "start": 30.91,
-        "end": 33.26,
-        "text": "警方想查清他的身份，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.35
-      },
-      {
-        "cue": 16,
-        "start": 33.49,
-        "end": 35.0,
-        "text": "却找不到入口。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.51
-      },
-      {
-        "cue": 17,
-        "start": 35.0,
-        "end": 38.44,
-        "text": "所有衣物标签几乎都被剪掉。",
-        "active_fraction_above_minus42dbfs": 0.938,
-        "duration_seconds": 3.44
-      },
-      {
-        "cue": 18,
-        "start": 39.02,
-        "end": 42.75,
-        "text": "警方把指纹和牙齿记录送去比对，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.73
-      },
-      {
-        "cue": 19,
-        "start": 42.87,
-        "end": 44.2,
-        "text": "仍没有匹配。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.33
-      },
-      {
-        "cue": 20,
-        "start": 44.73,
-        "end": 47.05,
-        "text": "验尸官发现内脏充血，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.32
-      },
-      {
-        "cue": 21,
-        "start": 47.52,
-        "end": 49.19,
-        "text": "怀疑可能中毒；",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.67
-      },
-      {
-        "cue": 22,
-        "start": 49.66,
-        "end": 51.98,
-        "text": "常见毒物却查不出来。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.32
-      },
-      {
-        "cue": 23,
-        "start": 52.47,
-        "end": 55.0,
-        "text": "死因从此成了问号。",
-        "active_fraction_above_minus42dbfs": 0.913,
-        "duration_seconds": 2.53
-      },
-      {
-        "cue": 24,
-        "start": 55.0,
-        "end": 56.76,
-        "text": "一九四九年一月，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.76
-      },
-      {
-        "cue": 25,
-        "start": 57.06,
-        "end": 60.21,
-        "text": "阿德莱德火车站发现一只旧皮箱，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.15
-      },
-      {
-        "cue": 26,
-        "start": 60.57,
-        "end": 62.19,
-        "text": "警方怀疑属于他。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.62
-      },
-      {
-        "cue": 27,
-        "start": 62.64,
-        "end": 63.88,
-        "text": "箱里有衣物、",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.24
-      },
-      {
-        "cue": 28,
-        "start": 64.27,
-        "end": 66.11,
-        "text": "剃须用品和橙线，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.84
-      },
-      {
-        "cue": 29,
-        "start": 66.46,
-        "end": 69.28,
-        "text": "线头与裤子的修补处相合。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.82
-      },
-      {
-        "cue": 30,
-        "start": 69.67,
-        "end": 72.76,
-        "text": "衣物上只剩下“基恩”这个姓氏，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.09
-      },
-      {
-        "cue": 31,
-        "start": 73.12,
-        "end": 75.0,
-        "text": "却无人报失踪。",
-        "active_fraction_above_minus42dbfs": 0.882,
-        "duration_seconds": 1.88
-      },
-      {
-        "cue": 32,
-        "start": 75.0,
-        "end": 76.76,
-        "text": "随后复查时，",
-        "active_fraction_above_minus42dbfs": 0.938,
-        "duration_seconds": 1.76
-      },
-      {
-        "cue": 33,
-        "start": 76.9,
-        "end": 82.97,
-        "text": "验尸官在他裤子的暗袋里发现一张卷起的小纸片。",
-        "active_fraction_above_minus42dbfs": 0.932,
-        "duration_seconds": 6.07
-      },
-      {
-        "cue": 34,
-        "start": 83.1,
-        "end": 85.9,
-        "text": "上面印着两个波斯语词：",
-        "active_fraction_above_minus42dbfs": 0.962,
-        "duration_seconds": 2.8
-      },
-      {
-        "cue": 35,
-        "start": 86.49,
-        "end": 89.02,
-        "text": "Tamam Shud，",
-        "active_fraction_above_minus42dbfs": 0.783,
-        "duration_seconds": 2.53
-      },
-      {
-        "cue": 36,
-        "start": 89.14,
-        "end": 90.04,
-        "text": "意思是“结束了”。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.9
-      },
-      {
-        "cue": 37,
-        "start": 90.53,
-        "end": 93.91,
-        "text": "纸片来自诗集《鲁拜集》的末页。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.38
-      },
-      {
-        "cue": 38,
-        "start": 94.27,
-        "end": 97.31,
-        "text": "警方后来找到那本缺页的书，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.04
-      },
-      {
-        "cue": 39,
-        "start": 97.76,
-        "end": 100.0,
-        "text": "撕痕严丝合缝。",
-        "active_fraction_above_minus42dbfs": 0.95,
-        "duration_seconds": 2.24
-      },
-      {
-        "cue": 40,
-        "start": 100.0,
-        "end": 103.39,
-        "text": "诗集封底还有一串潦草字母，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.39
-      },
-      {
-        "cue": 41,
-        "start": 103.82,
-        "end": 106.84,
-        "text": "几十年来无人能可靠破解。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.02
-      },
-      {
-        "cue": 42,
-        "start": 107.47,
-        "end": 109.06,
-        "text": "旁边的电话号码，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.59
-      },
-      {
-        "cue": 43,
-        "start": 109.42,
-        "end": 111.49,
-        "text": "指向附近一位护士。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.07
-      },
-      {
-        "cue": 44,
-        "start": 111.59,
-        "end": 113.1,
-        "text": "她对警方说，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.51
-      },
-      {
-        "cue": 45,
-        "start": 113.36,
-        "end": 114.71,
-        "text": "不认识这个人，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 1.35
-      },
-      {
-        "cue": 46,
-        "start": 115.15,
-        "end": 119.71,
-        "text": "也不知道自己的号码为何会出现在诗集里。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 4.56
-      },
-      {
-        "cue": 47,
-        "start": 120.31,
-        "end": 123.02,
-        "text": "线索似乎指向某个人，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.71
-      },
-      {
-        "cue": 48,
-        "start": 123.39,
-        "end": 125.0,
-        "text": "却没有结论。",
-        "active_fraction_above_minus42dbfs": 0.857,
-        "duration_seconds": 1.61
-      },
-      {
-        "cue": 49,
-        "start": 125.0,
-        "end": 125.83,
-        "text": "于是，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.83
-      },
-      {
-        "cue": 50,
-        "start": 126.24,
-        "end": 127.02,
-        "text": "间谍、",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.78
-      },
-      {
-        "cue": 51,
-        "start": 127.43,
-        "end": 128.32,
-        "text": "情杀、",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.89
-      },
-      {
-        "cue": 52,
-        "start": 128.77,
-        "end": 132.41,
-        "text": "毒杀后抛尸的猜想越传越远。",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 3.64
-      },
-      {
-        "cue": 53,
-        "start": 132.83,
-        "end": 134.83,
-        "text": "冷战刚刚开始，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 2.0
-      },
-      {
-        "cue": 54,
-        "start": 135.29,
-        "end": 135.821,
-        "text": "纸条像暗号，",
-        "active_fraction_above_minus42dbfs": 1.0,
-        "duration_seconds": 0.531
-      },
